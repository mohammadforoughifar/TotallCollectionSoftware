@namespace Inventory.Client.Pages
@page "/fa-pay/my"
@inject IFaPayClientService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>فیش‌های حقوقی من</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1><i class="bi bi-person-vcard"></i> فیش‌های حقوقی من</h1>
        <div class="lead">مشاهده و دانلود فیش‌های صادرشده برای شما</div>
    </div>
</div>

@if (!faRead)
{
    <div class="alert alert-warning">به این بخش دسترسی ندارید.</div>
    return;
}

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>دوره</th>
                        <th class="d-none d-md-table-cell">حقوق پایه</th>
                        <th class="d-none d-md-table-cell">جمع مزایا</th>
                        <th class="d-none d-md-table-cell">جمع کسور</th>
                        <th>خالص پرداختی</th>
                        <th>وضعیت</th>
                        <th style="width:130px">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in slips)
                    {
                        <tr>
                            <td><strong>@FaPayUi.YearMonth(s.RunYear, s.RunMonth)</strong></td>
                            <td class="d-none d-md-table-cell text-nowrap">@FaPayUi.Money(s.BaseSalary)</td>
                            <td class="d-none d-md-table-cell text-nowrap">@FaPayUi.Money(s.GrossEarnings)</td>
                            <td class="d-none d-md-table-cell text-nowrap">@FaPayUi.Money(s.TotalDeductions)</td>
                            <td class="text-nowrap"><strong class="text-primary">@FaPayUi.Money(s.NetPay)</strong></td>
                            <td>@if (s.IsPaid) { <span class="badge text-bg-success">پرداخت شد</span> } else { <span class="badge text-bg-secondary">پرداخت نشده</span> }</td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-primary" title="مشاهده" @onclick="() => Go(s.Id)"><i class="bi bi-eye"></i></button>
                                    <button class="btn btn-outline-secondary" title="دانلود PDF" @onclick="() => Pdf(s.Id)"><i class="bi bi-file-earmark-pdf"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (slips.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">فیشی برای شما صادر نشده است.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<style>
    @@media (max-width: 575px) {
        .page-head h1 { font-size: 1.25rem; }
        .page-head .lead { font-size: .85rem; }
        .table { font-size: .82rem; }
        .btn-group-sm .btn { padding: .35rem .6rem; font-size: 1rem; }
    }
</style>

@code {
    private bool faRead => Auth.Has("FaPay.Read") || Auth.Has("FaPay.Manage") || Auth.IsAdmin;
    private bool loading = true;
    private List<FaPaySlipDto> slips = new();

    protected override async Task OnInitializedAsync()
    {
        if (!faRead) { loading = false; return; }
        try { slips = await Svc.MySlipsAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        loading = false;
    }

    private void Go(int id) => Nav.NavigateTo(FaPayUi.MySlipUrl(id));

    private async Task Pdf(int id)
    {
        try { await Svc.DownloadSlipPdfAsync(id, true); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
