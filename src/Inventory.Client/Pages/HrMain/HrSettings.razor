@namespace Inventory.Client.Pages
@page "/hr-main/settings"
@inject IAuthState Auth
@inject IHrCoreService Svc
<PageTitle>سازمان و تنظیمات</PageTitle>
<div class="page-head"><h1>سازمان و تنظیمات</h1><a class="btn btn-sm btn-outline-secondary" href="hr-main"><i class="bi bi-arrow-right" aria-hidden="true"></i> خانه منابع انسانی</a></div>
@if (items.Length == 0)
{
    <div class="alert alert-warning" role="alert">به بخش تنظیمات دسترسی ندارید.</div>
}
else
{
    <HrLinkGrid Items="items" />
}

@if (CanPurge)
{
    <div class="card mt-4 border-danger">
        <div class="card-body">
            <h2 class="h6 mb-2 text-danger"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i> پاک‌سازی داده‌های آزمایشی منابع انسانی</h2>
            <p class="small text-muted mb-2">
                همه‌ی داده‌های ثبت‌شده‌ی ماژول منابع انسانی را برای همیشه حذف می‌کند — مناسب زمانی که با داده‌ی فیک/آزمایشی کار کرده‌اید و می‌خواهید از صفر شروع کنید.
            </p>
            <ul class="small text-muted mb-3">
                <li>حذف می‌شود: ساختار سازمانی و پست‌ها، کل پرسنل و پرونده‌ها، قراردادها و احکام، جذب و خروج، ارزیابی‌ها، حضور و مرخصی، حقوق و دستمزد (دوره‌ها/فیش‌ها/وام‌ها)، آموزش، اطلاعیه/تیکت/پیشنهاد/نظرسنجی و تاریخچه‌ی عملیات همین ماژول‌ها.</li>
                <li>حفظ می‌شود: کاربران و نقش‌ها، انواع مرخصی، شیفت‌ها، دستگاه‌های تردد، اقلام و تنظیمات حقوق، قالب‌های قرارداد، تقویم و تعطیلات.</li>
            </ul>
            @if (result is not null)
            {
                <div class="alert alert-success mb-0" role="status">
                    <b><i class="bi bi-check2-circle" aria-hidden="true"></i> @result.Message</b>
                    <div class="small mt-1">@string.Join(" · ", result.Areas.Where(a => a.Value > 0).Select(a => $"{a.Key}: {a.Value.Num()}"))</div>
                    @if (!string.IsNullOrWhiteSpace(result.Warning))
                    {
                        <div class="alert alert-warning small mt-2 mb-0" role="alert">@result.Warning</div>
                    }
                </div>
            }
            else if (error)
            {
                <div class="alert alert-danger" role="alert">پاک‌سازی انجام نشد — دسترسی یا اتصال خود را بررسی کنید و دوباره تلاش کنید.</div>
            }
            else if (busy)
            {
                <button class="btn btn-danger" disabled><span class="spinner-border spinner-border-sm"></span> در حال پاک‌سازی…</button>
            }
            else if (armed)
            {
                <div class="d-flex flex-wrap gap-2 align-items-center">
                    <button class="btn btn-danger" @onclick="DoPurge"><i class="bi bi-trash3" aria-hidden="true"></i> بله، همه‌چیز را پاک کن</button>
                    <button class="btn btn-outline-secondary" @onclick="() => armed = false">انصراف</button>
                    <span class="small text-danger fw-bold">این عمل بازگشت‌پذیر نیست.</span>
                </div>
            }
            else
            {
                <button class="btn btn-outline-danger" @onclick="() => armed = true"><i class="bi bi-trash3" aria-hidden="true"></i> پاک‌سازی داده‌های منابع انسانی…</button>
            }
        </div>
    </div>
}

@code {
    private HrNavigation.Entry[] items = [];
    private bool armed, busy, error;
    private HrPurgeResultDto? result;
    private bool CanPurge => Auth.IsAdmin || Auth.Has("Settings.Manage");
    protected override void OnParametersSet() => items = HrNavigation.Visible(Auth.Has, Auth.IsAdmin).Where(s => s.Id is "org" or "setup").SelectMany(s => s.Items).Where(i => i.Href != "hr-main/settings").ToArray();

    private async Task DoPurge()
    {
        busy = true; error = false; result = null;
        try { result = await Svc.PurgeDemoDataAsync(); armed = false; }
        catch { error = true; }
        finally { busy = false; }
    }
}
