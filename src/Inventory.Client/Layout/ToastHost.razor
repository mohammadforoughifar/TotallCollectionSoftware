@inject IToastService Toast
@implements IDisposable

<div class="toast-container">
    @foreach (var t in Toast.Toasts)
    {
        <div class="toast-item @t.Kind">
            <div class="toast-icon">
                <i class="bi @Icon(t.Kind)"></i>
            </div>
            <div>@t.Message</div>
            <button type="button" class="toast-close btn btn-link p-0" title="بستن اعلان"
                    @onclick="() => Toast.Remove(t.Id)" @onclick:stopPropagation="true" aria-label="بستن اعلان">
                <i class="bi bi-x"></i>
            </button>
        </div>
    }
</div>

@code {
    protected override void OnInitialized() => Toast.OnChange += OnChange;

    private void OnChange() => InvokeAsync(StateHasChanged);

    private static string Icon(string kind) => kind switch
    {
        "success" => "bi-check-circle-fill",
        "error" => "bi-x-circle-fill",
        _ => "bi-info-circle-fill"
    };

    public void Dispose() => Toast.OnChange -= OnChange;
}
