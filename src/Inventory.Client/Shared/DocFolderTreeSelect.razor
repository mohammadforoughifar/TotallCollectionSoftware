@using Inventory.Shared.Dtos
@inject IJSRuntime JS

@code {
    private readonly string _uniqueId = Guid.NewGuid().ToString("N").Substring(0, 8);
}

<div class="doc-folder-tree-select @CssClass" dir="rtl">
    <div class="input-group">
        <input type="text"
               class="form-control"
               value="@searchText"
               placeholder="@Placeholder"
               disabled="@Disabled"
               @ref="_input"
               @onfocus="OnFocus"
               @oninput="OnInput"
               @onkeydown="OnKeyDown" />

        @if (AllowClear && Value.HasValue && !Disabled)
        {
            <button type="button" class="btn btn-outline-secondary dfts-clear-btn" title="پاک کردن انتخاب (ریشه آرشیو)" tabindex="-1"
                    @onclick="ClearSelection" @onclick:stopPropagation="true">
                <i class="bi bi-x-lg"></i>
            </button>
        }
        <button type="button" class="btn btn-outline-secondary dfts-toggle-btn" tabindex="-1"
                disabled="@Disabled"
                @onclick="ToggleDropdown" @onclick:stopPropagation="true">
            <i class="bi @(open ? "bi-chevron-up" : "bi-chevron-down")"></i>
        </button>
    </div>

    @if (open)
    {
        <div class="pop-overlay" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
        <div class="dfts-menu" style="@MenuStyle" @onclick:stopPropagation="true">
            @* گزینه ریشه آرشیو *@
            @if (string.IsNullOrWhiteSpace(searchText))
            {
                <div class="dfts-item dfts-root-item @(!Value.HasValue ? "selected" : "")"
                     @onclick="() => SelectFolder(null, RootTitle)">
                    <i class="bi bi-folder2-open text-primary me-1"></i>
                    <span class="fw-bold">@RootTitle</span>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(searchText))
            {
                @* حالت جستجو: نمایش نتایج فیلترشده همراه با مسیر کامل پوشه *@
                var matched = FilteredFolders;
                if (matched.Count == 0)
                {
                    <div class="dfts-empty">پوشه‌ای با این عنوان یافت نشد</div>
                }
                else
                {
                    @foreach (var f in matched)
                    {
                        var isSel = Value.HasValue && Value.Value == f.Id;
                        <div class="dfts-item @(isSel ? "selected" : "")"
                             @onclick="() => SelectFolder(f.Id, f.Name)">
                            <i class="bi bi-folder-fill text-warning me-1"></i>
                            <span class="dfts-item-title">@f.Name</span>
                            @if (GetFolderPath(f.Id) is string p && p != f.Name)
                            {
                                <small class="dfts-item-path text-muted ms-2">(@p)</small>
                            }
                        </div>
                    }
                }
            }
            else
            {
                @* حالت عادی: نمایش درختی پوشه‌ها با قابلیت باز/بسته شدن *@
                if (Folders.Count == 0)
                {
                    <div class="dfts-empty">پوشه‌ای وجود ندارد</div>
                }
                else
                {
                    <div class="dfts-tree-container">
                        @RenderTreeNodes(null, 0)
                    </div>
                }
            }
        </div>
    }
</div>

<style>
    .doc-folder-tree-select { position: relative; }
    .dfts-clear-btn, .dfts-toggle-btn { z-index: 2; }
    .dfts-menu {
        position: fixed;
        background: #fff;
        border: 1px solid #cbd5e1;
        border-radius: 8px;
        box-shadow: 0 10px 25px -5px rgba(0,0,0,0.1), 0 8px 10px -6px rgba(0,0,0,0.1);
        max-height: 320px;
        overflow-y: auto;
        padding: 6px;
        z-index: 4500;
        font-size: 0.875rem;
    }
    .dfts-empty {
        padding: 12px;
        text-align: center;
        color: #94a3b8;
    }
    .dfts-item {
        display: flex;
        align-items: center;
        padding: 6px 10px;
        border-radius: 6px;
        cursor: pointer;
        transition: background 0.15s ease;
    }
    .dfts-item:hover {
        background: #f1f5f9;
    }
    .dfts-item.selected {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 600;
    }
    .dfts-root-item {
        border-bottom: 1px solid #f1f5f9;
        margin-bottom: 4px;
        padding-bottom: 8px;
    }
    .dfts-tree-row {
        display: flex;
        align-items: center;
        padding: 4px 6px;
        border-radius: 6px;
        cursor: pointer;
        user-select: none;
        transition: background 0.15s ease;
    }
    .dfts-tree-row:hover {
        background: #f1f5f9;
    }
    .dfts-tree-row.selected {
        background: #e0e7ff;
        color: #3730a3;
        font-weight: 600;
    }
    .dfts-caret {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 20px;
        height: 20px;
        margin-left: 2px;
        cursor: pointer;
        border-radius: 4px;
        color: #64748b;
    }
    .dfts-caret:hover {
        background: #e2e8f0;
        color: #1e293b;
    }
    .dfts-caret-spacer {
        display: inline-block;
        width: 20px;
        height: 20px;
        margin-left: 2px;
    }
    .dfts-item-path {
        font-size: 0.75rem;
    }
</style>

@code {
    [Parameter] public List<DocFolderDto> Folders { get; set; } = new();
    [Parameter] public int? Value { get; set; }
    [Parameter] public EventCallback<int?> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "ریشهٔ آرشیو (یا انتخاب پوشه)";
    [Parameter] public string RootTitle { get; set; } = "ریشهٔ آرشیو";
    [Parameter] public string CssClass { get; set; } = "";
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }

    private string searchText = "";
    private bool open;
    private readonly HashSet<int> expanded = new();
    private ElementReference _input;
    private double _mTop, _mLeft, _mWidth;

    private string MenuStyle => Popover.FixedStyle(_mTop, _mLeft, _mWidth);

    protected override void OnParametersSet()
    {
        UpdateDisplayFromValue();
    }

    private void UpdateDisplayFromValue()
    {
        if (Value.HasValue && Value.Value > 0)
        {
            var folder = Folders.FirstOrDefault(f => f.Id == Value.Value);
            if (folder != null)
            {
                searchText = folder.Name;
                EnsureParentsExpanded(folder.ParentId);
                return;
            }
        }
        searchText = "";
    }

    private void EnsureParentsExpanded(int? parentId)
    {
        var cur = parentId;
        var guard = 0;
        while (cur.HasValue && cur.Value > 0 && guard++ < 25)
        {
            expanded.Add(cur.Value);
            var parent = Folders.FirstOrDefault(f => f.Id == cur.Value);
            cur = parent?.ParentId;
        }
    }

    private List<DocFolderDto> FilteredFolders
    {
        get
        {
            if (string.IsNullOrWhiteSpace(searchText)) return Folders;
            return Folders.Where(f => f.Name.Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    private string GetFolderPath(int folderId)
    {
        var current = Folders.FirstOrDefault(f => f.Id == folderId);
        if (current == null) return "";
        var parts = new List<string> { current.Name };
        var curParent = current.ParentId;
        var guard = 0;
        while (curParent.HasValue && curParent.Value > 0 && guard++ < 20)
        {
            var p = Folders.FirstOrDefault(f => f.Id == curParent.Value);
            if (p == null) break;
            parts.Insert(0, p.Name);
            curParent = p.ParentId;
        }
        return string.Join(" / ", parts);
    }

    private async Task OpenMenu()
    {
        if (Disabled) return;
        try
        {
            var r = await JS.InvokeAsync<UiRect>("uiRect", _input);
            (_mTop, _mLeft, _mWidth) = Popover.Below(r);
        }
        catch (JSException) { }
        open = true;
    }

    private void CloseMenu()
    {
        open = false;
        UpdateDisplayFromValue();
    }

    private async Task ToggleDropdown()
    {
        if (open) CloseMenu();
        else await OpenMenu();
    }

    private async Task OnFocus()
    {
        await OpenMenu();
    }

    private void OnInput(ChangeEventArgs e)
    {
        searchText = e.Value?.ToString() ?? "";
        if (!open) _ = OpenMenu();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            CloseMenu();
        }
    }

    private void ToggleExpand(int folderId)
    {
        if (!expanded.Add(folderId))
            expanded.Remove(folderId);
    }

    private async Task SelectFolder(int? folderId, string name)
    {
        Value = folderId;
        searchText = folderId.HasValue ? name : "";
        open = false;
        await ValueChanged.InvokeAsync(Value);
    }

    private async Task ClearSelection()
    {
        await SelectFolder(null, "");
    }

    private RenderFragment RenderTreeNodes(int? parentId, int depth) => builder =>
    {
        var children = Folders.Where(f => f.ParentId == parentId).OrderBy(f => f.Name).ToList();
        var seq = 0;

        foreach (var f in children)
        {
            var current = f;
            var hasChildren = Folders.Any(x => x.ParentId == current.Id);
            var isExpanded = expanded.Contains(current.Id);
            var isSelected = Value.HasValue && Value.Value == current.Id;

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "dfts-tree-row " + (isSelected ? "selected" : ""));
            builder.AddAttribute(seq++, "style", $"padding-right:{depth * 18 + 6}px");
            builder.AddAttribute(seq++, "onclick",
                Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => SelectFolder(current.Id, current.Name)));

            if (hasChildren)
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "dfts-caret");
                builder.AddAttribute(seq++, "onclick",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => ToggleExpand(current.Id)));
                builder.AddEventStopPropagationAttribute(seq++, "onclick", true);

                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", "bi " + (isExpanded ? "bi-chevron-down" : "bi-chevron-left"));
                builder.CloseElement();

                builder.CloseElement();
            }
            else
            {
                builder.OpenElement(seq++, "span");
                builder.AddAttribute(seq++, "class", "dfts-caret-spacer");
                builder.CloseElement();
            }

            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", current.IsPublic ? "bi bi-folder-fill text-info me-1" : "bi bi-folder-fill text-warning me-1");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "dfts-label");
            builder.AddContent(seq++, current.Name);
            builder.CloseElement();

            builder.CloseElement();

            if (hasChildren && isExpanded)
            {
                builder.AddContent(seq++, RenderTreeNodes(current.Id, depth + 1));
            }
        }
    };
}
