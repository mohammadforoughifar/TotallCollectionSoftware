    private Task LoadMoreWorkOrdersAsync() => LoadProjectOrdersAsync(loadMore: true);
    private async Task LoadProjectOrdersAsync(bool loadMore = false)
    {
        if (_loadingOrders) return;
        var generation = ++_workOrderLoadGeneration;
        var skip = loadMore ? _workOrderSkip : 0;
        _loadingOrders = true;
        try
        {
            var rows = await Http.GetFromJsonAsync<List<MindFlowWorkOrder>>($"api/workorders/mindflow-lookup?take=100&skip={skip}") ?? new();
            if (generation != _workOrderLoadGeneration) return;
            foreach (var order in rows) _workOrderCache[order.Id] = order;
            if (!loadMore) _projectOrders.Clear();
            var knownIds = _projectOrders.Select(o => o.Id).ToHashSet();
            _projectOrders.AddRange(rows.Where(o => knownIds.Add(o.Id)));
            _workOrderSkip = skip + rows.Count;
            _hasMoreWorkOrders = rows.Count == 100;

            foreach (var linkedId in NodeWorkOrderIds(SelectedNode).Where(id => !_workOrderCache.ContainsKey(id)))
            {
                try
                {
                    var linked = await Http.GetFromJsonAsync<MindFlowWorkOrder>($"api/workorders/{linkedId}");
                    if (linked is not null) _workOrderCache[linked.Id] = linked;
                }
                catch (HttpRequestException) { }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (generation == _workOrderLoadGeneration)
            {
                if (!loadMore) _projectOrders.Clear();
                _hasMoreWorkOrders = false;
                _message = "فهرست دستورکارها بارگذاری نشد.";
            }
        }
        finally
        {
            if (generation == _workOrderLoadGeneration) _loadingOrders = false;
        }
    }
    private async Task LoadLinkedChecklistAsync(bool force = false)
