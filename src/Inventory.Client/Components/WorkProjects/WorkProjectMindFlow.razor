    private WorkProjectMindFlowDto CreateStarterMap(string title)
    {
        var root = Guid.NewGuid();
        return new WorkProjectMindFlowDto { ProjectId = ProjectId, Title = title, Nodes = new()
        {
            new() { Id = root, Text = title, X = 800, Y = 450, Color = "#596cf3" },
            new() { ParentId = root, Text = "هدف‌ها", X = 520, Y = 270, Color = "#596cf3" },
            new() { ParentId = root, Text = "کارها", X = 520, Y = 630, Color = "#32a783" },
