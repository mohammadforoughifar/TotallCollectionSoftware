@using System.Text.Json
@implements IDisposable
@inject HttpClient Http
@inject IJSRuntime JS
@inject IAuthState Auth

<div class="wpmf-root @(_isFullscreen ? "wpmf-fullscreen" : "")" dir="rtl">
    <div class="wpmf-head">
        <div><div class="wpmf-kicker">نگار ذهنی</div><input class="wpmf-title" value="@_map.Title" @oninput="OnTitleInput" disabled="@(!CanEdit)" /></div>
        <div class="wpmf-head-actions"><span class="wpmf-save-state">@(_dirty ? "تغییرات ذخیره‌نشده" : _status)</span><button class="btn btn-sm btn-outline-secondary wpmf-maximize" type="button" @onclick="ToggleFullscreen" title="@(_isFullscreen ? "بازگشت به اندازهٔ معمول" : "بزرگ‌نمایی تمام‌صفحه")" aria-label="@(_isFullscreen ? "بازگشت به اندازهٔ معمول" : "بزرگ‌نمایی تمام‌صفحه")"><i class="bi @(_isFullscreen ? "bi-fullscreen-exit" : "bi-arrows-fullscreen")"></i></button><button class="btn btn-sm btn-primary" @onclick="SaveAsync" disabled="@(!CanEdit || _saving)"><i class="bi bi-cloud-check"></i> @(_saving ? "در حال ذخیره…" : "ذخیره نقشه")</button></div>
    </div>
    <div class="wpmf-toolbar">
        <div class="wpmf-tools">
            @if (SelectedNode is not null)
            {
                if (SelectedNode.ChildMindFlow is not null || SelectedNode.LinkedMindFlowProjectId.HasValue)
                {
                    var linkedFlowForToolbar = SelectedNode.LinkedMindFlowProjectId is int linkedId ? FindAccessibleMindFlow(linkedId) : null;
                    var canDesignSubFlow = SelectedNode.ChildMindFlow is not null ? CanEdit : linkedFlowForToolbar?.CanManage == true && linkedFlowForToolbar.Status == "Open";
                    <a class="btn btn-sm btn-outline-primary" href="@SubMindFlowHref(SelectedNode.Id)" target="_blank" rel="noopener noreferrer" title="بازکردن زیرنگاشت در تب جدید">
                        <i class="bi bi-diagram-3"></i> @(canDesignSubFlow ? "طراحی زیرنگاشت" : "مشاهده زیرنگاشت")
                    </a>
                }
                else if (CanEdit)
                {
                    <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateChildMindFlowAsync" disabled="@_saving">
                        <i class="bi bi-plus-square"></i> ساخت زیرنگاشت
                    </button>
                }
            }
            <button class="btn btn-sm btn-light" @onclick="AddChild" disabled="@(!CanEdit)"><i class="bi bi-node-plus"></i> زیرشاخه</button>
            <button class="btn btn-sm btn-light" @onclick="AddSibling" disabled="@(!CanEdit)"><i class="bi bi-diagram-2"></i> هم‌سطح</button>
            <button class="btn btn-sm btn-light" @onclick="Undo" disabled="@(!CanEdit || _undo.Count == 0)">↶</button>
            <button class="btn btn-sm btn-light" @onclick="Redo" disabled="@(!CanEdit || _redo.Count == 0)">↷</button>
            <button class="btn btn-sm btn-light" @onclick="ToggleCollapse" disabled="@(!CanEdit)" title="جمع/بازکردن شاخه">@(SelectedNode?.Collapsed == true ? "⊞" : "⊟")</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="DeleteSelected" disabled="@(!CanEdit || SelectedNode?.ParentId is null)"><i class="bi bi-trash"></i></button>
        </div>
        <div class="wpmf-zoom"><input class="form-control form-control-sm" placeholder="جست‌وجو در نقشه" @bind="_search" @bind:event="oninput" /><button class="btn btn-sm btn-light" @onclick="ZoomOut">−</button><span>@((int)(Zoom * 100))٪</span><button class="btn btn-sm btn-light" @onclick="ZoomIn">＋</button><button class="btn btn-sm btn-light" @onclick="Fit">نمای کامل</button></div>
    </div>
    @if (!string.IsNullOrWhiteSpace(_message)) { <div class="alert alert-warning py-2 px-3 mb-2">@_message</div> }
    @if (_loading)
    {
        <div class="wpmf-loading"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری نقشهٔ پروژه…</div>
    }
    else
    {
        <div class="wpmf-workarea">
            <div class="wpmf-canvas-wrap">
                <div class="wpmf-canvas-scroller">
                    <div class="wpmf-grid"></div>
                    <svg id="@_svgId" class="wpmf-canvas" data-readonly="@(!CanEdit)" viewBox="@ViewBox" aria-label="@(IsStandalone ? "نگاشت ذهنی مستقل" : "نقشه ذهنی پروژه")">
                    @foreach (var node in VisibleNodes.Where(n => n.ParentId.HasValue))
                    {
                        var parent = _map.Nodes.FirstOrDefault(n => n.Id == node.ParentId);
                        if (parent is not null && IsVisible(parent))
                        {
                            var direction = node.X >= parent.X ? 1 : -1;
                            var sx = parent.X + direction * Width(parent) / 2;
                            var ex = node.X - direction * Width(node) / 2;
                            var mid = (sx + ex) / 2;
                            <path class="wpmf-link" data-parent-id="@parent.Id" data-node-id="@node.Id" d="M @N(sx) @N(parent.Y) C @N(mid) @N(parent.Y), @N(mid) @N(node.Y), @N(ex) @N(node.Y)" stroke="@node.Color" />
                        }
                    }
                    @foreach (var node in VisibleNodes)
                    {
                            var progress = GetProgress(node.Id);
                            var workOrderCount = NodeWorkOrderIds(node).Count;
                            var linkedSubFlow = HasAccessibleSubMindFlow(node);
                            var actionCount = (workOrderCount > 0 ? 1 : 0) + (linkedSubFlow ? 1 : 0);
                            var actionSpace = actionCount * 30;
                            var width = Width(node);
                            var height = Height(node);
                            var selected = node.Id == _selectedId;
                        var cx = width / 2 - 18;
                        var cy = -height / 2 + 18;
                        var radius = 13;
                        var circumference = 2 * Math.PI * radius;
                        <g class="wpmf-node @(selected ? "selected" : "") @(string.IsNullOrWhiteSpace(_search) || !node.Text.Contains(_search, StringComparison.OrdinalIgnoreCase) ? "" : "match")" data-node-id="@node.Id" data-parent-id="@(node.ParentId?.ToString() ?? "")" data-x="@N(node.X)" data-y="@N(node.Y)" data-width="@N(width)" transform="translate(@N(node.X),@N(node.Y))" @onclick="() => Select(node.Id)" @onclick:stopPropagation="true">
                            <rect class="wpmf-node-bg" x="@N(-width / 2)" y="@N(-height / 2)" width="@N(width)" height="@N(height)" rx="18" fill="@(node.ParentId is null ? node.Color : "#fff")" stroke="@node.Color" />
                            @if (workOrderCount > 0)
                            {
                                <foreignObject x="@N(-width / 2 + 4)" y="@N(-height / 2 + 4)" width="27" height="24">
                                    <button xmlns="http://www.w3.org/1999/xhtml" type="button" class="wpmf-node-action wpmf-node-order-action" title="بازکردن دستورکارهای این گره (@workOrderCount)" @onclick="() => OpenNodeWorkOrdersAsync(node)" @onclick:stopPropagation="true">
                                        <i class="bi bi-clipboard-check"></i><span>@workOrderCount</span>
                                    </button>
                                </foreignObject>
                            }
                            @if (linkedSubFlow)
                            {
                                var subIconX = -width / 2 + (workOrderCount > 0 ? 34 : 4);
                                <foreignObject x="@N(subIconX)" y="@N(-height / 2 + 4)" width="27" height="24">
                                    <a xmlns="http://www.w3.org/1999/xhtml" class="wpmf-node-action wpmf-node-subflow-action" href="@SubMindFlowHref(node.Id)" target="_blank" rel="noopener noreferrer" title="بازکردن زیرمایندفلو در تب جدید" @onclick="StopNodeAction" @onclick:stopPropagation="true">
                                        <i class="bi bi-diagram-3"></i>
                                    </a>
                                </foreignObject>
                            }
                            <foreignObject x="@N(-width / 2 + (node.ParentId is null ? 8 : 0) + actionSpace)" y="@N(-height / 2)" width="@N(width - (progress.HasValue ? 34 : 8) - actionSpace)" height="@N(height)">
                                <div xmlns="http://www.w3.org/1999/xhtml" class="wpmf-node-label @(node.ParentId is null ? "root" : "")">@node.Text</div>
                            </foreignObject>
                            @if (progress is double pct)
                            {
                                <circle class="wpmf-ring-track @(node.ParentId is null ? "root-track" : "")" cx="@N(cx)" cy="@N(cy)" r="@N(radius)" />
                                <circle class="wpmf-ring-value" cx="@N(cx)" cy="@N(cy)" r="@N(radius)" stroke="@(node.ParentId is null ? "#fff" : node.Color)" stroke-dasharray="@N(circumference)" stroke-dashoffset="@N(circumference * (1 - Math.Clamp(pct, 0, 100) / 100))" transform="rotate(-90 @N(cx) @N(cy))" />
                                <foreignObject x="@N(cx - 14)" y="@N(cy - 8)" width="28" height="16"><div xmlns="http://www.w3.org/1999/xhtml" class="wpmf-ring-label @(node.ParentId is null ? "root-label" : "")">@Math.Round(pct)%</div></foreignObject>
                            }
                            @if (node.Collapsed && ChildCount(node.Id) > 0) { <circle class="wpmf-collapse-dot" cx="0" cy="@N(height / 2 + 8)" r="6" /> }
                        </g>
                    }
                    </svg>
                </div>
                <div class="wpmf-hint">@(CanEdit ? "برای دیدن بخش‌های بیرون قاب، افقی یا عمودی اسکرول کن؛ گره را بکش تا جابه‌جا یا روی گرهٔ مقصد رها کن تا زیرشاخه شود." : "برای دیدن جزئیات، روی گره کلیک کن؛ برای دیدن بخش‌های بیرون قاب اسکرول کن.")</div>
            </div>
            <aside class="wpmf-inspector" aria-label="پنل تنظیمات و طراحی؛ برای دیدن گزینه‌های بیشتر عمودی اسکرول کنید">
                @if (SelectedNode is not null)
                {
                    var p = GetProgress(SelectedNode.Id);
                    <section class="wpmf-inspector-card wpmf-node-settings-card">
                        <header class="wpmf-card-heading"><i class="bi bi-sliders"></i><span>مشخصات گره</span></header>
                        <div class="wpmf-card-body">
                    <div class="wpmf-progress-head"><div class="wpmf-progress-ring" style="@RingStyle(SelectedNode.Color, p ?? 0)"><span>@(p is double v ? $"{Math.Round(v)}٪" : "—")</span></div><div><strong>پیشرفت این شاخه</strong><small>@ProgressSource(SelectedNode)</small></div></div>
                    <section class="wpmf-size-panel">
                        <div class="wpmf-size-heading"><b>اندازهٔ المان انتخاب‌شده</b><small>@Math.Round(Width(SelectedNode)) × @Math.Round(Height(SelectedNode)) px</small></div>
                        <div class="wpmf-size-row">
                            <span>عرض</span>
                            <button type="button" class="btn btn-sm btn-light" title="کوچک‌کردن عرض" @onclick="() => AdjustSelectedNodeSize(-20, 0)" disabled="@(!CanEdit || Width(SelectedNode) <= MinNodeWidth)">−</button>
                            <output>@Math.Round(Width(SelectedNode)) px</output>
                            <button type="button" class="btn btn-sm btn-light" title="بزرگ‌کردن عرض" @onclick="() => AdjustSelectedNodeSize(20, 0)" disabled="@(!CanEdit || Width(SelectedNode) >= MaxNodeWidth)">＋</button>
                        </div>
                        <div class="wpmf-size-row">
                            <span>ارتفاع</span>
                            <button type="button" class="btn btn-sm btn-light" title="کم‌کردن ارتفاع" @onclick="() => AdjustSelectedNodeSize(0, -10)" disabled="@(!CanEdit || Height(SelectedNode) <= MinNodeHeight)">−</button>
                            <output>@Math.Round(Height(SelectedNode)) px</output>
                            <button type="button" class="btn btn-sm btn-light" title="زیادکردن ارتفاع" @onclick="() => AdjustSelectedNodeSize(0, 10)" disabled="@(!CanEdit || Height(SelectedNode) >= MaxNodeHeight)">＋</button>
                        </div>
                    </section>
                    <label class="form-label small mb-1">عنوان بخش</label>
                    <input class="form-control form-control-sm mb-3" value="@SelectedNode.Text" @oninput="OnNodeText" disabled="@(!CanEdit)" />
                    <label class="form-label small mb-1">یادداشت</label>
                    <textarea class="form-control form-control-sm mb-3" rows="2" value="@SelectedNode.Note" @oninput="OnNodeNote" disabled="@(!CanEdit)" placeholder="توضیح...">@SelectedNode.Note</textarea>
                    <label class="form-label small mb-1">رنگ شاخه</label>
                    <div class="wpmf-colors mb-3">@foreach (var color in Palette) { <button class="@(SelectedNode.Color == color ? "active" : "")" style="background:@color" @onclick="() => SetColor(color)" disabled="@(!CanEdit)" aria-label="تغییر رنگ"></button> }</div>
                        </div>
                    </section>
                    <section class="wpmf-inspector-card wpmf-order-card">
                        <header class="wpmf-card-heading"><i class="bi bi-clipboard-check"></i><span>دستورکارهای این گره</span><b class="wpmf-card-count">@NodeWorkOrderIds(SelectedNode).Count</b>
                            @if (CanEdit && Auth.Has("WorkOrders.Create"))
                            {
                                <a class="wpmf-create-order-btn" href="@CreateWorkOrderHref(SelectedNode)" target="_blank" rel="noopener noreferrer" title="ساخت دستورکار جدید و اتصال به این گره" aria-label="ساخت دستورکار جدید" @onclick="SaveBeforeCreateWorkOrderAsync"><i class="bi bi-plus-lg"></i></a>
                            }
                        </header>
                        @if (CanEdit)
                        {
                            <button type="button" class="wpmf-add-order-btn" @onclick="ToggleWorkOrderOptions" aria-expanded="@_showWorkOrderOptions" disabled="@_loadingOrders">
                                <i class="bi @(_showWorkOrderOptions ? "bi-dash-circle" : "bi-plus-circle")"></i> @(_showWorkOrderOptions ? "بستن فهرست" : "افزودن دستورکار")
                            </button>
                        }
                        @if (_showWorkOrderOptions && CanEdit)
                        {
                            <div id="wpmf-order-options" class="wpmf-order-picker-list" role="listbox" aria-label="انتخاب دستورکار">
                                @if (_loadingOrders)
                                {
                                    <div class="wpmf-combo-empty">در حال بارگذاری دستورکارها…</div>
                                }
                                else if (FilteredWorkOrders.Count == 0)
                                {
                                    <div class="wpmf-combo-empty">دستورکار دیگری برای اتصال در دسترس نیست.</div>
                                }
                                else
                                {
                                    @foreach (var order in FilteredWorkOrders)
                                    {
                                        <button type="button" class="wpmf-order-picker-option" @key="order.Id" @onclick="() => ChooseWorkOrderAsync(order)">
                                            <span class="wpmf-order-picker-icon"><i class="bi bi-clipboard"></i></span>
                                            <span class="wpmf-order-picker-copy"><strong>@order.Number · @order.Title</strong><small>@(string.IsNullOrWhiteSpace(order.ProjectName) ? "بدون پروژه" : order.ProjectName)</small></span>
                                            <span class="badge @(order.Status == "Closed" ? "text-bg-secondary" : "text-bg-success")">@(order.Status == "Closed" ? "بسته" : "باز")</span>
                                        </button>
                                    }
                                }
                            </div>
                            @if (_hasMoreWorkOrders)
                            {
                                <button type="button" class="wpmf-load-more-orders" @onclick="LoadMoreWorkOrdersAsync" disabled="@_loadingOrders">@( _loadingOrders ? "در حال بارگذاری…" : "نمایش دستورکارهای بیشتر")</button>
                            }
                        }
                    @if (NodeWorkOrderIds(SelectedNode).Count > 0)
                    {
                        <div class="wpmf-order-chips">
                            @foreach (var orderId in NodeWorkOrderIds(SelectedNode))
                            {
                                var orderChip = FindWorkOrder(orderId);
                                <span class="wpmf-order-chip @(orderId == _selectedWorkOrderId ? "active" : "")" @key="orderId">
                                    <button type="button" class="wpmf-order-chip-main" @onclick="() => SelectNodeWorkOrderAsync(orderId)">
                                        <i class="bi bi-clipboard-check"></i> @(orderChip is null ? $"#{orderId}" : orderChip.Number)
                                    </button>
                                    @if (CanEdit) { <button type="button" class="wpmf-order-chip-remove" title="قطع اتصال" @onclick="() => UnlinkWorkOrderAsync(orderId)">×</button> }
                                </span>
                            }
                        </div>
                    }
                    @if (_showNodeWorkOrderList && NodeWorkOrderIds(SelectedNode).Count > 1)
                    {
                        <div class="wpmf-node-order-list">
                            <div class="small fw-semibold mb-1">دستورکارهای این گره</div>
                            @foreach (var orderId in NodeWorkOrderIds(SelectedNode))
                            {
                                var row = FindWorkOrder(orderId);
                                <button type="button" class="wpmf-node-order-row" @key="orderId" @onclick="() => SelectNodeWorkOrderAsync(orderId)">
                                    <strong>@(row?.Number ?? $"دستورکار #{orderId}")</strong>
                                    <span>@(row?.Title ?? "برای مشاهده کلیک کن")</span>
                                </button>
                            }
                        </div>
                    }
                    @if (_selectedWorkOrderId is int linkedOrderId && NodeWorkOrderIds(SelectedNode).Contains(linkedOrderId))
                    {
                        var linkedOrder = FindWorkOrder(linkedOrderId);
                        @if (linkedOrder is not null)
                        {
                            <div class="small text-muted mb-2 d-flex justify-content-between align-items-center gap-2 flex-wrap">
                                <span><b>@linkedOrder.Number</b> · @linkedOrder.Title · @(linkedOrder.Status == "Closed" ? "بسته" : "باز")</span>
                                <a class="small" href="@($"/work-orders?open={linkedOrder.Id}")" target="_blank" rel="noopener noreferrer"><i class="bi bi-box-arrow-up-right"></i> باز کردن در تب جدید</a>
                            </div>
                            @if (_loadingChecklist)
                            {
                                <div class="small text-muted py-2">در حال بارگذاری چک‌لیست دستور…</div>
                            }
                            else if (_linkedChecklist.Count == 0)
                            {
                                <div class="wpmf-empty-check">این دستور هنوز چک‌لیست ندارد.</div>
                            }
                            else
                            {
                                <div class="small text-muted mb-2">برای تکمیل مربع را تیک بزن.@(CanReorderChecklist(linkedOrder) ? " برای تغییر ترتیب، ردیف را با دستگیره بکش." : "")</div>
                                @foreach (var item in _linkedChecklist)
                                {
                                    var mayToggle = CanToggleChecklistItem(linkedOrder, item);
                                    var mayReorder = CanReorderChecklist(linkedOrder);
                                    <div class="wpmf-check-row @(mayReorder ? "reorderable" : "") @(item.Id == _dragChecklistItemId ? "dragging" : "") @(item.Id == _checklistDropTargetId ? "drop-target" : "")" @key="item.Id"
                                         draggable="@mayReorder" @ondragstart="() => StartChecklistDrag(item.Id)" @ondragend="ClearChecklistDrag"
                                         @ondragover="() => ChecklistDragOver(item.Id)" @ondragover:preventDefault="true"
                                         @ondrop="() => DropChecklistItem(linkedOrder.Id, item.Id)" @ondrop:preventDefault="true">
                                        @if (mayReorder) { <span class="wpmf-drag-handle" title="برای تغییر ترتیب بکش">⠿</span> }
                                        <input type="checkbox" checked="@item.IsDone" @onchange="e => ToggleWorkOrderItem(linkedOrder.Id, item.Id, e)" disabled="@(!mayToggle)" />
                                        <span class="wpmf-check-text @(item.IsDone ? "done" : "")">@item.Text</span>
                                        @if (item.IsDone && !string.IsNullOrWhiteSpace(item.DoneByName)) { <small class="text-muted">@item.DoneByName</small> }
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <div class="wpmf-empty-check">اطلاعات این دستورکار در دسترس نیست یا مجوز مشاهدهٔ آن را نداری.</div>
                            <a class="small" href="@($"/work-orders?open={linkedOrderId}")" target="_blank" rel="noopener noreferrer">رفتن به دستورکار در تب جدید</a>
                        }
                    }
                    else if (NodeWorkOrderIds(SelectedNode).Count == 0)
                    {
                        <div class="wpmf-empty-check">برای دیدن چک‌لیست اصلی، دستورکارهای موجود را به این گره وصل کن.</div>
                    }
                    </section>
                    <section class="wpmf-inspector-card wpmf-subflow-card">
                        <header class="wpmf-card-heading"><i class="bi bi-diagram-3"></i><span>زیرنگاشت</span><span class="wpmf-card-status">@(SelectedNode.ChildMindFlow is not null ? "ساخته‌شده" : SelectedNode.LinkedMindFlowProjectId.HasValue ? "پیوندشده" : "ندارد")</span></header>
                    @if (SelectedNode.ChildMindFlow is not null)
                    {
                        <a class="wpmf-subflow-link" href="@SubMindFlowHref(SelectedNode.Id)" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-diagram-3"></i> @(CanEdit ? "طراحی" : "مشاهدهٔ") «@SelectedNode.ChildMindFlow.Title» در تب جدید
                        </a>
                    }
                    else if (SelectedNode.LinkedMindFlowProjectId is int linkedMindFlowId)
                    {
                        var linkedMindFlow = FindAccessibleMindFlow(linkedMindFlowId);
                        @if (linkedMindFlow is not null)
                        {
                            <a class="wpmf-subflow-link" href="@($"/work-projects/mindflow?projectId={linkedMindFlow.ProjectId}")" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-diagram-3"></i> @(linkedMindFlow.CanManage && linkedMindFlow.Status == "Open" ? "طراحی" : "مشاهدهٔ") «@linkedMindFlow.Title» در تب جدید
                            </a>
                        }
                        else
                        {
                            <div class="wpmf-empty-check">این زیرمایندفلو برای حساب فعلی قابل مشاهده نیست.</div>
                        }
                        @if (CanEdit)
                        {
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 mt-1" @onclick="UnlinkExistingMindFlow">قطع پیوند</button>
                        }
                    }
                    else if (CanEdit)
                    {
                        <label class="form-label small mb-1">جست‌وجو و پیوند به مایندفلو موجود</label>
                        <div class="wpmf-combobox mb-2">
                            <input class="form-control form-control-sm" role="combobox" aria-expanded="@_showMindFlowOptions" aria-controls="wpmf-mindflow-options"
                                   placeholder="نام یا شمارهٔ پروژه را جست‌وجو کن…" value="@_mindFlowSearch"
                                   @oninput="SearchMindFlows" @onfocus="ShowMindFlowOptions" />
                            @if (_showMindFlowOptions)
                            {
                                <div id="wpmf-mindflow-options" class="wpmf-combo-options" role="listbox">
                                    @if (_mindFlowsLoading) { <div class="wpmf-combo-empty">در حال بارگذاری…</div> }
                                    else if (FilteredMindFlows.Count == 0) { <div class="wpmf-combo-empty">مایندفلوی دیگری در دسترس نیست.</div> }
                                    else
                                    {
                                        @foreach (var flow in FilteredMindFlows)
                                        {
                                            <button type="button" class="wpmf-combo-option" @key="flow.ProjectId" @onclick="() => LinkExistingMindFlow(flow)">
                                                <strong>@flow.Number — @flow.Title</strong>
                                                <small>@(flow.Status == "Closed" ? "بسته · فقط‌خواندنی" : "باز")</small>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateChildMindFlowAsync" disabled="@_saving">
                            <i class="bi bi-plus-circle"></i> ساخت زیرمایندفلوی تازه
                        </button>
                    }
                    </section>
                    @if (CanManageAccess)
                    {
                        <section class="wpmf-access-panel wpmf-inspector-card">
