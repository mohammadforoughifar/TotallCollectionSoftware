        {
            var membersTask = Http.GetFromJsonAsync<List<WorkProjectMindFlowMemberDto>>($"{ShareApiUrl}/members");
            var candidatesTask = FetchMindFlowCandidatesAsync(_memberSearch);
            await Task.WhenAll((Task)membersTask, (Task)candidatesTask);
            var members = await membersTask ?? new();
            var candidates = await candidatesTask ?? new();
            _mindFlowMembers.Clear(); _mindFlowMembers.AddRange(members);
            if (generation == _candidateSearchGeneration) ReplaceCandidates(candidates);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _accessMessage = "فهرست افراد یا دسترسی‌ها بارگذاری نشد؛ شرکت فعال و دسترسی مالک نگاشت را بررسی کن.";
        }
        finally { if (generation == _candidateSearchGeneration) _peopleLoading = false; }
    }
    private async Task SearchMindFlowCandidatesAsync(ChangeEventArgs e)
    {
        _memberSearch = e.Value?.ToString() ?? "";
        _showCandidateOptions = true;
        var generation = ++_candidateSearchGeneration;
        await Task.Delay(250);
        if (generation != _candidateSearchGeneration || !CanManageAccess) return;
        _peopleLoading = true;
        try
        {
            var candidates = await FetchMindFlowCandidatesAsync(_memberSearch);
            if (generation == _candidateSearchGeneration) ReplaceCandidates(candidates);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (generation == _candidateSearchGeneration) _accessMessage = "جست‌وجوی افراد انجام نشد؛ شرکت فعال یا اتصال سرور را بررسی کن.";
        }
        finally { if (generation == _candidateSearchGeneration) _peopleLoading = false; }
    }
    private Task<List<WorkProjectMindFlowUserDto>?> FetchMindFlowCandidatesAsync(string search)
    {
        var url = $"{ShareApiUrl}/candidates?take=100";
        if (!string.IsNullOrWhiteSpace(search)) url += $"&q={Uri.EscapeDataString(search.Trim())}";
        return Http.GetFromJsonAsync<List<WorkProjectMindFlowUserDto>>(url);
    }
    private void ReplaceCandidates(List<WorkProjectMindFlowUserDto> candidates)
    {
        _candidates.Clear(); _candidates.AddRange(candidates);
        foreach (var user in candidates)
            if (_selectedCandidateIds.Contains(user.UserId)) _selectedCandidateNames[user.UserId] = user.Name;
    }
    private void ShowCandidateOptions() => _showCandidateOptions = true;
    private void ToggleCandidate(WorkProjectMindFlowUserDto user)
    {
        if (!CanManageAccess) return;
        if (_selectedCandidateIds.Remove(user.UserId)) _selectedCandidateNames.Remove(user.UserId);
        else
        {
            _selectedCandidateIds.Add(user.UserId);
            _selectedCandidateNames[user.UserId] = user.Name;
        }
    }
    private void RemoveCandidateFromSelection(int userId)
    {
        _selectedCandidateIds.Remove(userId);
        _selectedCandidateNames.Remove(userId);
    }
    private async Task AddMindFlowMemberAsync()
    {
        if (!CanManageAccess || _selectedCandidateIds.Count == 0 || _savingMembers) return;
        var userIds = _selectedCandidateIds.ToList();
        _savingMembers = true;
        _accessMessage = "";
        try
        {
            var response = await Http.PostAsJsonAsync($"{ShareApiUrl}/members",
                new AddWorkProjectMindFlowMembersDto { UserIds = userIds, Role = IsStandalone ? _inviteRole : "Viewer" });
            if (!response.IsSuccessStatusCode) { _accessMessage = await ErrorMessage(response); return; }
            _selectedCandidateIds.Clear(); _selectedCandidateNames.Clear();
            _memberSearch = ""; _showCandidateOptions = false;
            _accessMessage = $"دسترسی ثبت شد برای {userIds.Count} نفر.";
            await LoadMindFlowPeopleAsync();
        }
        catch (HttpRequestException) { _accessMessage = "افزودن افراد انجام نشد؛ اتصال سرور و شرکت فعال را بررسی کن."; }
        finally { _savingMembers = false; }
    }
    private async Task RemoveMindFlowMemberAsync(WorkProjectMindFlowMemberDto member)
    {
        if (!CanManageAccess || !await JS.InvokeAsync<bool>("confirm", $"دسترسی «{member.Name}» به این نگاشت لغو شود؟")) return;
        _accessMessage = "";
        try
        {
            var response = await Http.DeleteAsync($"{ShareApiUrl}/members/{member.UserId}");
            if (!response.IsSuccessStatusCode) { _accessMessage = await ErrorMessage(response); return; }
            _accessMessage = "دسترسی لغو شد.";
            await LoadMindFlowPeopleAsync();
        }
        catch (HttpRequestException) { _accessMessage = "لغو دسترسی انجام نشد؛ اتصال سرور را بررسی کن."; }
    }
    private async Task ChooseWorkOrderAsync(MindFlowWorkOrder order)
    {
        if (!CanEdit || SelectedNode is null || NodeWorkOrderIds(SelectedNode).Contains(order.Id)) return;
        Snapshot();
        SelectedNode.WorkOrderIds ??= new();
        SelectedNode.WorkOrderIds.Add(order.Id);
        SelectedNode.WorkOrderId = null;
        _workOrderCache[order.Id] = order;
        _selectedWorkOrderId = order.Id; _showNodeWorkOrderList = false;
        _showWorkOrderOptions = false; _message = ""; Dirty();
        await LoadLinkedChecklistAsync(force: true);
    }
    private async Task UnlinkWorkOrderAsync(int orderId)
    {
        if (!CanEdit || SelectedNode is null || !NodeWorkOrderIds(SelectedNode).Contains(orderId)) return;
        Snapshot();
        SelectedNode.WorkOrderIds ??= new();
        SelectedNode.WorkOrderIds.RemoveAll(id => id == orderId);
        if (SelectedNode.WorkOrderId == orderId) SelectedNode.WorkOrderId = null;
        var remaining = NodeWorkOrderIds(SelectedNode);
        if (_selectedWorkOrderId == orderId || remaining.Count == 1)
        {
            _selectedWorkOrderId = remaining.Count > 0 ? remaining[0] : null;
            _showNodeWorkOrderList = false;
        }
        if (remaining.Count < 2) _showNodeWorkOrderList = false;
        Dirty();
        await LoadLinkedChecklistAsync(force: true);
    }
    private async Task SelectNodeWorkOrderAsync(int orderId)
    {
        if (SelectedNode is null || !NodeWorkOrderIds(SelectedNode).Contains(orderId)) return;
        _showNodeWorkOrderList = false;
        _selectedWorkOrderId = orderId;
        await EnsureWorkOrderDetailsAsync(new[] { orderId });
        await LoadLinkedChecklistAsync(force: true);
    }
    private async Task OpenNodeWorkOrdersAsync(WorkProjectMindFlowNodeDto node)
    {
        await Select(node.Id);
        var ids = NodeWorkOrderIds(node);
        if (ids.Count == 1)
        {
            await SelectNodeWorkOrderAsync(ids[0]);
            return;
        }
        if (ids.Count > 1)
        {
            _showNodeWorkOrderList = true; _selectedWorkOrderId = null;
            _checklistLoadGeneration++; _linkedChecklist.Clear(); _loadedChecklistOrderId = null; _loadingChecklist = false;
            await EnsureWorkOrderDetailsAsync(ids);
        }
    }
    private async Task EnsureWorkOrderDetailsAsync(IEnumerable<int> ids)
    {
        foreach (var id in ids.Distinct())
        {
            if (_workOrderCache.ContainsKey(id)) continue;
            try
            {
                var order = await Http.GetFromJsonAsync<MindFlowWorkOrder>($"api/workorders/{id}");
                if (order is not null) _workOrderCache[order.Id] = order;
            }
            catch (HttpRequestException) { }
        }
    }
    private async Task ToggleWorkOrderItem(int orderId, int itemId, ChangeEventArgs e)
    {
        var item = _linkedChecklist.FirstOrDefault(x => x.Id == itemId);
        var order = FindWorkOrder(orderId);
        if (item is null || order is null || !CanToggleChecklistItem(order, item)) return;
        var isDone = e.Value is bool b ? b : bool.TryParse(e.Value?.ToString(), out var parsed) && parsed;
        if (item.IsDone == isDone) return;
        try
        {
            var response = await Http.PostAsJsonAsync($"api/workorders/{orderId}/checklist/{itemId}/toggle", new { isDone });
            if (!response.IsSuccessStatusCode) { _message = await ErrorMessage(response); return; }
            _message = "";
            try
            {
                var refreshedOrder = await Http.GetFromJsonAsync<MindFlowWorkOrder>($"api/workorders/{orderId}");
                if (refreshedOrder is not null) _workOrderCache[orderId] = refreshedOrder;
            }
            catch (HttpRequestException) { }
            await LoadProjectOrdersAsync();
            await LoadLinkedChecklistAsync(force: true);
        }
        catch (HttpRequestException) { _message = "ثبت وضعیت انجام نشد؛ اتصال API را بررسی کن."; }
    }
    private MindFlowWorkOrder? FindWorkOrder(int id) => _workOrderCache.TryGetValue(id, out var order) ? order : _projectOrders.FirstOrDefault(o => o.Id == id);
    private static List<int> NodeWorkOrderIds(WorkProjectMindFlowNodeDto? node)
    {
        if (node is null) return new();
        var ids = node.WorkOrderIds?.ToList() ?? new();
        if (node.WorkOrderId is int legacyId && legacyId > 0 && !ids.Contains(legacyId)) ids.Add(legacyId);
        return ids.Where(id => id > 0).Distinct().ToList();
    }
    private bool CanToggleChecklistItem(MindFlowWorkOrder order, MindFlowChecklistItem item)
    {
        var owner = order.OwnerUserId == Auth.UserId;
        var assignee = order.Assignees.Any(a => a.UserId == Auth.UserId);
        return order.Status != "Closed" && (owner || (assignee && !item.IsDone));
    }
    private bool CanReorderChecklist(MindFlowWorkOrder order) => order.Status != "Closed" && order.OwnerUserId == Auth.UserId;
    private void StartChecklistDrag(int itemId)
    {
        if (_linkedChecklist.Any(i => i.Id == itemId)) { _dragChecklistItemId = itemId; _checklistDropTargetId = null; }
    }
    private void ChecklistDragOver(int targetId)
    {
        if (_dragChecklistItemId is not null && targetId != _dragChecklistItemId) _checklistDropTargetId = targetId;
    }
    private void ClearChecklistDrag() { _dragChecklistItemId = null; _checklistDropTargetId = null; }
    private async Task DropChecklistItem(int orderId, int targetId)
    {
        if (_dragChecklistItemId is not int draggedId || draggedId == targetId) { ClearChecklistDrag(); return; }
        var order = FindWorkOrder(orderId);
        var from = _linkedChecklist.FindIndex(i => i.Id == draggedId);
        var to = _linkedChecklist.FindIndex(i => i.Id == targetId);
        if (order is null || !CanReorderChecklist(order) || from < 0 || to < 0) { ClearChecklistDrag(); return; }

        var item = _linkedChecklist[from];
        _linkedChecklist.RemoveAt(from);
        var insertAt = from < to ? to - 1 : to;
        _linkedChecklist.Insert(insertAt, item);
        ClearChecklistDrag();
        try
        {
            var response = await Http.PostAsJsonAsync($"api/workorders/{orderId}/checklist/reorder",
                new { itemIds = _linkedChecklist.Select(i => i.Id).ToList() });
            if (!response.IsSuccessStatusCode)
            {
                _message = await ErrorMessage(response);
                await LoadLinkedChecklistAsync(force: true);
                return;
            }
            _message = "";
        }
        catch (HttpRequestException)
        {
            _message = "تغییر ترتیب ذخیره نشد؛ اتصال سرور را بررسی کن.";
            await LoadLinkedChecklistAsync(force: true);
        }
    }
    private void SetColor(string color)
    {
        if (!CanEdit || SelectedNode is null) return; Snapshot(); var branch = SelectedNode; while (branch.ParentId is Guid p && _map.Nodes.FirstOrDefault(n => n.Id == p) is { ParentId: not null } parent) branch = parent; Recolor(branch.Id, color); Dirty();
    }
    private void Recolor(Guid id, string color) { var node = _map.Nodes.FirstOrDefault(n => n.Id == id); if (node is not null) node.Color = color; foreach (var c in _map.Nodes.Where(n => n.ParentId == id).ToList()) Recolor(c.Id, color); }
    private void OnTitleInput(ChangeEventArgs e) { if (!CanEdit) return; Snapshot(); _map.Title = e.Value?.ToString() ?? ""; var root = _map.Nodes.FirstOrDefault(n => n.ParentId is null); if (root is not null) root.Text = _map.Title; Dirty(); }
    private void OnNodeText(ChangeEventArgs e) { if (!CanEdit || SelectedNode is null) return; Snapshot(); SelectedNode.Text = e.Value?.ToString() ?? ""; Dirty(); }
    private void OnNodeNote(ChangeEventArgs e) { if (!CanEdit || SelectedNode is null) return; Snapshot(); SelectedNode.Note = e.Value?.ToString() ?? ""; Dirty(); }
    private async Task Select(Guid id)
    {
        if (!_map.Nodes.Any(n => n.Id == id)) return;
        var changed = _selectedId != id;
        _selectedId = id; _message = "";
        if (!changed) { await LoadLinkedChecklistAsync(); return; }
        _showWorkOrderOptions = false; _showNodeWorkOrderList = false;
        var ids = NodeWorkOrderIds(SelectedNode);
        _selectedWorkOrderId = ids.Count > 0 ? ids[0] : null;
        await EnsureWorkOrderDetailsAsync(ids);
        await LoadLinkedChecklistAsync(force: true);
    }
