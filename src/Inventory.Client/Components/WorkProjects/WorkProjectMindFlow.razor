        var generation = ++_checklistLoadGeneration;
        _linkedChecklist.Clear(); _loadedChecklistOrderId = orderId;
        if (orderId is null) { _loadingChecklist = false; return; }
        _loadingChecklist = true;
        try
        {
            var rows = await Http.GetFromJsonAsync<List<MindFlowChecklistItem>>($"api/workorders/{orderId}/checklist") ?? new();
            if (generation == _checklistLoadGeneration) _linkedChecklist.AddRange(rows);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            if (generation == _checklistLoadGeneration) _message = "چک‌لیست دستور بارگذاری نشد؛ دسترسی به دستور کار را بررسی کن.";
        }
        finally { if (generation == _checklistLoadGeneration) _loadingChecklist = false; }
