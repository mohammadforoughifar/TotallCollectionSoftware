    private void Dirty() { _dirty = true; _status = "ویرایش نشده"; }
    private void Snapshot() { _undo.Push(JsonSerializer.Serialize(_map)); _redo.Clear(); }
    private void Undo() { if (!CanEdit || _undo.Count == 0) return; _redo.Push(JsonSerializer.Serialize(_map)); Restore(_undo.Pop()); }
    private void Redo() { if (!CanEdit || _redo.Count == 0) return; _undo.Push(JsonSerializer.Serialize(_map)); Restore(_redo.Pop()); }
    private void Restore(string json) { _map = JsonSerializer.Deserialize<WorkProjectMindFlowDto>(json) ?? new(); Normalize(); _selectedId = _map.Nodes.Any(n => n.Id == _selectedId) ? _selectedId : _map.Nodes.FirstOrDefault()?.Id ?? Guid.Empty; Dirty(); }
    private double? GetProgress(Guid id)
    {
        var n = _map.Nodes.FirstOrDefault(x => x.Id == id); if (n is null) return null;
        var linkedProgress = NodeWorkOrderIds(n).Select(FindWorkOrder).Where(order => order is not null).Select(order => order!.OrderProgress).ToList();
        if (linkedProgress.Count > 0) return linkedProgress.Average();
        var children = _map.Nodes.Where(x => x.ParentId == id).Select(x => GetProgress(x.Id)).Where(x => x.HasValue).Select(x => x!.Value).ToList();
        return children.Count == 0 ? null : children.Average();
    }
    private string ProgressSource(WorkProjectMindFlowNodeDto node)
    {
        var linkedIds = NodeWorkOrderIds(node);
        if (linkedIds.Count > 0)
        {
            var orders = linkedIds.Select(FindWorkOrder).Where(order => order is not null).ToList();
            return orders.Count == 0 ? "دستورهای متصل در دسترس نیستند" : $"میانگین پیشرفت {orders.Count} دستور از چک‌لیست اصلی";
        }
        var count = _map.Nodes.Count(c => c.ParentId == node.Id && GetProgress(c.Id).HasValue);
        return count > 0 ? $"میانگین {count} زیرشاخه" : "برای محاسبهٔ پیشرفت، دستور کار وصل کن";
    }
    private static string RingStyle(string color, double value) => $"--ring-color:{color};--ring-p:{Math.Clamp(value, 0, 100).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)}%";
    private int ChildCount(Guid id) => _map.Nodes.Count(n => n.ParentId == id);
    private bool IsVisible(WorkProjectMindFlowNodeDto node) { if (node.ParentId is not Guid p) return true; var parent = _map.Nodes.FirstOrDefault(n => n.Id == p); return parent is not null && !parent.Collapsed && IsVisible(parent); }
    private double? NodeProgress(Guid id) => GetProgress(id);
    private static double Width(WorkProjectMindFlowNodeDto node)
        => Math.Clamp(node.Width ?? (node.ParentId is null ? 250 : Math.Clamp(100 + node.Text.Length * 12, 145, 245)), MinNodeWidth, MaxNodeWidth);
    private static double Height(WorkProjectMindFlowNodeDto node)
        => Math.Clamp(node.Height ?? (node.ParentId is null ? 82 : 62), MinNodeHeight, MaxNodeHeight);
    private void AdjustSelectedNodeSize(double widthDelta, double heightDelta)
    {
        if (!CanEdit || SelectedNode is not { } node) return;
        var width = Math.Clamp(Width(node) + widthDelta, MinNodeWidth, MaxNodeWidth);
        var height = Math.Clamp(Height(node) + heightDelta, MinNodeHeight, MaxNodeHeight);
        if (width == Width(node) && height == Height(node)) return;
        Snapshot();
        node.Width = width; node.Height = height;
        node.X = Math.Clamp(node.X, width / 2 + 4, 1600 - width / 2 - 4);
        node.Y = Math.Clamp(node.Y, height / 2 + 4, 900 - height / 2 - 4);
        Dirty();
    }
    private static string N(double x) => x.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);
    private void ZoomIn() => Zoom = Math.Min(1.7, Zoom + .1);
    private void ZoomOut() => Zoom = Math.Max(.6, Zoom - .1);
    private void Fit() => Zoom = 1;
    private void ToggleFullscreen() => _isFullscreen = !_isFullscreen;

    [JSInvokable]
    public async Task RefreshAfterReturnAsync()
    {
        if (_loading || _saving || _dirty || _loadingOrders || _map.Nodes.Count == 0) return;
        var selectedId = _selectedId;
        try
        {
            var path = NormalizeSubMindFlowPath(SubFlowPath);
            if (path == "invalid") return;
            var url = string.IsNullOrWhiteSpace(path) ? RootMapApiUrl : SubMapApiUrl(path);
            var latest = await Http.GetFromJsonAsync<WorkProjectMindFlowDto>(url);
            if (latest?.Nodes is not { Count: > 0 }) return;
            _map = latest;
            Normalize();
            _selectedId = _map.Nodes.Any(n => n.Id == selectedId)
                ? selectedId : _map.Nodes.FirstOrDefault(n => n.ParentId is null)?.Id ?? Guid.Empty;
            var linkedIds = NodeWorkOrderIds(SelectedNode);
            if (_selectedWorkOrderId is not int currentOrderId || !linkedIds.Contains(currentOrderId))
            {
                var firstLinkedId = linkedIds.FirstOrDefault();
                _selectedWorkOrderId = firstLinkedId > 0 ? firstLinkedId : null;
            }
            await LoadProjectOrdersAsync();
            await LoadLinkedChecklistAsync(force: true);
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException) { }
    }

    [JSInvokable]
    public Task CommitDrag(Guid rootId, List<DragPoint> points, Guid? targetParentId)
    {
        if (!CanEdit || points.Count == 0) return Task.CompletedTask;
        Snapshot(); var moved = points.ToDictionary(p => p.Id); var root = _map.Nodes.FirstOrDefault(n => n.Id == rootId); var target = moved.GetValueOrDefault(rootId);
        var dx = root is null || target is null ? 0 : target.X - root.X; var dy = root is null || target is null ? 0 : target.Y - root.Y;
        foreach (var point in points) if (_map.Nodes.FirstOrDefault(n => n.Id == point.Id) is { } node) { node.X = point.X; node.Y = point.Y; }
        var descendants = new HashSet<Guid> { rootId }; var changed = true;
        while (changed) { changed = false; foreach (var child in _map.Nodes.Where(n => n.ParentId.HasValue && descendants.Contains(n.ParentId.Value))) if (descendants.Add(child.Id)) changed = true; }
        foreach (var id in descendants.Where(id => !moved.ContainsKey(id))) if (_map.Nodes.FirstOrDefault(n => n.Id == id) is { } hidden) { hidden.X += dx; hidden.Y += dy; }
        if (root?.ParentId is not null && targetParentId is Guid nextParentId && !descendants.Contains(nextParentId)
            && _map.Nodes.FirstOrDefault(n => n.Id == nextParentId) is { } nextParent)
        {
            root.ParentId = nextParentId;
            nextParent.Collapsed = false;
        }
        _selectedId = rootId; Dirty(); return InvokeAsync(StateHasChanged);
    }
