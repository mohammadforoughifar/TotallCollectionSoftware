<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Locally hosted PDF.js: .js modules work with standard IIS MIME mappings. -->
    <staticContent>
      <remove fileExtension=".bcmap" />
      <mimeMap fileExtension=".bcmap" mimeType="application/octet-stream" />
      <remove fileExtension=".pfb" />
      <mimeMap fileExtension=".pfb" mimeType="application/octet-stream" />
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
    </staticContent>
    <!-- SignalR WebSocket URLs carry the JWT in access_token. The automation
         JWT contains module permissions and can exceed IIS's default 2048
         character query-string limit. -->
    <security>
      <requestFiltering>
        <!-- بدون محدودیت حجم آپلود/پیوست فایل (IIS): بیشینهٔ مقدار مجاز maxAllowedContentLength -->
        <requestLimits maxQueryString="32768" maxUrl="65536" maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <webSocket enabled="true" />
    <!-- فراخوانی‌های AI (استنتاج CPU) ممکن است چند دقیقه طول بکشند؛ سقف پیش‌فرض IIS دو دقیقه است -->
    <aspNetCore requestTimeout="00:10:00" />
  </system.webServer>
</configuration>
