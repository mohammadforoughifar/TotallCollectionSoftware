<?xml version="1.0" encoding="utf-8"?>
<!--
  پیکربندی NuGet مخصوص این راه‌حل.
  چرا لازم است؟ روی برخی سیستم‌ها (به‌ویژه ویژوال‌استودیو با تنظیمات سازمانی)
  در NuGet.Config سطح ماشین بخش <packageSourceMapping> فعال است و چون هیچ الگویی
  برای بسته‌هایی مثل QuestPDF، PDFsharp، WebPush، SixLabors.ImageSharp و
  Microsoft.Extensions.Identity.Core تعریف نشده، منبع nuget.org نادیده گرفته می‌شود و
  خطای «Unable to resolve …» می‌گیریم.

  این فایل با <clear /> تنظیمات ارث‌بری‌شده را پاک می‌کند و همه بسته‌ها را به nuget.org می‌سپارد.
  اگر فید داخلی/سازمانی دارید، آن را به هر دو بخش packageSources و packageSourceMapping اضافه کنید.

  نکته: بستهٔ TaxCollectData.Library 0.0.34 روی nuget.org نیست (آخرین نسخهٔ عمومی 0.0.4 است)
  و فایل آن در پوشهٔ «packages» ریشهٔ همین مخزن قرار دارد؛ به همین دلیل فید محلی زیر اضافه شده است.
  ⚠️ در ویندوز نام فایل‌ها به بزرگی/کوچکی حروف حساس نیست؛ فایل دومی با نام NuGet.Config نسازید.
-->
<configuration>

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <add key="Moadian-local" value="packages" />
  </packageSources>

  <disabledPackageSources>
    <clear />
  </disabledPackageSources>

  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
    <!-- فقط بستهٔ مودیان از فید محلی خوانده می‌شود؛ بقیهٔ بسته‌ها از nuget.org -->
    <packageSource key="Moadian-local">
      <package pattern="TaxCollectData.Library" />
    </packageSource>
  </packageSourceMapping>

</configuration>
