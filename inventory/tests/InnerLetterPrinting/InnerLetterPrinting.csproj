<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <!-- Real production composition, without API startup, EF, or database access. -->
    <Compile Include="../../src/Inventory.Api/Services/Office/InnerLetterPdfRenderer.cs" Link="InnerLetterPdfRenderer.cs" />
    <Compile Include="../../src/Inventory.Api/Services/Office/InnerLetterheadTemplates.cs" Link="InnerLetterheadTemplates.cs" />
    <Compile Include="../../src/Inventory.Api/Services/Office/Outgoing/HomepaLetterheadLayout.cs" Link="HomepaLetterheadLayout.cs" />
    <PackageReference Include="QuestPDF" Version="2024.12.3" />
    <PackageReference Include="PDFsharp" Version="6.1.1" />
    <Content Include="../../src/Inventory.Api/Resources/fonts/*.ttf" Link="Resources/fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../../src/Inventory.Api/Reports/InnerLetters/Companies/1003/*.mrt" Link="Reports/InnerLetters/Companies/1003/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
