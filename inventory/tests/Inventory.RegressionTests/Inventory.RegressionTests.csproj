<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Match the production WASM client's no-ICU configuration. -->
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Inventory.Shared/Inventory.Shared.csproj" />
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <!-- Exercise the real client adapters without starting a WASM browser. -->
    <Compile Include="../../src/Inventory.Client/Services/RadisHr/*.cs" Link="Client/RadisHr/%(Filename)%(Extension)" />
    <Compile Include="../../src/Inventory.Client/Services/AuthState.cs" Link="Client/AuthState.cs" />
    <Compile Include="../../src/Inventory.Client/Services/ApiClient.cs" Link="Client/ApiClient.cs" />
    <Compile Include="../../src/Inventory.Client/Services/IApiClient.cs" Link="Client/IApiClient.cs" />
    <Compile Include="../../src/Inventory.Client/Services/IInventoryApi.cs" Link="Client/IInventoryApi.cs" />
    <Compile Include="../../src/Inventory.Client/Services/ToastService.cs" Link="Client/ToastService.cs" />
  </ItemGroup>
</Project>
