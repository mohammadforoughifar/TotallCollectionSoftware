@page "/attendance"
@inject ApiClient Api
@inject ToastService Toasts
@inject AuthState Auth
@inject IJSRuntime JS

<section class="page">
    <div class="section-head">
        <div>
            <p class="eyebrow">کارکرد ماهانه</p>
            <h2>ورود و خروج @Fa.MonthLabel(_month)</h2>
            <p class="muted">نتیجه پردازش فایل دستگاه برای @Fa.N(_rows.Count) پرسنل</p>
        </div>
        <div class="head-actions">
            <select @bind="_month" @bind:after="LoadMonthAsync">
                @foreach (var month in _months)
                {
                    <option value="@month">@Fa.MonthLabel(month)</option>
                }
            </select>
            <InputFile OnChange="OnWorkbookSelected" accept=".xlsx,.xls" />
            <button class="button primary" type="button" @onclick="ImportAsync" disabled="@(_file == null || _busy)">ورود فایل دستگاه</button>
            <button class="button primary" type="button" @onclick="RecalculateAsync" disabled="@_busy">صحه‌گذاری داده‌ها</button>
            <button class="button secondary" type="button" @onclick="ExportAsync">خروجی کارکرد</button>
        </div>
    </div>

    <div class="stats attendance-stats">
        <article><span>پرسنل بررسی‌شده</span><strong>@Fa.N(_rows.Count)</strong><small>ماه @Fa.MonthLabel(_month)</small></article>
        <article><span>تطبیق قطعی</span><strong class="ok">@Fa.N(_matched)</strong><small>با فایل دستگاه</small></article>
        <article><span>نیازمند تطبیق</span><strong class="warn">@Fa.N(_rows.Count - _matched)</strong><small>پرداخت متوقف</small></article>
        <article><span>دوره کارکرد</span><strong>@MonthName</strong><small>سال @Fa.N(YearPart)</small></article>
    </div>

    @if (!string.IsNullOrEmpty(_importMessage))
    {
        <p class="form-message success-text" role="status">@_importMessage</p>
    }

    <section class="guard-shift-grid">
        <form class="panel" @onsubmit="SaveGuardCycleAsync" @onsubmit:preventDefault="true">
            <h3>برنامه چرخه‌ای نگهبان</h3>
            <p class="muted">چرخه ثابت: ۲ شیفت صبح ۶–۱۸، ۲ شیفت شب ۱۸–۶ روز بعد، ۲ روز استراحت.</p>
            <label>
                نگهبان
                <select @bind="_cycle.EmployeeCode">
                    <option value="">— انتخاب کنید —</option>
                    @foreach (var employee in _guards)
                    {
                        <option value="@employee.Code">@employee.FullName</option>
                    }
                </select>
            </label>
            <label>تاریخ شروع چرخه <input required placeholder="1405/01/01" @bind="_cycle.StartDate" /></label>
            <label>
                شروع چرخه نفر اول
                <select @bind="_cycle.StartShift">
                    <option value="morning">شیفت صبح</option>
                    <option value="night">شیفت شب</option>
                </select>
            </label>
            <button class="button primary" type="submit">ذخیره و ساخت برنامه</button>
            <p class="form-message">@_cycleMessage</p>
        </form>

        <article class="panel">
            <div class="section-head compact">
                <div><p class="eyebrow">برنامه خودکار</p><h3>نمایش برنامه نگهبان</h3></div>
            </div>
            <div class="guard-calendar-toolbar">
                <button class="icon-button" type="button" @onclick="() => ShiftRoster(-1)">‹</button>
                <strong>@Fa.MonthLabel($"{_rosterYear}/{_rosterMonth:00}")</strong>
                <button class="icon-button" type="button" @onclick="() => ShiftRoster(1)">›</button>
            </div>
            <div class="calendar-weekdays">
                <span>ش</span><span>ی</span><span>د</span><span>س</span><span>چ</span><span>پ</span><span>ج</span>
            </div>
            <div class="guard-roster-calendar">
                @for (var i = 0; i < RosterOffset; i++)
                {
                    <span class="empty-cell"></span>
                }
                @foreach (var day in _roster)
                {
                    <span class="roster-day @RosterClass(day.Shift)">
                        <b>@Fa.N(day.Day)</b>
                        <i>@day.Shift</i>
                    </span>
                }
            </div>
            <div class="guard-roster-legend">
                <span class="roster-morning">صبح ۰۶:۰۰–۱۸:۰۰</span>
                <span class="roster-night">شب ۱۸:۰۰–۰۶:۰۰</span>
                <span class="roster-rest">استراحت</span>
            </div>
        </article>
    </section>

    <form class="panel manual-punch-form" @onsubmit="SavePunchAsync" @onsubmit:preventDefault="true">
        <h3>درخواست ثبت دستی ورود یا خروج</h3>
        <p class="muted">این درخواست تا قبل از تأیید مدیر اداری در محاسبات اعمال نمی‌شود و رکورد دستگاه را حذف یا بازنویسی نمی‌کند.</p>
        <label>
            پرسنل
            <select required @bind="_punch.Employee">
                <option value="">— انتخاب کنید —</option>
                @foreach (var employee in _employees)
                {
                    <option value="@employee.Code">@employee.FullName</option>
                }
            </select>
        </label>
        <label>تاریخ <input required placeholder="1405/03/01" @bind="_punch.Date" /></label>
        <label>ساعت <input required type="time" value="@_punch.Time" @onchange="e => _punch.Time = Text(e)" /></label>
        <label>
            نوع تردد
            <select required @bind="_punch.Type">
                <option value="entry">ورود</option>
                <option value="exit">خروج</option>
            </select>
        </label>
        <label>
            علت ثبت دستی
            <select required @bind="_punchReason">
                <option value="">انتخاب کنید</option>
                <option>خرابی دستگاه</option>
                <option>فراموشی ثبت تردد</option>
                <option>قطعی برق یا شبکه</option>
                <option>مأموریت خارج شرکت</option>
                <option>سایر</option>
            </select>
        </label>
        <label class="wide">توضیحات <textarea required rows="2" @bind="_punchNote"></textarea></label>
        <button class="button primary" type="submit">ثبت درخواست اصلاحیه</button>
        <p class="form-message">@_punchMessage</p>
    </form>

    <article class="panel correction-guide">
        <h3>مسیر اصلاح دستی حضور و غیاب</h3>
        <ol>
            <li>نگهبانی درخواست ورود/خروج دستی را با علت و توضیحات ثبت می‌کند.</li>
            <li>مدیر اداری درخواست را در جدول «سوابق اصلاحیه» بررسی و تأیید یا رد می‌کند.</li>
            <li>فقط درخواست تأییدشده در محاسبات اعمال می‌شود؛ رکورد اصلی دستگاه حذف یا بازنویسی نمی‌شود.</li>
        </ol>
    </article>

    <article class="panel review-panel">
        <div class="section-head compact">
            <div><p class="eyebrow">سوابق اصلاحیه</p><h3>درخواست‌های ثبت دستی تردد</h3></div>
            <span class="badge">@Fa.N(_punches.Count) رکورد</span>
        </div>
        <div class="table-wrap">
            <table>
                <thead>
                    <tr><th>پرسنل</th><th>تاریخ و ساعت</th><th>نوع</th><th>علت و توضیحات</th><th>ثبت‌کننده / زمان ثبت</th><th>وضعیت</th><th>عملیات اداری</th></tr>
                </thead>
                <tbody>
                    @foreach (var punch in _punches)
                    {
                        <tr>
                            <td>@NameOf(punch.Employee)</td>
                            <td>@Fa.N(punch.Date) — @Fa.N(punch.Time)</td>
                            <td>@(punch.Type == "entry" ? "ورود" : "خروج")</td>
                            <td>@punch.Reason</td>
                            <td>@punch.RequestedBy</td>
                            <td><span class="badge @StatusClass(punch.Status)">@StatusLabel(punch.Status)</span></td>
                            <td class="row-actions">
                                @if (punch.Status == "pending" && CanReview)
                                {
                                    <button type="button" @onclick="() => ReviewAsync(punch, true)">تأیید</button>
                                    <button type="button" class="danger" @onclick="() => ReviewAsync(punch, false)">رد</button>
                                }
                                else
                                {
                                    <span class="muted">@punch.ReviewedBy</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_punches.Count == 0)
        {
            <p class="empty">هنوز اصلاحیه دستی ثبت نشده است.</p>
        }
    </article>

    <form class="panel leave-mission-form" @onsubmit="SaveLeaveAsync" @onsubmit:preventDefault="true">
        <h3>ثبت مرخصی و مأموریت پرسنل</h3>
        <label>
            پرسنل
            <select required @bind="_leave.Employee">
                <option value="">— انتخاب کنید —</option>
                @foreach (var employee in _employees)
                {
                    <option value="@employee.Code">@employee.FullName</option>
                }
            </select>
        </label>
        <label>
            نوع درخواست
            <select @bind="_leave.Type">
                <option>مرخصی ساعتی</option>
                <option>مرخصی روزانه</option>
                <option>مأموریت ساعتی</option>
                <option>مأموریت روزانه</option>
            </select>
        </label>
        <label>تاریخ <input required placeholder="1405/03/01" @bind="_leave.Date" /></label>
        @if (_leave.Type.Contains("ساعتی"))
        {
            <label class="hourly-field">از ساعت <input required type="time" value="@_leave.From" @onchange="e => _leave.From = Text(e)" /></label>
            <label class="hourly-field">تا ساعت <input required type="time" value="@_leave.To" @onchange="e => _leave.To = Text(e)" /></label>
        }
        <div class="form-actions">
            <button class="button primary" type="submit">ثبت درخواست</button>
        </div>
        <p class="form-message">@_leaveMessage</p>
    </form>

    <section>
        <article class="panel review-panel">
            <div class="section-head compact">
                <div><p class="eyebrow">کنترل ثبت دستی</p><h3>مرخصی‌ها و مأموریت‌های ثبت‌شده</h3></div>
                <span class="badge">@Fa.N(_leaves.Count) رکورد</span>
            </div>
            <p class="muted">هر ثبت بلافاصله اینجا نمایش داده می‌شود. در صورت اشتباه از دکمه حذف استفاده کنید.</p>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>پرسنل</th><th>نوع</th><th>تاریخ</th><th>بازه زمانی</th><th>ثبت‌کننده</th><th>عملیات</th></tr></thead>
                    <tbody>
                        @foreach (var record in _leaves)
                        {
                            <tr>
                                <td>@NameOf(record.Employee)</td>
                                <td>@record.Type</td>
                                <td>@Fa.N(record.Date)</td>
                                <td>@(string.IsNullOrEmpty(record.From) ? "تمام روز" : $"{Fa.N(record.From)} — {Fa.N(record.To)}")</td>
                                <td>@record.RegisteredBy</td>
                                <td class="row-actions">
                                    <button type="button" class="danger" @onclick="() => DeleteLeaveAsync(record)">حذف</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_leaves.Count == 0)
            {
                <p class="empty">هنوز مرخصی یا مأموریتی ثبت نشده است.</p>
            }
        </article>

        <article class="panel review-panel">
            <div class="section-head compact">
                <div><p class="eyebrow">کنترل فایل دستگاه</p><h3>ورود و خروج‌های واردشده</h3></div>
                <span class="badge">@Fa.N(_days.Count) رکورد</span>
            </div>
            <p class="muted">ورودی‌های تکراری نادیده گرفته می‌شوند و اطلاعات قبلی، مرخصی‌ها و مأموریت‌ها بازنویسی نخواهند شد.</p>
            <label class="device-person-filter">
                نمایش پرسنل
                <select @bind="_deviceFilter" @bind:after="LoadDaysAsync">
                    <option value="">ابتدا نام پرسنل را انتخاب کنید</option>
                    @foreach (var employee in _employees)
                    {
                        <option value="@employee.Code">@employee.FullName</option>
                    }
                </select>
            </label>
            <div class="table-wrap">
                <table>
                    <thead><tr><th>ردیف</th><th>کد پرسنلی</th><th>نام</th><th>تاریخ</th><th>اولین تردد</th><th>آخرین تردد</th><th>حضور</th></tr></thead>
                    <tbody>
                        @{ var index = 0; }
                        @foreach (var day in _days)
                        {
                            index++;
                            <tr>
                                <td>@Fa.N(index)</td>
                                <td>@Fa.N(day.Code)</td>
                                <td>@day.Name</td>
                                <td>@Fa.N(day.Date)</td>
                                <td>@Fa.N(day.First)</td>
                                <td>@Fa.N(day.Last)</td>
                                <td>@Fa.N(Hm(day.Presence))</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (_days.Count == 0)
            {
                <p class="empty">برای مشاهده سوابق، نام پرسنل را انتخاب کنید.</p>
            }
        </article>
    </section>

    <div class="table-wrap">
        <table class="attendance-table">
            <thead>
                <tr>
                    <th>کد</th><th>نام</th><th>کد دستگاه</th><th>وضعیت تطبیق</th><th>حضور</th>
                    <th>مرخصی ساعتی</th><th>ماموریت</th><th>کسرکار</th><th>اضافه‌کار مجاز</th><th>اضافه‌کار غیرمجاز</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in _rows)
                {
                    <tr>
                        <td>@Fa.N(row.Code)</td>
                        <td>@row.Name</td>
                        <td>@Fa.N(row.DeviceCode)</td>
                        <td>@(string.IsNullOrEmpty(row.Status) ? "تطبیق قطعی" : row.Status)</td>
                        <td>@Fa.N(row.Presence)</td>
                        <td>@Fa.N(row.Leave)</td>
                        <td>@Fa.N(row.Mission)</td>
                        <td>@Fa.N(row.Shortfall)</td>
                        <td>@Fa.N(row.Ot)</td>
                        <td>@Fa.N(row.UnauthorizedOt)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (_rows.Count == 0)
    {
        <p class="empty">برای این ماه هنوز کارکردی محاسبه نشده است.</p>
    }
</section>

@code {
    private List<Employee> _employees = new();
    private List<string> _months = new();
    private List<PayrollRow> _rows = new();
    private List<AttendanceDay> _days = new();
    private List<LeaveMission> _leaves = new();
    private List<ManualPunch> _punches = new();
    private List<GuardCycle> _cycles = new();
    private List<RosterDay> _roster = new();

    private GuardCycle _cycle = new();
    private ManualPunch _punch = new();
    private LeaveMission _leave = new() { Type = "مرخصی ساعتی" };

    private string _month = "";
    private string _deviceFilter = "";
    private string _punchReason = "", _punchNote = "";
    private string _importMessage = "", _cycleMessage = "", _punchMessage = "", _leaveMessage = "";
    private IBrowserFile? _file;
    private bool _busy;
    private int _rosterYear, _rosterMonth, _matched;

    private record RosterDay(int Day, string Shift);

    private bool CanReview => Auth.UserKey is "hr" or "ceo";
    private int YearPart => int.TryParse(_month.Split('/').FirstOrDefault(), out var y) ? y : PersianCalendarUtil.Today().Jy;
    private string MonthName
    {
        get
        {
            var parts = _month.Split('/');
            return parts.Length == 2 && int.TryParse(parts[1], out var m) && m >= 1 && m <= 12 ? Fa.MonthNames[m - 1] : "—";
        }
    }
    private int RosterOffset => PersianCalendarUtil.WeekdayIndex(_rosterYear, _rosterMonth, 1);

    private IEnumerable<Employee> _guards => _employees.Where(e => e.Unit.Contains("نگهبان") || e.WorkStation.Contains("نگهبان"));

    protected override async Task OnInitializedAsync()
    {
        var today = PersianCalendarUtil.Today();
        _rosterYear = today.Jy;
        _rosterMonth = today.Jm;

        _employees = await Api.GetListAsync<Employee>("api/employees");
        _months = await Api.GetListAsync<string>("api/attendance/months");
        if (_months.Count == 0) _months.Add(PersianCalendarUtil.DateKey(today.Jy, today.Jm, 1)[..7]);
        _month = _months.Count > 0 ? _months[^1] : "";

        _cycles = await Api.GetListAsync<GuardCycle>("api/attendance/guard-cycles");
        await LoadMonthAsync();
        await LoadReviewAsync();
        BuildRoster();
    }

    private async Task LoadMonthAsync()
    {
        _rows = await Api.GetListAsync<PayrollRow>($"api/payroll/month/{_month}");
        _matched = _rows.Count(r => string.IsNullOrEmpty(r.Status) || r.Status.Contains("قطعی"));
        await LoadDaysAsync();
    }

    private async Task LoadDaysAsync()
    {
        if (string.IsNullOrEmpty(_deviceFilter)) { _days = new(); return; }
        _days = await Api.GetListAsync<AttendanceDay>($"api/attendance/days?month={_month}&code={_deviceFilter}");
    }

    private async Task LoadReviewAsync()
    {
        _punches = await Api.GetListAsync<ManualPunch>("api/attendance/punches");
        _leaves = await Api.GetListAsync<LeaveMission>($"api/attendance/leaves?month={_month}");
    }

    private void OnWorkbookSelected(InputFileChangeEventArgs args) => _file = args.File;

    private async Task ImportAsync()
    {
        if (_file == null) return;
        _busy = true;

        using var content = new MultipartFormDataContent();
        using var stream = _file.OpenReadStream(30 * 1024 * 1024);
        using var memory = new MemoryStream();
        await stream.CopyToAsync(memory);
        var part = new ByteArrayContent(memory.ToArray());
        part.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
            "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet");
        content.Add(part, "file", _file.Name);

        var result = await Api.PostFormAsync<AttendanceImportResult>("api/attendance/import-workbook", content);
        _busy = false;

        if (result != null)
        {
            _importMessage = $"{Fa.N(result.Rows)} ردیف خوانده شد؛ {Fa.N(result.Inserted)} رکورد جدید ثبت و {Fa.N(result.Ignored)} رکورد تکراری نادیده گرفته شد ({Fa.N(result.From)} تا {Fa.N(result.To)}).";
            Toasts.Success("فایل دستگاه با موفقیت بارگذاری شد.");
            _months = await Api.GetListAsync<string>("api/attendance/months");
            await LoadMonthAsync();
        }
    }

    private async Task RecalculateAsync()
    {
        _busy = true;
        var ok = await Api.SendAsync(HttpMethod.Post, $"api/attendance/recalculate?month={_month}");
        _busy = false;
        if (ok) await LoadMonthAsync();
    }

    private async Task ExportAsync()
    {
        var lines = new List<string> { "کد,نام,کد دستگاه,وضعیت,حضور,مرخصی,مأموریت,کسرکار,اضافه‌کار مجاز,اضافه‌کار غیرمجاز" };
        lines.AddRange(_rows.Select(r =>
            string.Join(',', r.Code, r.Name, r.DeviceCode, string.IsNullOrEmpty(r.Status) ? "تطبیق قطعی" : r.Status,
                r.Presence, r.Leave, r.Mission, r.Shortfall, r.Ot, r.UnauthorizedOt)));
        var bytes = System.Text.Encoding.UTF8.GetPreamble()
            .Concat(System.Text.Encoding.UTF8.GetBytes(string.Join('\n', lines))).ToArray();
        await JS.InvokeVoidAsync("radisInterop.downloadFile",
            $"RADIS-Attendance-{_month.Replace('/', '-')}.csv", "text/csv", Convert.ToBase64String(bytes));
    }

    private async Task SaveGuardCycleAsync()
    {
        if (string.IsNullOrEmpty(_cycle.EmployeeCode)) { _cycleMessage = "نگهبان را انتخاب کنید."; return; }
        var ok = await Api.SendAsync(HttpMethod.Post, "api/attendance/guard-cycles", _cycle);
        _cycleMessage = ok ? "چرخهٔ نگهبانی ذخیره شد." : "ذخیره‌سازی انجام نشد.";
        if (ok)
        {
            _cycles = await Api.GetListAsync<GuardCycle>("api/attendance/guard-cycles");
            BuildRoster();
        }
    }

    private void ShiftRoster(int delta)
    {
        _rosterMonth += delta;
        if (_rosterMonth > 12) { _rosterMonth = 1; _rosterYear++; }
        if (_rosterMonth < 1) { _rosterMonth = 12; _rosterYear--; }
        BuildRoster();
    }

    private void BuildRoster()
    {
        var cycle = _cycles.FirstOrDefault(c => c.EmployeeCode == _cycle.EmployeeCode) ?? _cycles.FirstOrDefault();
        var days = PersianCalendarUtil.CalendarMonthDays(_rosterYear, _rosterMonth);
        _roster = new List<RosterDay>();

        for (var day = 1; day <= days; day++)
        {
            var date = PersianCalendarUtil.DateKey(_rosterYear, _rosterMonth, day);
            var shift = AttendanceEngine.CycleFor(cycle, date);
            _roster.Add(new RosterDay(day, shift?.Type ?? "—"));
        }
    }

    private static string RosterClass(string shift) => shift switch
    {
        "صبح" => "roster-morning",
        "شب" => "roster-night",
        "استراحت" => "roster-rest",
        _ => ""
    };

    private async Task SavePunchAsync()
    {
        _punch.Reason = string.IsNullOrEmpty(_punchNote) ? _punchReason : $"{_punchReason} — {_punchNote}";
        var response = await Api.PostAsync<IdResponse>("api/attendance/punches", _punch);
        if (response != null)
        {
            _punchMessage = response.Message;
            Toasts.Success(response.Message);
            _punch = new ManualPunch();
            _punchReason = _punchNote = "";
            await LoadReviewAsync();
        }
    }

    private async Task ReviewAsync(ManualPunch punch, bool approve)
    {
        var ok = await Api.SendAsync(HttpMethod.Post, $"api/attendance/punches/{punch.Id}/review?approve={approve.ToString().ToLowerInvariant()}");
        if (ok) await LoadReviewAsync();
    }

    private async Task SaveLeaveAsync()
    {
        if (!_leave.Type.Contains("ساعتی")) { _leave.From = ""; _leave.To = ""; }
        var response = await Api.PostAsync<IdResponse>("api/attendance/leaves", _leave);
        if (response != null)
        {
            _leaveMessage = response.Message;
            Toasts.Success(response.Message);
            _leave = new LeaveMission { Type = "مرخصی ساعتی" };
            await LoadReviewAsync();
        }
    }

    private async Task DeleteLeaveAsync(LeaveMission record)
    {
        if (await Api.DeleteAsync($"api/attendance/leaves/{record.Id}"))
        {
            Toasts.Success("رکورد حذف شد.");
            await LoadReviewAsync();
        }
    }

    private static string Text(ChangeEventArgs args) => args.Value?.ToString() ?? "";

    private string NameOf(string code) =>
        _employees.FirstOrDefault(e => e.Code == code)?.FullName ?? code;

    private static string Hm(int minutes) => AttendanceEngine.Hm(minutes);

    private static string StatusLabel(string status) => status switch
    {
        "approved" => "تأییدشده",
        "rejected" => "ردشده",
        _ => "در انتظار بررسی"
    };

    private static string StatusClass(string status) => status switch
    {
        "approved" => "ok",
        "rejected" => "danger",
        _ => "warn"
    };
}
