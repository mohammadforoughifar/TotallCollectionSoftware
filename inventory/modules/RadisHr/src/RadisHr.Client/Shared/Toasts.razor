@implements IDisposable
@inject ToastService Svc

<div class="toast-stack">
    @foreach (var toast in Svc.Items.ToList())
    {
        <div class="toast @toast.Kind" @onclick="() => Svc.Dismiss(toast)">@toast.Message</div>
    }
</div>

@code {
    protected override void OnInitialized() => Svc.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Svc.Changed -= OnChanged;
}
