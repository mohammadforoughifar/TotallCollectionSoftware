@inject ApiClient Api
@inject ToastService Toasts

<div class="modal-backdrop" @onclick="Close">
    <div class="modal-card" @onclick:stopPropagation="true">
        <h3>تغییر رمز عبور</h3>
        <p class="muted">رمز جدید باید حداقل ۶ نویسه باشد.</p>
        <div class="form-grid">
            <label>حساب کاربری<input value="@UserKey" readonly /></label>
            <label>رمز فعلی<input type="password" @bind="_current" /></label>
            <label>رمز جدید<input type="password" @bind="_next" /></label>
            <label>تکرار رمز جدید<input type="password" @bind="_confirm" /></label>
        </div>
        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="error">@_error</p>
        }
        <div class="head-actions">
            <button type="button" @onclick="SubmitAsync" disabled="@_busy">ثبت رمز جدید</button>
            <button type="button" class="button secondary" @onclick="Close">انصراف</button>
        </div>
    </div>
</div>

@code {
    [Parameter] public string UserKey { get; set; } = "";
    [Parameter] public EventCallback OnClose { get; set; }

    private string _current = "", _next = "", _confirm = "", _error = "";
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = "";
        if (_next.Length < 6) { _error = "رمز جدید باید حداقل ۶ نویسه باشد."; return; }
        if (_next != _confirm) { _error = "تکرار رمز جدید مطابقت ندارد."; return; }

        _busy = true;
        var ok = await Api.SendAsync(HttpMethod.Post, "api/auth/change-password",
            new ChangePasswordRequest(UserKey, _current, _next));
        _busy = false;

        if (ok) await Close();
    }

    private Task Close() => OnClose.InvokeAsync();
}
