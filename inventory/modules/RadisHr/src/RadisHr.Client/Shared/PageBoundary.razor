@* 
    محافظ خطای صفحه — اگر رندر یک صفحه با استثنا مواجه شود، به‌جای سفید شدن کل برنامه
    یک پیام خوانا نمایش می‌دهد و امکان تلاش دوباره می‌دهد.
*@
<ErrorBoundary @ref="_boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="error">
        <section class="page">
            <article class="panel">
                <div class="section-head compact">
                    <div>
                        <p class="eyebrow">خطای نمایش صفحه</p>
                        <h3>این بخش به‌درستی بارگذاری نشد</h3>
                    </div>
                    <button class="button secondary" type="button" @onclick="Retry">تلاش دوباره</button>
                </div>
                <p class="muted">
                    اطلاعات این صفحه ناقص یا در دسترس نبود. اگر مشکل ادامه داشت،
                    از اتصال به سرویس و کامل بودن داده‌های پایه مطمئن شوید.
                </p>
                <p class="form-message" role="status">@error.Message</p>
            </article>
        </section>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ErrorBoundary? _boundary;

    /// <summary>هنگام جابه‌جایی بین صفحه‌ها، وضعیت خطا پاک می‌شود.</summary>
    protected override void OnParametersSet() => _boundary?.Recover();

    private void Retry() => _boundary?.Recover();
}
