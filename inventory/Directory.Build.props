<Project>
  <PropertyGroup>
    <!-- .NET 8 uses C# 12. Do not use latest: C# 14 can bind array
         extension calls to Span overloads that .NET 8 expression interpreters cannot execute. -->
    <LangVersion>12.0</LangVersion>
    <!--
      CS0006 Metadata file '...\\obj\\Debug\\net8.0\\ref\\*.dll' could not be found
      اسمبلی مرجع (ref) اگر مسیر پروژه پرانتز/فاصله داشته باشد (مثل Downloads\\... (2)\\)
      یا بیلد موازی قبل از اتمام Shared اجرا شود، ساخته نمی‌شود.
      وابسته‌ها باید همان DLL اصلی را مرجع کنند.
    -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
