<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <!-- Let the SDK produce and track obj/<Configuration>/<TFM>/ref/*.dll.
         ProjectReference builds Shared before Api/Client, including in Visual Studio.
         Never copy an implementation DLL into ref or disable reference assemblies. -->
    <ProduceReferenceAssembly>true</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
</Project>
