@code {
    [Parameter] public int? ReportId { get; set; }

    private RsCatalogDto catalog = new();
    private RsShareTargetsDto targets = new();
    private List<RsReportDto> myReports = new();
    private RsQueryDto query = new();
    private RsResultDto? result;

    private int reportId;
    private string name = "";
    private string? description;
    private RsVisibility visibility = RsVisibility.Private;
    private List<RsUserShareDto> userShares = new();
    private List<RsRoleShareDto> roleShares = new();
    private string? userSearch;

    private bool loading = true, running, saving, dirty;
    private bool canDesign => catalog.CanDesign;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanSee("ReportStudio")) { loading = false; return; }
        try
        {
            catalog = await Api.GetCatalogAsync() ?? new();
            targets = await Api.GetShareTargetsAsync() ?? new();
            myReports = await Api.ListAsync() ?? new();
        }
        catch (Exception ex) { Toast.Error("بارگذاری گزارش‌ساز ناموفق بود: " + ex.Message); }
        loading = false;

        if (ReportId is > 0) await LoadReportAsync(ReportId.Value);
    }

    // ---------------- جدول‌ها ----------------
    private IEnumerable<RsJoinPathDto> AvailableJoins
    {
        get
        {
            var present = query.Tables.Select(t => t.TableKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
            return catalog.Joins.Where(j => present.Contains(j.FromTable) && !present.Contains(j.ToTable));
        }
    }

    private void AddTable(string tableKey, string? joinKey)
    {
        if (query.Tables.Any(t => t.TableKey == tableKey)) return;
        query.Tables.Add(new RsQueryTableDto
        {
            TableKey = tableKey,
            JoinKey = joinKey,
            JoinKind = RsJoinKind.Left
        });
        MarkDirty();
    }

    private void RemoveTable(int idx)
    {
        if (idx < 0 || idx >= query.Tables.Count) return;
        var removed = query.Tables[idx].TableKey;

        // حذف جدول اصلی = پاک‌کردن کل طراحی (چون بقیه به آن وابسته‌اند)
        if (idx == 0) { query.Tables.Clear(); query.Columns.Clear(); query.Filters.Clear(); query.Sorts.Clear(); }
        else
        {
            query.Tables.RemoveAt(idx);
            // جدول‌هایی که از این جدول جوین خورده‌اند هم باید بروند
            var gone = true;
            while (gone)
            {
                gone = false;
                var present = query.Tables.Select(t => t.TableKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
                for (var i = query.Tables.Count - 1; i > 0; i--)
                {
                    var j = catalog.Joins.FirstOrDefault(x => x.Key == query.Tables[i].JoinKey);
                    if (j is null || !present.Contains(j.FromTable))
                    {
                        query.Tables.RemoveAt(i);
                        gone = true;
                        break;
                    }
                }
            }
            var live = query.Tables.Select(t => t.TableKey).ToHashSet(StringComparer.OrdinalIgnoreCase);
            query.Columns.RemoveAll(c => !live.Contains(TableOf(c.FieldKey)));
            query.Filters.RemoveAll(f => !live.Contains(TableOf(f.FieldKey)));
            query.Sorts.RemoveAll(s => !live.Contains(TableOf(s.FieldKey)));
        }
        MarkDirty();
    }

    private void SetJoinKind(int idx, string? v)
    {
        if (idx <= 0 || idx >= query.Tables.Count) return;
        query.Tables[idx].JoinKind = v == "0" ? RsJoinKind.Inner : RsJoinKind.Left;
        MarkDirty();
    }

    private static string TableOf(string fieldKey)
    {
        var d = fieldKey.IndexOf('.');
        return d <= 0 ? "" : fieldKey[..d];
    }

    // ---------------- ستون‌ها ----------------
    private RsFieldDto? FindField(string key) =>
        catalog.Tables.SelectMany(t => t.Fields)
            .FirstOrDefault(f => f.Key.Equals(key, StringComparison.OrdinalIgnoreCase));

    private bool IsUsed(string key) =>
        query.Columns.Any(c => c.FieldKey.Equals(key, StringComparison.OrdinalIgnoreCase));

    private void AddColumn(RsFieldDto f)
    {
        if (IsUsed(f.Key)) return;
        query.Columns.Add(new RsColumnDto
        {
            FieldKey = f.Key,
            Order = query.Columns.Count,
            // سنجه‌ها به‌صورت پیش‌فرض مجموع می‌گیرند تا کاربر تازه‌کار سریع به نتیجه برسد
            Agg = f.Aggregatable && !f.Groupable ? RsAgg.Sum : RsAgg.None
        });
        MarkDirty();
    }

    private void RemoveColumn(int i)
    {
        if (i < 0 || i >= query.Columns.Count) return;
        var key = query.Columns[i].FieldKey;
        query.Columns.RemoveAt(i);
        query.Sorts.RemoveAll(s => s.FieldKey == key);
        for (var k = 0; k < query.Columns.Count; k++) query.Columns[k].Order = k;
        MarkDirty();
    }

    private void SetAgg(int i, string? v)
    {
        if (i < 0 || i >= query.Columns.Count) return;
        query.Columns[i].Agg = int.TryParse(v, out var n) ? (RsAgg)n : RsAgg.None;
        MarkDirty();
    }

    private void SetBucket(int i, string? v)
    {
        if (i < 0 || i >= query.Columns.Count) return;
        query.Columns[i].Bucket = int.TryParse(v, out var n) ? (RsDateBucket)n : RsDateBucket.None;
        MarkDirty();
    }

    private void SetLabel(int i, string? v)
    {
        if (i < 0 || i >= query.Columns.Count) return;
        query.Columns[i].Label = string.IsNullOrWhiteSpace(v) ? null : v.Trim();
        MarkDirty();
    }

    private void ToggleSort(string fieldKey)
    {
        var s = query.Sorts.FirstOrDefault(x => x.FieldKey == fieldKey);
        if (s is null) query.Sorts.Add(new RsSortDto { FieldKey = fieldKey, Desc = false });
        else if (!s.Desc) s.Desc = true;
        else query.Sorts.Remove(s);
        MarkDirty();
    }

    private string SortIcon(string fieldKey)
    {
        var s = query.Sorts.FirstOrDefault(x => x.FieldKey == fieldKey);
        return s is null ? "bi-arrow-down-up" : s.Desc ? "bi-sort-down" : "bi-sort-up";
    }

    // ---------------- فیلترها ----------------
    private void AddFilter() { query.Filters.Add(new RsFilterDto()); MarkDirty(); }
    private void RemoveFilter(int i) { if (i >= 0 && i < query.Filters.Count) { query.Filters.RemoveAt(i); MarkDirty(); } }

    private void SetFilterField(int i, string? v)
    {
        if (i < 0 || i >= query.Filters.Count) return;
        query.Filters[i].FieldKey = v ?? "";
        query.Filters[i].Value = null;
        query.Filters[i].Value2 = null;
        var f = FindField(v ?? "");
        query.Filters[i].Op = OpsFor(f).FirstOrDefault();
        MarkDirty();
    }

    private void SetFilterOp(int i, string? v)
    {
        if (i < 0 || i >= query.Filters.Count) return;
        query.Filters[i].Op = int.TryParse(v, out var n) ? (RsOp)n : RsOp.Eq;
        MarkDirty();
    }

    private void SetFilterValue(int i, string? v)
    {
        if (i < 0 || i >= query.Filters.Count) return;
        query.Filters[i].Value = v; MarkDirty();
    }

    private void SetFilterValue2(int i, string? v)
    {
        if (i < 0 || i >= query.Filters.Count) return;
        query.Filters[i].Value2 = v; MarkDirty();
    }

    private void SetAndOr(int i, string? v)
    {
        if (i < 0 || i >= query.Filters.Count) return;
        query.Filters[i].OrWithPrevious = v == "or"; MarkDirty();
    }

    private void SetPrompt(int i, bool on)
    {
        if (i < 0 || i >= query.Filters.Count) return;
        query.Filters[i].IsPrompt = on; MarkDirty();
    }

    private static List<RsOp> OpsFor(RsFieldDto? f) => f?.Type switch
    {
        RsFieldType.Text => new() { RsOp.Contains, RsOp.Eq, RsOp.Ne, RsOp.StartsWith, RsOp.EndsWith, RsOp.IsNull, RsOp.NotNull },
        RsFieldType.Number or RsFieldType.Money => new() { RsOp.Eq, RsOp.Ne, RsOp.Gt, RsOp.Gte, RsOp.Lt, RsOp.Lte, RsOp.Between },
        RsFieldType.Date => new() { RsOp.DateRange, RsOp.Eq, RsOp.Gte, RsOp.Lte, RsOp.Between, RsOp.IsNull, RsOp.NotNull },
        RsFieldType.Bool => new() { RsOp.Eq, RsOp.Ne },
        RsFieldType.Enum => new() { RsOp.Eq, RsOp.Ne },
        _ => new() { RsOp.Eq }
    };

    private static string OpFa(RsOp op) => op switch
    {
        RsOp.Eq => "برابر", RsOp.Ne => "نابرابر",
        RsOp.Gt => "بزرگ‌تر از", RsOp.Gte => "بزرگ‌تر یا مساوی",
        RsOp.Lt => "کوچک‌تر از", RsOp.Lte => "کوچک‌تر یا مساوی",
        RsOp.Contains => "شامل", RsOp.StartsWith => "شروع با", RsOp.EndsWith => "پایان با",
        RsOp.In => "یکی از", RsOp.Between => "بین",
        RsOp.IsNull => "خالی", RsOp.NotNull => "پر",
        RsOp.DateRange => "بازهٔ زمانی",
        _ => op.ToString()
    };

    // ---------------- نمایش ----------------
    private void SetOutput(string? v)
    {
        query.Output = int.TryParse(v, out var n) ? (RsOutput)n : RsOutput.Table; MarkDirty();
    }
    private void SetChart(string? v)
    {
        query.Chart = int.TryParse(v, out var n) ? (RsChart)n : RsChart.Bar; MarkDirty();
    }
    private void SetPivot(string? v) { query.PivotColumnField = v; MarkDirty(); }
    private void SetTake(string? v)
    {
        query.Take = int.TryParse(v, out var n) ? Math.Clamp(n, 1, 5000) : 200; MarkDirty();
    }
    private void SetVisibility(string? v)
    {
        visibility = int.TryParse(v, out var n) ? (RsVisibility)n : RsVisibility.Private; MarkDirty();
    }

    private static string VisibilityFa(RsVisibility v) => v switch
    {
        RsVisibility.Private => "خصوصی",
        RsVisibility.Shared => "اشتراکی",
        _ => "عمومی"
    };

    // ---------------- اشتراک ----------------
    private void ToggleRole(RsRoleShareDto role, bool on)
    {
        var ex = roleShares.FirstOrDefault(x => x.RoleId == role.RoleId);
        if (on && ex is null)
            roleShares.Add(new RsRoleShareDto { RoleId = role.RoleId, RoleName = role.RoleName, Access = RsAccess.View });
        else if (!on && ex is not null) roleShares.Remove(ex);
        MarkDirty();
    }

    private void SetRoleAccess(int roleId, string? v)
    {
        var ex = roleShares.FirstOrDefault(x => x.RoleId == roleId);
        if (ex is not null && int.TryParse(v, out var n)) { ex.Access = (RsAccess)n; MarkDirty(); }
    }

    private void ToggleUser(RsUserShareDto u, bool on)
    {
        var ex = userShares.FirstOrDefault(x => x.UserId == u.UserId);
        if (on && ex is null)
            userShares.Add(new RsUserShareDto { UserId = u.UserId, UserName = u.UserName, FullName = u.FullName, Access = RsAccess.View });
        else if (!on && ex is not null) userShares.Remove(ex);
        MarkDirty();
    }

    private void SetUserAccess(int userId, string? v)
    {
        var ex = userShares.FirstOrDefault(x => x.UserId == userId);
        if (ex is not null && int.TryParse(v, out var n)) { ex.Access = (RsAccess)n; MarkDirty(); }
    }

    private async Task OnUserSearch(ChangeEventArgs e)
    {
        userSearch = e.Value?.ToString();
        try { targets = await Api.GetShareTargetsAsync(userSearch) ?? targets; }
        catch { /* جست‌وجوی ناموفق نباید صفحه را بشکند */ }
    }

    // ---------------- اجرا و ذخیره ----------------
    private void MarkDirty() => dirty = true;

    private async Task RunAsync()
    {
        running = true;
        try
        {
            result = reportId > 0 && !dirty
                ? await Api.RunAsync(reportId)
                : await Api.PreviewAsync(query);
        }
        catch (Exception ex)
        {
            result = new RsResultDto { Ok = false, Error = "اجرا ناموفق بود: " + ex.Message };
        }
        running = false;
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(name)) { Toast.Error("نام گزارش را وارد کنید."); return; }
        saving = true;
        try
        {
            var dto = new RsReportDto
            {
                Id = reportId,
                Name = name.Trim(),
                Description = description,
                Query = query,
                Visibility = visibility,
                UserShares = userShares,
                RoleShares = roleShares
            };

            if (reportId > 0) await Api.UpdateAsync(reportId, dto);
            else reportId = await Api.CreateAsync(dto);

            myReports = await Api.ListAsync() ?? new();
            dirty = false;
            Toast.Success("گزارش ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error("ذخیره ناموفق بود: " + ex.Message); }
        saving = false;
    }

    private async Task LoadReportAsync(int id)
    {
        try
        {
            var r = await Api.GetAsync(id);
            if (r is null) { Toast.Error("گزارش پیدا نشد."); return; }
            reportId = r.Id;
            name = r.Name;
            description = r.Description;
            query = r.Query ?? new RsQueryDto();
            visibility = r.Visibility;
            userShares = r.UserShares ?? new();
            roleShares = r.RoleShares ?? new();
            dirty = false;
            result = null;
            await RunAsync();
        }
        catch (Exception ex) { Toast.Error("بارگذاری گزارش ناموفق بود: " + ex.Message); }
    }

    private void NewReport()
    {
        reportId = 0;
        name = "";
        description = null;
        query = new RsQueryDto();
        visibility = RsVisibility.Private;
        userShares = new();
        roleShares = new();
        result = null;
        dirty = false;
    }

    private async Task DeleteAsync(int id)
    {
        try
        {
            await Api.DeleteAsync(id);
            if (reportId == id) NewReport();
            myReports = await Api.ListAsync() ?? new();
            Toast.Success("گزارش حذف شد.");
        }
        catch (Exception ex) { Toast.Error("حذف ناموفق بود: " + ex.Message); }
    }
}
