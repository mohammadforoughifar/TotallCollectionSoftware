@namespace Inventory.Client.Pages
@page "/report-studio"
@page "/report-studio/{ReportId:int}"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IAuthState Auth
@inject IReportStudioClient Api
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>گزارش‌ساز</PageTitle>

@if (!Auth.CanSee("ReportStudio"))
{
    <div class="alert alert-warning mt-3">
        <i class="bi bi-shield-exclamation"></i>
        شما به «گزارش‌ساز» دسترسی ندارید. برای دریافت دسترسی با مدیر سیستم تماس بگیرید.
    </div>
}
else
{
    <div class="page-head rs-head">
        <div>
            <h1><i class="bi bi-clipboard-data-fill"></i> گزارش‌ساز</h1>
            <p class="lead mb-0">جدول‌ها را انتخاب کن، به هم جوین بزن و گزارش را با هر کس یا هر نقشی به اشتراک بگذار.</p>
        </div>
        <div class="rs-head-actions">
            <button class="btn btn-outline-secondary btn-sm" @onclick="NewReport">
                <i class="bi bi-plus-lg"></i> گزارش جدید
            </button>
            @if (canDesign && dirty)
            {
                <button class="btn btn-success btn-sm" disabled="@saving" @onclick="SaveAsync">
                    @if (saving) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-check2"></i> ذخیره
                </button>
            }
            @if (reportId > 0)
            {
                <a class="btn btn-outline-primary btn-sm" href="@Api.ExportUrl(reportId)" target="_blank">
                    <i class="bi bi-file-earmark-excel"></i> خروجی
                </a>
            }
            <button class="btn btn-primary btn-sm" disabled="@running" @onclick="RunAsync">
                @if (running) { <span class="spinner-border spinner-border-sm"></span> }
                <i class="bi bi-play-fill"></i> اجرا
            </button>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
    <div class="rs-layout">

        @* ==================== ستون راست: گزارش‌های ذخیره‌شده ==================== *@
        <aside class="rs-side">
            <div class="rs-panel">
                <div class="rs-panel-head"><i class="bi bi-folder2-open"></i> گزارش‌های من</div>
                <div class="rs-panel-body rs-scroll">
                    @if (myReports.Count == 0)
                    {
                        <div class="rs-empty-sm">هنوز گزارشی نساخته‌اید.</div>
                    }
                    @foreach (var r in myReports)
                    {
                        <div class="rs-report-item @(r.Id == reportId ? "active" : "")" @onclick="() => LoadReportAsync(r.Id)">
                            <i class="bi @r.Icon"></i>
                            <div class="rs-report-meta">
                                <span class="rs-report-name">@r.Name</span>
                                <span class="rs-report-sub">
                                    @if (!r.IsMine) { <span class="badge-shared">اشتراکی از @r.OwnerName</span> }
                                    else { <text>@VisibilityFa(r.Visibility)</text> }
                                </span>
                            </div>
                            @if (r.IsMine)
                            {
                                <button class="rs-icon-btn text-danger" title="حذف"
                                        @onclick:stopPropagation="true" @onclick="() => DeleteAsync(r.Id)">
                                    <i class="bi bi-trash"></i>
                                </button>
                            }
                        </div>
                    }
                </div>
            </div>
        </aside>

        @* ==================== ستون وسط: طراح ==================== *@
        <section class="rs-main">

            @* ---------- مشخصات ---------- *@
            <div class="rs-panel">
                <div class="rs-panel-head"><i class="bi bi-card-text"></i> مشخصات گزارش</div>
                <div class="rs-panel-body">
                    <div class="rs-grid-2">
                        <label class="rs-field">
                            <span>نام گزارش</span>
                            <input class="form-control form-control-sm" @bind="name" @bind:event="oninput"
                                   @onchange="MarkDirty" placeholder="مثلاً: گردش نامه‌های معوق" />
                        </label>
                        <label class="rs-field">
                            <span>توضیح</span>
                            <input class="form-control form-control-sm" @bind="description" @bind:event="oninput"
                                   @onchange="MarkDirty" placeholder="اختیاری" />
                        </label>
                    </div>
                </div>
            </div>

            @* ---------- جدول‌ها و جوین ---------- *@
            <div class="rs-panel">
                <div class="rs-panel-head">
                    <i class="bi bi-diagram-3"></i> جدول‌ها و ارتباط‌ها
                    <span class="rs-hint-inline">اول جدول اصلی، بعد جدول‌های مرتبط</span>
                </div>
                <div class="rs-panel-body">
                    @if (query.Tables.Count == 0)
                    {
                        <div class="rs-empty-sm mb-2">جدول اصلی را انتخاب کنید:</div>
                        <div class="rs-chip-wrap">
                            @foreach (var cat in catalog.Tables.GroupBy(t => t.Category))
                            {
                                <div class="rs-cat">
                                    <div class="rs-cat-title">@cat.Key</div>
                                    <div class="rs-chip-wrap">
                                        @foreach (var t in cat)
                                        {
                                            <button class="rs-chip" @onclick="() => AddTable(t.Key, null)">
                                                <i class="bi @t.Icon"></i> @t.Title
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="rs-tables">
                            @for (var i = 0; i < query.Tables.Count; i++)
                            {
                                var idx = i;
                                var qt = query.Tables[idx];
                                var def = catalog.Tables.FirstOrDefault(t => t.Key == qt.TableKey);
                                var join = catalog.Joins.FirstOrDefault(j => j.Key == qt.JoinKey);
                                <div class="rs-table-card">
                                    <div class="rs-table-head">
                                        <i class="bi @(def?.Icon ?? "bi-table")"></i>
                                        <strong>@(def?.Title ?? qt.TableKey)</strong>
                                        @if (idx == 0) { <span class="rs-badge-main">جدول اصلی</span> }
                                        <button class="rs-icon-btn text-danger ms-auto" title="حذف"
                                                @onclick="() => RemoveTable(idx)"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                    @if (idx > 0 && join is not null)
                                    {
                                        <div class="rs-join-row">
                                            <i class="bi bi-link-45deg"></i>
                                            <span>@join.Title</span>
                                            <select class="form-select form-select-sm rs-join-kind"
                                                    value="@((int)qt.JoinKind)"
                                                    @onchange="e => SetJoinKind(idx, e.Value?.ToString())">
                                                <option value="1">همهٔ سطرهای جدول اصلی (Left)</option>
                                                <option value="0">فقط سطرهای دارای تطابق (Inner)</option>
                                            </select>
                                            @if (join.Multiplies)
                                            {
                                                <span class="rs-warn" title="@join.Description">
                                                    <i class="bi bi-exclamation-triangle"></i> تکرار سطر
                                                </span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        @if (AvailableJoins.Any())
                        {
                            <div class="rs-add-join">
                                <span class="rs-add-label">افزودن جدول مرتبط:</span>
                                @foreach (var j in AvailableJoins)
                                {
                                    var target = catalog.Tables.FirstOrDefault(t => t.Key == j.ToTable);
                                    <button class="rs-chip rs-chip-add" title="@j.Description"
                                            @onclick="() => AddTable(j.ToTable, j.Key)">
                                        <i class="bi bi-plus-lg"></i> @(target?.Title ?? j.ToTable)
                                    </button>
                                }
                            </div>
                        }
                    }
                </div>
            </div>

            @* ---------- ستون‌ها ---------- *@
            @if (query.Tables.Count > 0)
            {
                <div class="rs-panel">
                    <div class="rs-panel-head">
                        <i class="bi bi-columns-gap"></i> ستون‌های خروجی
                        <span class="rs-hint-inline">روی نام ستون کلیک کنید تا اضافه شود</span>
                    </div>
                    <div class="rs-panel-body">
                        <div class="rs-field-picker rs-scroll">
                            @foreach (var tk in query.Tables.Select(t => t.TableKey))
                            {
                                var def = catalog.Tables.FirstOrDefault(t => t.Key == tk);
                                if (def is null) { continue; }
                                <div class="rs-cat">
                                    <div class="rs-cat-title"><i class="bi @def.Icon"></i> @def.Title</div>
                                    <div class="rs-chip-wrap">
                                        @foreach (var f in def.Fields)
                                        {
                                            var fld = f;
                                            <button class="rs-chip rs-chip-field @(IsUsed(fld.Key) ? "used" : "")"
                                                    title="@(fld.Hint ?? fld.Title)" @onclick="() => AddColumn(fld)">
                                                @fld.Title
                                                @if (fld.Aggregatable) { <i class="bi bi-calculator rs-agg-dot"></i> }
                                            </button>
                                        }
                                    </div>
                                </div>
                            }
                        </div>

                        @if (query.Columns.Count > 0)
                        {
                            <div class="rs-col-list">
                                @for (var i = 0; i < query.Columns.Count; i++)
                                {
                                    var ci = i;
                                    var c = query.Columns[ci];
                                    var f = FindField(c.FieldKey);
                                    <div class="rs-col-row">
                                        <span class="rs-col-name">@(f?.Title ?? c.FieldKey)</span>

                                        <select class="form-select form-select-sm rs-sel"
                                                value="@((int)c.Agg)"
                                                @onchange="e => SetAgg(ci, e.Value?.ToString())">
                                            <option value="0">بدون تجمیع (گروه‌بندی)</option>
                                            <option value="1">تعداد</option>
                                            <option value="6">تعداد یکتا</option>
                                            @if (f is not null && (f.Type == RsFieldType.Number || f.Type == RsFieldType.Money))
                                            {
                                                <option value="2">مجموع</option>
                                                <option value="3">میانگین</option>
                                            }
                                            @if (f is not null && (f.Type == RsFieldType.Number || f.Type == RsFieldType.Money || f.Type == RsFieldType.Date))
                                            {
                                                <option value="4">کمینه</option>
                                                <option value="5">بیشینه</option>
                                            }
                                        </select>

                                        @if (f?.Type == RsFieldType.Date && c.Agg == RsAgg.None)
                                        {
                                            <select class="form-select form-select-sm rs-sel"
                                                    value="@((int)c.Bucket)"
                                                    @onchange="e => SetBucket(ci, e.Value?.ToString())">
                                                <option value="0">تاریخ کامل</option>
                                                <option value="1">روزانه</option>
                                                <option value="2">ماهانه</option>
                                                <option value="3">فصلی</option>
                                                <option value="4">سالانه</option>
                                            </select>
                                        }

                                        <input class="form-control form-control-sm rs-label" placeholder="عنوان دلخواه"
                                               value="@c.Label" @onchange="e => SetLabel(ci, e.Value?.ToString())" />

                                        <button class="rs-icon-btn" title="مرتب‌سازی"
                                                @onclick="() => ToggleSort(c.FieldKey)">
                                            <i class="bi @SortIcon(c.FieldKey)"></i>
                                        </button>
                                        <button class="rs-icon-btn text-danger" title="حذف"
                                                @onclick="() => RemoveColumn(ci)"><i class="bi bi-x-lg"></i></button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>

                @* ---------- فیلترها ---------- *@
                <div class="rs-panel">
                    <div class="rs-panel-head">
                        <i class="bi bi-funnel"></i> فیلترها
                        <button class="btn btn-outline-secondary btn-sm ms-auto" @onclick="AddFilter">
                            <i class="bi bi-plus-lg"></i> افزودن شرط
                        </button>
                    </div>
                    <div class="rs-panel-body">
                        @if (query.Filters.Count == 0)
                        {
                            <div class="rs-empty-sm">بدون فیلتر — همهٔ سطرها نمایش داده می‌شوند.</div>
                        }
                        @for (var i = 0; i < query.Filters.Count; i++)
                        {
                            var fi = i;
                            var fl = query.Filters[fi];
                            var f = FindField(fl.FieldKey);
                            <div class="rs-filter-row">
                                @if (fi > 0)
                                {
                                    <select class="form-select form-select-sm rs-andor"
                                            value="@(fl.OrWithPrevious ? "or" : "and")"
                                            @onchange="e => SetAndOr(fi, e.Value?.ToString())">
                                        <option value="and">و</option>
                                        <option value="or">یا</option>
                                    </select>
                                }
                                else { <span class="rs-andor-fixed">جایی که</span> }

                                <select class="form-select form-select-sm rs-sel-wide"
                                        value="@fl.FieldKey" @onchange="e => SetFilterField(fi, e.Value?.ToString())">
                                    <option value="">— ستون —</option>
                                    @foreach (var tk in query.Tables.Select(t => t.TableKey))
                                    {
                                        var def = catalog.Tables.FirstOrDefault(t => t.Key == tk);
                                        if (def is null) { continue; }
                                        <optgroup label="@def.Title">
                                            @foreach (var ff in def.Fields)
                                            {
                                                <option value="@ff.Key">@ff.Title</option>
                                            }
                                        </optgroup>
                                    }
                                </select>

                                <select class="form-select form-select-sm rs-sel"
                                        value="@((int)fl.Op)" @onchange="e => SetFilterOp(fi, e.Value?.ToString())">
                                    @foreach (var op in OpsFor(f))
                                    {
                                        <option value="@((int)op)">@OpFa(op)</option>
                                    }
                                </select>

                                @if (fl.Op != RsOp.IsNull && fl.Op != RsOp.NotNull && !fl.IsPrompt)
                                {
                                    @if (fl.Op == RsOp.DateRange)
                                    {
                                        <select class="form-select form-select-sm rs-sel"
                                                value="@fl.Value" @onchange="e => SetFilterValue(fi, e.Value?.ToString())">
                                            <option value="today">امروز</option>
                                            <option value="yesterday">دیروز</option>
                                            <option value="last7">۷ روز اخیر</option>
                                            <option value="last30">۳۰ روز اخیر</option>
                                            <option value="last90">۹۰ روز اخیر</option>
                                            <option value="month">ماه جاری</option>
                                            <option value="year">سال جاری</option>
                                        </select>
                                    }
                                    else if (f?.Type == RsFieldType.Bool)
                                    {
                                        <select class="form-select form-select-sm rs-sel"
                                                value="@fl.Value" @onchange="e => SetFilterValue(fi, e.Value?.ToString())">
                                            <option value="1">بله</option>
                                            <option value="0">خیر</option>
                                        </select>
                                    }
                                    else if (f?.EnumMap is { Count: > 0 })
                                    {
                                        <select class="form-select form-select-sm rs-sel"
                                                value="@fl.Value" @onchange="e => SetFilterValue(fi, e.Value?.ToString())">
                                            <option value="">— انتخاب —</option>
                                            @foreach (var kv in f.EnumMap)
                                            {
                                                <option value="@kv.Key">@kv.Value</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        <input class="form-control form-control-sm rs-val" placeholder="مقدار"
                                               value="@fl.Value" @onchange="e => SetFilterValue(fi, e.Value?.ToString())" />
                                        @if (fl.Op == RsOp.Between)
                                        {
                                            <input class="form-control form-control-sm rs-val" placeholder="تا"
                                                   value="@fl.Value2" @onchange="e => SetFilterValue2(fi, e.Value?.ToString())" />
                                        }
                                    }
                                }

                                <label class="rs-prompt" title="کاربر هنگام اجرا مقدار را وارد می‌کند">
                                    <input type="checkbox" checked="@fl.IsPrompt"
                                           @onchange="e => SetPrompt(fi, (bool)(e.Value ?? false))" />
                                    <span>پرسشی</span>
                                </label>

                                <button class="rs-icon-btn text-danger" title="حذف"
                                        @onclick="() => RemoveFilter(fi)"><i class="bi bi-x-lg"></i></button>
                            </div>
                        }
                    </div>
                </div>

                @* ---------- نمایش و اشتراک ---------- *@
                <div class="rs-panel">
                    <div class="rs-panel-head"><i class="bi bi-sliders"></i> نمایش و دسترسی</div>
                    <div class="rs-panel-body">
                        <div class="rs-grid-3">
                            <label class="rs-field">
                                <span>نوع خروجی</span>
                                <select class="form-select form-select-sm" value="@((int)query.Output)"
                                        @onchange="e => SetOutput(e.Value?.ToString())">
                                    <option value="0">جدول</option>
                                    <option value="1">نمودار</option>
                                    <option value="2">عدد شاخص (KPI)</option>
                                    <option value="3">جدول محوری</option>
                                </select>
                            </label>

                            @if (query.Output == RsOutput.Chart)
                            {
                                <label class="rs-field">
                                    <span>نوع نمودار</span>
                                    <select class="form-select form-select-sm" value="@((int)query.Chart)"
                                            @onchange="e => SetChart(e.Value?.ToString())">
                                        <option value="0">میله‌ای</option>
                                        <option value="2">خطی</option>
                                        <option value="3">دایره‌ای</option>
                                        <option value="4">دونات</option>
                                    </select>
                                </label>
                            }
                            @if (query.Output == RsOutput.Pivot)
                            {
                                <label class="rs-field">
                                    <span>ستون سرستون</span>
                                    <select class="form-select form-select-sm" value="@query.PivotColumnField"
                                            @onchange="e => SetPivot(e.Value?.ToString())">
                                        <option value="">— انتخاب —</option>
                                        @foreach (var c in query.Columns.Where(x => x.Agg == RsAgg.None))
                                        {
                                            <option value="@c.FieldKey">@(FindField(c.FieldKey)?.Title ?? c.FieldKey)</option>
                                        }
                                    </select>
                                </label>
                            }

                            <label class="rs-field">
                                <span>حداکثر سطر</span>
                                <input type="number" class="form-control form-control-sm" min="1" max="5000"
                                       value="@query.Take" @onchange="e => SetTake(e.Value?.ToString())" />
                            </label>

                            <label class="rs-field">
                                <span>چه کسانی ببینند؟</span>
                                <select class="form-select form-select-sm" value="@((int)visibility)"
                                        @onchange="e => SetVisibility(e.Value?.ToString())">
                                    <option value="0">فقط خودم</option>
                                    <option value="1">کاربران و نقش‌های انتخابی</option>
                                    <option value="2">همه (با رعایت مجوز ماژول)</option>
                                </select>
                            </label>
                        </div>

                        @if (visibility == RsVisibility.Shared)
                        {
                            <div class="rs-share">
                                <div class="rs-share-col">
                                    <div class="rs-share-title"><i class="bi bi-people-fill"></i> نقش‌ها</div>
                                    @foreach (var role in targets.Roles)
                                    {
                                        var rr = role;
                                        var existing = roleShares.FirstOrDefault(x => x.RoleId == rr.RoleId);
                                        <div class="rs-share-row">
                                            <label class="rs-share-check">
                                                <input type="checkbox" checked="@(existing is not null)"
                                                       @onchange="e => ToggleRole(rr, (bool)(e.Value ?? false))" />
                                                <span>@rr.RoleName</span>
                                            </label>
                                            @if (existing is not null)
                                            {
                                                <select class="form-select form-select-sm rs-access"
                                                        value="@((int)existing.Access)"
                                                        @onchange="e => SetRoleAccess(rr.RoleId, e.Value?.ToString())">
                                                    <option value="0">فقط مشاهده</option>
                                                    <option value="1">مشاهده + خروجی</option>
                                                    <option value="2">ویرایش</option>
                                                </select>
                                            }
                                        </div>
                                    }
                                </div>

                                <div class="rs-share-col">
                                    <div class="rs-share-title"><i class="bi bi-person-fill"></i> کاربران</div>
                                    <input class="form-control form-control-sm mb-2" placeholder="جست‌وجوی کاربر…"
                                           value="@userSearch" @onchange="OnUserSearch" />
                                    <div class="rs-scroll rs-user-list">
                                        @foreach (var u in targets.Users)
                                        {
                                            var uu = u;
                                            var existing = userShares.FirstOrDefault(x => x.UserId == uu.UserId);
                                            <div class="rs-share-row">
                                                <label class="rs-share-check">
                                                    <input type="checkbox" checked="@(existing is not null)"
                                                           @onchange="e => ToggleUser(uu, (bool)(e.Value ?? false))" />
                                                    <span>@(string.IsNullOrWhiteSpace(uu.FullName) ? uu.UserName : uu.FullName)</span>
                                                </label>
                                                @if (existing is not null)
                                                {
                                                    <select class="form-select form-select-sm rs-access"
                                                            value="@((int)existing.Access)"
                                                            @onchange="e => SetUserAccess(uu.UserId, e.Value?.ToString())">
                                                        <option value="0">فقط مشاهده</option>
                                                        <option value="1">مشاهده + خروجی</option>
                                                        <option value="2">ویرایش</option>
                                                    </select>
                                                }
                                            </div>
                                        }
                                        @if (targets.Users.Count == 0)
                                        {
                                            <div class="rs-empty-sm">کاربری یافت نشد.</div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ---------- نتیجه ---------- *@
            @if (result is not null)
            {
                <div class="rs-panel">
                    <div class="rs-panel-head">
                        <i class="bi bi-table"></i> نتیجه
                        @if (result.Ok)
                        {
                            <span class="rs-hint-inline">
                                @Fa.Digits(result.TotalRows.ToString()) سطر — @Fa.Digits(result.ElapsedMs.ToString()) میلی‌ثانیه
                            </span>
                        }
                    </div>
                    <div class="rs-panel-body">
                        @if (!result.Ok)
                        {
                            <div class="alert alert-danger rs-alert">
                                <i class="bi bi-exclamation-octagon"></i> @result.Error
                            </div>
                        }
                        else
                        {
                            @foreach (var w in result.Warnings)
                            {
                                <div class="alert alert-warning rs-alert"><i class="bi bi-info-circle"></i> @w</div>
                            }

                            @if (result.Output == RsOutput.Kpi)
                            {
                                <div class="rs-kpi">
                                    <div class="rs-kpi-value">@Fa.Digits((result.KpiValue ?? 0).ToString("N0"))</div>
                                    <div class="rs-kpi-unit">@result.KpiUnit</div>
                                </div>
                            }
                            else if (result.Output == RsOutput.Chart && result.Series.Count > 0)
                            {
                                <div class="rs-chart-legend">
                                    @foreach (var s in result.Series)
                                    {
                                        <div class="rs-series">
                                            <div class="rs-series-name">@s.Name</div>
                                            <div class="rs-bars">
                                                @{
                                                    var max = s.Values.Count > 0 ? s.Values.Max() : 1;
                                                    if (max <= 0) { max = 1; }
                                                }
                                                @for (var bi = 0; bi < s.Labels.Count; bi++)
                                                {
                                                    var pct = (double)(s.Values[bi] / max) * 100;
                                                    <div class="rs-bar-row">
                                                        <span class="rs-bar-label">@s.Labels[bi]</span>
                                                        <div class="rs-bar-track">
                                                            <div class="rs-bar-fill" style="width:@pct.ToString("F1")%"></div>
                                                        </div>
                                                        <span class="rs-bar-val">@Fa.Digits(s.Values[bi].ToString("N0"))</span>
                                                    </div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else if (result.Rows.Count == 0)
                            {
                                <div class="rs-empty-sm">سطری با این شرایط پیدا نشد.</div>
                            }
                            else
                            {
                                <div class="rs-table-wrap rs-scroll">
                                    <table class="table table-sm rs-table">
                                        <thead>
                                            <tr>
                                                <th class="rs-rownum">#</th>
                                                @foreach (var c in result.Columns)
                                                {
                                                    <th style="text-align:@c.Align">
                                                        @c.Title
                                                        @if (!string.IsNullOrEmpty(c.Unit)) { <small class="rs-unit">(@c.Unit)</small> }
                                                    </th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @for (var ri = 0; ri < result.Rows.Count; ri++)
                                            {
                                                var row = result.Rows[ri];
                                                <tr>
                                                    <td class="rs-rownum">@Fa.Digits((ri + 1).ToString())</td>
                                                    @for (var cj = 0; cj < row.Count; cj++)
                                                    {
                                                        var align = cj < result.Columns.Count ? result.Columns[cj].Align : "right";
                                                        <td style="text-align:@align">@row[cj]</td>
                                                    }
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                </div>
            }
        </section>
    </div>
    }
}

