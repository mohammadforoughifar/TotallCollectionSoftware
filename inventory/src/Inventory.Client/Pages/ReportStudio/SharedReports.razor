@namespace Inventory.Client.Pages
@page "/reports-hub"
@page "/reports-hub/{ReportId:int}"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IAuthState Auth
@inject IReportStudioClient Api
@inject IToastService Toast
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>گزارش‌ها</PageTitle>

@if (!Auth.CanSee("ReportStudio"))
{
    <div class="alert alert-warning mt-3">
        <i class="bi bi-shield-exclamation"></i> شما به بخش گزارش‌ها دسترسی ندارید.
    </div>
}
else
{
    <div class="page-head">
        <div>
            <h1><i class="bi bi-journal-text"></i> گزارش‌ها</h1>
            <p class="lead mb-0">گزارش‌هایی که ساخته‌اید یا با شما به اشتراک گذاشته شده‌اند.</p>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center p-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (reports.Count == 0)
    {
        <div class="rh-empty">
            <i class="bi bi-inbox"></i>
            <h5>هنوز گزارشی در دسترس شما نیست</h5>
            <p>گزارش‌هایی که خودتان بسازید یا دیگران با شما به اشتراک بگذارند، اینجا نمایش داده می‌شوند.</p>
        </div>
    }
    else
    {
        <div class="rh-filters">
            <button class="rh-tab @(tab == "all" ? "active" : "")" @onclick='() => SetTab("all")'>
                همه <span class="rh-count">@Fa.Digits(reports.Count.ToString())</span>
            </button>
            <button class="rh-tab @(tab == "mine" ? "active" : "")" @onclick='() => SetTab("mine")'>
                ساختهٔ من <span class="rh-count">@Fa.Digits(reports.Count(r => r.IsMine).ToString())</span>
            </button>
            <button class="rh-tab @(tab == "shared" ? "active" : "")" @onclick='() => SetTab("shared")'>
                اشتراکی با من <span class="rh-count">@Fa.Digits(reports.Count(r => !r.IsMine).ToString())</span>
            </button>
            <input class="form-control form-control-sm rh-search" placeholder="جست‌وجو…"
                   value="@search" @oninput="e => search = e.Value?.ToString()" />
        </div>

        @foreach (var grp in GroupedReports)
        {
            <div class="rh-group">
                <div class="rh-group-head">
                    <i class="bi @(string.IsNullOrWhiteSpace(grp.Key) ? "bi-folder" : "bi-folder2-open")"></i>
                    <span>@(string.IsNullOrWhiteSpace(grp.Key) ? "بدون پوشه" : grp.Key)</span>
                    <span class="rh-group-count">@Fa.Digits(grp.Count().ToString())</span>
                </div>
                <div class="rh-grid">
                    @foreach (var rep in grp)
                    {
                <div class="rh-card @(rep.Id == openId ? "active" : "")" @onclick="() => OpenAsync(rep.Id)">
                    <div class="rh-card-top">
                        <i class="bi @rep.Icon rh-icon"></i>
                        <div class="rh-card-title">
                            <span class="rh-name">@rep.Name</span>
                            @if (!string.IsNullOrWhiteSpace(rep.Description))
                            {
                                <span class="rh-desc">@rep.Description</span>
                            }
                        </div>
                    </div>
                    <div class="rh-card-foot">
                        @if (rep.IsMine)
                        {
                            <span class="rh-badge rh-mine"><i class="bi bi-person-check"></i> ساختهٔ من</span>
                        }
                        else
                        {
                            <span class="rh-badge rh-shared"><i class="bi bi-share"></i> از @rep.OwnerName</span>
                        }
                        <span class="rh-badge rh-access">@AccessFa(rep.MyAccess)</span>
                    </div>
                </div>
                    }
                </div>
            </div>
        }

        @if (openId > 0)
        {
            <div class="rs-panel mt-3">
                <div class="rs-panel-head">
                    <i class="bi bi-table"></i> @openName
                    @if (result is { Ok: true })
                    {
                        <span class="rh-meta">
                            @Fa.Digits(result.TotalRows.ToString()) سطر — @Fa.Digits(result.ElapsedMs.ToString()) میلی‌ثانیه
                        </span>
                    }
                    <div class="rh-actions">
                        @if (canExport)
                        {
                            <a class="btn btn-outline-primary btn-sm" href="@Api.ExportUrl(openId)" target="_blank">
                                <i class="bi bi-file-earmark-excel"></i> خروجی
                            </a>
                        }
                        @if (canEdit)
                        {
                            <a class="btn btn-outline-secondary btn-sm" href="report-studio/@openId">
                                <i class="bi bi-pencil"></i> ویرایش
                            </a>
                        }
                        <button class="btn btn-primary btn-sm" disabled="@running" @onclick="() => RunAsync(openId)">
                            @if (running) { <span class="spinner-border spinner-border-sm"></span> }
                            <i class="bi bi-arrow-clockwise"></i> اجرای مجدد
                        </button>
                    </div>
                </div>
                <div class="rs-panel-body">
                    @if (running)
                    {
                        <div class="text-center p-4"><div class="spinner-border text-primary"></div></div>
                    }
                    else if (result is null)
                    {
                        <div class="rh-hint">برای دیدن نتیجه، «اجرای مجدد» را بزنید.</div>
                    }
                    else if (!result.Ok)
                    {
                        <div class="alert alert-danger rh-alert">
                            <i class="bi bi-exclamation-octagon"></i> @result.Error
                        </div>
                    }
                    else
                    {
                        @foreach (var w in result.Warnings)
                        {
                            <div class="alert alert-warning rh-alert"><i class="bi bi-info-circle"></i> @w</div>
                        }

                        @if (result.Output == RsOutput.Kpi)
                        {
                            <div class="rh-kpi">
                                <div class="rh-kpi-value">@Fa.Digits((result.KpiValue ?? 0).ToString("N0"))</div>
                                <div class="rh-kpi-unit">@result.KpiUnit</div>
                            </div>
                        }
                        else if (result.Output == RsOutput.Chart && result.Series.Count > 0)
                        {
                            <div class="rh-chart"><canvas id="@ChartId"></canvas></div>
                        }
                        else if (result.Rows.Count == 0)
                        {
                            <div class="rh-hint">سطری برای نمایش وجود ندارد.</div>
                        }
                        else
                        {
                            <div class="rh-table-wrap">
                                <table class="table table-sm rh-table">
                                    <thead>
                                        <tr>
                                            <th class="rh-rownum">#</th>
                                            @foreach (var c in result.Columns)
                                            {
                                                <th style="text-align:@c.Align">@c.Title</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < result.Rows.Count; i++)
                                        {
                                            var row = result.Rows[i];
                                            <tr>
                                                <td class="rh-rownum">@Fa.Digits((i + 1).ToString())</td>
                                                @for (var j = 0; j < row.Count; j++)
                                                {
                                                    var al = j < result.Columns.Count ? result.Columns[j].Align : "right";
                                                    <td style="text-align:@al">@row[j]</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
}

<style>
    .rh-filters { display:flex; align-items:center; gap:.4rem; flex-wrap:wrap; margin-bottom:.9rem; direction:rtl; }
    .rh-tab { border:1px solid #e2e8f0; background:#fff; border-radius:999px; padding:.3rem .85rem;
              font-size:.82rem; cursor:pointer; color:#475569; }
    .rh-tab.active { background:#eff6ff; border-color:#93c5fd; color:#1d4ed8; font-weight:700; }
    .rh-count { background:#f1f5f9; border-radius:999px; padding:0 .4rem; font-size:.72rem; margin-right:.25rem; }
    .rh-search { max-width:220px; margin-right:auto; }

    .rh-grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(250px,1fr)); gap:.7rem; direction:rtl; }
    .rh-card { background:#fff; border:1px solid #e5eaf0; border-radius:12px; padding:.75rem .85rem;
               cursor:pointer; transition:border-color .15s, box-shadow .15s; }
    .rh-card:hover { border-color:#93c5fd; box-shadow:0 2px 10px rgba(37,99,235,.08); }
    .rh-card.active { border-color:#2563eb; background:#f8fbff; }
    .rh-card-top { display:flex; gap:.55rem; align-items:flex-start; }
    .rh-icon { font-size:1.35rem; color:#2563eb; }
    .rh-card-title { display:flex; flex-direction:column; min-width:0; }
    .rh-name { font-weight:700; font-size:.9rem; color:#1e293b; }
    .rh-desc { font-size:.76rem; color:#94a3b8; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
    .rh-card-foot { display:flex; gap:.35rem; flex-wrap:wrap; margin-top:.6rem; }
    .rh-badge { font-size:.7rem; border-radius:6px; padding:.1rem .4rem; }
    .rh-mine { background:#dcfce7; color:#166534; }
    .rh-shared { background:#fef3c7; color:#92400e; }
    .rh-access { background:#e0e7ff; color:#3730a3; }

    .rh-empty { text-align:center; padding:3rem 1rem; color:#94a3b8; }
    .rh-empty i { font-size:2.5rem; }
    .rh-hint { color:#94a3b8; font-size:.85rem; padding:.6rem 0; }
    .rh-meta { margin-right:1rem; font-size:.75rem; font-weight:400; color:#94a3b8; }
    .rh-actions { margin-right:auto; display:flex; gap:.4rem; }
    .rh-alert { padding:.5rem .7rem; font-size:.82rem; margin-bottom:.5rem; }
    .rh-table-wrap { max-height:480px; overflow:auto; }
    .rh-table { font-size:.82rem; margin:0; }
    .rh-table thead th { position:sticky; top:0; background:#f8fafc; z-index:1; white-space:nowrap; }
    .rh-rownum { color:#94a3b8; width:42px; text-align:center; }
    .rh-chart { height:340px; position:relative; }
    .rh-kpi { text-align:center; padding:1.6rem 0; }
    .rh-kpi-value { font-size:2.6rem; font-weight:800; color:#2563eb; }
    .rh-kpi-unit { font-size:.85rem; color:#64748b; }

    .rh-group { margin-bottom:1.1rem; }
    .rh-group-head { display:flex; align-items:center; gap:.4rem; margin-bottom:.5rem;
                     font-size:.82rem; font-weight:700; color:#1d4ed8; }
    .rh-group-head > i { font-size:.95rem; }
    .rh-group-count { background:#dbeafe; color:#1e40af; border-radius:999px;
                      padding:0 .45rem; font-size:.68rem; font-weight:700; }
    .rs-panel { background:#fff; border:1px solid #e5eaf0; border-radius:14px; overflow:hidden; direction:rtl; }
    .rs-panel-head { display:flex; align-items:center; gap:.5rem; padding:.6rem .9rem; background:#f8fafc;
                     border-bottom:1px solid #eef2f7; font-weight:700; font-size:.88rem; color:#334155; }
    .rs-panel-body { padding:.8rem .9rem; }
</style>

@code {
    [Parameter] public int? ReportId { get; set; }

    private List<RsReportDto> reports = new();
    private RsResultDto? result;
    private bool loading = true, running;
    private int openId;
    private string openName = "";
    private bool canExport, canEdit;
    private string tab = "all";
    private string? search;

    private readonly string ChartId = "rhChart_" + Guid.NewGuid().ToString("N")[..8];
    private bool chartPending;

    private IEnumerable<RsReportDto> Filtered
    {
        get
        {
            var q = tab switch
            {
                "mine" => reports.Where(r => r.IsMine),
                "shared" => reports.Where(r => !r.IsMine),
                _ => reports.AsEnumerable()
            };
            if (!string.IsNullOrWhiteSpace(search))
            {
                var t = search.Trim();
                q = q.Where(r => r.Name.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (r.Description ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    /// <summary>
    /// گزارش‌ها گروه‌بندی‌شده بر اساس پوشه.
    /// پوشه‌ها را خودِ کاربر هنگام ساخت گزارش تعیین می‌کند، بنابراین
    /// تفکیکِ گزارش‌ها دقیقاً مطابقِ نظمِ ذهنیِ اوست.
    /// </summary>
    private List<IGrouping<string, RsReportDto>> GroupedReports =>
        Filtered.GroupBy(r => r.Folder ?? "")
                .OrderBy(g => string.IsNullOrWhiteSpace(g.Key) ? 1 : 0)
                .ThenBy(g => g.Key, StringComparer.Ordinal)
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanSee("ReportStudio")) { loading = false; return; }
        try { reports = await Api.ListAsync() ?? new(); }
        catch (Exception ex) { Toast.Error("بارگذاری گزارش‌ها ناموفق بود: " + ex.Message); }
        loading = false;

        if (ReportId is > 0) await OpenAsync(ReportId.Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartPending) return;
        chartPending = false;
        if (result is null || !result.Ok || result.Output != RsOutput.Chart || result.Series.Count == 0) return;

        try
        {
            var type = result.Chart switch
            {
                RsChart.Line => "line",
                RsChart.Pie => "pie",
                RsChart.Doughnut => "doughnut",
                RsChart.Area => "line",
                _ => "bar"
            };
            var datasets = result.Series.Select(x => new { name = x.Name, values = x.Values })
                                        .Cast<object>().ToArray();
            await JS.InvokeVoidAsync("appDash.renderChart", ChartId, type, result.Series[0].Labels, datasets);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("appDash.destroyChart", ChartId); } catch { }
    }

    private void SetTab(string t) => tab = t;

    private async Task OpenAsync(int id)
    {
        var rep = reports.FirstOrDefault(r => r.Id == id);
        openId = id;
        openName = rep?.Name ?? "گزارش";
        canExport = rep is not null && (rep.IsMine || rep.MyAccess >= RsAccess.Export);
        canEdit = rep?.CanEdit ?? false;
        await RunAsync(id);
    }

    private async Task RunAsync(int id)
    {
        running = true;
        result = null;
        try { result = await Api.RunAsync(id); }
        catch (Exception ex) { result = new RsResultDto { Ok = false, Error = "اجرا ناموفق بود: " + ex.Message }; }
        running = false;
        chartPending = result is { Ok: true, Output: RsOutput.Chart };
    }

    private static string AccessFa(RsAccess a) => a switch
    {
        RsAccess.Edit => "ویرایش",
        RsAccess.Export => "مشاهده + خروجی",
        _ => "فقط مشاهده"
    };
}
