@namespace Inventory.Client.Pages.BonHr
@page "/bon-hr/accounting"
@inject BonHrApi Api
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LayoutState Layout

<PageTitle>حسابداری حقوق بن‌سازه</PageTitle>
<BonHrShell Title="حسابداری حقوق بن‌سازه" Sub="کنترل و تأیید ماهانه">
    <Actions>
        <button class="btn btn-light" type="button" @onclick="ExportArchiveAsync">خروجی بایگانی</button>
        <button class="btn btn-primary" type="button" @onclick="() => _showSettle = true">تعیین تکلیف مساعده</button>
    </Actions>
</BonHrShell>

@using System.Text

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <p class="text-muted small mb-0">کارتابل مدیر مالی حسابداری</p>
            <h2>کنترل، تأیید و بایگانی حقوق</h2>
            <p class="text-muted">پس از تأیید، نتیجه ماه قفل و برای صدور مجوز پرداخت آماده می‌شود.</p>
        </div>
        <button class="btn btn-light" type="button" @onclick="ExportArchiveAsync">خروجی بایگانی</button>
    </div>

    <form class="card card-body mt-3 v016-form accounting-selector" @onsubmit:preventDefault="true">
        <label class="form-label">ماه حقوق
            <select class="form-select" value="@_month" @onchange="OnMonthChanged">
                @foreach (var month in _months)
                {
                    <option value="@month">@BonFa.MonthLabel(month)</option>
                }
            </select>
        </label>

        <label class="form-label">پرسنل
            <select class="form-select" value="@_employeeCode" @onchange="OnEmployeeChanged">
                <option value="">— انتخاب پرسنل —</option>
                @foreach (var row in _data.Rows)
                {
                    <option value="@row.Row.Code">@row.Row.Name (@BonFa.N(row.Row.Code))</option>
                }
            </select>
        </label>

        <button class="btn btn-primary" type="button" @onclick="ApproveMonthAsync">تأیید ماه و آماده‌سازی مجوز پرداخت</button>
        <button class="btn btn-light" type="button" @onclick="SettleMonthAsync">تسویه شد</button>
        <p class="form-message wide-field">@_message</p>
    </form>

    <article class="card card-body mt-3 accounting-details">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div>
                <p class="text-muted small mb-0">جزئیات محاسبات پرسنل منتخب</p>
                <h3>@(Selected == null ? "ابتدا نام پرسنل را انتخاب کنید" : $"{Selected.Row.Name} — {BonFa.MonthLabel(_month)}")</h3>
            </div>
            <span class="badge badge-soft-primary">خالص نهایی: @BonFa.N(Selected?.FinalNet ?? 0) ریال</span>
        </div>

        @if (Selected != null)
        {
            <div class="accounting-summary">
                <div><span>ناخالص</span><strong>@BonFa.N(Selected.Row.Gross)</strong></div>
                <div><span>حقوق پایه</span><strong>@BonFa.N(Selected.Row.Base)</strong></div>
                <div><span>اضافه‌کار</span><strong>@BonFa.N(Selected.Row.OtPay)</strong></div>
                <div><span>کسرکار</span><strong>@BonFa.N(Selected.Row.ShortfallPay)</strong></div>
                <div><span>بیمه</span><strong>@BonFa.N(Selected.Row.Insurance)</strong></div>
                <div><span>مالیات</span><strong>@BonFa.N(Selected.Row.Tax)</strong></div>
                <div><span>کارانه</span><strong>@BonFa.N(Selected.Row.Performance)</strong></div>
                <div><span>خالص اولیه</span><strong>@BonFa.N(Selected.Row.Net)</strong></div>
            </div>

            <div class="accounting-edit-grid">
                <label class="form-label">مبلغ مالیات <BonHrRial @bind-Value="_tax" /></label>
                <label class="form-label">مبلغ بیمه <BonHrRial @bind-Value="_insurance" /></label>
                <label class="form-label">مبلغ اضافه‌کار <BonHrRial @bind-Value="_overtime" /></label>
                <label class="form-label">مبلغ کسرکار <BonHrRial @bind-Value="_shortfall" /></label>
                <label class="form-label">مبلغ کارانه <BonHrRial @bind-Value="_performance" /></label>
                <label class="form-label">مبلغ بهره‌وری <BonHrRial @bind-Value="_productivity" /></label>
                <label class="form-label">سایر پرداختی‌ها <BonHrRial @bind-Value="_otherPayments" /></label>
            </div>

            <label class="accounting-reason">
                دلیل اصلاح
                <textarea class="form-control" rows="2" placeholder="در صورت تغییر هر مبلغ، ثبت دلیل اجباری است." @bind="_reason"></textarea>
            </label>

            <button class="btn btn-light" type="button" @onclick="SaveAdjustmentAsync" disabled="@_data.Locked">
                ثبت اصلاحات و ارسال گزارش برای مدیرعامل
            </button>

            @if (_data.Locked)
            {
                <p class="payroll-warning">این ماه تأیید و قفل شده است؛ امکان اصلاح وجود ندارد.</p>
            }
        }
    </article>

    <Modal Size="modal-xl" Visible="_showSettle" Title="تعیین تکلیف مساعده" OnClose="() => _showSettle = false">
        <ChildContent>
        <form id="bon-set-form" @onsubmit="SaveSettlementAsync" @onsubmit:preventDefault="true">
            <label class="form-label">مساعده پرسنل منتخب
                <select class="form-select" value="@_settlementAdvanceId" @onchange="OnAdvanceChanged">
                    <option value="0">— انتخاب مساعده —</option>
                    @foreach (var advance in SelectedAdvances)
                    {
                        <option value="@advance.Id">@BonFa.N(advance.Date) — @BonFa.N(advance.Amount) ریال (مانده @BonFa.N(advance.Balance))</option>
                    }
                </select>
            </label>

            <label class="form-label">روش تسویه
                <select class="form-select" @bind="_settlementMethod">
                    <option value="pending">فعلاً کسر نشود</option>
                    <option value="full">تسویه کامل در ماه جاری</option>
                    <option value="installment">تسویه مرحله‌ای</option>
                </select>
            </label>

            @if (_settlementMethod is "full" or "installment")
            {
                <label class="installment-field">ماه شروع <input class="form-control" placeholder="1405/04" @bind="_settlementStartMonth" /></label>
            }

            @if (_settlementMethod == "installment")
            {
                <label class="installment-field">تعداد اقساط <input class="form-control" type="number" min="1" max="60" @bind="_settlementCount" /></label>
                <label class="installment-field">مبلغ هر قسط (ریال) <BonHrRial @bind-Value="_settlementAmount" /></label>
                <div class="installment-field settlement-plan-total" role="status">
                    جمع اقساط: @BonFa.N(_settlementAmount * _settlementCount) ریال
                </div>
            }

            <p class="form-message wide-field">@_settlementMessage</p>
        </form>
        </ChildContent>
        <Footer>
            <button class="btn btn-light" type="button" @onclick="() => _showSettle = false">انصراف</button>
            <button class="btn btn-primary" type="submit" form="bon-set-form">ثبت تصمیم تسویه</button>
        </Footer>
    </Modal>

    <div class="card card-body mt-3">
        @if (SelectedAdvance != null && SelectedAdvance.Installments.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead><tr><th>ماه قسط</th><th>مبلغ</th><th>وضعیت</th><th>عملیات</th></tr></thead>
                    <tbody>
                        @foreach (var installment in SelectedAdvance.Installments.OrderBy(i => i.Month))
                        {
                            var item = installment;
                            <tr>
                                <td>@BonFa.MonthLabel(item.Month)</td>
                                <td>@BonFa.N(item.Amount)</td>
                                <td>@(item.Applied ? "اعمال‌شده" : "در انتظار")</td>
                                <td class="row-actions">
                                    @if (!item.Applied)
                                    {
                                        <button class="btn btn-light" type="button" @onclick="() => ApplyInstallmentAsync(item)">اعمال قسط</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <p class="text-muted text-center py-3 mb-0">برای دیدن اقساط، از «تعیین تکلیف مساعده» یک رکورد انتخاب کنید.</p>
        }
    </div>

    <article class="card card-body mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>کد</th><th>نام</th><th>خالص اولیه</th><th>مساعده/بیمه تکمیلی</th><th>تغییرات حسابداری</th><th>مبلغ نهایی</th><th>وضعیت</th></tr>
                </thead>
                <tbody>
                    @foreach (var row in _data.Rows)
                    {
                        <tr>
                            <td>@BonFa.N(row.Row.Code)</td>
                            <td>@row.Row.Name</td>
                            <td>@BonFa.N(row.Row.Net)</td>
                            <td>@BonFa.N(DeductionsOf(row.Row.Code))</td>
                            <td>@(row.Adjustment == null ? "—" : row.Adjustment.Reason)</td>
                            <td>@BonFa.N(row.FinalNet)</td>
                            <td><span class="badge badge-soft-primary">@(row.Paid ? "پرداخت‌شده" : _data.Status)</span></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="row g-3 mb-3">
            <div><span>تعداد پرسنل</span><strong>@BonFa.N(_data.EmployeeCount)</strong></div>
            <div><span>جمع خالص نهایی</span><strong>@BonFa.N(_data.TotalNet)</strong></div>
            <div><span>وضعیت ماه</span><strong>@_data.Status</strong></div>
        </div>
    </article>

    <article class="card card-body mt-3">
        <h3>بایگانی معتبر ماهانه</h3>
        <div class="archive-cards">
            @foreach (var archive in _archives)
            {
                <div class="archive-card">
                    <strong>@BonFa.MonthLabel(archive.Month)</strong>
                    <span class="badge badge-soft-primary">@archive.Status</span>
                    <p>جمع خالص: <b>@BonFa.N(archive.TotalNet)</b> ریال</p>
                    <p>تعداد پرسنل: <b>@BonFa.N(archive.EmployeeCount)</b></p>
                    <small>تأیید: @archive.ApprovedBy @(archive.ApprovedAt?.ToString("yyyy-MM-dd") ?? "")</small>
                    @if (!string.IsNullOrEmpty(archive.SettledBy))
                    {
                        <small>تسویه: @archive.SettledBy @(archive.SettledAt?.ToString("yyyy-MM-dd") ?? "")</small>
                    }
                </div>
            }
        </div>
        @if (_archives.Count == 0) { <p class="text-muted text-center py-4">بایگانی‌ای ثبت نشده است.</p> }
    </article>


@code {
    private List<string> _months = new();
    private List<AccountingArchive> _archives = new();
    private List<Advance> _advances = new();
    private AccountingMonthDto _data = new();

    private string _month = "";
    private string _employeeCode = "";
    private string _message = "";

    private decimal _tax, _insurance, _overtime, _shortfall, _performance, _productivity, _otherPayments;
    private string _reason = "";

    private int _settlementAdvanceId;
    private string _settlementMethod = "pending";
    private string _settlementStartMonth = "";
    private int _settlementCount = 1;
    private decimal _settlementAmount;
    private string _settlementMessage = "";
    private bool _showSettle;

    private AccountingRowDto? Selected =>
        _data.Rows.FirstOrDefault(r => r.Row.Code == _employeeCode);

    private List<Advance> SelectedAdvances =>
        _advances.Where(a => a.EmployeeCode == _employeeCode).ToList();

    private Advance? SelectedAdvance =>
        _advances.FirstOrDefault(a => a.Id == _settlementAdvanceId);

    protected override async Task OnInitializedAsync()
    {
        _months = await Api.ListAsync<string>("api/payroll/months");
        _month = _months.LastOrDefault() ?? "";
        _advances = await Api.ListAsync<Advance>("api/workflows/advances");
        _archives = await Api.ListAsync<AccountingArchive>("api/workflows/archives");
        await LoadMonthAsync();
    }

    private async Task LoadMonthAsync()
    {
        if (string.IsNullOrEmpty(_month)) { _data = new AccountingMonthDto(); return; }
        _data = await Api.GetAsync<AccountingMonthDto>($"api/workflows/accounting/{_month}") ?? new AccountingMonthDto();
        LoadAdjustmentFields();
    }

    private void LoadAdjustmentFields()
    {
        var selected = Selected;
        if (selected == null) return;

        var adjustment = selected.Adjustment;
        _tax = adjustment?.Tax ?? selected.Row.Tax;
        _insurance = adjustment?.Insurance ?? selected.Row.Insurance;
        _overtime = adjustment?.Overtime ?? selected.Row.OtPay;
        _shortfall = adjustment?.Shortfall ?? selected.Row.ShortfallPay;
        _performance = adjustment?.Performance ?? selected.Row.Performance;
        _productivity = adjustment?.Productivity ?? 0m;
        _otherPayments = adjustment?.OtherPayments ?? 0m;
        _reason = adjustment?.Reason ?? "";
    }

    /// <summary>کسورات جانبی: اقساط مساعدهٔ همان ماه + سهم بیمه تکمیلی کارمند</summary>
    private decimal DeductionsOf(string code)
    {
        var installment = _advances
            .Where(a => a.EmployeeCode == code)
            .SelectMany(a => a.Installments)
            .Where(i => i.Month == _month)
            .Sum(i => i.Amount);
        return installment;
    }

    private async Task OnMonthChanged(ChangeEventArgs args)
    {
        _month = args.Value?.ToString() ?? "";
        await LoadMonthAsync();
    }

    private void OnEmployeeChanged(ChangeEventArgs args)
    {
        _employeeCode = args.Value?.ToString() ?? "";
        _settlementAdvanceId = 0;
        LoadAdjustmentFields();
    }

    private void OnAdvanceChanged(ChangeEventArgs args)
    {
        _settlementAdvanceId = int.TryParse(args.Value?.ToString(), out var id) ? id : 0;
        var advance = SelectedAdvance;
        if (advance == null) return;

        _settlementMethod = advance.SettlementMethod;
        _settlementStartMonth = string.IsNullOrEmpty(advance.SettlementStartMonth) ? _month : advance.SettlementStartMonth;
        _settlementCount = advance.SettlementCount > 0 ? advance.SettlementCount : 1;
        _settlementAmount = advance.SettlementAmount;
    }

    private async Task SaveAdjustmentAsync()
    {
        if (Selected == null) return;
        if (string.IsNullOrWhiteSpace(_reason)) { _message = "ثبت دلیل اصلاح الزامی است."; return; }

        var ok = await Api.SendAsync(HttpMethod.Post, "api/workflows/accounting/adjust", new AccountingAdjustment
        {
            Month = _month,
            EmployeeCode = _employeeCode,
            Tax = _tax,
            Insurance = _insurance,
            Overtime = _overtime,
            Shortfall = _shortfall,
            Performance = _performance,
            Productivity = _productivity,
            OtherPayments = _otherPayments,
            Reason = _reason.Trim()
        });

        if (!ok) return;
        _message = "اصلاحات ثبت و گزارش برای مدیرعامل ارسال شد.";
        await LoadMonthAsync();
    }

    private async Task ApproveMonthAsync()
    {
        var ok = await Api.SendAsync(HttpMethod.Post, $"api/workflows/accounting/{_month}/approve");
        if (!ok) return;
        _archives = await Api.ListAsync<AccountingArchive>("api/workflows/archives");
        await LoadMonthAsync();
    }

    private async Task SettleMonthAsync()
    {
        var paidDate = PersianCalendarUtil.TodayKey();
        var reference = $"PAY-{_month.Replace("/", "")}";
        var ok = await Api.SendAsync(HttpMethod.Post,
            $"api/workflows/accounting/{_month}/settle?paidDate={paidDate}&reference={reference}");
        if (!ok) return;
        _archives = await Api.ListAsync<AccountingArchive>("api/workflows/archives");
        await LoadMonthAsync();
    }

    private async Task SaveSettlementAsync()
    {
        var advance = SelectedAdvance;
        if (advance == null) { _settlementMessage = "ابتدا مساعده را انتخاب کنید."; return; }

        if (_settlementMethod is "full" or "installment" && string.IsNullOrWhiteSpace(_settlementStartMonth))
        {
            _settlementMessage = "ماه شروع تسویه را وارد کنید (نمونه: 1405/04).";
            return;
        }

        var ok = await Api.SendAsync(HttpMethod.Post, $"api/workflows/advances/{advance.Id}/settlement", new Advance
        {
            SettlementMethod = _settlementMethod,
            SettlementStartMonth = _settlementStartMonth,
            SettlementCount = _settlementCount,
            SettlementAmount = _settlementAmount
        });

        if (!ok) return;
        _settlementMessage = "تصمیم تسویه ثبت شد.";
        _showSettle = false;
        _advances = await Api.ListAsync<Advance>("api/workflows/advances");
    }

    private async Task ApplyInstallmentAsync(AdvanceInstallment installment)
    {
        var ok = await Api.SendAsync(HttpMethod.Post, $"api/workflows/advances/installments/{installment.Id}/apply");
        if (ok) _advances = await Api.ListAsync<Advance>("api/workflows/advances");
    }

    private async Task ExportArchiveAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("ماه,وضعیت,جمع خالص,تعداد پرسنل,تأییدکننده,تاریخ تأیید,تسویه‌کننده,تاریخ تسویه");
        foreach (var a in _archives)
            csv.AppendLine($"{a.Month},{a.Status},{a.TotalNet},{a.EmployeeCount},{a.ApprovedBy},{a.ApprovedAt:yyyy-MM-dd},{a.SettledBy},{a.SettledAt:yyyy-MM-dd}");

        csv.AppendLine();
        csv.AppendLine($"ریز ماه {_month}");
        csv.AppendLine("کد,نام,خالص اولیه,کسورات جانبی,دلیل اصلاح,خالص نهایی,پرداخت‌شده");
        foreach (var row in _data.Rows)
            csv.AppendLine($"{row.Row.Code},{row.Row.Name},{row.Row.Net},{DeductionsOf(row.Row.Code)},{row.Adjustment?.Reason},{row.FinalNet},{(row.Paid ? "بله" : "خیر")}");

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await JS.InvokeVoidAsync("saveAsFile", "accounting-archive.csv", Convert.ToBase64String(bytes));
        Toast.Success("خروجی بایگانی حسابداری آماده شد.");
    }
}
