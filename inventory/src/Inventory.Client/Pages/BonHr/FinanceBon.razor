@namespace Inventory.Client.Pages.BonHr
@page "/bon-hr/finance"
@inject BonHrApi Api
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LayoutState Layout

<PageTitle>مالی بن‌سازه</PageTitle>
<BonHrShell Title="مالی بن‌سازه" Sub="مساعده و پرداخت حقوق">
    <Actions>
        <button class="btn btn-primary" type="button" @onclick="() => _showForm = true">
            <i class="bi bi-plus-lg"></i> مساعده جدید
        </button>
    </Actions>
</BonHrShell>

@using System.Text

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <p class="text-muted small mb-0">کارتابل مالی</p>
            <h2>ثبت مساعده پرداخت‌شده</h2>
            <p class="text-muted">کاربر مالی فقط نام پرسنل، تاریخ پرداخت از تقویم و مبلغ مساعده را ثبت می‌کند.</p>
        </div>
        <span class="badge badge-soft-primary">@BonFa.N(_advances.Sum(a => a.Balance)) ریال مانده</span>
    </div>

    <Modal Size="modal-xl" Visible="_showForm" Title="ثبت مساعده پرداخت‌شده" OnClose="() => _showForm = false">
        <ChildContent>
    <form id="bon-adv-form" @onsubmit="SaveAdvanceAsync" @onsubmit:preventDefault="true">
        <label class="form-label">پرسنل
            <select class="form-select" required value="@_advance.EmployeeCode" @onchange="OnEmployeeChanged">
                <option value="">— انتخاب پرسنل —</option>
                @foreach (var employee in _employees)
                {
                    <option value="@employee.Code">@employee.First @employee.Last (@BonFa.N(employee.Code))</option>
                }
            </select>
        </label>

        <label class="form-label">تاریخ پرداخت
            <BonHrDate @bind-Value="_advance.Date" />
        </label>

        <label class="form-label">مبلغ مساعده (ریال) <BonHrRial @bind-Value="_advance.Amount" /></label>

        <div class="advance-debt-status wide-field" role="status">
            @if (string.IsNullOrEmpty(_advance.EmployeeCode))
            {
                <span class="text-muted">با انتخاب پرسنل، مانده بدهی قبلی نمایش داده می‌شود.</span>
            }
            else if (SelectedOpenAdvances.Count == 0)
            {
                <span>این پرسنل مساعده تسویه‌نشده ندارد.</span>
            }
            else
            {
                <span>
                    <b>@BonFa.N(SelectedOpenAdvances.Count)</b> مساعده تسویه‌نشده با مانده کل
                    <b>@BonFa.N(SelectedOpenAdvances.Sum(a => a.Balance))</b> ریال دارد.
                </span>
            }
        </div>

        <p class="form-message wide-field">@_message</p>
    </form>
        </ChildContent>
        <Footer>
            <button class="btn btn-light" type="button" @onclick="() => _showForm = false">انصراف (Esc)</button>
            <button class="btn btn-primary" type="submit" form="bon-adv-form">ثبت مساعده</button>
        </Footer>
    </Modal>

    <article class="card card-body mt-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <h3>سوابق مساعده‌های ثبت‌شده</h3>
            <button class="btn btn-light" type="button" @onclick="ExportAsync">خروجی سوابق</button>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr><th>پرسنل</th><th>تاریخ پرداخت</th><th>مبلغ</th><th>وضعیت تعیین تکلیف</th><th>کسرشده</th><th>مانده</th></tr>
                </thead>
                <tbody>
                    @foreach (var advance in _advances)
                    {
                        <tr>
                            <td>@NameOf(advance.EmployeeCode)<br /><small class="text-muted">@BonFa.N(advance.EmployeeCode)</small></td>
                            <td>@BonFa.N(advance.Date)</td>
                            <td>@BonFa.N(advance.Amount)</td>
                            <td><span class="badge badge-soft-primary">@advance.SettlementStatus</span></td>
                            <td>@BonFa.N(advance.Deducted)</td>
                            <td>@BonFa.N(advance.Balance)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_advances.Count == 0) { <p class="text-muted text-center py-4">هنوز مساعده‌ای ثبت نشده است.</p> }
    </article>

    <article class="card card-body mt-3">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
            <div><p class="text-muted small mb-0">پرداخت‌های حقوق</p><h3>فیش‌های تسویه‌شده</h3></div>
            <label class="form-label">ماه
                <select class="form-select" value="@_paymentMonth" @onchange="OnPaymentMonthChanged">
                    <option value="">همه ماه‌ها</option>
                    @foreach (var month in _months)
                    {
                        <option value="@month">@BonFa.MonthLabel(month)</option>
                    }
                </select>
            </label>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead><tr><th>ماه</th><th>پرسنل</th><th>مبلغ</th><th>تاریخ پرداخت</th><th>مرجع</th><th>ثبت‌کننده</th></tr></thead>
                <tbody>
                    @foreach (var payment in _payments)
                    {
                        <tr>
                            <td>@BonFa.MonthLabel(payment.Month)</td>
                            <td>@NameOf(payment.EmployeeCode)</td>
                            <td>@BonFa.N(payment.Amount)</td>
                            <td>@BonFa.N(payment.PaidDate)</td>
                            <td>@BonFa.N(payment.Reference)</td>
                            <td>@payment.PaidBy</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_payments.Count == 0) { <p class="text-muted text-center py-4">پرداختی ثبت نشده است.</p> }
    </article>


@code {
    private List<Advance> _advances = new();
    private List<Employee> _employees = new();
    private List<PayrollPayment> _payments = new();
    private List<string> _months = new();

    private Advance _advance = new();
    private string _message = "";
    private bool _showForm;
    private string _paymentMonth = "";

    private List<Advance> SelectedOpenAdvances =>
        _advances.Where(a => a.EmployeeCode == _advance.EmployeeCode && a.Balance > 0).ToList();

    protected override async Task OnInitializedAsync()
    {
        _employees = await Api.ListAsync<Employee>("api/employees");
        _months = await Api.ListAsync<string>("api/payroll/months");
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _advances = await Api.ListAsync<Advance>("api/workflows/advances");
        var url = string.IsNullOrEmpty(_paymentMonth) ? "api/workflows/payments" : $"api/workflows/payments?month={_paymentMonth}";
        _payments = await Api.ListAsync<PayrollPayment>(url);
    }

    private string NameOf(string code)
    {
        var employee = _employees.FirstOrDefault(e => e.Code == code);
        return employee == null ? code : $"{employee.First} {employee.Last}";
    }

    private void OnEmployeeChanged(ChangeEventArgs args) =>
        _advance.EmployeeCode = args.Value?.ToString() ?? "";

    private async Task OnPaymentMonthChanged(ChangeEventArgs args)
    {
        _paymentMonth = args.Value?.ToString() ?? "";
        await ReloadAsync();
    }

    private async Task SaveAdvanceAsync()
    {
        if (string.IsNullOrEmpty(_advance.EmployeeCode)) { _message = "انتخاب پرسنل الزامی است."; return; }
        if (_advance.Amount <= 0) { _message = "مبلغ مساعده باید بزرگ‌تر از صفر باشد."; return; }

        var ok = await Api.SendAsync(HttpMethod.Post, "api/workflows/advances", _advance);
        if (!ok) return;

        _message = "مساعده ثبت شد و برای تعیین تکلیف به حسابداری ارسال گردید.";
        _advance = new Advance();
        _showForm = false;
        await ReloadAsync();
    }

    private async Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine("کد پرسنلی,نام,تاریخ پرداخت,مبلغ,وضعیت,کسرشده,مانده,روش تسویه,ماه شروع,تعداد اقساط");
        foreach (var a in _advances)
            csv.AppendLine($"{a.EmployeeCode},{NameOf(a.EmployeeCode)},{a.Date},{a.Amount},{a.SettlementStatus},{a.Deducted},{a.Balance},{a.SettlementMethod},{a.SettlementStartMonth},{a.SettlementCount}");

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await JS.InvokeVoidAsync("saveAsFile", "advances.csv", Convert.ToBase64String(bytes));
        Toast.Success("خروجی سوابق مساعده آماده شد.");
    }
}
