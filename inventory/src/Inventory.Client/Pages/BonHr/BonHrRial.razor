<input class="form-control num" dir="ltr" value="@Display"
       @oninput="OnInput" placeholder="@Placeholder" />

@code {
    [Parameter] public decimal Value { get; set; }
    [Parameter] public EventCallback<decimal> ValueChanged { get; set; }
    [Parameter] public string? Placeholder { get; set; }

    private string Display => Value == 0 ? "" : BonFa.Rial(Value);

    private async Task OnInput(ChangeEventArgs e)
    {
        var n = BonFa.ParseRial(e.Value?.ToString());
        Value = n;
        await ValueChanged.InvokeAsync(n);
    }
}
