@namespace Inventory.Client.Pages.BonHr
@page "/bon-hr/production-daily"
@inject BonHrApi Api
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject LayoutState Layout

<PageTitle>گزارش روزانه حضور</PageTitle>
<BonHrShell Title="گزارش روزانه حضور" Sub="کارکرد روز و تجمیع ماه" />

@using System.Text

    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <p class="text-muted small mb-0">کارتابل مدیر تولید</p>
            <h2>گزارش روزانه حضور پرسنل</h2>
            <p class="text-muted">کارکرد روز انتخابی و تجمیع مرخصی، کسرکار و اضافه‌کار از ابتدای ماه تا همان تاریخ.</p>
        </div>
        <div class="d-flex gap-2 flex-wrap">
            <label class="form-label">تاریخ گزارش
                <BonHrDate Value="_date" ValueChanged="OnDatePicked" AllowClear="false" />
            </label>
            <button class="btn btn-light" type="button" @onclick="ExportAsync">خروجی گزارش</button>
        </div>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="kpi kpi-blue"><div class="kpi-num">@BonFa.N(_rows.Count)</div><div class="kpi-lbl">پرسنل</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi kpi-green"><div class="kpi-num">@BonFa.N(_rows.Count(r => r.Status.Contains("حاضر")))</div><div class="kpi-lbl">حاضر</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi kpi-orange"><div class="kpi-num">@BonFa.N(_rows.Count(r => r.Status.Contains("مرخصی") || r.Status.Contains("مأموریت")))</div><div class="kpi-lbl">مرخصی/مأموریت</div></div></div>
        <div class="col-6 col-md-3"><div class="kpi kpi-red"><div class="kpi-num">@BonFa.N(_rows.Count(r => r.Status.Contains("غایب")))</div><div class="kpi-lbl">غایب</div></div></div>
    </div>

    <article class="card card-body mt-3">
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>پرسنل</th><th>حضور روز</th><th>وضعیت</th><th>مرخصی روز</th>
                        <th>کسرکار روز</th><th>اضافه‌کار روز</th><th>تجمیع ماه تا تاریخ</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in _rows)
                    {
                        <tr>
                            <td>@row.Name<br /><small class="text-muted">@BonFa.N(row.Code)</small></td>
                            <td>@BonFa.N(row.Presence)</td>
                            <td><span class="badge badge-soft-primary">@row.Status</span></td>
                            <td>@BonFa.N(row.Leave)</td>
                            <td>@BonFa.N(row.Shortfall)</td>
                            <td>@BonFa.N(row.Ot)</td>
                            <td>
                                <small>
                                    حضور @BonFa.N(row.MonthPresence) — مرخصی @BonFa.N(row.MonthLeave)<br />
                                    کسرکار @BonFa.N(row.MonthShortfall) — اضافه‌کار @BonFa.N(row.MonthOt)
                                </small>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        @if (_rows.Count == 0)
        {
            <p class="text-muted text-center py-4">برای این تاریخ رکوردی وجود ندارد.</p>
        }
    </article>


@code {
    private List<DailyReportRow> _rows = new();
    private string _date = PersianCalendarUtil.TodayKey();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        if (string.IsNullOrEmpty(_date)) return;
        _rows = await Api.ListAsync<DailyReportRow>($"api/attendance/daily-report?date={_date}");
    }

    private async Task OnDatePicked(string? value)
    {
        _date = value ?? "";
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        var csv = new StringBuilder();
        csv.AppendLine($"گزارش روزانه حضور — {_date}");
        csv.AppendLine("کد,نام,حضور روز,وضعیت,مرخصی روز,کسرکار روز,اضافه‌کار روز,حضور ماه,مرخصی ماه,کسرکار ماه,اضافه‌کار ماه");
        foreach (var r in _rows)
            csv.AppendLine($"{r.Code},{r.Name},{r.Presence},{r.Status},{r.Leave},{r.Shortfall},{r.Ot},{r.MonthPresence},{r.MonthLeave},{r.MonthShortfall},{r.MonthOt}");

        var bytes = Encoding.UTF8.GetPreamble().Concat(Encoding.UTF8.GetBytes(csv.ToString())).ToArray();
        await JS.InvokeVoidAsync("saveAsFile", $"daily-{_date.Replace("/", "-")}.csv", Convert.ToBase64String(bytes));
        Toast.Success("خروجی گزارش روزانه آماده شد.");
    }
}
