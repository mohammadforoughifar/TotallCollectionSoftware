@inject LayoutState Layout

<div class="page-head">
    <div>
        <h1>@Title</h1>
        @if (!string.IsNullOrWhiteSpace(Sub))
        {
            <p class="lead">@Sub</p>
        }
    </div>
    <div class="ms-auto d-flex gap-2 flex-wrap">@Actions</div>
</div>

@ChildContent

<style>
.kpi{border-radius:16px;padding:1rem .6rem;text-align:center;border:1px solid #e2e6f1;background:#fff;box-shadow:0 4px 14px rgba(45,55,110,.08);border-top:4px solid #8e5cff;}
.kpi-num{font-size:1.5rem;font-weight:900;line-height:1.2;}
.kpi-lbl{font-size:.78rem;font-weight:700;color:#5f688a;margin-top:.25rem;}
.kpi-blue{border-top-color:#3f8cff;} .kpi-blue .kpi-num{color:#1d5fc2;}
.kpi-orange{border-top-color:#f4a23c;} .kpi-orange .kpi-num{color:#b06a00;}
.kpi-red{border-top-color:#e0245e;} .kpi-red .kpi-num{color:#b21b4c;}
.kpi-green{border-top-color:#2ec47e;} .kpi-green .kpi-num{color:#0e8a55;}
.kpi-teal{border-top-color:#14b8a6;} .kpi-teal .kpi-num{color:#0e8577;}
.kpi-purple{border-top-color:#8e5cff;} .kpi-purple .kpi-num{color:#6d4dff;}
.modal-dialog.modal-lg{max-width:min(920px,96vw);}
.modal-dialog.modal-xl{max-width:min(1140px,96vw);}
.modal-body{max-height:min(78vh,760px);overflow:auto;}
.wc-week-header,.wc-days{display:grid;grid-template-columns:repeat(7,1fr);gap:4px;}
.wc-week-header span{text-align:center;font-size:.7rem;font-weight:800;color:#94a3b8;}
.wc-day,button.wc-day{border:1px solid transparent;background:#f8fafc;border-radius:8px;min-height:48px;display:flex;flex-direction:column;align-items:center;justify-content:center;font-size:.8rem;font-weight:700;color:#334155;padding:.2rem;min-width:0;}
button.wc-day{cursor:pointer;}
button.wc-day:hover{box-shadow:0 2px 8px rgba(0,0,0,.12);}
.wc-day.d-rest,button.wc-day.d-rest{background:#f1f5f9;color:#64748b;}
.wc-day.d-official,button.wc-day.d-official{background:#dc2626;color:#fff;}
.wc-day.d-company,button.wc-day.d-company{background:#f59e0b;color:#fff;}
.wc-day.d-morning{background:#dbeafe;color:#1e40af;}
.wc-day.d-night{background:#1e1b4b;color:#fff;}
.wc-day.d-today,button.wc-day.d-today{outline:2px solid #1e293b;outline-offset:1px;}
.wc-day.d-sel,button.wc-day.d-sel{box-shadow:0 0 0 3px #93c5fd;}
.wc-day small{font-size:.58rem;font-weight:700;max-width:100%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.wc-legend{display:flex;flex-wrap:wrap;gap:.8rem;font-size:.78rem;color:#64748b;}
.wc-dot{display:inline-block;width:11px;height:11px;border-radius:3px;margin-inline-end:.25rem;vertical-align:middle;}
.wc-dot-work{background:#f8fafc;border:1px solid #cbd5e1;}
.wc-dot-rest{background:#f1f5f9;border:1px solid #94a3b8;}
.wc-dot-official{background:#dc2626;}
.wc-dot-company{background:#f59e0b;}
.wc-dot-today{background:#fff;outline:2px solid #1e293b;}
.wc-month-head{display:flex;justify-content:space-between;align-items:center;gap:.5rem;margin-bottom:.6rem;}
.form-grid .form-label,label.form-label{display:block;font-weight:700;color:#475569;margin-bottom:.65rem;}
label.form-label > input,label.form-label > select,label.form-label > textarea,label.form-label > .date-picker{display:block;width:100%;margin-top:.25rem;}
</style>

@code {
    [Parameter] public string Title { get; set; } = "منابع انسانی بن‌سازه";
    [Parameter] public string Sub { get; set; } = "";
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    protected override void OnParametersSet() => Layout.SetTitle(Title);
}
