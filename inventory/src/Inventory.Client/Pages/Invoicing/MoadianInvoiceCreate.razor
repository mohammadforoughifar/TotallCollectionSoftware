@page "/moadian/invoice-new"
@using Microsoft.AspNetCore.Components
@inject IMoadianStandaloneClientService StandaloneSvc
@inject IMoadianMasterDataClientService MasterDataSvc
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>ثبت صورتحساب جدید</PageTitle>

<div class="page-head">
    <div>
        <h1>ثبت صورتحساب جدید</h1>
        <p class="lead">ثبت مستقل از ERP — مشتری و کالا/خدمت از «اطلاعات پایه مودیان» تکمیل می‌شود</p>
    </div>
    <div class="ms-auto d-flex gap-2 flex-wrap">
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/fiscal-years")'>
            <i class="bi bi-calendar3"></i> سال مالی مودیان
        </button>
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/master-data")'>
            <i class="bi bi-database"></i> اطلاعات پایه مودیان
        </button>
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/provider-invoices")'>
            <i class="bi bi-list-ul"></i> فهرست صورتحساب‌ها
        </button>
    </div>
</div>

@if (savedInvoice is not null)
{
    <div class="card border-success mb-3">
        <div class="card-header bg-success bg-opacity-10 fw-bold">
            <i class="bi bi-check-circle-fill text-success"></i> صورتحساب ثبت شد
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="small text-muted">شمارهٔ صورتحساب (سند سالانه)</div>
                    <div class="fs-4 fw-bold num" dir="ltr">@savedInvoice.DocumentNumber</div>
                </div>
                <div class="col-md-3">
                    <div class="small text-muted">سریال سراسری داخلی</div>
                    <div class="fs-5 num">@savedInvoice.Number</div>
                </div>
                <div class="col-md-2">
                    <div class="small text-muted">سال / دوره</div>
                    <div class="num">@savedInvoice.FiscalYear — @savedInvoice.FiscalPeriodTitle</div>
                </div>
                <div class="col-md-2">
                    <div class="small text-muted">مبلغ کل</div>
                    <div class="num fw-bold">@savedInvoice.TotalNet.Money()</div>
                </div>
                <div class="col-md-2">
                    <div class="small text-muted">وضعیت</div>
                    <div>@StatusBadge(savedInvoice.Status)</div>
                </div>
            </div>
            <div class="alert alert-warning py-2 small mt-3 mb-0">
                این صورتحساب با وضعیت «ارسال نشده» ثبت شد؛ ارسال به سامانهٔ مودیان در این نسخه فعال نیست.
            </div>
            <div class="mt-3 d-flex gap-2">
                <button class="btn btn-primary" @onclick="StartNewForm"><i class="bi bi-plus-lg"></i> ثبت صورتحساب جدید</button>
                <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/provider-invoices")'>
                    <i class="bi bi-list-ul"></i> فهرست صورتحساب‌ها
                </button>
            </div>
        </div>
    </div>
}
else if (loadingRefs)
{
    <div class="text-center py-5">
        <span class="spinner-border text-primary"></span>
        <div class="small text-muted mt-2">در حال بارگذاری سال‌های مالی، مشتریان و کالا/خدمات...</div>
    </div>
}
else
{
    @if (!string.IsNullOrWhiteSpace(numberWarning))
    {
        <div class="alert alert-warning py-2 small d-flex gap-2 align-items-start">
            <i class="bi bi-exclamation-triangle-fill mt-1"></i>
            <div>
                @numberWarning
                <a class="ms-2" href="/moadian/fiscal-years">تعریف/اصلاح سال مالی</a>
            </div>
        </div>
    }

    <!-- ===== مشخصات صورتحساب ===== -->
    <div class="card mb-3">
        <div class="card-header fw-bold"><i class="bi bi-receipt"></i> مشخصات صورتحساب</div>
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-3">
                    <label class="form-label small">شمارهٔ صورتحساب جدید</label>
                    <input class="form-control form-control-sm num fw-bold" dir="ltr" readonly
                           value="@(nextNumber?.DocumentNumber ?? "—")" />
                    <div class="form-text">
                        سریال داخلی: <span class="num">@(nextNumber?.NextGlobalNumber ?? 0)</span>
                        · دوره: <span class="num">@(nextNumber?.FiscalPeriodTitle ?? "—")</span>
                        <br />شمارهٔ نهایی هنگام ذخیره قطعی می‌شود.
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">سال مالی <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" @bind="selectedYearId" @bind:after="RefreshNumberAsync">
                        <option value="0">— خودکار از تاریخ —</option>
                        @foreach (var y in years)
                        {
                            <option value="@y.Id">@y.Year@(y.IsClosed ? " (بسته)" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">تاریخ فاکتور <span class="text-danger">*</span></label>
                    <DatePicker Value="@((DateTime?)form.Date)" ValueChanged="OnDateChanged" MinYear="1390" MaxYear="1440" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">موضوع صورتحساب <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" @bind="form.Subject">
                        @foreach (var s in SubjectOptions)
                        {
                            <option value="@s">@MoadianInvoiceRules.SubjectTitle(s) (@((int)s))</option>
                        }
                    </select>
                    <div class="form-text">کد رسمی موضوع صورتحساب در پرانتز آمده است.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">وضعیت</label>
                    <div class="form-control form-control-sm bg-light d-flex align-items-center gap-2">
                        @StatusBadge(MoadianInvoiceStatus.Draft)
                        <span class="small text-muted">پس از ثبت، این صورتحساب «ارسال نشده» می‌ماند؛ ارسال به سامانه در این نسخه انجام نمی‌شود.</span>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small">الگوی صورتحساب <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" @bind="form.InvoicePattern">
                        @foreach (var p in PatternOptions)
                        {
                            <option value="@p">@MoadianInvoiceRules.PatternTitle(p) (@((int)p))</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">نوع صورتحساب</label>
                    <select class="form-select form-select-sm" @bind="form.InvoiceType" @bind:after="OnInvoiceTypeChanged">
                        <option value="@MoadianTaxInvoiceType.Type1">۱ — نوع اول</option>
                        <option value="@MoadianTaxInvoiceType.Type2">۲ — نوع دوم</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">نوع پرداخت صورتحساب <span class="text-danger">*</span></label>
                    <select class="form-select form-select-sm" @bind="form.PayType">
                        @foreach (var pay in MoadianPayTypes.All)
                        {
                            <option value="@pay">@MoadianPayTypes.TitleWithCode(pay)</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label small">توضیحات</label>
                    <input class="form-control form-control-sm" maxlength="600" @bind="form.Description"
                           placeholder="توضیح اختیاری صورتحساب" />
                </div>

                @if (MoadianInvoiceRules.RequiresReference(form.Subject))
                {
                    <div class="col-md-4">
                        <label class="form-label small">شناسهٔ مالیاتی صورتحساب مرجع <span class="text-danger">*</span></label>
                        <input class="form-control form-control-sm" dir="ltr" maxlength="22" @bind="form.ReferenceTaxId" />
                        <div class="form-text">برای موضوع‌های اصلاحی/ابطالی/برگشتی، ۲۲ نویسهٔ شناسهٔ صورتحساب مرجع لازم است.</div>
                    </div>
                }
            </div>

            <hr class="my-3" />

            <div class="row g-2">
                <div class="col-md-4">
                    <label class="form-label small">مشتری</label>
                    <select class="form-select form-select-sm" @bind="selectedCustomerId" @bind:after="ApplyCustomer">
                        <option value="0">— ورود دستی —</option>
                        @foreach (var c in customers)
                        {
                            <option value="@c.Id">@CustomerLabel(c)</option>
                        }
                    </select>
                    <div class="form-text">با انتخاب مشتری، شناسه و نشانی خریدار خودکار تکمیل می‌شود.</div>
                </div>
                <div class="col-md-2">
                    <label class="form-label small">شناسه ملی خریدار</label>
                    <input class="form-control form-control-sm" dir="ltr" maxlength="50" @bind="form.BuyerTaxId" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">نام خریدار <span class="text-danger">*</span></label>
                    <input class="form-control form-control-sm" maxlength="200" @bind="form.BuyerName" />
                </div>
                <div class="col-md-1">
                    <label class="form-label small">کدپستی</label>
                    <input class="form-control form-control-sm" dir="ltr" maxlength="50" @bind="form.BuyerPostalCode" />
                </div>
                <div class="col-md-2">
                    <label class="form-label small">تلفن</label>
                    <input class="form-control form-control-sm" dir="ltr" maxlength="50" @bind="form.BuyerPhone" />
                </div>
                <div class="col-md-12">
                    <label class="form-label small">نشانی خریدار</label>
                    <input class="form-control form-control-sm" maxlength="300" @bind="form.BuyerAddress" />
                </div>
            </div>
        </div>
    </div>

    <!-- ===== اقلام ===== -->
    <div class="card mb-3">
        <div class="card-header fw-bold d-flex align-items-center justify-content-between">
            <span><i class="bi bi-list-check"></i> اقلام کالا و خدمت</span>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-primary" @onclick="AddLine">
                    <i class="bi bi-plus-lg"></i> افزودن قلم
                </button>
                <button class="btn btn-sm btn-outline-danger" @onclick="RemoveLastLine" disabled="@(lines.Count <= 1)">
                    <i class="bi bi-dash-lg"></i> حذف آخرین قلم
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-sm table-bordered align-middle text-center mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="min-width:190px">نام کالا و خدمت <span class="text-danger">*</span></th>
                            <th style="min-width:140px">واحد کالا و خدمت</th>
                            <th style="width:95px">تعداد <span class="text-danger">*</span></th>
                            <th style="width:130px">فی کالا (ریال)</th>
                            <th style="width:140px">مبلغ قبل تخفیف (ریال)</th>
                            <th style="width:120px">تخفیف (ریال)</th>
                            <th style="width:140px">مبلغ بعد تخفیف (ریال)</th>
                            <th style="width:95px">درصد مالیات</th>
                            <th style="width:150px">مالیات ارزش افزوده (ریال)</th>
                            <th style="width:150px">مبلغ کل کالا و خدمت (ریال)</th>
                            <th style="width:40px"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < lines.Count; i++)
                        {
                            var index = i;
                            var line = lines[index];
                            <tr>
                                <td>
                                    <select class="form-select form-select-sm mb-1" @bind="line.GoodsOrServiceId"
                                            @bind:after="() => ApplyGoods(index)">
                                        <option value="0">— دستی / از اطلاعات پایه —</option>
                                        @foreach (var g in goods)
                                        {
                                            <option value="@g.Id">@GoodsLabel(g)</option>
                                        }
                                    </select>
                                    <input class="form-control form-control-sm" maxlength="400" @bind="line.Request.SstTitle"
                                           placeholder="نام کالا یا خدمت" />
                                    <input class="form-control form-control-sm mt-1" dir="ltr"
                                           @bind="line.Request.SstId" maxlength="50" placeholder="شناسهٔ کالا/خدمت (اختیاری)" />
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" @bind="line.Request.UnitCode">
                                        <option value="">— انتخاب واحد —</option>
                                        @foreach (var u in units)
                                        {
                                            <option value="@u.Code">@u.Name (@u.Code)</option>
                                        }
                                    </select>
                                </td>
                                <td>
                                    <input class="form-control form-control-sm num text-center" type="number" min="0" step="0.001"
                                           @bind="line.Request.Quantity" @bind:after="Recalc" />
                                </td>
                                <td>
                                    <MoneyInput Value="line.Request.UnitPrice" ValueChanged="v => { line.Request.UnitPrice = v; Recalc(); }" Placeholder="0" />
                                </td>
                                <td class="text-center num">@line.Gross.Money()</td>
                                <td>
                                    <MoneyInput Value="line.Request.Discount" ValueChanged="v => { line.Request.Discount = v; Recalc(); }" Placeholder="0" />
                                </td>
                                <td class="text-center num">@line.AfterDiscount.Money()</td>
                                <td>
                                    <input class="form-control form-control-sm num text-center" type="number" min="0" max="100" step="0.01"
                                           @bind="line.Request.VatRate" @bind:after="Recalc" />
                                </td>
                                <td class="text-center num">@line.VatAmount.Money()</td>
                                <td class="text-center num fw-bold">@line.Total.Money()</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light" title="حذف قلم" @onclick="() => RemoveLine(index)"
                                            disabled="@(lines.Count <= 1)">
                                        <i class="bi bi-x-lg text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer">
            <div class="row g-2 small">
                <div class="col-md-3"><span class="text-muted">جمع مبلغ قبل تخفیف: </span><span class="num">@TotalGross.Money()</span></div>
                <div class="col-md-3"><span class="text-muted">جمع تخفیف: </span><span class="num">@TotalDiscount.Money()</span></div>
                <div class="col-md-3"><span class="text-muted">جمع مالیات ارزش افزوده: </span><span class="num">@TotalVat.Money()</span></div>
                <div class="col-md-3 fw-bold"><span class="text-muted">جمع کل صورتحساب: </span><span class="num text-primary fs-6">@TotalNet.Money()</span></div>
            </div>
            <div class="form-text mt-2">
                مبلغ قبل تخفیف = تعداد × فی کالا | مبلغ بعد تخفیف = مبلغ قبل تخفیف − تخفیف |
                مالیات ارزش افزوده = مبلغ بعد تخفیف × درصد مالیات | مبلغ کل = مبلغ بعد تخفیف + مالیات
            </div>
        </div>
    </div>

    <div class="d-flex gap-2 mb-4">
        <button class="btn btn-success" @onclick="Save" disabled="@(saving || !CanSave)">
            @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-save"></i> @(saving ? "در حال ثبت..." : "ثبت صورتحساب")
        </button>
        <button class="btn btn-light" @onclick="ResetForm" disabled="@saving">پاک کردن فرم</button>
        <button class="btn btn-outline-secondary" disabled title="ارسال به سامانه تا تأیید و دسترسی رسمی غیرفعال است.">
            <i class="bi bi-send"></i> ارسال به سامانه مالیاتی (غیرفعال)
        </button>
    </div>
}

@code {
    private bool loadingRefs = true;
    private bool saving;
    private List<MoadianFiscalYearDto> years = new();
    private List<MoadianCustomerProfileDto> customers = new();
    private List<MoadianGoodsOrServiceProfileDto> goods = new();
    private List<MoadianUnitOfMeasurementDto> units = new();

    private MoadianStandaloneInvoiceRequest form = NewRequest();
    private List<LineForm> lines = new();
    private int selectedYearId;
    private int selectedCustomerId;
    private MoadianNextNumberDto? nextNumber;
    private string? numberWarning;
    private MoadianInvoice? savedInvoice;

    private static readonly MoadianInvoiceSubject[] SubjectOptions =
    {
        MoadianInvoiceSubject.Original,
        MoadianInvoiceSubject.Corrective,
        MoadianInvoiceSubject.Void,
        MoadianInvoiceSubject.SaleReturn
    };

    private IReadOnlyList<MoadianInvoicePattern> PatternOptions => MoadianInvoiceRules.AvailablePatterns(form.InvoiceType);

    private decimal TotalGross => Round(lines.Sum(l => l.Gross));
    private decimal TotalDiscount => Round(lines.Sum(l => l.Request.Discount));
    private decimal TotalVat => Round(lines.Sum(l => l.VatAmount));
    private decimal TotalNet => Round(TotalGross - TotalDiscount + TotalVat);

    private bool CanSave => nextNumber?.CanCreate == true
                            && !string.IsNullOrWhiteSpace(form.BuyerName)
                            && lines.Any(l => l.Request.Quantity > 0);

    protected override async Task OnInitializedAsync() => await LoadReferencesAsync();

    private static MoadianStandaloneInvoiceRequest NewRequest() => new()
    {
        Date = DateTime.Now,
        Subject = MoadianInvoiceSubject.Original,
        InvoiceType = MoadianTaxInvoiceType.Type1,
        InvoicePattern = MoadianInvoicePattern.Sale,
        PayType = MoadianPayType.Cash
    };

    private async Task LoadReferencesAsync()
    {
        loadingRefs = true;
        try
        {
            var yearsTask = StandaloneSvc.GetFiscalYearsAsync();
            var customersTask = MasterDataSvc.GetCustomersAsync();
            var goodsTask = MasterDataSvc.GetGoodsOrServicesAsync();
            var unitsTask = MasterDataSvc.GetUnitsAsync();
            await Task.WhenAll(yearsTask, customersTask, goodsTask, unitsTask);

            years = await yearsTask;
            customers = (await customersTask).Where(c => !c.IsDeleted).ToList();
            goods = (await goodsTask).Where(g => !g.IsDeleted).ToList();
            units = (await unitsTask).Where(u => !u.IsDeleted).ToList();

            var faYear = PersianDate.FromGregorian(form.Date).Year;
            selectedYearId = years.FirstOrDefault(y => y.Year == faYear && !y.IsClosed)?.Id
                             ?? years.FirstOrDefault(y => y.Year == faYear)?.Id
                             ?? 0;

            if (lines.Count == 0) AddLine();
            if (units.Count > 0) lines[0].Request.UnitCode = units[0].Code;
            await RefreshNumberAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loadingRefs = false; }
    }

    private async Task RefreshNumberAsync()
    {
        try
        {
            nextNumber = await StandaloneSvc.GetNextNumberAsync(selectedYearId, form.Date);
            numberWarning = nextNumber.Warning;
        }
        catch (Exception ex)
        {
            nextNumber = null;
            numberWarning = ex.Message;
        }
    }

    private async Task OnDateChanged(DateTime? value)
    {
        if (value is null) return;
        form.Date = value.Value;
        if (selectedYearId == 0 || years.FirstOrDefault(y => y.Id == selectedYearId)?.Year != PersianDate.FromGregorian(form.Date).Year)
            selectedYearId = years.FirstOrDefault(y => y.Year == PersianDate.FromGregorian(form.Date).Year)?.Id ?? 0;
        await RefreshNumberAsync();
    }

    /// <summary>با تغییر نوع صورتحساب، الگوهای مجاز عوض می‌شوند؛ الگوی نامعتبر بازنشانی می‌شود.</summary>
    private void OnInvoiceTypeChanged()
    {
        if (!PatternOptions.Contains(form.InvoicePattern))
            form.InvoicePattern = PatternOptions.FirstOrDefault();
        StateHasChanged();
    }

    private void ApplyCustomer()
    {
        var customer = customers.FirstOrDefault(c => c.Id == selectedCustomerId);
        if (customer is null) return;
        form.CustomerId = customer.Id;
        form.BuyerTaxId = customer.NationalId ?? customer.EconomicNumber;
        form.BuyerName = customer.Name;
        form.BuyerAddress = customer.Address;
        form.BuyerPostalCode = customer.PostalCode;
        form.BuyerPhone = customer.Phone;
    }

    private void ApplyGoods(int index)
    {
        var line = lines[index];
        var item = goods.FirstOrDefault(g => g.Id == line.GoodsOrServiceId);
        if (item is null) return;

        line.Request.SstTitle = item.Name ?? "";
        line.Request.SstId = item.UniqueIdentifier ?? "";
        line.Request.UnitPrice = item.Price;
        line.Request.VatRate = item.ValueAddedPercentage;

        var unit = units.FirstOrDefault(u => u.Code == item.UnitOfMeasurement);
        if (unit is not null) line.Request.UnitCode = unit.Code;
        else if (!string.IsNullOrWhiteSpace(item.UnitName))
        {
            var byName = units.FirstOrDefault(u => u.Name == item.UnitName);
            line.Request.UnitCode = byName?.Code ?? item.UnitOfMeasurement;
        }
        Recalc();
    }

    private void AddLine()
    {
        var line = new LineForm();
        var firstUnit = units.FirstOrDefault();
        if (firstUnit is not null) line.Request.UnitCode = firstUnit.Code;
        lines.Add(line);
    }

    private void RemoveLine(int index)
    {
        if (lines.Count <= 1) return;
        lines.RemoveAt(index);
    }

    private void RemoveLastLine()
    {
        if (lines.Count <= 1) return;
        lines.RemoveAt(lines.Count - 1);
    }

    private void Recalc() => StateHasChanged();

    private async Task Save()
    {
        if (!CanSave)
        {
            Toast.Error(numberWarning ?? "اطلاعات صورتحساب کامل نیست.");
            return;
        }

        var payload = new MoadianStandaloneInvoiceRequest
        {
            FiscalYearId = selectedYearId,
            Date = form.Date,
            Subject = form.Subject,
            InvoiceType = form.InvoiceType,
            InvoicePattern = form.InvoicePattern,
            ReferenceTaxId = string.IsNullOrWhiteSpace(form.ReferenceTaxId) ? null : form.ReferenceTaxId.Trim(),
            CustomerId = selectedCustomerId > 0 ? selectedCustomerId : null,
            BuyerTaxId = form.BuyerTaxId,
            BuyerName = form.BuyerName,
            BuyerAddress = form.BuyerAddress,
            BuyerPostalCode = form.BuyerPostalCode,
            BuyerPhone = form.BuyerPhone,
            PayType = form.PayType,
            Description = form.Description,
            Lines = lines.Where(l => l.Request.Quantity > 0).Select(l => new MoadianStandaloneLineRequest
            {
                GoodsOrServiceId = l.GoodsOrServiceId,
                SstId = l.Request.SstId ?? "",
                SstTitle = l.Request.SstTitle ?? "",
                UnitCode = l.Request.UnitCode,
                Quantity = l.Request.Quantity,
                UnitPrice = l.Request.UnitPrice,
                Discount = l.Request.Discount,
                VatRate = l.Request.VatRate
            }).ToList()
        };

        saving = true;
        try
        {
            savedInvoice = await StandaloneSvc.CreateInvoiceAsync(payload);
            Toast.Success($"صورتحساب {savedInvoice.DocumentNumber} ثبت شد.");
            years = await StandaloneSvc.GetFiscalYearsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task StartNewForm()
    {
        savedInvoice = null;
        ResetForm();
        await RefreshNumberAsync();
    }

    private void ResetForm()
    {
        form = NewRequest();
        lines = new();
        selectedCustomerId = 0;
        AddLine();
    }

    private static string CustomerLabel(MoadianCustomerProfileDto c)
        => string.IsNullOrWhiteSpace(c.ProviderName) ? (c.Name ?? "—") : $"{c.Name} — {c.ProviderName}";

    private static string GoodsLabel(MoadianGoodsOrServiceProfileDto g)
        => string.IsNullOrWhiteSpace(g.UnitName) ? (g.Name ?? "—") : $"{g.Name} ({g.UnitName})";

    /// <summary>
    /// بج وضعیت به‌صورت RenderFragment ساخته می‌شود (نه رشتهٔ HTML) تا مرورگر تگ‌ها را به‌صورت متن نشان ندهد.
    /// صورتحساب تازه‌ثبت‌شده «ارسال نشده» است؛ ارسال به سامانه در این نسخه انجام نمی‌شود.
    /// </summary>
    private static RenderFragment StatusBadge(MoadianInvoiceStatus status) => builder =>
    {
        var (css, text) = StatusInfo(status);
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {css}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };

    private static (string Css, string Text) StatusInfo(MoadianInvoiceStatus status) => status switch
    {
        MoadianInvoiceStatus.Draft => ("bg-warning text-dark", "ارسال نشده"),
        MoadianInvoiceStatus.Queued => ("bg-info text-dark", "در صف ارسال"),
        MoadianInvoiceStatus.Sending => ("bg-info text-dark", "در حال ارسال"),
        MoadianInvoiceStatus.Sent => ("bg-success", "ارسال‌شده"),
        MoadianInvoiceStatus.Failed => ("bg-danger", "ناموفق"),
        MoadianInvoiceStatus.Returned => ("bg-danger", "برگشتی"),
        MoadianInvoiceStatus.Voided => ("bg-dark", "ابطال‌شده"),
        _ => ("bg-secondary", "—")
    };

    private static decimal Round(decimal value) => Math.Round(value, 2, MidpointRounding.AwayFromZero);

    /// <summary>سطر فرم: درخواست قلم + محاسبات نمایشی.</summary>
    private sealed class LineForm
    {
        public int GoodsOrServiceId { get; set; }
        public MoadianStandaloneLineRequest Request { get; } = new() { Quantity = 1 };

        public decimal Gross => Round(Request.Quantity * Request.UnitPrice);
        public decimal AfterDiscount => Math.Max(0, Gross - Request.Discount);
        public decimal VatAmount => Round(AfterDiscount * Request.VatRate / 100m);
        public decimal Total => Round(AfterDiscount + VatAmount);
    }
}
