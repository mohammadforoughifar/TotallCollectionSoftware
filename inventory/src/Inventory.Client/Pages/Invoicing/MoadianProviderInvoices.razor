@page "/moadian/provider-invoices"
@using Microsoft.AspNetCore.Components
@inject IMoadianProviderInvoicesClientService ProviderInvoicesSvc
@inject IMoadianMasterDataClientService MasterDataSvc
@inject IMoadianClientService MoadianSvc
@inject IFiscalPrinterClientService PrinterSvc
@inject ICompanyProfileService CompanySvc
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>صورتحساب‌های خدمات‌دهنده (مودیان)</PageTitle>

<div class="page-head">
    <div>
        <h1>صورتحساب‌های مودیان — به تفکیک خدمات‌دهنده</h1>
    </div>
    <div class="ms-auto">
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/invoice-new")'>
            <i class="bi bi-plus-lg"></i> ثبت صورتحساب جدید
        </button>
    </div>
</div>

<!-- انتخاب خدمات‌دهنده + فیلترها -->
<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-auto" style="min-width:220px">
                <select class="form-select form-select-sm fw-bold" @bind="providerId" @bind:after="OnProviderChanged" disabled="@providersLoading">
                    <option value="0">@(providersLoading ? "در حال بارگذاری..." : "— خدمات‌دهنده را انتخاب کنید —")</option>
                    @foreach (var p in providers)
                    {
                        <option value="@p.Id">@ProviderTitle(p)</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select class="form-select form-select-sm" @bind="filterPeriod" @bind:after="OnFilterChanged">
                    <option value="">همه دوره‌ها</option>
                    @foreach (var p in periods)
                    {
                        <option value="@p.Id">@p.Title@(p.IsClosed ? " (بسته)" : "")</option>
                    }
                </select>
            </div>
            <div class="col-auto">
                <select class="form-select form-select-sm" @bind="filterStatus" @bind:after="OnFilterChanged">
                    <option value="">همه وضعیت‌ها</option>
                    @foreach (var s in StatusOptions)
                    {
                        <option value="@s.Key">@s.Value</option>
                    }
                </select>
            </div>
            <div class="col-auto" style="min-width:220px">
                <input class="form-control form-control-sm" placeholder="جستجو (شماره/مشتری/taxid)..." @bind="filterSearch" @bind:event="oninput" @bind:after="OnSearchChanged" />
            </div>
            <div class="col-auto">
                <button class="btn btn-sm btn-light" title="تازه‌سازی" @onclick="Load">
                    <i class="bi bi-arrow-clockwise"></i>
                </button>
            </div>
            <div class="col-auto ms-auto small text-muted">
                @(invoices.Count) صورتحساب — مجموع: @invoices.Sum(x => x.TotalNet).Money()
            </div>
        </div>
    </div>
</div>

@if (providers.Count == 0 && !providersLoading)
{
    <div class="alert alert-warning py-2 small">
        هنوز خدمات‌دهنده‌ای در «اطلاعات پایه مودیان» تعریف نشده است.
        <a href="moadian/master-data">ایجاد خدمات‌دهنده</a>
    </div>
}
else if (providerId is > 0 && !loading)
{
    <!-- جدول صورتحساب‌ها -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle text-center mb-0">
                    <thead>
                        <tr>
                            <th style="width:36px">ردیف</th>
                            <th>موضوع</th>
                            <th>شمارهٔ صورتحساب</th>
                            <th>تاریخ صدور</th>
                            <th>نام مشتری</th>
                            <th class="text-center">مجموع صورتحساب</th>
                            <th>نوع پرداخت</th>
                            <th>الگوی صورتحساب</th>
                            <th>وضعیت</th>
                            <th>عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (invoices.Count == 0)
                        {
                            <tr><td colspan="10" class="text-center text-muted py-4">
                                برای این خدمات‌دهنده صورتحسابی یافت نشد — از «ثبت صورتحساب جدید» شروع کنید.
                            </td></tr>
                        }
                        @for (var idx = 0; idx < invoices.Count; idx++)
                        {
                            var inv = invoices[idx];
                            <tr class='@(inv.Status is MoadianInvoiceStatus.Failed or MoadianInvoiceStatus.BuyerRejected or MoadianInvoiceStatus.Returned ? "table-danger" : "")'>
                                <td class="num text-muted">@(idx + 1)</td>
                                <td>
                                    <div class="fw-bold">@(SubjectFa(inv.InvoiceSubject))</div>
                                    <div class="small text-muted">inty: @InvoiceTypeFa(inv.InvoiceType)</div>
                                </td>
                                <td class="num fw-bold" dir="ltr">
                                    @(string.IsNullOrWhiteSpace(inv.DocumentNumber) ? inv.Number.ToString() : inv.DocumentNumber)
                                    @if (inv.YearSerial > 0)
                                    {
                                        <div class="small text-muted num">سریال @Fa.Digits(inv.Number)</div>
                                    }
                                </td>
                                <td class="num">
                                    @FaDate(inv.Date)
                                    <div class="small text-muted">@Fa.Digits(inv.Date.ToString("HH:mm"))</div>
                                </td>
                                <td class="text-start">
                                    <div>@(inv.BuyerName ?? "—")</div>
                                    @if (!string.IsNullOrWhiteSpace(inv.BuyerTaxId))
                                    {
                                        <div class="small text-muted num" dir="ltr">@inv.BuyerTaxId</div>
                                    }
                                </td>
                                <td class="text-center num fw-bold">@inv.TotalNet.Money()</td>
                                <td>@(inv.PayTypeTitle ?? "—")</td>
                                <td>
                                    @PatternFa(inv.InvoicePattern)
                                </td>
                                <td>
                                    @StatusBadge(inv.Status)
                                    @if (!string.IsNullOrWhiteSpace(inv.LastInquiryStatus))
                                    {
                                        <div class="small text-muted num" dir="ltr" title="وضعیت خام سامانه در آخرین استعلام">
                                            @(inv.LastInquiryAt is DateTime t ? FaDate(t) + " — " : "")@inv.LastInquiryStatus
                                        </div>
                                    }
                                </td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-outline-info" title="جزئیات کامل صورتحساب" @onclick="() => OpenDetails(inv)">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-dark" title="پیش‌نمایش/چاپ برگه حرارتی (رسید)" @onclick="() => ShowPrint(inv)">
                                        <i class="bi bi-receipt"></i>
                                    </button>
                                    <button class="btn btn-sm btn-outline-primary" title="چاپ صورتحساب الکترونیکی (A4)" @onclick="() => ShowPaperPrint(inv)">
                                        <i class="bi bi-printer"></i>
                                    </button>
                                    @if (inv.Status == MoadianInvoiceStatus.Draft)
                                    {
                                        <button class="btn btn-sm btn-outline-primary" title="بازبینی و ویرایش صورتحساب ارسال‌نشده" @onclick="() => EditDraft(inv)">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" title="حذف صورتحساب ارسال‌نشده" @onclick="() => DeleteInvoice(inv)">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                    @if (CanSend(inv))
                                    {
                                        <button class="btn btn-sm btn-outline-success" title="ارسال رسمی به سامانه مودیان"
                                                disabled="@IsBusy(inv.Id)" @onclick="() => SendInvoice(inv)">
                                            <i class="bi @SendIcon(inv)"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-success" disabled title="@SendBlockedReason(inv)">
                                            <i class="bi bi-send"></i>
                                        </button>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(inv.ReferenceId))
                                    {
                                        <button class="btn btn-sm btn-outline-warning" title="استعلام رسمی وضعیت از سامانه مودیان"
                                                disabled="@IsBusy(inv.Id)" @onclick="() => InquiryInvoice(inv)">
                                            <i class="bi @InquiryIcon(inv)"></i>
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-warning" disabled title="برای استعلام، ابتدا باید به سامانه ارسال شود.">
                                            <i class="bi bi-arrow-repeat"></i>
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

@if (loading)
{
    <div class="text-center py-5 text-muted"><div class="spinner-border me-2" role="status"></div>در حال بارگذاری...</div>
}

<!-- ===================== مودال جزئیات ===================== -->
<Modal Visible="showDetails" Title="@(detailsTitle)" Size="modal-xl" OnClose="CloseDetails">
    <ChildContent>
        @if (detailsInvoice is not null)
        {
            var d = detailsInvoice;
            <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">
                @StatusBadge(d.Status)
                <span class="small text-muted">شمارهٔ سند: <b class="num" dir="ltr">@(d.DocumentNumber ?? "—")</b></span>
                <span class="small text-muted">سریال داخلی: <b class="num">@Fa.Digits(d.Number)</b></span>
                @if (!string.IsNullOrWhiteSpace(d.TaxId22))
                {
                    <span class="badge bg-secondary num" dir="ltr" title="شماره منحصر به فرد مالیاتی">taxid: @d.TaxId22</span>
                }
                @if (!string.IsNullOrWhiteSpace(d.ReferenceId))
                {
                    <span class="badge bg-light text-dark border num" dir="ltr" title="شماره مرجع (inno)">ref: @d.ReferenceId</span>
                }
                @if (!string.IsNullOrWhiteSpace(d.TrackingId))
                {
                    <span class="badge bg-light text-dark border num" dir="ltr" title="UID سامانه">uid: @d.TrackingId</span>
                }
            </div>

            @if (d.InquiryErrors.Count > 0)
            {
                <div class="alert @(d.InquirySuccess == true ? "alert-warning" : "alert-danger") py-2 small">
                    <strong><i class="bi bi-exclamation-triangle-fill"></i> خطاها و پیام‌های سامانه در آخرین استعلام</strong>
                    @if (d.LastInquiryAt is DateTime inqAt)
                    {
                        <span class="text-muted ms-2">@(FaDateTime(inqAt)) — وضعیت: @(d.LastInquiryStatus ?? "—")</span>
                    }
                    <ul class="mb-0 mt-1 ps-3">
                        @foreach (var er in d.InquiryErrors)
                        {
                            <li>
                                @if (!string.IsNullOrWhiteSpace(er.Code))
                                {
                                    <code class="num" dir="ltr">@er.Code</code>
                                }
                                @(string.IsNullOrWhiteSpace(er.Message) ? "— (پیامی از سامانه دریافت نشد)" : er.Message)
                            </li>
                        }
                    </ul>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(d.ErrorMessage) || !string.IsNullOrWhiteSpace(d.ErrorCode))
            {
                <div class="alert alert-danger py-2 small">
                    <strong><i class="bi bi-exclamation-triangle-fill"></i> خطای ثبت‌شده — کد: @(d.ErrorCode ?? "—")</strong>
                    <div class="mt-1" style="white-space:pre-wrap">@(d.ErrorMessage ?? "")</div>
                </div>
            }

            @if (!string.IsNullOrWhiteSpace(d.LastSendPayload))
            {
                <div class="mb-2">
                    <button class="btn btn-sm btn-outline-secondary" @onclick="() => ShowPayload(d)">
                        <i class="bi bi-file-code"></i> JSON ارسال‌شده به سامانه (مقادیر دقیق آخرین ثبت)
                    </button>
                </div>
            }

            <div class="row g-2 mb-3 small">
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">موضوع (ins)</span>@SubjectFa(d.InvoiceSubject) <span class="num">@((int)d.InvoiceSubject)</span></div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">نوع (inty)</span>@InvoiceTypeFa(d.InvoiceType)</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">الگو (inp)</span>@PatternFa(d.InvoicePattern)</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">نوع پرداخت (setm)</span>@(d.PayTypeTitle ?? "—")</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">تاریخ صدور</span>@FaDateTime(d.Date)</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">دوره مالی</span>@(d.FiscalPeriodTitle ?? "—")</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">فروشنده</span>@d.SellerName</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">مشتری</span>@(d.BuyerName ?? "—")<div class="num text-muted" dir="ltr">@(d.BuyerTaxId ?? "")</div></div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">جمع پیش از تخفیف</span>@d.TotalGross.Money()</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">تخفیف</span>@d.TotalDiscount.Money()</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">مالیات</span>@d.TotalVat.Money()</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">مجموع صورتحساب</span><b>@d.TotalNet.Money()</b></div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">تلاش ارسال</span>@Fa.Digits(d.Attempts) @(d.SendAt is DateTime s ? "— آخرین: " + FaDateTime(s) : "")</div></div>
                <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">آخرین استعلام رسمی</span>@(d.LastInquiryAt is DateTime t ? FaDateTime(t) + " — " : "—")@(d.LastInquiryStatus ?? "")</div></div>
                @if (!string.IsNullOrWhiteSpace(d.ReferenceTaxId))
                {
                    <div class="col-md-3"><div class="border rounded p-2 h-100"><span class="text-muted d-block">مرجع (Irtaxid)</span><span class="num" dir="ltr">@d.ReferenceTaxId</span></div></div>
                }
            </div>

            <h6 class="mb-2">اقلام</h6>
            <div class="table-responsive mb-3">
                <table class="table table-sm table-bordered align-middle small">
                    <thead>
                        <tr><th style="width:40px">ردیف</th><th>شرح</th><th>شناسه کالا/خدمت</th><th>واحد</th><th class="text-center">تعداد</th><th class="text-center">فی</th><th class="text-center">تخفیف</th><th class="text-center">٪ مالیات</th><th class="text-center">مالیات</th><th class="text-center">جمع</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var l in d.Lines)
                        {
                            <tr>
                                <td class="num">@Fa.Digits(l.RowNo)</td>
                                <td class="text-start">@l.SstTitle</td>
                                <td class="num" dir="ltr">@(l.SstId ?? "—")</td>
                                <td>@(l.UnitCode ?? "—")</td>
                                <td class="text-center num">@l.Quantity.Num()</td>
                                <td class="text-center num">@l.UnitPrice.Money()</td>
                                <td class="text-center num">@l.Discount.Money()</td>
                                <td class="text-center num">@l.VatRate.Num()</td>
                                <td class="text-center num">@l.VatAmount.Money()</td>
                                <td class="text-center num">@l.Total.Money()</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <h6 class="mb-2">رویدادها و سوابق</h6>
            @if (detailsLogsLoading)
            {
                <div class="text-muted small py-3">در حال دریافت سوابق...</div>
            }
            else if (detailsLogs.Count == 0)
            {
                <div class="text-muted small py-2">برای این صورتحساب رویدادی ثبت نشده است.</div>
            }
            else
            {
                <div class="list-group list-group-flush border rounded" style="max-height:280px;overflow:auto">
                    @foreach (var log in detailsLogs)
                    {
                        <div class="list-group-item py-2">
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                <span class="badge bg-secondary">@LogActionFa(log.Action)</span>
                                <span class="small text-muted">@FaDateTime(log.CreatedAt)</span>
                            </div>
                            <div class="mt-1 small">@log.Message</div>
                            @if (!string.IsNullOrWhiteSpace(log.Detail))
                            {
                                <pre class="bg-light border rounded p-2 mt-2 mb-0 small" style="white-space:pre-wrap;overflow-wrap:anywhere" dir="ltr">@log.Detail</pre>
                            }
                        </div>
                    }
                </div>
            }
        }
    </ChildContent>
    <Footer>
        @if (detailsInvoice is { } di)
        {
            @if (!string.IsNullOrWhiteSpace(di.ReferenceId))
            {
                <button class="btn btn-outline-warning" disabled="@IsBusy(di.Id)" @onclick="() => InquiryInvoice(di)">
                    <i class="bi bi-arrow-repeat"></i> استعلام از سامانه
                </button>
            }
            @if (CanSend(di))
            {
                <button class="btn btn-success" disabled="@IsBusy(di.Id)" @onclick="() => SendInvoice(di)">
                    <i class="bi bi-send"></i> ارسال به سامانه
                </button>
            }
            <button class="btn btn-primary" @onclick="() => ShowPaperPrint(di)">
                <i class="bi bi-printer"></i> چاپ صورتحساب (A4)
            </button>
        }
        <button class="btn btn-light" @onclick="CloseDetails">بستن</button>
    </Footer>
</Modal>

<!-- ===================== مودال ویرایش صورتحساب ارسال‌نشده ===================== -->
<Modal Visible="showForm" Title="ویرایش صورتحساب ارسال‌نشده" Size="modal-xl" OnClose="CloseForm">
    <ChildContent>
    <div class="row g-2 mb-2">
        <div class="col-md-2">
            <label class="form-label small">جهت سند داخلی</label>
            <select class="form-select form-select-sm" @bind="New.Kind">
                @foreach (var k in KindOptions) { <option value="@k.Key">@k.Value</option> }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">نوع صورتحساب <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" @bind="New.InvoiceType">
                <option value="Unselected">— انتخاب —</option>
                <option value="Type1">نوع ۱</option>
                <option value="Type2">نوع ۲</option>
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">الگوی صورتحساب <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" @bind="New.InvoicePattern">
                <option value="Unselected">— ابتدا نوع را انتخاب کنید —</option>
                @if (New.InvoicePattern != MoadianInvoicePattern.Unselected && !MoadianInvoiceRules.IsPatternAllowed(New.InvoiceType, New.InvoicePattern))
                {
                    <option value="@New.InvoicePattern">@MoadianInvoiceRules.PatternTitle(New.InvoicePattern) (@((int)New.InvoicePattern)) — ناسازگار</option>
                }
                @foreach (var pattern in MoadianInvoiceRules.AvailablePatterns(New.InvoiceType))
                {
                    <option value="@pattern">@((int)pattern) — @MoadianInvoiceRules.PatternTitle(pattern)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">موضوع صورتحساب <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" @bind="New.InvoiceSubject">
                <option value="Unselected">— انتخاب —</option>
                @if (New.InvoiceSubject != MoadianInvoiceSubject.Unselected && !MoadianInvoiceRules.IsSubjectAllowed(New.InvoicePattern, New.InvoiceSubject))
                {
                    <option value="@New.InvoiceSubject">@MoadianInvoiceRules.SubjectTitle(New.InvoiceSubject) (@((int)New.InvoiceSubject)) — ناسازگار</option>
                }
                @foreach (var subject in MoadianInvoiceRules.AvailableSubjects(New.InvoicePattern))
                {
                    <option value="@subject">@((int)subject) — @MoadianInvoiceRules.SubjectTitle(subject)</option>
                }
            </select>
        </div>
        <div class="col-md-2">
            <label class="form-label small">تاریخ صدور</label>
            <DatePicker Value="@((DateTime?)New.Date)" ValueChanged="OnNewInvoiceDateChanged" MinYear="1390" MaxYear="1430" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">زمان صدور (indatim)</label>
            <TimeInput Value="@NewIssueTime" ValueChanged="OnNewIssueTimeChanged" Suffix="زمان محلی صورتحساب" />
        </div>
    </div>
    <div class="row g-2 mb-2">
        <div class="col-md-3">
            <label class="form-label small">دوره مالیاتی</label>
            <select class="form-select form-select-sm" @bind="New.FiscalPeriodId">
                <option value="0">— انتخاب کنید —</option>
                @foreach (var p in periods)
                {
                    <option value="@p.Id">@p.Title@(p.IsClosed ? " (بسته!)" : "")</option>
                }
            </select>
        </div>
        <div class="col-md-3">
            <label class="form-label small">روش تسویه</label>
            <input class="form-control form-control-sm" @bind="New.Settlement" placeholder="نقدی/نسیه..." />
        </div>
        <div class="col-md-3">
            <label class="form-label small">توضیح</label>
            <input class="form-control form-control-sm" @bind="New.Description" />
        </div>
        <div class="col-md-3">
            @if (MoadianInvoiceRules.RequiresReference(New.InvoiceSubject) || !string.IsNullOrWhiteSpace(New.ReferenceTaxId))
            {
                <label class="form-label small">شناسه صورتحساب مرجع <span class="text-danger">@(MoadianInvoiceRules.RequiresReference(New.InvoiceSubject) ? "*" : "")</span></label>
                <input class="form-control form-control-sm" dir="ltr" maxlength="22" @bind="New.ReferenceTaxId" placeholder="۲۲ نویسه" />
            }
            else
            {
            }
        </div>
    </div>
    <hr class="my-2" />
    <div class="row g-2 mb-2">
        <div class="col-md-3">
            <label class="form-label small">شناسهٔ ملی/اقتصادی خریدار</label>
            <input class="form-control form-control-sm" dir="ltr" maxlength="50" @bind="New.BuyerTaxId" placeholder="حقیقی: ۱۰ رقم | حقوقی: ۱۱ رقم" />
            <div class="small text-muted mt-1">حقیقی: شمارهٔ ملی ۱۰ رقمی — حقوقی: شناسهٔ ملی ۱۱ رقمی (کد اقتصادی ۱۴ رقمی دیگر پذیرفته نمی‌شود)</div>
        </div>
        <div class="col-md-3">
            <label class="form-label small">نام خریدار</label>
            <input class="form-control form-control-sm" @bind="New.BuyerName" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">کد پستی</label>
            <input class="form-control form-control-sm" dir="ltr" inputmode="numeric" maxlength="50" @bind="New.BuyerPostalCode" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">تلفن</label>
            <input class="form-control form-control-sm" maxlength="50" @bind="New.BuyerPhone" />
        </div>
        <div class="col-md-2">
            <label class="form-label small">آدرس</label>
            <input class="form-control form-control-sm" @bind="New.BuyerAddress" />
        </div>
    </div>

    <div class="d-flex align-items-center justify-content-between mb-2" dir="rtl">
        <b class="small">اقلام فاکتور:</b>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-primary" @onclick="AddLine"><i class="bi bi-plus-lg"></i> قلم</button>
            <button class="btn btn-sm btn-outline-danger" @onclick="RemoveLast"><i class="bi bi-dash-lg"></i> حذف آخر</button>
        </div>
    </div>
    <table class="table table-sm table-bordered align-middle">
        <thead>
            <tr><th style="width:17%">شناسه کالا/خدمت مالیاتی</th><th>شرح</th><th style="width:11%">انتخاب کد</th><th style="width:8%">واحد مالیاتی</th><th style="width:7%">تعداد</th><th style="width:11%">فی کالا (ریال)</th><th style="width:10%">تخفیف (ریال)</th><th style="width:6%">٪ مالیات</th><th style="width:10%">مالیات ارزش افزوده (ریال)</th><th class="text-center">جمع</th></tr>
        </thead>
        <tbody>
            @foreach (var l in New.Lines)
            {
                <tr>
                    <td><input class="form-control form-control-sm" dir="ltr" @bind="l.SstId" @bind:event="oninput" /></td>
                    <td><input class="form-control form-control-sm" @bind="l.SstTitle" /></td>
                    <td>
                        <select class="form-select form-select-sm" @onchange='@(e => ApplyCpc(l, e.Value?.ToString() ?? ""))'>
                            <option value="">— انتخاب از فهرست —</option>
                            @foreach (var c in cpcList)
                            {
                                <option value="@c.Code">@c.Code — @c.Title</option>
                            }
                        </select>
                    </td>
                    <td><input class="form-control form-control-sm" dir="ltr" @bind="l.UnitCode" /></td>
                    <td><input class="form-control form-control-sm num text-center" @bind="l.Quantity" @bind:event="oninput" @bind:after="() => RecalcLine(l)" /></td>
                    <td><MoneyInput Value="l.UnitPrice" ValueChanged="v => { l.UnitPrice = v; RecalcLine(l); }" Placeholder="0" /></td>
                    <td><MoneyInput Value="l.Discount" ValueChanged="v => { l.Discount = v; RecalcLine(l); }" Placeholder="0" /></td>
                    <td><input class="form-control form-control-sm num text-center" @bind="l.VatRate" @bind:event="oninput" @bind:after="() => RecalcLine(l)" /></td>
                    <td class="text-center num">@l.VatAmount.Money()</td>
                    <td class="text-center num">@l.Total.Money()</td>
                </tr>
            }
        </tbody>
        <tfoot>
            <tr class="fw-bold">
                <td colspan="4" class="text-center">جمع کل اقلام</td>
                <td class="text-center num">@New.Lines.Sum(x => x.Quantity).Num()</td>
                <td class="text-center num">@New.Lines.Sum(x => x.UnitPrice).Money()</td>
                <td class="text-center num">@New.Lines.Sum(x => x.Discount).Money()</td>
                <td class="text-center text-muted">—</td>
                <td class="text-center num">@New.Lines.Sum(x => x.VatAmount).Money()</td>
                <td class="text-center num text-primary">@New.Lines.Sum(x => x.Taxable + x.VatAmount).Money()</td>
            </tr>
        </tfoot>
    </table>
    </ChildContent>
    <Footer>
        <button class="btn btn-primary" @onclick="SaveEdited" disabled="@saving">@(saving ? "در حال ذخیره..." : "ذخیره تغییرات")</button>
        <button class="btn btn-light" @onclick="CloseForm">انصراف</button>
    </Footer>
</Modal>

<!-- ===================== مودال چاپ ===================== -->
<Modal Visible="showPrint" Title="پیش‌نمایش برگه" Size="modal-lg" OnClose="ClosePrint">
    <ChildContent>
        @if (printResult is not null)
        {
            <div class="row g-3">
                <div class="col-md-7">
                    <iframe @ref="printFrame" class="w-100 border rounded" style="height:430px;background:#fff"></iframe>
                    <div class="small text-muted mt-1">@printResult.Message</div>
                </div>
                <div class="col-md-5">
                    <div class="mt-3">
                        <button class="btn btn-success w-100" @onclick="DoPrint" disabled="@printing">
                            <i class="bi bi-printer"></i> @(printing ? "در حال چاپ..." : "چاپ روی چاپگر")
                        </button>
                        <button class="btn btn-outline-secondary w-100 mt-2" @onclick="BrowserPrint">چاپ در مرورگر</button>
                        <button class="btn btn-outline-primary w-100 mt-2" @onclick="CopyTicket">کپی متن رسید</button>
                    </div>
                    <pre class="bg-light border rounded p-2 mt-3 small" style="max-height:220px;overflow:auto">@printResult.TicketText</pre>
                </div>
            </div>
        }
    </ChildContent>
</Modal>

<!-- ===================== مودال چاپ صورتحساب (A4 مطابق نمونه) ===================== -->
<Modal Visible="showPaperPrint" Title="چاپ صورتحساب الکترونیکی" Size="modal-lg" OnClose="ClosePaperPrint">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <iframe @ref="paperPrintFrame" class="w-100 border rounded" style="height:480px;background:#fff"></iframe>
            </div>
            <div class="col-md-4">
                <div class="mt-3">
                    <button class="btn btn-primary w-100" @onclick="PrintPaper">
                        <i class="bi bi-printer"></i> چاپ (افزودن به چاپگر)
                    </button>
                    <div class="small text-muted mt-3">
                        با زدن «چاپ»، دیالوگ چاپ مرورگر باز می‌شود و از آن‌جا چاپگر را انتخاب و تایپ کنید.
                        همان‌طور که می‌بینید، دقیقاً همین برگهٔ A4 به چاپگر فرستاده می‌شود.
                        اقلام بیش از ۱۸ ردیف در صفحات بعدی چاپ می‌شوند.
                    </div>
                </div>
            </div>
        </div>
    </ChildContent>
</Modal>

<!-- ===================== مودال JSON ارسال‌شده به سامانه ===================== -->
<Modal Visible="showPayload" Title="JSON ارسال‌شده به سامانه — آخرین تلاش ثبت" Size="modal-lg" OnClose="() => showPayload = false">
    <ChildContent>
        <div class="small text-muted mb-2">
            این همان دقیق‌ترین payload است که در آخرین تلاش ثبت به سامانهٔ مودیان فرستاده شد.
            اگر سامانه خطای فیلدی می‌دهد (مثل setm / pmt / bid / tinb)، مقدار همان فیلد را از اینجا چک کنید.
        </div>
        <pre dir="ltr" style="max-height:55vh;overflow:auto;background:#f6f8fa;padding:.75rem;border-radius:.375rem;font-size:.72rem;line-height:1.35;white-space:pre-wrap;word-break:break-all">@payloadText</pre>
        <div class="mt-2 text-end">
            <button class="btn btn-sm btn-outline-primary" @onclick="CopyPayload"><i class="bi bi-clipboard"></i> کپی JSON</button>
        </div>
    </ChildContent>
</Modal>

<!-- ریشهٔ چاپ: هنگام window.print() فقط همین بخش چاپ می‌شود (مستقیم به چاپگر) -->
<div id="moadian-print-root" @ref="paperPrintRoot" style="display:none"></div>
<style>
    @@media print {
        body * { visibility: hidden !important; }
        #moadian-print-root, #moadian-print-root * { visibility: visible !important; }
        #moadian-print-root { display: block !important; position: absolute !important; left: 0; top: 0; width: 100%; }
    }
</style>

@code {
    [Parameter, SupplyParameterFromQuery(Name = "invoice")]
    public int? OpenInvoiceId { get; set; }
    private int? lastOpenedInvoiceId;

    private List<MoadianInvoice> invoices = new();
    private List<MoadianServiceProviderProfileDto> providers = new();
    private List<MoadianFiscalPeriod> periods = new();
    private List<MoadianCpc> cpcList = new();
    private int providerId;
    private bool providersLoading, loading;
    private int? filterPeriod;
    private string filterStatus = "";
    private string filterSearch = "";
    private CancellationTokenSource? searchDebounce;
    private (int id, string kind)? busy;

    private bool showDetails, showPrint, showForm, printing, saving;
    private MoadianInvoiceRequest New = new();
    private TimeOnly NewIssueTime => TimeOnly.FromDateTime(New.Date == default ? DateTime.Now : New.Date);
    private static readonly Dictionary<MoadianInvoiceKind, string> KindOptions = new()
    {
        [MoadianInvoiceKind.Sale] = "فروش",
        [MoadianInvoiceKind.SaleReturn] = "فروش برگشتی",
        [MoadianInvoiceKind.Purchase] = "خرید",
        [MoadianInvoiceKind.PurchaseReturn] = "خرید برگشتی",
        [MoadianInvoiceKind.Proforma] = "پیش‌فاکتور"
    };
    private MoadianInvoice? detailsInvoice;
    private List<MoadianLog> detailsLogs = new();
    private bool detailsLogsLoading;
    private FiscalPrintResult? printResult;
    private ElementReference printFrame;
    private int printInvoiceId;

    private bool showPaperPrint;
    private ElementReference paperPrintFrame;
    private ElementReference paperPrintRoot;
    private string? paperPrintHtml;

    private bool showPayload;
    private string? payloadText;

    private string detailsTitle => detailsInvoice is null
        ? "جزئیات صورتحساب"
        : $"جزئیات صورتحساب {detailsInvoice.DocumentNumber ?? Fa.Digits(detailsInvoice.Number)}";

    private static readonly Dictionary<MoadianInvoiceStatus, string> StatusOptions = new()
    {
        [MoadianInvoiceStatus.Draft] = "ارسال نشده",
        [MoadianInvoiceStatus.Queued] = "در صف",
        [MoadianInvoiceStatus.Sending] = "در حال ارسال",
        [MoadianInvoiceStatus.Sent] = "ارسال‌شده",
        [MoadianInvoiceStatus.Failed] = "ناموفق",
        [MoadianInvoiceStatus.Returned] = "برگشتی",
        [MoadianInvoiceStatus.AwaitingBuyerConfirmation] = "در انتظار خریدار",
        [MoadianInvoiceStatus.BuyerConfirmed] = "تأیید خریدار",
        [MoadianInvoiceStatus.BuyerRejected] = "رد خریدار",
        [MoadianInvoiceStatus.Voided] = "ابطال‌شده"
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadProviders();
        await LoadRefs();
    }

    protected override async Task OnParametersSetAsync()
    {
        // لینک عمیق از داشبورد مودیان (؟invoice=) — مودال جزئیات را می‌گشاید
        if (OpenInvoiceId is > 0 && OpenInvoiceId != lastOpenedInvoiceId)
        {
            lastOpenedInvoiceId = OpenInvoiceId;
            try
            {
                var inv = await MoadianSvc.GetInvoiceAsync(OpenInvoiceId.Value);
                await OpenDetails(inv);
            }
            catch (Exception ex) { Toast.Error(ex.Message); }
        }
    }

    private async Task LoadRefs()
    {
        try
        {
            periods = await MoadianSvc.GetPeriodsAsync();
            cpcList = await MoadianSvc.GetCpcAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task LoadProviders()
    {
        providersLoading = true;
        try
        {
            providers = (await MasterDataSvc.GetProvidersAsync()).Where(p => !p.IsDeleted).OrderBy(p => p.Id).ToList();
            if (providerId == 0 && providers.Count > 0)
            {
                providerId = providers[0].Id;
            }
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            providersLoading = false;
        }
        if (providerId is > 0)
        {
            await Load();
        }
    }

    private async Task Load()
    {
        if (providerId is not > 0) return;
        loading = true;
        try
        {
            MoadianInvoiceStatus? st = Enum.TryParse<MoadianInvoiceStatus>(filterStatus, out var parsed) ? parsed : null;
            invoices = await ProviderInvoicesSvc.GetByProviderAsync(providerId, filterPeriod, filterSearch, st);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task OnProviderChanged()
    {
        if (providerId is not > 0)
        {
            invoices = new List<MoadianInvoice>();
            return;
        }
        await Load();
    }

    private void OnFilterChanged() => _ = Load();

    private void OnSearchChanged()
    {
        searchDebounce?.Cancel();
        searchDebounce = new CancellationTokenSource();
        _ = DebouncedLoadAsync(searchDebounce.Token);
    }

    private async Task DebouncedLoadAsync(CancellationToken token)
    {
        try { await Task.Delay(300, token); }
        catch (TaskCanceledException) { return; }
        if (token.IsCancellationRequested) return;
        await Load();
    }

    // ---------- عملیات ردیفی ----------

    private bool IsBusy(int id) => busy?.id == id;
    private string SendIcon(MoadianInvoice inv) => IsBusy(inv.Id) && busy!.Value.kind == "send" ? "bi-hourglass-split" : "bi-send";
    private string InquiryIcon(MoadianInvoice inv) => IsBusy(inv.Id) && busy!.Value.kind == "inquiry" ? "bi-hourglass-split" : "bi-arrow-repeat";

    private static bool CanSend(MoadianInvoice inv)
        => inv.Status is MoadianInvoiceStatus.Draft
            or MoadianInvoiceStatus.Failed
            or MoadianInvoiceStatus.Returned
            or MoadianInvoiceStatus.Sending;

    private static string SendBlockedReason(MoadianInvoice inv) => inv.Status switch
    {
        MoadianInvoiceStatus.Sent or MoadianInvoiceStatus.AwaitingBuyerConfirmation => "قبلاً ارسال شده است؛ برای وضعیت فعلی «استعلام» را استفاده کنید.",
        MoadianInvoiceStatus.BuyerConfirmed => "تأییدشده توسط خریدار؛ ارسال مجدد مجاز نیست.",
        MoadianInvoiceStatus.BuyerRejected => "توسط خریدار رد شده؛ برای اصلاح، موضوع اصلاحی/برگشتی جدید ثبت کنید.",
        MoadianInvoiceStatus.Voided => "صورتحساب ابطال‌شده قابل ارسال نیست.",
        MoadianInvoiceStatus.Queued => "در صف ارسال است.",
        _ => "در این وضعیت قابل ارسال نیست."
    };

    private async Task SendInvoice(MoadianInvoice inv)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"صورتحساب {inv.DocumentNumber ?? Fa.Digits(inv.Number)} به‌صورت رسمی به سامانه مودیان ارسال شود؟\nاین عمل با کلید خصوصی اتصالِ خدمات‌دهنده امضا و به سامانه ثبت می‌شود.");
        if (!ok) return;
        await RunOperationAsync(inv.Id, "send", () => ProviderInvoicesSvc.SendAsync(inv.Id));
    }

    private async Task InquiryInvoice(MoadianInvoice inv)
        => await RunOperationAsync(inv.Id, "inquiry", () => ProviderInvoicesSvc.InquiryAsync(inv.Id));

    /// <summary>اجرای عملیات رسمی (ارسال/استعلام) با قفل دکمه تا پایان + به‌روزرسانی فهرست.</summary>
    private async Task RunOperationAsync(int invoiceId, string kind, Func<Task<MoadianSubmissionResultDto>> action)
    {
        if (busy is not null) return;
        busy = (invoiceId, kind);
        try
        {
            var result = await action();
            if (result.Success) Toast.Success(result.Message);
            else Toast.Info(result.Message);
            // تصویر تازهٔ صورتحساب در پاسخ عملیات هست؛ فهرست را با همان فیلترها تازه می‌کنیم.
            await Load();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            busy = null;
        }
    }

    // ---------- جزئیات ----------

    private async Task OpenDetails(MoadianInvoice inv)
    {
        detailsInvoice = inv;
        detailsLogs = new List<MoadianLog>();
        showDetails = true;
        detailsLogsLoading = true;
        try
        {
            var fresh = await MoadianSvc.GetInvoiceAsync(inv.Id);
            detailsInvoice = fresh;
            detailsLogs = (await MoadianSvc.GetLogsAsync(inv.Id))
                .OrderByDescending(x => x.CreatedAt).ThenByDescending(x => x.Id).ToList();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            detailsLogsLoading = false;
        }
    }

    private void CloseDetails()
    {
        showDetails = false;
        detailsInvoice = null;
        detailsLogs = new List<MoadianLog>();
    }

    // ---------- ویرایش/حذف پیش‌نویس ----------

    private void EditDraft(MoadianInvoice inv)
    {
        if (inv.Status != MoadianInvoiceStatus.Draft) return;
        New = new MoadianInvoiceRequest
        {
            Id = inv.Id,
            Kind = inv.Kind,
            InvoiceType = inv.InvoiceType,
            InvoicePattern = inv.InvoicePattern,
            InvoiceSubject = inv.InvoiceSubject,
            ReferenceTaxId = inv.ReferenceTaxId,
            Date = inv.Date,
            FiscalPeriodId = inv.FiscalPeriodId,
            BuyerTaxId = inv.BuyerTaxId,
            BuyerName = inv.BuyerName,
            BuyerAddress = inv.BuyerAddress,
            BuyerPostalCode = inv.BuyerPostalCode,
            BuyerPhone = inv.BuyerPhone,
            Settlement = inv.Settlement,
            Description = inv.Description,
            Lines = inv.Lines.Select(l => new MoadianInvoiceLine
            {
                RowNo = l.RowNo, SstId = l.SstId, UnitCode = l.UnitCode, SstTitle = l.SstTitle,
                Quantity = l.Quantity, UnitPrice = l.UnitPrice, Discount = l.Discount, VatRate = l.VatRate,
                VatAmount = l.VatAmount, Total = l.Total
            }).ToList()
        };
        if (New.Lines.Count == 0) New.Lines.Add(NewLine());
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task SaveEdited()
    {
        if (New.Id <= 0) return; // در این صفحه فقط ویرایش انجام می‌شود
        if (New.FiscalPeriodId == 0) { Toast.Error("دوره مالیاتی را انتخاب کنید."); return; }
        var issueDateError = MoadianInvoiceRules.ValidateIssueDate(New.Date);
        if (issueDateError is not null) { Toast.Error(issueDateError); return; }
        if (New.InvoiceType is not (MoadianTaxInvoiceType.Type1 or MoadianTaxInvoiceType.Type2))
        {
            Toast.Error("نوع صورتحساب را انتخاب کنید.");
            return;
        }
        var selectionError = MoadianInvoiceRules.ValidateSelection(New.InvoiceType, New.InvoicePattern, New.InvoiceSubject, New.ReferenceTaxId);
        if (selectionError is not null) { Toast.Error(selectionError); return; }
        if (New.Lines.Count == 0 || New.Lines.All(x => x.Quantity <= 0)) { Toast.Error("حداقل یک قلم معتبر لازم است."); return; }
        saving = true;
        try
        {
            RecalcAll();
            var inv = await MoadianSvc.UpdateDraftAsync(New.Id, New);
            Toast.Success($"صورتحساب {Fa.Digits(inv.Number)} ذخیره شد (ارسال‌نشده).");
            showForm = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteInvoice(MoadianInvoice inv)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"صورتحساب {inv.DocumentNumber ?? Fa.Digits(inv.Number)} برای همیشه حذف شود؟ فقط صورتحساب‌های ارسال‌نشده قابل حذف‌اند.");
        if (!ok) return;
        try
        {
            await MoadianSvc.DeleteInvoiceAsync(inv.Id);
            Toast.Success("حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static MoadianInvoiceLine NewLine() => new()
    {
        RowNo = 1, SstId = "", UnitCode = "", SstTitle = "", Quantity = 1, VatRate = 0
    };

    private void AddLine()
    {
        var l = NewLine();
        l.RowNo = New.Lines.Count + 1;
        New.Lines.Add(l);
    }

    private void RemoveLast()
    {
        if (New.Lines.Count > 1) New.Lines.RemoveAt(New.Lines.Count - 1);
    }

    private void RecalcLine(MoadianInvoiceLine l)
    {
        l.VatAmount = Math.Round(l.Taxable * l.VatRate / 100m, 2, MidpointRounding.AwayFromZero);
        l.Total = l.Taxable + l.VatAmount;
    }

    private void RecalcAll()
    {
        foreach (var l in New.Lines) RecalcLine(l);
    }

    private void ApplyCpc(MoadianInvoiceLine l, string code)
    {
        var cpc = cpcList.FirstOrDefault(c => c.Code == code);
        if (cpc is null) return;
        l.SstId = cpc.Code;
        if (string.IsNullOrWhiteSpace(l.UnitCode)) l.UnitCode = cpc.Unit;
        if (string.IsNullOrWhiteSpace(l.SstTitle)) l.SstTitle = cpc.Title;
    }

    private void OnNewInvoiceDateChanged(DateTime? date)
    {
        if (date is null) return;
        var currentTime = TimeOnly.FromDateTime(New.Date == default ? DateTime.Now : New.Date);
        New.Date = date.Value.Date.Add(currentTime.ToTimeSpan());
    }

    private void OnNewIssueTimeChanged(TimeOnly time)
    {
        var issueDate = New.Date == default ? DateTime.Now.Date : New.Date.Date;
        New.Date = issueDate.Add(time.ToTimeSpan());
    }

    // ---------- چاپ ----------

    private async Task ShowPrint(MoadianInvoice inv)
    {
        try
        {
            printResult = await PrinterSvc.RenderAsync(inv.Id);
            printInvoiceId = inv.Id;
            showPrint = true;
            await Task.Delay(100);
            if (printFrame.Id is not null)
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{printFrame.Id}').srcdoc = {System.Text.Json.JsonSerializer.Serialize(printResult.PreviewHtml)};");
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void ClosePrint()
    {
        showPrint = false;
        printResult = null;
    }

    private async Task DoPrint()
    {
        if (printInvoiceId == 0) return;
        printing = true;
        try
        {
            var res = await PrinterSvc.PrintAsync(printInvoiceId);
            if (res.Success) Toast.Success(res.Message);
            else Toast.Error(res.Message);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            printing = false;
        }
    }

    private async Task BrowserPrint() => await JS.InvokeVoidAsync("eval", $"window.open('', '_blank').document.write({System.Text.Json.JsonSerializer.Serialize(printResult?.PreviewHtml ?? "")}); setTimeout(() => window.close(), 100);");

    private async Task CopyTicket()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", printResult?.TicketText ?? "");
        Toast.Success("متن رسید کپی شد.");
    }

    // ---------- چاپ صورتحساب الکترونیکی (A4 مطابق نمونه) ----------
    private async Task ShowPaperPrint(MoadianInvoice inv)
    {
        try
        {
            var full = inv.Lines is { Count: > 0 } ? inv : await MoadianSvc.GetInvoiceAsync(inv.Id);
            CompanyProfileDto? profile = null;
            try { profile = await CompanySvc.GetAsync(); }
            catch { /* بدون پروفایل شرکت نیز چاپ می‌شود (نام فروشنده از خود صورتحساب) */ }
            paperPrintHtml = MoadianInvoicePrint.Build(full, profile, Nav.BaseUri);
            showPaperPrint = true;
            await Task.Delay(150);
            if (paperPrintFrame.Id is not null)
            {
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{paperPrintFrame.Id}').srcdoc = {System.Text.Json.JsonSerializer.Serialize(paperPrintHtml)};");
            }
            // محتوای A4 را در ریشهٔ چاپ سند اصلی بگذار تا window.print() فقط همین‌را چاپ کند
            if (paperPrintRoot.Id is not null)
            {
                var fragment = MoadianInvoicePrint.ToPrintableFragment(paperPrintHtml);
                await JS.InvokeVoidAsync("eval", $"document.getElementById('{paperPrintRoot.Id}').innerHTML = {System.Text.Json.JsonSerializer.Serialize(fragment)};");
            }
            // مستقیم به چاپگر: دیالوگ چاپ مرورگر همین‌جا باز می‌شود
            await Task.Delay(300);
            await PrintPaper();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void ClosePaperPrint()
    {
        showPaperPrint = false;
        paperPrintHtml = null;
    }

    /// <summary>
    /// چاپ سطح‌بالا (window.print) روی سند اصلی — با CSS @media print فقط ریشهٔ چاپ
    /// (همان برگهٔ A4) دیده و چاپ می‌شود؛ یعنی خروجی دقیقاً روی چاپگر کاربر قرار می‌گیرد.
    /// </summary>
    private async Task PrintPaper()
    {
        try
        {
            await JS.InvokeVoidAsync("window.print");
        }
        catch (Exception ex)
        {
            Toast.Error("چاپ از مرورگر انجام نشد: " + ex.Message);
        }
    }

    // ---------- JSON ارسال‌شده به سامانه ----------
    private void ShowPayload(MoadianInvoice inv)
    {
        payloadText = inv.LastSendPayload;
        showPayload = true;
    }

    private async Task CopyPayload()
    {
        if (string.IsNullOrEmpty(payloadText)) return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", payloadText);
            Toast.Success("JSON کپی شد.");
        }
        catch (Exception ex)
        {
            Toast.Error("کپی نشد: " + ex.Message);
        }
    }

    // ---------- کمکی ----------

    private static string ProviderTitle(MoadianServiceProviderProfileDto p)
        => string.IsNullOrWhiteSpace(p.PersianName) ? (p.EnglishName ?? $"خدمات‌دهنده {p.NationalId}") : p.PersianName;

    private static string InvoiceTypeFa(MoadianTaxInvoiceType type) => type switch
    {
        MoadianTaxInvoiceType.Type1 => "نوع ۱",
        MoadianTaxInvoiceType.Type2 => "نوع ۲",
        _ => "انتخاب نشده"
    };

    private static string PatternFa(MoadianInvoicePattern pattern) => pattern == MoadianInvoicePattern.Unselected
        ? "انتخاب نشده"
        : $"{(int)pattern} — {MoadianInvoiceRules.PatternTitle(pattern)}";

    private static string SubjectFa(MoadianInvoiceSubject subject) => subject == MoadianInvoiceSubject.Unselected
        ? "انتخاب نشده"
        : MoadianInvoiceRules.SubjectTitle(subject);

    private static string LogActionFa(MoadianLogAction action) => action switch
    {
        MoadianLogAction.Created => "ساخت صورتحساب",
        MoadianLogAction.Enqueued => "ورود به صف",
        MoadianLogAction.Sent => "ارسال به سامانه",
        MoadianLogAction.Failed => "خطا در ارسال",
        MoadianLogAction.Returned => "برگشت/رد از سامانه",
        MoadianLogAction.Voided => "ابطال",
        MoadianLogAction.Updated => "ویرایش",
        MoadianLogAction.Inquiry => "استعلام از سامانه",
        _ => action.ToString()
    };

    private static string FaDateTime(DateTime dt) => $"{FaDate(dt)} {Fa.Digits(dt.ToString("HH:mm:ss"))}";

    private static string FaDate(DateTime dt)
    {
        var (y, m, d) = Inventory.Shared.PersianDate.FromGregorian(dt);
        return $"{Fa.Digits(y)}/{Fa.Digits(m.ToString("00"))}/{Fa.Digits(d.ToString("00"))}";
    }

    private static RenderFragment? StatusBadge(MoadianInvoiceStatus s) => builder =>
    {
        var (cls, text) = s switch
        {
            MoadianInvoiceStatus.Draft => ("bg-warning text-dark", "ارسال نشده"),
            MoadianInvoiceStatus.Queued => ("bg-info text-dark", "در صف ارسال"),
            MoadianInvoiceStatus.Sending => ("bg-info text-dark", "در حال ارسال"),
            MoadianInvoiceStatus.Sent => ("bg-success", "ارسال‌شده"),
            MoadianInvoiceStatus.Failed => ("bg-danger", "ناموفق"),
            MoadianInvoiceStatus.Returned => ("bg-danger", "برگشتی"),
            MoadianInvoiceStatus.AwaitingBuyerConfirmation => ("bg-primary", "در انتظار تأیید خریدار"),
            MoadianInvoiceStatus.BuyerConfirmed => ("bg-success", "تأییدشده توسط خریدار"),
            MoadianInvoiceStatus.BuyerRejected => ("bg-danger", "ردشده توسط خریدار"),
            _ => ("bg-dark", "ابطال‌شده")
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };
}
