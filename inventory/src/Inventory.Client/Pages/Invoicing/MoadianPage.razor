@page "/moadian"
@using Microsoft.AspNetCore.Components
@inject IMoadianClientService MoadianSvc
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>سامانه مودیان</PageTitle>

<div class="page-head">
    <div>
        <h1>سامانه مودیان <span class="badge bg-success">فعال</span></h1>
    </div>
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/settings")'>
            <i class="bi bi-gear"></i> تنظیمات
        </button>
        <button class="btn btn-primary" @onclick='() => Nav.NavigateTo("/moadian/provider-invoices")'>
            <i class="bi bi-receipt"></i> صورتحساب‌های خدمات‌دهنده
        </button>
        <button class="btn btn-outline-primary" @onclick='() => Nav.NavigateTo("/moadian/invoice-new")'>
            <i class="bi bi-plus-lg"></i> ثبت صورتحساب جدید
        </button>
    </div>
</div>


<!-- کارت‌های آماری -->
<div class="row g-3 mb-3">
    <div class="col-6 col-lg-2">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">کل فاکتورها</div>
            <div class="stat-value num">@dash.TotalCount.Num()</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">ارسال‌نشده</div>
            <div class="stat-value num text-secondary">@dash.DraftCount.Num()</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">در صف</div>
            <div class="stat-value num text-warning">@dash.QueuedCount.Num()</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">ارسال‌شده</div>
            <div class="stat-value num text-success">@dash.SentCount.Num()</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">ناموفق/برگشتی</div>
            <div class="stat-value num text-danger">@(dash.FailedCount + dash.ReturnedCount).Num()</div>
        </div></div>
    </div>
    <div class="col-6 col-lg-2">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">فروشنده</div>
            <div class="stat-value fs-6 pt-1">@(dash.SellerName ?? "—")</div>
            <div class="fs-8 text-muted" dir="ltr">@(dash.TaxId ?? "")</div>
        </div></div>
    </div>
</div>

<div class="row g-3 mb-3">
    <div class="col-md-4">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">جمع خالص فاکتورها</div>
            <div class="stat-value num text-primary">@dash.NetTotal.Money()</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">مالیات بر ارزش افزوده</div>
            <div class="stat-value num text-warning">@dash.VatTotal.Money()</div>
        </div></div>
    </div>
    <div class="col-md-4">
        <div class="card stat-card"><div class="card-body">
            <div class="stat-label">وضعیت ارسال/استعلام</div>
            <div class="stat-value fs-6 pt-1 text-success">فعال — با کلید خصوصی اتصال</div>
        </div></div>
    </div>
</div>

<!-- آخرین مشکلات -->
<div class="card mb-3">
    <div class="card-header fw-bold">آخرین خطاها و برگشت‌ها</div>
    <div class="card-body p-0">
        @if (dash.RecentIssues.Count == 0)
        {
            <div class="p-3 text-muted">موردی وجود ندارد — همه‌چیز عالی است. ✅</div>
        }
        else
        {
            <table class="table table-sm mb-0">
                <thead><tr><th>شماره</th><th>نوع</th><th>وضعیت</th><th>پیام خطا</th><th></th></tr></thead>
                <tbody>
                    @foreach (var inv in dash.RecentIssues)
                    {
                        <tr>
                            <td class="num">@inv.Number</td>
                            <td>
                                @KindFa(inv.Kind)
                                <div class="small text-muted">inty: @InvoiceTypeFa(inv.InvoiceType) · inp: @PatternFa(inv.InvoicePattern)</div>
                                <div class="small text-muted">ins: @SubjectFa(inv.InvoiceSubject)</div>
                            </td>
                            <td>@StatusBadge(inv.Status)</td>
                            <td class="text-danger small">@(inv.ErrorMessage ?? "")</td>
                            <td><button class="btn btn-sm btn-outline-primary" @onclick="() => GoInvoice(inv.Id)">مشاهده</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<div class="card">
    <div class="card-header fw-bold">راهنمای سریع</div>
    <div class="card-body">
        <ol class="mb-0 fs-14">
            <li>اطلاعات فروشنده، حافظهٔ مالیاتی و سیاست ساخت خودکار صورتحساب هر منبع از صفحهٔ «تنظیمات مودیان» تنظیم می‌شود (نشانی: moadian/settings).</li>
            <li>صورتحساب را از «ثبت صورتحساب جدید» بسازید، یا از فاکتور قطعی فروش ERP/سند فروش «عملیات» بسازید؛ نوع رسمی (inty)، الگو (inp) و موضوع (ins) را جداگانه بازبینی کنید و آن‌ها را با جهت سند داخلی یکی نگیرید.</li>
            <li>برای هر ردیف، شناسه کالا/خدمت مالیاتی و واحد مالیاتی واقعی را تکمیل کنید؛ شناسهٔ ساختگی تولید نمی‌شود.</li>
            <li>ارسال رسمی و استعلام وضعیت از صفحهٔ «صورتحساب‌های خدمات‌دهنده» با کلید خصوصی اتصالِ همان خدمات‌دهنده انجام می‌شود؛ وضعیت‌های خریدار (در انتظار/تأیید/رد) پس از استعلام به‌روز می‌شوند.</li>
        </ol>
    </div>
</div>

@code {
    private MoadianDashboard dash = new();

    protected override async Task OnInitializedAsync()
    {
        try { dash = await MoadianSvc.GetDashboardAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void GoInvoice(int id) => Nav.NavigateTo($"/moadian/provider-invoices?invoice={id}");

    private static string InvoiceTypeFa(MoadianTaxInvoiceType type) => type switch
    {
        MoadianTaxInvoiceType.Type1 => "نوع ۱",
        MoadianTaxInvoiceType.Type2 => "نوع ۲",
        _ => "انتخاب‌نشده"
    };

    private static string PatternFa(MoadianInvoicePattern pattern) => pattern == MoadianInvoicePattern.Unselected
        ? "انتخاب‌نشده"
        : $"{(int)pattern} — {MoadianInvoiceRules.PatternTitle(pattern)}";

    private static string SubjectFa(MoadianInvoiceSubject subject) => subject == MoadianInvoiceSubject.Unselected
        ? "انتخاب‌نشده"
        : $"{(int)subject} — {MoadianInvoiceRules.SubjectTitle(subject)}";

    private static string KindFa(MoadianInvoiceKind k) => k switch
    {
        MoadianInvoiceKind.Sale => "فروش",
        MoadianInvoiceKind.SaleReturn => "فروش برگشتی",
        MoadianInvoiceKind.Purchase => "خرید",
        MoadianInvoiceKind.PurchaseReturn => "خرید برگشتی",
        _ => "پیش‌فاکتور"
    };

    private static RenderFragment? StatusBadge(MoadianInvoiceStatus s) => builder =>
    {
        var (cls, text) = s switch
        {
            MoadianInvoiceStatus.Draft => ("bg-warning text-dark", "ارسال نشده"),
            MoadianInvoiceStatus.Queued => ("bg-info text-dark", "در صف ارسال"),
            MoadianInvoiceStatus.Sending => ("bg-info text-dark", "در حال ارسال"),
            MoadianInvoiceStatus.Sent => ("bg-success", "ارسال‌شده"),
            MoadianInvoiceStatus.Failed => ("bg-danger", "ناموفق"),
            MoadianInvoiceStatus.Returned => ("bg-danger", "برگشتی"),
            _ => ("bg-dark", "ابطال‌شده")
        };
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", $"badge {cls}");
        builder.AddContent(2, text);
        builder.CloseElement();
    };
}
