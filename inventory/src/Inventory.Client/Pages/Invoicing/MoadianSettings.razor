@page "/moadian/settings"
@using Microsoft.AspNetCore.Components
@inject IMoadianClientService MoadianSvc
@inject IFiscalPrinterClientService PrinterSvc
@inject IMoadianStandaloneClientService StandaloneSvc
@inject NavigationManager Nav
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>تنظیمات مودیان و چاپگر مالی</PageTitle>

<div class="page-head">
    <div>
        <h1>تنظیمات مودیان و چاپگر مالی</h1>
        <p class="lead">پیکربندی کلیدهای امنیتی، سال مالی و دوره‌های مالیاتی، شناسه کالا/خدمات و چاپگر مالی</p>
    </div>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class='nav-link @(tab == 1 ? "active" : "")' @onclick="() => tab = 1">اتصال سامانه</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 2 ? "active" : "")' @onclick="() => tab = 2">دوره‌های مالیاتی</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 3 ? "active" : "")' @onclick="() => tab = 3">فهرست داخلی شناسه‌ها</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 4 ? "active" : "")' @onclick="() => tab = 4">چاپگر مالی</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 5 ? "active" : "")' @onclick="() => tab = 5">لاگ ارسال</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 6 ? "active" : "")' @onclick="() => OpenFiscalYears()">سال مالی</button></li>
</ul>

@if (tab == 1)
{
    <div class="card">
        <div class="card-body">
            <div class="alert alert-warning py-2 small">
                <i class="bi bi-shield-exclamation"></i>
                این بخش فعلاً پیش‌نویس و بازبینی را مدیریت می‌کند. ارسال آزمایشی/واقعی غیرفعال است؛ تا تأیید مستندات رسمی و آزمون با دسترسی مجاز، هیچ فاکتوری به‌عنوان «ارسال‌شده» ثبت نخواهد شد.
            </div>

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small">شناسه مالیاتی فروشنده <span class="text-danger">*</span></label>
                    <input class="form-control" dir="ltr" @bind="setting.TaxId" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">شناسه/کد حافظه مالیاتی (در صورت دریافت)</label>
                    <input class="form-control" dir="ltr" maxlength="20" @bind="setting.FiscalMemoryId" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">کد اقتصادی</label>
                    <input class="form-control" dir="ltr" @bind="setting.EconomicCode" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">نام فروشنده</label>
                    <input class="form-control" @bind="setting.SellerName" />
                </div>
                <div class="col-md-3">
                    <label class="form-label small">تلفن فروشنده</label>
                    <input class="form-control" @bind="setting.SellerPhone" />
                </div>
                <div class="col-md-8">
                    <label class="form-label small">آدرس فروشنده</label>
                    <input class="form-control" @bind="setting.SellerAddress" />
                </div>
                <div class="col-md-4">
                    <label class="form-label small">کد پستی</label>
                    <input class="form-control" dir="ltr" @bind="setting.SellerPostalCode" />
                </div>
                <div class="col-md-6">
                    <label class="form-label small">نشانی پایهٔ API (تنظیم اتصال آینده)</label>
                    <input class="form-control" dir="ltr" placeholder="https://tp.tax.gov.ir/requestsmanager" @bind="setting.BaseUrl" />
                    <div class="form-text">ثبت نشانی به‌تنهایی ارسال را فعال نمی‌کند.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">کلید خصوصی امضا (PEM)</label>
                    <textarea class="form-control font-monospace small" rows="5" dir="ltr" placeholder="کلید هنگام ذخیره به‌صورت محافظت‌شده نگهداری می‌شود." @bind="setting.PrivateKeyPem"></textarea>
                    <div class="form-text">مقدار ماسک‌شده را برای حفظ کلید قبلی دست‌نخورده بگذارید؛ برای جایگزینی، کل مقدار را با PEM جدید عوض کنید.</div>
                </div>
                <div class="col-md-6">
                    <label class="form-label small">گواهی امضای مؤدی (PEM)</label>
                    <textarea class="form-control font-monospace small" rows="5" dir="ltr" placeholder="گواهی هنگام ذخیره به‌صورت محافظت‌شده نگهداری می‌شود." @bind="setting.SigningCertificatePem"></textarea>
                    <div class="form-text">مقدار ماسک‌شده را برای حفظ گواهی قبلی دست‌نخورده بگذارید.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label small">نرخ پیش‌فرض مالیات (٪)</label>
                    <input class="form-control text-center num" @bind="setting.DefaultVatRate" />
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="cb-autodraft-operations" @bind="setting.AutoDraftFromOperations" />
                        <label class="form-check-label small" for="cb-autodraft-operations">ساخت خودکار پیش‌نویس از فروش‌های ثبت‌شده در «عملیات»</label>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="cb-autodraft-fac" @bind="setting.AutoDraftFromFacInvoices" />
                        <label class="form-check-label small" for="cb-autodraft-fac">ساخت خودکار پیش‌نویس پس از قطعی‌شدن فاکتور فروش ERP</label>
                    </div>
                </div>
                <div class="col-md-6 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="cb-log" @bind="setting.LoggingEnabled" />
                        <label class="form-check-label small" for="cb-log">ثبت رویدادهای پیش‌نویس و بازبینی</label>
                    </div>
                </div>
                <div class="col-12">
                    <button class="btn btn-primary" @onclick="SaveSetting" disabled="@saving">@(saving ? "در حال ذخیره..." : "ذخیره تنظیمات")</button>
                </div>
            </div>
        </div>
    </div>
}

@if (tab == 2)
{
    <div class="card">
        <div class="card-header fw-bold">دوره‌های مالیاتی (ماه‌های شمسی)</div>
        <div class="card-body">
            <div class="row g-2 mb-3">
                <div class="col-auto"><input class="form-control form-control-sm" type="number" placeholder="سال (مثلاً 1405)" @bind="pYear" /></div>
                <div class="col-auto">
                    <select class="form-select form-select-sm" @bind="pMonth">
                        @for (var i = 1; i <= 12; i++)
                        {
                            <option value="@i">@PersianDate.MonthName(i)</option>
                        }
                    </select>
                </div>
                <div class="col-auto">
                    <div class="form-check mt-1">
                        <input class="form-check-input" type="checkbox" id="cb-close" @bind="pClosed" />
                        <label class="form-check-label small" for="cb-close">بسته</label>
                    </div>
                </div>
                <div class="col-auto"><button class="btn btn-sm btn-primary" @onclick="SavePeriod">افزودن دوره</button></div>
            </div>
            <table class="table table-sm table-hover align-middle text-center">
                <thead><tr><th>دوره</th><th>وضعیت</th><th class="text-center">تعداد فاکتور</th><th class="text-center">جمع خالص</th><th></th></tr></thead>
                <tbody>
                    @foreach (var p in periods)
                    {
                        <tr>
                            <td class="num fw-bold">@p.Title</td>
                            <td>@ClosedBadge(p.IsClosed)</td>
                            <td class="text-center num">@p.InvoiceCount</td>
                            <td class="text-center num">@p.NetTotal.Money()</td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeletePeriod(p)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (tab == 3)
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center">
            <span>فهرست داخلی شناسه‌های کالا/خدمت</span>
            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="OpenCpc"><i class="bi bi-plus-lg"></i> شناسه جدید</button>
        </div>
        <div class="card-body">
            <div class="alert alert-warning py-2 small">
                این فهرست دادهٔ داخلی است و هنوز با آخرین مرجع رسمی تطبیق نشده؛ در هر پیش‌نویس، شناسه و واحد مالیاتی را با مرجع معتبر مؤدی تطبیق دهید.
            </div>
            <div class="input-group mb-3">
                <input class="form-control form-control-sm" placeholder="جستجوی کد یا شرح..." @bind="cpcSearch" @bind:event="oninput" @bind:after="LoadCpc" />
            </div>
            <table class="table table-sm table-hover align-middle text-center">
                <thead><tr><th>کد</th><th>شرح</th><th>نام لاتین</th><th>واحد</th><th>فعال</th><th></th></tr></thead>
                <tbody>
                    @foreach (var c in cpcList)
                    {
                        <tr>
                            <td class="num" dir="ltr">@c.Code</td>
                            <td>@c.Title</td>
                            <td class="text-muted" dir="ltr">@c.EnTitle</td>
                            <td>@c.Unit</td>
                            <td><i class='bi @(c.IsActive ? "bi-check-circle text-success" : "bi-x-circle text-secondary")'></i></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-secondary" @onclick="() => EditCpc(c)"><i class="bi bi-pencil"></i></button>
                                <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteCpc(c)"><i class="bi bi-trash"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@if (tab == 4)
{
    <div class="row g-3">
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-bold">تنظیمات چاپگر مالی</div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small">نام چاپگر</label>
                            <input class="form-control" @bind="printer.PrinterName" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small">عرض کاغذ</label>
                            <select class="form-select" @bind="printer.PaperWidthMm">
                                <option value="80">۸۰ میلی‌متر</option>
                                <option value="58">۵۸ میلی‌متر</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">پورت دستگاه</label>
                            <input class="form-control" dir="ltr" placeholder="FILE:/tmp/pos.txt یا 192.168.1.50:9100 یا /dev/usb/lp0" @bind="printer.PortName" />
                            <div class="form-text">خالی = حالت شبیه‌سازی (فقط پیش‌نمایش/ذخیره). برای تست خروجی ESC/POS: <code dir="ltr">FILE:/tmp/pos.txt</code></div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">تعداد نسخه</label>
                            <input class="form-control text-center num" @bind="printer.Copies" />
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="cb-cut" @bind="printer.CutPaper" />
                                <label class="form-check-label small" for="cb-cut">بریدن کاغذ</label>
                            </div>
                        </div>
                        <div class="col-md-3 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="cb-en" @bind="printer.Enabled" />
                                <label class="form-check-label small" for="cb-en">فعال</label>
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">سربرگ رسید (هر خط)</label>
                            <textarea class="form-control small" rows="2" @bind="printer.HeaderLines"></textarea>
                        </div>
                        <div class="col-12">
                            <label class="form-label small">پابرگ رسید</label>
                            <textarea class="form-control small" rows="2" @bind="printer.FooterLines"></textarea>
                        </div>
                        <div class="col-12">
                            <button class="btn btn-primary" @onclick="SavePrinter" disabled="@saving">@(saving ? "..." : "ذخیره تنظیمات چاپگر")</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card">
                <div class="card-header fw-bold">راهنما</div>
                <div class="card-body small">
                    <ul class="mb-0">
                        <li>چاپگری که از ESC/POS پشتیبانی می‌کند: پورت شبکه <code dir="ltr">IP:9100</code> یا مسیر دستگاه <code dir="ltr">/dev/usb/lp0</code>.</li>
                        <li>برای تست بدون سخت‌افزار: <code dir="ltr">FILE:/tmp/pos.txt</code> — خروجی بایت‌های ESC/POS ذخیره می‌شود.</li>
                        <li>پیش‌نویس چاپ‌شده با واترمارک «سند رسمی نیست» مشخص می‌شود و QR/UID سامانه برای آن ساخته نمی‌شود.</li>
                        <li>چاپ رسید رسمی تا تأیید اتصال مستقیم مودیان غیرفعال است.</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
}

@if (tab == 5)
{
    <div class="card">
        <div class="card-header fw-bold">لاگ ارسال (آخرین ۳۰۰ رویداد)</div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead><tr><th>زمان</th><th>فاکتور</th><th>رویداد</th><th>پیام</th></tr></thead>
                <tbody>
                    @foreach (var lg in logs)
                    {
                        <tr>
                            <td class="num text-nowrap">@lg.CreatedAt.ToString("MM/dd HH:mm")</td>
                            <td class="num">@lg.InvoiceNumber</td>
                            <td>@LogActionFa(lg.Action)</td>
                            <td class="small">@lg.Message</td>
                        </tr>
                    }
                    @if (logs.Count == 0)
                    {
                        <tr><td colspan="4" class="text-center text-muted py-3">لاگی ثبت نشده است.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<!-- ===================== مودال CPC ===================== -->
<Modal Visible="showCpc" Title='@(cpcEdit.Id == 0 ? "شناسه کالا/خدمت جدید" : "ویرایش شناسه")' OnClose="() => showCpc = false">
    <ChildContent>
    <div class="row g-3">
        <div class="col-12 col-sm-6">
            <label class="form-label small">کد CPC <span class="text-danger">*</span></label>
            <input class="form-control" dir="ltr" @bind="cpcEdit.Code" />
        </div>
        <div class="col-12 col-sm-6">
            <label class="form-label small">واحد</label>
            <input class="form-control" @bind="cpcEdit.Unit" placeholder="عدد / خدمت" />
        </div>
        <div class="col-12">
            <label class="form-label small">شرح فارسی <span class="text-danger">*</span></label>
            <input class="form-control" @bind="cpcEdit.Title" />
        </div>
        <div class="col-12">
            <label class="form-label small">نام لاتین</label>
            <input class="form-control" dir="ltr" @bind="cpcEdit.EnTitle" />
        </div>
        <div class="col-12">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="cb-cpc-active" @bind="cpcEdit.IsActive" />
                <label class="form-check-label small" for="cb-cpc-active">فعال (قابل انتخاب در اقلام)</label>
            </div>
        </div>
    </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-primary" @onclick="SaveCpc" disabled="@saving">@(saving ? "..." : "ذخیره")</button>
        <button class="btn btn-light" @onclick="() => showCpc = false">انصراف</button>
    </Footer>
</Modal>

@if (tab == 6)
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center justify-content-between">
            <span>سال مالی مودیان (شمسی) و شمارهٔ سند سالانه</span>
            <div class="d-flex gap-2">
                <input class="form-control form-control-sm num" style="width:110px" type="number" min="1300" max="1500"
                       placeholder="مثلاً 1405" @bind="newYearValue" />
                <button class="btn btn-sm btn-primary" @onclick="AddFiscalYear" disabled="@saving">
                    <i class="bi bi-plus-lg"></i> تعریف سال مالی
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick='() => Nav.NavigateTo("/moadian/fiscal-years")'>
                    صفحهٔ کامل سال مالی
                </button>
            </div>
        </div>
        <div class="card-body">
            <div class="alert alert-info py-2 small">
                با تعریف سال مالی، ۱۲ دورهٔ ماهانهٔ آن خودکار ساخته می‌شود؛ شمارهٔ سند هر صورتحساب به شکل
                <span class="num" dir="ltr">سال/سریال</span> از همین سال تخصیص می‌یابد.
            </div>
            @if (fiscalYears.Count == 0)
            {
                <div class="text-muted small">سال مالی ثبت نشده است.</div>
            }
            else
            {
                <table class="table table-sm table-hover align-middle text-center mb-0">
                    <thead><tr><th>سال</th><th>دوره‌ها</th><th class="text-center">تعداد صورتحساب</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var y in fiscalYears)
                        {
                            <tr>
                                <td class="num fw-bold">@y.Year</td>
                                <td class="num small">@y.PeriodCount ماه (@y.ClosedPeriodCount بسته)</td>
                                <td class="text-center num">@y.InvoiceCount</td>
                                <td>@ClosedBadge(y.IsClosed)</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light" @onclick="() => ToggleFiscalYear(y)" disabled="@saving">
                                        @(y.IsClosed ? "باز کردن" : "بستن")
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
}

@code {
    private int tab = 1;
    private bool saving;

    private MoadianSetting setting = new();
    private List<MoadianFiscalPeriod> periods = new();
    private List<MoadianCpc> cpcList = new();
    private List<MoadianLog> logs = new();

    private int pYear = PersianDate.FromGregorian(DateTime.Now).Year;
    private int pMonth = PersianDate.FromGregorian(DateTime.Now).Month;
    private bool pClosed;

    private string cpcSearch = "";
    private bool showCpc;
    private MoadianCpc cpcEdit = new();

    private FiscalPrinterSetting printer = new();
    private List<MoadianFiscalYearDto> fiscalYears = new();
    private int newYearValue = PersianDate.FromGregorian(DateTime.Now).Year;

    private async Task OpenFiscalYears()
    {
        tab = 6;
        try { fiscalYears = await StandaloneSvc.GetFiscalYearsAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task AddFiscalYear()
    {
        if (newYearValue is < 1300 or > 1500) { Toast.Error("سال شمسی باید بین ۱۳۰۰ و ۱۵۰۰ باشد."); return; }
        saving = true;
        try
        {
            await StandaloneSvc.SaveFiscalYearAsync(new MoadianFiscalYearRequest { Year = newYearValue, CreateMonthlyPeriods = true });
            Toast.Success($"سال مالی {newYearValue} با ۱۲ دورهٔ ماهانه ثبت شد.");
            fiscalYears = await StandaloneSvc.GetFiscalYearsAsync();
            periods = await MoadianSvc.GetPeriodsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task ToggleFiscalYear(MoadianFiscalYearDto y)
    {
        saving = true;
        try
        {
            if (y.IsClosed) await StandaloneSvc.ReopenFiscalYearAsync(y.Id);
            else await StandaloneSvc.CloseFiscalYearAsync(y.Id);
            fiscalYears = await StandaloneSvc.GetFiscalYearsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            setting = await MoadianSvc.GetSettingAsync();
            periods = await MoadianSvc.GetPeriodsAsync();
            cpcList = await MoadianSvc.GetCpcAsync();
            logs = await MoadianSvc.GetLogsAsync();
            printer = await PrinterSvc.GetSettingAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task SaveSetting()
    {
        if (string.IsNullOrWhiteSpace(setting.TaxId)) { Toast.Error("شماره مالیاتی را وارد کنید."); return; }
        saving = true;
        try
        {
            setting = await MoadianSvc.SaveSettingAsync(setting);
            Toast.Success("تنظیمات مودیان ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task SavePeriod()
    {
        if (pYear < 1300 || pYear > 1500) { Toast.Error("سال معتبر وارد کنید."); return; }
        saving = true;
        try
        {
            await MoadianSvc.SavePeriodAsync(new MoadianFiscalPeriod { Year = pYear, Month = pMonth, IsClosed = pClosed });
            Toast.Success("دوره اضافه شد.");
            periods = await MoadianSvc.GetPeriodsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeletePeriod(MoadianFiscalPeriod p)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"دوره {p.Title} حذف شود؟")) return;
        try
        {
            await MoadianSvc.DeletePeriodAsync(p.Id);
            Toast.Success("حذف شد.");
            periods = await MoadianSvc.GetPeriodsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task LoadCpc()
    {
        try { cpcList = await MoadianSvc.GetCpcAsync(cpcSearch); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void OpenCpc()
    {
        cpcEdit = new MoadianCpc { IsActive = true, Unit = "عدد" };
        showCpc = true;
    }

    private void EditCpc(MoadianCpc c)
    {
        cpcEdit = new MoadianCpc { Id = c.Id, Code = c.Code, Title = c.Title, EnTitle = c.EnTitle, IsActive = c.IsActive, Unit = c.Unit };
        showCpc = true;
    }

    private async Task SaveCpc()
    {
        if (string.IsNullOrWhiteSpace(cpcEdit.Code) || string.IsNullOrWhiteSpace(cpcEdit.Title))
        { Toast.Error("کد و شرح الزامی است."); return; }
        saving = true;
        try
        {
            await MoadianSvc.SaveCpcAsync(cpcEdit);
            Toast.Success("ذخیره شد.");
            showCpc = false;
            await LoadCpc();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteCpc(MoadianCpc c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"شناسه {c.Code} حذف شود؟")) return;
        try
        {
            await MoadianSvc.DeleteCpcAsync(c.Id);
            Toast.Success("حذف شد.");
            await LoadCpc();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task SavePrinter()
    {
        saving = true;
        try
        {
            printer = await PrinterSvc.SaveSettingAsync(printer);
            Toast.Success("تنظیمات چاپگر ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private static RenderFragment? ClosedBadge(bool closed) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", closed ? "badge bg-danger" : "badge bg-success");
        builder.AddContent(2, closed ? "بسته" : "باز");
        builder.CloseElement();
    };

    private static string LogActionFa(Inventory.Shared.MoadianLogAction a) => a switch
    {
        Inventory.Shared.MoadianLogAction.Created => "ساخت",
        Inventory.Shared.MoadianLogAction.Enqueued => "صف",
        Inventory.Shared.MoadianLogAction.Sent => "ارسال موفق",
        Inventory.Shared.MoadianLogAction.Failed => "خطا",
        Inventory.Shared.MoadianLogAction.Returned => "برگشت",
        Inventory.Shared.MoadianLogAction.Voided => "ابطال",
        Inventory.Shared.MoadianLogAction.Updated => "ویرایش پیش‌نویس",
        _ => a.ToString()
    };
}
