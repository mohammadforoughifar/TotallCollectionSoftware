@page "/moadian/master-data"
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Forms
@inject IMoadianMasterDataClientService MoadianMasterDataSvc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>اطلاعات پایه مودیان</PageTitle>

<div class="page-head">
    <div>
        <h1>اطلاعات پایه مودیان</h1>
    </div>
</div>


<ul class="nav nav-tabs mb-3 flex-wrap">
    <li class="nav-item"><button class='nav-link @(tab == 1 ? "active" : "")' @onclick="() => tab = 1">خدمات‌دهنده</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 2 ? "active" : "")' @onclick="() => tab = 2">اتصال</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 3 ? "active" : "")' @onclick="() => tab = 3">مشتری</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 4 ? "active" : "")' @onclick="() => tab = 4">کالا و خدمت</button></li>
    <li class="nav-item"><button class='nav-link @(tab == 5 ? "active" : "")' @onclick="() => tab = 5">واحد اندازه‌گیری</button></li>
</ul>

@if (loading)
{
    <div class="card"><div class="card-body text-center py-5"><div class="spinner-border text-primary" role="status"></div><div class="mt-2 text-muted">در حال دریافت اطلاعات...</div></div></div>
}
else if (tab == 1)
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center gap-2">
            <span>خدمات‌دهندگان / صادرکنندگان</span>
            <span class="badge bg-secondary">@providers.Count</span>
            <button class="btn btn-sm btn-primary ms-auto" @onclick="OpenNewProvider"><i class="bi bi-plus-lg"></i> خدمات‌دهنده جدید</button>
        </div>
        <div class="card-body p-0">
            @if (providers.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-building-add"></i><h5>خدمات‌دهنده‌ای ثبت نشده است</h5></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead><tr><th>نام / نوع شخص</th><th>شناسهٔ ملی</th><th>شمارهٔ اقتصادی</th><th>کدپستی</th><th>وضعیت</th><th class="text-center">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var p in providers)
                            {
                                <tr class="@(p.IsDeleted ? "text-muted" : "")">
                                    <td><div class="fw-600">@ProviderTitle(p)</div><div class="small text-muted">@p.Type</div></td>
                                    <td class="num" dir="ltr">@p.NationalId</td>
                                    <td class="num" dir="ltr">@(p.EconomicNumber ?? "—")</td>
                                    <td class="num" dir="ltr">@(p.PostalCode ?? "—")</td>
                                    <td>@StateBadge(p.IsDeleted)</td>
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-light" title="ویرایش CPInfo" @onclick="() => OpenEditProvider(p)"><i class="bi bi-pencil text-primary"></i></button>
                                        @if (p.IsDeleted)
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetProviderDeleted(p, false)"><i class="bi bi-arrow-counterclockwise"></i> بازیابی</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light" title="غیرفعال‌کردن" @onclick="() => SetProviderDeleted(p, true)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else if (tab == 2)
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center gap-2 flex-wrap">
            <span>اتصال‌های خدمات‌دهندگان</span>
            <span class="badge bg-secondary">@FilteredConnections.Count()</span>
            <select class="form-select form-select-sm ms-auto" style="max-width:280px" @bind="providerFilter">
                <option value="0">همه خدمات‌دهندگان</option>
                @foreach (var p in ActiveProviders)
                {
                    <option value="@p.Id">@ProviderTitle(p)</option>
                }
            </select>
            @if (Auth.IsAdmin)
            {
                <button class="btn btn-sm btn-primary" title="هر خدمات‌دهنده فقط یک اتصال می‌تواند داشته باشد"
                        @onclick="OpenNewConnection" disabled="@(ActiveProviders.Count == 0 || ActiveProviders.All(p => HasConnection(p.Id)))"><i class="bi bi-plus-lg"></i> اتصال جدید</button>
            }
        </div>
        <div class="card-body p-0">
            @if (ActiveProviders.Count == 0)
            {
                <div class="alert alert-warning m-3 mb-0">ابتدا یک خدمات‌دهندهٔ فعال در فرم CPInfo تعریف کنید.</div>
            }
            else if (!FilteredConnections.Any())
            {
                <div class="empty-state"><i class="bi bi-plug"></i><h5>اتصالی ثبت نشده است</h5></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead><tr><th>خدمات‌دهنده</th><th>شناسهٔ حافظهٔ مالیاتی</th><th>کلید خصوصی</th><th>نشانی وب‌سرویس</th><th>وضعیت</th><th>آخرین تست اتصال</th><th class="text-center">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var c in FilteredConnections)
                            {
                                <tr class="@(c.IsDeleted ? "text-muted" : "")">
                                    <td><div>@c.ProviderName</div><div class="small text-muted">اتصال #@c.Id</div></td>
                                    <td class="num" dir="ltr">@c.TaxMemoryId</td>
                                    <td><span class="badge @(c.HasPrivateKey ? "bg-success" : "bg-warning text-dark")">@(c.HasPrivateKey ? "بارگذاری شده" : "بارگذاری نشده")</span></td>
                                    <td class="small" dir="ltr">@c.WebServiceAddress</td>
                                    <td>@StateBadge(c.IsDeleted)</td>
                                    <td class="small">
                                        @if (c.LastTestAt is null)
                                        {
                                            <span class="text-muted">تست نشده</span>
                                        }
                                        else
                                        {
                                            <span class="badge @(c.LastTestSucceeded == true ? "bg-success" : "bg-danger")">@(c.LastTestSucceeded == true ? "موفق" : "ناموفق")</span>
                                            <div class="text-muted num">@c.LastTestAt.Value.ToFaDateTime()</div>
                                            @if (!string.IsNullOrWhiteSpace(c.LastTestMessage))
                                            {
                                                <div class="text-muted" title="@c.LastTestMessage">@Shorten(c.LastTestMessage!, 70)</div>
                                            }
                                        }
                                    </td>
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm @(c.LastTestSucceeded == true ? "btn-outline-success" : "btn-outline-primary")"
                                                title="@(c.HasPrivateKey ? "تست اتصال به سامانه و بررسی اعتبار احراز هویت" : "ابتدا کلید خصوصی اتصال را بارگذاری کنید")"
                                                @onclick="() => TestConnection(c)"
                                                disabled="@(testBusy || c.IsDeleted || !c.HasPrivateKey || ProviderIsDeleted(c.ServiceProviderId))">
                                            @if (testBusyConnectionId == c.Id)
                                            {
                                                <span class="spinner-border spinner-border-sm me-1"></span>
                                                <span>در حال تست...</span>
                                            }
                                            else
                                            {
                                                <i class="bi bi-plug"></i>
                                                <span>تست اتصال</span>
                                            }
                                        </button>
                                        @if (Auth.IsAdmin)
                                        {
                                            <button class="btn btn-sm btn-light" title="ویرایش اتصال" @onclick="() => OpenEditConnection(c)" disabled="@ProviderIsDeleted(c.ServiceProviderId)"><i class="bi bi-pencil text-primary"></i></button>
                                            @if (c.IsDeleted)
                                            {
                                                <button class="btn btn-sm btn-outline-success" title="فعال‌کردن اتصال" @onclick="() => SetConnectionDeleted(c, false)" disabled="@ProviderIsDeleted(c.ServiceProviderId)"><i class="bi bi-arrow-counterclockwise"></i> بازیابی</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-light" title="غیرفعال‌کردن اتصال" @onclick="() => SetConnectionDeleted(c, true)"><i class="bi bi-pause-circle text-warning"></i></button>
                                            }
                                            <button class="btn btn-sm btn-outline-danger" title="حذف کامل اتصال و فایل کلید خصوصی آن"
                                                    @onclick="() => DeleteConnectionPermanently(c)" disabled="@(saving || testBusy || connectionBusy)">
                                                <i class="bi bi-trash"></i> حذف
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="small text-muted" title="ویرایش، حذف و غیرفعال‌سازی اتصال فقط برای مدیر امکان‌پذیر است"><i class="bi bi-lock"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else if (tab == 3)
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center gap-2 flex-wrap">
            <span>مشتریان / خریداران</span>
            <span class="badge bg-secondary">@FilteredCustomers.Count()</span>
            <select class="form-select form-select-sm ms-auto" style="max-width:280px" @bind="providerFilter">
                <option value="0">همه خدمات‌دهندگان</option>
                @foreach (var p in ActiveProviders)
                {
                    <option value="@p.Id">@ProviderTitle(p)</option>
                }
            </select>
            <button class="btn btn-sm btn-primary" @onclick="OpenNewCustomer" disabled="@(ActiveProviders.Count == 0)"><i class="bi bi-plus-lg"></i> مشتری جدید</button>
        </div>
        <div class="card-body p-0">
            @if (ActiveProviders.Count == 0)
            {
                <div class="alert alert-warning m-3 mb-0">ابتدا یک خدمات‌دهندهٔ فعال تعریف کنید.</div>
            }
            else if (!FilteredCustomers.Any())
            {
                <div class="empty-state"><i class="bi bi-people"></i><h5>مشتری‌ای ثبت نشده است</h5></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead><tr><th>خدمات‌دهنده</th><th>نام مشتری</th><th>شناسه‌های خریدار</th><th>تلفن</th><th>کدپستی و نشانی</th><th>وضعیت</th><th class="text-center">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var c in FilteredCustomers)
                            {
                                <tr class="@(c.IsDeleted ? "text-muted" : "")">
                                    <td>@c.ProviderName</td>
                                    <td><div class="fw-600">@c.Name</div><div class="small text-muted">@c.Type</div></td>
                                    <td class="small"><div>شناسهٔ ملی: <span class="num" dir="ltr">@(c.NationalId ?? "—")</span></div><div>شمارهٔ اقتصادی: <span class="num" dir="ltr">@(c.EconomicNumber ?? "—")</span></div></td>
                                    <td class="num" dir="ltr">@(c.Phone ?? "—")</td>
                                    <td class="small"><div class="num" dir="ltr">@(c.PostalCode ?? "—")</div><div class="text-muted">@(c.Address ?? "—")</div></td>
                                    <td>@StateBadge(c.IsDeleted)</td>
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditCustomer(c)"><i class="bi bi-pencil text-primary"></i></button>
                                        @if (c.IsDeleted)
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetCustomerDeleted(c, false)"><i class="bi bi-arrow-counterclockwise"></i> بازیابی</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light" title="غیرفعال‌کردن" @onclick="() => SetCustomerDeleted(c, true)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else if (tab == 4)
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center gap-2 flex-wrap">
            <span>کالاها و خدمات</span>
            <span class="badge bg-secondary">@FilteredGoods.Count()</span>
            <select class="form-select form-select-sm ms-auto" style="max-width:280px" @bind="providerFilter">
                <option value="0">همه خدمات‌دهندگان</option>
                @foreach (var p in ActiveProviders)
                {
                    <option value="@p.Id">@ProviderTitle(p)</option>
                }
            </select>
            <button class="btn btn-sm btn-primary" @onclick="OpenNewGoods" disabled="@(ActiveProviders.Count == 0 || ActiveUnits.Count == 0)"><i class="bi bi-plus-lg"></i> کالا و خدمت جدید</button>
            <button class="btn btn-sm btn-outline-primary" @onclick="OpenGoodsImport" disabled="@(ActiveProviders.Count == 0)">
                <i class="bi bi-file-earmark-excel"></i> ورود از اکسل
            </button>
        </div>
        <div class="card-body p-0">
            @if (ActiveProviders.Count == 0)
            {
                <div class="alert alert-warning m-3 mb-0">ابتدا یک خدمات‌دهندهٔ فعال تعریف کنید.</div>
            }
            else if (ActiveUnits.Count == 0)
            {
                <div class="alert alert-warning m-3 mb-0">ابتدا در زبانهٔ واحدها، واحدهای موردنیاز را ثبت کنید. هیچ کد رسمی از پیش حدس زده نشده است.</div>
            }
            else if (!FilteredGoods.Any())
            {
                <div class="empty-state"><i class="bi bi-box-seam"></i><h5>کالا یا خدمتی ثبت نشده است</h5></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead><tr><th>خدمات‌دهنده</th><th>نام کالا/خدمت</th><th>شناسهٔ کالا/خدمت</th><th>واحد کالا و خدمت</th><th>درصد ارزش افزوده</th><th class="text-center">قیمت واحد (ریال)</th><th>وضعیت</th><th class="text-center">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var g in FilteredGoods)
                            {
                                <tr class="@(g.IsDeleted ? "text-muted" : "")">
                                    <td>@g.ProviderName</td>
                                    <td>@g.Name</td>
                                    <td class="num" dir="ltr">@(g.UniqueIdentifier ?? "—")</td>
                                    <td>@(g.UnitName ?? g.UnitOfMeasurement)</td>
                                    <td class="num">@g.ValueAddedPercentage٪</td>
                                    <td class="text-center num fw-600">@g.Price.Money()</td>
                                    <td>@StateBadge(g.IsDeleted)</td>
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditGoods(g)"><i class="bi bi-pencil text-primary"></i></button>
                                        @if (g.IsDeleted)
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetGoodsDeleted(g, false)"><i class="bi bi-arrow-counterclockwise"></i> بازیابی</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light" title="غیرفعال‌کردن" @onclick="() => SetGoodsDeleted(g, true)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    <div class="card">
        <div class="card-header fw-bold d-flex align-items-center gap-2">
            <span>واحدهای اندازه‌گیری</span>
            <span class="badge bg-secondary">@units.Count</span>
            <button class="btn btn-sm btn-primary ms-auto" @onclick="OpenNewUnit"><i class="bi bi-plus-lg"></i> واحد جدید</button>
        </div>
        <div class="card-body p-0">
            @if (units.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-rulers"></i><h5>واحدی ثبت نشده است</h5></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle text-center mb-0">
                        <thead><tr><th>کد واحد</th><th>نام واحد</th><th>وضعیت</th><th class="text-center">عملیات</th></tr></thead>
                        <tbody>
                            @foreach (var u in units)
                            {
                                <tr class="@(u.IsDeleted ? "text-muted" : "")">
                                    <td class="num" dir="ltr">@u.Code</td>
                                    <td>@u.Name</td>
                                    <td>@StateBadge(u.IsDeleted)</td>
                                    <td class="text-center text-nowrap">
                                        <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditUnit(u)"><i class="bi bi-pencil text-primary"></i></button>
                                        @if (u.IsDeleted)
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => SetUnitDeleted(u, false)"><i class="bi bi-arrow-counterclockwise"></i> بازیابی</button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light" title="غیرفعال‌کردن" @onclick="() => SetUnitDeleted(u, true)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<Modal Visible="showProviderModal" Title="@(providerForm.Id == 0 ? "خدمات‌دهندهٔ جدید" : "ویرایش خدمات‌دهنده")" Size="modal-lg" OnClose="CloseProviderModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-4"><label class="form-label">نوع شخص</label><input class="form-control" maxlength="50" placeholder="حقوقی / حقیقی" @bind="providerForm.Type" /></div>
            <div class="col-md-4"><label class="form-label">شناسهٔ ملی <span class="text-danger">*</span></label><input class="form-control" maxlength="50" dir="ltr" @bind="providerForm.NationalId" /></div>
            <div class="col-md-4"><label class="form-label">شمارهٔ اقتصادی</label><input class="form-control" maxlength="50" dir="ltr" @bind="providerForm.EconomicNumber" /></div>
            <div class="col-md-6"><label class="form-label">نام فارسی</label><input class="form-control" maxlength="50" @bind="providerForm.PersianName" /></div>
            <div class="col-md-6"><label class="form-label">نام لاتین</label><input class="form-control" maxlength="50" dir="ltr" @bind="providerForm.EnglishName" /></div>
            <div class="col-md-6"><label class="form-label">کدپستی</label><input class="form-control" maxlength="50" dir="ltr" @bind="providerForm.PostalCode" /></div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-primary" @onclick="SaveProvider" disabled="@saving">@(saving ? "در حال ذخیره..." : "ذخیره خدمات‌دهنده")</button>
        <button class="btn btn-light" @onclick="CloseProviderModal">انصراف</button>
    </Footer>
</Modal>

<Modal Visible="showConnectionModal" Title="@(connectionForm.Id == 0 ? "اتصال جدید" : "ویرایش اتصال")" Size="modal-xl" OnClose="CloseConnectionModal">
    <ChildContent>
        <div class="position-relative">
            <div class="row g-3">
                <div class="col-12">
                    <div class="alert alert-warning py-2 small mb-0">
                        هر خدمات‌دهنده فقط یک اتصال دارد و مدیریت آن (ویرایش/حذف/غیرفعال‌سازی) فقط برای مدیر امکان‌پذیر است. نشانی وب‌سرویس فقط ذخیره می‌شود و در همین مرحله آزمون شبکه انجام نمی‌شود؛ برای بررسی ارتباط دکمهٔ «تست اتصال» را بزنید.
                        @if (connectionForm.Id == 0)
                        {
                            <span>برای ثبت اتصال، فایل کلید خصوصی .key با محتوای PKCS#8 PEM الزامی است.</span>
                        }
                        else
                        {
                            <span>اگر فایل جدید انتخاب نشود، کلید خصوصی فعلی اتصال حفظ می‌شود.</span>
                        }
                    </div>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">خدمات‌دهنده <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="connectionForm.ServiceProviderId" disabled="@(connectionBusy || connectionForm.Id != 0)">
                        <option value="0">انتخاب کنید...</option>
                        @foreach (var p in ConnectionProviderChoices)
                        {
                            <option value="@p.Id" disabled="@HasConnection(p.Id)">@ProviderTitle(p)@(HasConnection(p.Id) ? " (اتصال تعریف‌شده)" : "")</option>
                        }
                    </select>
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">نشانی وب‌سرویس خدمات‌دهنده <span class="text-danger">*</span></label>
                    <input class="form-control" maxlength="2048" dir="ltr" placeholder="https://..." @bind="connectionForm.WebServiceAddress" disabled="@connectionBusy" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label">شناسهٔ یکتای حافظهٔ مالیاتی <span class="text-danger">*</span></label>
                    <input class="form-control" maxlength="50" dir="ltr" autocomplete="off" @bind="connectionForm.TaxMemoryId" disabled="@connectionBusy" />
                </div>
                <div class="col-12">
                    <label class="form-label">فایل کلید خصوصی (پسوند .key) @if (connectionForm.Id == 0) { <span class="text-danger">*</span> }</label>
                    @if (connectionForm.HasPrivateKey)
                    {
                        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 border rounded p-2 mb-2">
                            <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemovePrivateKey" disabled="@connectionBusy">حذف کلید از اتصال</button>
                        </div>
                    }
                    else
                    {
                        <div class="small text-muted mb-2">@(connectionForm.Id == 0 ? "برای ثبت اتصال، انتخاب فایل کلید الزامی است." : "کلید خصوصی بارگذاری نشده است؛ برای تست اتصال باید ابتدا بارگذاری شود.")</div>
                    }
                    <InputFile id="moadian-private-key" class="form-control" accept=".key" OnChange="OnPrivateKeySelected" disabled="@connectionBusy" />
                    @if (selectedPrivateKeyFile is not null)
                    {
                        <div class="small mt-2">فایل انتخاب‌شده برای بارگذاری/جایگزینی: <span dir="ltr">@selectedPrivateKeyFile.Name</span> (@(selectedPrivateKeyFile.Size / 1024) KB)</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(privateKeyUploadError))
                    {
                        <div class="text-danger small mt-2">@privateKeyUploadError</div>
                    }
                </div>
            </div>
            @if (connectionBusy)
            {
                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex flex-column align-items-center justify-content-center rounded" style="background:rgba(255,255,255,.9);z-index:20;min-height:340px;">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="mt-2 fw-bold text-primary">@connectionBusyMessage</div>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-success" @onclick="SaveConnection" disabled="@connectionBusy"><i class="bi bi-save"></i> @(connectionForm.Id == 0 ? "ذخیره اتصال" : "ذخیره تغییرات")</button>
        <button type="button" class="btn btn-light" @onclick="CloseConnectionModal" disabled="@connectionBusy">انصراف</button>
    </Footer>
</Modal>

