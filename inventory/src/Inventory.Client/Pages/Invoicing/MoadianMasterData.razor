    // ================== تست اتصال و احراز هویت خدمات‌دهنده ==================
    private async Task TestConnection(MoadianProviderConnectionProfileDto c)
    {
        if (testBusy) return;
        testBusy = true;
        testBusyConnectionId = c.Id;
        testConnectionId = c.Id;
        testConnectionTitle = c.ProviderName;
        testResult = null;
        testResultError = null;
        showTestModal = true;
        try
        {
            testResult = await MoadianMasterDataSvc.TestConnectionAsync(c.Id);
        }
        catch (Exception ex)
        {
            testResultError = ex.Message;
            Toast.Error($"تست اتصال انجام نشد: {ex.Message}");
        }
        finally
        {
            testBusy = false;
            testBusyConnectionId = 0;
            await ReloadConnectionsAsync();
        }
    }

    private async Task RerunTest()
    {
        var connection = connections.FirstOrDefault(x => x.Id == testConnectionId);
        if (connection is null) return;
        await TestConnection(connection);
    }

    private void CloseTestModal()
    {
        showTestModal = false;
        testResult = null;
        testResultError = null;
        testBusy = false;
    }

    private async Task ReloadConnectionsAsync()
    {
        try { connections = await MoadianMasterDataSvc.GetConnectionsAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static string Shorten(string value, int max)
        => value.Length <= max ? value : value[..max] + "…";

    private int DefaultProviderId()
        => providerFilter != 0 && ActiveProviders.Any(p => p.Id == providerFilter)
            ? providerFilter
            : ActiveProviders.FirstOrDefault()?.Id ?? 0;

    private Task<bool> Confirm(string message) => JS.InvokeAsync<bool>("confirm", message).AsTask();
