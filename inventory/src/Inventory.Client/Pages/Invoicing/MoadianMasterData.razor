    /// <summary>حذف قطعی اتصال همراه با فایل کلید خصوصی؛ قابل بازگردانی نیست.</summary>
    private async Task DeleteConnectionPermanently(MoadianProviderConnectionProfileDto c)
    {
        var hasKey = c.HasPrivateKey;
        var message = $"اتصال «{c.ProviderName}» برای همیشه حذف شود؟"
                      + (hasKey ? "\nفایل کلید خصوصی ذخیره‌شدهٔ این اتصال هم از سرور پاک می‌شود و بازگردانی ممکن نیست." : "")
                      + (c.LastTestAt is not null ? "\nسابقهٔ آخرین تست اتصال نیز حذف می‌شود." : "");
        if (!await JS.InvokeAsync<bool>("confirm", message)) return;

        saving = true;
        try
        {
            await MoadianMasterDataSvc.DeleteConnectionPermanentlyAsync(c.Id);
            Toast.Success("اتصال و فایل کلید آن حذف شد.");
            if (providerFilter != 0 && !connections.Any(x => x.Id != c.Id && x.ServiceProviderId == providerFilter))
                providerFilter = 0;
            await LoadAll();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

