    private void OnGoodsFileSelected(InputFileChangeEventArgs e) => goodsImportFile = e.File;

    private async Task DownloadGoodsTemplate()
    {
        if (downloadingTemplate) return;
        downloadingTemplate = true;
        try
        {
            var (data, fileName, contentType) = await MoadianMasterDataSvc.DownloadGoodsOrServicesTemplateAsync();
            if (data is null || data.Length == 0) { Toast.Error("فایل نمونه خالی برگشت."); return; }
            if (string.IsNullOrWhiteSpace(fileName) || !fileName.EndsWith(".xlsx", StringComparison.OrdinalIgnoreCase))
                fileName = "Moadian-GoodsOrServices-Template.xlsx";

            var ok = await JS.InvokeAsync<bool>("downloadBlob", fileName, contentType, Convert.ToBase64String(data));
            if (ok) Toast.Success("فایل نمونهٔ اکسل دانلود شد.");
            else Toast.Error("دانلود فایل انجام نشد. مسدودکنندهٔ پاپ‌آپ را بررسی کنید.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { downloadingTemplate = false; }
    }

    private async Task DoGoodsImport()
    {
        if (goodsImportFile is null) return;
        goodsImporting = true;
        try
        {
            await using var stream = goodsImportFile.OpenReadStream(maxAllowedSize: 10 * 1024 * 1024);
            goodsImportResult = await MoadianMasterDataSvc.ImportGoodsOrServicesAsync(stream, goodsImportFile.Name);
            if (goodsImportResult.Failed == 0)
                Toast.Success($"{goodsImportResult.Imported} کالا/خدمت از اکسل ثبت شد.");
            else
                Toast.Info($"{goodsImportResult.Imported} سطر ثبت و {goodsImportResult.Failed} سطر رد شد؛ جزئیات خطاها در همان پنجره آمده است.");
            await LoadAll();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { goodsImporting = false; }
    }
