            بارگذاری و ثبت
        </button>
        <button class="btn btn-light" @onclick="CloseGoodsImport">بستن</button>
    </Footer>
</Modal>

@code {
    private int tab = 1;
    private const long MaxPrivateKeyFileSize = 64L * 1024L;
    private bool loading = true;
    private bool saving;
    private bool connectionBusy;
    private string connectionBusyMessage = "";
    private int providerFilter;
    private IBrowserFile? selectedPrivateKeyFile;
    private string? privateKeyUploadError;

    private List<MoadianServiceProviderProfileDto> providers = new();
    private List<MoadianProviderConnectionProfileDto> connections = new();
    private List<MoadianCustomerProfileDto> customers = new();
    private List<MoadianGoodsOrServiceProfileDto> goods = new();
    private List<MoadianUnitOfMeasurementDto> units = new();

    private MoadianServiceProviderProfileDto providerForm = new();
    private MoadianProviderConnectionProfileDto connectionForm = new();
    private MoadianCustomerProfileDto customerForm = new();
    private MoadianGoodsOrServiceProfileDto goodsForm = new();
    private MoadianUnitOfMeasurementDto unitForm = new();

    private bool showProviderModal, showConnectionModal, showCustomerModal, showGoodsModal, showUnitModal;
    private bool showGoodsImport, goodsImporting, downloadingTemplate;
    private IBrowserFile? goodsImportFile;
    private ExcelImportResult? goodsImportResult;
    private bool showTestModal;
    private bool testBusy;
    private int testBusyConnectionId;
    private int testConnectionId;
    private string testConnectionTitle = "";
    private MoadianConnectionTestResultDto? testResult;
    private string? testResultError;

    private List<MoadianServiceProviderProfileDto> ActiveProviders => providers.Where(x => !x.IsDeleted).ToList();
    private List<MoadianUnitOfMeasurementDto> ActiveUnits => units.Where(x => !x.IsDeleted).ToList();
    private IEnumerable<MoadianProviderConnectionProfileDto> FilteredConnections => providerFilter == 0 ? connections : connections.Where(x => x.ServiceProviderId == providerFilter);
    private IEnumerable<MoadianCustomerProfileDto> FilteredCustomers => providerFilter == 0 ? customers : customers.Where(x => x.ServiceProviderId == providerFilter);
    private IEnumerable<MoadianGoodsOrServiceProfileDto> FilteredGoods => providerFilter == 0 ? goods : goods.Where(x => x.ServiceProviderId == providerFilter);
    private IEnumerable<MoadianServiceProviderProfileDto> ConnectionProviderChoices => ActiveProviders;

    protected override async Task OnInitializedAsync() => await LoadAll();

    private async Task LoadAll()
    {
        loading = true;
        try
        {
            var providersTask = MoadianMasterDataSvc.GetProvidersAsync();
            var connectionsTask = MoadianMasterDataSvc.GetConnectionsAsync();
            var customersTask = MoadianMasterDataSvc.GetCustomersAsync();
            var goodsTask = MoadianMasterDataSvc.GetGoodsOrServicesAsync();
            var unitsTask = MoadianMasterDataSvc.GetUnitsAsync();
            await Task.WhenAll(providersTask, connectionsTask, customersTask, goodsTask, unitsTask);
            providers = await providersTask;
            connections = await connectionsTask;
            customers = await customersTask;
            goods = await goodsTask;
            units = await unitsTask;
            if (providerFilter != 0 && !providers.Any(x => x.Id == providerFilter && !x.IsDeleted))
                providerFilter = 0;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private static string ProviderTitle(MoadianServiceProviderProfileDto p)
        => p.PersianName ?? p.EnglishName ?? p.NationalId;

    private bool ProviderIsDeleted(int id) => providers.Any(x => x.Id == id && x.IsDeleted);

    private static RenderFragment StateBadge(bool deleted) => builder =>
    {
        builder.OpenElement(0, "span");
        builder.AddAttribute(1, "class", deleted ? "badge bg-secondary" : "badge bg-success");
        builder.AddContent(2, deleted ? "غیرفعال" : "فعال");
        builder.CloseElement();
    };

    // CPInfo form
    private void OpenNewProvider() { providerForm = new(); showProviderModal = true; }
    private void OpenEditProvider(MoadianServiceProviderProfileDto p)
    {
        providerForm = new MoadianServiceProviderProfileDto
        {
            Id = p.Id, Type = p.Type, EconomicNumber = p.EconomicNumber,
            PersianName = p.PersianName, EnglishName = p.EnglishName, NationalId = p.NationalId,
            PostalCode = p.PostalCode, IsDeleted = p.IsDeleted
        };
        showProviderModal = true;
    }

    private async Task SaveProvider()
    {
        if (string.IsNullOrWhiteSpace(providerForm.NationalId)) { Toast.Error("شناسهٔ ملی خدمات‌دهنده الزامی است."); return; }
        if (string.IsNullOrWhiteSpace(providerForm.PersianName) && string.IsNullOrWhiteSpace(providerForm.EnglishName)) { Toast.Error("حداقل یکی از «نام فارسی» یا «نام لاتین» خدمات‌دهنده را وارد کنید."); return; }
        saving = true;
        try
        {
            if (providerForm.Id == 0) await MoadianMasterDataSvc.CreateProviderAsync(providerForm);
            else await MoadianMasterDataSvc.UpdateProviderAsync(providerForm.Id, providerForm);
            showProviderModal = false;
            Toast.Success("CPInfo خدمات‌دهنده ذخیره شد.");
            await LoadAll();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }
    private void CloseProviderModal() => showProviderModal = false;

    // ConnectInfo form — هر خدمات‌دهنده فقط یک اتصال دارد
    private bool HasConnection(int providerId) => connections.Any(c => c.ServiceProviderId == providerId);

    private void OpenNewConnection()
    {
        var candidates = ActiveProviders.Where(p => !HasConnection(p.Id)).ToList();
        var selected = candidates.FirstOrDefault(p => p.Id == providerFilter) ?? candidates.FirstOrDefault();
        connectionForm = new MoadianProviderConnectionProfileDto { ServiceProviderId = selected?.Id ?? 0 };
        selectedPrivateKeyFile = null;
        privateKeyUploadError = null;
        showConnectionModal = true;
    }

    private void OpenEditConnection(MoadianProviderConnectionProfileDto c)
    {
        if (!Auth.IsAdmin) return;
        connectionForm = new MoadianProviderConnectionProfileDto
        {
            Id = c.Id, ServiceProviderId = c.ServiceProviderId, ProviderName = c.ProviderName,
            WebServiceAddress = c.WebServiceAddress,
            TaxMemoryId = c.TaxMemoryId,
            HasPrivateKey = c.HasPrivateKey, IsDeleted = c.IsDeleted
        };
        selectedPrivateKeyFile = null;
        privateKeyUploadError = null;
        showConnectionModal = true;
    }

    private bool ValidateConnectionForm()
    {
        if (connectionForm.ServiceProviderId <= 0) { Toast.Error("خدمات‌دهنده را انتخاب کنید."); return false; }
        if (connectionForm.Id == 0 && HasConnection(connectionForm.ServiceProviderId))
        { Toast.Error("برای این خدمات‌دهنده از قبل اتصال تعریف شده است؛ اتصال موجود را ویرایش کنید."); return false; }
        if (string.IsNullOrWhiteSpace(connectionForm.WebServiceAddress)
            || !Uri.TryCreate(connectionForm.WebServiceAddress.Trim(), UriKind.Absolute, out var address)
            || address.Scheme != Uri.UriSchemeHttps
            || !string.IsNullOrEmpty(address.UserInfo)
            || !string.IsNullOrEmpty(address.Query)
            || !string.IsNullOrEmpty(address.Fragment))
        { Toast.Error("آدرس وب‌سایت باید HTTPS معتبر و بدون credentials، query یا fragment باشد."); return false; }
        if (string.IsNullOrWhiteSpace(connectionForm.TaxMemoryId)) { Toast.Error("شناسهٔ یکتای حافظهٔ مالیاتی الزامی است."); return false; }
        if (!string.IsNullOrWhiteSpace(privateKeyUploadError)) { Toast.Error(privateKeyUploadError); return false; }
        if (selectedPrivateKeyFile is null && !connectionForm.HasPrivateKey)
        { Toast.Error("فایل کلید خصوصی .key با محتوای PKCS#8 PEM الزامی است."); return false; }
        return true;
    }

    private async Task SaveConnection()
    {
        if (!ValidateConnectionForm()) return;
        connectionBusy = true;
        connectionBusyMessage = "در حال ذخیرهٔ اتصال و فایل کلید...";
        var isNew = connectionForm.Id == 0;
        try
        {
            connectionForm = isNew
                ? await MoadianMasterDataSvc.CreateConnectionAsync(connectionForm)
                : await MoadianMasterDataSvc.UpdateConnectionAsync(connectionForm.Id, connectionForm);

            if (selectedPrivateKeyFile is not null)
            {
                var file = selectedPrivateKeyFile;
                await using var stream = file.OpenReadStream(MaxPrivateKeyFileSize);
                var status = await MoadianMasterDataSvc.UploadPrivateKeyAsync(
                    connectionForm.Id, stream, file.Name, "application/octet-stream");
                connectionForm.HasPrivateKey = status.HasPrivateKey;
                selectedPrivateKeyFile = null;
                privateKeyUploadError = null;
            }

            if (!connectionForm.HasPrivateKey)
            {
                // ساخت اتصال بدون کلید معنادار نیست؛ ردیف تازه‌ساخته حذف می‌شود.
                if (isNew) await MoadianMasterDataSvc.DeleteConnectionPermanentlyAsync(connectionForm.Id);
                throw new InvalidOperationException("فایل کلید خصوصی بارگذاری نشده است؛ اتصال ذخیره نشد.");
            }

            CloseConnectionModal();
            Toast.Success(isNew ? "اتصال خدمات‌دهنده ذخیره شد." : "تغییرات اتصال ذخیره شد.");
            await LoadAll();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
            await LoadAll();
        }
        finally { connectionBusy = false; }
    }

    private Task OnPrivateKeySelected(InputFileChangeEventArgs args)
    {
        selectedPrivateKeyFile = null;
        privateKeyUploadError = null;
        try
        {
            var file = args.GetMultipleFiles(1).FirstOrDefault();
            if (file is null) return Task.CompletedTask;
            if (!string.Equals(Path.GetExtension(file.Name), ".key", StringComparison.OrdinalIgnoreCase))
                privateKeyUploadError = "فقط فایل کلید خصوصی با پسوند .key انتخاب کنید؛ محتوای آن باید PKCS#8 PEM باشد.";
            else if (file.Size is <= 0 or > MaxPrivateKeyFileSize)
                privateKeyUploadError = "اندازهٔ فایل باید بین ۱ بایت و ۶۴ کیلوبایت باشد.";
            else
                selectedPrivateKeyFile = file;
        }
        catch (InvalidOperationException)
        {
            privateKeyUploadError = "فقط یک فایل PEM برای هر اتصال انتخاب کنید.";
        }
        return Task.CompletedTask;
    }

    private async Task RemovePrivateKey()
    {
        if (connectionForm.Id <= 0 || !connectionForm.HasPrivateKey) return;
        if (!await Confirm("ارجاع کلید خصوصی از این اتصال حذف شود؟ فایل‌های همین ذخیره‌گاهِ مدیریت‌شده که از این فرم بارگذاری شده‌اند از سرور پاک می‌شوند؛ فایل‌های قدیمی یا خارج از مسیر مدیریت‌شده دست‌نخورده می‌مانند.")) return;
        connectionBusy = true;
        connectionBusyMessage = "در حال حذف کلید از ذخیره‌گاه خصوصی...";
        try
        {
            var status = await MoadianMasterDataSvc.RemovePrivateKeyAsync(connectionForm.Id);
            connectionForm.HasPrivateKey = status.HasPrivateKey;
            selectedPrivateKeyFile = null;
            privateKeyUploadError = null;
            Toast.Success("کلید از اتصال حذف شد.");
            await LoadAll();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { connectionBusy = false; }
    }

