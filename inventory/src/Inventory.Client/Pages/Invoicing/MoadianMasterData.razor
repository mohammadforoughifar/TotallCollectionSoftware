<Modal Visible="showTestModal" Title="@($"تست اتصال — {testConnectionTitle}")" Size="modal-lg" OnClose="CloseTestModal">
    <ChildContent>
        @if (testBusy)
        {
            <div class="text-center py-4">
                <span class="spinner-border text-primary"></span>
                <div class="mt-2 fw-bold text-primary">در حال برقراری ارتباط با سامانه و بررسی احراز هویت...</div>
            </div>
        }
        else if (!string.IsNullOrWhiteSpace(testResultError))
        {
            <div class="alert alert-danger py-2 mb-0">@testResultError</div>
        }
        else if (testResult is not null)
        {
            <div class="alert @(testResult.Success ? "alert-success" : "alert-danger") py-2">
                <div class="fw-bold">
                    @if (testResult.Success)
                    {
                        <i class="bi bi-check-circle"></i> <span>ارتباط برقرار است و احراز هویت معتبر است.</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle"></i> <span>تست ناموفق بود.</span>
                    }
                </div>
                <div class="small mt-1">@testResult.Message</div>
            </div>

            <table class="table table-sm align-middle text-center">
                <thead><tr><th>گام</th><th>وضعیت</th><th>توضیح</th><th>زمان (ms)</th></tr></thead>
                <tbody>
                    @foreach (var step in testResult.Steps)
                    {
                        <tr>
                            <td class="small">@step.Title</td>
                            <td class="text-nowrap">
                                <span class="badge @(step.Ok ? "bg-success" : "bg-danger")">@(step.Ok ? "موفق" : "ناموفق")</span>
                                @if (step.HttpStatus is not null) { <span class="badge bg-light text-dark num">HTTP @step.HttpStatus</span> }
                            </td>
                            <td class="small">@step.Detail</td>
                            <td class="num small">@step.DurationMs</td>
                        </tr>
                    }
                </tbody>
            </table>

            <div class="row g-2 small">
                <div class="col-md-6"><span class="text-muted">آدرس پایهٔ تست‌شده: </span><span dir="ltr">@testResult.BaseUrl</span></div>
                <div class="col-md-3"><span class="text-muted">نوع مؤدی: </span>@testResult.ClientType</div>
                <div class="col-md-3"><span class="text-muted">نسخهٔ API: </span>@testResult.ApiVersion</div>
                <div class="col-md-6"><span class="text-muted">شناسهٔ احراز هویت‌شده (@testResult.IdentityField): </span><span dir="ltr" class="num">@testResult.ClientIdUsed</span></div>
                <div class="col-md-3"><span class="text-muted">شناسهٔ حافظهٔ مالیاتی: </span><span dir="ltr" class="num">@testResult.TaxMemoryId</span></div>
                <div class="col-md-3"><span class="text-muted">زمان کل: </span><span class="num">@testResult.DurationMs ms</span></div>
                @if (!string.IsNullOrWhiteSpace(testResult.TaxpayerName))
                {
                    <div class="col-md-6"><span class="text-muted">نام تجاری: </span>@testResult.TaxpayerName</div>
                    <div class="col-md-3"><span class="text-muted">وضعیت مؤدی: </span>@testResult.FiscalStatus</div>
                }
                @if (!string.IsNullOrWhiteSpace(testResult.PublicKeyId))
                {
                    <div class="col-md-12"><span class="text-muted">شناسهٔ کلید عمومی سازمان مالیاتی: </span><span dir="ltr" class="num">@testResult.PublicKeyId</span></div>
                }
            </div>

            @if (testResult.Endpoints.Count > 0)
            {
                <details class="mt-2">
                    <summary class="small text-muted">آدرس سرویس‌های فراخوانی‌شده</summary>
                    <ul class="small mb-0" dir="ltr">
                        @foreach (var endpoint in testResult.Endpoints) { <li>@endpoint</li> }
                    </ul>
                </details>
            }

        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseTestModal" disabled="@testBusy">بستن</button>
        <button class="btn btn-primary" @onclick="RerunTest" disabled="@(testBusy || testConnectionId <= 0)">
            @if (testBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-arrow-repeat"></i> تست مجدد
        </button>
    </Footer>
</Modal>

<Modal Visible="showGoodsImport" Title="ورود گروهی کالا و خدمت از اکسل" Size="modal-lg" OnClose="CloseGoodsImport">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <div class="alert alert-info fs-8 mb-0">
                    <i class="bi bi-info-circle ms-1"></i>
                    ابتدا
