@namespace Inventory.Client.Pages
@page "/fa-com/my"
@inject IFaComService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>تیکت‌های من</PageTitle>

<div class="page-head mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="bi bi-inbox"></i> تیکت‌های من</h1>
            <div class="lead">گفتگو با واحد منابع انسانی (مرخصی، حقوق، بیمه، قرارداد، آموزش)</div>
        </div>
        @if (faCreate)
        {
            <button class="btn btn-success" @onclick="() => showNew = true"><i class="bi bi-plus-lg"></i> تیکت جدید</button>
        }
    </div>
</div>

@if (!faRead)
{
    <div class="alert alert-warning">به این بخش دسترسی ندارید.</div>
    return;
}

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>موضوع</th>
                        <th>دسته</th>
                        <th>اولویت</th>
                        <th>وضعیت</th>
                        <th class="text-center">پاسخ‌ها</th>
                        <th>تاریخ ثبت</th>
                        <th style="width:90px">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var t in rows)
                    {
                        <tr>
                            <td><strong>@t.Subject</strong></td>
                            <td>@FaComUi.Category(t.Category)</td>
                            <td><span class="badge @FaComUi.PriorityBadge(t.Priority)">@FaComUi.Priority(t.Priority)</span></td>
                            <td><span class="badge @FaComUi.StatusBadge(t.Status)">@FaComUi.TicketStatus(t.Status)</span></td>
                            <td class="text-center">@Fa.Digits(t.RepliesCount.ToString())</td>
                            <td class="small num">@FaComUi.Dt(t.CreatedAt)</td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary" title="مشاهده و گفتگو" @onclick="() => Go(t.Id)"><i class="bi bi-eye"></i></button>
                            </td>
                        </tr>
                    }
                    @if (rows.Count == 0)
                    {
                        <tr><td colspan="7" class="text-center text-muted py-4">تیکتی ثبت نکرده‌اید.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<Modal Visible="showNew" Title="تیکت جدید" Size="modal-lg" OnClose="() => showNew = false">
    <ChildContent>
    <div class="row g-2">
        <div class="col-12"><label class="form-label">موضوع</label><input class="form-control" @bind="form.Subject" /></div>
        <div class="col-md-6">
            <label class="form-label">دسته</label>
            <select class="form-select" @bind="form.Category">
                @for (int c = 0; c <= 5; c++)
                {
                    <option value="@c">@FaComUi.Category(c)</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">اولویت</label>
            <select class="form-select" @bind="form.Priority">
                @for (int p = 0; p <= 2; p++)
                {
                    <option value="@p">@FaComUi.Priority(p)</option>
                }
            </select>
        </div>
        <div class="col-12"><label class="form-label">متن درخواست</label><textarea class="form-control" rows="4" @bind="form.Body"></textarea></div>
    </div>
    </ChildContent>
    <Footer>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-secondary" @onclick="() => showNew = false">انصراف</button>
        <button class="btn btn-success" @onclick="Save"><i class="bi bi-check-lg"></i> ثبت تیکت</button>
    </div>
    </Footer>
</Modal>

@code {
    private bool faRead => Auth.Has("FaCom.Read") || Auth.Has("FaCom.Manage") || Auth.IsAdmin;
    private bool faCreate => Auth.Has("FaCom.Create") || Auth.Has("FaCom.Manage") || Auth.IsAdmin;
    private bool loading = true;
    private List<FaComTicketDto> rows = new();
    private bool showNew;
    private FaComTicketSaveDto form = new() { Priority = 1 };

    protected override async Task OnInitializedAsync()
    {
        if (!faRead) { loading = false; return; }
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try { rows = await Svc.GetMyTicketsAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        loading = false;
    }

    private void Go(int id) => Nav.NavigateTo(FaComUi.MyTicketUrl(id));

    private async Task Save()
    {
        try
        {
            var t = await Svc.CreateMyTicketAsync(form);
            showNew = false;
            form = new FaComTicketSaveDto { Priority = 1 };
            Toast.Success("تیکت ثبت شد.");
            Nav.NavigateTo(FaComUi.MyTicketUrl(t.Id));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
