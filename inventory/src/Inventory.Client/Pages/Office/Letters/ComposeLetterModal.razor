@inject ILetterService LetterSvc
@inject IToastService Toast

@* ============================================================
   فرم ایجاد نامه — شیت کناری مطابق طرح مصوب (پروتوتایپ نسخه ۶):
   • گیرنده (الزامی) / ارجاع / هامش — هرکدام انفرادی|گروهی با کمبوباکس
   • فوریت و محرمانگی رادیویی
   • ادیتور متن غنی
   • پیوست: دراپ‌زون — بدون محدودیت تعداد، هر فایل ≤۲۰MB، فایل خالی رد می‌شود
   • عطف/پیرو با مودال انتخاب از نامه‌های دریافتی/ارسالی
   • ذخیره پیش‌نویس + ادامه پیش‌نویس + ویرایش نامه (قبل از خوانده‌شدن)
   ============================================================ *@

@if (visible)
{
@* استایل inline: انیمیشن/ترنسفورم والد را خنثی می‌کند تا position:fixed نسبت به ویوپورت بماند *@
<div class="ltx" style="animation:none;transform:none">
    <div class="ov" @onclick="Close"></div>
    <div class="sheet" @onclick="CloseCombos">
        <div class="sheet-h">
            <b><i class="bi bi-envelope-plus" style="color:var(--p2)"></i> @SheetTitle</b>
            <span class="dt"><i class="bi bi-calendar3"></i> @DateTime.Now.ToFa()</span>
            <button class="x" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="sheet-b">

            <div class="row3">
                <LetterPickCombo @ref="cbRcv" Label="گیرنده" Icon="bi-person-plus" Required="true"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="rcvUsers" SelectedGroups="rcvGroups"
                                 HasError="errRcv" Changed="OnRcvChanged" />
                <LetterPickCombo @ref="cbErja" Label="ارجاع" Icon="bi-arrow-left-circle"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="erjaUsers" SelectedGroups="erjaGroups" />
                <LetterPickCombo @ref="cbHamesh" Label="هامش (رونوشت)" Icon="bi-people"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="hameshUsers" SelectedGroups="hameshGroups" />
            </div>

            <div class="row2">
                <div class="fcard">
                    <label>فوریت نامه</label>
                    <div class="rads">
                        @foreach (var f in new[] { "عادی", "فوری", "آنی" })
                        {
                            var v = f;
                            <div class="rad @(foriat == v ? "on" : "")" @onclick="() => foriat = v"><span class="rdot"></span> @v</div>
                        }
                    </div>
                </div>
                <div class="fcard">
                    <label>محرمانگی نامه</label>
                    <div class="rads">
                        @foreach (var m in new[] { "عادی", "محرمانه", "سری" })
                        {
                            var v = m;
                            <div class="rad @(mahram == v ? "on" : "")" @onclick="() => mahram = v"><span class="rdot"></span> @v</div>
                        }
                    </div>
                </div>
            </div>

            <div class="fcard @(errTitle ? "err" : "")">
                <label>عنوان نامه <span class="req">*</span></label>
                <input class="tin" placeholder="عنوان نامه را وارد کنید…" @bind="title" @bind:event="oninput" />
                @if (errTitle)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> عنوان نامه الزامی است</div>
                }
            </div>

            <div class="fcard">
                <label>متن نامه</label>
                <RichTextEditor @ref="_rich" Id="ltxEditor" Placeholder="متن نامه را بنویسید…"
                                @bind-Value="pendingBody" Height="260" />
            </div>

                <div class="fcard">
                    <label>پیوست</label>
                    <div class="dz">
                        <div class="ic"><i class="bi bi-cloud-arrow-up"></i></div>
                        <div><b>فایل را بکشید و رها کنید یا کلیک کنید</b><small>بدون محدودیت تعداد — هر فایل حداکثر ۲۰ مگابایت</small></div>
                        <InputFile OnChange="OnFiles" multiple />
                    </div>
                    <div class="selpills">
                        @foreach (var f in pendingFiles)
                        {
                            var ff = f;
                            <span class="spill"><i class="bi @FileIcon(ff.Name)"></i> @ff.Name <small>(@FmtSize(ff.Size))</small> <i class="bi bi-x-lg" @onclick="() => pendingFiles.Remove(ff)"></i></span>
                        }
                        @foreach (var a in savedAtts)
                        {
                            var aa = a;
                            <span class="spill"><i class="bi @FileIcon(aa.FileName)"></i> @aa.FileName <small>(@FmtSize(aa.Size))</small> <i class="bi bi-x-lg" @onclick="() => RemoveSavedAtt(aa)"></i></span>
                        }
                    </div>
                    @if (!string.IsNullOrEmpty(fileErr))
                    {
                        <div class="ferr"><i class="bi bi-exclamation-circle"></i> @fileErr</div>
                    }
                </div>

                <div class="fcard">
                    <label>نامه‌های مرتبط (عطف / پیرو) <span class="opt">اختیاری</span></label>
                    <div class="selpills" style="margin-top:0">
                        @foreach (var r in related)
                        {
                            var rr = r;
                            <span class="rpill">
                                <span class="k @(rr.Related == 2 ? "atf" : "peyro")">@(rr.Related == 2 ? "عطف" : "پیرو")</span>
                                <span class="num"># @rr.RelateLetterNumber.FaDigits()</span> @rr.RelateLetterTitle
                                <i class="bi bi-x-lg" @onclick="() => related.Remove(rr)"></i>
                            </span>
                        }
                        <button type="button" class="addrel" @onclick="OpenRel"><i class="bi bi-plus-lg"></i> ثبت نامه مرتبط</button>
                    </div>
                </div>
        </div>
        <div class="sheet-f">
            @if (isEditLetter)
            {
                <button class="lbtn grn" disabled="@busy" @onclick="SubmitEdit">
                    @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-check-lg"></i> ذخیره تغییرات
                </button>
            }
            else
            {
                <button class="lbtn grn" disabled="@busy" @onclick="Send">
                    @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-send"></i> ارسال
                </button>
                <button class="lbtn pri" disabled="@busy" @onclick="SaveDraft"><i class="bi bi-save"></i> ذخیره بعنوان پیش‌نویس</button>
            }
            <span class="spacer"></span>
            <button class="lbtn red" @onclick="Close"><i class="bi bi-x-lg"></i> انصراف</button>
        </div>
    </div>

    @* ---------- مودال انتخاب نامه مرتبط ---------- *@
    @if (relOpen)
    {
        <div class="gov" @onclick="CloseRelIfSelf">
            <div class="gmodal" style="width:min(640px,96vw)" @onclick:stopPropagation="true">
                <div class="gm-h">
                    <div class="ttl"><b><i class="bi bi-link-45deg" style="color:var(--p2)"></i> ثبت نامه مرتبط</b><small>نوع رابطه را انتخاب و نامه‌ها را علامت بزنید</small></div>
                    <button class="x" @onclick="() => relOpen = false"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="gm-seg">
                    <button class="@(relType == 2 ? "on" : "")" @onclick="() => relType = 2"><i class="bi bi-arrow-90deg-right"></i> عطف به</button>
                    <button class="@(relType == 1 ? "on" : "")" @onclick="() => relType = 1"><i class="bi bi-arrow-return-left"></i> پیرو</button>
                </div>
                <div class="gm-b">
                    <input class="tin" style="margin-bottom:9px" placeholder="جستجوی شماره یا عنوان…"
                           @bind="relSearch" @bind:event="oninput" @bind:after="SearchRel" />
                    @foreach (var l in relResults)
                    {
                        var rl = l;
                        <div class="rl-row @(relSel.Contains(rl.LetterId) ? "on" : "")" @onclick="() => ToggleRelSel(rl.LetterId)">
                            <span class="chk"><i class="bi bi-check"></i></span>
                            <div class="inf"><b>@rl.Title</b><small class="num"># @rl.LetterNumber.FaDigits() · @rl.Date.ToFa()</small></div>
                            <span class="rl-dir @(rl.IsSent ? "out" : "in")">
                                <i class="bi @(rl.IsSent ? "bi-send" : "bi-box-arrow-in-down")"></i>
                                @(rl.IsSent ? "ارسالی" : "دریافتی")
                            </span>
                        </div>
                    }
                    @if (relResults.Count == 0) { <div class="cempty">نامه‌ای یافت نشد</div> }
                </div>
                <div class="gm-f">
                    <button class="lbtn ghost" @onclick="() => relOpen = false">انصراف</button>
                    <button class="lbtn pri" @onclick="AddRel"><i class="bi bi-check-lg"></i> افزودن نامه‌های انتخابی</button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    [Parameter] public EventCallback OnSent { get; set; }

    private const long MaxFile = 20L * 1024 * 1024; // ۲۰ مگابایت

    private bool visible;
    private bool busy;
    private bool isEditLetter;
    private int editLetterId;
    private int? draftId;

    private string title = "";
    private string foriat = "عادی";
    private string mahram = "عادی";
    private string pendingBody = "";

    private bool errTitle, errRcv;

    private List<LetterReciverDto> allUsers = new();
    private List<LetterGroupDto> allGroups = new();

    private LetterPickCombo? cbRcv, cbErja, cbHamesh;
    private RichTextEditor? _rich;
    private HashSet<int> rcvUsers = new(), rcvGroups = new();
    private HashSet<int> erjaUsers = new(), erjaGroups = new();
    private HashSet<int> hameshUsers = new(), hameshGroups = new();

    // پیوست‌ها
    private List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> pendingFiles = new();
    private List<LetterAttachmentDto> savedAtts = new(); // پیوست‌های موجود پیش‌نویس
    private string fileErr = "";

    // عطف/پیرو
    private List<RelatedLetterDto> related = new();
    private bool relOpen;
    private int relType = 2;
    private string relSearch = "";
    private List<LetterPickDto> relResults = new();
    private HashSet<int> relSel = new();

    private string SheetTitle => isEditLetter ? "ویرایش نامه" : draftId is > 0 ? "ادامه پیش‌نویس" : "ایجاد نامه جدید";

    // ==================== باز کردن ====================

    /// <summary>نامه جدید — یا از روی پیش‌نویس (title/text/pishnevisId)</summary>
    public void Open(string? prefTitle = null, string? prefText = null, int? pishnevisId = null)
    {
        ResetAll();
        title = prefTitle ?? "";
        pendingBody = prefText ?? "";
        draftId = pishnevisId;
        visible = true;
        _ = LoadListsAsync();
        if (pishnevisId is > 0) _ = LoadDraftAttsAsync(pishnevisId.Value);
        StateHasChanged();
        _ = InitEditorAsync();
    }

    /// <summary>ویرایش نامه ارسال‌شده (فقط قبل از خوانده‌شدن) — همه اطلاعات فرم ایجاد قابل ویرایش است</summary>
    public void OpenEdit(InnerLetterDetailDto letter)
    {
        ResetAll();
        isEditLetter = true;
        editLetterId = letter.LetterId;
        title = letter.Title;
        foriat = letter.Foriat;
        mahram = letter.Mahramanegi;
        pendingBody = letter.Text ?? "";

        // گیرندگان فعلی (گروه‌ها هنگام ارسال به کاربر باز شده‌اند؛ اینجا به‌صورت کاربران انفرادی می‌آیند)
        foreach (var r in letter.ReciversGirande) rcvUsers.Add(r.UserId);
        foreach (var r in letter.ReciversErja) erjaUsers.Add(r.UserId);
        foreach (var r in letter.ReciversHamesh) hameshUsers.Add(r.UserId);

        // عطف / پیرو فعلی
        related = letter.RelatedLetters.Select(r => new RelatedLetterDto
        {
            Related = r.Related,
            RelateLetterId = r.RelateLetterId,
            RelateLetterNumber = r.RelateLetterNumber,
            RelateLetterTitle = r.RelateLetterTitle
        }).ToList();

        visible = true;
        _ = LoadListsAsync();
        _ = LoadLetterAttsAsync(letter.LetterId);
        StateHasChanged();
        _ = InitEditorAsync();
    }

    private async Task LoadLetterAttsAsync(int letterId)
    {
        try { savedAtts = await LetterSvc.GetAttachmentsAsync(letterId); StateHasChanged(); }
        catch { }
    }

    private void ResetAll()
    {
        isEditLetter = false; editLetterId = 0; draftId = null;
        title = ""; foriat = "عادی"; mahram = "عادی"; pendingBody = "";
        errTitle = errRcv = false; fileErr = "";
        rcvUsers.Clear(); rcvGroups.Clear();
        erjaUsers.Clear(); erjaGroups.Clear();
        hameshUsers.Clear(); hameshGroups.Clear();
        pendingFiles.Clear(); savedAtts.Clear();
        related.Clear(); relOpen = false; relSel.Clear();
    }

    private async Task InitEditorAsync()
    {
        await Task.Delay(60); // صبر برای رندر contenteditable
        if (_rich != null) await _rich.SetContentAsync(pendingBody);
    }

    private async Task LoadListsAsync()
    {
        try
        {
            if (allUsers.Count == 0) allUsers = await LetterSvc.GetReciversAsync();
            allGroups = await LetterSvc.GetGroupsAsync();
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task LoadDraftAttsAsync(int pishId)
    {
        try { savedAtts = await LetterSvc.GetPishnevisAttachmentsAsync(pishId); StateHasChanged(); }
        catch { }
    }

    private void Close() => visible = false;

    private void CloseCombos()
    {
        cbRcv?.Close(); cbErja?.Close(); cbHamesh?.Close();
    }

    private void OnRcvChanged()
    {
        if (rcvUsers.Count + rcvGroups.Count > 0) errRcv = false;
    }

    // ==================== پیوست‌ها ====================

    private void OnFiles(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var rejected = new List<string>();
        foreach (var f in e.GetMultipleFiles(100))
        {
            if (f.Size <= 0) { rejected.Add($"{f.Name} (خالی — ۰ بایت)"); continue; }
            if (f.Size > MaxFile) { rejected.Add($"{f.Name} (بیش از ۲۰ مگابایت)"); continue; }
            if (pendingFiles.Any(x => x.Name == f.Name && x.Size == f.Size) ||
                savedAtts.Any(x => x.FileName == f.Name && x.Size == f.Size))
            { rejected.Add($"{f.Name} (تکراری)"); continue; }
            pendingFiles.Add(f);
        }
        fileErr = rejected.Count > 0 ? "این فایل‌ها پذیرفته نشدند: " + string.Join("، ", rejected) : "";
        if (rejected.Count > 0) Toast.Error("برخی فایل‌ها پذیرفته نشدند.");
    }

    private async Task RemoveSavedAtt(LetterAttachmentDto a)
    {
        try
        {
            await LetterSvc.DeleteAttachmentAsync(a.Id);
            savedAtts.Remove(a);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static string FmtSize(long b) =>
        b >= 1024 * 1024 ? $"{b / 1024.0 / 1024.0:0.#} مگابایت".FaDigits()
        : b >= 1024 ? $"{b / 1024} کیلوبایت".FaDigits()
        : $"{b} بایت".FaDigits();

    private static string FileIcon(string name)
    {
        var e = (Path.GetExtension(name) ?? "").TrimStart('.').ToLowerInvariant();
        return e switch
        {
            "pdf" => "bi-file-earmark-pdf",
            "xls" or "xlsx" or "csv" => "bi-file-earmark-excel",
            "doc" or "docx" => "bi-file-earmark-word",
            "png" or "jpg" or "jpeg" or "gif" or "webp" or "svg" => "bi-file-earmark-image",
            "zip" or "rar" or "7z" => "bi-file-earmark-zip",
            _ => "bi-file-earmark"
        };
    }

    // ==================== عطف / پیرو ====================

    private async Task OpenRel()
    {
        relSel.Clear(); relSearch = ""; relOpen = true;
        await SearchRel();
    }

    private void CloseRelIfSelf() => relOpen = false;

    private async Task SearchRel()
    {
        try
        {
            var res = await LetterSvc.PickAsync(string.IsNullOrWhiteSpace(relSearch) ? null : relSearch);
            relResults = res.Where(r => related.All(x => x.RelateLetterId != r.LetterId)).ToList();
        }
        catch { relResults = new(); }
    }

    private void ToggleRelSel(int id) { if (!relSel.Remove(id)) relSel.Add(id); }

    private void AddRel()
    {
        if (relSel.Count == 0) { Toast.Error("هیچ نامه‌ای انتخاب نشده است."); return; }
        foreach (var id in relSel)
        {
            var l = relResults.FirstOrDefault(x => x.LetterId == id);
            if (l == null) continue;
            related.Add(new RelatedLetterDto
            {
                Related = relType,
                RelateLetterId = l.LetterId,
                RelateLetterNumber = l.LetterNumber,
                RelateLetterTitle = l.Title
            });
        }
        relOpen = false;
        Toast.Success("نامه(های) مرتبط افزوده شد.");
    }

    // ==================== ارسال / پیش‌نویس / ویرایش ====================

    private async Task<string> EditorHtmlAsync()
    {
        if (_rich != null) return await _rich.GetContentAsync();
        return pendingBody;
    }

    private bool Validate()
    {
        errTitle = string.IsNullOrWhiteSpace(title);
        errRcv = rcvUsers.Count + rcvGroups.Count == 0;
        if (errTitle || errRcv) { Toast.Error("موارد الزامی را تکمیل کنید."); return false; }
        return true;
    }

    private async Task Send()
    {
        if (!Validate()) return;
        busy = true;
        try
        {
            var dto = new AddInnerLetterDto
            {
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                Foriat = foriat,
                Mahramanegi = mahram,
                ReciversGirande = rcvUsers.ToList(),
                GroupsGirande = rcvGroups.ToList(),
                ReciversErja = erjaUsers.ToList(),
                GroupsErja = erjaGroups.ToList(),
                ReciversHamesh = hameshUsers.ToList(),
                GroupsHamesh = hameshGroups.ToList(),
                RelatedLetters = related,
                FromPishnevisId = draftId
            };
            var letterId = await LetterSvc.SendAsync(dto);

            // آپلود پیوست‌های جدید روی نامه ارسال‌شده
            await UploadPendingAsync(id => LetterSvc.UploadAttachmentAsync(letterId, id.stream, id.name, id.type));

            Toast.Success("نامه با موفقیت ارسال شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SaveDraft()
    {
        if (string.IsNullOrWhiteSpace(title)) { errTitle = true; Toast.Error("برای ذخیره پیش‌نویس، عنوان لازم است."); return; }
        busy = true;
        try
        {
            var id = await LetterSvc.SavePishnevisAsync(new PishnevisDto
            {
                PishnevisId = draftId ?? 0,
                Title = title.Trim(),
                Text = await EditorHtmlAsync()
            });
            await UploadPendingAsync(x => LetterSvc.UploadPishnevisAttachmentAsync(id, x.stream, x.name, x.type));
            Toast.Success("پیش‌نویس ذخیره شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SubmitEdit()
    {
        if (!Validate()) return;
        busy = true;
        try
        {
            await LetterSvc.EditAsync(editLetterId, new EditInnerLetterDto
            {
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                Foriat = foriat,
                Mahramanegi = mahram,
                ReciversGirande = rcvUsers.ToList(),
                GroupsGirande = rcvGroups.ToList(),
                ReciversErja = erjaUsers.ToList(),
                GroupsErja = erjaGroups.ToList(),
                ReciversHamesh = hameshUsers.ToList(),
                GroupsHamesh = hameshGroups.ToList(),
                RelatedLetters = related
            });

            // آپلود پیوست‌های تازه‌افزوده روی نامه
            await UploadPendingAsync(x => LetterSvc.UploadAttachmentAsync(editLetterId, x.stream, x.name, x.type));

            Toast.Success("نامه ویرایش شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task UploadPendingAsync(Func<(Stream stream, string name, string type), Task> uploader)
    {
        foreach (var f in pendingFiles)
        {
            try
            {
                await using var s = f.OpenReadStream(MaxFile);
                await uploader((s, f.Name, f.ContentType));
            }
            catch (Exception ex) { Toast.Error($"بارگذاری {f.Name}: {ex.Message}"); }
        }
        pendingFiles.Clear();
    }
}
