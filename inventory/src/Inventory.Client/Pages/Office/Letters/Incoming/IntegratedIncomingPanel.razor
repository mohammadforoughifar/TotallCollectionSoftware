@using Inventory.Shared.Dtos
@inject IIncomingLetterService IncomingSvc
@inject IAuthState Auth
@inject IToastService Toast

<div class="integrated-incoming-panel">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h3 class="mb-1"><i class="bi bi-inbox-fill text-primary me-2"></i>نامه‌های وارده</h3>
            <small class="text-muted">ثبت‌شده‌ها و بایگانی‌شده‌های دبیرخانه</small>
        </div>
        @if (CanRegister)
        {
            <button class="btn btn-primary" @onclick="OpenCreate">
                <i class="bi bi-plus-lg me-1"></i> ثبت نامه وارده جدید
            </button>
        }
    </div>

    <div class="btn-group mb-3" role="group">
        <button class="btn @(view == "registered" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetView("registered")'>
            <i class="bi bi-check2-circle me-1"></i> ثبت‌شده‌ها <span class="badge bg-light text-dark ms-1">@registeredTotal.FaDigits()</span>
        </button>
        <button class="btn @(view == "archived" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetView("archived")'>
            <i class="bi bi-archive me-1"></i> بایگانی‌شده‌ها <span class="badge bg-light text-dark ms-1">@archivedTotal.FaDigits()</span>
        </button>
    </div>

    @if (loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (items.Count == 0)
    {
        <div class="alert alert-light border text-center py-5">نامه‌ای در این بخش ثبت نشده است.</div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var l in items)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between gap-2 mb-2">
                                <span class="badge text-bg-primary"># @l.NumberSabt.FaDigits()</span>
                                <small class="text-muted">@l.DateErsal.ToFaDate()</small>
                            </div>
                            <h5 class="card-title text-truncate" title="@l.Title">@l.Title</h5>
                            <div class="small text-muted mb-2"><i class="bi bi-person me-1"></i>فرستنده: @l.Ferestande</div>
                            @if (!string.IsNullOrWhiteSpace(l.NumberLetterVarede))
                            {
                                <div class="small text-muted">شماره مبدأ: @l.NumberLetterVarede</div>
                            }
                        </div>
                        <div class="card-footer bg-transparent border-0 pt-0">
                            <span class="badge @(view == "archived" ? "text-bg-secondary" : "text-bg-success")">
                                <i class="bi @(view == "archived" ? "bi-archive" : "bi-check2") me-1"></i>@(view == "archived" ? "بایگانی‌شده" : "ثبت‌شده")
                            </span>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<ComposeIncomingModal @ref="compose" OnSaved="ReloadAsync" />

@code {
    private string view = "registered";
    private bool loading;
    private List<IncomingLetterListItemDto> items = new();
    private int registeredTotal;
    private int archivedTotal;
    private ComposeIncomingModal? compose;
    private bool CanRegister => Auth.Has("IncomingLetters.Dabirkhane") || Auth.Has("OutgoingLetters.Dabirkhane") || Auth.Has("Admin");

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private void OpenCreate() => compose?.OpenCreate();

    private async Task SetView(string value)
    {
        view = value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            var registered = await IncomingSvc.GetSentAsync(null, 1, 12);
            var archived = await IncomingSvc.GetArchiveAsync(null, 1, 12);
            registeredTotal = registered.TotalCount;
            archivedTotal = archived.TotalCount;
            items = view == "archived" ? archived.Items : registered.Items;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }
}
