@page "/incoming-letters"
@page "/office/incoming-letters"
@inject IIncomingLetterService IncomingSvc
@inject ILetterService LetterSvc
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

@* ============================================================
   کارتابل نامه وارده — طرح اتوماسیون اداری (هم‌طراز با نامه داخلی)
   ریل پوشه‌ها | لیست نامه‌ها با چیپ فیلتر | پانل خواندن و ارجاع
   ============================================================ *@

<PageTitle>کارتابل نامه وارده — اتوماسیون اداری</PageTitle>

<div class="ltx @(readerOpen ? "rd-open" : "")" style="animation:none;transform:none">
    <div class="shell" @onclick="CloseMenus">

        @* ---------- ریل پوشه‌ها (Folder Rail) ---------- *@
        <nav class="rail">
            <div class="logo" title="اتوماسیون اداری — نامه وارده"><i class="bi bi-inbox-fill"></i></div>
            <div style="height:8px"></div>

            <button class="@(folder == "inbox" ? "on" : "")" title="دریافتی (کارتابل جاری)" @onclick='() => SetFolder("inbox")'>
                <i class="bi bi-inbox-fill"></i>
                @if (stats.InboxUnread > 0) { <span class="rbadge">@stats.InboxUnread.FaDigits()</span> }
            </button>
            <span class="rlbl">دریافتی</span>

            <button class="@(folder == "sent" ? "on" : "")" title="ثبت‌شده‌ها" @onclick='() => SetFolder("sent")'>
                <i class="bi bi-send-check-fill"></i>
            </button>
            <span class="rlbl">ثبت‌شده</span>

            <button class="@(folder == "starred" ? "on" : "")" title="نشان‌شده" @onclick='() => SetFolder("starred")'>
                <i class="bi bi-star-fill"></i>
            </button>
            <span class="rlbl">نشان‌شده</span>

            <button class="@(folder == "archive" ? "on" : "")" title="بایگانی" @onclick='() => SetFolder("archive")'>
                <i class="bi bi-archive-fill"></i>
            </button>
            <span class="rlbl">بایگانی</span>

            <div class="grow"></div>
            @if (CanDabirkhane)
            {
                <button title="رزرو شماره اندیکاتور" @onclick="OpenReservationManager"><i class="bi bi-hash"></i></button>
                <span class="rlbl">رزرو شماره</span>
            }
            <button title="بروزرسانی" @onclick="ReloadDataAsync"><i class="bi bi-arrow-clockwise"></i></button>
            <span class="rlbl">بروزرسانی</span>
        </nav>

        @* ---------- لیست اصلی نامه‌ها ---------- *@
        <section class="pane">
            <div class="pane-head">
                <div class="pane-title">
                    <h1>کارتابل نامه وارده — @FolderTitle</h1>
                    <span class="sync"><span class="dot"></span> بروزرسانی زنده</span>
                </div>

                <div class="search">
                    <i class="bi bi-search"></i>
                    <input placeholder="جستجو در موضوع، شماره ثبت، فرستنده مبدأ…" @bind="searchTerm" @bind:event="oninput" @bind:after="ReloadDataAsync" />
                </div>

                <div class="chips">
                    <button class="chip @(filter == "all" ? "on" : "")" @onclick='() => SetFilter("all")'>همه <span class="n">@totalItems.FaDigits()</span></button>
                    @if (folder == "inbox")
                    {
                        <button class="chip @(filter == "unread" ? "on" : "")" @onclick='() => SetFilter("unread")'>خوانده‌نشده <span class="n">@stats.InboxUnread.FaDigits()</span></button>
                    }
                    <button class="chip @(filter == "starred" ? "on" : "")" @onclick='() => SetFilter("starred")'><i class="bi bi-star-fill" style="font-size:10px;color:#eab308"></i> نشان‌شده</button>
                    <button class="chip @(filter == "attach" ? "on" : "")" @onclick='() => SetFilter("attach")'><i class="bi bi-paperclip" style="font-size:10px"></i> پیوست‌دار</button>

                    @if (selectedErjaIds.Count > 0 && folder == "inbox")
                    {
                        <button class="chip on" style="background:#f59e0b;color:#fff;border-color:#d97706" @onclick="BatchBayeganiAsync">
                            <i class="bi bi-archive-fill me-1"></i> بایگانی دسته‌ای (@selectedErjaIds.Count.FaDigits())
                        </button>
                    }
                </div>
            </div>

            <div class="list">
                @if (loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (folder == "archive")
                {
                    <BayeganiTree @ref="bayeganiTree" IncomingOnly="true" Filter="@searchTerm" OnOpenLetter="OpenArchivedLetter" OnChanged="OnArchiveChanged" OnLetterUnarchived="OnLetterUnarchived" />
                }
                else if (letters.Count == 0)
                {
                    <div class="empty"><i class="bi bi-inbox fs-1 d-block mb-2"></i> نامه‌ای در این بخش یافت نشد.</div>
                }
                else
                {
                    @foreach (var item in PagedLetters)
                    {
                        var l = item;
                        var isUnread = !l.IsRead && folder == "inbox";
                        var isSel = activeLetter?.LetterId == l.LetterId;

                        <div class="mail @(isUnread ? "unread" : "") @(isSel ? "sel" : "")" @onclick="() => SelectLetter(l)">
                            @if (folder == "inbox" && l.ErjaId.HasValue)
                            {
                                <div style="display:flex;align-items:center;padding-left:6px" @onclick:stopPropagation="true">
                                    <input type="checkbox" class="form-check-input" checked="@selectedErjaIds.Contains(l.ErjaId.Value)" @onchange="() => ToggleSelectErja(l.ErjaId.Value)" />
                                </div>
                            }

                            <div class="avt" style="background:#3b82f6;color:#fff"><i class="bi bi-inbox"></i></div>

                            <div class="mail-b">
                                <div class="mail-r1">
                                    <span class="who">@l.Ferestande</span>
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-0 fs-7"># @l.NumberSabt.FaDigits()</span>
                                </div>
                                <div class="mail-tt">@l.Title</div>
                                <div class="mail-pv">
                                    <span>مبدأ: @(string.IsNullOrWhiteSpace(l.NumberLetterVarede) ? "-" : l.NumberLetterVarede)</span>
                                    <span class="ms-2">· تاریخ ورود: @l.DateErsal.ToFaDate()</span>
                                </div>
                            </div>

                            <div class="dd" @onclick:stopPropagation="true">
                                <button class="star-btn" @onclick="() => ToggleNeshanAsync(l)" title="نشان کردن">
                                    <i class="bi @(l.IsNeshan ? "bi-star-fill text-warning" : "bi-star text-muted")"></i>
                                </button>
                                <button @onclick="() => ToggleRowMenu(l.LetterId)"><i class="bi bi-three-dots-vertical"></i></button>

                                @if (openMenuLetterId == l.LetterId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        <button @onclick="() => OpenDetailModal(l.LetterId)"><i class="bi bi-eye"></i> مشاهده کامل</button>
                                        <button @onclick="() => OpenErja(l.LetterId, l.NumberSabt)"><i class="bi bi-send"></i> ارجاع نامه</button>
                                        <button @onclick="() => OpenGardesh(l)"><i class="bi bi-diagram-3"></i> گردش نامه</button>
                                        @if (l.ErjaId.HasValue && !l.IsBayegani)
                                        {
                                            <button @onclick="() => ToggleBayeganiAsync(l)"><i class="bi bi-archive"></i> انطباق و بایگانی</button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ---------- صفحه‌بندی ---------- *@
                    @if (totalPages > 1)
                    {
                        <div class="d-flex justify-content-between align-items-center p-3 border-top">
                            <small class="text-muted">صفحه @currentPage.FaDigits() از @totalPages.FaDigits() (کل: @totalItems.FaDigits())</small>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-secondary" disabled="@(currentPage <= 1)" @onclick="() => GoPageAsync(currentPage - 1)">قبلی</button>
                                <button class="btn btn-outline-secondary" disabled="@(currentPage >= totalPages)" @onclick="() => GoPageAsync(currentPage + 1)">بعدی</button>
                            </div>
                        </div>
                    }
                }
            </div>
        </section>

        @* ---------- ستون پانل خواندن و جزییات نامه ---------- *@
        @if (readerOpen && activeDetail != null)
        {
            <aside class="reader" style="overflow-y:auto">
                <div class="rd-top">
                    <span class="t"><i class="bi bi-envelope-paper-fill" style="color:var(--p)"></i> @activeDetail.Title</span>
                    <button class="icb" title="بستن" @onclick="CloseReader"><i class="bi bi-x-lg"></i></button>
                </div>

                <div class="paper" style="padding:16px">
                    <div class="d-flex justify-content-between align-items-start mb-3 pb-2 border-bottom">
                        <div>
                            <h6 class="fw-bold mb-1">فرستنده: @activeDetail.Ferestande</h6>
                            <small class="text-muted">تاریخ نامه مبدأ: @activeDetail.Date.ToFaDate() | ثبت ورودی: @activeDetail.DateErsal.ToFaDate()</small>
                        </div>
                        <div class="text-end">
                            <span class="badge bg-primary fs-6">شماره ثبت: # @activeDetail.NumberSabt.FaDigits()</span>
                            @if (!string.IsNullOrWhiteSpace(activeDetail.NumberLetterVarede))
                            {
                                <div class="small text-muted mt-1">شماره مبدأ: @activeDetail.NumberLetterVarede</div>
                            }
                        </div>
                    </div>

                    <div class="mb-3" style="min-height:120px; line-height:1.7; background:#fafafa; padding:12px; border-radius:8px">
                        @if (string.IsNullOrWhiteSpace(activeDetail.Description))
                        {
                            <span class="text-muted">بدون توضیحات متنی</span>
                        }
                        else
                        {
                            @((MarkupString)activeDetail.Description)
                        }
                    </div>

                    @* پیوست‌ها *@
                    @if (activeDetail.Attachments.Count > 0)
                    {
                        <div class="card border-0 bg-light p-2 mb-3">
                            <label class="fw-bold small mb-2"><i class="bi bi-paperclip me-1"></i>پیوست‌های نامه (@activeDetail.Attachments.Count.FaDigits() فایل):</label>
                            <div class="d-flex flex-column gap-2">
                                @foreach (var att in activeDetail.Attachments)
                                {
                                    var downloadUrl = IncomingSvc.AttachmentDownloadUrl(att.AttachmentId);
                                    <div class="d-flex justify-content-between align-items-center bg-white p-2 rounded border small">
                                        <span><i class="bi bi-file-earmark-arrow-down text-primary me-1"></i><b>@att.FileName</b></span>
                                        <a href="@downloadUrl" target="_blank" download class="btn btn-sm btn-outline-primary py-0">دانلود</a>
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* عملیات سریع *@
                    <div class="d-flex gap-2 justify-content-end pt-2 border-top">
                        <button class="btn btn-sm btn-outline-info" @onclick="() => OpenGardeshFromReader(activeDetail.LetterId)">
                            <i class="bi bi-diagram-3"></i> گردش
                        </button>
                        @if (activeDetail.ActiveErjaId.HasValue)
                        {
                            <button class="btn btn-sm btn-primary" @onclick="() => OpenAnswerFromReader(activeDetail.ActiveErjaId.Value, activeDetail.NumberSabt)">
                                <i class="bi bi-reply-fill"></i> ثبت پاسخ
                            </button>
                        }
                        <button class="btn btn-sm btn-success" @onclick="() => OpenErja(activeDetail.LetterId, activeDetail.NumberSabt)">
                            <i class="bi bi-send-fill"></i> ارجاع
                        </button>
                    </div>
                </div>
            </aside>
        }
    </div>
</div>

@* ---------- مدال‌های جانبی ---------- *@
<IncomingLetterViewModal @ref="viewModal" OnErja="HandleErjaFromView" OnAnswerErja="HandleAnswerFromView" OnEdit="HandleEditFromView" OnGardesh="HandleGardeshFromView" />
<IncomingErjaSheet @ref="erjaSheet" OnSubmitted="ReloadDataAsync" />
<IncomingGardeshModal @ref="gardeshModal" />
<IncomingReservationManager @ref="reservationManager" />
<BayeganiFolderPickerModal @ref="folderPicker" />
<IncomingLetterViewModal @ref="archiveViewModal" OnErja="HandleErjaFromView" OnAnswerErja="HandleAnswerFromView" OnEdit="HandleEditFromView" OnGardesh="HandleGardeshFromView" />

@code {
    [Parameter] public string? Tab { get; set; }

    private string folder = "inbox";
    private string filter = "all";
    private string searchTerm = "";

    private bool loading = true;
    private bool readerOpen = false;
    private int currentPage = 1;
    private int pageSize = 15;
    private int totalPages = 1;
    private int totalItems = 0;

    private int openMenuLetterId = 0;
    private IncomingLetterListItemDto? activeLetter;
    private IncomingLetterDetailDto? activeDetail;

    private List<IncomingLetterListItemDto> letters = new();
    private IncomingLetterCartableStatsDto stats = new();
    private bool CanDabirkhane => Auth.Has("IncomingLetters.Dabirkhane") || Auth.Has("OutgoingLetters.Dabirkhane") || Auth.Has("Admin");
    private List<int> selectedErjaIds = new();

    private ComposeIncomingModal? composeModal;
    private IncomingLetterViewModal? viewModal;
    private IncomingErjaSheet? erjaSheet;
    private IncomingGardeshModal? gardeshModal;
    private IncomingReservationManager? reservationManager;
    private BayeganiFolderPickerModal? folderPicker;
    private BayeganiTree? bayeganiTree;
    private IncomingLetterViewModal? archiveViewModal;

    private string FolderTitle => folder switch
    {
        "sent" => "ثبت‌شده‌ها",
        "starred" => "نشان‌شده",
        "archive" => "بایگانی",
        _ => "دریافتی (کارتابل جاری)"
    };

    private IEnumerable<IncomingLetterListItemDto> PagedLetters => filter switch
    {
        "unread" => letters.Where(l => !l.IsRead),
        "starred" => letters.Where(l => l.IsNeshan),
        "attach" => letters.Where(l => l.AttachmentCount > 0),
        _ => letters
    };

    protected override async Task OnInitializedAsync()
    {
        if (Tab is "inbox" or "sent" or "starred" or "archive") folder = Tab;
        await ReloadDataAsync();
    }

    private async Task SetFolder(string f)
    {
        folder = f;
        currentPage = 1;
        selectedErjaIds.Clear();
        readerOpen = false;
        await ReloadDataAsync();
    }

    private void SetFilter(string flt)
    {
        filter = flt;
    }

    private async Task GoPageAsync(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await ReloadDataAsync();
    }

    private async Task ReloadDataAsync()
    {
        loading = true;
        try
        {
            stats = await IncomingSvc.GetStatsAsync();

            PagedResult<IncomingLetterListItemDto> result;
            if (folder == "sent")
            {
                result = await IncomingSvc.GetSentAsync(searchTerm, currentPage, pageSize);
            }
            else if (folder == "archive")
            {
                result = await IncomingSvc.GetArchiveAsync(searchTerm, currentPage, pageSize);
            }
            else
            {
                result = await IncomingSvc.GetInboxAsync(searchTerm, null, currentPage, pageSize);
            }

            letters = result.Items;
            totalItems = result.TotalCount;
            totalPages = result.TotalPages > 0 ? result.TotalPages : 1;
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectLetter(IncomingLetterListItemDto l)
    {
        activeLetter = l;
        readerOpen = true;
        try
        {
            activeDetail = await IncomingSvc.GetDetailAsync(l.LetterId);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private async Task OpenArchivedLetter(BayeganiNodeDto node)
    {
        if (node.LetterId is not { } letterId) return;
        try
        {
            activeDetail = await IncomingSvc.GetDetailAsync(letterId);
            activeLetter = letters.FirstOrDefault(x => x.LetterId == letterId);
            readerOpen = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task OnArchiveChanged()
    {
        await ReloadDataAsync();
        if (bayeganiTree != null) await bayeganiTree.ReloadAsync();
    }

    private async Task OnLetterUnarchived(BayeganiNodeDto node)
    {
        if (node.ErjaId is { } erjaId) await IncomingSvc.ToggleBayeganiAsync(erjaId);
        await ReloadDataAsync();
    }

    private void CloseReader()
    {
        readerOpen = false;
        activeLetter = null;
        activeDetail = null;
    }

    private void ToggleRowMenu(int letterId)
    {
        openMenuLetterId = openMenuLetterId == letterId ? 0 : letterId;
    }

    private void CloseMenus() => openMenuLetterId = 0;

    private void OpenComposeNew() => composeModal?.OpenCreate();
    private void OpenReservationManager() => reservationManager?.Open();
    private void OpenDetailModal(int letterId) => viewModal?.Open(letterId);

    private void OpenErja(int letterId, int numberSabt) => erjaSheet?.OpenErja(letterId, numberSabt);
    private void OpenGardesh(IncomingLetterListItemDto letter) => gardeshModal?.Open(letter.LetterId, letter.Title, letter.Ferestande, letter.NumberSabt, letter.DateErsal);

    private void OpenGardeshFromReader(int letterId)
    {
        if (activeDetail != null)
            gardeshModal?.Open(activeDetail.LetterId, activeDetail.Title, activeDetail.Ferestande, activeDetail.NumberSabt, activeDetail.DateErsal);
    }

    private void OpenAnswerFromReader(int erjaId, int sabtNumber) => erjaSheet?.OpenAnswer(erjaId, sabtNumber);

    private async Task ToggleNeshanAsync(IncomingLetterListItemDto item)
    {
        try
        {
            if (item.ErjaId.HasValue) item.IsNeshan = await IncomingSvc.ToggleNeshanAsync(item.ErjaId.Value);
            else item.IsNeshan = await IncomingSvc.ToggleLetterNeshanAsync(item.LetterId);
            Toast.Success(item.IsNeshan ? "نامه نشان شد." : "نشان برداشت شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ToggleBayeganiAsync(IncomingLetterListItemDto item)
    {
        if (!item.ErjaId.HasValue) return;
        try
        {
            item.IsBayegani = await IncomingSvc.ToggleBayeganiAsync(item.ErjaId.Value);
            Toast.Success(item.IsBayegani ? "نامه به بایگانی منتقل شد." : "از بایگانی خارج شد.");
            await ReloadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void ToggleSelectErja(int erjaId)
    {
        if (selectedErjaIds.Contains(erjaId)) selectedErjaIds.Remove(erjaId);
        else selectedErjaIds.Add(erjaId);
    }

    private async Task BatchBayeganiAsync()
    {
        if (selectedErjaIds.Count == 0) return;
        try
        {
            if (folderPicker == null) return;
            var destination = await folderPicker.PickAsync("انتخاب پوشه برای بایگانی گروهی");
            if (destination is not { } folderId || folderId <= 0) return;
            await LetterSvc.ArchiveLettersAsync(new ArchiveLettersDto
            {
                FolderId = folderId,
                ErjaIds = selectedErjaIds.ToList()
            });
            Toast.Success($"{selectedErjaIds.Count.FaDigits()} نامه بایگانی گردید.");
            selectedErjaIds.Clear();
            await ReloadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void HandleErjaFromView((int LetterId, int SabtNumber) args) => erjaSheet?.OpenErja(args.LetterId, args.SabtNumber);
    private void HandleAnswerFromView((int ErjaId, int SabtNumber) args) => erjaSheet?.OpenAnswer(args.ErjaId, args.SabtNumber);
    private void HandleEditFromView(IncomingLetterDetailDto letter) => composeModal?.OpenEdit(letter);
    private void HandleGardeshFromView(int letterId)
    {
        if (activeDetail != null) gardeshModal?.Open(activeDetail.LetterId, activeDetail.Title, activeDetail.Ferestande, activeDetail.NumberSabt, activeDetail.DateErsal);
    }
}
