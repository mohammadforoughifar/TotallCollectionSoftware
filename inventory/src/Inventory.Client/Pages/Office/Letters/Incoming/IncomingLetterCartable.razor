    /// <summary>در جریان بودن دریافت گردش برای کپی — برای غیرفعال‌کردن دکمه.</summary>
    private bool copying;

    /// <summary>
    /// کپی نامه وارده — فرم ثبت نامهٔ «جدید» با اطلاعات نامهٔ جاری باز می‌شود و
    /// «همهٔ افرادِ در گردش» نیز از پیش انتخاب می‌شوند.
    /// شمارهٔ ثبت/اندیکاتور کپی نمی‌شود تا شمارهٔ نامهٔ قبلی دوباره مصرف نشود.
    /// </summary>
    private async Task CopyLetter()
    {
        if (activeDetail == null || composeModal == null) return;
        copying = true;
        try
        {
            var recivers = await CollectGardeshRecipientsAsync(activeDetail.LetterId);
            await composeModal.OpenCopy(activeDetail, recivers);
            Toast.Success(recivers is { IsEmpty: false }
                ? $"فرم ثبت نامهٔ وارده با اطلاعات نامهٔ اصلی باز شد و {recivers.Total.FaDigits()} نفر از افراد در گردش از پیش انتخاب شدند؛ شمارهٔ ثبت را بررسی کنید."
                : "فرم ثبت نامهٔ وارده با اطلاعات نامهٔ اصلی باز شد؛ گیرندگان را انتخاب و ثبت کنید.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { copying = false; }
    }

    /// <summary>
    /// خواندن درخت گردش نامه و سطل‌بندی افراد بر اساس نقش‌شان.
    /// کاربر جاری حذف می‌شود چون کمبوی گیرندگان او را فهرست نمی‌کند (u.Id != MyUserId).
    /// شکست در دریافت گردش نباید جلوی باز شدن فرم کپی را بگیرد.
    /// </summary>
    private async Task<LetterCopyRecipients?> CollectGardeshRecipientsAsync(int letterId)
    {
        try
        {
            var tree = await IncomingSvc.GetGardeshAsync(letterId);
            return tree.CollectRecipients(Auth.UserId);
        }
        catch { return null; }
    }
