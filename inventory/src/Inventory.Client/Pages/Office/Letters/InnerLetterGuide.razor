@inject IJSRuntime JS

<div class="inner-letter-guide" dir="rtl">
    <header class="guide-hero">
        <div class="guide-hero-copy">
            <div class="guide-eyebrow"><i class="bi bi-stars"></i> اتوماسیون اداری / راهنمای کاربری</div>
            <h1>راهنمای کارتابل نامه داخلی</h1>
            <p>
                از ایجاد و ارسال نامه تا پاسخ، ارجاع، پیگیری گردش و بایگانی؛
                همه مراحل کار با نامه داخلی را گام‌به‌گام در این صفحه ببینید.
            </p>
            <div class="guide-actions no-print">
                <button type="button" class="guide-button primary" @onclick="BackToLetters">
                    <i class="bi bi-arrow-right"></i>
                    بازگشت به نامه‌ها
                </button>
                <button type="button" class="guide-button secondary" @onclick="PrintGuide">
                    <i class="bi bi-printer"></i>
                    چاپ یا ذخیره PDF
                </button>
            </div>
            <div class="guide-meta">
                <span><i class="bi bi-check2-circle"></i> مطابق نسخه فعلی سامانه</span>
                <span><i class="bi bi-phone"></i> قابل استفاده در رایانه و موبایل</span>
            </div>
        </div>
        <div class="guide-hero-art" aria-hidden="true">
            <span class="art-orbit orbit-one"><i class="bi bi-send-fill"></i></span>
            <span class="art-orbit orbit-two"><i class="bi bi-paperclip"></i></span>
            <span class="art-orbit orbit-three"><i class="bi bi-check2-all"></i></span>
            <div class="art-envelope"><i class="bi bi-envelope-paper-heart-fill"></i></div>
        </div>
    </header>

    <section class="quick-start" aria-labelledby="quick-start-title">
        <div class="quick-start-head">
            <span class="section-kicker">شروع سریع</span>
            <h2 id="quick-start-title">ارسال اولین نامه در سه گام</h2>
        </div>
        <div class="quick-steps">
            <div class="quick-step">
                <span class="step-number">۱</span>
                <div><strong>نامه جدید</strong><small>در کارتابل روی دکمه «+» بزنید.</small></div>
            </div>
            <i class="bi bi-chevron-left step-arrow" aria-hidden="true"></i>
            <div class="quick-step">
                <span class="step-number">۲</span>
                <div><strong>تکمیل نامه</strong><small>گیرنده، عنوان و متن را وارد کنید.</small></div>
            </div>
            <i class="bi bi-chevron-left step-arrow" aria-hidden="true"></i>
            <div class="quick-step">
                <span class="step-number">۳</span>
                <div><strong>ارسال</strong><small>اطلاعات را بازبینی و «ارسال» را انتخاب کنید.</small></div>
            </div>
        </div>
    </section>

    <div class="guide-layout">
        <aside class="guide-toc no-print" aria-label="فهرست راهنما">
            <div class="toc-title"><i class="bi bi-list-check"></i> فهرست مطالب</div>
            <nav>
                <button type="button" @onclick='() => ScrollTo("overview")'><span>۱</span> آشنایی با کارتابل</button>
                <button type="button" @onclick='() => ScrollTo("folders")'><span>۲</span> پوشه‌های نامه</button>
                <button type="button" @onclick='() => ScrollTo("compose")'><span>۳</span> ایجاد و ارسال نامه</button>
                <button type="button" @onclick='() => ScrollTo("drafts")'><span>۴</span> کار با پیش‌نویس‌ها</button>
                <button type="button" @onclick='() => ScrollTo("reading")'><span>۵</span> مشاهده و عملیات نامه</button>
                <button type="button" @onclick='() => ScrollTo("reply")'><span>۶</span> پاسخ، تأیید و رد</button>
                <button type="button" @onclick='() => ScrollTo("referral")'><span>۷</span> ارجاع و هامش</button>
                <button type="button" @onclick='() => ScrollTo("search")'><span>۸</span> جستجو و فیلتر</button>
                <button type="button" @onclick='() => ScrollTo("archive")'><span>۹</span> بایگانی نامه‌ها</button>
                <button type="button" @onclick='() => ScrollTo("tracking")'><span>۱۰</span> گردش و پیگیری</button>
                <button type="button" @onclick='() => ScrollTo("advanced")'><span>۱۱</span> امکانات تکمیلی</button>
                <button type="button" @onclick='() => ScrollTo("faq")'><span>۱۲</span> پرسش‌های متداول</button>
            </nav>
            <div class="toc-tip">
                <i class="bi bi-lightbulb-fill"></i>
                <span>نمایش بعضی دکمه‌ها به سطح دسترسی شما بستگی دارد.</span>
            </div>
        </aside>

        <main class="guide-content">
            <section id="overview" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۱</span>
                    <div>
                        <span class="section-kicker">نمای کلی</span>
                        <h2>آشنایی با کارتابل نامه داخلی</h2>
                    </div>
                </div>
                <p>
                    کارتابل نامه داخلی محل مکاتبات میان کاربران و واحدهای سازمان است. صفحه از سه بخش اصلی تشکیل شده است:
                    ریل پوشه‌ها، فهرست نامه‌ها و صفحه خواندن نامه.
                </p>
                <div class="anatomy-grid">
                    <article class="anatomy-card violet">
                        <span class="card-icon"><i class="bi bi-layout-sidebar-inset"></i></span>
                        <h3>ریل پوشه‌ها</h3>
                        <p>از این قسمت بین دریافتی، ارسالی، پیش‌نویس، نشان‌شده و بایگانی جابه‌جا شوید.</p>
                    </article>
                    <article class="anatomy-card blue">
                        <span class="card-icon"><i class="bi bi-view-list"></i></span>
                        <h3>فهرست نامه‌ها</h3>
                        <p>عنوان، فرستنده یا گیرنده، شماره، تاریخ، فوریت، محرمانگی و وضعیت هر نامه را ببینید.</p>
                    </article>
                    <article class="anatomy-card green">
                        <span class="card-icon"><i class="bi bi-envelope-open"></i></span>
                        <h3>صفحه خواندن</h3>
                        <p>متن، مشخصات، گیرندگان، پیوست‌ها و عملیات مرتبط با نامه انتخاب‌شده اینجا نمایش داده می‌شود.</p>
                    </article>
                </div>
                <div class="guide-note info">
                    <i class="bi bi-broadcast-pin"></i>
                    <div><strong>به‌روزرسانی زنده</strong><span>با ثبت یا تغییر نامه، کارتابل به‌صورت زنده به‌روزرسانی می‌شود.</span></div>
                </div>
            </section>

            <section id="folders" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۲</span>
                    <div>
                        <span class="section-kicker">دسته‌بندی</span>
                        <h2>پوشه‌های نامه</h2>
                    </div>
                </div>
                <div class="folder-list">
                    <div class="folder-row">
                        <span class="folder-icon inbox"><i class="bi bi-inbox-fill"></i></span>
                        <div><h3>دریافتی</h3><p>نامه‌هایی که به‌عنوان گیرنده، ارجاع یا هامش برای شما فرستاده شده‌اند. عدد کنار آیکن، تعداد خوانده‌نشده‌هاست.</p></div>
                    </div>
                    <div class="folder-row">
                        <span class="folder-icon sent"><i class="bi bi-send"></i></span>
                        <div><h3>ارسالی</h3><p>نامه‌هایی که شما ثبت و ارسال کرده‌اید؛ برای پیگیری گردش، ویرایش مجاز و چاپ از این پوشه استفاده کنید.</p></div>
                    </div>
                    <div class="folder-row">
                        <span class="folder-icon draft"><i class="bi bi-pencil-square"></i></span>
                        <div><h3>پیش‌نویس</h3><p>نامه‌های ناتمام ذخیره‌شده که هنوز ارسال نشده‌اند و می‌توانید بعداً تکمیل، ویرایش یا حذف کنید.</p></div>
                    </div>
                    <div class="folder-row">
                        <span class="folder-icon starred"><i class="bi bi-star-fill"></i></span>
                        <div><h3>نشان‌شده</h3><p>نامه‌های مهم دریافتی یا ارسالی که با ستاره علامت زده‌اید تا سریع‌تر پیدا شوند.</p></div>
                    </div>
                    <div class="folder-row">
                        <span class="folder-icon archive"><i class="bi bi-archive-fill"></i></span>
                        <div><h3>بایگانی</h3><p>نامه‌هایی که در پوشه‌های بایگانی شخصی مرتب کرده‌اید؛ امکان جستجو و خروج از بایگانی نیز وجود دارد.</p></div>
                    </div>
                </div>
            </section>

            <section id="compose" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۳</span>
                    <div>
                        <span class="section-kicker">ثبت مکاتبه</span>
                        <h2>ایجاد و ارسال نامه جدید</h2>
                    </div>
                </div>
                <ol class="instruction-list">
                    <li><span>۱</span><div>در ریل سمت راست کارتابل، دکمه <b>«+» (نامه جدید)</b> را انتخاب کنید.</div></li>
                    <li><span>۲</span><div>حداقل یک <b>گیرنده</b> انتخاب کنید. می‌توانید کاربر یا گروه گیرندگان را برگزینید.</div></li>
                    <li><span>۳</span><div><b>عنوان نامه</b> را وارد و متن را با ویرایشگر کامل کنید.</div></li>
                    <li><span>۴</span><div>در صورت نیاز فوریت، محرمانگی، ارجاع، هامش، پیوست و نامه مرتبط را تنظیم کنید.</div></li>
                    <li><span>۵</span><div>پس از بازبینی، <b>ارسال</b> را بزنید یا برای ادامه در آینده، <b>ذخیره به‌عنوان پیش‌نویس</b> را انتخاب کنید.</div></li>
                </ol>

                <div class="table-wrap">
                    <table class="guide-table">
                        <thead><tr><th>فیلد</th><th>وضعیت</th><th>کاربرد</th></tr></thead>
                        <tbody>
                            <tr><td><b>گیرنده</b></td><td><span class="required-badge">الزامی</span></td><td>دریافت‌کننده اصلی نامه؛ انتخاب انفرادی و گروهی ممکن است.</td></tr>
                            <tr><td><b>ارجاع</b></td><td><span class="optional-badge">اختیاری</span></td><td>ارسال هم‌زمان نامه برای اقدام کاربران یا گروه‌های دیگر.</td></tr>
                            <tr><td><b>هامش (رونوشت)</b></td><td><span class="optional-badge">اختیاری</span></td><td>ارسال رونوشت جهت اطلاع.</td></tr>
                            <tr><td><b>عنوان</b></td><td><span class="required-badge">الزامی</span></td><td>موضوع کوتاه، روشن و قابل جستجوی نامه.</td></tr>
                            <tr><td><b>فوریت</b></td><td><span class="optional-badge">عادی / فوری / آنی</span></td><td>اولویت رسیدگی را مشخص می‌کند.</td></tr>
                            <tr><td><b>محرمانگی</b></td><td><span class="optional-badge">عادی / محرمانه / سری</span></td><td>سطح حساسیت محتوای نامه را نشان می‌دهد.</td></tr>
                        </tbody>
                    </table>
                </div>

                <div class="subsection">
                    <h3><i class="bi bi-paperclip"></i> افزودن پیوست</h3>
                    <p>فایل‌ها را در کادر پیوست رها کنید یا روی آن کلیک کنید. تعداد فایل‌ها محدود نیست، اما هر فایل باید غیرخالی و حداکثر <b>۲۰ مگابایت</b> باشد؛ فایل تکراری پذیرفته نمی‌شود.</p>
                </div>
                <div class="subsection">
                    <h3><i class="bi bi-link-45deg"></i> ثبت عطف و پیرو</h3>
                    <p>با «ثبت نامه مرتبط»، نوع رابطه <b>عطف به</b> یا <b>پیرو</b> را انتخاب و نامه موردنظر را از میان نامه‌های داخلی، صادره یا وارده جستجو کنید.</p>
                </div>
                <div class="guide-note warning">
                    <i class="bi bi-shield-lock-fill"></i>
                    <div><strong>پیش از ارسال کنترل کنید</strong><span>گیرندگان، سطح محرمانگی، متن و پیوست‌ها را بازبینی کنید؛ نامه ارسالی فقط تا پیش از خوانده‌شدن توسط گیرنده قابل ویرایش است.</span></div>
                </div>
            </section>

            <section id="drafts" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۴</span>
                    <div>
                        <span class="section-kicker">ذخیره موقت</span>
                        <h2>کار با پیش‌نویس‌ها</h2>
                    </div>
                </div>
                <p>اگر نامه هنوز آماده ارسال نیست، آن را پیش‌نویس کنید. در پوشه پیش‌نویس سه عملیات در دسترس است:</p>
                <div class="action-grid three">
                    <article><i class="bi bi-send"></i><h3>ادامه و ارسال</h3><p>فرم کامل نامه باز می‌شود تا گیرنده و سایر اطلاعات را تکمیل و ارسال کنید.</p></article>
                    <article><i class="bi bi-pencil-square"></i><h3>ویرایش سریع</h3><p>عنوان و متن پیش‌نویس را بدون ورود به فرم کامل اصلاح کنید.</p></article>
                    <article><i class="bi bi-trash3"></i><h3>حذف</h3><p>پیش‌نویس بلااستفاده را پس از تأیید نهایی حذف کنید.</p></article>
                </div>
                <div class="guide-note success">
                    <i class="bi bi-save2-fill"></i>
                    <div><strong>دو راه ساخت پیش‌نویس</strong><span>از فرم «نامه جدید» گزینه ذخیره پیش‌نویس را بزنید، یا در پوشه پیش‌نویس «افزودن پیش‌نویس» را انتخاب کنید.</span></div>
                </div>
            </section>

            <section id="reading" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۵</span>
                    <div>
                        <span class="section-kicker">صفحه خواندن</span>
                        <h2>مشاهده و عملیات روی نامه</h2>
                    </div>
                </div>
                <p>با انتخاب هر ردیف، جزئیات نامه باز می‌شود. باز کردن نامه دریافتیِ خوانده‌نشده، وضعیت آن را به خوانده‌شده تغییر می‌دهد.</p>
                <div class="action-grid">
                    <article><i class="bi bi-star"></i><h3>نشان‌کردن</h3><p>نامه مهم را ستاره‌دار یا نشان آن را حذف کنید.</p></article>
                    <article><i class="bi bi-archive"></i><h3>بایگانی</h3><p>نامه را به پوشه دلخواه بفرستید.</p></article>
                    <article><i class="bi bi-printer"></i><h3>چاپ</h3><p>نسخه سربرگ‌دار A4 یا A5 را دریافت کنید.</p></article>
                    <article><i class="bi bi-files"></i><h3>کپی نامه</h3><p>فرم نامه جدید را با عنوان و متن نامه فعلی باز کنید.</p></article>
                    <article><i class="bi bi-pencil-square"></i><h3>ویرایش</h3><p>فرستنده تا قبل از خواندن گیرندگان می‌تواند نامه را اصلاح کند.</p></article>
                    <article><i class="bi bi-list-task"></i><h3>تبدیل به دستور کار</h3><p>در صورت داشتن مجوز، نامه را به یک دستور کار قابل پیگیری تبدیل کنید.</p></article>
                </div>
                <div class="subsection">
                    <h3><i class="bi bi-file-earmark-arrow-down"></i> مشاهده پیوست‌ها</h3>
                    <p>روی پیوست کلیک کنید؛ تصویر، PDF و متن در پیش‌نمایش باز می‌شوند و سایر فایل‌ها دانلود خواهند شد. فرستنده یا مدیر می‌تواند پیوست را حذف کند و فرستنده امکان افزودن پیوست جدید دارد.</p>
                </div>
            </section>

            <section id="reply" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۶</span>
                    <div>
                        <span class="section-kicker">اقدام گیرنده</span>
                        <h2>پاسخ، تأیید و رد نامه</h2>
                    </div>
                </div>
                <div class="response-flow">
                    <div><i class="bi bi-check-lg"></i><strong>تأیید و ثبت پاسخ</strong><span>پاسخ استاندارد «تأیید می‌شود» ثبت می‌گردد.</span></div>
                    <div><i class="bi bi-x-lg"></i><strong>رد</strong><span>پاسخ استاندارد «رد می‌شود» ثبت می‌گردد.</span></div>
                    <div><i class="bi bi-chat-text"></i><strong>پاسخ متنی</strong><span>متن دلخواه خود را وارد و ثبت کنید.</span></div>
                </div>
                <div class="guide-note info">
                    <i class="bi bi-eye-slash-fill"></i>
                    <div><strong>پاسخ خصوصی</strong><span>در فرم پاسخ متنی می‌توانید «پاسخ خصوصی» را فعال کنید تا پاسخ فقط برای فرستنده قابل مشاهده باشد.</span></div>
                </div>
            </section>

            <section id="referral" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۷</span>
                    <div>
                        <span class="section-kicker">گردش سازمانی</span>
                        <h2>ارجاع و هامش</h2>
                    </div>
                </div>
                <div class="compare-grid">
                    <article class="compare-card referral">
                        <div class="compare-title"><i class="bi bi-arrow-left-circle-fill"></i><h3>ارجاع</h3></div>
                        <p>برای سپردن اقدام یا پیگیری نامه به کاربر یا گروه دیگر است.</p>
                        <ul>
                            <li>انتخاب گیرنده الزامی است.</li>
                            <li>انتخاب «عملگر نامه» الزامی است.</li>
                            <li>ثبت متن پاراف و مهلت پاسخ اختیاری است.</li>
                        </ul>
                    </article>
                    <article class="compare-card margin-note">
                        <div class="compare-title"><i class="bi bi-people-fill"></i><h3>هامش (رونوشت)</h3></div>
                        <p>برای اطلاع‌رسانی و ارسال رونوشت نامه به افراد یا گروه‌های دیگر است.</p>
                        <ul>
                            <li>انتخاب گیرنده الزامی است.</li>
                            <li>به انتخاب عملگر نیاز ندارد.</li>
                            <li>می‌توانید متن هامش یا پاراف بنویسید.</li>
                        </ul>
                    </article>
                </div>
                <ol class="instruction-list compact">
                    <li><span>۱</span><div>نامه را باز و دکمه <b>ارجاع / هامش</b> را انتخاب کنید.</div></li>
                    <li><span>۲</span><div>نوع اقدام را مشخص و کاربر یا گروه مقصد را انتخاب کنید.</div></li>
                    <li><span>۳</span><div>برای ارجاع، عملگر را تعیین کنید؛ در صورت نیاز پاراف و مهلت را نیز ثبت کنید.</div></li>
                    <li><span>۴</span><div>دکمه ثبت را بزنید؛ شاخه جدید در گردش نامه نمایش داده می‌شود.</div></li>
                </ol>
            </section>

            <section id="search" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۸</span>
                    <div>
                        <span class="section-kicker">دسترسی سریع</span>
                        <h2>جستجو، فیلتر و مرتب‌سازی</h2>
                    </div>
                </div>
                <div class="search-demo" aria-hidden="true">
                    <i class="bi bi-search"></i><span>جستجو در عنوان، شماره یا فرستنده…</span><kbd>جستجو</kbd>
                </div>
                <div class="feature-columns">
                    <div>
                        <h3><i class="bi bi-funnel"></i> فیلترهای سریع</h3>
                        <div class="chip-row"><span>همه</span><span>خوانده‌نشده</span><span>نشان‌شده</span><span>مهلت‌دار</span><span>پیوست‌دار</span></div>
                    </div>
                    <div>
                        <h3><i class="bi bi-sort-down"></i> مرتب‌سازی</h3>
                        <p>جدیدترین، قدیمی‌ترین، عنوان صعودی یا نزولی و شماره صعودی یا نزولی.</p>
                    </div>
                </div>
                <div class="guide-note neutral">
                    <i class="bi bi-info-circle-fill"></i>
                    <div><strong>نکته</strong><span>با تغییر پوشه، فیلتر به حالت «همه» و کادر جستجو به حالت خالی برمی‌گردد.</span></div>
                </div>
            </section>

            <section id="archive" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۹</span>
                    <div>
                        <span class="section-kicker">نظم‌دهی</span>
                        <h2>بایگانی تکی و گروهی</h2>
                    </div>
                </div>
                <div class="split-steps">
                    <article>
                        <span class="mini-label">یک نامه</span>
                        <h3><i class="bi bi-archive"></i> بایگانی تکی</h3>
                        <ol><li>نامه را باز کنید یا منوی سه‌نقطه را بزنید.</li><li>«بایگانی» را انتخاب کنید.</li><li>پوشه مقصد را برگزینید.</li></ol>
                    </article>
                    <article>
                        <span class="mini-label">چند نامه</span>
                        <h3><i class="bi bi-archive-fill"></i> بایگانی گروهی</h3>
                        <ol><li>تیک کنار نامه‌های موردنظر را فعال کنید.</li><li>«بایگانی گروهی» را بزنید.</li><li>پوشه مقصد را انتخاب کنید.</li></ol>
                    </article>
                </div>
                <p>برای بازگرداندن نامه، آن را در پوشه بایگانی پیدا کنید و گزینه <b>خروج از بایگانی</b> را پس از تأیید انتخاب کنید.</p>
                <div class="shortcut"><kbd>Ctrl</kbd><b>+</b><kbd>Shift</kbd><b>+</b><kbd>B</kbd><span>میانبر بایگانی یا خروج از بایگانیِ نامه باز</span></div>
            </section>

            <section id="tracking" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۱۰</span>
                    <div>
                        <span class="section-kicker">پیگیری</span>
                        <h2>مشاهده گردش نامه</h2>
                    </div>
                </div>
                <p>از منوی سه‌نقطه نامه یا گزینه «پیگیری گردش»، پنجره گردش را باز کنید. اطلاعات در سه نمای مختلف قابل مشاهده است:</p>
                <div class="view-modes">
                    <span><i class="bi bi-list-ul"></i><b>لیستی</b></span>
                    <span><i class="bi bi-diagram-2"></i><b>درختواره</b></span>
                    <span><i class="bi bi-diagram-3"></i><b>فلوچارتی</b></span>
                </div>
                <p>با انتخاب هر ایستگاه، نوع دریافت، فرستنده، تاریخ ارجاع، وضعیت خواندن، عملگر، مهلت، متن پاراف، پاسخ و نتیجه تأیید یا رد نمایش داده می‌شود.</p>
                <div class="status-legend">
                    <span class="done"><i></i> انجام‌شده / پاسخ‌داده‌شده</span>
                    <span class="waiting"><i></i> در انتظار اقدام</span>
                    <span class="overdue"><i></i> مهلت گذشته</span>
                </div>
            </section>

            <section id="advanced" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۱۱</span>
                    <div>
                        <span class="section-kicker">امکانات تکمیلی</span>
                        <h2>ابزارهای هوشمند و نکات دسترسی</h2>
                    </div>
                </div>
                <div class="advanced-card">
                    <div class="advanced-icon"><i class="bi bi-robot"></i></div>
                    <div>
                        <h3>دستیار هوشمند نامه</h3>
                        <p>در صورت داشتن مجوز دستیار هوش مصنوعی، هنگام نگارش می‌توانید پیش‌نویس متن و پیشنهاد گیرنده بگیرید. در صفحه خواندن نیز خلاصه، پیشنهاد ارجاع، استخراج اقدام‌ها و مهلت‌ها، دسته‌بندی و پیش‌نویس پاسخ در دسترس است.</p>
                        <div class="chip-row ai"><span>پیش‌نویس هوشمند</span><span>خلاصه</span><span>پیشنهاد ارجاع</span><span>اقدام‌ها</span><span>پیش‌نویس پاسخ</span></div>
                    </div>
                </div>
                <div class="permission-list">
                    <div><i class="bi bi-eye-fill"></i><span><b>مشاهده:</b> برای ورود به کارتابل و دیدن نامه‌ها لازم است.</span></div>
                    <div><i class="bi bi-plus-circle-fill"></i><span><b>ثبت:</b> دکمه نامه جدید و امکان ارسال را فعال می‌کند.</span></div>
                    <div><i class="bi bi-arrow-left-circle-fill"></i><span><b>ارجاع:</b> امکان ارجاع یا هامش نامه را در اختیار شما می‌گذارد.</span></div>
                    <div><i class="bi bi-list-task"></i><span><b>دستور کار:</b> تبدیل نامه به دستور کار به مجوز ایجاد دستور کار نیاز دارد.</span></div>
                </div>
                <div class="guide-note warning">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                    <div><strong>حفظ محرمانگی</strong><span>نامه‌های «محرمانه» و «سری» را فقط برای افراد مجاز ارسال کنید و پیش از افزودن پیوست، محتوای فایل را کنترل کنید.</span></div>
                </div>
            </section>

            <section id="faq" class="guide-section">
                <div class="section-heading">
                    <span class="section-index">۱۲</span>
                    <div>
                        <span class="section-kicker">رفع ابهام</span>
                        <h2>پرسش‌های متداول</h2>
                    </div>
                </div>
                <div class="faq-list">
                    <details open>
                        <summary>چرا دکمه ویرایش نامه را نمی‌بینم؟ <i class="bi bi-chevron-down"></i></summary>
                        <p>فقط فرستنده می‌تواند نامه ارسالی را ویرایش کند و این امکان تا پیش از خوانده‌شدن نامه توسط گیرنده‌ها فعال است.</p>
                    </details>
                    <details>
                        <summary>چرا امکان ارجاع یا ایجاد نامه برای من فعال نیست؟ <i class="bi bi-chevron-down"></i></summary>
                        <p>نمایش عملیات بر اساس نقش و سطح دسترسی شماست. برای دریافت مجوز «ثبت» یا «ارجاع نامه داخلی» با مدیر سیستم تماس بگیرید.</p>
                    </details>
                    <details>
                        <summary>چرا فایل پیوست پذیرفته نمی‌شود؟ <i class="bi bi-chevron-down"></i></summary>
                        <p>فایل خالی، فایل تکراری یا فایل بزرگ‌تر از ۲۰ مگابایت پذیرفته نمی‌شود. نام و حجم فایل را بررسی و دوباره تلاش کنید.</p>
                    </details>
                    <details>
                        <summary>نامه‌ای را پیدا نمی‌کنم؛ چه کار کنم؟ <i class="bi bi-chevron-down"></i></summary>
                        <p>پوشه‌های دریافتی، ارسالی، نشان‌شده و بایگانی را بررسی کنید؛ فیلتر را روی «همه» بگذارید و با بخشی از عنوان یا شماره نامه جستجو کنید.</p>
                    </details>
                    <details>
                        <summary>تفاوت «پاسخ» با «نامه پاسخ» چیست؟ <i class="bi bi-chevron-down"></i></summary>
                        <p>«ثبت پاسخ» نتیجه اقدام را در همان گردش ذخیره می‌کند. گزینه «پیش‌نویس پاسخ» یا کپی نامه، یک نامه داخلی جدید می‌سازد که می‌تواند عطف رسمی به نامه قبلی داشته باشد.</p>
                    </details>
                </div>
            </section>

            <footer class="guide-footer">
                <div><i class="bi bi-check2-circle"></i><span><b>پایان راهنمای نامه داخلی</b><small>اکنون می‌توانید به کارتابل برگردید و کار را شروع کنید.</small></span></div>
                <button type="button" class="guide-button primary no-print" @onclick="BackToLetters"><i class="bi bi-arrow-right"></i> بازگشت به نامه‌ها</button>
            </footer>
        </main>
    </div>
</div>

@code {
    [Parameter] public EventCallback OnBack { get; set; }

    private Task BackToLetters()
        => OnBack.InvokeAsync();

    private async Task ScrollTo(string sectionId)
        => await JS.InvokeVoidAsync("scrollIntoViewById", sectionId, "start", "smooth");

    private async Task PrintGuide()
        => await JS.InvokeVoidAsync("print");
}
