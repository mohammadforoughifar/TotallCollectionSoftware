@page "/letters/view/{LetterId:int}"
@inject NavigationManager Nav

@* ============================================================
   مسیر قدیمی مشاهده نامه (لینک نوتیفیکیشن‌ها) —
   در طرح مصوب، خواندن نامه داخل خود کارتابل انجام می‌شود؛
   این مسیر فقط به کارتابل با نامه بازشده هدایت می‌کند.
   ============================================================ *@

@code {
    [Parameter] public int LetterId { get; set; }

    protected override void OnInitialized() =>
        Nav.NavigateTo($"letters?open={LetterId}", replace: true);
}
