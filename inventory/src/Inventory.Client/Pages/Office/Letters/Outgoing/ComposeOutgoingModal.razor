    }
    private async Task SearchRel()
    {
        try
        {
            var res = await OutgoingSvc.PickAsync(string.IsNullOrWhiteSpace(relSearch) ? null : relSearch);
            relResults = res.Where(r => related.All(x => x.RelateLetterId != r.LetterId)).ToList();
        }
        catch { relResults = new(); }
    }
    private void ToggleRelSel(int id) { if (!relSel.Remove(id)) relSel.Add(id); }
    private void AddRel()
    {
        if (relSel.Count == 0) { Toast.Error("هیچ نامه‌ای انتخاب نشده."); return; }
        foreach (var id in relSel)
        {
            var l = relResults.FirstOrDefault(x => x.LetterId == id);
            if (l == null) continue;
            related.Add(new RelatedLetterDto
            {
                Related = relType,
                RelateLetterId = l.LetterId,
                RelateLetterNumber = l.LetterNumber,
                RelateLetterTitle = l.Title
            });
        }
        relOpen = false;
        Toast.Success("نامه مرتبط افزوده شد.");
    }

