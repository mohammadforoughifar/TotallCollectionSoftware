    private bool Validate()
    {
        errTitle = string.IsNullOrWhiteSpace(title);
        errReceiverOrg = string.IsNullOrWhiteSpace(receiverOrg);
        // 🔒 حداقل یک امضا کننده الزامی است
        errSigners = signerSelections.Count == 0 && signerSelGroups.Count == 0;
        if (errTitle || errReceiverOrg || errSigners)
        {
            Toast.Error(errSigners && !errTitle && !errReceiverOrg
                ? "نامه صادره باید حداقل یک امضا کننده داشته باشد."
                : "موارد الزامی را تکمیل کنید.");
            return false;
        }
        return true;
    }

    private async Task Send()
    {
        if (!Validate()) return;
        busy = true;
        try
        {
            var dto = new AddOutgoingLetterDto
            {
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                Foriat = foriat,
                Mahramanegi = mahram,
                ReceiverOrganization = receiverOrg.Trim(),
                ReceiverName = receiverName?.Trim(),
                ReceiverTitle = receiverTitle?.Trim(),
                ReceiverAddress = receiverAddress?.Trim(),
                CopyTo = null,
                CopyTos = CopyRowsForSave(),
                ExternalRefNumber = externalRef?.Trim(),
                CompanyId = companyId > 0 ? companyId : null,
                ReciversGirande = rcvUsers.ToList(),
                GroupsGirande = rcvGroups.ToList(),
                ReciversErja = erjaUsers.ToList(),
                GroupsErja = erjaGroups.ToList(),
                ReciversHamesh = hameshUsers.ToList(),
                GroupsHamesh = hameshGroups.ToList(),
                SignerSelections = signerSelections.ToList(),
                SignerGroupIds = signerSelGroups.ToList(),
                RelatedLetters = related,
                FromPishnevisId = draftId
            };
            var letterId = await OutgoingSvc.SendAsync(dto);
            await UploadPendingAsync(id => OutgoingSvc.UploadAttachmentAsync(letterId, id.stream, id.name, id.type));
            Toast.Success("نامه صادره با موفقیت ثبت شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

