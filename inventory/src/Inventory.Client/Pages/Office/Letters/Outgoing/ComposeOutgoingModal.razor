@inject IOutgoingLetterService OutgoingSvc
@inject IToastService Toast
@inject IJSRuntime JS

@* ============================================================
   فرم ایجاد نامه صادره — مشابه داخلی اما با گیرنده بیرونی
   • گیرنده بیرونی الزامی (سازمان/شخص)
   • گیرندگان داخلی جهت گردش تایید (اختیاری)
   • فوریت و محرمانگی
   • ادیتور متن غنی + پیوست + عطف/پیرو
   • ذخیره پیش‌نویس + ویرایش
   ============================================================ *@

@if (visible)
{
<div class="ltx" style="animation:none;transform:none">
    <div class="ov" @onclick="Close"></div>
    <div class="sheet" @onclick="CloseCombos">
        <div class="sheet-h">
            <b><i class="bi bi-send" style="color:var(--p2)"></i> @SheetTitle</b>
            <span class="dt"><i class="bi bi-calendar3"></i> @DateTime.Now.ToFa()</span>
            <button class="x" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="sheet-b">

            @* ---------- گیرنده بیرونی ---------- *@
            <div class="fcard @(errReceiverOrg ? "err" : "")">
                <label>سازمان مقصد <span class="req">* — نامه صادره</span></label>
                <input class="tin" placeholder="نام سازمان/شرکت مقصد…" @bind="receiverOrg" @bind:event="oninput" />
                @if (errReceiverOrg)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> نام سازمان مقصد الزامی است</div>
                }
            </div>

            <div class="row3">
                <div class="fcard">
                    <label>نام گیرنده <span class="opt">اختیاری</span></label>
                    <input class="tin" placeholder="نام شخص گیرنده…" @bind="receiverName" />
                </div>
                <div class="fcard">
                    <label>سمت گیرنده <span class="opt">اختیاری</span></label>
                    <input class="tin" placeholder="سمت در سازمان مقصد…" @bind="receiverTitle" />
                </div>
                <div class="fcard">
                    <label>شماره مرجع خارجی <span class="opt">اختیاری</span></label>
                    <input class="tin" placeholder="شماره نامه طرف مقابل…" @bind="externalRef" />
                </div>
            </div>

            <div class="fcard">
                <label>آدرس/توضیحات مقصد <span class="opt">اختیاری</span></label>
                <input class="tin" placeholder="آدرس یا توضیحات…" @bind="receiverAddress" />
            </div>

            <div class="fcard">
                <label>رونوشت (Copy To) <span class="opt">اختیاری — متن آزاد</span></label>
                <input class="tin" placeholder="مثلاً: واحد مالی - جهت اطلاع…" @bind="copyTo" />
            </div>

            @* ---------- گردش داخلی جهت تایید + امضا کنندگان ---------- *@
            <div class="row3">
                <LetterPickCombo @ref="cbRcv" Label="گیرنده داخلی (تایید)" Icon="bi-person-check"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="rcvUsers" SelectedGroups="rcvGroups"
                                 Changed="OnRcvChanged" />
                <LetterPickCombo @ref="cbErja" Label="ارجاع داخلی" Icon="bi-arrow-left-circle"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="erjaUsers" SelectedGroups="erjaGroups" />
                <LetterPickCombo @ref="cbHamesh" Label="هامش داخلی" Icon="bi-people"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="hameshUsers" SelectedGroups="hameshGroups" />
            </div>

            <div class="row2">
                <LetterPickCombo @ref="cbSigners" Label="امضا کنندگان (بر اساس دسترسی Sign)" Icon="bi-pen"
                                 Users="signerUsers" Groups="allGroups"
                                 SelectedUsers="signerSelUsers" SelectedGroups="signerSelGroups"
                                 Changed="OnSignerChanged" />
                <div class="fcard" style="display:flex;align-items:center;gap:8px;padding:10px">
                    <i class="bi bi-info-circle" style="color:var(--p2)"></i>
                    <small>امضا کنندگان فقط از بین کاربران دارای دسترسی <code>OutgoingLetters.Sign</code> قابل انتخاب هستند. وقتی امضا شد شماره صادره (SadereNumber) مقدار می‌گیرد.</small>
                </div>
            </div>

            <div class="row2">
                <div class="fcard">
                    <label>فوریت نامه</label>
                    <div class="rads">
                        @foreach (var f in new[] { "عادی", "فوری", "آنی" })
                        {
                            var v = f;
                            <div class="rad @(foriat == v ? "on" : "")" @onclick="() => foriat = v"><span class="rdot"></span> @v</div>
                        }
                    </div>
                </div>
                <div class="fcard">
                    <label>محرمانگی نامه</label>
                    <div class="rads">
                        @foreach (var m in new[] { "عادی", "محرمانه", "سری" })
                        {
                            var v = m;
                            <div class="rad @(mahram == v ? "on" : "")" @onclick="() => mahram = v"><span class="rdot"></span> @v</div>
                        }
                    </div>
                </div>
            </div>

            <div class="fcard @(errTitle ? "err" : "")">
                <label>عنوان نامه <span class="req">*</span></label>
                <input class="tin" placeholder="عنوان نامه را وارد کنید…" @bind="title" @bind:event="oninput" />
                @if (errTitle)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> عنوان نامه الزامی است</div>
                }
            </div>

            <div class="fcard">
                <label>متن نامه</label>
                <div class="edt">
                    <div class="edt-bar">
                        <button type="button" @onclick='() => Ed("undo")'><i class="bi bi-arrow-clockwise"></i></button>
                        <button type="button" @onclick='() => Ed("redo")'><i class="bi bi-arrow-counterclockwise"></i></button>
                        <span class="sep"></span>
                        <button type="button" @onclick='() => Ed("bold")'><i class="bi bi-type-bold"></i></button>
                        <button type="button" @onclick='() => Ed("italic")'><i class="bi bi-type-italic"></i></button>
                        <button type="button" @onclick='() => Ed("underline")'><i class="bi bi-type-underline"></i></button>
                        <span class="sep"></span>
                        <button type="button" @onclick='() => Ed("justifyRight")'><i class="bi bi-text-right"></i></button>
                        <button type="button" @onclick='() => Ed("justifyCenter")'><i class="bi bi-text-center"></i></button>
                        <button type="button" @onclick='() => Ed("justifyLeft")'><i class="bi bi-text-left"></i></button>
                    </div>
                    <div class="edt-body" id="ltxOutEditor" contenteditable="true" data-ph="متن نامه صادره را بنویسید…"></div>
                </div>
            </div>

            <div class="fcard">
                <label>پیوست</label>
                <div class="dz">
                    <div class="ic"><i class="bi bi-cloud-arrow-up"></i></div>
                    <div><b>فایل را بکشید و رها کنید یا کلیک کنید</b><small>بدون محدودیت تعداد — هر فایل حداکثر ۲۰ مگابایت</small></div>
                    <InputFile OnChange="OnFiles" multiple />
                </div>
                <div class="selpills">
                    @foreach (var f in pendingFiles)
                    {
                        var ff = f;
                        <span class="spill"><i class="bi @FileIcon(ff.Name)"></i> @ff.Name <small>(@FmtSize(ff.Size))</small> <i class="bi bi-x-lg" @onclick="() => pendingFiles.Remove(ff)"></i></span>
                    }
                    @foreach (var a in savedAtts)
                    {
                        var aa = a;
                        <span class="spill"><i class="bi @FileIcon(aa.FileName)"></i> @aa.FileName <small>(@FmtSize(aa.Size))</small> <i class="bi bi-x-lg" @onclick="() => RemoveSavedAtt(aa)"></i></span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(fileErr))
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> @fileErr</div>
                }
            </div>

            <div class="fcard">
                <label>نامه‌های مرتبط (عطف / پیرو) <span class="opt">اختیاری</span></label>
                <div class="selpills" style="margin-top:0">
                    @foreach (var r in related)
                    {
                        var rr = r;
                        <span class="rpill">
                            <span class="k @(rr.Related == 2 ? "atf" : "peyro")">@(rr.Related == 2 ? "عطف" : "پیرو")</span>
                            <span class="num"># @rr.RelateLetterNumber.FaDigits()</span> @rr.RelateLetterTitle
                            <i class="bi bi-x-lg" @onclick="() => related.Remove(rr)"></i>
                        </span>
                    }
                    <button type="button" class="addrel" @onclick="OpenRel"><i class="bi bi-plus-lg"></i> ثبت نامه مرتبط</button>
                </div>
            </div>
        </div>
        <div class="sheet-f">
            @if (isEditLetter)
            {
                <button class="lbtn grn" disabled="@busy" @onclick="SubmitEdit">
                    @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-check-lg"></i> ذخیره تغییرات
                </button>
            }
            else
            {
                <button class="lbtn grn" disabled="@busy" @onclick="Send">
                    @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-send"></i> ثبت و ارسال صادره
                </button>
                <button class="lbtn pri" disabled="@busy" @onclick="SaveDraft"><i class="bi bi-save"></i> ذخیره پیش‌نویس</button>
            }
            <span class="spacer"></span>
            <button class="lbtn red" @onclick="Close"><i class="bi bi-x-lg"></i> انصراف</button>
        </div>
    </div>

    @if (relOpen)
    {
        <div class="gov" @onclick="CloseRelIfSelf">
            <div class="gmodal" style="width:min(640px,96vw)" @onclick:stopPropagation="true">
                <div class="gm-h">
                    <div class="ttl"><b><i class="bi bi-link-45deg" style="color:var(--p2)"></i> ثبت نامه مرتبط</b><small>نوع رابطه و نامه‌ها را انتخاب کنید</small></div>
                    <button class="x" @onclick="() => relOpen = false"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="gm-seg">
                    <button class="@(relType == 2 ? "on" : "")" @onclick="() => relType = 2"><i class="bi bi-arrow-90deg-right"></i> عطف به</button>
                    <button class="@(relType == 1 ? "on" : "")" @onclick="() => relType = 1"><i class="bi bi-arrow-return-left"></i> پیرو</button>
                </div>
                <div class="gm-b">
                    <input class="tin" style="margin-bottom:9px" placeholder="جستجوی شماره یا عنوان…"
                           @bind="relSearch" @bind:event="oninput" @bind:after="SearchRel" />
                    @foreach (var l in relResults)
                    {
                        var rl = l;
                        <div class="rl-row @(relSel.Contains(rl.LetterId) ? "on" : "")" @onclick="() => ToggleRelSel(rl.LetterId)">
                            <span class="chk"><i class="bi bi-check"></i></span>
                            <div class="inf"><b>@rl.Title</b><small class="num"># @rl.LetterNumber.FaDigits() · @rl.Date.ToFa() — @rl.SourceTypeTitle</small></div>
                            <span class="rl-dir @(rl.IsSent ? "out" : "in")">
                                <i class="bi @(rl.IsSent ? "bi-send" : "bi-box-arrow-in-down")"></i>
                                @(rl.IsSent ? "ارسالی" : "دریافتی")
                            </span>
                        </div>
                    }
                    @if (relResults.Count == 0) { <div class="cempty">نامه‌ای یافت نشد</div> }
                </div>
                <div class="gm-f">
                    <button class="lbtn ghost" @onclick="() => relOpen = false">انصراف</button>
                    <button class="lbtn pri" @onclick="AddRel"><i class="bi bi-check-lg"></i> افزودن نامه‌های انتخابی</button>
                </div>
            </div>
        </div>
    }
</div>
}

@code {
    [Parameter] public EventCallback OnSent { get; set; }

    private const long MaxFile = 20L * 1024 * 1024;

    private bool visible;
    private bool busy;
    private bool isEditLetter;
    private int editLetterId;
    private int? draftId;

    private string title = "";
    private string receiverOrg = "";
    private string? receiverName;
    private string? receiverTitle;
    private string? receiverAddress;
    private string? copyTo;
    private string? externalRef;
    private string foriat = "عادی";
    private string mahram = "عادی";
    private string pendingBody = "";

    private bool errTitle, errReceiverOrg;
    private List<LetterReciverDto> allUsers = new();
    private List<LetterGroupDto> allGroups = new();

    private LetterPickCombo? cbRcv, cbErja, cbHamesh, cbSigners;
    private HashSet<int> rcvUsers = new(), rcvGroups = new();
    private HashSet<int> erjaUsers = new(), erjaGroups = new();
    private HashSet<int> hameshUsers = new(), hameshGroups = new();
    private HashSet<int> signerSelUsers = new(), signerSelGroups = new();
    private List<LetterReciverDto> signerUsers = new();

    private List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> pendingFiles = new();
    private List<LetterAttachmentDto> savedAtts = new();
    private string fileErr = "";

    private List<RelatedLetterDto> related = new();
    private bool relOpen;
    private int relType = 2;
    private string relSearch = "";
    private List<OutgoingLetterPickDto> relResults = new();
    private HashSet<int> relSel = new();

    private string SheetTitle => isEditLetter ? "ویرایش نامه صادره" : draftId is > 0 ? "ادامه پیش‌نویس صادره" : "ایجاد نامه صادره جدید";

    public void Open(string? prefTitle = null, string? prefText = null, int? pishnevisId = null, string? prefReceiverOrg = null)
    {
        ResetAll();
        title = prefTitle ?? "";
        pendingBody = prefText ?? "";
        receiverOrg = prefReceiverOrg ?? "";
        draftId = pishnevisId;
        visible = true;
        _ = LoadListsAsync();
        if (pishnevisId is > 0) _ = LoadDraftAttsAsync(pishnevisId.Value);
        StateHasChanged();
        _ = SetEditorSoonAsync();
    }

    public void OpenEdit(OutgoingLetterDetailDto letter)
    {
        ResetAll();
        isEditLetter = true;
        editLetterId = letter.LetterId;
        title = letter.Title;
        foriat = letter.Foriat;
        mahram = letter.Mahramanegi;
        pendingBody = letter.Text ?? "";
        receiverOrg = letter.ReceiverOrganization;
        receiverName = letter.ReceiverName;
        receiverTitle = letter.ReceiverTitle;
        receiverAddress = letter.ReceiverAddress;
        copyTo = letter.CopyTo;
        externalRef = letter.ExternalRefNumber;

        foreach (var r in letter.ReciversGirande) rcvUsers.Add(r.UserId);
        foreach (var r in letter.ReciversErja) erjaUsers.Add(r.UserId);
        foreach (var r in letter.ReciversHamesh) hameshUsers.Add(r.UserId);
        foreach (var s in letter.Signers) signerSelUsers.Add(s.UserId);

        related = letter.RelatedLetters.Select(r => new RelatedLetterDto
        {
            Related = r.Related,
            RelateLetterId = r.RelateLetterId,
            RelateLetterNumber = r.RelateLetterNumber,
            RelateLetterTitle = r.RelateLetterTitle
        }).ToList();

        visible = true;
        _ = LoadListsAsync();
        _ = LoadLetterAttsAsync(letter.LetterId);
        StateHasChanged();
        _ = SetEditorSoonAsync();
    }

    private async Task LoadLetterAttsAsync(int letterId)
    {
        try { savedAtts = await OutgoingSvc.GetAttachmentsAsync(letterId); StateHasChanged(); }
        catch { }
    }

    private void ResetAll()
    {
        isEditLetter = false; editLetterId = 0; draftId = null;
        title = ""; receiverOrg = ""; receiverName = null; receiverTitle = null; receiverAddress = null; copyTo = null; externalRef = null;
        foriat = "عادی"; mahram = "عادی"; pendingBody = "";
        errTitle = errReceiverOrg = false; fileErr = "";
        rcvUsers.Clear(); rcvGroups.Clear();
        erjaUsers.Clear(); erjaGroups.Clear();
        hameshUsers.Clear(); hameshGroups.Clear();
        signerSelUsers.Clear(); signerSelGroups.Clear();
        pendingFiles.Clear(); savedAtts.Clear();
        related.Clear(); relOpen = false; relSel.Clear();
    }

    private async Task SetEditorSoonAsync()
    {
        await Task.Delay(60);
        try { await JS.InvokeVoidAsync("rteSetHtml", "ltxOutEditor", pendingBody); } catch { }
    }

    private async Task LoadListsAsync()
    {
        try
        {
            if (allUsers.Count == 0) allUsers = await OutgoingSvc.GetReciversAsync();
            allGroups = await OutgoingSvc.GetGroupsAsync();
            try { signerUsers = await OutgoingSvc.GetAvailableSignersAsync(); } catch { signerUsers = allUsers; }
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task LoadDraftAttsAsync(int pishId)
    {
        try { savedAtts = await OutgoingSvc.GetPishnevisAttachmentsAsync(pishId); StateHasChanged(); }
        catch { }
    }

    private void Close() => visible = false;
    private void CloseCombos() { cbRcv?.Close(); cbErja?.Close(); cbHamesh?.Close(); cbSigners?.Close(); }
    private void OnRcvChanged() { }
    private void OnSignerChanged() { }

    private async Task Ed(string cmd)
    {
        try { await JS.InvokeVoidAsync("rteExec", cmd); } catch { }
    }

    private void OnFiles(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var rejected = new List<string>();
        foreach (var f in e.GetMultipleFiles(100))
        {
            if (f.Size <= 0) { rejected.Add($"{f.Name} (خالی)"); continue; }
            if (f.Size > MaxFile) { rejected.Add($"{f.Name} (بیش از ۲۰MB)"); continue; }
            if (pendingFiles.Any(x => x.Name == f.Name && x.Size == f.Size) ||
                savedAtts.Any(x => x.FileName == f.Name && x.Size == f.Size))
            { rejected.Add($"{f.Name} (تکراری)"); continue; }
            pendingFiles.Add(f);
        }
        fileErr = rejected.Count > 0 ? "رد شده: " + string.Join("، ", rejected) : "";
        if (rejected.Count > 0) Toast.Error("برخی فایل‌ها پذیرفته نشدند.");
    }

    private async Task RemoveSavedAtt(LetterAttachmentDto a)
    {
        try { await OutgoingSvc.DeleteAttachmentAsync(a.Id); savedAtts.Remove(a); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static string FmtSize(long b) =>
        b >= 1024 * 1024 ? $"{b / 1024.0 / 1024.0:0.#} مگابایت".FaDigits()
        : b >= 1024 ? $"{b / 1024} کیلوبایت".FaDigits()
        : $"{b} بایت".FaDigits();

    private static string FileIcon(string name)
    {
        var e = (Path.GetExtension(name) ?? "").TrimStart('.').ToLowerInvariant();
        return e switch
        {
            "pdf" => "bi-file-earmark-pdf",
            "xls" or "xlsx" or "csv" => "bi-file-earmark-excel",
            "doc" or "docx" => "bi-file-earmark-word",
            "png" or "jpg" or "jpeg" or "gif" or "webp" or "svg" => "bi-file-earmark-image",
            "zip" or "rar" or "7z" => "bi-file-earmark-zip",
            _ => "bi-file-earmark"
        };
    }

    private async Task OpenRel()
    {
        relSel.Clear(); relSearch = ""; relOpen = true;
        await SearchRel();
    }
    private void CloseRelIfSelf() => relOpen = false;
    private async Task SearchRel()
    {
        try
        {
            var res = await OutgoingSvc.PickAsync(string.IsNullOrWhiteSpace(relSearch) ? null : relSearch);
            relResults = res.Where(r => related.All(x => x.RelateLetterId != r.LetterId)).ToList();
        }
        catch { relResults = new(); }
    }
    private void ToggleRelSel(int id) { if (!relSel.Remove(id)) relSel.Add(id); }
    private void AddRel()
    {
        if (relSel.Count == 0) { Toast.Error("هیچ نامه‌ای انتخاب نشده."); return; }
        foreach (var id in relSel)
        {
            var l = relResults.FirstOrDefault(x => x.LetterId == id);
            if (l == null) continue;
            related.Add(new RelatedLetterDto
            {
                Related = relType,
                RelateLetterId = l.LetterId,
                RelateLetterNumber = l.LetterNumber,
                RelateLetterTitle = l.Title
            });
        }
        relOpen = false;
        Toast.Success("نامه مرتبط افزوده شد.");
    }

    private async Task<string> EditorHtmlAsync()
    {
        try { return await JS.InvokeAsync<string>("rteGetHtml", "ltxOutEditor") ?? ""; }
        catch { return pendingBody; }
    }

    private bool Validate()
    {
        errTitle = string.IsNullOrWhiteSpace(title);
        errReceiverOrg = string.IsNullOrWhiteSpace(receiverOrg);
        if (errTitle || errReceiverOrg) { Toast.Error("موارد الزامی را تکمیل کنید."); return false; }
        return true;
    }

    private async Task Send()
    {
        if (!Validate()) return;
        busy = true;
        try
        {
            var dto = new AddOutgoingLetterDto
            {
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                Foriat = foriat,
                Mahramanegi = mahram,
                ReceiverOrganization = receiverOrg.Trim(),
                ReceiverName = receiverName?.Trim(),
                ReceiverTitle = receiverTitle?.Trim(),
                ReceiverAddress = receiverAddress?.Trim(),
                CopyTo = copyTo?.Trim(),
                ExternalRefNumber = externalRef?.Trim(),
                ReciversGirande = rcvUsers.ToList(),
                GroupsGirande = rcvGroups.ToList(),
                ReciversErja = erjaUsers.ToList(),
                GroupsErja = erjaGroups.ToList(),
                ReciversHamesh = hameshUsers.ToList(),
                GroupsHamesh = hameshGroups.ToList(),
                SignerUserIds = signerSelUsers.ToList(),
                SignerGroupIds = signerSelGroups.ToList(),
                RelatedLetters = related,
                FromPishnevisId = draftId
            };
            var letterId = await OutgoingSvc.SendAsync(dto);
            await UploadPendingAsync(id => OutgoingSvc.UploadAttachmentAsync(letterId, id.stream, id.name, id.type));
            Toast.Success("نامه صادره با موفقیت ثبت شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SaveDraft()
    {
        if (string.IsNullOrWhiteSpace(title)) { errTitle = true; Toast.Error("عنوان لازم است."); return; }
        busy = true;
        try
        {
            var id = await OutgoingSvc.SavePishnevisAsync(new OutgoingPishnevisDto
            {
                PishnevisId = draftId ?? 0,
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                ReceiverOrganization = receiverOrg?.Trim(),
                ReceiverName = receiverName?.Trim(),
                ReceiverTitle = receiverTitle?.Trim()
            });
            await UploadPendingAsync(x => OutgoingSvc.UploadPishnevisAttachmentAsync(id, x.stream, x.name, x.type));
            Toast.Success("پیش‌نویس صادره ذخیره شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SubmitEdit()
    {
        if (!Validate()) return;
        busy = true;
        try
        {
            await OutgoingSvc.EditAsync(editLetterId, new EditOutgoingLetterDto
            {
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                Foriat = foriat,
                Mahramanegi = mahram,
                ReceiverOrganization = receiverOrg.Trim(),
                ReceiverName = receiverName?.Trim(),
                ReceiverTitle = receiverTitle?.Trim(),
                ReceiverAddress = receiverAddress?.Trim(),
                CopyTo = copyTo?.Trim(),
                ExternalRefNumber = externalRef?.Trim(),
                ReciversGirande = rcvUsers.ToList(),
                GroupsGirande = rcvGroups.ToList(),
                ReciversErja = erjaUsers.ToList(),
                GroupsErja = erjaGroups.ToList(),
                ReciversHamesh = hameshUsers.ToList(),
                GroupsHamesh = hameshGroups.ToList(),
                SignerUserIds = signerSelUsers.ToList(),
                SignerGroupIds = signerSelGroups.ToList(),
                RelatedLetters = related
            });
            await UploadPendingAsync(x => OutgoingSvc.UploadAttachmentAsync(editLetterId, x.stream, x.name, x.type));
            Toast.Success("نامه صادره ویرایش شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task UploadPendingAsync(Func<(Stream stream, string name, string type), Task> uploader)
    {
        foreach (var f in pendingFiles)
        {
            try
            {
                await using var s = f.OpenReadStream(MaxFile);
                await uploader((s, f.Name, f.ContentType));
            }
            catch (Exception ex) { Toast.Error($"بارگذاری {f.Name}: {ex.Message}"); }
        }
        pendingFiles.Clear();
    }
}
