    private async Task SubmitEdit()
    {
        if (!Validate()) return;
        busy = true;
        try
        {
            await OutgoingSvc.EditAsync(editLetterId, new EditOutgoingLetterDto
            {
                Title = title.Trim(),
                Text = await EditorHtmlAsync(),
                Foriat = foriat,
                Mahramanegi = mahram,
                ReceiverOrganization = receiverOrg.Trim(),
                ReceiverName = receiverName?.Trim(),
                ReceiverTitle = receiverTitle?.Trim(),
                ReceiverAddress = receiverAddress?.Trim(),
                CopyTo = null,
                CopyTos = CopyRowsForSave(),
                ExternalRefNumber = externalRef?.Trim(),
                CompanyId = companyId > 0 ? companyId : null,
                ReciversGirande = rcvUsers.ToList(),
                GroupsGirande = rcvGroups.ToList(),
                ReciversErja = erjaUsers.ToList(),
                GroupsErja = erjaGroups.ToList(),
                ReciversHamesh = hameshUsers.ToList(),
                GroupsHamesh = hameshGroups.ToList(),
                SignerSelections = signerSelections.ToList(),
                SignerGroupIds = signerSelGroups.ToList(),
                RelatedLetters = related
            });
            // رونوشت‌گیرندگان پس از ویرایشِ خودِ نامه جایگزین می‌شوند (جدول مستقل)
            await OutgoingSvc.ReplaceCopyTosAsync(editLetterId, CopyRowsForSave());
            await UploadPendingAsync(x => OutgoingSvc.UploadAttachmentAsync(editLetterId, x.stream, x.name, x.type));
            Toast.Success("نامه صادره ویرایش شد.");
            visible = false;
            await OnSent.InvokeAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task UploadPendingAsync(Func<(Stream stream, string name, string type), Task> uploader)
    {
        foreach (var f in pendingFiles)
        {
            try
            {
                await using var s = f.OpenReadStream(long.MaxValue);
                await uploader((s, f.Name, f.ContentType));
            }
            catch (Exception ex) { Toast.Error($"بارگذاری {f.Name}: {ex.Message}"); }
        }
        pendingFiles.Clear();
    }
