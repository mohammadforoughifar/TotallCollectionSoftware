@inject IOutgoingLetterService OutgoingSvc
@inject IJSRuntime JS
@inject IToastService Toast
@inject IJSRuntime JS

@* ============================================================
   فرم ایجاد نامه صادره — مشابه داخلی اما با گیرنده بیرونی
   • گیرنده بیرونی الزامی (سازمان/شخص)
   • گیرندگان داخلی جهت گردش تایید (اختیاری)
   • فوریت و محرمانگی
   • ادیتور متن غنی + پیوست + عطف/پیرو
   • ذخیره پیش‌نویس + ویرایش
   ============================================================ *@

@if (visible)
{
<div class="ltx" style="animation:none;transform:none">
    <div class="ov"></div>
    <div class="sheet" @onclick="CloseCombos">
        <div class="sheet-h">
            <b><i class="bi bi-send" style="color:var(--p2)"></i> @SheetTitle</b>
            <span class="dt"><i class="bi bi-calendar3"></i> @DateTime.Now.ToFa()</span>
            <button class="x" @onclick="Close"><i class="bi bi-x-lg"></i></button>
        </div>
        <div class="sheet-b">

            @* ---------- گیرنده بیرونی ---------- *@
            <div class="fcard @(errReceiverOrg ? "err" : "")">
                <label>سازمان مقصد <span class="req">* — نامه صادره</span></label>
                <input class="tin" placeholder="نام سازمان/شرکت مقصد…" @bind="receiverOrg" @bind:event="oninput" />
                @if (errReceiverOrg)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> نام سازمان مقصد الزامی است</div>
                }
            </div>

            <div class="row3">
                <div class="fcard">
                    <label>نام گیرنده <span class="opt">اختیاری</span></label>
                    <input class="tin" placeholder="نام شخص گیرنده…" @bind="receiverName" />
                </div>
                <div class="fcard">
                    <label>سمت گیرنده <span class="opt">اختیاری</span></label>
                    <input class="tin" placeholder="سمت در سازمان مقصد…" @bind="receiverTitle" />
                </div>
                <div class="fcard">
                    <label>شماره مرجع خارجی <span class="opt">اختیاری</span></label>
                    <input class="tin" placeholder="شماره نامه طرف مقابل…" @bind="externalRef" />
                </div>
            </div>

            <div class="fcard">
                <label>آدرس/توضیحات مقصد <span class="opt">اختیاری</span></label>
                <input class="tin" placeholder="آدرس یا توضیحات…" @bind="receiverAddress" />
            </div>

            @* رونوشت‌گیرندگان — هر گیرنده یک ردیف مستقل در جدول OutgoingLetterCopyToes.
               کاربر آن‌ها را یکی‌یکی با دکمهٔ «افزودن رونوشت» می‌سازد و چاپِ
               «با رونوشت» مستقیماً از همین جدول می‌خواند. *@
            <div class="fcard">
                <div style="display:flex;align-items:center;gap:8px;margin-bottom:6px">
                    <label style="margin:0">رونوشت‌گیرندگان <span class="opt">اختیاری</span></label>
                    <span style="flex:1"></span>
                    <button type="button" class="lbtn ghost" style="padding:4px 10px;font-size:12px" @onclick="AddCopyRow">
                        <i class="bi bi-plus-lg"></i> افزودن رونوشت
                    </button>
                </div>

                @if (copyRows.Count == 0)
                {
                    <div style="color:#64748b;font-size:12.5px;padding:6px 0">
                        رونوشتی ثبت نشده است — با دکمهٔ «افزودن رونوشت» گیرندگان را یکی‌یکی اضافه کنید.
                    </div>
                }
                else
                {
                    <table style="width:100%;border-collapse:collapse;font-size:12.5px">
                        <thead>
                            <tr style="background:#f8fafc">
                                <th style="padding:6px 8px;border:1px solid #e2e8f0;width:34px">#</th>
                                <th style="padding:6px 8px;border:1px solid #e2e8f0">نام رونوشت‌گیرنده <span class="req">*</span></th>
                                <th style="padding:6px 8px;border:1px solid #e2e8f0">توضیح/سمت <span class="opt">اختیاری</span></th>
                                <th style="padding:6px 8px;border:1px solid #e2e8f0;width:130px">شماره مرجع <span class="opt">اختیاری</span></th>
                                <th style="padding:6px 8px;border:1px solid #e2e8f0;width:38px"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (var i = 0; i < copyRows.Count; i++)
                            {
                                var idx = i;
                                var row = copyRows[idx];
                                <tr>
                                    <td class="num" style="padding:4px 8px;border:1px solid #e2e8f0;text-align:center;color:#64748b">@((idx + 1).FaDigits())</td>
                                    <td style="padding:4px;border:1px solid #e2e8f0">
                                        <input class="tin" style="width:100%" placeholder="مثلاً: واحد مالی" @bind="row.Name" />
                                    </td>
                                    <td style="padding:4px;border:1px solid #e2e8f0">
                                        <input class="tin" style="width:100%" placeholder="مثلاً: جهت اطلاع" @bind="row.Desc" />
                                    </td>
                                    <td style="padding:4px;border:1px solid #e2e8f0">
                                        <input class="tin num" style="width:100%" placeholder="اختیاری" @bind="row.RefNo" />
                                    </td>
                                    <td style="padding:4px;border:1px solid #e2e8f0;text-align:center">
                                        <i class="bi bi-x-lg" style="cursor:pointer;color:#dc2626" title="حذف این رونوشت"
                                           @onclick="() => copyRows.RemoveAt(idx)"></i>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    <div style="font-size:11.5px;color:#64748b;margin-top:5px">
                        <i class="bi bi-info-circle"></i> در نسخهٔ چاپ «با رونوشت»، هر گیرنده در یک سطر جداگانه درج می‌شود.
                    </div>
                }
            </div>

            @* ---------- گردش داخلی جهت تایید + امضا کنندگان ---------- *@
            <div class="row3">
                <LetterPickCombo @ref="cbRcv" Label="گیرنده داخلی (تایید)" Icon="bi-person-check"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="rcvUsers" SelectedGroups="rcvGroups"
                                 Changed="OnRcvChanged" />
                <LetterPickCombo @ref="cbErja" Label="ارجاع داخلی" Icon="bi-arrow-left-circle"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="erjaUsers" SelectedGroups="erjaGroups" />
                <LetterPickCombo @ref="cbHamesh" Label="هامش داخلی" Icon="bi-people"
                                 Users="allUsers" Groups="allGroups"
                                 SelectedUsers="hameshUsers" SelectedGroups="hameshGroups" />
            </div>

            <div class="row2">
                <div>
                    <div class="fcard @(errSigners ? "err" : "")">
                        <label><i class="bi bi-pen"></i> امضاکنندگان <span class="req">*</span></label>
                        <button type="button" class="tin signer-combo-trigger" @onclick="() => signerPickerOpen = !signerPickerOpen">
                            <span><i class="bi bi-person-lines-fill"></i> انتخاب نام و سمت امضاکننده</span>
                            <span>@signerSelections.Count.FaDigits() انتخاب <i class="bi bi-chevron-down"></i></span>
                        </button>
                        @if (signerPickerOpen)
                        {
                            <div class="signer-picker-panel">
                                <input class="tin mb-2" placeholder="جستجو بر اساس نام یا سمت…" @bind="signerQuery" @bind:event="oninput" />
                                <div class="signer-options">
                                    @foreach (var option in FilteredSignerOptions)
                                    {
                                        var selected = IsSignerSelected(option);
                                        <button type="button" class="signer-option @(selected ? "selected" : "")" @onclick="() => ToggleSigner(option)">
                                            <span class="chk"><i class="bi bi-check"></i></span>
                                            <span>@option.FullName</span>
                                            <small><i class="bi bi-briefcase"></i> @option.PositionTitle</small>
                                        </button>
                                    }
                                    @if (FilteredSignerOptions.Count == 0) { <div class="text-muted small p-2">امضاکننده‌ای یافت نشد.</div> }
                                </div>
                            </div>
                        }
                        @if (allGroups.Count > 0)
                        {
                            <div class="mt-2 small fw-bold">افزودن گروه‌های امضاکننده</div>
                            <div class="d-flex flex-wrap gap-2 mt-1">
                                @foreach (var group in allGroups)
                                {
                                    <label class="badge rounded-pill text-bg-light border" style="cursor:pointer">
                                        <input type="checkbox" checked="@signerSelGroups.Contains(group.GroupId)" @onchange="e => ToggleSignerGroup(group.GroupId, e)" />
                                        @group.NameGroup
                                    </label>
                                }
                            </div>
                        }
                        <div class="selpills">
                            @foreach (var item in signerSelections)
                            {
                                var option = SignerOptions.FirstOrDefault(x => x.UserId == item.UserId && x.SematId == item.SematId);
                                <span class="spill">@(option?.FullName ?? item.UserId.ToString()) <small><i class="bi bi-briefcase"></i> @(option?.PositionTitle ?? "سمت ثبت‌شده")</small>
                                    <i class="bi bi-x-lg" @onclick="() => RemoveSigner(item.UserId, item.SematId)"></i></span>
                            }
                            @foreach (var gid in signerSelGroups)
                            {
                                var group = allGroups.FirstOrDefault(x => x.GroupId == gid);
                                <span class="spill gp">@(group?.NameGroup ?? gid.ToString()) <i class="bi bi-x-lg" @onclick="() => signerSelGroups.Remove(gid)"></i></span>
                            }
                        </div>
                        @if (errSigners)
                        {
                            <div class="ferr"><i class="bi bi-exclamation-circle"></i> نامه صادره باید حداقل یک امضاکننده داشته باشد.</div>
                        }
                    </div>
                </div>
                <div class="fcard" style="display:flex;align-items:center;gap:8px;padding:10px">
                    <i class="bi bi-info-circle" style="color:var(--p2)"></i>
                    <small>انتخاب <b>حداقل یک امضا کننده الزامی است</b>. امضا کنندگان از بین کاربران دارای دسترسی <code>OutgoingLetters.Sign</code> انتخاب می‌شوند و وقتی همه امضا کردند، شماره صادره (SadereNumber) مقدار می‌گیرد و نامه وارد دبیرخانه می‌شود.</small>
                </div>
            </div>

            @* ---------- شرکت صادرکننده (سربرگ چاپ) ---------- *@
            <div class="fcard">
                <label>شرکت صادرکننده (سربرگ چاپ) <span class="opt">شرکت فعال شما؛ در منوی چاپ می‌توانید چاپ با سربرگ یا بدون سربرگ را انتخاب کنید.</span></label>
                <select class="tin" @bind="companyId">
                    <option value="0">— بدون انتخاب شرکت (چاپ بدون سربرگ) —</option>
                    @if (activeCompany is { } c)
                    {
                        <option value="@c.Id">@c.Name @(c.HasLetterhead ? "📄 سربرگ" : "(بدون سربرگ)")</option>
                    }
                </select>
            </div>

            <div class="row2">
                <div class="fcard">
                    <label>فوریت نامه</label>
                    <div class="rads">
                        @foreach (var f in new[] { "عادی", "فوری", "آنی" })
                        {
                            var v = f;
                            <div class="rad @(foriat == v ? "on" : "")" @onclick="() => foriat = v"><span class="rdot"></span> @v</div>
                        }
                    </div>
                </div>
                <div class="fcard">
                    <label>محرمانگی نامه</label>
                    <div class="rads">
                        @foreach (var m in new[] { "عادی", "محرمانه", "سری" })
                        {
                            var v = m;
                            <div class="rad @(mahram == v ? "on" : "")" @onclick="() => mahram = v"><span class="rdot"></span> @v</div>
                        }
                    </div>
                </div>
            </div>

            <div class="fcard @(errTitle ? "err" : "")">
                <label>عنوان نامه <span class="req">*</span></label>
                <input class="tin" placeholder="عنوان نامه را وارد کنید…" @bind="title" @bind:event="oninput" />
                @if (errTitle)
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> عنوان نامه الزامی است</div>
                }
            </div>

            <div class="fcard">
                <label>متن نامه</label>
                <RichTextEditor @ref="_richOut" Id="ltxOutEditor" Placeholder="متن نامه صادره را بنویسید…" @bind-Value="pendingBody" Height="260" />
            </div>

            <div class="fcard">
                <label>پیوست</label>
                <div class="dz">
                    <div class="ic"><i class="bi bi-cloud-arrow-up"></i></div>
                    <div><b>فایل را بکشید و رها کنید یا کلیک کنید</b><small>بدون محدودیت تعداد و حجم</small></div>
                    <InputFile OnChange="OnFiles" multiple />
                </div>
                <div class="selpills">
                    @foreach (var f in pendingFiles)
                    {
                        var ff = f;
                        <span class="spill"><i class="bi @FileIcon(ff.Name)"></i> @ff.Name <small>(@FmtSize(ff.Size))</small> <i class="bi bi-x-lg" @onclick="() => pendingFiles.Remove(ff)"></i></span>
                    }
                    @foreach (var a in savedAtts)
                    {
                        var aa = a;
                        <span class="spill"><i class="bi @FileIcon(aa.FileName)"></i> @aa.FileName <small>(@FmtSize(aa.Size))</small> <i class="bi bi-x-lg" @onclick="() => RemoveSavedAtt(aa)"></i></span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(fileErr))
                {
                    <div class="ferr"><i class="bi bi-exclamation-circle"></i> @fileErr</div>
                }
            </div>

            <div class="fcard">
                <label>نامه‌های مرتبط (عطف / پیرو) <span class="opt">اختیاری</span></label>
                <div class="selpills" style="margin-top:0">
                    @foreach (var r in related)
                    {
                        var rr = r;
                        <span class="rpill">
                            <span class="k @(rr.Related == 2 ? "atf" : "peyro")">@(rr.Related == 2 ? "عطف" : "پیرو")</span>
                            <span class="num"># @rr.RelateLetterNumber.FaDigits()</span> @rr.RelateLetterTitle
                            <i class="bi bi-x-lg" @onclick="() => related.Remove(rr)"></i>
                        </span>
                    }
                    <button type="button" class="addrel" @onclick="OpenRel"><i class="bi bi-plus-lg"></i> ثبت نامه مرتبط</button>
                </div>
            </div>
        </div>
        <div class="sheet-f">
            @if (isEditLetter)
            {
                <button class="lbtn grn" disabled="@busy" @onclick="SubmitEdit">
                    @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-check-lg"></i> ذخیره تغییرات
                </button>
            }
            else
            {
                <button class="lbtn grn" disabled="@busy" @onclick="Send">
                    @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-send"></i> ثبت و ارسال صادره
                </button>
                <button class="lbtn pri" disabled="@busy" @onclick="SaveDraft"><i class="bi bi-save"></i> ذخیره پیش‌نویس</button>
            }
            <span class="spacer"></span>
            <button class="lbtn red" @onclick="Close"><i class="bi bi-x-lg"></i> انصراف</button>
        </div>
    </div>

    @if (relOpen)
    {
        <div class="gov">
            <div class="gmodal" style="width:min(640px,96vw)" @onclick:stopPropagation="true">
                <div class="gm-h">
                    <div class="ttl"><b><i class="bi bi-link-45deg" style="color:var(--p2)"></i> ثبت نامه مرتبط</b><small>نوع رابطه و نامه‌ها را انتخاب کنید</small></div>
                    <button class="x" @onclick="() => relOpen = false"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="gm-seg">
                    <button class="@(relType == 2 ? "on" : "")" @onclick="() => relType = 2"><i class="bi bi-arrow-90deg-right"></i> عطف به</button>
                    <button class="@(relType == 1 ? "on" : "")" @onclick="() => relType = 1"><i class="bi bi-arrow-return-left"></i> پیرو</button>
                </div>
                <div class="gm-b">
                    <input class="tin" style="margin-bottom:9px" placeholder="جستجوی شماره یا عنوان…"
                           @bind="relSearch" @bind:event="oninput" @bind:after="SearchRel" />
                    @foreach (var l in relResults)
                    {
                        var rl = l;
                        <div class="rl-row @(relSel.Contains(rl.LetterId) ? "on" : "")" @onclick="() => ToggleRelSel(rl.LetterId)">
                            <span class="chk"><i class="bi bi-check"></i></span>
                            <div class="inf"><b>@rl.Title</b><small class="num"># @rl.LetterNumber.FaDigits() · @rl.Date.ToFa() — @rl.SourceTypeTitle</small></div>
                            <span class="rl-dir @(rl.IsSent ? "out" : "in")">
                                <i class="bi @(rl.IsSent ? "bi-send" : "bi-box-arrow-in-down")"></i>
                                @(rl.IsSent ? "ارسالی" : "دریافتی")
                            </span>
                        </div>
                    }
                    @if (relResults.Count == 0) { <div class="cempty">نامه‌ای یافت نشد</div> }
                </div>
                <div class="gm-f">
                    <button class="lbtn ghost" @onclick="() => relOpen = false">انصراف</button>
                    <button class="lbtn pri" @onclick="AddRel"><i class="bi bi-check-lg"></i> افزودن نامه‌های انتخابی</button>
                </div>
            </div>
        </div>
    }
</div>
}

<style>
.signer-combo-trigger{display:flex;justify-content:space-between;align-items:center;text-align:right;width:100%;cursor:pointer}
.signer-picker-panel{position:relative;z-index:5;background:white;border:1px solid #e2e8f0;border-radius:8px;padding:8px;margin-top:4px;box-shadow:0 8px 24px #0f172a1a}
.signer-options{max-height:210px;overflow:auto;border:1px solid #e2e8f0;border-radius:8px;padding:4px;display:grid;gap:3px}
.signer-option{display:flex;align-items:center;gap:8px;width:100%;text-align:right;background:#fff;border:0;border-radius:6px;padding:7px 9px;color:inherit}
.signer-option:hover,.signer-option.selected{background:#eef2ff}
.signer-option .chk{width:17px;height:17px;border:1px solid #94a3b8;border-radius:4px;display:inline-flex;align-items:center;justify-content:center}
.signer-option.selected .chk{background:#4f46e5;color:white;border-color:#4f46e5}
.signer-option small{margin-inline-start:auto;color:#64748b}
</style>

@code {
    [Parameter] public EventCallback OnSent { get; set; }

    private const long MaxFile = 20L * 1024 * 1024;

    private bool visible;
    private bool busy;
    private bool isEditLetter;
    private int editLetterId;
    private int? draftId;

    private string title = "";
    private string receiverOrg = "";
    private string? receiverName;
    private string? receiverTitle;
    private string? receiverAddress;
    /// <summary>رونوشت‌گیرندگان — هر ردیف یک گیرنده (جدول مستقل OutgoingLetterCopyToes)</summary>
    private List<SaveOutgoingLetterCopyToDto> copyRows = new();

    /// <summary>افزودن یک ردیف رونوشت خالی — کاربر آن را یکی‌یکی پر می‌کند</summary>
    private void AddCopyRow() => copyRows.Add(new SaveOutgoingLetterCopyToDto { Name = "" });

    /// <summary>ردیف‌های آماده برای ارسال — فقط موارد دارای نام، با چینشِ فعلی جدول</summary>
    private List<SaveOutgoingLetterCopyToDto> CopyRowsForSave() =>
        copyRows
            .Where(r => !string.IsNullOrWhiteSpace(r.Name))
            .Select(r => new SaveOutgoingLetterCopyToDto
            {
                Id = r.Id,
                Name = r.Name.Trim(),
                Desc = string.IsNullOrWhiteSpace(r.Desc) ? null : r.Desc.Trim(),
                RefNo = string.IsNullOrWhiteSpace(r.RefNo) ? null : r.RefNo.Trim()
            })
            .ToList();
    private string? externalRef;
    private string foriat = "عادی";
    private string mahram = "عادی";
    private string pendingBody = "";

    private bool errTitle, errReceiverOrg, errSigners;
    private List<LetterReciverDto> allUsers = new();
    private List<LetterGroupDto> allGroups = new();
    private LetterCompanyDto? activeCompany;
    private int companyId;

    private LetterPickCombo? cbRcv, cbErja, cbHamesh;
    private RichTextEditor? _richOut;
    private HashSet<int> rcvUsers = new(), rcvGroups = new();
    private HashSet<int> erjaUsers = new(), erjaGroups = new();
    private HashSet<int> hameshUsers = new(), hameshGroups = new();
    private HashSet<int> signerSelGroups = new();
    private List<OutgoingSignerSelectionDto> signerSelections = new();
    private List<LetterReciverDto> signerUsers = new();
    private string signerQuery = "";
    private bool signerPickerOpen;

    private sealed record SignerOption(int UserId, int? SematId, string FullName, string PositionTitle);
    private List<SignerOption> SignerOptions => signerUsers.SelectMany(user =>
        user.PositionOptions is { Count: > 0 }
            ? user.PositionOptions.Select(position => new SignerOption(user.UserId, position.SematId, user.FullName, position.Title))
            : new[] { new SignerOption(user.UserId, user.SematId, user.FullName, user.SematTitle ?? "بدون سمت") })
        .ToList();
    private List<SignerOption> FilteredSignerOptions => SignerOptions
        .Where(x => string.IsNullOrWhiteSpace(signerQuery) || x.FullName.Contains(signerQuery, StringComparison.OrdinalIgnoreCase)
            || x.PositionTitle.Contains(signerQuery, StringComparison.OrdinalIgnoreCase))
        .Take(100).ToList();
    private bool IsSignerSelected(SignerOption option) => signerSelections.Any(x => x.UserId == option.UserId && x.SematId == option.SematId);
    private void ToggleSigner(SignerOption option)
    {
        var existing = signerSelections.FirstOrDefault(x => x.UserId == option.UserId && x.SematId == option.SematId);
        if (existing != null) signerSelections.Remove(existing);
        else
        {
            // برای هر نفر یک سمت انتخاب می‌شود؛ انتخاب سمت دیگر جایگزین قبلی است.
            signerSelections.RemoveAll(x => x.UserId == option.UserId);
            signerSelections.Add(new OutgoingSignerSelectionDto { UserId = option.UserId, SematId = option.SematId });
        }
        errSigners = false;
    }
    private void RemoveSigner(int userId, int? sematId) => signerSelections.RemoveAll(x => x.UserId == userId && x.SematId == sematId);
