    private async Task OnFiles(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        var rejected = new List<string>();
        foreach (var picked in e.GetMultipleFiles(int.MaxValue))
        {
            if (picked.Size <= 0) { rejected.Add($"{picked.Name} (خالی)"); continue; }
            if (picked.Size > 20 * 1024 * 1024) { rejected.Add($"{picked.Name} (بیش از ۲۰MB)"); continue; }
            // نسخهٔ فعلی وقتی مراجع رو IBrowserFile را مثل قبل نگه می‌داشتیم، در ثبت‌ها OnRead می‌شدند
            // با «no file with ID N ... file list may have changed» می‌خوردند؛ چون سامانهٔ فایل مرورگر در
            // ورود جدید یا رندر نو، ID های قدیمی را رها می‌کند. پس فایل فوراً در حافظه خوانده می‌شود.
            MemoryBrowserFile f;
            try
            {
                await using var src = picked.OpenReadStream(long.MaxValue);
                using var ms = new MemoryStream(picked.Size > 0 ? (int)picked.Size : 0);
                await src.CopyToAsync(ms);
                f = new MemoryBrowserFile(picked.Name, picked.ContentType, ms.ToArray());
            }
            catch (Exception readEx) { rejected.Add($"{picked.Name} (خوانش: {readEx.Message})"); continue; }
            if (pendingFiles.Any(x => x.Name == f.Name && x.Size == f.Size) ||
                savedAtts.Any(x => x.FileName == f.Name && x.Size == f.Size))
            { rejected.Add($"{f.Name} (تکراری)"); continue; }
            pendingFiles.Add(f);
        }
        fileErr = rejected.Count > 0 ? "رد شده: " + string.Join("، ", rejected) : "";
        if (rejected.Count > 0) Toast.Error("برخی فایل‌ها پذیرفته نشدند.");
    }

