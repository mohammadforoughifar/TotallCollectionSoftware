        copyRows = (letter.CopyTos ?? new())
            .Select(c => new SaveOutgoingLetterCopyToDto
            {
                Id = c.Id, Name = c.Name, Desc = c.Desc, RefNo = c.RefNo
            })
            .ToList();
        externalRef = letter.ExternalRefNumber;
        companyId = letter.CompanyId ?? 0;

        foreach (var r in letter.ReciversGirande) rcvUsers.Add(r.UserId);
        foreach (var r in letter.ReciversErja) erjaUsers.Add(r.UserId);
        foreach (var r in letter.ReciversHamesh) hameshUsers.Add(r.UserId);
        foreach (var s in letter.Signers) signerSelections.Add(new OutgoingSignerSelectionDto { UserId = s.UserId, SematId = s.SematId });

        related = letter.RelatedLetters.Select(r => new RelatedLetterDto
        {
            Related = r.Related,
            RelateLetterId = r.RelateLetterId,
            RelateLetterNumber = r.RelateLetterNumber,
            RelateLetterTitle = r.RelateLetterTitle
        }).ToList();

        visible = true;
        _ = LoadListsAsync();
        _ = LoadLetterAttsAsync(letter.LetterId);
        StateHasChanged();
        _ = SetEditorSoonAsync();
    }

