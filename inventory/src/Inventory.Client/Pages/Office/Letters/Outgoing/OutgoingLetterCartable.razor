    private async Task OnOutgoingAttachmentSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (selected == null || outgoingAttachmentUploading) return;
        outgoingAttachmentUploading = true;
        try
        {
            foreach (var file in e.GetMultipleFiles(int.MaxValue))
            {
                if (file.Size <= 0 || file.Size > 20 * 1024 * 1024)
                {
                    Toast.Error($"حجم فایل «{file.Name}» نامعتبر است؛ حداکثر ۲۰ مگابایت مجاز است.");
                    continue;
                }
                await using var stream = file.OpenReadStream(20 * 1024 * 1024);
                await OutgoingSvc.UploadAttachmentAsync(selected.LetterId, stream, file.Name, file.ContentType);
            }
            attachments = await OutgoingSvc.GetAttachmentsAsync(selected.LetterId);
            Toast.Success("پیوست با موفقیت اضافه شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { outgoingAttachmentUploading = false; }
    }

