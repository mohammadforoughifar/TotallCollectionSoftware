<BayeganiFolderPickerModal @ref="personalArchivePicker" />
<ComposeOutgoingModal @ref="compose" OnSent="OnComposed" />
<OutgoingPishnevisModal @ref="pishModal" OnSaved="OnDraftSaved" />
<OutgoingErjaSheet @ref="erjaSheet" OnSubmitted="OnErjaSubmitted" />
<OutgoingGardeshModal @ref="gardesh" />

<style>.print-letterhead-toggle{display:flex;align-items:center;gap:8px;padding:7px 10px;font-size:13px;cursor:pointer;white-space:nowrap}</style>

@code {
    // اندازهٔ چاپ — به‌صورت ثابت تعریف می‌شود تا داخل صفت‌های HTML
    // نیازی به نوشتن رشتهٔ داخل کوتیشن نباشیم (در Razor بک‌اسلش داخل صفت HTML معتبر نیست).
    private const string SizeA4 = "A4";
    private const string SizeA5 = "A5";

    private bool showGuide;
    private void OpenGuide()
    {
        CloseMenus();
        showGuide = true;
    }
    private void BackFromGuide() => showGuide = false;

    [Parameter] public string? Tab { get; set; }

    private HashSet<int> selectedLetterIds = new();
    private bool batchBayeganiModalOpen;
    private string batchBayeganiNote = "";
    private BayeganiFolderPickerModal? personalArchivePicker;

    private void ToggleSelectLetter(int letterId)
    {
        if (letterId <= 0) return;
        var id = letterId;
        if (selectedLetterIds.Contains(id)) selectedLetterIds.Remove(id);
        else selectedLetterIds.Add(id);
    }

    private void OpenBatchBayeganiModal()
    {
        if (selectedLetterIds.Count == 0) return;
        batchBayeganiNote = "";
        batchBayeganiModalOpen = true;
    }

    private async Task SubmitBatchBayegani()
    {
        if (selectedLetterIds.Count == 0) return;
        busy = true;
        try
        {
            if (personalArchivePicker == null) return;
            var destination = await personalArchivePicker.PickAsync("انتخاب پوشه برای بایگانی گروهی نامه‌های صادره");
            if (destination is not { } folderId || folderId <= 0) return;
            await LetterSvc.ArchiveLettersAsync(new ArchiveLettersDto
            {
                FolderId = folderId,
                OutgoingLetterIds = selectedLetterIds.ToList(),
                Title = string.IsNullOrWhiteSpace(batchBayeganiNote) ? null : batchBayeganiNote.Trim()
            });
            Toast.Success($"{selectedLetterIds.Count.FaDigits()} نامه با موفقیت بایگانی شدند.");
            selectedLetterIds.Clear();
            batchBayeganiModalOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            busy = false;
        }
    }

    private string folder = "sent";
    private string filter = "all";
    private string search = "";
    private bool loading = true;
    private bool busy;
    private bool readerOpen;
    private int openMenuId;

    private List<OutgoingLetterListItemDto> items = new();
    private List<OutgoingPishnevisDto> drafts = new();
    private OutgoingLetterCartableStatsDto stats = new();
    private int signingUnsigned = 0;

    private OutgoingLetterDetailDto? selected;
    private OutgoingLetterListItemDto? selectedItem;
    private List<LetterWorkOrderSummary> workOrders = new();
    private HashSet<int> workOrderLetterIds = new();
    private bool showWorkOrderReport;
    private async Task LoadWorkOrdersAsync(int letterId)
    {
        workOrders = await Api.GetAsync<List<LetterWorkOrderSummary>>($"api/workorders/for-source?module=OutgoingLetter&sourceId={letterId}") ?? new();
        showWorkOrderReport = false;
    }
    private List<LetterAttachmentDto> attachments = new();
    private bool outgoingAttachmentUploading;

    private bool replyOpen;
    private string replyText = "";
    private bool replyPrivate;

    private bool signOpen;
    private string signNote = "";

    private ComposeOutgoingModal? compose;
    private OutgoingPishnevisModal? pishModal;
    private OutgoingErjaSheet? erjaSheet;
    private OutgoingGardeshModal? gardesh;

    private bool CanErja => Auth.Has("OutgoingLetters.Erja");
    private bool FolderIsSent => folder == "sent";

    private string FolderTitle => folder switch
    {
        "inbox" => "دریافتی + امضایی",
        "signing" => "امضایی‌های من",
        "sent" => "صادره",
        "draft" => "پیش‌نویس‌ها",
        "starred" => "نشان‌شده‌ها",
        "archive" => "بایگانی",
        _ => "جهت تایید"
    };

    private List<OutgoingLetterListItemDto> BaseItems =>
        folder == "starred" ? items.Where(l => l.IsNeshan).ToList() : items;

    private List<OutgoingLetterListItemDto> Filtered
    {
        get
        {
            var arr = BaseItems;
            arr = filter switch
            {
                "unread" => arr.Where(l => !l.IsRead && !l.IsSigned).ToList(),
                // «امضایی»: اول نامه‌های نیازمند امضا، بعد امضاشده‌ها؛ در هر گروه جدیدترین
                // تاریخ ارجاع/ثبت اول — همان ترتیبی که سرور برای پوشهٔ «امضا» می‌دهد.
                "sign" => arr.Where(l => l.IsSigner)
                              .OrderBy(l => l.IsSigned)
                              .ThenByDescending(l => l.Date)
                              .ToList(),
                "starred" => arr.Where(l => l.IsNeshan).ToList(),
                "attach" => arr.Where(l => l.HasAttachment).ToList(),
                "workorder" => arr.Where(l => workOrderLetterIds.Contains(l.LetterId)).ToList(),
                _ => arr
            };
            return arr;
        }
    }

    private List<OutgoingPishnevisDto> FilteredDrafts => drafts;

    private const int PageSize = 15;
    private int page = 1;
    private int totalServerCount = 0;
    private int TotalCount => totalServerCount;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));
    private List<OutgoingLetterListItemDto> Paged => Filtered;
    private List<OutgoingPishnevisDto> PagedDrafts => drafts;
    private int jumpPage;

    private IEnumerable<int> PageNumbers
    {
        get
        {
            int start = Math.Max(1, page - 3), end = Math.Min(PageCount, page + 3);
            for (int i = start; i <= end; i++) yield return i;
        }
    }
    private void GoPage(int p)
    {
        if (p < 1 || p > PageCount || p == page) return;
        page = p;
        _ = InvokeAsync(async () => { await ReloadAsync(keepSelection: true, resetPage: false); StateHasChanged(); });
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("کارتابل نامه صادره");
        Rt.DataChanged += OnDataChanged;
        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (!string.IsNullOrEmpty(Tab) && Tab is "inbox" or "sent" or "draft" or "starred" or "archive" or "signing")
            folder = Tab;
        else folder = "sent";

        await ReloadAsync();
        if (int.TryParse(qs["open"], out var openId) && openId > 0)
            await OpenById(openId);

        if (qs["compose"] == "1" && qs["source"] == "MeetingMinutes" && int.TryParse(qs["sourceId"], out var minId) && minId > 0 && !_composeHandled)
        {
            _composeHandled = true;
            await OpenComposeFromMinutesAsync(minId, int.TryParse(qs["itemId"], out var itemId) ? itemId : 0);
        }
    }

    private bool _composeHandled;
    private async Task OpenComposeFromMinutesAsync(int minutesId, int itemId = 0)
    {
        try
        {
