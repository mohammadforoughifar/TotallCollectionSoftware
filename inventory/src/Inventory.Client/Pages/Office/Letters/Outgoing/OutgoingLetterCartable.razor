    private async Task ReloadAsync() { await ReloadAsync(false, true); }

    private async Task ReloadAsync(bool keepSelection, bool resetPage = true)
    {
        if (resetPage) page = 1;
        loading = true;
        try
        {
            var s = string.IsNullOrWhiteSpace(search) ? null : search;
            var unread = filter == "unread" ? (bool?)true : null;
            if (folder == "draft")
            {
                var draftPage = await OutgoingSvc.GetPishnevisPageAsync((page - 1) * PageSize, PageSize, s);
                drafts = draftPage.Items;
                totalServerCount = draftPage.TotalCount;
            }
            else
            {
                PagedResult<OutgoingLetterListItemDto> res;
                // با فیلتر «امضایی» فهرست مستقیماً از «امضایی‌های من» گرفته می‌شود تا
                // مرتب‌سازی (نیاز به امضا اول، سپس جدیدترین ارجاع) و صفحه‌بندی سمت سرور درست باشد.
                if (filter == "sign" && (folder == "inbox" || folder == "signing"))
                {
                    res = await OutgoingSvc.GetSigningInboxAsync(s, null, page, PageSize);
                }
                else switch (folder)
                {
                    case "sent":
                        res = await OutgoingSvc.GetSentAsync(s, page, PageSize);
                        break;
                    case "archive":
                        res = await OutgoingSvc.GetArchiveAsync(s, page, PageSize);
                        break;
                    case "signing":
                        res = await OutgoingSvc.GetSigningInboxAsync(s, null, page, PageSize);
                        break;
                    case "starred":
                        var starredInbox = await OutgoingSvc.GetInboxAsync(s, null, page, PageSize);
                        var starredSent = await OutgoingSvc.GetSentAsync(s, page, PageSize);
                        res = new PagedResult<OutgoingLetterListItemDto>
                        {
                            Items = starredInbox.Items.Concat(starredSent.Items).Where(x => x.IsNeshan).ToList(),
                            TotalCount = starredInbox.Items.Count(x => x.IsNeshan) + starredSent.Items.Count(x => x.IsNeshan),
                            Page = page, PageSize = PageSize
                        };
                        break;
                    default:
                        res = await OutgoingSvc.GetInboxAsync(s, unread, page, PageSize);
                        break;
                }
                items = res.Items;
                try { workOrderLetterIds = (await Api.GetAsync<List<int>>("api/workorders/source-ids?module=OutgoingLetter") ?? new()).ToHashSet(); } catch { workOrderLetterIds.Clear(); }
                totalServerCount = res.TotalCount;
            }
            stats = await OutgoingSvc.GetStatsAsync();
            try
            {
                var signingList = await OutgoingSvc.GetSigningInboxAsync(null, true, 1, 1);
                signingUnsigned = signingList.TotalCount;
                var signingAll = await OutgoingSvc.GetSigningInboxAsync(null, null, 1, 1);
                signingTotal = signingAll.TotalCount;
            }
            catch { }
            if (keepSelection && selected != null)
                selectedItem = items.FirstOrDefault(l => l.LetterId == selected.LetterId) ?? selectedItem;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task SetFolder(string f)
    {
        showGuide = false;
        folder = f; filter = "all"; search = ""; openMenuId = 0; page = 1;
        selected = null; selectedItem = null; readerOpen = false;
        await ReloadAsync();
    }

    private async Task SetFilter(string f)
    {
        // فیلترهای نشان‌شده / پیوست‌دار / امضایی / خوانده‌نشده سمت کلاینت روی دادهٔ
        // همین صفحه اعمال می‌شوند (نگاه کنید به Filtered و BaseItems)، پس درخواست
        // دوبارهٔ سرور بی‌فایده است.
        //
        // مهم‌تر: آن درخواست از یک هندلرِ void به‌صورت fire-and-forget صدا زده می‌شد
        // («_ = ReloadAsync()»). ReloadAsync پیش از اولین await به‌طور هم‌زمان
        // loading=true می‌گذاشت، Blazor اسپینر را رندر می‌کرد، و بعد ادامهٔ کار
        // بیرون از چرخهٔ رندر تمام می‌شد: finally مقدار loading=false را ست می‌کرد
        // ولی هیچ re-render زمان‌بندی نمی‌شد. نتیجه: صفحه برای همیشه روی «در حال
        // بارگذاری» می‌ماند، با اینکه داده در حافظه آمده بود.
        //
        // الگو از LetterCartable.razor:909 گرفته شده که همین مشکل را داشت و رفع شده
        // («درخواست دوباره باعث loading طولانی و هم‌پوشانی درخواست‌ها می‌شد»).
        // GoPage در همین فایل هم از راه‌حل معادل استفاده می‌کند:
        // InvokeAsync(...) + StateHasChanged().
        // «خوانده‌نشده» باید سمت سرور اعمال شود؛ وگرنه فقط روی همان ۱۵ ردیف بارگذاری‌شده
        // (یک صفحه) کار می‌کرد و نامه‌های نخواندهٔ صفحات بعد دیده نمی‌شدند.
        var needsServer =
            (folder == "inbox" && (f == "unread" || filter == "unread")) ||
            ((folder == "inbox" || folder == "signing") && (f == "sign" || filter == "sign"));
        filter = f;
        page = 1;
        if (needsServer)
        {
            await ReloadAsync(keepSelection: true);
            return;
        }
        loading = false;
        StateHasChanged();
    }
