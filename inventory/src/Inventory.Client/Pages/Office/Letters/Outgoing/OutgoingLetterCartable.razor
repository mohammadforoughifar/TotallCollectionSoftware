@page "/outgoing-letters"
@using Inventory.Shared.Security
@page "/outgoing-letters/{Tab}"
@inject IOutgoingLetterService OutgoingSvc
@inject LetterPrintWorkflow PrintWorkflow
@inject ILetterService LetterSvc
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject LayoutState Layout
@inject RealtimeService Rt
@inject IJSRuntime JS
@inject IApiClient Api
@inject IApiClient Api
@implements IDisposable

<PageTitle>کارتابل نامه صادره</PageTitle>

<div class="ltx @(!showGuide && readerOpen ? "rd-open" : "") @(showGuide ? "guide-open" : "")" style="animation:none;transform:none">
    <div class="shell" @onclick="CloseMenus">

        <nav class="rail">
            <div class="logo"><i class="bi bi-send-fill"></i></div>
            <button class="compose" title="نامه صادره جدید" @onclick="OpenCompose"><i class="bi bi-plus-lg"></i></button>
            <div style="height:8px"></div>

            @* عدد روی «دریافتی» = تعداد نخوانده‌ها (ارجاع‌های خوانده‌نشده + نامه‌های در انتظار امضا) *@
            <button class="@(!showGuide && folder == "inbox" ? "on" : "")" title="@($"دریافتی (شامل امضا) — {stats.InboxUnread.FaDigits()} نامهٔ خوانده‌نشده")" aria-label="@($"دریافتی، {stats.InboxUnread.FaDigits()} نامهٔ خوانده‌نشده")" @onclick='() => SetFolder("inbox")'>
                <i class="bi bi-inbox-fill"></i>
                @if (stats.InboxUnread > 0) { <span class="rbadge">@stats.InboxUnread.FaDigits()</span> }
            </button>
            <span class="rlbl">دریافتی</span>
            <button class="@(!showGuide && folder == "signing" ? "on" : "")" title="امضایی‌های من" @onclick='() => SetFolder("signing")'>
                <i class="bi bi-pen-fill"></i>
                @if (signingUnsigned > 0) { <span class="rbadge" style="background:#f59e0b">@signingUnsigned.FaDigits()</span> }
            </button>
            <span class="rlbl">امضا</span>
            <button class="@(!showGuide && folder == "sent" ? "on" : "")" title="ارسالی" @onclick='() => SetFolder("sent")'><i class="bi bi-send"></i></button>
            <span class="rlbl">صادره</span>
            <button class="@(!showGuide && folder == "draft" ? "on" : "")" title="پیش‌نویس" @onclick='() => SetFolder("draft")'><i class="bi bi-pencil-square"></i></button>
            <span class="rlbl">پیش‌نویس</span>
            <button class="@(!showGuide && folder == "starred" ? "on" : "")" title="نشان‌شده" @onclick='() => SetFolder("starred")'><i class="bi bi-star"></i></button>
            <span class="rlbl">نشان‌شده</span>
            <button class="@(!showGuide && folder == "archive" ? "on" : "")" title="بایگانی" @onclick='() => SetFolder("archive")'><i class="bi bi-archive"></i></button>
            <span class="rlbl">بایگانی</span>
            <button type="button" class="@(showGuide ? "on" : "")" title="راهنمای نامه صادره" aria-label="راهنمای نامه صادره" aria-pressed="@showGuide" @onclick="OpenGuide"><i class="bi bi-journal-check"></i></button>
            <span class="rlbl">راهنما</span>
            <div class="grow"></div>
        </nav>

        @if (showGuide)
        {
            <section class="guide-workspace">
                <OutgoingLetterGuide OnBack="BackFromGuide" />
            </section>
        }
        else
        {

        <section class="pane">
            <div class="pane-head">
                <div class="pane-title">
                    <h1>کارتابل نامه صادره — @FolderTitle</h1>
                    <span class="sync"><span class="dot"></span> بروزرسانی زنده</span>
                </div>
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input placeholder="جستجو در عنوان، شماره، سازمان مقصد، شماره صادره…" @bind="search" @bind:event="oninput" @bind:after="ReloadAsync" />
                </div>
                <div class="chips">
                    <button class="chip @(filter == "all" ? "on" : "")" @onclick='() => SetFilter("all")'>همه <span class="n">@((folder == "inbox" ? stats.InboxTotal : BaseItems.Count).FaDigits())</span></button>
                    @if (folder != "draft")
                    {
                        @if (folder == "inbox" || folder == "signing")
                        {
                            <button class="chip @(filter == "unread" ? "on" : "")" @onclick='() => SetFilter("unread")' title="فقط نامه‌های خوانده‌نشده / در انتظار امضا (روی همهٔ صفحات)">خوانده‌نشده <span class="n">@stats.InboxUnread.FaDigits()</span></button>
                            <button class="chip @(filter == "sign" ? "on" : "")" @onclick='() => SetFilter("sign")' title="نامه‌های امضایی من — اول نیازمند امضا، سپس امضاشده‌ها"><i class="bi bi-pen"></i> امضایی <span class="n">@signingTotal.FaDigits()</span></button>
                        }
                        <button class="chip @(filter == "starred" ? "on" : "")" @onclick='() => SetFilter("starred")'><i class="bi bi-star-fill" style="font-size:10px;color:#eab308"></i> نشان‌شده</button>
                        <button class="chip @(filter == "attach" ? "on" : "")" @onclick='() => SetFilter("attach")'><i class="bi bi-paperclip" style="font-size:10px"></i> پیوست‌دار</button>
                        <button class="chip @(filter == "workorder" ? "on" : "")" @onclick='() => SetFilter("workorder")'><i class="bi bi-list-task" style="font-size:10px"></i> دستورکارشده</button>
                        @if (selectedLetterIds.Count > 0)
                        {
                            <button class="chip on" style="background:#f59e0b;color:#fff;border-color:#d97706;" @onclick="OpenBatchBayeganiModal">
                                <i class="bi bi-archive-fill me-1"></i> بایگانی گروهی (@selectedLetterIds.Count.FaDigits())
                            </button>
                        }
                    }
                </div>
            </div>
            <div class="list">
                @if (loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (folder == "draft")
                {
                    @* «افزودن پیش‌نویس» فرم سبک پیش‌نویس را باز می‌کند، نه فرم کامل ارسال نامه *@
                    <button class="draft-add" @onclick="() => pishModal?.Open()">
                        <i class="bi bi-plus-lg"></i> افزودن پیش‌نویس
                    </button>
                    @if (drafts.Count == 0)
                    {
                        <div class="empty"><i class="bi bi-pencil-square"></i>پیش‌نویس صادره ندارید</div>
                    }
                    @foreach (var d in PagedDrafts)
                    {
                        var dd = d;
                        <div class="mail" @onclick="() => OpenDraft(dd)">
                            <div class="avt"><i class="bi bi-pencil"></i></div>
                            <div class="mail-b">
                                <div class="mail-r1"><span class="who">پیش‌نویس صادره</span></div>
                                <div class="mail-tt">@dd.Title</div>
                                <div class="mail-pv">@Preview(dd.Text) — @dd.ReceiverOrganization</div>
                            </div>
                            <div class="dd">
                                <button @onclick="e => ToggleMenu(-dd.PishnevisId)" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (openMenuId == -dd.PishnevisId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        <button @onclick="() => OpenDraft(dd)"><i class="bi bi-send"></i> ادامه پیش‌نویس (ارسال)</button>
                                        <button @onclick="() => pishModal?.Open(dd)"><i class="bi bi-pencil-square"></i> ویرایش پیش‌نویس</button>
                                        <div class="mdiv"></div>
                                        <button class="danger" @onclick="() => DeleteDraft(dd)"><i class="bi bi-trash"></i> حذف پیش‌نویس</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    @if (Filtered.Count == 0)
                    {
                        <div class="empty"><i class="bi bi-inbox"></i>نامه‌ای یافت نشد</div>
                    }
                    string lastDay = "";
                    @foreach (var l in Paged)
                    {
                        var ll = l;
                        var day = ll.Date.ToFaLong();
                        @if (day != lastDay)
                        {
                            lastDay = day;
                            <div class="day">@day</div>
                        }
                        <div class="mail @( (folder=="inbox"||folder=="signing") && (!ll.IsRead && !ll.IsSigned) ? "unread" : "") @(ll.IsNeshan ? "starred" : "") @(selected?.LetterId == ll.LetterId ? "sel" : "")"
                             @onclick="() => OpenLetter(ll)">
                            @if (ll.LetterId > 0 && (ll.ErjaId.HasValue || FolderIsSent))
                            {
                                <div class="me-2 d-flex align-items-center" @onclick:stopPropagation="true">
                                    <input type="checkbox" checked="@(selectedLetterIds.Contains(ll.LetterId))" @onchange="() => ToggleSelectLetter(ll.LetterId)" style="width:16px;height:16px;cursor:pointer;" />
                                </div>
                            }
                            <div class="avt">@AvatarText(FolderIsSent ? ll.ReceiverOrganization : ll.Sender)</div>
                            <div class="mail-b">
                                <div class="mail-r1">
                                    <span class="who">
                                        <span class="who-val">@(FolderIsSent ? "به: " + ll.ReceiverOrganization + (ll.ReceiverName != null ? " (" + ll.ReceiverName + ")" : "") : ll.Sender)</span>
                                        <i class="bi bi-star-fill star-ico"></i>
                                    </span>
                                    <span class="tm num">@ll.Date.ToFaDateTime()</span>
                                </div>
                                <div class="mail-tt">
                                    @ll.Title
                                    @if (workOrderLetterIds.Contains(ll.LetterId)) { <span class="workorder-mark ms-1" title="این نامه دستورکار دارد"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="18" height="18" aria-label="دستورکارشده"><rect x="7" y="5" width="34" height="38" rx="9" fill="#FFEDD5" stroke="#F97316" stroke-width="2.5"/><rect x="17" y="2" width="14" height="7" rx="3.5" fill="#F97316"/><g fill="none" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M13 18l2.5 2.5 4.5-5.5" stroke="#EA580C"/><path d="M13 27l2.5 2.5 4.5-5.5" stroke="#EA580C"/><circle cx="16" cy="35" r="2.8" stroke="#FDBA74"/><path d="M25 18h9M25 27h9M25 35h6" stroke="#FDBA74"/></g></svg></span> }
                                    @if (ll.IsSigner)
                                    {
                                        <span class="tg @(ll.IsSigned ? "green" : "amber")" style="margin-inline-start:6px">
                                            <i class="bi @(ll.IsSigned ? "bi-check2-all" : "bi-pen")"></i> @(ll.IsSigned ? "امضا شده" : "نیاز به امضا")
                                        </span>
                                    }
                                </div>
                                <div class="tags">
                                    @* لیبل «خوانده‌نشده» — همان شرطی که ردیف را بولد می‌کند *@
                                    @if ((folder == "inbox" || folder == "signing") && !ll.IsRead && !ll.IsSigned)
                                    {
                                        <span class="tg unread" title="این نامه هنوز خوانده نشده است"><i class="bi bi-envelope-fill"></i> خوانده‌نشده</span>
                                    }
                                    <span class="tg purple num"># @ll.LetterNumber.FaDigits()</span>
                                    @if (!string.IsNullOrWhiteSpace(ll.SadereNumber))
                                    {
                                        <span class="tg green num"><i class="bi bi-patch-check"></i> صادره: @ll.SadereNumber.FaDigits()</span>
                                    }
                                    <span class="tg blue">@ll.StatusTitle</span>
                                    @if (ll.Foriat != "عادی") { <span class="tg red">! @ll.Foriat</span> }
                                    @if (ll.Mahramanegi != "عادی") { <span class="tg dark"><i class="bi bi-lock-fill"></i> @ll.Mahramanegi</span> }
                                    @if (ll.HasAttachment) { <span class="tg gray"><i class="bi bi-paperclip"></i></span> }
                                    @if (ll.ErjaType != null) { <span class="tg @(ll.ErjaType.Contains("امضا") ? "amber" : "gray")">@ll.ErjaType</span> }
                                    @if (ll.SignersTotal > 0) { <span class="tg @(ll.SignersSigned==ll.SignersTotal ? "green" : "amber")"><i class="bi bi-people"></i> @ll.SignersSigned/@ll.SignersTotal امضا</span> }
                                    @if (ll.CanSign) { <span class="tg red"><i class="bi bi-pen"></i> قابل امضا</span> }
                                </div>
                            </div>
                            <div class="dd">
                                <button @onclick="() => ToggleMenu(ll.LetterId)" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (openMenuId == ll.LetterId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        @if (ll.CanSign)
                                        {
                                            <button @onclick="() => QuickSign(ll)"><i class="bi bi-pen"></i> امضا</button>
                                        }
                                        @if (FolderIsSent)
                                        {
                                            <button @onclick="() => EditLetter(ll.LetterId)"><i class="bi bi-pencil-square"></i> ویرایش</button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => MenuReply(ll)"><i class="bi bi-reply"></i> پاسخ</button>
                                        }
                                        @if (CanErja)
                                        {
                                            <button @onclick="() => MenuErja(ll)"><i class="bi bi-arrow-left-circle"></i> ارجاع / هامش</button>
                                        }
                                        @if (ll.ErjaId is { } eid1)
                                        {
                                            <button @onclick="() => ToggleStar(ll)">
                                                <i class="bi @(ll.IsNeshan ? "bi-star-fill" : "bi-star")" style="@(ll.IsNeshan ? "color:#eab308" : "")"></i>
                                                @(ll.IsNeshan ? "حذف نشان" : "نشان‌کردن")
                                            </button>
                                        }
                                        else if (FolderIsSent)
                                        {
                                            <button @onclick="() => ToggleSentStar(ll)">
                                                <i class="bi @(ll.IsNeshan ? "bi-star-fill" : "bi-star")" style="@(ll.IsNeshan ? "color:#eab308" : "")"></i>
                                                @(ll.IsNeshan ? "حذف نشان" : "نشان‌کردن")
                                            </button>
                                        }
                                        <div class="mdiv"></div>
                                        <button @onclick="() => MenuGardesh(ll)"><i class="bi bi-diagram-3"></i> گردش نامه</button>
                                        <button class="lbtn ghost" @onclick="() => TogglePrintMenu(ll)" @onclick:stopPropagation="true"><i class="bi bi-printer"></i> چاپ</button>
                                        @if (printMenuOpen && printMenuLetterId == ll.LetterId)
                                        {
                                            <div class="ltmenu" @onclick:stopPropagation="true">
                                                <label class="print-letterhead-toggle"><input type="checkbox" @bind="printWithLetterhead" /> چاپ با سربرگ شرکت</label>
                                                <div class="mdiv"></div>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA4, true); }"><i class="bi bi-file-earmark"></i> A4 — با هامش</button>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA4, false); }"><i class="bi bi-file-earmark"></i> A4 — بدون هامش</button>
                                                <div class="mdiv"></div>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA5, true); }"><i class="bi bi-file-earmark"></i> A5 — با هامش</button>
                                                <button data-ltx-print-option @onclick="async () => { await PrintRow(ll, SizeA5, false); }"><i class="bi bi-file-earmark"></i> A5 — بدون هامش</button>
                                            </div>
                                        }
                                        @if (ll.ErjaId is { } eid2)
                                        {
                                            <button class="warn" @onclick="() => ToggleArchive(ll)">
                                                <i class="bi bi-archive"></i> @(folder == "archive" ? "خروج از بایگانی" : "بایگانی")
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @if (PageCount > 1)
            {
                <div class="lt-pager">
                    <button class="pgbtn" disabled="@(page <= 1)" @onclick="() => GoPage(1)"><i class="bi bi-chevron-double-left"></i></button>
                    <button class="pgbtn" disabled="@(page <= 1)" @onclick="() => GoPage(page - 1)"><i class="bi bi-chevron-left"></i></button>
                    @foreach (var p in PageNumbers)
                    {
                        var pp = p;
                        <button class="pgbtn @(pp == page ? "on" : "")" @onclick="() => GoPage(pp)">@pp.FaDigits()</button>
                    }
                    <button class="pgbtn" disabled="@(page >= PageCount)" @onclick="() => GoPage(page + 1)"><i class="bi bi-chevron-right"></i></button>
                    <button class="pgbtn" disabled="@(page >= PageCount)" @onclick="() => GoPage(PageCount)"><i class="bi bi-chevron-double-right"></i></button>
                    <div class="pg-jump">
                        <label>رفتن به صفحه: </label>
                        <input type="number" @bind="jumpPage" min="1" max="@PageCount" style="width:50px" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="() => GoPage(jumpPage)"><i class="bi bi-arrow-right"></i></button>
                    </div>
                    <span class="pginfo">@TotalCount.FaDigits() نامه — صفحه @(page.FaDigits()) از @PageCount.FaDigits()</span>
                </div>
            }
        </section>

        <main class="reader">
            <div class="rd-top">
                <span class="t">@(selected?.Title ?? "—")</span>
                @if (selected != null)
                {
                    @if (selected.MyErja is { } myStar)
                    {
                        <button class="icb @(myStar.IsNeshan ? "gold" : "")" title="نشان‌کردن" @onclick="ToggleStarReader">
                            <i class="bi @(myStar.IsNeshan ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    }
                    else if (selected.IsMine)
                    {
                        <button class="icb @(selected.IsNeshan ? "gold" : "")" title="نشان‌کردن نامه ارسالی" @onclick="ToggleStarReader">
                            <i class="bi @(selected.IsNeshan ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    }
                    <button class="icb" title="نمایش نامه (صفحه کامل)" @onclick="() => ViewLetter(selected.LetterId)"><i class="bi bi-eye"></i></button>
                    <span class="print-wr">
                        @* بدون stopPropagation کلیک به @onclick="CloseMenus" روی .shell می‌رسد و منو همان لحظه بسته می‌شود *@
                        <button class="icb" title="چاپ نامٔ صادره روی سربرگ" disabled="@printingPdf" @onclick="TogglePrintSelected" @onclick:stopPropagation="true"><i class="bi bi-printer"></i></button>
                        @if (printMenuOpen)
                        {
                            <div class="ltmenu" @onclick:stopPropagation="true">
                                <label class="print-letterhead-toggle"><input type="checkbox" @bind="printWithLetterhead" /> چاپ با سربرگ شرکت</label>
                                <div class="mdiv"></div>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA4, true); }"><i class="bi bi-file-earmark"></i> A4 — با هامش</button>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA4, false); }"><i class="bi bi-file-earmark"></i> A4 — بدون هامش</button>
                                <div class="mdiv"></div>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA5, true); }"><i class="bi bi-file-earmark"></i> A5 — با هامش</button>
                                <button data-ltx-print-option @onclick="async () => { await PrintSelected(SizeA5, false); }"><i class="bi bi-file-earmark"></i> A5 — بدون هامش</button>
                            </div>
                        }
                    </span>
                    <button class="icb" title="کپی نامه" @onclick="CopyLetter"><i class="bi bi-files"></i></button>
                    @if (selected.CanSign)
                    {
                        <button class="lbtn grn" @onclick="OpenSignModal"><i class="bi bi-pen"></i> امضای نامه</button>
                    }
                    @if (selected.CanEdit)
                    {
                        <button class="icb" title="ویرایش" @onclick="() => EditLetter(selected.LetterId)"><i class="bi bi-pencil-square"></i></button>
                    }
                    @if (selected.MyErja != null)
                    {
                        <button class="lbtn ghost" @onclick="OpenReply"><i class="bi bi-reply"></i> پاسخ</button>
                    }
                    @if (CanErja && (selected.IsMine || selected.MyErja != null || selected.IsSigner))
                    {
                        <button class="lbtn pri" @onclick="OpenErjaSheet"><i class="bi bi-arrow-left-circle"></i> ارجاع / هامش</button>
                    }
                    @if (selected.IsMine || selected.MyErja != null || selected.IsSigner)
                    {
                        <button class="lbtn ghost" title="@(workOrders.Count > 0 ? "افزودن دستورکار جدید از این نامه" : "تبدیل این نامه به دستور کار")"
                                @onclick="() => OpenWorkOrder(selected.LetterId)">
                            <i class="bi @(workOrders.Count > 0 ? "bi-plus-circle" : "bi-list-task")"></i>
                            @(workOrders.Count > 0 ? "افزودن دستورکار" : "دستورکار")
                        </button>
                    }
                }
            </div>
            <div class="rd-scroll">
                @if (selected == null)
                {
                    <div class="empty" style="grid-column:1/-1"><i class="bi bi-envelope-open"></i>نامه‌ای انتخاب نشده است</div>
                }
                else
                {
                    <div>
                        <div class="paper">
                            <div class="paper-h">
                                <div class="avt">@AvatarText(selected.SenderName)</div>
                                <div class="ph-meta">
                                    <div class="n1">@selected.SenderName</div>
                                    <div class="n2">فرستنده @(selected.IsMine ? "(شما)" : "")</div>
                                </div>
                                <div class="ind">
                                    <div class="no num"># @selected.LetterNumber.FaDigits()</div>
                                    @if (!string.IsNullOrWhiteSpace(selected.SadereNumber))
                                    {
                                        <div class="no num" style="color:#16a34a;font-weight:700">صادره: @selected.SadereNumber.FaDigits()</div>
                                    }
                                    <div class="dt">@selected.DateSabt.ToFaDateTime()</div>
                                    @if (selected.DateSadere is { } ds)
                                    {
                                        <div class="dt" style="color:#16a34a">تاریخ صدور: @ds.ToFaDateTime()</div>
                                    }
                                </div>
                            </div>
                            <div style="padding:10px 16px;background:#f8fafc;border-bottom:1px solid #e2e8f0;display:flex;flex-wrap:wrap;gap:12px;font-size:13px">
                                <span><b>گیرنده بیرونی:</b> @selected.ReceiverOrganization @(selected.ReceiverName != null ? $"({selected.ReceiverName})" : "")</span>
                                @if (!string.IsNullOrWhiteSpace(selected.ReceiverTitle)) { <span><b>سمت:</b> @selected.ReceiverTitle</span> }
                                @if (!string.IsNullOrWhiteSpace(selected.ReceiverAddress)) { <span><b>آدرس:</b> @selected.ReceiverAddress</span> }
                                @if (!string.IsNullOrWhiteSpace(selected.CopyTo)) { <span><b>رونوشت:</b> @selected.CopyTo</span> }
