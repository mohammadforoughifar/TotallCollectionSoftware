    private async Task LoadDetailAsync(int letterId)
    {
        try
        {
            selected = await OutgoingSvc.GetDetailAsync(letterId);
            await LoadWorkOrdersAsync(letterId);
            attachments = new();
            try { attachments = await OutgoingSvc.GetAttachmentsAsync(letterId); } catch { }
            // «خوانده شد» همیشه — هم برای دارندهٔ ارجاع و هم برای امضاکننده (که ممکن است
            // هیچ ارجاعی نداشته باشد و پیش‌تر تا لحظهٔ امضا خوانده‌نشده می‌ماند).
            if (selected != null)
            {
                try { await OutgoingSvc.MarkLetterReadAsync(letterId); } catch { }
                if (selected.MyErja != null) selected.MyErja.IsRead = true;
                foreach (var it in items.Where(i => i.LetterId == letterId)) it.IsRead = true;
                if (selectedItem != null) selectedItem.IsRead = true;
                // شمارندهٔ «خوانده‌نشده» باید همان لحظه کم شود، نه با رفرش صفحه.
                stats = await OutgoingSvc.GetStatsAsync();
                StateHasChanged();
            }
            // نامه باز نشد: یا دسترسی نداریم یا حذف شده است — به‌جای صفحهٔ خالی
            // پیامِ روشن نشان داده می‌شود.
            if (selected == null) Toast.Error("این نامه برای شما در دسترس نیست یا حذف شده است.");
        }
        catch (Exception ex) { selected = null; Toast.Error(ex.Message); }
    }

