        replyOpen = false;
    }

    private async Task SubmitAnswerCore(string text, bool isPrivate, int typeTaeed)
    {
        if (selected?.MyErja is not { } my) return;
        busy = true;
        try
        {
            await OutgoingSvc.AnswerAsync(my.ErjaId, new AnswerErjaDto { Answer = text, ShowForAll = !isPrivate, TypeTaeed = typeTaeed });
            Toast.Success(typeTaeed == 1 ? "تایید و پاسخ ثبت شد." : typeTaeed == 2 ? "رد شد." : "پاسخ ثبت شد.");
            await LoadDetailAsync(selected.LetterId);
            await ReloadAsync(keepSelection: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private void OpenErjaSheet()
    {
        if (selected == null) return;
        erjaSheet?.Open(selected.LetterId, selected.LetterNumber, selected.MyErja?.ErjaId);
    }

    private async Task OnErjaSubmitted()
    {
        if (selected != null) await LoadDetailAsync(selected.LetterId);
        await ReloadAsync(keepSelection: true);
        StateHasChanged();
    }

    private void OpenSignModal()
    {
        if (selected == null || !selected.CanSign) { Toast.Error("شما امکان امضای این نامه را ندارید."); return; }
        signNote = selected.MySigner?.SignNote ?? "";
        signOpen = true;
    }

    private async Task SubmitSign()
    {
        if (selected == null) return;
        busy = true;
        try
        {
            await OutgoingSvc.SignAsync(selected.LetterId, string.IsNullOrWhiteSpace(signNote) ? null : signNote);
            Toast.Success("نامه با موفقیت امضا شد و شماره صادره تخصیص یافت.");
            signOpen = false;
            await LoadDetailAsync(selected.LetterId);
            await ReloadAsync(keepSelection: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    public void Dispose() => Rt.DataChanged -= OnDataChanged;

    private sealed class LetterWorkOrderSummary
    {
        public int Id { get; set; }
        public string Number { get; set; } = "";
        public string Title { get; set; } = "";
        public int AssigneeCount { get; set; }
        public List<string> Assignees { get; set; } = new();
    }
}

