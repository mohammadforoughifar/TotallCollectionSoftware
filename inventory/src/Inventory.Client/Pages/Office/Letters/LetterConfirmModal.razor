@* ============================================================
   مودال تأیید عمومی ماژول نامه‌ها — «آیا مطمئن هستید؟»
   استفاده: var ok = await confirm.AskAsync("خروج از بایگانی", "آیا ...؟");
   ریسپانسیو: در موبایل تمام‌عرض پایین صفحه، در دسکتاپ وسط صفحه
   ============================================================ *@

@if (visible)
{
    <div class="ltx" style="animation:none;transform:none">
        <div class="gov" style="position:fixed;inset:0" @onclick="() => Answer(false)">
            <div class="gmodal cfm" @onclick:stopPropagation="true">
                <div class="cfm-ic @tone"><i class="bi @icon"></i></div>
                <div class="cfm-t">@title</div>
                <div class="cfm-m">@message</div>
                <div class="cfm-btns">
                    <button class="lbtn ghost" @onclick="() => Answer(false)">انصراف</button>
                    <button class="lbtn @(tone == "danger" ? "red" : "pri")" @onclick="() => Answer(true)">
                        <i class="bi bi-check-lg"></i> @okText
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool visible;
    private string title = "";
    private string message = "";
    private string okText = "تایید";
    private string icon = "bi-question-lg";
    private string tone = "warn"; // warn | danger
    private TaskCompletionSource<bool>? tcs;

    /// <summary>نمایش دیالوگ تأیید — خروجی: true = کاربر تایید کرد</summary>
    public Task<bool> AskAsync(string caption, string text, string confirmText = "تایید",
                               string iconClass = "bi-exclamation-triangle", string toneClass = "warn")
    {
        title = caption;
        message = text;
        okText = confirmText;
        icon = iconClass;
        tone = toneClass;
        visible = true;
        StateHasChanged();
        tcs = new TaskCompletionSource<bool>();
        return tcs.Task;
    }

    private void Answer(bool ok)
    {
        visible = false;
        tcs?.TrySetResult(ok);
        StateHasChanged();
    }
}
