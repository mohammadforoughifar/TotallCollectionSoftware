    private async Task ToggleStar(InnerLetterListItemDto l)
    {
        openMenuId = 0;
        if (l.ErjaId is not { } eid) return;
        try
        {
            l.IsNeshan = await LetterSvc.ToggleNeshanAsync(eid);
            if (selected?.MyErja is { } my && my.ErjaId == eid) my.IsNeshan = l.IsNeshan;
            Toast.Success(l.IsNeshan ? "نامه نشان شد ⭐" : "نشان نامه برداشته شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
