    private async Task ToggleArchive(InnerLetterListItemDto l)
    {
        openMenuId = 0;
        try
        {
            if (folder == "archive")
            {
                // تأیید کاربر قبل از خروج از بایگانی
                if (confirmModal != null &&
                    !await confirmModal.AskAsync("خروج از بایگانی",
                        $"آیا مطمئن هستید که می‌خواهید نامه «{l.Title}» را از بایگانی خارج کنید؟",
                        "بله، خارج کن", "bi-box-arrow-up", "warn"))
                    return;

                // خروج از بایگانی — مسیر گیرنده (ارجاع) یا فرستنده (نامه)
                if (l.ErjaId is { } eid0) await LetterSvc.UnarchiveByErjaAsync(eid0);
                else await LetterSvc.UnarchiveByLetterAsync(l.LetterId);
                Toast.Success("نامه از بایگانی خارج شد");
                if (selected?.LetterId == l.LetterId || selectedItem?.LetterId == l.LetterId)
                { selected = null; selectedItem = null; readerOpen = false; }
                if (bayeganiTree != null) await bayeganiTree.ReloadAsync();
                stats = await LetterSvc.GetStatsAsync();
                return;
            }

            // بایگانی: انتخاب پوشه مقصد از درخت بایگانی
            if (folderPicker == null) return;
            var dest = await folderPicker.PickAsync($"بایگانی نامه «{l.Title}»");
            if (dest is not { } folderId || folderId <= 0) return;

            var dto = new ArchiveLettersDto { FolderId = folderId };
            if (l.ErjaId is { } eid) dto.ErjaIds.Add(eid);
            else dto.LetterIds.Add(l.LetterId); // نامه ارسالی — مسیر فرستنده

            await LetterSvc.ArchiveLettersAsync(dto);
            Toast.Success("نامه بایگانی شد");
            if (selected?.LetterId == l.LetterId) { selected = null; selectedItem = null; readerOpen = false; }
            await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>بایگانی نامه باز در ریدر — دکمه نوار بالا و کلید میانبر Ctrl+Shift+B</summary>
