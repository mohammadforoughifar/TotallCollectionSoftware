    {
        if (selected == null) return;
        try
        {
            bool val;
            if (selected.MyErja is { } my)
            {
                val = await LetterSvc.ToggleNeshanAsync(my.ErjaId);
                my.IsNeshan = val;
                var row = items.FirstOrDefault(x => x.ErjaId == my.ErjaId);
                if (row != null) row.IsNeshan = val;
            }
            else if (selected.IsMine)
            {
                val = await LetterSvc.ToggleLetterNeshanAsync(selected.LetterId);
                var row = items.FirstOrDefault(x => x.LetterId == selected.LetterId);
                if (row != null) row.IsNeshan = val;
            }
            else return;

            if (selectedItem?.LetterId == selected.LetterId) selectedItem!.IsNeshan = val;
            readerStar = val;
            Toast.Success(val ? "نامه نشان شد ⭐" : "نشان نامه برداشته شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

