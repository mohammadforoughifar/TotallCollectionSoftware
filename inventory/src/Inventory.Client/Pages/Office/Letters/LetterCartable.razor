@page "/letters"
@page "/letters/{Tab}"
@using System.Net.Http.Headers
@inject ILetterService LetterSvc
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject LayoutState Layout
@inject RealtimeService Rt
@inject IJSRuntime JS
@inject HttpClient Http
@implements IDisposable

<PageTitle>کارتابل نامه داخلی</PageTitle>

@* ============================================================
   کارتابل نامه داخلی — طرح مصوب (پروتوتایپ طرح ۱ نسخه ۶):
   ریل پوشه‌ها | لیست نامه‌ها با چیپ فیلتر | صفحه خواندن
   ============================================================ *@

<div class="ltx @(readerOpen ? "rd-open" : "")" style="animation:none;transform:none">
    <div class="shell" @onclick="CloseMenus">

        @* ---------- ریل پوشه‌ها ---------- *@
        <nav class="rail">
            <div class="logo"><i class="bi bi-envelope-paper-fill"></i></div>
            <button class="compose" title="نامه جدید" @onclick="OpenCompose"><i class="bi bi-plus-lg"></i></button>
            <div style="height:8px"></div>

            <button class="@(folder == "inbox" ? "on" : "")" title="دریافتی" @onclick='() => SetFolder("inbox")'>
                <i class="bi bi-inbox-fill"></i>
                @if (stats.InboxUnread > 0) { <span class="rbadge">@stats.InboxUnread.FaDigits()</span> }
            </button>
            <span class="rlbl">دریافتی</span>
            <button class="@(folder == "sent" ? "on" : "")" title="ارسالی" @onclick='() => SetFolder("sent")'><i class="bi bi-send"></i></button>
            <span class="rlbl">ارسالی</span>
            <button class="@(folder == "draft" ? "on" : "")" title="پیش‌نویس" @onclick='() => SetFolder("draft")'><i class="bi bi-pencil-square"></i></button>
            <span class="rlbl">پیش‌نویس</span>
            <button class="@(folder == "starred" ? "on" : "")" title="نشان‌شده" @onclick='() => SetFolder("starred")'><i class="bi bi-star"></i></button>
            <span class="rlbl">نشان‌شده</span>
            <button class="@(folder == "archive" ? "on" : "")" title="بایگانی" @onclick='() => SetFolder("archive")'><i class="bi bi-archive"></i></button>
            <span class="rlbl">بایگانی</span>
            <div class="grow"></div>
        </nav>

        @* ---------- لیست ---------- *@
        <section class="pane">
            <div class="pane-head">
                <div class="pane-title">
                    <h1>کارتابل نامه داخلی — @FolderTitle</h1>
                    <span class="sync"><span class="dot"></span> بروزرسانی زنده</span>
                </div>
                <div class="search">
                    <i class="bi bi-search"></i>
                    <input placeholder="جستجو در عنوان، شماره، فرستنده…" @bind="search" @bind:event="oninput" @bind:after="ReloadAsync" />
                </div>
                <div class="chips">
                    <button class="chip @(filter == "all" ? "on" : "")" @onclick='() => SetFilter("all")'>همه <span class="n">@BaseItems.Count.FaDigits()</span></button>
                    @if (folder != "draft")
                    {
                        @if (folder == "inbox")
                        {
                            <button class="chip @(filter == "unread" ? "on" : "")" @onclick='() => SetFilter("unread")'>خوانده‌نشده <span class="n">@BaseItems.Count(l => !l.IsRead).FaDigits()</span></button>
                        }
                        <button class="chip @(filter == "starred" ? "on" : "")" @onclick='() => SetFilter("starred")'><i class="bi bi-star-fill" style="font-size:10px;color:#eab308"></i> نشان‌شده</button>
                        <button class="chip @(filter == "deadline" ? "on" : "")" @onclick='() => SetFilter("deadline")'><i class="bi bi-clock" style="font-size:10px"></i> مهلت‌دار</button>
                        <button class="chip @(filter == "attach" ? "on" : "")" @onclick='() => SetFilter("attach")'><i class="bi bi-paperclip" style="font-size:10px"></i> پیوست‌دار</button>
                    }
                </div>
            </div>
            <div class="list">
                @if (loading)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (folder == "draft")
                {
                    @if (drafts.Count == 0)
                    {
                        <div class="empty"><i class="bi bi-pencil-square"></i>پیش‌نویسی ندارید</div>
                    }
                    @foreach (var d in PagedDrafts)
                    {
                        var dd = d;
                        <div class="mail" @onclick="() => OpenDraft(dd)">
                            <div class="avt"><i class="bi bi-pencil"></i></div>
                            <div class="mail-b">
                                <div class="mail-r1"><span class="who">پیش‌نویس</span></div>
                                <div class="mail-tt">@dd.Title</div>
                                <div class="mail-pv">@Preview(dd.Text)</div>
                            </div>
                            <div class="dd">
                                <button @onclick="e => ToggleMenu(-dd.PishnevisId)" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (openMenuId == -dd.PishnevisId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        <button @onclick="() => OpenDraft(dd)"><i class="bi bi-pencil-square"></i> ادامه پیش‌نویس</button>
                                        <div class="mdiv"></div>
                                        <button class="danger" @onclick="() => DeleteDraft(dd)"><i class="bi bi-trash"></i> حذف پیش‌نویس</button>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
                else
                {
                    @if (Filtered.Count == 0)
                    {
                        <div class="empty"><i class="bi bi-inbox"></i>نامه‌ای یافت نشد</div>
                    }
                    string lastDay = "";
                    @foreach (var l in Paged)
                    {
                        var ll = l;
                        var day = ll.Date.ToFaLong();
                        @if (day != lastDay)
                        {
                            lastDay = day;
                            <div class="day">@day</div>
                        }
                        <div class="mail @(folder == "inbox" && !ll.IsRead ? "unread" : "") @(ll.IsNeshan ? "starred" : "") @(selected?.LetterId == ll.LetterId ? "sel" : "")"
                             @onclick="() => OpenLetter(ll)">
                            <div class="avt">@AvatarText(FolderIsSent ? ll.Reciver : ll.Sender)</div>
                            <div class="mail-b">
                                <div class="mail-r1">
                                    <span class="who">
                                        @(FolderIsSent ? "به: " + ll.Reciver + (ll.ReciverCount > 1 ? " +" + (ll.ReciverCount - 1).FaDigits() : "") : ll.Sender)
                                        <i class="bi bi-star-fill star-ico"></i>
                                    </span>
                                    <span class="tm num">@ll.Date.ToFaDateTime()</span>
                                </div>
                                <div class="mail-tt">@ll.Title</div>
                                <div class="tags">
                                    <span class="tg purple num"># @ll.LetterNumber.FaDigits()</span>
                                    @if (ll.Foriat != "عادی") { <span class="tg red">! @ll.Foriat</span> }
                                    @if (ll.Mahramanegi != "عادی") { <span class="tg dark"><i class="bi bi-lock-fill"></i> @ll.Mahramanegi</span> }
                                    @if (ll.HasAttachment) { <span class="tg gray"><i class="bi bi-paperclip"></i></span> }
                                    @if (ll.MohlatPasokh is { } mp) { <span class="tg amber"><i class="bi bi-clock"></i> مهلت: @mp.ToFa()</span> }
                                    @if (ll.TypeTaeed == 1) { <span class="tg green"><i class="bi bi-check2-all"></i> تایید شد</span> }
                                    else if (ll.TypeTaeed == 2) { <span class="tg red"><i class="bi bi-x-lg"></i> رد شد</span> }
                                    else if (ll.HasAnswer) { <span class="tg green"><i class="bi bi-check2-all"></i> پاسخ داده شد</span> }
                                    @if (!string.IsNullOrEmpty(ll.ErjaType) && ll.ErjaType != "گیرنده") { <span class="tg gray">@ll.ErjaType</span> }
                                </div>
                            </div>
                            <div class="dd">
                                <button @onclick="() => ToggleMenu(ll.LetterId)" @onclick:stopPropagation="true"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (openMenuId == ll.LetterId)
                                {
                                    <div class="ltmenu" @onclick:stopPropagation="true">
                                        @if (FolderIsSent)
                                        {
                                            <button @onclick="() => EditLetter(ll.LetterId)"><i class="bi bi-pencil-square"></i> ویرایش</button>
                                        }
                                        else
                                        {
                                            <button @onclick="() => MenuReply(ll)"><i class="bi bi-reply"></i> پاسخ</button>
                                        }
                                        @if (CanErja)
                                        {
                                            <button @onclick="() => MenuErja(ll)"><i class="bi bi-arrow-left-circle"></i> ارجاع / هامش</button>
                                        }
                                        @if (ll.ErjaId is { } eid1)
                                        {
                                            <button @onclick="() => ToggleStar(ll)">
                                                <i class="bi @(ll.IsNeshan ? "bi-star-fill" : "bi-star")" style="@(ll.IsNeshan ? "color:#eab308" : "")"></i>
                                                @(ll.IsNeshan ? "حذف نشان" : "نشان‌کردن")
                                            </button>
                                        }
                                        <div class="mdiv"></div>
                                        <button @onclick="() => MenuGardesh(ll)"><i class="bi bi-diagram-3"></i> گردش نامه</button>
                                        <button @onclick="() => MenuPrint(ll)"><i class="bi bi-printer"></i> چاپ</button>
                                        @if (ll.ErjaId is { } eid2)
                                        {
                                            <button class="warn" @onclick="() => ToggleArchive(ll)">
                                                <i class="bi bi-archive"></i> @(folder == "archive" ? "خروج از بایگانی" : "بایگانی")
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>

            @* ---------- صفحه‌بندی ---------- *@
            @if (PageCount > 1)
            {
                <div class="lt-pager">
                    <button class="pgbtn" disabled="@(page <= 1)" @onclick="() => GoPage(page - 1)"><i class="bi bi-chevron-right"></i></button>
                    @foreach (var p in PageNumbers)
                    {
                        var pp = p;
                        <button class="pgbtn @(pp == page ? "on" : "")" @onclick="() => GoPage(pp)">@pp.FaDigits()</button>
                    }
                    <button class="pgbtn" disabled="@(page >= PageCount)" @onclick="() => GoPage(page + 1)"><i class="bi bi-chevron-left"></i></button>
                    <span class="pginfo">@TotalCount.FaDigits() نامه — صفحه @(page.FaDigits()) از @PageCount.FaDigits()</span>
                </div>
            }
        </section>

        @* ---------- ریدر ---------- *@
        <main class="reader">
            <div class="rd-top">
                <span class="t">@(selected?.Title ?? "—")</span>
                @if (selected != null)
                {
                    @if (selected.MyErja is { } myStar)
                    {
                        <button class="icb @(myStar.IsNeshan ? "gold" : "")" title="نشان‌کردن" @onclick="ToggleStarReader">
                            <i class="bi @(myStar.IsNeshan ? "bi-star-fill" : "bi-star")"></i>
                        </button>
                    }
                    <button class="icb" title="چاپ" @onclick="Print"><i class="bi bi-printer"></i></button>
                    @if (selected.CanEdit)
                    {
                        <button class="icb" title="ویرایش" @onclick="() => EditLetter(selected.LetterId)"><i class="bi bi-pencil-square"></i></button>
                    }
                    @if (selected.MyErja != null)
                    {
                        <button class="lbtn ghost" @onclick="OpenReply"><i class="bi bi-reply"></i> پاسخ</button>
                    }
                    @if (CanErja && (selected.IsMine || selected.MyErja != null))
                    {
                        <button class="lbtn pri" @onclick="OpenErjaSheet"><i class="bi bi-arrow-left-circle"></i> ارجاع / هامش</button>
                    }
                    @* ---------- اتصال به دستور کار ---------- *@
                    @if (IsConverted)
                    {
                        <button class="lbtn grn" title="@($"دستور کار: {letterWorkOrders[0].Number}")" @onclick="() => GoToWorkOrder(letterWorkOrders[0].Id)">
                            <i class="bi bi-list-task"></i> دستورکار شده
                        </button>
                    }
                    else if (woLoaded && CanConvertToWorkOrder)
                    {
                        <button class="lbtn pri" title="تبدیل این نامه به دستور کار" @onclick="ConvertToWorkOrder">
                            <i class="bi bi-arrow-right-circle"></i> تبدیل به دستور کار
                        </button>
                    }
                }
            </div>
            <div class="rd-scroll">
                @if (selected == null)
                {
                    <div class="empty" style="grid-column:1/-1"><i class="bi bi-envelope-open"></i>نامه‌ای انتخاب نشده است</div>
                }
                else
                {
                    <div>
                        <div class="paper">
                            <div class="paper-h">
                                <div class="avt">@AvatarText(selected.SenderName)</div>
                                <div class="ph-meta">
                                    <div class="n1">@selected.SenderName</div>
                                    <div class="n2">فرستنده @(selected.IsMine ? "(شما)" : "")</div>
                                </div>
                                <div class="ind">
                                    <div class="no num"># @selected.LetterNumber.FaDigits()</div>
                                    <div class="dt">@selected.DateSabt.ToFaDateTime()</div>
                                </div>
                            </div>
                            <div class="paper-body">@((MarkupString)(selected.Text ?? "—"))</div>
                            @if (attachments.Count > 0)
                            {
                                <div class="paper-foot">
                                    @foreach (var a in attachments)
                                    {
                                        var aa = a;
                                        <a class="att" href="@LetterSvc.AttachmentDownloadUrl(aa.Id)" target="_blank">
                                            <div class="ic"><i class="bi @FileIcon(aa.FileName)"></i></div>
                                            <div>@aa.FileName<small>@FmtSize(aa.Size) — @aa.UploaderName</small></div>
                                        </a>
                                    }
                                </div>
                            }
                        </div>

                        @* دستور ارجاع برای من *@
                        @if (selected.MyErja is { } my && my.Type != "گیرنده" && !string.IsNullOrWhiteSpace(my.MatnErja))
                        {
                            <div class="myerja">
                                <i class="bi bi-arrow-left-circle"></i>
                                <b>دستور @my.Type:</b> @my.MatnErja
                                @if (my.AmalgarTitle != null) { <span class="tg purple" style="margin-inline-start:5px">@my.AmalgarTitle</span> }
                                @if (my.MohlatPasokh is { } mp2) { <span class="tg amber" style="margin-inline-start:5px"><i class="bi bi-clock"></i> مهلت: @mp2.ToFa()</span> }
                            </div>
                        }

                        @* پاسخ ثبت‌شده من *@
                        @if (selected.MyErja is { } my2 && !string.IsNullOrWhiteSpace(my2.Answer))
                        {
                            <div class="myans">
                                <i class="bi bi-check-circle"></i> <b>پاسخ شما:</b> @my2.Answer
                                @if (my2.TypeTaeed == 1) { <span class="tg green" style="margin-inline-start:5px">تایید ✓</span> }
                                @if (my2.TypeTaeed == 2) { <span class="tg red" style="margin-inline-start:5px">رد ✗</span> }
                                <small style="color:var(--sub);display:block;margin-top:3px">@my2.DateAnswer?.ToFaDateTime()</small>
                            </div>
                        }

                        <div class="act-strip">
                            @if (selected.MyErja is { } my3)
                            {
                                <button class="lbtn pri" @onclick="() => QuickAnswer(1)"><i class="bi bi-check-lg"></i> تایید و ثبت پاسخ</button>
                                <button class="lbtn ghost" @onclick="() => QuickAnswer(2)"><i class="bi bi-x-lg"></i> رد</button>
                                <button class="lbtn ghost" @onclick="OpenReply"><i class="bi bi-chat-text"></i> ثبت پاسخ متنی</button>
                            }
                            else if (selected.IsMine)
                            {
                                <button class="lbtn pri" @onclick="() => MenuGardeshCur()"><i class="bi bi-diagram-3"></i> پیگیری گردش</button>
                                @if (selected.CanEdit)
                                {
                                    <button class="lbtn ghost" @onclick="() => EditLetter(selected.LetterId)"><i class="bi bi-pencil-square"></i> ویرایش</button>
                                }
                            }
                            @if (selectedItem?.ErjaId != null)
                            {
                                <button class="lbtn ghost" @onclick="() => ToggleArchive(selectedItem!)">
                                    <i class="bi bi-archive"></i> @(folder == "archive" ? "خروج از بایگانی" : "بایگانی")
                                </button>
                            }
                        </div>
                    </div>

                    <aside class="side">
                        <div class="scard">
                            <h3><i class="bi bi-info-circle-fill"></i> مشخصات نامه</h3>
                            <div class="kv"><b>شماره اندیکاتور</b><span class="num">@selected.LetterNumber.FaDigits()</span></div>
                            <div class="kv"><b>تاریخ ثبت</b><span class="num">@selected.DateSabt.ToFaDateTime()</span></div>
                            <div class="kv"><b>فوریت</b><span style="@(selected.Foriat != "عادی" ? "color:var(--bad);font-weight:700" : "")">@selected.Foriat</span></div>
                            <div class="kv"><b>محرمانگی</b><span>@selected.Mahramanegi</span></div>
                            @if (selected.MyErja?.MohlatPasokh is { } mp3)
                            {
                                <div class="kv"><b>مهلت پاسخ</b><span style="color:var(--amb);font-weight:700">@mp3.ToFa()</span></div>
                            }
                        </div>
                        @if (selected.RelatedLetters.Count > 0)
                        {
                            <div class="scard">
                                <h3><i class="bi bi-link-45deg"></i> نامه‌های مرتبط</h3>
                                @foreach (var r in selected.RelatedLetters)
                                {
                                    <div class="kv">
                                        <b>@(r.Related == 2 ? "عطف به" : "پیرو")</b>
                                        <span class="num" style="color:var(--p2);cursor:pointer" @onclick="() => OpenById(r.RelateLetterId)"># @r.RelateLetterNumber.FaDigits()</span>
                                    </div>
                                }
                            </div>
                        }
                        <div class="scard">
                            <h3><i class="bi bi-people-fill"></i> گیرندگان</h3>
                            <div class="ppl">
                                @foreach (var u in selected.ReciversGirande) { <span class="pp"><span class="mini"><i class="bi bi-person"></i></span> @u.FullName (گیرنده)</span> }
                                @foreach (var u in selected.ReciversErja) { <span class="pp"><span class="mini"><i class="bi bi-person"></i></span> @u.FullName (ارجاع)</span> }
                                @foreach (var u in selected.ReciversHamesh) { <span class="pp"><span class="mini"><i class="bi bi-person"></i></span> @u.FullName (هامش)</span> }
                            </div>
                        </div>
                    </aside>
                }
            </div>
        </main>
    </div>

    @* ---------- مودال پاسخ ---------- *@
    @if (replyOpen)
    {
        <div class="gov" @onclick="() => replyOpen = false">
            <div class="gmodal" style="width:min(540px,96vw)" @onclick:stopPropagation="true">
                <div class="gm-h">
                    <div class="ttl"><b><i class="bi bi-reply" style="color:var(--p2)"></i> ثبت پاسخ</b><small>@selected?.Title — # @(selected?.LetterNumber.FaDigits())</small></div>
                    <button class="x" @onclick="() => replyOpen = false"><i class="bi bi-x-lg"></i></button>
                </div>
                <div class="gm-b">
                    <div class="fcard" style="box-shadow:none">
                        <label>متن پاسخ</label>
                        <textarea class="tin" placeholder="پاسخ خود را بنویسید…" @bind="replyText"></textarea>
                    </div>
                    <label style="display:flex;align-items:center;gap:7px;font-size:12px;cursor:pointer;margin-top:10px">
                        <input type="checkbox" @bind="replyPrivate" /> پاسخ خصوصی (فقط فرستنده ببیند)
                    </label>
                </div>
                <div class="gm-f">
                    <button class="lbtn ghost" @onclick="() => replyOpen = false">انصراف</button>
                    <button class="lbtn pri" disabled="@busy" @onclick="() => SubmitReply(0)"><i class="bi bi-send"></i> ثبت پاسخ</button>
                </div>
            </div>
        </div>
    }
</div>

<ComposeLetterModal @ref="compose" OnSent="OnComposed" />
<ErjaSheet @ref="erjaSheet" OnSubmitted="OnErjaSubmitted" />
<GardeshModal @ref="gardesh" />

@code {
    [Parameter] public string? Tab { get; set; }

    private string folder = "inbox";
    private string filter = "all";
    private string search = "";
    private bool loading = true;
    private bool busy;
    private bool readerOpen;
    private int openMenuId;

    private List<InnerLetterListItemDto> items = new();
    private List<PishnevisDto> drafts = new();
    private LetterCartableStatsDto stats = new();

    private InnerLetterDetailDto? selected;
    private InnerLetterListItemDto? selectedItem;
    private List<LetterAttachmentDto> attachments = new();

    private bool replyOpen;
    private string replyText = "";
    private bool replyPrivate;

    private ComposeLetterModal? compose;
    private ErjaSheet? erjaSheet;
    private GardeshModal? gardesh;

    // دستور کارِ ساخته‌شده از نامه (برای نشان «دستورکار شده» و لینک)
    private List<WoSourceItem> letterWorkOrders = new();
    private bool woLoaded;

    private bool CanErja => Auth.Has("InnerLetters.Erja");
    private bool FolderIsSent => folder == "sent";

    // تبدیل نامه به دستور کار: فقط فرستنده یا مدیر، و داشتن مجوز ایجاد دستور کار
    private bool CanConvertToWorkOrder =>
        (selected?.IsMine == true || Auth.IsAdmin) && Auth.Has("WorkOrders.Create");
    private bool IsConverted => letterWorkOrders.Count > 0;

    /// <summary>لینک منبع نامه در صفحه دستور کار — برای نمایش در لیست دستور کارها</summary>
    public const string SourceModule = "InnerLetter";

    private string FolderTitle => folder switch
    {
        "sent" => "ارسالی", "draft" => "پیش‌نویس‌ها", "starred" => "نشان‌شده‌ها", "archive" => "بایگانی", _ => "دریافتی"
    };

    private List<InnerLetterListItemDto> BaseItems =>
        folder == "starred" ? items.Where(l => l.IsNeshan).ToList() : items;

    private List<InnerLetterListItemDto> Filtered
    {
        get
        {
            var arr = BaseItems;
            arr = filter switch
            {
                "unread" => arr.Where(l => !l.IsRead).ToList(),
                "starred" => arr.Where(l => l.IsNeshan).ToList(),
                "deadline" => arr.Where(l => l.MohlatPasokh != null).ToList(),
                "attach" => arr.Where(l => l.HasAttachment).ToList(),
                _ => arr
            };
            return arr;
        }
    }

    private List<PishnevisDto> FilteredDrafts =>
        string.IsNullOrWhiteSpace(search) ? drafts
        : drafts.Where(d => (d.Title + d.Text).Contains(search.Trim())).ToList();

    // ==================== صفحه‌بندی ====================

    private const int PageSize = 15;
    private int page = 1;

    private int TotalCount => folder == "draft" ? FilteredDrafts.Count : Filtered.Count;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize));

    private List<InnerLetterListItemDto> Paged =>
        Filtered.Skip((page - 1) * PageSize).Take(PageSize).ToList();

    private List<PishnevisDto> PagedDrafts =>
        FilteredDrafts.Skip((page - 1) * PageSize).Take(PageSize).ToList();

    private IEnumerable<int> PageNumbers
    {
        get
        {
            int start = Math.Max(1, page - 2), end = Math.Min(PageCount, page + 2);
            for (int i = start; i <= end; i++) yield return i;
        }
    }

    private void GoPage(int p)
    {
        if (p < 1 || p > PageCount || p == page) return;
        page = p;
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("کارتابل نامه داخلی");
        Rt.DataChanged += OnDataChanged;

        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);

        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (!string.IsNullOrEmpty(Tab) && Tab is "inbox" or "sent" or "draft" or "starred" or "archive")
            folder = Tab;

        await ReloadAsync();

        // باز کردن مستقیم یک نامه (لینک نوتیفیکیشن): letters?open=ID
        if (int.TryParse(qs["open"], out var openId) && openId > 0)
            await OpenById(openId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(Tab) && Tab != folder && Tab is "inbox" or "sent" or "draft" or "starred" or "archive")
        {
            folder = Tab;
            await ReloadAsync();
        }
    }

    private void OnDataChanged(string scope)
    {
        if (scope != "letters") return;
        _ = InvokeAsync(async () => { await ReloadAsync(keepSelection: true); StateHasChanged(); });
    }

    private async Task ReloadAsync() { page = 1; await ReloadAsync(false); }

    private async Task ReloadAsync(bool keepSelection)
    {
        loading = true;
        try
        {
            var s = string.IsNullOrWhiteSpace(search) ? null : search;
            switch (folder)
            {
                case "sent": items = await LetterSvc.GetSentAsync(s); break;
                case "draft": drafts = await LetterSvc.GetPishnevisListAsync(s); break;
                case "archive": items = await LetterSvc.GetArchiveAsync(s); break;
                default: items = await LetterSvc.GetInboxAsync(s); break; // inbox + starred
            }
            stats = await LetterSvc.GetStatsAsync();
            if (keepSelection && selected != null)
            {
                selectedItem = items.FirstOrDefault(l => l.LetterId == selected.LetterId) ?? selectedItem;
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task SetFolder(string f)
    {
        folder = f; filter = "all"; search = ""; openMenuId = 0; page = 1;
        selected = null; selectedItem = null; readerOpen = false;
        await ReloadAsync();
    }

    private void SetFilter(string f) { filter = f; page = 1; }

    private void ToggleMenu(int id) => openMenuId = openMenuId == id ? 0 : id;
    private void CloseMenus() => openMenuId = 0;

    private static string AvatarText(string name)
    {
        var t = (name ?? "").Trim();
        if (t.StartsWith("به:")) t = t[3..].Trim();
        return string.IsNullOrEmpty(t) ? "؟" : t[..1];
    }

    private static string Preview(string? html)
    {
        if (string.IsNullOrEmpty(html)) return "";
        var text = System.Text.RegularExpressions.Regex.Replace(html, "<[^>]+>", " ");
        text = System.Net.WebUtility.HtmlDecode(text).Trim();
        return text.Length > 80 ? text[..80] + "…" : text;
    }

    private static string FmtSize(long b) =>
        b >= 1024 * 1024 ? $"{b / 1024.0 / 1024.0:0.#} مگابایت".FaDigits()
        : b >= 1024 ? $"{b / 1024} کیلوبایت".FaDigits()
        : $"{b} بایت".FaDigits();

    private static string FileIcon(string name)
    {
        var e = (Path.GetExtension(name) ?? "").TrimStart('.').ToLowerInvariant();
        return e switch
        {
            "pdf" => "bi-file-earmark-pdf",
            "xls" or "xlsx" or "csv" => "bi-file-earmark-excel",
            "doc" or "docx" => "bi-file-earmark-word",
            "png" or "jpg" or "jpeg" or "gif" or "webp" or "svg" => "bi-file-earmark-image",
            "zip" or "rar" or "7z" => "bi-file-earmark-zip",
            _ => "bi-file-earmark"
        };
    }

    // ==================== باز کردن نامه ====================

    private async Task OpenLetter(InnerLetterListItemDto l)
    {
        openMenuId = 0;
        selectedItem = l;
        await LoadDetailAsync(l.LetterId);
        readerOpen = true;
    }

    private async Task OpenById(int letterId)
    {
        selectedItem = items.FirstOrDefault(x => x.LetterId == letterId);
        await LoadDetailAsync(letterId);
        readerOpen = true;
    }

    private async Task LoadDetailAsync(int letterId)
    {
        letterWorkOrders = new();
        try
        {
            selected = await LetterSvc.GetDetailAsync(letterId);
            attachments = new();
            try { attachments = await LetterSvc.GetAttachmentsAsync(letterId); } catch { }
            await LoadLetterWorkOrdersAsync(letterId);

            // ثبت خودکار خوانده‌شدن
            if (selected?.MyErja is { IsRead: false } my)
            {
                await LetterSvc.MarkReadAsync(my.ErjaId);
                my.IsRead = true;
                if (selectedItem != null) selectedItem.IsRead = true;
                stats = await LetterSvc.GetStatsAsync();
            }
        }
        catch (Exception ex)
        {
            selected = null;
            Toast.Error(ex.Message);
        }
    }

    // ==================== اتصال به دستور کار ====================

    /// <summary>دستورهای کارِ ساخته‌شده از این نامه (برای نشان «دستورکار شده» و لینک).</summary>
    private async Task LoadLetterWorkOrdersAsync(int letterId)
    {
        letterWorkOrders = new();
        woLoaded = false;
        try
        {
            letterWorkOrders = await Http.GetFromJsonAsync<List<WoSourceItem>>(
                $"/api/workorders/for-source?module={SourceModule}&sourceId={letterId}") ?? new();
        }
        catch { letterWorkOrders = new(); }
        finally { woLoaded = true; }
    }

    private void GoToWorkOrder(int workOrderId) => Nav.NavigateTo($"/work-orders?open={workOrderId}");

    private void ConvertToWorkOrder()
    {
