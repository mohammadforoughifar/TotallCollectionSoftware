    /// <summary>افزودن پیوست جدید به نامه باز در ریدر (فقط فرستنده)</summary>
    private async Task OnReaderFiles(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (selected == null || attUploading) return;
        attUploading = true;
        try
        {
            foreach (var f in e.GetMultipleFiles(50))
            {
                if (f.Size <= 0) { Toast.Error($"فایل «{f.Name}» خالی است."); continue; }
                if (f.Size > 20 * 1024 * 1024) { Toast.Error($"فایل «{f.Name}» بزرگ‌تر از ۲۰ مگابایت است."); continue; }
                try
                {
                    await using var stream = f.OpenReadStream(20 * 1024 * 1024);
                    await LetterSvc.UploadAttachmentAsync(selected.LetterId, stream, f.Name, f.ContentType);
                }
                catch (Exception ex) { Toast.Error($"«{f.Name}»: {ex.Message}"); }
            }
            attachments = await LetterSvc.GetAttachmentsAsync(selected.LetterId);
            Toast.Success("پیوست‌ها بروزرسانی شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { attUploading = false; }
    }

