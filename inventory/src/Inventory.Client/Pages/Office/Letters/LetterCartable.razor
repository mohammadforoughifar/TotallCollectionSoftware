    private async Task QuickAnswer(int typeTaeed)
    {
        if (selected?.MyErja is not { } my) return;
        replyText = "";
        replyPrivate = false;
        replyOpen = true;
        // برای تایید/رد، مودال با نوع از پیش تعیین‌شده باز نمی‌شود؛ مستقیم ثبت می‌کنیم اگر متن لازم نیست
        replyOpen = false;
        await SubmitAnswerCore(typeTaeed == 1 ? "تایید می‌شود." : "رد می‌شود.", false, typeTaeed);
    }

    private async Task SubmitReply(int typeTaeed)
    {
        if (string.IsNullOrWhiteSpace(replyText)) { Toast.Error("متن پاسخ را بنویسید."); return; }
        await SubmitAnswerCore(replyText, replyPrivate, typeTaeed);
        replyOpen = false;
    }

    private async Task SubmitAnswerCore(string text, bool isPrivate, int typeTaeed)
    {
        if (selected?.MyErja is not { } my) return;
        busy = true;
        try
        {
            await LetterSvc.AnswerAsync(my.ErjaId, new AnswerErjaDto
            {
                Answer = text,
                ShowForAll = !isPrivate,
                TypeTaeed = typeTaeed
            });
            Toast.Success(typeTaeed == 1 ? "نامه تایید و پاسخ ثبت شد." : typeTaeed == 2 ? "نامه رد شد." : "پاسخ ثبت شد.");
            await LoadDetailAsync(selected.LetterId);
            await ReloadAsync(keepSelection: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

