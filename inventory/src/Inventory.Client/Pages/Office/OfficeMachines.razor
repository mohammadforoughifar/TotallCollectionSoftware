@namespace Inventory.Client.Pages
@page "/office-machines"
@inject HttpClient Http

<PageTitle>ماشین‌های اداری</PageTitle>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-700 d-flex justify-content-between align-items-center flex-wrap gap-2" 
         style="background:linear-gradient(135deg,#4f8cff,#8e5cff);color:#fff;border-radius:14px 14px 0 0;">
        <span><i class="bi bi-printer-fill me-2"></i>ماشین‌های اداری
            <span class="badge bg-light text-dark ms-1">@filtered.Count</span>
        </span>
        <button class="btn btn-light btn-sm fw-700 shadow-sm" style="border-radius:8px;color:#4f5b8a;" @onclick="OpenForm">
            <i class="bi bi-plus-lg"></i> افزودن ماشین
        </button>
    </div>

<div class="card-body">
        @if (isLoading)
        {
            <div class="text-center py-4"><div class="spinner-border text-primary"></div></div>
        }
        else if (filtered.Count == 0)
        {
            <div class="alert alert-info py-2 mb-0">ماشینی ثبت نشده — «افزودن ماشین» را بزنید.</div>
        }
        else
        {
            @* ---------- جدول دسکتاپ ---------- *@
            <div class="table-responsive d-none d-md-block">
                <table class="table table-hover align-middle mb-0" style="white-space:nowrap;">
                    <thead class="table-light">
                        <tr>
                            <th>#</th><th>مدل</th><th>سریال</th><th>محل</th><th>تاریخ نصب</th>
                            <th>تعمیرات</th><th>وضعیت</th><th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var i = 1; }
                        @foreach (var m in filtered)
                        {
                            <tr>
                                <td class="text-secondary fw-600">@(i++)</td>
                                <td class="fw-700">@m.Model</td>
                                <td><code>@(string.IsNullOrEmpty(m.SerialNumber) ? "—" : m.SerialNumber)</code></td>
                                <td>@(string.IsNullOrEmpty(m.Location) ? "—" : m.Location)</td>
                                <td>@(m.InstallDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                                <td><span class="badge bg-info">@m.RepairCount تعمیر</span></td>
                                <td>
                                    @if (m.IsActive)
                                    { <span class="badge bg-success">فعال</span> }
                                    else
                                    { <span class="badge bg-secondary">غیرفعال</span> }
                                </td>
                                <td>
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-sm btn-outline-warning ops-btn" title="فرم نگهداری و تعمیرات" @onclick="() => OpenRepairForm(m)"><i class="bi bi-tools"></i></button>
                                                                                <button class="btn btn-sm btn-outline-primary ops-btn" title="ویرایش" @onclick="() => Edit(m)"><i class="bi bi-pencil-fill"></i></button>
                                        <button class="btn btn-sm btn-outline-danger ops-btn" title="حذف" @onclick="() => Delete(m.Id)"><i class="bi bi-trash-fill"></i></button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ---------- کارت‌ویو موبایل ---------- *@
            <div class="d-md-none">
                @{ var k = 1; }
                @foreach (var m in filtered)
                {
                    <div class="m-card">
                        <div class="m-title">@(k++). @m.Model</div>
                        <div class="m-row"><span class="m-label">سریال</span><span class="m-val">@(string.IsNullOrEmpty(m.SerialNumber) ? "—" : m.SerialNumber)</span></div>
                        <div class="m-row"><span class="m-label">محل</span><span class="m-val">@(string.IsNullOrEmpty(m.Location) ? "—" : m.Location)</span></div>
                        <div class="m-row"><span class="m-label">نصب</span><span class="m-val">@(m.InstallDate?.ToString("yyyy/MM/dd") ?? "—")</span></div>
                        <div class="m-row"><span class="m-label">تعمیرات</span><span class="m-val">@m.RepairCount مورد</span></div>
                        <div class="m-row"><span class="m-label">وضعیت</span><span class="m-val">@(m.IsActive ? "فعال ✅" : "غیرفعال")</span></div>
                        <div class="m-actions">
                            <button class="btn btn-sm btn-outline-warning" @onclick="() => OpenRepairForm(m)"><i class="bi bi-tools"></i> تعمیرات</button>
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => Edit(m)"><i class="bi bi-pencil-fill"></i> ویرایش</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="() => Delete(m.Id)"><i class="bi bi-trash-fill"></i></button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ---------- مودال فرم ماشین ---------- *@
@if (ShowForm)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.5)" @onclick="CloseForm">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick="() => { }" @onclick:stopPropagation="true">
            <div class="modal-content" style="overflow:visible;">
                <div class="modal-header">
                    <h5 class="modal-title">@(editing ? "ویرایش ماشین" : "افزودن ماشین اداری")</h5>
                    <button type="button" class="btn-close" @onclick="CloseForm"></button>
                </div>
                <div class="modal-body" style="overflow:visible;padding:1.25rem;">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    { <div class="alert alert-danger py-2">@formError</div> }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-800">مدل <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" maxlength="150" @bind="form.Model" placeholder="مثلاً: پرینتر HP LaserJet M404" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800">شماره سریال</label>
                            <input class="form-control form-control-sm" maxlength="150" @bind="form.SerialNumber" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800">محل</label>
                            <input class="form-control form-control-sm" maxlength="250" @bind="form.Location" placeholder="مثلاً: اتاق اداری" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-800">تاریخ نصب (شمسی)</label>
                            <DatePicker @bind-Value="form.InstallDate" AllowClear="true" />
                            <div class="small text-muted mt-1"><i class="bi bi-calendar3"></i> روی آیکون تقویم بزنید یا به شکل 1403/05/12 تایپ کنید</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label small fw-800">نوع اتصال ماشین <span class="text-danger">*</span></label>
                            <div class="d-flex gap-3">
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="connType" id="ctNet"
                                           checked="@(form.ConnectionType == "Network")"
                                           @onchange="@(() => form.ConnectionType = "Network")" />
                                    <label class="form-check-label fw-600" for="ctNet"><i class="bi bi-wifi text-primary"></i> شبکه</label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="radio" name="connType" id="ctCable"
                                           checked="@(form.ConnectionType == "Cable")"
                                           @onchange="@(() => form.ConnectionType = "Cable")" />
                                    <label class="form-check-label fw-600" for="ctCable"><i class="bi bi-usb-plug text-warning"></i> کابلی</label>
                                </div>
                            </div>
                        </div>
                        @if (form.ConnectionType == "Network")
                        {
                            <div class="col-md-6">
                                <label class="form-label small fw-800">آدرس IP <span class="text-danger">*</span></label>
                                <input class="form-control form-control-sm num" dir="ltr" maxlength="50" @bind="form.IpAddress" placeholder="192.168.1.50" />
                            </div>
                        }
                        else
                        {
                            <div class="col-12">
                                <label class="form-label small fw-800">سیستم متصل <span class="text-danger">*</span></label>
                                @* کمبوی سیستم با جستجو — نام مالک مشخص است *@
                                <div class="om-combo">
                                    <div class="om-combo-control form-control form-control-sm" @onclick="() => sysDropOpen = !sysDropOpen">
                                        @if (form.LinkedSystemInfoId is null)
                                        {
                                            <span class="text-muted">— انتخاب سیستم —</span>
                                        }
                                        else
                                        {
                                            var ss = sysLookup.FirstOrDefault(x => x.Id == form.LinkedSystemInfoId);
                                            <span>@(ss == null ? form.LinkedSystemLabel : $"{ss.Label} — {ss.Owner}")</span>
                                        }
                                        <i class="bi bi-chevron-down om-caret"></i>
                                    </div>
                                    @if (sysDropOpen)
                                    {
                                        <div class="om-combo-menu shadow">
                                            <div class="p-2 border-bottom">
                                                <input class="form-control form-control-sm" placeholder="جستجو (سیستم، مالک، IP)..."
                                                       @bind="sysSearch" @bind:event="oninput" @onclick:stopPropagation="true" />
                                            </div>
                                            <div class="om-combo-items">
                                                @foreach (var ss in FilteredSys)
                                                {
                                                    <div class="om-combo-item @(form.LinkedSystemInfoId == ss.Id ? "sel" : "")"
                                                         @onclick="() => PickSys(ss)">
                                                        <i class="bi bi-pc-display text-primary"></i>
                                                        <span>@ss.Label</span>
                                                        @if (!string.IsNullOrWhiteSpace(ss.Ip))
                                                        {
                                                            <span class="badge bg-light text-dark border num">@ss.Ip</span>
                                                        }
                                                        <small class="text-muted ms-auto">مالک: @(string.IsNullOrWhiteSpace(ss.Owner) ? "—" : ss.Owner)</small>
                                                    </div>
                                                }
                                                @if (!FilteredSys.Any())
                                                {
                                                    <div class="px-3 py-2 text-muted small">سیستمی پیدا نشد.</div>
                                                }
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        <div class="col-12">
                            <label class="form-label small fw-800">توضیحات</label>
                            <textarea class="form-control form-control-sm" rows="2" maxlength="500" @bind="form.Notes"></textarea>
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch mt-1">
                                <input class="form-check-input" type="checkbox" role="switch" id="mActive" @bind="form.IsActive" />
                                <label class="form-check-label" for="mActive">فعال باشد</label>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary rounded-pill px-4" @onclick="CloseForm">انصراف</button>
                    <button class="btn btn-primary rounded-pill px-4 fw-800" disabled="@busy" @onclick="Save">@(editing ? "ذخیره تغییرات" : "افزودن")</button>
                </div>
            </div>
        </div>
    </div>
}

@* ---------- مودال سابقه: تعمیرات + هزینه‌ها ---------- *@
@* ---------- فرم نگهداری و تعمیرات ---------- *@
@if (repairMachine != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.55)" @onclick="CloseRepairForm">
        <div class="modal-dialog modal-lg modal-dialog-centered" @onclick="() => { }" @onclick:stopPropagation="true">
            <div class="modal-content" style="overflow:visible;">
                <div class="modal-header" style="background:linear-gradient(135deg,#fff7e0,#ffeef3);border-radius:8px 8px 0 0;">
                    <h5 class="modal-title"><i class="bi bi-tools"></i> فرم نگهداری و تعمیرات — @repairMachine.Model</h5>
                    <button type="button" class="btn-close" @onclick="CloseRepairForm"></button>
                </div>
                <div class="modal-body" style="overflow:visible;padding:1.25rem;">
                    @if (!string.IsNullOrWhiteSpace(repairError))
                    { <div class="alert alert-danger py-2">@repairError</div> }

                    @* ---------- فرم ثبت/ویرایش تعمیر ---------- *@
                    <div class="card border-0 shadow-sm mb-3" style="background:#fdfdff;">
                        <div class="card-body">
                            <b class="d-block mb-2">@(editingRepairId > 0 ? "ویرایش رکورد تعمیر" : "ثبت تعمیر جدید")</b>
                            <div class="row g-2">
                                <div class="col-md-4">
                                    <label class="form-label small fw-800 mb-1">تاریخ رفت (شمسی)</label>
                                    <DatePicker @bind-Value="rf.GoneDate" AllowClear="true" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-800 mb-1">تاریخ برگشت (شمسی)</label>
                                    <DatePicker @bind-Value="rf.ReturnDate" AllowClear="true" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small fw-800 mb-1">هزینه (تومان)</label>
                                    <input type="number" class="form-control form-control-sm" @bind="rf.Cost" style="direction:ltr;" />
                                </div>
                                <div class="col-md-12 d-flex align-items-center gap-3 mt-1">
                                    <div class="form-check form-switch">
                                        <input class="form-check-input" type="checkbox" role="switch" id="rfFixed" @bind="rf.Fixed" />
                                        <label class="form-check-label small fw-800" for="rfFixed">برطرف شد</label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-800 mb-1">شرح ایراد <span class="text-danger">*</span></label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="rf.Problem" placeholder="مثلاً: خط روی چاپ، صدای غیرعادی..."></textarea>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label small fw-800 mb-1">شرح کارهای انجام‌شده</label>
                                    <textarea class="form-control form-control-sm" rows="2" @bind="rf.PerformedWork" placeholder="مثلاً: تعویض کارتریج و تمیزکاری هد..."></textarea>
                                </div>
                            </div>
                            <div class="d-flex gap-2 mt-2">
                                <button class="btn btn-sm btn-success rounded-pill px-4 fw-800" @onclick="SaveRepair">
                                    <i class="bi bi-check-circle-fill"></i> @(editingRepairId > 0 ? "ذخیره تغییرات" : "ثبت تعمیر")
                                </button>
                                @if (editingRepairId > 0)
                                {
                                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" @onclick="ResetRepairForm">فرم جدید</button>
                                }
                            </div>
                        </div>
                    </div>

                    @* ---------- سابقه‌ی تعمیرات ---------- *@
                    <b class="d-block mb-2"><i class="bi bi-clock-history"></i> سابقه‌ی تعمیرات (@repairList.Count) — جمع هزینه‌ی تعمیرات: @repairList.Sum(r => r.Cost).ToString("N0")</b>
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>تاریخ رفت</th><th>تاریخ برگشت</th><th>شرح ایراد</th>
                                    <th>کارهای انجام‌شده</th><th>هزینه</th><th>وضعیت</th><th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (repairList.Count == 0)
                                {
                                    <tr><td colspan="7" class="text-center text-muted py-3">تعمیری ثبت نشده</td></tr>
                                }
                                @foreach (var r in repairList)
                                {
                                    <tr>
                                        <td>@(r.GoneDate?.ToString("yyyy/MM/dd") ?? "—")</td>
                                        <td>
                                            @if (r.ReturnDate != null)
                                            { @r.ReturnDate?.ToString("yyyy/MM/dd") }
                                            else
                                            { <span class="badge bg-danger">در رفتار</span> }
                                        </td>
                                        <td class="small" style="min-width:160px;">@r.Problem</td>
                                        <td class="small text-muted" style="min-width:160px;">@(string.IsNullOrEmpty(r.PerformedWork) ? "—" : r.PerformedWork)</td>
                                        <td class="fw-800">@(r.Cost > 0 ? r.Cost.ToString("N0") : "—")</td>
                                        <td>
                                            @if (r.Fixed)
                                            { <span class="badge bg-success">برطرف شد</span> }
                                            else
                                            { <span class="badge bg-warning text-dark">در جریان</span> }
                                        </td>
                                        <td>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-outline-primary py-0 px-1" title="ویرایش" @onclick="() => EditRepair(r)"><i class="bi bi-pencil-fill"></i></button>
                                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="حذف" @onclick="() => DelRepair(r.Id)"><i class="bi bi-trash-fill"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
/* تقویم شمسی داخل مودال — کامل و بالاتر از مودال */
.modal .dp-popover{z-index:1095;box-shadow:0 12px 40px rgba(30,40,90,.28);}
.modal .date-picker{position:relative;}
.ops-btn{width:34px;height:30px;display:inline-flex;align-items:center;justify-content:center;padding:0;border-radius:8px;}
    .om-combo { position: relative; }
    .om-combo-control { display: flex; align-items: center; gap: .4rem; cursor: pointer; min-height: 34px; padding-left: 1.8rem; position: relative; }
    .om-caret { position: absolute; left: .6rem; color: #94a3b8; }
    .om-combo-menu { position: absolute; top: calc(100% + 4px); right: 0; left: 0; z-index: 1070; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .om-combo-items { max-height: 220px; overflow-y: auto; }
    .om-combo-item { display: flex; align-items: center; gap: .5rem; padding: .45rem .8rem; cursor: pointer; font-size: .83rem; }
    .om-combo-item:hover { background: #f1f5f9; }
    .om-combo-item.sel { background: #eef4ff; }
</style>

@code {
    private List<MachineItem> items = new();
    private bool isLoading = true;
    private string searchText = "";

    private bool ShowForm = false;
    private bool editing = false;
    private bool busy;
    private string formError = "";
    private int editId;
    private MachineForm form = new();

    // ---------- فرم نگهداری و تعمیرات ----------
    private MachineItem? repairMachine;
    private List<RepairItem> repairList = new();
    private RepairForm rf = new();
    private int editingRepairId;
    private string repairError = "";

    private List<MachineItem> filtered => string.IsNullOrWhiteSpace(searchText)
        ? items
        : items.Where(m =>
            (m.Model ?? "").Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (m.SerialNumber ?? "").Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase) ||
            (m.Location ?? "").Contains(searchText.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        isLoading = true;
        try { items = await Http.GetFromJsonAsync<List<MachineItem>>("/api/OfficeMachines") ?? new(); }
        catch { items = new(); }
        finally { isLoading = false; }
    }

    private async Task LoadSysLookup()
    {
        if (sysLookup.Count > 0) return;
        try { sysLookup = await Http.GetFromJsonAsync<List<SysOpt>>("/api/OfficeMachines/systems-lookup") ?? new(); }
        catch { sysLookup = new(); }
    }

    private async Task OpenForm()
    {
        editing = false; editId = 0; formError = "";
        form = new MachineForm();
        sysDropOpen = false; sysSearch = "";
        await LoadSysLookup();
        ShowForm = true;
    }

    private async Task Edit(MachineItem m)
    {
        editing = true; editId = m.Id; formError = "";
        form = new MachineForm
        {
            Model = m.Model, SerialNumber = m.SerialNumber, Location = m.Location,
            InstallDate = m.InstallDate, Notes = m.Notes, IsActive = m.IsActive,
            ConnectionType = m.ConnectionType ?? "Network",
            IpAddress = m.IpAddress,
            LinkedSystemInfoId = m.LinkedSystemInfoId,
            LinkedSystemLabel = m.LinkedSystemLabel
        };
        sysDropOpen = false; sysSearch = "";
        await LoadSysLookup();
        ShowForm = true;
    }

    private void CloseForm() => ShowForm = false;

    private static string? NullIfEmpty(string? s) => string.IsNullOrWhiteSpace(s) ? null : s.Trim();

    private async Task Save()
    {
        formError = "";
        if (string.IsNullOrWhiteSpace(form.Model)) { formError = "مدل را وارد کنید."; return; }
        if (form.ConnectionType == "Network" && string.IsNullOrWhiteSpace(form.IpAddress))
        { formError = "برای ماشین شبکه، آدرس IP را وارد کنید."; return; }
        if (form.ConnectionType == "Cable" && form.LinkedSystemInfoId is not > 0)
        { formError = "برای ماشین کابلی، سیستم متصل را انتخاب کنید."; return; }
        busy = true;
        try
        {
            var payload = new MachineItem
            {
                Id = editId, Model = form.Model.Trim(),
                SerialNumber = NullIfEmpty(form.SerialNumber), Location = NullIfEmpty(form.Location),
                InstallDate = form.InstallDate,
                Notes = NullIfEmpty(form.Notes), IsActive = form.IsActive,
                ConnectionType = form.ConnectionType,
                IpAddress = form.ConnectionType == "Network" ? NullIfEmpty(form.IpAddress) : null,
                LinkedSystemInfoId = form.ConnectionType == "Cable" ? form.LinkedSystemInfoId : null,
                LinkedSystemLabel = form.ConnectionType == "Cable" ? form.LinkedSystemLabel : null
            };
            HttpResponseMessage resp;
            if (editing && editId > 0) resp = await Http.PutAsJsonAsync($"/api/OfficeMachines/{editId}", payload);
            else resp = await Http.PostAsJsonAsync("/api/OfficeMachines", payload);
            if (resp.IsSuccessStatusCode) { ShowForm = false; await Load(); }
            else formError = "خطای سرور: " + await resp.Content.ReadAsStringAsync();
        }
        catch (Exception ex) { formError = "ارتباط با API برقرار نشد. (" + ex.Message + ")"; }
        finally { busy = false; }
    }

    private async Task Delete(int id)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/OfficeMachines/{id}");
            if (resp.IsSuccessStatusCode) await Load();
        }
        catch { }
    }

    // ---------- فرم نگهداری و تعمیرات ----------
    private async Task OpenRepairForm(MachineItem m)
    {
        repairMachine = m;
        repairError = "";
        ResetRepairForm();
        await LoadRepairs();
    }

    private void CloseRepairForm()
    {
        repairMachine = null;
        repairList = new();
    }

    private void ResetRepairForm()
    {
        editingRepairId = 0;
        rf = new RepairForm();
    }

    private async Task LoadRepairs()
    {
        if (repairMachine == null) return;
        try { repairList = await Http.GetFromJsonAsync<List<RepairItem>>($"/api/OfficeMachines/{repairMachine.Id}/repairs") ?? new(); }
        catch { repairList = new(); }
    }

    private void EditRepair(RepairItem r)
    {
        editingRepairId = r.Id;
        rf = new RepairForm
        {
            GoneDate = r.GoneDate, ReturnDate = r.ReturnDate,
            Problem = r.Problem, PerformedWork = r.PerformedWork,
            Cost = r.Cost, Fixed = r.Fixed
        };
    }

    private async Task SaveRepair()
    {
        repairError = "";
        if (repairMachine == null) return;
        if (string.IsNullOrWhiteSpace(rf.Problem)) { repairError = "شرح ایراد را بنویسید."; return; }

        var payload = new RepairItem
        {
            Id = editingRepairId,
            GoneDate = rf.GoneDate, ReturnDate = rf.ReturnDate,
            Problem = rf.Problem.Trim(),
            PerformedWork = string.IsNullOrWhiteSpace(rf.PerformedWork) ? null : rf.PerformedWork.Trim(),
            Cost = rf.Cost, Fixed = rf.Fixed
        };

        HttpResponseMessage resp;
        if (editingRepairId > 0)
            resp = await Http.PutAsJsonAsync($"/api/OfficeMachines/repairs/{editingRepairId}", payload);
        else
            resp = await Http.PostAsJsonAsync($"/api/OfficeMachines/{repairMachine.Id}/repairs", payload);

        if (resp.IsSuccessStatusCode)
        {
            ResetRepairForm();
            await LoadRepairs();
            await Load();
        }
        else
        {
            var body = await resp.Content.ReadAsStringAsync();
            try { repairError = System.Text.Json.JsonDocument.Parse(body).RootElement.GetProperty("message").GetString(); }
            catch { repairError = $"کد {(int)resp.StatusCode}"; }
        }
    }

    private async Task DelRepair(int rid)
    {
        if (await Http.DeleteAsync($"/api/OfficeMachines/repairs/{rid}") is { IsSuccessStatusCode: true })
        {
            if (editingRepairId == rid) ResetRepairForm();
            await LoadRepairs();
            await Load();
        }
    }

