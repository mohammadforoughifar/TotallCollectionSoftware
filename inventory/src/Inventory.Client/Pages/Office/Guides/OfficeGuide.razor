@inject IJSRuntime JS

<div class="inner-letter-guide" dir="rtl" @ref="guideRoot">
    <header class="guide-hero">
        <div class="guide-hero-copy">
            <div class="guide-eyebrow"><i class="bi bi-stars"></i> اتوماسیون اداری / راهنمای کاربری</div>
            <h1>@Title</h1>
            <p>@Description</p>
            <div class="guide-actions no-print">
                <button type="button" class="guide-button primary" @onclick="Back">
                    <i class="bi bi-arrow-right"></i>
                    @BackLabel
                </button>
                <button type="button" class="guide-button secondary" @onclick="PrintGuide">
                    <i class="bi bi-printer"></i>
                    چاپ یا ذخیره PDF
                </button>
            </div>
            <div class="guide-meta">
                <span><i class="bi bi-check2-circle"></i> مطابق نسخه فعلی سامانه</span>
                <span><i class="bi bi-phone"></i> قابل استفاده در رایانه و موبایل</span>
            </div>
        </div>
        <div class="guide-hero-art" aria-hidden="true">
            <span class="art-orbit orbit-one"><i class="bi bi-send-fill"></i></span>
            <span class="art-orbit orbit-two"><i class="bi bi-paperclip"></i></span>
            <span class="art-orbit orbit-three"><i class="bi bi-check2-all"></i></span>
            <div class="art-envelope"><i class="bi @Icon"></i></div>
        </div>
    </header>

    <section class="quick-start" aria-label="شروع سریع">
        <div class="quick-start-head">
            <span class="section-kicker">شروع سریع</span>
            <h2>@QuickStartTitle</h2>
        </div>
        <div class="quick-steps">
            @for (var i = 0; i < Steps.Count; i++)
            {
                var step = Steps[i];
                if (i > 0) { <i class="bi bi-chevron-left step-arrow" aria-hidden="true"></i> }
                <div class="quick-step">
                    <span class="step-number">@((i + 1).FaDigits())</span>
                    <div><strong>@step.Title</strong><small>@step.Description</small></div>
                </div>
            }
        </div>
    </section>
    <div class="guide-layout">
        <aside class="guide-toc no-print" aria-label="فهرست راهنما">
            <div class="toc-title"><i class="bi bi-list-check"></i> فهرست مطالب</div>
            <nav>
                @for (var i = 0; i < Sections.Count; i++)
                {
                    var tocSection = Sections[i];
                    <button type="button" @onclick="() => ScrollTo(tocSection.Id)"><span>@((i + 1).FaDigits())</span> @tocSection.Title</button>
                }
            </nav>
            <div class="toc-tip"><i class="bi bi-lightbulb-fill"></i><span>نمایش بعضی دکمه‌ها به سطح دسترسی شما بستگی دارد.</span></div>
        </aside>
        <main class="guide-content">
            @ChildContent
            <footer class="guide-footer">
                <div><i class="bi bi-check2-circle"></i><span><b>پایان @Title</b><small>اکنون می‌توانید به بخش مربوط برگردید و کار را شروع کنید.</small></span></div>
                <button type="button" class="guide-button primary no-print" @onclick="Back"><i class="bi bi-arrow-right"></i> @BackLabel</button>
            </footer>
        </main>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter, EditorRequired] public string Description { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "bi-envelope-paper-heart-fill";
    [Parameter] public string BackLabel { get; set; } = "بازگشت";
    [Parameter] public string QuickStartTitle { get; set; } = "شروع کار در سه گام";
    [Parameter, EditorRequired] public IReadOnlyList<GuideStep> Steps { get; set; } = Array.Empty<GuideStep>();
    [Parameter, EditorRequired] public IReadOnlyList<GuideLink> Sections { get; set; } = Array.Empty<GuideLink>();
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback OnBack { get; set; }

    private ElementReference guideRoot;

    private Task Back() => OnBack.InvokeAsync();
    private async Task ScrollTo(string id) => await JS.InvokeVoidAsync("officeGuides.scrollTo", guideRoot, id);
    private async Task PrintGuide() => await JS.InvokeVoidAsync("officeGuides.print", guideRoot);
}
