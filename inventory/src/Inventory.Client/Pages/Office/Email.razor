@page "/office/email"
@page "/office/personal-email"
@inject IEmailClientService EmailSvc
@inject IAuthState Auth
@inject IToastService Toast
@inject LayoutState Layout
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IApiClient Api
@using Inventory.Client.Pages.Office.Letters
@using Inventory.Client.Pages.Office.Letters.Incoming
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

@* ============================================================
   پست الکترونیک — دو مسیر با یک چیدمان:
     /office/email           → ایمیل سازمانی (حساب‌های شخصی + رسمیِ دبیرخانه)
     /office/personal-email  → ایمیل شخصی (فقط حساب‌های شخصیِ خود کاربر)
   • پشتیبانی Gmail / Yahoo / Outlook / وب‌میل هاست / سفارشی
   • دریافت با IMAP، ارسال با SMTP، پیوست، نشان‌کردن، اسپم، بایگانی پوشه‌ای
   • فهرست‌ها با صفحه‌بندیِ کاملاً سمت سرور خوانده می‌شوند
   ============================================================ *@

<PageTitle>@(personalMode ? "ایمیل شخصی" : "ایمیل سازمانی")</PageTitle>

<div class="ltx" style="animation:none;transform:none">
    <div style="display:flex;height:calc(100vh - 130px);min-height:540px;background:var(--card);border:1px solid var(--line);border-radius:18px;overflow:hidden">
        <nav class="rail" style="flex:0 0 72px;overflow-y:auto">
                <div class="logo"><i class="bi bi-envelope-at"></i></div>

                @if (Auth.Has("Email.Create"))
                {
                    <button class="compose" title="ایمیل جدید" @onclick="OpenCompose"><i class="bi bi-plus-lg"></i></button>
                    <div style="height:8px"></div>
                }

                <button class="@(tab == "inbox" ? "on" : "")" title="دریافتی" @onclick='() => SetTab("inbox")' disabled="@busy">
                    <i class="bi bi-inbox-fill"></i>
                    @if (unreadCount > 0) { <span class="rbadge">@unreadCount.FaDigits()</span> }
                </button>
                <span class="rlbl">دریافتی</span>

                <button class="@(tab == "sent" ? "on" : "")" title="ارسالی" @onclick='() => SetTab("sent")' disabled="@busy">
                    <i class="bi bi-send"></i>
                </button>
                <span class="rlbl">ارسالی</span>

                <button class="@(tab == "starred" ? "on" : "")" title="نشان‌شده" @onclick='() => SetTab("starred")' disabled="@busy">
                    <i class="bi bi-star"></i>
                </button>
                <span class="rlbl">نشان</span>

                <button class="@(tab == "spam" ? "on" : "")" title="اسپم (هرزنامه)" @onclick='() => SetTab("spam")' disabled="@busy">
                    <i class="bi bi-shield-slash"></i>
                    @if (spamCount > 0) { <span class="rbadge">@spamCount.FaDigits()</span> }
                </button>
                <span class="rlbl">اسپم</span>

                <button class="@(tab == "archive" ? "on" : "")" title="بایگانی" @onclick='() => SetTab("archive")' disabled="@busy">
                    <i class="bi bi-archive"></i>
                </button>
                <span class="rlbl">بایگانی</span>

                <button class="@(tab == "accounts" ? "on" : "")" title="حساب‌ها" @onclick='() => SetTab("accounts")' disabled="@busy">
                    <i class="bi bi-gear"></i>
                </button>
                <span class="rlbl">حساب‌ها</span>

                <div class="grow"></div>
        </nav>
        <section style="flex:1;min-width:0;min-height:0;display:flex;flex-direction:column;overflow:hidden">
        <div style="padding:14px;width:100%;box-sizing:border-box;display:flex;flex-direction:column;min-height:0;flex:1">

        <div class="rd-top" style="border-radius:12px;margin-bottom:12px">
            <span class="t"><i class="bi @(personalMode ? "bi-person-badge" : "bi-envelope-at")" style="color:var(--p2)"></i> @(personalMode ? "ایمیل شخصی" : "ایمیل سازمانی")</span>
            <span class="spacer" style="flex:1"></span>
            @if (Auth.Has("Email.Create"))
            {
                <button class="lbtn pri" @onclick="OpenCompose"><i class="bi bi-pencil-square"></i> ایمیل جدید</button>
            }
        </div>

        @* ---------- نوار ابزار ---------- *@
        <div class="scard" style="margin-bottom:12px;display:flex;flex-wrap:wrap;gap:10px;align-items:center">
            <div class="chips" style="margin:0">
                <button class="chip @(tab == "inbox" ? "on" : "")" @onclick='() => SetTab("inbox")'>
                    <i class="bi bi-inbox"></i> دریافتی @if (unreadCount > 0) { <span class="n">@unreadCount.FaDigits()</span> }
                </button>
                <button class="chip @(tab == "sent" ? "on" : "")" @onclick='() => SetTab("sent")'>
                    <i class="bi bi-send"></i> ارسالی
                </button>
                <button class="chip @(tab == "starred" ? "on" : "")" @onclick='() => SetTab("starred")'>
                    <i class="bi bi-star"></i> نشان‌شده
                </button>
                <button class="chip @(tab == "spam" ? "on" : "")" @onclick='() => SetTab("spam")'>
                    <i class="bi bi-shield-slash"></i> اسپم @if (spamCount > 0) { <span class="n">@spamCount.FaDigits()</span> }
                </button>
                <button class="chip @(tab == "archive" ? "on" : "")" @onclick='() => SetTab("archive")'>
                    <i class="bi bi-archive"></i> بایگانی
                </button>
                <button class="chip @(tab == "accounts" ? "on" : "")" @onclick='() => SetTab("accounts")'>
                    <i class="bi bi-gear"></i> حساب‌ها
                </button>
            </div>

            @if (tab != "accounts")
            {
                <select class="tin" style="max-width:270px" @bind="accFilter" @bind:after="OnFilterChanged">
                    <option value="0">— همه حساب‌ها —</option>
                    @foreach (var a in VisibleAccounts)
                    {
                        <option value="@a.EmailId">
                            @(a.IsDabirkhane ? "📮 " : "")@a.EmailAddress @(a.IsMine ? "" : "(دبیرخانه)")
                        </option>
                    }
                </select>

                <div class="search" style="flex:1;min-width:180px">
                    <i class="bi bi-search"></i>
                    <input placeholder="جستجو در موضوع، آدرس، متن…" @bind="search" @bind:event="oninput" @bind:after="OnSearchChanged" />
                </div>

                <select class="tin" style="max-width:120px" @bind="pageSize" @bind:after="OnFilterChanged" title="تعداد ایمیل در هر صفحه">
                    <option value="25">۲۵ در صفحه</option>
                    <option value="50">۵۰ در صفحه</option>
                    <option value="100">۱۰۰ در صفحه</option>
                </select>

                @if (accFilter > 0)
                {
                    <button class="lbtn ghost" disabled="@syncing" @onclick="SyncNow">
                        <i class="bi @(syncing ? "bi-arrow-repeat bi-spin" : "bi-cloud-arrow-down")"></i>
                        @(syncing ? "در حال دریافت…" : tab == "spam" ? "دریافت هرزنامه‌ها" : "دریافت ایمیل‌ها")
                    </button>
                }
            }
        </div>

        @* ---------- مدیریت پوشه‌های بایگانی (تب بایگانی) ---------- *@
        @if (tab == "archive" && Auth.Has("Email.Create"))
        {
            <div class="scard" style="margin-bottom:12px;display:flex;flex-wrap:wrap;gap:8px;align-items:center">
                <b style="font-size:13px"><i class="bi bi-folder-plus" style="color:var(--p2)"></i> پوشه‌های بایگانی:</b>
                @foreach (var f in folders)
                {
                    var ff = f;
                    <span class="tg purple">
                        <i class="bi bi-folder"></i> @f.Title @(f.TypeEmail == 1 ? "(ارسالی)" : "(دریافتی)")
                        @if (Auth.Has("Email.Delete"))
                        {
                            <i class="bi bi-x-lg" style="cursor:pointer;margin-inline-start:4px" title="حذف پوشه" @onclick="() => DeleteFolder(ff)"></i>
                        }
                    </span>
                }
                @if (folders.Count == 0) { <span style="color:#64748b;font-size:12.5px">پوشه‌ای نیست</span> }
                <span style="flex:1"></span>
                <input class="tin" style="max-width:200px" placeholder="نام پوشه جدید…" @bind="newFolderTitle" />
                <select class="tin" style="max-width:120px" @bind="newFolderType">
                    <option value="0">دریافتی</option>
                    <option value="1">ارسالی</option>
                </select>
                <button class="lbtn pri" @onclick="AddFolder"><i class="bi bi-plus-lg"></i> افزودن</button>
            </div>
        }

        @* ---------- نوار پیشرفت هنگام دریافت/بارگذاری ---------- *@
        @if (busy)
        {
            <div class="eml-prog-wrap">
                <div class="eml-prog"><div class="bar"></div></div>
                <span class="eml-prog-t"><span class="sp"></span>@busyText</span>
            </div>
        }

        @* ==================== حساب‌ها ==================== *@
        @if (tab == "accounts")
        {
            @if (Auth.Has("Email.Create"))
            {
                <div style="margin-bottom:10px">
                    <button class="lbtn pri" @onclick='() => OpenAccountEditor(null)'><i class="bi bi-plus-lg"></i> افزودن حساب ایمیل</button>
                </div>
            }

            @* ----- حساب‌های دبیرخانه (در بخشِ ایمیلِ شخصی نمایش داده نمی‌شود) ----- *@
            @if (CanManageDabirkhane && !personalMode)
            {
                <div class="scard" style="margin-bottom:12px">
                    <h3><i class="bi bi-mailbox" style="color:var(--p2)"></i> حساب‌های رسمی دبیرخانه <span class="opt">— جدا از ایمیل شخصی؛ برای ارسال نامه صادره</span></h3>
                    @if (!accounts.Any(a => a.IsDabirkhane))
                    {
                        <div style="color:#d97706;font-size:13px;padding:6px 0">
                            <i class="bi bi-info-circle"></i> هنوز حساب دبیرخانه‌ای ثبت نشده — برای ارسال نامه با پست الکترونیک، حساب رسمی دبیرخانه را با تیک «دبیرخانه» اضافه کنید.
                        </div>
                    }
                    @foreach (var a in accounts.Where(x => x.IsDabirkhane))
                    {
                        var aa = a;
                        @AccountRow(aa)
                    }
                </div>
            }

            @* ----- حساب‌های شخصی ----- *@
            <div class="scard">
                <h3><i class="bi bi-person"></i> @(personalMode ? "حساب‌های ایمیل شخصی من" : "حساب‌های شخصی من")
                    @if (personalMode) { <span class="opt">— فقط ایمیل‌های شخصیِ شما؛ ایمیل‌های رسمیِ دبیرخانه در «ایمیل سازمانی» است</span> }
                </h3>
                @if (!VisibleAccounts.Any())
                {
                    <div style="color:#64748b;font-size:13px;padding:6px 0">
                        حساب شخصی ثبت نکرده‌اید — «افزودن حساب ایمیل» را بزنید و تیکِ «دبیرخانه» را برندارید.
                    </div>
                }
                @foreach (var a in VisibleAccounts)
                {
                    var aa = a;
                    @AccountRow(aa)
                }
            </div>
        }
        else
        {
            @* ==================== دو ستون لیست + خواندن ==================== *@
            <div class="eml-wrap">
                @* ---------- لیست ایمیل‌ها ---------- *@
                <div class="eml-list">
                    <div class="eml-scroll">
                        @if (loading)
                        {
                            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                        }
                        else if (messages.Count == 0)
                        {
                            <div class="empty">
                                <i class="bi @(tab == "spam" ? "bi-shield-check" : "bi-inbox")"></i>
                                @if (tab == "spam")
                                {
                                    @("هرزنامه‌ای نیست — «دریافت هرزنامه‌ها» را بزنید یا یک ایمیل را دستی اسپم کنید.")
                                }
                                else if (!string.IsNullOrWhiteSpace(search))
                                {
                                    @("نتیجه‌ای برای این جستجو پیدا نشد.")
                                }
                                else
                                {
                                    @(accFilter > 0 ? "ایمیلی نیست — «دریافت ایمیل‌ها» را بزنید." : "ایمیلی نیست — یک حساب انتخاب کنید و دریافت بزنید.")
                                }
                            </div>
                        }
                        else
                        {
                            string lastDay = "";
                            @foreach (var m in messages)
                            {
                                var mm = m;
                                var day = mm.Date.ToFaDate();
                                @if (day != lastDay) { lastDay = day; <div class="day">@day</div> }
                                <div class="mail @(mm.IsRead || mm.Box == "Sent" ? "" : "unread") @(mm.IsNeshan ? "starred" : "") @(openId == mm.Id && openBox == mm.Box ? "sel" : "")"
                                     @onclick="() => OpenMessage(mm)">
                                    <div class="avt">@AvatarText(mm)</div>
                                    <div class="mail-b">
                                        <div class="mail-r1">
                                            <span class="who">
                                                @(mm.Box == "Sent" ? mm.FromOrTo : mm.FromOrTo)
                                                <i class="bi bi-star-fill star-ico"></i>
                                            </span>
                                            <span class="tm num">@mm.Date.ToFaDateTime()</span>
                                        </div>
                                        <div class="mail-tt">@mm.Subject</div>
                                        <div class="mail-pv">@(mm.Box == "Sent" ? "به: " : "از: ")@PreviewName(mm)</div>
                                        <div class="tags">
                                            <span class="tg gray">@mm.AccountAddress</span>
                                            @if (mm.IsSpam) { <span class="tg red"><i class="bi bi-shield-slash"></i> اسپم</span> }
                                            @if (mm.IsAttachment) { <span class="tg gray"><i class="bi bi-paperclip"></i> پیوست</span> }
                                            @if (!string.IsNullOrEmpty(mm.FolderTitle)) { <span class="tg purple"><i class="bi bi-folder"></i> @mm.FolderTitle</span> }
                                            @if (!mm.IsRead && mm.Box == "Inbox") { <span class="tg blue">جدید</span> }
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                    </div>

                    @* ---------- صفحه‌بندی (سمت سرور) ---------- *@
                    @if (!loading && totalItems > 0)
                    {
                        <div class="eml-pager">
                            <span class="pg-info">
                                صفحه @curPage.FaDigits() از @totalPages.FaDigits()
                                — @totalItems.FaDigits() ایمیل
                            </span>
                            <span style="flex:1"></span>
                            @if (totalPages > 1)
                            {
                                <button class="pg" disabled="@(curPage <= 1)" @onclick="() => GoPageAsync(1)" title="صفحه‌ی اول">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                                <button class="pg" disabled="@(curPage <= 1)" @onclick="() => GoPageAsync(curPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                @if (PageButtons().First() > 1) { <span class="pg-gap">…</span> }
                                @foreach (var p in PageButtons())
                                {
                                    var pp = p;
                                    <button class="pg @(pp == curPage ? "on" : "")" @onclick="() => GoPageAsync(pp)">@pp.FaDigits()</button>
                                }
                                @if (PageButtons().Last() < totalPages) { <span class="pg-gap">…</span> }
                                <button class="pg" disabled="@(curPage >= totalPages)" @onclick="() => GoPageAsync(curPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="pg" disabled="@(curPage >= totalPages)" @onclick="() => GoPageAsync(totalPages)" title="صفحه‌ی آخر">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                            }
                        </div>
                    }
                </div>

                @* ---------- صفحه خواندن ---------- *@
                <div class="eml-reader">
                    @if (openMsg == null)
                    {
                        <div class="empty" style="margin:auto">
                            <i class="bi bi-envelope-open"></i>
                            ایمیلی برای نمایش انتخاب نشده است
                        </div>
                    }
                    else
                    {
                        <div class="rd-top">
                            <span class="t">@openMsg.Subject</span>
                            <span style="flex:1"></span>
                            <button class="icb @(openMsg.IsNeshan ? "gold" : "")" title="نشان‌کردن" @onclick="ToggleStar">
                                <i class="bi @(openMsg.IsNeshan ? "bi-star-fill" : "bi-star")"></i>
                            </button>
                            @if (openMsg.Box == "Inbox" && Auth.Has("Email.Create"))
                            {
                                <button class="icb" title="پاسخ" @onclick="ReplyTo"><i class="bi bi-reply"></i></button>
                            }
                            @if (openMsg.Box == "Inbox")
                            {
                                @* اسپم: انتقال به هرزنامه / بازگشت به صندوقِ دریافتی *@
                                <button class="icb @(openMsg.IsSpam ? "gold" : "")"
                                        title="@(openMsg.IsSpam ? "خارج کردن از هرزنامه" : "نشان‌کردن به‌عنوان هرزنامه")"
                                        @onclick="() => ToggleSpamAsync(!openMsg.IsSpam)">
                                    <i class="bi bi-shield-slash"></i>
                                </button>
                                <button class="icb" title="تبدیل به نامه داخلی" disabled="@converting" @onclick="ConvertToLetterAsync">
                                    <i class="bi @(converting ? "bi-arrow-repeat bi-spin" : "bi-file-earmark-arrow-up")"></i>
                                </button>
                                <button class="icb text-primary" title="تبدیل به نامه وارده" disabled="@converting" @onclick="ConvertToIncomingLetterAsync">
                                    <i class="bi bi-inbox-fill"></i>
                                </button>
                            }
                            <button class="icb" title="بایگانی" @onclick="() => archOpen = !archOpen"><i class="bi bi-archive"></i></button>
                        </div>

                        <div class="eml-scroll">
                            <div class="paper">
                                <div class="paper-h">
                                    <div class="avt"><i class="bi @(openMsg.Box == "Sent" ? "bi-send" : "bi-envelope")"></i></div>
                                    <div class="ph-meta">
                                        <div class="n1">@(openMsg.Box == "Sent" ? "به: " + openMsg.FromOrTo : openMsg.FromOrTo)</div>
                                        <div class="n2">از حساب @openMsg.AccountAddress — @openMsg.Date.ToFaDateTime()</div>
                                    </div>
                                    @if (archOpen)
                                    {
                                        <div class="ind" style="display:flex;gap:6px;align-items:center">
                                            <select class="tin" style="max-width:200px" @bind="archFolderId">
                                                <option value="0">— خروج از بایگانی —</option>
                                                @foreach (var f in folders.Where(f => f.TypeEmail == (openMsg.Box == "Sent" ? 1 : 0)))
                                                {
                                                    <option value="@f.EmailFolderId">@f.Title</option>
                                                }
                                            </select>
                                            <button class="lbtn ghost" @onclick="ArchiveCurrent"><i class="bi bi-check-lg"></i> ثبت</button>
                                        </div>
                                    }
                                </div>

                                <div class="paper-body">@((MarkupString)(openMsg.Body ?? "—"))</div>

                                @if (openMsg.Attachments.Count > 0)
                                {
                                    <div class="paper-foot">
                                        @foreach (var a in openMsg.Attachments)
                                        {
                                            var att = a;
                                            <button type="button" class="att text-start" @onclick="() => DownloadAttachmentAsync(att)">
                                                <div class="ic"><i class="bi bi-paperclip"></i></div>
                                                <div>@att.RealName<small>@FmtSize(att.Size)</small></div>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>        }
    </div>
        </section>
    </div>
</div>

@* ==================== مودال ارسال ایمیل ==================== *@
@if (composeOpen)
{
    <div class="ltx" style="animation:none;transform:none">
        <div class="ov"></div>
        <div class="sheet" style="max-width:640px">
            <div class="sheet-h">
                <b><i class="bi bi-pencil-square" style="color:var(--p2)"></i> @(composeReplyTo != null ? "پاسخ به ایمیل" : "ایمیل جدید")</b>
                <button class="x" @onclick="() => composeOpen = false"><i class="bi bi-x-lg"></i></button>
            </div>
            <div class="sheet-b">
                <div class="fcard">
                    <label>از حساب <span class="req">*</span></label>
                    <select class="tin" @bind="cpAccountId">
                        @foreach (var a in VisibleAccounts.Where(x => x.IsActive))
                        {
                            <option value="@a.EmailId">@(a.IsDabirkhane ? "📮 دبیرخانه — " : "")@a.EmailAddress</option>
                        }
                    </select>
                    @if (!accounts.Any(x => x.IsActive))
                    {
                        <div class="ferr"><i class="bi bi-info-circle"></i> ابتدا از تب «حساب‌ها» یک حساب اضافه کنید.</div>
                    }
                </div>
                <div class="fcard @(cpErrTo ? "err" : "")">
                    <label>گیرنده(ها) <span class="req">*</span> <span class="opt">با کاما جدا شوند</span></label>
                    <input class="tin" placeholder="a@sample.com، b@sample.com…" @bind="cpTo" @bind:event="oninput" />
                    @if (cpErrTo)
                    {
                        <div class="ferr"><i class="bi bi-exclamation-circle"></i> گیرنده الزامی است</div>
                    }
                </div>
                <div class="fcard">
                    <label>رونوشت <span class="opt">اختیاری</span></label>
                    <input class="tin" @bind="cpCc" />
                </div>
                <div class="fcard @(cpErrSubject ? "err" : "")">
                    <label>موضوع <span class="req">*</span></label>
                    <input class="tin" @bind="cpSubject" @bind:event="oninput" />
                    @if (cpErrSubject)
                    {
                        <div class="ferr"><i class="bi bi-exclamation-circle"></i> موضوع الزامی است</div>
                    }
                </div>
                <div class="fcard">
                    <label>متن ایمیل</label>
                    <textarea class="tin" rows="8" style="min-height:140px" @bind="cpBody"></textarea>
                </div>
                <div class="fcard">
                    <label>پیوست <span class="opt">هر فایل حداکثر ۲۰ مگابایت</span></label>
                    <InputFile OnChange="OnComposeFiles" multiple />
                    <div class="selpills">
                        @foreach (var f in _pendingBrowser)
                        {
                            var ff = f;
                            <span class="spill"><i class="bi bi-paperclip"></i> @ff.Name <small>(@FmtSize(ff.Size))</small> <i class="bi bi-x-lg" @onclick="() => _pendingBrowser.Remove(ff)"></i></span>
                        }
                        @foreach (var vf in _virtualAtts)
                        {
                            var vff = vf;
                            <span class="spill" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd"><i class="bi bi-file-earmark-pdf"></i> @vff.FileName <small>(@FmtSize(vff.Data.Length))</small> <i class="bi bi-x-lg" @onclick="() => _virtualAtts.Remove(vff)"></i></span>
                        }
                    </div>
                </div>
            </div>
            <div class="sheet-f">
                <span class="spacer"></span>
                <button class="lbtn ghost" @onclick="() => composeOpen = false">انصراف</button>
                <button class="lbtn pri" disabled="@cpBusy" @onclick="SubmitCompose">
                    @if (cpBusy) { <span class="spinner-border spinner-border-sm"></span> }
                    <i class="bi bi-send"></i> ارسال
                </button>
            </div>
        </div>
    </div>
}

@* ==================== مودال حساب ایمیل ==================== *@
@if (accOpen)
{
    <div class="ltx" style="animation:none;transform:none">
        <div class="ov"></div>
        <div class="sheet" style="max-width:620px">
