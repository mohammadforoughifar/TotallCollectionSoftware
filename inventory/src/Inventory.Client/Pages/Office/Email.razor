}

@* ==================== فرم ایجاد نامه داخلی (تبدیل ایمیل به نامه) ==================== *@
<ComposeLetterModal @ref="letterCompose" />
<ComposeIncomingModal @ref="composeIncomingModal" OnSaved="() => StateHasChanged()" />

@code {
    private bool loading = true;
    private bool syncing;

    /// <summary>در حال کار: همگام‌سازی با سرور یا بارگذاریِ فهرست.
    /// تا زمانی که درست است، تغییرِ بخش مجاز نیست تا کاربر وسطِ کار جابه‌جا نشود.</summary>
    private bool busy => syncing || loading;

    private string busyText => syncing ? "در حال دریافت ایمیل‌ها از سرور…" : "در حال بارگذاری…";
    private string tab = "inbox";
    private string search = "";
    private int accFilter;

    /// <summary>true وقتی کاربر از مسیر «ایمیل شخصی» آمده — فقط حساب‌های شخصیِ خودش</summary>
    private bool personalMode;

    // ---------- صفحه‌بندیِ سمت سرور ----------
    private int curPage = 1;
    private int pageSize = 25;
    private int totalItems;
    private int totalPages = 1;
    private int spamCount;

    private List<EmailAccountDto> accounts = new();
    private List<EmailMessageListItemDto> messages = new();
    private EmailMessageDetailDto? openMsg;
    private int openId;
    private string openBox = "";
    private int unreadCount;

    /// <summary>حساب‌هایی که در این صفحه دیده می‌شوند — در حالت شخصی فقط حساب‌های خودِ کاربر</summary>
    private List<EmailAccountDto> VisibleAccounts =>
        personalMode ? accounts.Where(a => a.IsMine && !a.IsDabirkhane).ToList() : accounts;

    private ComposeLetterModal? letterCompose;
    private bool converting;

    /// <summary>
    /// تبدیل ایمیل شخصی به نامه داخلی — فرم ایجاد نامه با عنوان و متنِ ایمیل
    /// و پیوست‌های آن باز می‌شود؛ کاربر بقیهٔ موارد را خودش پر می‌کند.
    /// </summary>
    private async Task DownloadAttachmentAsync(EmailAttachmentDto att)
    {
        try
        {
            var (data, name) = await EmailSvc.DownloadAttachmentAsync(att.AttachmentId);
            if (data is null || data.Length == 0) { Toast.Error("فایل پیوست پیدا نشد یا خالی است."); return; }
            await JS.InvokeVoidAsync("downloadBlob", string.IsNullOrWhiteSpace(name) ? att.RealName : name,
                "application/octet-stream", Convert.ToBase64String(data));
        }
        catch (Exception ex) { Toast.Error($"دانلود پیوست انجام نشد: {ex.Message}"); }
    }

    private async Task ConvertToLetterAsync()
    {
        if (openMsg == null) return;
        converting = true;
        try
        {
            var files = new List<IBrowserFile>();
            foreach (var a in openMsg.Attachments)
            {
                var (data, name) = await EmailSvc.DownloadAttachmentAsync(a.AttachmentId);
                if (data != null && data.Length > 0)
                    files.Add(new MemoryBrowserFile(name, "application/octet-stream", data));
            }

            // عنوانِ نامه نباید خالی باشد — ایمیل‌های بدون موضوع جایگزین می‌شوند
            var title = string.IsNullOrWhiteSpace(openMsg.Subject) ? "(بدون موضوع)" : openMsg.Subject.Trim();

            // سربرگِ «منبعِ نامه» تا گیرنده بداند این نامه برگرفته از یک ایمیل است
            var boxName = openMsg.Box == "Sent" ? "ارسالی" : "دریافتی";
            var from = openMsg.Box == "Sent" ? "به: " + openMsg.FromOrTo : "از: " + openMsg.FromOrTo;
            var header = "<div style=\"margin:0 0 12px;padding:8px 10px;border-inline-start:3px solid #c7d2fe;"
                       + "background:#f8fafc;border-radius:8px;font-family:Tahoma;font-size:12px;color:#475569;direction:rtl\">"
                       + "<b>برگرفته از ایمیل " + boxName + "</b><br/>"
                       + System.Net.WebUtility.HtmlEncode(from) + "<br/>"
                       + "موضوع: " + System.Net.WebUtility.HtmlEncode(title) + "<br/>"
                       + "حساب: " + System.Net.WebUtility.HtmlEncode(openMsg.AccountAddress)
                       + " — تاریخ: " + openMsg.Date.ToFaDateTime()
                       + "</div>";

            letterCompose?.Open(title, header + (openMsg.Body ?? ""), null, files);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { converting = false; }
    }

    private ComposeIncomingModal? composeIncomingModal;

    /// <summary>تبدیل ایمیل دریافتی به نامه وارده — فرم ثبت با اطلاعات ایمیل پر می‌شود.</summary>
    private async Task ConvertToIncomingLetterAsync()
    {
        if (openMsg == null || composeIncomingModal == null) return;
        converting = true;
        try
        {
            await composeIncomingModal.OpenFromEmail(openMsg);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { converting = false; }
    }

    private bool CanManageDabirkhane => Auth.Has("OutgoingLetters.Dabirkhane") || Auth.Has("Email.Delete");

    // ---------- بایگانی ----------
    private List<EmailFolderDto> folders = new();
    private bool archOpen;
    private int archFolderId;
    private string newFolderTitle = "";
    private int newFolderType;

    private async Task AddFolder()
    {
        if (string.IsNullOrWhiteSpace(newFolderTitle)) { Toast.Error("نام پوشه را وارد کنید."); return; }
        try
        {
            await EmailSvc.SaveFolderAsync(new SaveEmailFolderDto { Title = newFolderTitle.Trim(), TypeEmail = newFolderType });
            newFolderTitle = "";
            folders = await EmailSvc.GetFoldersAsync();
            Toast.Success("پوشه ایجاد شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteFolder(EmailFolderDto f)
    {
        try
        {
            await EmailSvc.DeleteFolderAsync(f.EmailFolderId);
            folders = await EmailSvc.GetFoldersAsync();
            Toast.Success("پوشه حذف شد.");
            await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---------- مودال ارسال ----------
    private bool composeOpen;
    private bool cpBusy, cpErrTo, cpErrSubject;
    private int cpAccountId;
    private string cpTo = "", cpCc = "", cpSubject = "", cpBody = "";
    private List<EmailOutAttachment> cpFiles = new();
    private EmailMessageDetailDto? composeReplyTo;

    // ---------- مودال حساب ----------
    private bool accOpen;
    private bool accBusy, accErrAddr, accErrPass;
    private int accEditId;
    private string accType = "Gmail", accAddress = "", accPassword = "", accSmtp = "", accImap = "";
    private int accSmtpPort = 587, accImapPort = 993;
    private bool accSmtpSsl = true, accImapSsl = true, accIsActive = true, accIsDabirkhane;
    private string? accDisplayName, presetHint, testMessage;
    private bool testOk;

    protected override async Task OnInitializedAsync()
    {
        // مسیرِ «ایمیل شخصی» همان صفحه است با پالایشِ حساب‌های شخصی
        personalMode = Nav.Uri.Contains("personal-email", StringComparison.OrdinalIgnoreCase);
        Layout.SetTitle(personalMode ? "ایمیل شخصی" : "ایمیل سازمانی");
        await LoadAccountsAsync();
        await ReloadAsync();

        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (qs["compose"] == "1" && qs["attach"] == "MeetingMinutes" && int.TryParse(qs["sourceId"], out var minId) && minId > 0 && !_composeHandled)
        {
            _composeHandled = true;
            await OpenComposeFromMinutesAsync(minId);
        }
    }

    public void Dispose() { _searchTimer?.Dispose(); }

    private async Task SetTab(string t)
    {
        tab = t; openMsg = null; openId = 0; openBox = ""; archOpen = false; curPage = 1;
        if (t == "accounts") await LoadAccountsAsync();
        if (t == "archive" && folders.Count == 0) { try { folders = await EmailSvc.GetFoldersAsync(); } catch { } }
        // دریافتی/ارسالی/اسپم: ابتدا فقط پیام‌های تازه از سرور گرفته و در بانک ذخیره می‌شوند،
        // سپس فهرستِ صفحه‌بندی‌شده از بانک خوانده می‌شود.
        if (t is "inbox" or "sent" or "spam")
        {
            if (VisibleAccounts.Any(a => a.IsActive)) await SyncFolderAsync(t);
            else { messages = new(); totalItems = 0; totalPages = 1; unreadCount = 0; spamCount = 0; }
        }
        await ReloadAsync();
    }

    /// <summary>
    /// همگام‌سازیِ افزایشی: بارِ اول همه‌ی پیام‌ها را در بانک می‌نشاند؛
    /// در دفعات بعد فقط پیام‌های جدیدتر از آخرین نوبت را می‌گیرد.
    /// </summary>
    private async Task SyncFolderAsync(string box)
    {
        syncing = true;
        StateHasChanged();
        try
        {
            var r = box switch
            {
                "sent" => await EmailSvc.SyncSentAsync(),
                "spam" => await EmailSvc.SyncJunkAsync(),
                _ => await EmailSvc.SyncInboxAsync()
            };
            // فقط هنگام رسیدنِ پیام تازه اطلاع می‌دهیم تا هر بار کلیک مزاحم نشود
            if (r.NewCount > 0) Toast.Success(r.Message);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { syncing = false; StateHasChanged(); }
    }

    private async Task LoadAccountsAsync()
    {
        try
        {
            accounts = await EmailSvc.GetAccountsAsync();
            var pool = VisibleAccounts;
            if (cpAccountId == 0 && pool.Any(x => x.IsActive))
                cpAccountId = pool.First(x => x.IsActive).EmailId;
            if (accFilter > 0 && accounts.All(x => x.EmailId != accFilter)) accFilter = 0;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>
    /// خواندنِ یک صفحه از فهرست. همه‌ی پالایش‌ها (جستجو، پوشه، اسپم، نشان،
    /// حساب) و برشِ صفحه در بانک انجام می‌شود و فقط همین صفحه به کلاینت می‌آید.
    /// </summary>
    private async Task ReloadAsync()
    {
        loading = true;
        try
        {
            // نبود حساب ایمیل یک وضعیت عادی است، نه خطای احراز هویت؛
            // در این حالت صندوق‌ها خالی نمایش داده می‌شوند تا کاربر حساب بسازد.
            if (tab != "accounts" && !VisibleAccounts.Any(a => a.IsActive))
            {
                messages = new(); totalItems = 0; totalPages = 1; unreadCount = 0; spamCount = 0;
                return;
            }
            int? fid = accFilter > 0 ? accFilter : null;
            var term = string.IsNullOrWhiteSpace(search) ? null : search.Trim();

            EmailListPageDto res;
            if (tab == "archive")
                res = await EmailSvc.GetArchiveAsync(fid, term, curPage, pageSize, personalMode);
            else if (tab == "sent")
                res = await EmailSvc.GetSentAsync(fid, term, null, curPage, pageSize, false, personalMode);
            else if (tab == "starred")
                res = await EmailSvc.GetInboxAsync(fid, term, null, null, curPage, pageSize, false, true, personalMode);
            else if (tab == "spam")
                res = await EmailSvc.GetInboxAsync(fid, term, null, null, curPage, pageSize, true, false, personalMode);
            else
                res = await EmailSvc.GetInboxAsync(fid, term, null, null, curPage, pageSize, false, false, personalMode);

            totalItems = res.TotalCount;
            totalPages = res.PageCount;
            spamCount = res.SpamCount;
            if (tab == "inbox") unreadCount = res.UnreadCount;

            // اگر بعد از حذف/اسپم/تغییرِ فیلتر، شماره‌ی صفحه از محدوده بیرون رفته باشد
            // (مثلاً آخرین آیتمِ آخرین صفحه حذف شده)، یک‌بار با صفحه‌ی معتبر بازخوانی می‌شود
            if (curPage > totalPages && totalPages >= 1)
            {
                curPage = totalPages;
                await ReloadAsync();
                return;
            }

            messages = res.Items;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    /// <summary>رفتن به یک صفحه — همیشه از سرور خوانده می‌شود</summary>
    private async Task GoPageAsync(int p)
    {
        if (p < 1 || p > totalPages || p == curPage) return;
        curPage = p;
        await ReloadAsync();
    }

    /// <summary>شماره‌های صفحه برای نمایش — پنجره‌ای تا هفت دکمه</summary>
    private List<int> PageButtons()
    {
        const int win = 7;
        if (totalPages <= win) return Enumerable.Range(1, totalPages).ToList();
        var start = Math.Max(1, Math.Min(curPage - win / 2, totalPages - win + 1));
        return Enumerable.Range(start, win).ToList();
    }

    // ---------- جستجو با تأخیر (جلوگیری از یک درخواست به‌ازای هر کلید) ----------
    private System.Threading.Timer? _searchTimer;

    private void OnSearchChanged()
    {
        _searchTimer?.Dispose();
        _searchTimer = new System.Threading.Timer(_ => _ = InvokeAsync(async () =>
        {
            curPage = 1;
            await ReloadAsync();
            StateHasChanged();
        }), null, 400, Timeout.Infinite);
    }

    private async Task OnFilterChanged()
    {
        curPage = 1;
        await ReloadAsync();
    }

    /// <summary>نشان‌کردن / خارج‌کردنِ یک ایمیل از هرزنامه</summary>
    private async Task ToggleSpamAsync(bool spam)
    {
        if (openMsg == null) return;
        try
        {
            await EmailSvc.MarkSpamAsync(openMsg.Box, openMsg.Id, spam);
            openMsg.IsSpam = spam;
            Toast.Success(spam ? "به هرزنامه منتقل شد." : "به صندوقِ دریافتی بازگشت.");
            openMsg = null; openId = 0; openBox = "";
            await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task SyncNow()
    {
        if (accFilter <= 0) { Toast.Error("ابتدا یک حساب انتخاب کنید."); return; }
        syncing = true;
        try
        {
            // در تبِ اسپم پوشه‌ی هرزنامه (Junk) روی سرورِ IMAP خوانده می‌شود
            var r = tab == "spam"
                ? await EmailSvc.SyncJunkAsync()
                : await EmailSvc.SyncAsync(accFilter);
            if (r.NewCount > 0) Toast.Success(r.Message);
            await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { syncing = false; }
    }

    // ==================== پیام‌ها ====================

    /// <summary>حروفِ آواتارِ ردیف — هم‌طراز با کارتابل نامه داخلی</summary>
    private static string AvatarText(EmailMessageListItemDto m)
    {
        var s = (m.FromOrTo ?? "").Trim();
        if (s.StartsWith("به:")) s = s[3..].Trim();
        var at = s.IndexOf('@');
        if (at > 0) s = s[..at];
        s = s.Trim(' ', '<', '>', '"', '\'');
        if (string.IsNullOrEmpty(s)) return "\u2709";
        var parts = s.Split(new[] { ' ', '.', '_', '-' }, StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length >= 2) return (parts[0][..1] + parts[1][..1]).ToUpperInvariant();
        return s.Length >= 2 ? s[..2] : s.ToUpperInvariant();
    }

    /// <summary>پیش‌نمایشِ زیرِ عنوان در فهرست</summary>
    private static string PreviewName(EmailMessageListItemDto m)
    {
        var s = (m.FromOrTo ?? "").Trim();
        if (string.IsNullOrEmpty(s)) return m.AccountAddress ?? "";
        return s.Length > 60 ? s[..60] + "\u2026" : s;
    }

    private async Task OpenMessage(EmailMessageListItemDto m)
    {
        try
        {
            if (folders.Count == 0)
            {
                try { folders = await EmailSvc.GetFoldersAsync(); } catch { }
            }
            openMsg = await EmailSvc.GetMessageAsync(m.Box, m.Id);
            openId = m.Id; openBox = m.Box; archOpen = false;
            archFolderId = openMsg.IsInFolder;
            if (!m.IsRead && m.Box == "Inbox") { m.IsRead = true; unreadCount = Math.Max(0, unreadCount - 1); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ToggleStar()
    {
        if (openMsg == null) return;
        try
        {
            openMsg.IsNeshan = await EmailSvc.ToggleNeshanAsync(openMsg.Box, openMsg.Id);
            var m = messages.FirstOrDefault(x => x.Id == openMsg.Id && x.Box == openMsg.Box);
            if (m != null) m.IsNeshan = openMsg.IsNeshan;
            if (tab == "starred" && !openMsg.IsNeshan) await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ArchiveCurrent()
    {
        if (openMsg == null) return;
        try
        {
            await EmailSvc.ArchiveAsync(openMsg.Box, openMsg.Id, archFolderId);
            Toast.Success(archFolderId > 0 ? "ایمیل بایگانی شد." : "از بایگانی خارج شد.");
            archOpen = false;
            await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ==================== ارسال ====================

    private void OpenCompose()
    {
        composeReplyTo = null;
        cpTo = cpCc = cpSubject = cpBody = "";
        cpErrTo = cpErrSubject = false;
        cpFiles.Clear();
        _pendingBrowser.Clear();
        _virtualAtts.Clear();
        var pool = VisibleAccounts;
        if (pool.Any(x => x.IsActive)) cpAccountId = pool.First(x => x.IsActive).EmailId;
        composeOpen = true;
    }

    private void ReplyTo()
    {
        if (openMsg == null) return;
        composeReplyTo = openMsg;
        cpAccountId = openMsg.EmailId;
        cpTo = openMsg.FromOrTo;
        cpCc = ""; cpBody = "";
        cpSubject = openMsg.Subject.StartsWith("پاسخ:", StringComparison.OrdinalIgnoreCase) ? openMsg.Subject : "پاسخ: " + openMsg.Subject;
        cpErrTo = cpErrSubject = false;
        cpFiles.Clear();
        _pendingBrowser.Clear();
        composeOpen = true;
    }

    private bool _composeHandled;
    private List<EmailOutAttachment> _virtualAtts = new();
    private async Task OpenComposeFromMinutesAsync(int minutesId)
    {
        try
        {
            var m = await Api.GetAsync<Inventory.Shared.Dtos.MinutesDetailDto>($"api/meeting-minutes/{minutesId}");
            if (m != null)
            {
                OpenCompose();
                cpSubject = $"صورتجلسه: {m.Title}";
                var sb = new System.Text.StringBuilder();
                sb.AppendLine("با سلام و احترام،");
                sb.AppendLine($"صورتجلسه «{m.Title}» مورخ {PersianDate.ToShortFa(m.MeetingDate)} به پیوست ارسال می‌گردد.");
                sb.AppendLine();
                sb.AppendLine("خلاصه مصوبات:");
                foreach (var itm in m.Items)
                {
                    var due = itm.DueDate != null ? PersianDate.ToShortFa(itm.DueDate.Value) : "—";
                    sb.AppendLine($"- بند {itm.RowNo}: {itm.Description} (مهلت: {due})");
                }
                cpBody = sb.ToString();

                try
                {
                    var pdfRes = await Api.GetFileAsync($"api/meeting-minutes/{minutesId}/print.pdf");
                    if (pdfRes.Data != null && pdfRes.Data.Length > 0)
                    {
                        var fname = !string.IsNullOrWhiteSpace(pdfRes.FileName) ? pdfRes.FileName : $"صورتجلسه-{minutesId}.pdf";
                        _virtualAtts.Add(new EmailOutAttachment(fname, pdfRes.ContentType ?? "application/pdf", pdfRes.Data));
                    }
                }
                catch { }
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری صورتجلسه: {ex.Message}");
            OpenCompose();
        }
    }

    private List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> _pendingBrowser = new();

    private void OnComposeFiles(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(20))
        {
            if (f.Size <= 0 || f.Size > 20L * 1024 * 1024)
            {
                Toast.Error($"فایل {f.Name} پذیرفته نشد (حداکثر ۲۰ مگابایت).");
                continue;
            }
            _pendingBrowser.Add(f);
        }
    }

    private async Task SubmitCompose()
    {
        cpErrTo = string.IsNullOrWhiteSpace(cpTo);
        cpErrSubject = string.IsNullOrWhiteSpace(cpSubject);
        if (cpErrTo || cpErrSubject) { Toast.Error("گیرنده و موضوع الزامی است."); return; }
        if (cpAccountId <= 0) { Toast.Error("حساب فرستنده را انتخاب کنید."); return; }

        cpBusy = true;
        try
        {
            var files = new List<EmailOutAttachment>();
            foreach (var bf in _pendingBrowser)
            {
                try
                {
                    await using var s = bf.OpenReadStream(20L * 1024 * 1024);
                    using var ms = new MemoryStream();
                    await s.CopyToAsync(ms);
                    files.Add(new EmailOutAttachment(bf.Name, bf.ContentType, ms.ToArray()));
                }
                catch (Exception ex) { Toast.Error($"خواندن {bf.Name}: {ex.Message}"); }
            }
            files.AddRange(_virtualAtts);
            await EmailSvc.SendAsync(cpAccountId, cpTo, cpCc, cpSubject, cpBody, files);
            Toast.Success("ایمیل ارسال شد.");
            composeOpen = false;
            _pendingBrowser.Clear();
            cpFiles.Clear();
            _virtualAtts.Clear();
            if (tab == "sent") await ReloadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { cpBusy = false; }
    }

    // ==================== حساب‌ها ====================

    private static string PresetTitle(string t) => t switch
    {
        "Gmail" => "جیمیل",
        "Yahoo" => "یاهو",
        "Outlook" => "اوت‌لوک / Office365",
        "Webmail" => "وب‌میل (هاست/سازمان)",
        _ => "سفارشی"
    };

    private void ApplyPreset(string type)
    {
        accType = type;
        testMessage = null;
        var preset = OtoEmailPresets.Find(type);
        if (preset != null)
        {
            if (type != "Custom")
            {
                accSmtp = preset.Smtp; accSmtpPort = preset.SmtpPort; accSmtpSsl = preset.SmtpSsl;
                accImap = preset.Imap; accImapPort = preset.ImapPort; accImapSsl = preset.ImapSsl;
            }
            presetHint = preset.Hint;
        }
    }

    private void OpenAccountEditor(EmailAccountDto? a)
    {
        accErrAddr = accErrPass = false;
        testMessage = null;
        if (a == null)
        {
            accEditId = 0;
            accAddress = accPassword = ""; accDisplayName = null;
            accIsActive = true; accIsDabirkhane = false;
            ApplyPreset("Gmail");
        }
        else
        {
            accEditId = a.EmailId;
            accAddress = a.EmailAddress; accPassword = "";
            accType = string.IsNullOrWhiteSpace(a.EmailType) ? "Custom" : a.EmailType;
            accSmtp = a.Smtp; accSmtpPort = a.SmtpPort; accSmtpSsl = a.SmtpSsl;
            accImap = a.Imap; accImapPort = a.ImapPort; accImapSsl = a.ImapSsl;
            accDisplayName = a.DisplayName; accIsActive = a.IsActive; accIsDabirkhane = a.IsDabirkhane;
            presetHint = OtoEmailPresets.Find(accType)?.Hint;
        }
        accOpen = true;
    }

    private SaveEmailAccountDto BuildDto() => new()
    {
        EmailId = accEditId,
        EmailAddress = accAddress?.Trim() ?? "",
        Password = accPassword,
        EmailType = accType,
        Smtp = accSmtp?.Trim() ?? "",
        SmtpPort = accSmtpPort,
        SmtpSsl = accSmtpSsl,
        Imap = accImap?.Trim() ?? "",
        ImapPort = accImapPort,
        ImapSsl = accImapSsl,
        DisplayName = accDisplayName,
        IsActive = accIsActive,
        IsDabirkhane = accIsDabirkhane
    };

    private async Task TestAccount()
    {
        accErrAddr = string.IsNullOrWhiteSpace(accAddress);
        accErrPass = accEditId == 0 && string.IsNullOrWhiteSpace(accPassword);
        if (accErrAddr || accErrPass) return;
        accBusy = true;
        try
        {
            var r = await EmailSvc.TestAccountAsync(BuildDto());
            testOk = r.SmtpOk && r.ImapOk;
            testMessage = r.Message;
        }
        catch (Exception ex) { testOk = false; testMessage = ex.Message; }
        finally { accBusy = false; }
    }

    private async Task SaveAccount()
    {
        accErrAddr = string.IsNullOrWhiteSpace(accAddress);
        accErrPass = accEditId == 0 && string.IsNullOrWhiteSpace(accPassword);
        if (accErrAddr || accErrPass) { Toast.Error("موارد الزامی را تکمیل کنید."); return; }
        accBusy = true;
        try
        {
            await EmailSvc.SaveAccountAsync(BuildDto());
            Toast.Success("حساب ایمیل ذخیره شد.");
            accOpen = false;
            await LoadAccountsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { accBusy = false; }
    }

    private async Task DeleteAccount(EmailAccountDto a)
    {
        try
        {
            await EmailSvc.DeleteAccountAsync(a.EmailId);
            Toast.Success("حساب حذف شد.");
            await LoadAccountsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private RenderFragment AccountRow(EmailAccountDto a) => @<div style="display:flex;flex-wrap:wrap;gap:10px;align-items:center;border:1px solid #e2e8f0;border-radius:10px;padding:10px 12px;margin-bottom:8px">
        <i class="bi @(a.IsDabirkhane ? "bi-mailbox" : "bi-person-badge")" style="color:var(--p2);font-size:18px"></i>
        <div style="flex:1;min-width:200px">
            <div style="font-weight:700;font-size:13.5px">@a.EmailAddress @if (!a.IsActive) { <span class="tg gray">غیرفعال</span> }</div>
            <div style="font-size:12px;color:#64748b;display:flex;gap:10px;flex-wrap:wrap;margin-top:2px">
                <span>@PresetTitleSafe(a.EmailType)</span>
                <span>SMTP: @(string.IsNullOrWhiteSpace(a.Smtp) ? "—" : a.Smtp + ":" + a.SmtpPort)</span>
                <span>IMAP: @(string.IsNullOrWhiteSpace(a.Imap) ? "—" : a.Imap + ":" + a.ImapPort)</span>
                @if (a.LastSync is { } ls) { <span>آخرین دریافت: @ls.ToFaDateTime()</span> }
                @if (!a.IsMine) { <span>مالک: @a.UserName</span> }
            </div>
        </div>
        @if (a.IsMine && Auth.Has("Email.Create"))
        {
            <button class="lbtn ghost" @onclick="() => OpenAccountEditor(a)"><i class="bi bi-pencil-square"></i> ویرایش</button>
        }
        @if (a.IsMine && Auth.Has("Email.Delete"))
        {
            <button class="lbtn red" @onclick="() => DeleteAccount(a)"><i class="bi bi-trash"></i></button>
        }
    </div>;

    private static string PresetTitleSafe(string t) => OtoEmailPresets.Title(t);

    private static string FmtSize(long b) =>
        b >= 1024 * 1024 ? $"{b / 1024.0 / 1024.0:0.#} مگابایت".FaDigits()
        : b >= 1024 ? $"{b / 1024} کیلوبایت".FaDigits()
        : $"{b} بایت".FaDigits();
}
