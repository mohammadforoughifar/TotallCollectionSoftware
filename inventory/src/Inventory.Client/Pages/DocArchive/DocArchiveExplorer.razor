@page "/doc-archive"
@page "/doc-archive/documents"
@inject IDocArchiveService Svc
@inject IToastService Toast
@inject IAuthState Auth
@inject LayoutState Layout
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>آرشیو اسناد و مدارک</PageTitle>

<div class="doc-archive-shell da-explorer" dir="rtl">
<header class="da-page-header">
    <div class="da-page-heading">
        <span class="da-page-icon"><i class="bi bi-folder2-open"></i></span>
        <h1>@(statusFilter switch { "inactive" => "مدارک غیرفعال", "deleted" => "سطل بازیافت", _ => "آرشیو اسناد و مدارک" })</h1>
    </div>
    <div class="da-page-actions">
        <div class="da-tools" @onkeydown="OnToolsKeyDown">
            <button type="button" class="btn btn-outline-secondary da-tools-trigger" aria-expanded="@(showTools ? "true" : "false")" aria-controls="da-tools-menu" @onclick="() => showTools = !showTools">
                <i class="bi bi-three-dots"></i> ابزارها
            </button>
            @if (showTools)
            {
                <button type="button" class="da-tools-backdrop" tabindex="-1" aria-label="بستن ابزارها" @onclick="() => showTools = false"></button>
                <div class="da-tools-menu" id="da-tools-menu">
                    <button type="button" @onclick="() => { showTools = false; showTagsModal = true; }"><i class="bi bi-tags"></i> برچسب‌ها</button>
                    <button type="button" @onclick="() => { showTools = false; OpenZipModal(selectedFolderId); }"><i class="bi bi-file-earmark-zip"></i> دانلود ZIP</button>
                    @if (Auth.Has("DocArchive.Manage"))
                    {
                        <button type="button" @onclick="async () => { showTools = false; await OpenCodeSettings(); }"><i class="bi bi-gear"></i> تنظیمات</button>
                    }
                    @if (IsManager && statusFilter != "deleted")
                    {
                        <hr />
                        <button type="button" @onclick="() => { showTools = false; showQueue = true; }"><i class="bi bi-list-task"></i> صف پردازش فایل‌ها</button>
                        <button type="button" disabled="@checkingExpiry" @onclick="async () => { showTools = false; await RunExpiryCheck(); }"><i class="bi bi-bell"></i> بررسی انقضا</button>
                        <button type="button" disabled="@reindexing" @onclick="async () => { showTools = false; await ReindexAll(); }"><i class="bi bi-file-earmark-font"></i> بازخوانی متن اسناد</button>
                    }
                </div>
            }
        </div>
        @if (Auth.Has("DocArchive.Create"))
        {
            <button type="button" class="btn btn-outline-secondary" @onclick="() => OpenFolder(null)"><i class="bi bi-folder-plus"></i> پوشه جدید</button>
        }
        @if (Auth.Has("DocArchive.Create") || CanWriteHere)
        {
            <button type="button" class="btn btn-primary da-new-document" data-hotkey="f2" title="مدرک جدید — F2" @onclick="OpenNewDoc" disabled="@(!CanWriteHere || statusFilter != "active")"><i class="bi bi-plus-lg"></i> مدرک جدید</button>
        }
    </div>
</header>

<div class="row g-3 da-workspace">
    @* ---------------- درخت پوشه‌ها (قابل جمع شدن، مخصوص موبایل) ---------------- *@
    <aside class="col-lg-3 da-folders @(showFoldersPane ? "" : "d-none")" aria-label="پوشه‌های اسناد">
        <div class="card h-100">
            <div class="card-header fw-700 fs-8 d-flex justify-content-between align-items-center">
                <span><i class="bi bi-diagram-3 ms-1"></i> پوشه‌ها</span>
                <span class="badge bg-secondary">@folders.Count</span>
            </div>
            <div class="card-body p-2" style="max-height:75vh;overflow:auto;">
                <div class="ftree-item @(statusFilter == "active" && selectedFolderId == null && expiryFilter == null ? "active" : "")"
                     @onclick="ShowAllActive">
                    <i class="bi bi-archive text-primary"></i>
                    <span class="fw-500">همه مدارک</span>
                </div>

                @* ---- زیرمنوهای انقضا ---- *@
                <div class="ftree-item @(expiryFilter == "expired" ? "active" : "")" @onclick="ShowExpired">
                    <i class="bi bi-calendar-x-fill text-danger"></i>
                    <span class="fw-500 text-danger">منقضی شده</span>
                    @if (expirySummary.Expired > 0)
                    {
                        <span class="badge bg-danger ms-auto">@expirySummary.Expired.Num()</span>
                    }
                </div>
                <div class="ftree-item @(expiryFilter == "expiring" ? "active" : "")" @onclick="ShowExpiring">
                    <i class="bi bi-clock-history text-warning"></i>
                    <span class="fw-500 text-warning-emphasis">رو به انقضا</span>
                    @if (expirySummary.ExpiringSoon > 0)
                    {
                        <span class="badge bg-warning text-dark ms-auto">@expirySummary.ExpiringSoon.Num()</span>
                    }
                </div>

                @* ---- زیرمنوی مدارک غیرفعال ---- *@
                <div class="ftree-item @(statusFilter == "inactive" ? "active" : "")" @onclick="ShowInactive">
                    <i class="bi bi-archive-fill text-secondary"></i>
                    <span class="fw-500 text-secondary">مدارک غیرفعال</span>
                    @if (inactiveCount > 0)
                    {
                        <span class="badge bg-secondary ms-auto">@inactiveCount.Num()</span>
                    }
                </div>
                <div class="ftree-item @(statusFilter == "deleted" ? "active" : "")" @onclick="ShowTrash">
                    <i class="bi bi-trash3 text-danger"></i>
                    <span class="fw-500 text-secondary">سطل بازیافت</span>
                    @if (trashCount > 0)
                    {
                        <span class="badge bg-danger-subtle text-danger ms-auto">@trashCount.Num()</span>
                    }
                </div>
                <hr class="my-1" />
                @if (loadingFolders)
                {
                    <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
                }
                else
                {
                    @RenderTree(null, 0)
                }
            </div>
        </div>
    </aside>

    @* ---------------- لیست مدارک و ابزار جستجو ---------------- *@
    <div class="col-lg-@(showFoldersPane ? 9 : 12) da-results">
        <div class="da-toolbar">
            <div class="da-search">
                <i class="bi bi-search"></i>
                <input class="form-control" aria-label="جستجوی اسناد" placeholder="جستجوی اسناد…" @bind="search" @bind:event="oninput" @bind:after="OnSearchChanged" />
                @if (!string.IsNullOrWhiteSpace(search))
                {
                    <button type="button" class="da-search-clear" aria-label="پاک کردن جستجو" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
                }
            </div>
            <button type="button" class="btn da-filter-button @(showAdvancedFilter || ActiveFilterCount > 0 ? "btn-primary" : "btn-outline-secondary")" aria-expanded="@(showAdvancedFilter ? "true" : "false")" @onclick="() => showAdvancedFilter = !showAdvancedFilter">
                <i class="bi bi-funnel"></i> فیلتر
                @if (ActiveFilterCount > 0) { <span class="badge bg-white text-primary">@ActiveFilterCount.Num()</span> }
            </button>
            <div class="da-view-actions">
                <div class="btn-group btn-group-sm" role="group" aria-label="نمایش مدارک">
                    <button type="button" class="btn @(viewMode == "table" ? "btn-primary" : "btn-outline-secondary")" title="نمای جدولی" aria-label="نمای جدولی" @onclick='() => SetViewMode("table")'><i class="bi bi-table"></i></button>
                    <button type="button" class="btn @(viewMode == "cards" ? "btn-primary" : "btn-outline-secondary")" title="نمای کارتی" aria-label="نمای کارتی" @onclick='() => SetViewMode("cards")'><i class="bi bi-grid"></i></button>
                </div>
                <button type="button" class="btn btn-sm @(showFoldersPane ? "btn-outline-secondary" : "btn-secondary")" title="پوشه‌ها" aria-label="نمایش یا پنهان‌کردن پوشه‌ها" aria-expanded="@(showFoldersPane ? "true" : "false")" @onclick="() => showFoldersPane = !showFoldersPane"><i class="bi bi-layout-sidebar"></i></button>
                <ExportButtons ReportKey="@(expiryFilter is null ? "doc-list" : "doc-expiring")" ShowText="false" Query="@(new { status = statusFilter, search = search, id = selectedFolderId })" />
            </div>
        </div>
        <div class="da-location-bar">
            <div class="da-location">
                @if (selectedFolderId is int fid)
                {
                    var f = folders.FirstOrDefault(x => x.Id == fid);
                    <button type="button" class="da-all-link" @onclick="ShowAllActive">همه مدارک</button>
                    <i class="bi bi-chevron-left"></i>
                    <span class="da-folder-name">@f?.Name</span>
                    <span class="da-access" title="سطح دسترسی">@LevelName(f?.MyLevel ?? DocAccessLevelDto.None)</span>
                    @if (f?.MyCanDownload == true)
                    {
                        <button type="button" class="btn btn-sm btn-light" title="دانلود پوشه" aria-label="دانلود پوشه" @onclick="() => OpenZipModal(fid)"><i class="bi bi-download"></i></button>
                    }
                }
                else
                {
                    <span>@(statusFilter switch { "inactive" => "غیرفعال", "deleted" => "حذف‌شده", _ => "همه مدارک" })</span>
                }
                @if (expiryFilter != null)
                {
                    <span class="da-expiry-filter">
                        @(expiryFilter == "expired" ? "منقضی‌شده" : "رو به انقضا")
                        <button type="button" aria-label="حذف فیلتر انقضا" @onclick="ClearExpiryFilter"><i class="bi bi-x"></i></button>
                    </span>
                }
            </div>
            <div class="da-result-actions">
                @if (statusFilter == "deleted" && IsManager && documents.Count > 0)
                {
                    <button type="button" class="btn btn-sm btn-outline-danger" @onclick="OpenPurgeAll"><i class="bi bi-trash3"></i> خالی کردن سطل</button>
                }
                <span class="da-result-count">@totalDocuments.Num() مدرک</span>
            </div>
        </div>

        @* ---------------- پنل فیلترهای پیشرفته و جستجوی تمام‌متن (Full-Text Search) ---------------- *@
        @if (showAdvancedFilter)
        {
            <div class="card da-filters">
                <div class="card-header py-2 bg-white d-flex justify-content-between align-items-center">
                    <span class="fw-700 fs-8 text-primary">
                        <i class="bi bi-sliders me-1"></i> فیلتر اسناد
                    </span>
                    <button class="btn btn-sm btn-link text-decoration-none text-muted p-0" @onclick="ResetFilters">
                        <i class="bi bi-trash"></i> پاک کردن
                    </button>
                </div>
                <div class="card-body py-2 fs-8">
                    <div class="row g-2">
                        @* جستجوی محتوای فایل‌ها و OCR *@
                        <div class="col-md-12">
                            <label class="form-label fw-600 mb-1">
                                <i class="bi bi-file-earmark-font text-primary ms-1"></i> محتوای فایل
                            </label>
                            <div class="input-group input-group-sm">
                                <span class="input-group-text bg-primary text-white"><i class="bi bi-search"></i></span>
                                <input class="form-control" placeholder="عبارت مورد نظر"
                                       @bind="contentSearch" @bind:event="oninput" @bind:after="LoadDocs" />
                            </div>
                        </div>

                        @* بازه زمانی ایجاد *@
                        <div class="col-md-3">
                            <label class="form-label mb-1 text-muted">ثبت از تاریخ:</label>
                            <DatePicker ValueChanged="CreatedFromChanged" Value="createdFrom" AllowClear="true" Placeholder="----/--/--" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1 text-muted">ثبت تا تاریخ:</label>
                            <DatePicker ValueChanged="CreatedToChanged" Value="createdTo" AllowClear="true" Placeholder="----/--/--" />
                        </div>

                        @* بازه زمانی انقضا *@
                        <div class="col-md-3">
                            <label class="form-label mb-1 text-muted">انقضا از تاریخ:</label>
                            <DatePicker ValueChanged="ExpiryFromChanged" Value="expiryFrom" AllowClear="true" Placeholder="----/--/--" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1 text-muted">انقضا تا تاریخ:</label>
                            <DatePicker ValueChanged="ExpiryToChanged" Value="expiryTo" AllowClear="true" Placeholder="----/--/--" />
                        </div>

                        @* نوع فایل پیوست *@
                        <div class="col-md-6">
                            <label class="form-label mb-1 text-muted">نوع فایل</label>
                            <div class="d-flex flex-wrap gap-1">
                                <button type="button" class="btn btn-xs rounded-pill @(selectedFileTypes.Count == 0 ? "btn-dark" : "btn-outline-secondary")"
                                        @onclick="ClearFileTypes">همه</button>
                                <button type="button" class="btn btn-xs rounded-pill @(selectedFileTypes.Contains("pdf") ? "btn-danger" : "btn-outline-danger")"
                                        @onclick='() => ToggleFileType("pdf")'><i class="bi bi-filetype-pdf me-1"></i>PDF</button>
                                <button type="button" class="btn btn-xs rounded-pill @(selectedFileTypes.Contains("word") ? "btn-primary" : "btn-outline-primary")"
                                        @onclick='() => ToggleFileType("word")'><i class="bi bi-file-earmark-word me-1"></i>Word</button>
                                <button type="button" class="btn btn-xs rounded-pill @(selectedFileTypes.Contains("excel") ? "btn-success" : "btn-outline-success")"
                                        @onclick='() => ToggleFileType("excel")'><i class="bi bi-file-earmark-excel me-1"></i>Excel</button>
                                <button type="button" class="btn btn-xs rounded-pill @(selectedFileTypes.Contains("image") ? "btn-info text-dark" : "btn-outline-info")"
                                        @onclick='() => ToggleFileType("image")'><i class="bi bi-file-earmark-image me-1"></i>تصویر</button>
                                <button type="button" class="btn btn-xs rounded-pill @(selectedFileTypes.Contains("text") ? "btn-secondary" : "btn-outline-secondary")"
                                        @onclick='() => ToggleFileType("text")'><i class="bi bi-file-earmark-text me-1"></i>متن</button>
                            </div>
                        </div>

                        @* فیلتر تگ‌ها *@
                        <div class="col-md-12">
                            <label class="form-label mb-1 text-muted">برچسب‌ها</label>
                            <div class="d-flex flex-wrap gap-1 align-items-center">
                                @if (availableTags.Count == 0)
                                {
                                    <span class="text-muted">بدون برچسب</span>
                                }
                                else
                                {
                                    @foreach (var t in availableTags)
                                    {
                                        var isSel = selectedTagIds.Contains(t.Id);
                                        <button type="button" class="btn btn-xs rounded-pill"
                                                style="@(isSel ? $"background-color:{t.Color};color:#fff;border:2px solid #000;" : $"background-color:#fff;color:#333;border:1px solid {t.Color};")"
                                                @onclick="() => ToggleTagFilter(t.Id)">
                                            <i class="bi @(isSel ? "bi-check-circle-fill" : "bi-tag")"></i> @t.Name
                                        </button>
                                    }
                                }
                            </div>
                        </div>

                        @* تنظیمات دامنه و دکمه اعمال *@
                        <div class="col-12 d-flex justify-content-between align-items-center flex-wrap gap-2 pt-2 border-top">
                            <div class="form-check form-check-inline">
                                <input class="form-check-input" type="checkbox" id="incSub" @bind="includeSubfolders" @bind:after="LoadDocs" />
                                <label class="form-check-label" for="incSub">شامل زیرپوشه‌ها</label>
                            </div>
                            <button class="btn btn-sm btn-primary" @onclick="LoadDocs">
                                <i class="bi bi-search me-1"></i> اعمال فیلترها
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ---------------- جدول مدارک ---------------- *@
        <div class="card da-document-list">
            <div class="card-body p-0">
                @if (loadingDocs)
                {
                    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
                }
                else if (documents.Count == 0)
                {
                    <div class="empty-state py-5 text-center text-muted">
                        <i class="bi bi-file-earmark-x fs-1 d-block mb-2"></i>
                        <h5>مدرکی یافت نشد</h5>
                    </div>
                }
                else if (viewMode == "cards")
                {
                    @* ---------------- نمای کارتی مدارک (قالب دوم؛ پیش‌فرض حالت موبایل/اندروید) ---------------- *@
                    <div class="doc-cards-wrap">
                        <div class="row g-2 g-md-3 row-cols-1 row-cols-md-2 row-cols-xxl-3">
                            @foreach (var d in documents)
                            {
                                <div class="col">
                                    <div class="m-card h-100 @(d.IsExpired ? "st-cancelled" : (d.DaysToExpire <= 30 ? "st-progress" : (!d.IsActive ? "st-delivered" : "st-ready")))">
                                        <div class="m-card-head">
                                            <div class="m-card-icon"><i class="bi bi-file-earmark-text"></i></div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                                    <span class="fw-700 num">@d.Code</span>
                                                    @if (d.RequireDownloadConfirm)
                                                    {
                                                        <span class="text-danger" title="محرمانه — دانلود/مشاهده فایل‌ها با تایید مجدد رمز"><i class="bi bi-shield-lock-fill"></i></span>
                                                    }
                                                    @if (d.WatermarkPreview)
                                                    {
                                                        <span class="text-info" title="پیش‌نمایش فایل‌ها با واترمارک نام کاربر"><i class="bi bi-droplet-half"></i></span>
                                                    }
                                                    @if (d.HasIndexedContent)
                                                    {
                                                        <span class="text-primary" title="دارای متن استخراج‌شده / OCR"><i class="bi bi-file-earmark-font"></i></span>
                                                    }
                                                    @if (d.ActiveVersionNo > 0)
                                                    {
                                                        <span class="badge bg-success">v@(d.ActiveVersionNo.Num())</span>
                                                        <span class="fs-9 text-muted">/ @d.VersionCount.Num()</span>
                                                    }
                                                </div>
                                                @if (statusFilter == "deleted")
                                            {
                                                <span class="da-document-title">@d.Title</span>
                                            }
                                            else
                                            {
                                                <a class="da-document-title d-block text-truncate" title="@d.Title" href="@($"/doc-archive/documents/{d.Id}")">@d.Title</a>
                                            }
                                                <div class="fs-8 text-muted text-truncate">
                                                    <i class="bi bi-folder2 ms-1"></i>@d.FolderName
                                                    @if (!string.IsNullOrWhiteSpace(d.CustomerCode))
                                                    {
                                                        <span class="num"> — مشتری: @d.CustomerCode</span>
                                                    }
                                                </div>
                                            </div>
                                        </div>
                                        <div class="m-card-body">
                                            <div class="m-card-row">
                                                <span>وضعیت ورژن</span>
                                                <b>@StatusBadge(d.LastVersionStatus)</b>
                                            </div>
                                            <div class="m-card-row">
                                                <span>وضعیت مدرک</span>
                                                <b>
                                                    @if (d.IsActive)
                                                    {
                                                        <span class="badge bg-success">فعال</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-secondary" title="@d.DeactivateReason">غیرفعال</span>
                                                    }
                                                </b>
                                            </div>
                                            <div class="m-card-row">
                                                <span>@(statusFilter == "deleted" ? "حذف شده در" : "انقضا")</span>
                                                <b class="num @(d.IsExpired ? "text-danger" : "")">
                                                    @if (statusFilter == "deleted")
                                                    {
                                                        @(d.DeletedAt?.ToFa() ?? "—")
                                                    }
                                                    else
                                                    {
                                                        @(d.ExpireDate?.ToFa() ?? "—")
                                                        @if (d.ExpireDate.HasValue)
                                                        {
                                                            <span class="badge @ExpiryClass(d) ms-1">@ExpiryText(d)</span>
                                                        }
                                                    }
                                                </b>
                                            </div>
                                            <div class="d-flex flex-wrap gap-1 mt-2">
                                                @if (d.IsPublic) { <span class="badge bg-info">عمومی</span> }
                                                @if (d.LinkCount > 0) { <span class="badge bg-light text-dark border"><i class="bi bi-link-45deg"></i> @d.LinkCount.Num()</span> }

                                                @foreach (var t in d.Tags)
                                                {
                                                    <span class="badge rounded-pill text-white" style="background-color:@t.Color;padding:3px 7px;">@t.Name</span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(d.ContentSnippet))
                                            {
                                                <div class="mt-2 p-1 px-2 rounded bg-warning-subtle text-dark fs-9 border">
                                                    <i class="bi bi-search me-1 text-warning-emphasis"></i>
                                                    <b>@d.MatchedAttachmentFileName</b>
                                                    <span>@d.ContentSnippet</span>
                                                </div>
                                            }
                                        </div>
                                        <div class="m-card-actions">
                                            @if (statusFilter == "deleted")
                                            {
                                                @if (d.MyLevel >= DocAccessLevelDto.Full)
                                                {
                                                    <button class="btn btn-light text-success" @onclick="() => OpenRestore(d)">
                                                        <i class="bi bi-arrow-counterclockwise"></i> بازگردانی
                                                    </button>
                                                }
                                                @if (IsManager)
                                                {
                                                    <button class="btn btn-light text-danger" @onclick="() => OpenPurge(d)">
                                                        <i class="bi bi-x-octagon-fill"></i> حذف قطعی
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-primary" @onclick="() => GoDoc(d.Id)">
                                                    <i class="bi bi-eye"></i> مشاهده
                                                </button>
                                                @if (d.MyLevel >= DocAccessLevelDto.Read && d.IsActive && Auth.Has("WorkOrders.Create"))
                                                {
                                                    <button class="btn btn-light fw-700" style="color:#9a3412"
                                                            title="صدور دستور کار برای این مدرک (پرسنل)" @onclick="() => GoWorkOrder(d.Id)">
                                                        <i class="bi bi-list-task"></i> دستور کار
                                                    </button>
                                                }
                                                @if (d.MyLevel >= DocAccessLevelDto.Full && d.IsActive)
                                                {
                                                    <button class="btn btn-light text-danger" title="انتقال به سطل بازیافت" @onclick="() => DeleteDoc(d)">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                }
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>کد</th>
                                    <th>مدرک</th>
                                    <th class="text-center">نسخه</th>
                                    <th class="text-center">وضعیت</th>
                                    <th>@(statusFilter == "deleted" ? "حذف شده در" : "انقضا")</th>
                                    <th class="text-end">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var d in documents)
                                {
                                    <tr class="@(d.IsActive ? "" : "table-light text-muted")">
                                        <td class="num fw-700">
                                            @d.Code
                                            @if (d.HasIndexedContent)
                                            {
                                                <span class="text-primary ms-1" title="دارای متن استخراج‌شده / OCR">
                                                    <i class="bi bi-file-earmark-font"></i>
                                                </span>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(d.CustomerCode))
                                            {
                                                <div class="da-customer-code" title="کد مشتری">@d.CustomerCode</div>
                                            }
                                        </td>
                                        <td>
                                            @if (statusFilter == "deleted")
                                            {
                                                <span class="da-document-title">@d.Title</span>
                                            }
                                            else
                                            {
                                                <a class="da-document-title" href="@($"/doc-archive/documents/{d.Id}")">@d.Title</a>
                                            }
                                            <div class="da-document-folder"><i class="bi bi-folder2"></i> @d.FolderName</div>
                                            <div class="d-flex flex-wrap gap-1 mt-1">
                                                @if (d.IsPublic) { <span class="badge bg-info">عمومی</span> }
                                                @if (d.LinkCount > 0) { <span class="badge bg-light text-dark"><i class="bi bi-link-45deg"></i> @d.LinkCount.Num()</span> }

                                                @foreach (var t in d.Tags)
                                                {
                                                    <span class="badge rounded-pill text-white" style="background-color:@t.Color;padding:3px 7px;">
                                                        @t.Name
                                                    </span>
                                                }
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(d.ContentSnippet))
                                            {
                                                <div class="mt-1 p-1 px-2 rounded bg-warning-subtle text-dark fs-9 border">
                                                    <i class="bi bi-search me-1 text-warning-emphasis"></i>
                                                    <b>@d.MatchedAttachmentFileName</b>
                                                    <span>@d.ContentSnippet</span>
                                                </div>
                                            }
                                        </td>
                                        <td class="text-center num">
                                            @if (d.ActiveVersionNo > 0)
                                            {
                                                <span class="badge bg-success">v@(d.ActiveVersionNo.Num())</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary">—</span>
                                            }
                                            <span class="fs-9 text-muted">/ @d.VersionCount.Num()</span>
                                            <div class="da-version-status">@StatusBadge(d.LastVersionStatus)</div>
                                        </td>
                                        <td class="text-center">
                                            @if (d.IsActive)
                                            {
                                                <span class="badge bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary" title="@d.DeactivateReason">غیرفعال</span>
                                            }
                                        </td>
                                        @if (statusFilter == "deleted")
                                        {
                                            <td class="num fs-8 text-muted">
                                                @(d.DeletedAt?.ToFa() ?? "—")
                                                @if (!string.IsNullOrEmpty(d.DeletedByName))
                                                {
                                                    <div class="fs-9">توسط @d.DeletedByName</div>
                                                }
                                            </td>
                                        }
                                        else
                                        {
                                            <td class="num @(d.IsExpired ? "text-danger fw-700" : "")">
                                                @(d.ExpireDate?.ToFa() ?? "—")
                                                @if (d.ExpireDate.HasValue)
                                                {
                                                    <span class="badge @ExpiryClass(d) ms-1" title="@ExpiryTitle(d)">@ExpiryText(d)</span>
                                                }
                                            </td>
                                        }
                                        <td class="text-end">
                                            @if (statusFilter == "deleted")
                                            {
                                                @if (d.MyLevel >= DocAccessLevelDto.Full)
                                                {
                                                    <button class="btn btn-sm btn-light" title="بازگرداندن مدرک"
                                                            @onclick="() => OpenRestore(d)">
                                                        <i class="bi bi-arrow-counterclockwise text-success"></i>
                                                    </button>
                                                }
                                                @if (IsManager)
                                                {
                                                    <button class="btn btn-sm btn-light" title="حذف قطعی و برگشت‌ناپذیر"
                                                            @onclick="() => OpenPurge(d)">
                                                        <i class="bi bi-x-octagon-fill text-danger"></i>
                                                    </button>
                                                }
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-primary" @onclick="() => GoDoc(d.Id)">
                                                    <i class="bi bi-eye"></i> مشاهده
                                                </button>
                                                @if (d.MyLevel >= DocAccessLevelDto.Read && d.IsActive && Auth.Has("WorkOrders.Create"))
                                                {
                                                    <button class="btn btn-sm btn-light fw-700" style="color:#9a3412"
                                                            title="صدور دستور کار برای این مدرک (پرسنل)" @onclick="() => GoWorkOrder(d.Id)">
                                                        <i class="bi bi-list-task"></i> دستور کار
                                                    </button>
                                                }
                                                @if (d.MyLevel >= DocAccessLevelDto.Full && d.IsActive)
                                                {
                                                    <button class="btn btn-sm btn-light" title="انتقال به سطل بازیافت"
                                                            @onclick="() => DeleteDoc(d)">
                                                        <i class="bi bi-trash text-danger"></i>
                                                    </button>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <nav class="d-flex justify-content-between align-items-center flex-wrap gap-2 py-3" aria-label="صفحه‌بندی مدارک">
            <select class="form-select form-select-sm" style="width:auto" aria-label="تعداد مدارک در صفحه" @bind="pageSize" @bind:after="LoadDocs">
                <option value="25">۲۵ مدرک</option><option value="50">۵۰ مدرک</option><option value="100">۱۰۰ مدرک</option>
            </select>
            <div class="d-flex align-items-center gap-2">
                <button class="btn btn-sm btn-outline-secondary" disabled="@(loadingDocs || currentPage <= 1)" @onclick="() => ChangePage(-1)">قبلی</button>
                <span class="fs-8">@currentPage.Num() / @totalPages.Num()</span>
                <button class="btn btn-sm btn-outline-secondary" disabled="@(loadingDocs || currentPage >= totalPages)" @onclick="() => ChangePage(1)">بعدی</button>
            </div>
        </nav>
    </div>
</div>

@* ==================== مودال بازگردانی مدرک ==================== *@
<Modal Visible="showRestore" Title="بازگرداندن مدرک از سطل بازیافت" OnClose="() => showRestore = false">
    <ChildContent>
        <p>آیا مدرک «<b class="num">@trashTarget?.Code</b> — @trashTarget?.Title» بازگردانده شود؟</p>
        <div class="alert alert-info fs-8">
            مدرک مجدداً در پوشه اصلی خود (یا اولین پوشه موجود در صورت حذف پوشه اصلی) فعال خواهد شد.
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showRestore = false">انصراف</button>
        <button class="btn btn-success" @onclick="DoRestore" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-arrow-counterclockwise ms-1"></i> بازگرداندن مدرک
        </button>
    </Footer>
</Modal>

@* ==================== مودال حذف قطعی ==================== *@
<Modal Visible="showPurge" Title="@(purgeAll ? "خالی کردن کامل سطل بازیافت" : "حذف قطعی و برگشت‌ناپذیر مدرک")" OnClose="() => showPurge = false">
    <ChildContent>
        <div class="alert alert-danger">
            <b><i class="bi bi-exclamation-triangle-fill me-1"></i> هشدار بسیار مهم:</b>
            این عملیات <b>برگشت‌ناپذیر</b> است. مدرک به‌همراه کلیه ورژن‌ها، پیوست‌ها، دسترسی‌ها و تاریخچه به‌صورت قطعی از دیتابیس پاک خواهد شد.
        </div>
        <p>برای تایید، عبارت <b>حذف قطعی</b> را در کادر زیر تایپ کنید:</p>
        <input class="form-control" @bind="purgeConfirm" placeholder="حذف قطعی" />
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showPurge = false">انصراف</button>
        <button class="btn btn-danger" @onclick="DoPurge"
                disabled="@(saving || purgeConfirm?.Trim() != "حذف قطعی")">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-x-octagon-fill ms-1"></i> تایید و حذف قطعی
        </button>
    </Footer>
</Modal>

@* ==================== مودال پوشه ==================== *@
<Modal Visible="showFolder" Title="@(folderForm.Id == 0 ? "پوشه جدید" : "تنظیمات و دسترسی پوشه")" Size="modal-lg" OnClose="() => showFolder = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">نام پوشه <span class="text-danger">*</span></label>
                <input class="form-control" @bind="folderForm.Name" />
            </div>
            <div class="col-md-4">
                <label class="form-label">پوشه والد</label>
                <select class="form-select" @bind="folderParentId">
                    <option value="0">بدون پوشه والد</option>
                    @foreach (var f in folders.Where(x => x.Id != folderForm.Id))
                    {
                        <option value="@f.Id">@FolderPath(f)</option>
                    }
                </select>
            </div>
            <div class="col-12">
                <label class="form-label">توضیحات</label>
                <input class="form-control" @bind="folderForm.Description" />
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="fPub" @bind="folderForm.IsPublic" />
                    <label class="form-check-label fw-700" for="fPub">نمایش برای همه</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="fPubDl" @bind="folderForm.PublicCanDownload"
                           disabled="@(!folderForm.IsPublic)" />
                    <label class="form-check-label" for="fPubDl">دانلود برای همه کاربران</label>
                </div>
            </div>
            <div class="col-12"><hr class="my-1" /></div>
            @* مدیریت دسترسی پوشه هم فقط برای دارندگان «دسترسی کامل» روی همان پوشه (یا مدیر آرشیو) *@
            @if (CanManageFolderAccess)
            {
                <div class="col-12">
                    <details class="da-folder-permissions">
                        <summary>دسترسی کاربران و گروه‌ها</summary>
                        <div class="fs-9 text-muted my-2">شامل زیرپوشه‌ها و مدارک داخل پوشه</div>
                        <DocPermissionEditor Users="lookups.Users" Roles="lookups.Roles" Items="folderPerms" />
                    </details>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        @if (folderForm.Id > 0 && IsManager)
        {
            <button class="btn btn-outline-danger me-auto" @onclick="DeleteFolder">حذف پوشه</button>
        }
        <button class="btn btn-light" @onclick="() => showFolder = false">انصراف</button>
        <button class="btn btn-primary" @onclick="SaveFolder" disabled="@saving">ذخیره</button>
    </Footer>
</Modal>

@* ==================== مودال فرم مدرک جدید ==================== *@
<DocumentFormModal Visible="showDoc" DefaultFolderId="@(selectedFolderId ?? 0)"
                   Folders="FolderLookup" Users="lookups.Users" Documents="lookups.Documents" Roles="lookups.Roles"
                   NumberingEnabled="lookups.CodeNumberingEnabled"
                   CanManageAccess="@CanManageDocAccessHere"
                   OnClose="() => showDoc = false" OnSaved="OnDocSaved" />

<DocIndexQueueModal Visible="showQueue" OnClose="() => showQueue = false" />

@* ==================== مودال مدیریت تگ‌ها ==================== *@
<DocTagsModal Visible="showTagsModal" OnClose="() => showTagsModal = false" OnTagsChanged="OnTagsChanged" />

@* ==================== مودال تنظیمات: شماره‌گذار خودکار کد مدرک ==================== *@
<Modal Visible="showCodeSettings" Title="شماره‌گذاری مدارک" Size="modal-md" OnClose="() => showCodeSettings = false">
    <ChildContent>
        @if (codeSettings == null)
        {
            <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        }
        else
        {
            <div class="form-check form-switch mb-2">
                <input class="form-check-input" type="checkbox" id="csEn" @bind="codeSettings.Enabled" />
                <label class="form-check-label fw-700" for="csEn">شماره‌گذار خودکار کد مدرک فعال باشد</label>
            </div>
            <div class="row g-2">
                <div class="col-4">
                    <label class="form-label fs-8">پیشوند کد</label>
                    <input class="form-control form-control-sm" @bind="codeSettings.Prefix" maxlength="10" />
                </div>
                <div class="col-4">
                    <label class="form-label fs-8">تعداد رقم</label>
                    <input class="form-control form-control-sm" type="number" min="3" max="10" @bind="codeSettings.Padding" />
                </div>
                <div class="col-4">
                    <label class="form-label fs-8">شماره بعدی</label>
                    <input class="form-control form-control-sm" type="number" min="1" @bind="codeSettings.NextNumber" />
                </div>
            </div>
            <div class="fs-9 text-muted mt-2">نمونه کد بعدی: <b class="num">@CodePreview</b></div>

            <hr />
            <div class="fw-700 fs-8 mb-1"><i class="bi bi-play-circle ms-1"></i> اجرای یک‌باره بازشمارش مدارک موجود</div>
            <div class="fs-9 text-muted mb-2">
                کد مدارکی که با الگوی فعلی سازگار نیستند، با کد خودکار جدید جایگزین می‌شود (کدهای سازگار دست‌نخورده می‌مانند؛
                هر جایگزینی در رخ‌نامه همان مدرک ثبت می‌شود). <b>این عمل فقط یک‌بار قابل اجراست.</b>
            </div>
            @if (codeSettings.BackfillRanAt != null)
            {
                <div class="alert alert-secondary py-2 fs-8 mb-0">
                    قبلاً اجرا شده است — @codeSettings.BackfillRanAt.Value.ToFa() توسط «@codeSettings.BackfillRanByName»
                    (@codeSettings.BackfillAssignedCount.Num() مدرک بازشمارش شد).
                </div>
            }
            else if (!confirmRun)
            {
                <button class="btn btn-sm btn-outline-warning fw-700" @onclick="() => confirmRun = true" disabled="@runningBackfill">
                    <i class="bi bi-play-circle"></i> اجرای یک‌باره بازشمارش
                </button>
            }
            else
            {
                <div class="border border-warning rounded-3 p-2" style="background:#fffbeb">
                    <div class="fs-8 mb-2"><i class="bi bi-exclamation-triangle text-warning"></i> کدهای دستیِ ناسازگار با الگو جایگزین می‌شوند؛ مطمئن هستید؟</div>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-warning fw-700" @onclick="RunBackfill" disabled="@runningBackfill">
                            @if (runningBackfill) { <span class="spinner-border spinner-border-sm"></span> }
                            بله، اجرا شود
                        </button>
                        <button class="btn btn-sm btn-light" @onclick="() => confirmRun = false" disabled="@runningBackfill">انصراف</button>
                    </div>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(backfillMessage))
            {
                <div class="alert alert-success py-2 fs-8 mt-2 mb-0">@backfillMessage</div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light btn-sm" @onclick="() => showCodeSettings = false">بستن</button>
        @if (codeSettings != null)
        {
            <button class="btn btn-primary btn-sm fw-700" @onclick="SaveCodeSettings" disabled="@settingsSaving">
                @if (settingsSaving) { <span class="spinner-border spinner-border-sm"></span> }
                ذخیره تنظیمات
            </button>
        }
    </Footer>
</Modal>

@* ==================== مودال دانلود درختی ZIP ==================== *@
<Modal Visible="showZipModal" Title="دانلود ZIP" Size="modal-md" OnClose="() => showZipModal = false">
    <ChildContent>
        <div class="mb-3">
            <label class="form-label fs-8 fw-bold">پوشه</label>
            <select class="form-select form-select-sm" @bind="zipTargetFolderId">
                <option value="0">همه پوشه‌های مجاز</option>
                @foreach (var f in folders.Where(x => x.MyCanDownload))
                {
                    <option value="@f.Id">@FolderPath(f)</option>
                }
            </select>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="zipSub" @bind="zipIncludeSubfolders" />
            <label class="form-check-label fs-8 fw-bold" for="zipSub">شامل زیرپوشه‌ها</label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="zipActive" @bind="zipOnlyActiveVersions" />
            <label class="form-check-label fs-8 fw-bold" for="zipActive">فقط نسخه‌های فعال</label>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="zipManifest" @bind="zipIncludeManifest" />
            <label class="form-check-label fs-8 fw-bold text-success" for="zipManifest">
                <i class="bi bi-file-earmark-excel-fill text-success me-1"></i>
                همراه فهرست اکسل مدارک
            </label>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showZipModal = false">انصراف</button>
        <button class="btn btn-primary" @onclick="StartZipDownload" disabled="@downloadingZip">
            @if (downloadingZip)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>در حال فشرده‌سازی و دانلود…</span>
            }
            else
            {
                <i class="bi bi-file-earmark-zip-fill me-1"></i>
                <span>دانلود بسته ZIP</span>
            }
        </button>
    </Footer>
</Modal>


</div>

@code {
    private List<DocFolderDto> folders = new();
    private List<DocumentListDto> documents = new();
    private List<DocTagDto> availableTags = new();
    private DocArchiveLookups lookups = new();

    // ---------- تنظیمات شماره‌گذار خودکار کد مدرک ----------
    private bool showCodeSettings, settingsSaving, confirmRun, runningBackfill;
    private DocCodeSettingsDto? codeSettings;
    private string? backfillMessage;

    private string CodePreview => codeSettings == null ? "" :
        (codeSettings.Prefix ?? "") + codeSettings.NextNumber.ToString().PadLeft(Math.Clamp(codeSettings.Padding, 3, 10), '0');

    private async Task OpenCodeSettings()
    {
        showCodeSettings = true;
        settingsSaving = false;
        confirmRun = false;
        backfillMessage = null;
        codeSettings = null;
        try { codeSettings = await Svc.GetCodeSettingsAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); codeSettings = new DocCodeSettingsDto(); }
    }

    private async Task SaveCodeSettings()
    {
        if (codeSettings == null) return;
        settingsSaving = true;
        try
        {
            codeSettings = await Svc.SaveCodeSettingsAsync(codeSettings);
            lookups.CodeNumberingEnabled = codeSettings.Enabled;
            Toast.Success("تنظیمات شماره‌گذار ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { settingsSaving = false; }
    }

    private async Task RunBackfill()
    {
        runningBackfill = true;
        try
        {
            var res = await Svc.RunCodeBackfillAsync();
            backfillMessage = res.Message;
            confirmRun = false;
            codeSettings = await Svc.GetCodeSettingsAsync();
            await LoadDocs();
        }
        catch (Exception ex) { Toast.Error(ex.Message); confirmRun = false; }
        finally { runningBackfill = false; }
    }
    private DocExpirySummaryDto expirySummary = new() { ExpiringDays = 60 };
    private int inactiveCount;
    private int trashCount;

    private int? selectedFolderId;
    private string search = "";
    private string contentSearch = "";
    private DateTime? createdFrom;
    private DateTime? createdTo;
    private DateTime? expiryFrom;
    private DateTime? expiryTo;
    private List<string> selectedFileTypes = new();
    private List<int> selectedTagIds = new();
    private bool includeSubfolders = true;

    private string statusFilter = "active";
    private string? expiryFilter = null;
    private bool showAdvancedFilter;
    private bool showTools;
    private bool showQueue;
    private void OnToolsKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Escape") showTools = false;
    }
    private bool showTagsModal;

    // ---------- دو قالب نمایش (جدول / کارت) + حالت موبایل/اندروید ----------
    private string viewMode = "table";
    private bool viewTouched;
    private bool showFoldersPane = true;
    private bool isMobileView;
    private DotNetObjectReference<DocArchiveExplorer>? selfRef;

    // متغیرهای دانلود درختی ZIP
    private bool showZipModal, downloadingZip;
    private int zipTargetFolderId;
    private bool zipIncludeSubfolders = true;
    private bool zipOnlyActiveVersions = true;
    private bool zipIncludeManifest = true;

    private bool loadingFolders = true, loadingDocs = true, saving, checkingExpiry, reindexing;
    private bool showFolder, showDoc, showRestore, showPurge, purgeAll;
    private string purgeConfirm = "";
    private DocumentListDto? trashTarget;

    private DocFolderDto folderForm = new();
    private int folderParentId;
    private List<DocPermissionDto> folderPerms = new();

    private bool IsManager => Auth.Has("DocArchive.Manage");

    private int ActiveFilterCount =>
        (!string.IsNullOrWhiteSpace(contentSearch) ? 1 : 0) +
        (createdFrom.HasValue || createdTo.HasValue ? 1 : 0) +
        (expiryFrom.HasValue || expiryTo.HasValue ? 1 : 0) +
        (selectedFileTypes.Count > 0 ? 1 : 0) +
        (selectedTagIds.Count > 0 ? 1 : 0);

    /// <summary>
    /// مدیریت دسترسی پوشه فقط برای دارندگان «دسترسی کامل» روی <b>همان پوشه</b> (یا مدیر آرشیو).
    /// برای پوشهٔ تازه (Id=0) فقط مدیر آرشیو — چون دسترسی کامل از grant های خود پوشه می‌آید
    /// و بعد از ساخت، از چرخ‌دندهٔ کنار پوشه قابل مدیریت است.
    /// </summary>
    private bool CanManageFolderAccess =>
        IsManager || (folderForm.Id > 0 &&
                      folders.FirstOrDefault(f => f.Id == folderForm.Id)?.MyLevel >= DocAccessLevelDto.Full);

    private bool CanWriteHere
    {
        get
        {
            if (IsManager) return true;
            if (selectedFolderId is int fid)
            {
                var f = folders.FirstOrDefault(x => x.Id == fid);
                return f != null && f.MyLevel >= DocAccessLevelDto.Write;
            }
            return folders.Any(f => f.MyLevel >= DocAccessLevelDto.Write);
        }
    }

    /// <summary>
    /// آیا کاربر می‌تواند در «مدرک جدید/ویرایش» (که در پوشهٔ انتخابی یا اولین پوشهٔ قابل نوشتن
    /// ساخته می‌شود) بخش دسترسی‌ها را مدیریت کند؟ مدیر آرشیو همیشه؛ غیرمدیر فقط اگر روی همان
    /// پوشه «دسترسی کامل» داشته باشد. (قبلاً فقط IsManager بود و کاربرِ Full غیرمدیر نمی‌توانست
    /// هنگام ساخت/ویرایش از همین صفحه دسترسی مدرک را تنظیم کند.)
    /// </summary>
    private bool CanManageDocAccessHere
    {
        get
        {
            if (IsManager) return true;
            var targetFolder = selectedFolderId is int fid
                ? folders.FirstOrDefault(x => x.Id == fid)
                : folders.FirstOrDefault(f => f.MyLevel >= DocAccessLevelDto.Write);
            return targetFolder != null && targetFolder.MyLevel >= DocAccessLevelDto.Full;
        }
    }

