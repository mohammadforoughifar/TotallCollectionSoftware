    private async Task DeleteDoc(DocumentListDto d)
    {
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"مدرک «{d.Code} — {d.Title}» به سطل بازیافت منتقل شود؟ بعداً می‌توانید آن را بازگردانید.");
