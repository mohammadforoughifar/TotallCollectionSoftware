    private string FolderPath(DocFolderDto f)
    {
        var parts = new List<string> { f.Name };
        var cur = f.ParentId;
        var guard = 0;
        while (cur is int p && guard++ < 20)
        {
            var pf = folders.FirstOrDefault(x => x.Id == p);
            if (pf == null) break;
            parts.Insert(0, pf.Name);
            cur = pf.ParentId;
        }
        return string.Join(" / ", parts);
    }

    private RenderFragment RenderTree(int? parentId, int depth) => builder =>
    {
        var seq = 0;
        foreach (var f in folders.Where(x => x.ParentId == parentId).OrderBy(x => x.Name))
        {
            var current = f;
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "ftree-item " + (selectedFolderId == current.Id ? "active" : ""));
            builder.AddAttribute(seq++, "style", $"padding-right:{depth * 14 + 8}px");
            builder.AddAttribute(seq++, "onclick",
                Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => SelectFolder(current.Id)));

            builder.OpenElement(seq++, "i");
            builder.AddAttribute(seq++, "class", current.IsPublic ? "bi bi-folder-fill text-info" : "bi bi-folder-fill text-warning");
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddContent(seq++, current.Name);
            builder.CloseElement();

            builder.OpenElement(seq++, "span");
            builder.AddAttribute(seq++, "class", "badge bg-light text-dark ms-auto");
            builder.AddContent(seq++, current.DocumentCount);
            builder.CloseElement();

            if (current.MyLevel >= DocAccessLevelDto.Full)
            {
                builder.OpenElement(seq++, "i");
                builder.AddAttribute(seq++, "class", "bi bi-gear text-secondary");
                builder.AddAttribute(seq++, "title", "تنظیمات و دسترسی");
                builder.AddAttribute(seq++, "onclick",
                    Microsoft.AspNetCore.Components.EventCallback.Factory.Create(this, () => OpenFolder(current)));
                builder.AddEventStopPropagationAttribute(seq++, "onclick", true);
                builder.CloseElement();
            }

            builder.CloseElement();

            builder.AddContent(seq++, RenderTree(current.Id, depth + 1));
        }
    };

    private async Task OpenFolder(DocFolderDto? f)
    {
        if (f == null)
        {
            folderForm = new DocFolderDto();
            folderParentId = selectedFolderId ?? 0;
            folderPerms = new();
        }
        else
        {
            try
            {
                var full = await Svc.GetFolderAsync(f.Id);
                folderForm = full;
                folderParentId = full.ParentId ?? 0;
                folderPerms = full.Permissions;
            }
            catch (Exception ex) { Toast.Error(ex.Message); }
        }
        showFolder = true;
    }

    private async Task SaveFolder()
    {
        if (string.IsNullOrWhiteSpace(folderForm.Name)) { Toast.Error("نام پوشه اجباری است."); return; }
        saving = true;
        try
        {
            folderForm.ParentId = folderParentId > 0 ? folderParentId : null;
            // فقط دارندهٔ دسترسی کامل روی این پوشه، فهرست دسترسی‌ها را ارسال می‌کند
            folderForm.Permissions = CanManageFolderAccess ? folderPerms : new();

            int id;
            if (folderForm.Id == 0)
            {
                // سرور هنگام ساخت، دسترسی‌های فرم + دسترسی کامل سازنده را یکجا ذخیره می‌کند؛
                // فراخوانی دوم حذف شد تا خطای کاذب «مدیریت دسترسی نیازمند دسترسی کامل است» رخ ندهد.
                id = await Svc.CreateFolderAsync(folderForm);
            }
            else
            {
                id = folderForm.Id;
                await Svc.UpdateFolderAsync(id, folderForm);
                // ذخیرهٔ دسترسی‌ها فقط وقتی مجاز باشیم — وگرنه سرور ۴۰۳ می‌دهد و خطای کاذب می‌بینیم
                if (CanManageFolderAccess)
                {
                    await Svc.SaveFolderPermissionsAsync(id, new DocPermissionsSaveDto
                    {
                        IsPublic = folderForm.IsPublic,
                        PublicCanDownload = folderForm.PublicCanDownload,
                        Items = folderPerms
                    });
                }
            }

            Toast.Success("پوشه ذخیره شد.");
            showFolder = false;
            await LoadFolders();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

