    // ---------- نمایش وضعیت انقضا ----------
    private static string ExpiryClass(DocumentListDto d)
    {
        if (d.IsExpired) return "bg-danger";
        return d.DaysToExpire switch
        {
            <= 7 => "bg-danger",
            <= 30 => "bg-warning text-dark",
            <= 60 => "bg-info text-dark",
            _ => "bg-light text-secondary"
        };
    }

    private static string ExpiryText(DocumentListDto d)
    {
        if (d.DaysToExpire is not int n) return "";
        if (n < 0) return $"{(-n).Num()} روز گذشته";
        if (n == 0) return "امروز";
        return $"{n.Num()} روز";
    }

    private static string ExpiryTitle(DocumentListDto d)
    {
        if (d.DaysToExpire is not int n) return "";
        if (n < 0) return $"این مدرک {(-n).Num()} روز است منقضی شده";
        if (n == 0) return "امروز منقضی می‌شود";
        return $"{n.Num()} روز تا انقضا";
    }

