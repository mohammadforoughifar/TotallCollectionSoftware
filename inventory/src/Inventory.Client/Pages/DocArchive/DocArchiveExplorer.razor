    private int currentPage = 1, pageSize = 25, totalDocuments;
    private int totalPages => Math.Max(1, (totalDocuments + pageSize - 1) / pageSize);
    private int searchRequest;
    private bool disposed;
    private CancellationTokenSource? searchDelay;
    private Task CreatedFromChanged(DateTime? value) { createdFrom = value; return LoadDocs(); }
    private Task CreatedToChanged(DateTime? value) { createdTo = value; return LoadDocs(); }
    private Task ExpiryFromChanged(DateTime? value) { expiryFrom = value; return LoadDocs(); }
    private Task ExpiryToChanged(DateTime? value) { expiryTo = value; return LoadDocs(); }
    private async Task OnSearchChanged()
    {
        searchRequest++;
        searchDelay?.Cancel();
        using var delay = new CancellationTokenSource(); searchDelay = delay;
        try { await Task.Delay(350, delay.Token); if (!disposed) await LoadDocs(); }
        catch (OperationCanceledException) { }
        finally { if (ReferenceEquals(searchDelay, delay)) searchDelay = null; }
    }
    private async Task ChangePage(int delta) { currentPage += delta; await LoadPage(); }
    private Task LoadDocs() { searchDelay?.Cancel(); currentPage = 1; return LoadPage(); }
    private async Task RefreshStats()
    {
        try {
            var stats = await Svc.GetStatsAsync();
            inactiveCount = stats.Inactive; trashCount = stats.Deleted;
            expirySummary.Expired = stats.Expired; expirySummary.ExpiringSoon = stats.Expiring;
        } catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task LoadPage()
    {
        var request = ++searchRequest;
        loadingDocs = true;
        try
        {
            var filter = new DocSearchFilterDto
            {
                Page = currentPage, PageSize = pageSize,
                Search = search,
                ContentSearch = contentSearch,
                FolderId = selectedFolderId,
                IncludeSubfolders = includeSubfolders,
                Status = statusFilter,
                ExpiryStatus = expiryFilter switch { "expiring" => "expiring", "expired" => "expired", _ => "all" },
                CreatedFrom = createdFrom,
                CreatedTo = createdTo,
                ExpiryFrom = expiryFrom,
                ExpiryTo = expiryTo,
                FileTypes = selectedFileTypes,
                TagIds = selectedTagIds
            };

            var result = await Svc.SearchPageAsync(filter);
            if (disposed || request != searchRequest) return;
            documents = result.Items; totalDocuments = result.Total; currentPage = result.Page;
        }
        catch (Exception ex) { if (!disposed && request == searchRequest) Toast.Error(ex.Message); }
        finally { if (!disposed && request == searchRequest) loadingDocs = false; }
    }

