    private async Task StartZipDownload()
    {
        downloadingZip = true;
        try
        {
            Toast.Info("در حال فشرده‌سازی بسته ZIP در سرور…");
            var (data, fileName, contentType) = await Svc.DownloadFolderZipAsync(
                zipTargetFolderId > 0 ? zipTargetFolderId : null,
                zipIncludeSubfolders,
                zipOnlyActiveVersions,
                zipIncludeManifest);

            if (data.Length == 0)
            {
                Toast.Info("بسته ZIP خالی است؛ مدرک قابل دانلودی در این محدوده یافت نشد.");
                return;
            }

            await JS.InvokeVoidAsync("downloadBlob", fileName, contentType, Convert.ToBase64String(data));
            Toast.Success("بسته ZIP دانلود شد.");
            showZipModal = false;
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در دانلود ZIP: {ex.Message}");
        }
        finally
        {
            downloadingZip = false;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            // در حالت موبایل/اندروید، قالب خودکار به نمای کارتی تغییر می‌کند
            isMobileView = await JS.InvokeAsync<bool>("appShell.isMobile");
            if (isMobileView && !viewTouched)
            {
                viewMode = "cards";
                showFoldersPane = false;
                StateHasChanged();
            }
            selfRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("appShell.watch", selfRef);
        }
        catch { /* JS در دسترس نیست */ }
    }

    [JSInvokable]
    public void OnScreenChanged(bool mobile)
    {
        if (isMobileView == mobile) return;
        isMobileView = mobile;
        // فقط اگر کاربر دستی قالب را عوض نکرده باشد، با تغییر اندازه صفحه قالب عوض می‌شود
        if (!viewTouched)
        {
            viewMode = mobile ? "cards" : "table";
            showFoldersPane = !mobile;
            InvokeAsync(StateHasChanged);
        }
    }

    private void SetViewMode(string mode)
    {
        viewMode = mode;
        viewTouched = true;
    }

