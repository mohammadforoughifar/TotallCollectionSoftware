@* ================== مودال مقایسه دو ورژن ==================
   استفاده: <VersionCompareModal @ref="cmp" /> سپس cmp.ShowAsync(docId, versions)
*@
@inject IDocArchiveService Svc
@inject IToastService Toast

<Modal Visible="visible" Title="مقایسه ورژن‌ها" Size="modal-xl" OnClose="Close">
    <ChildContent>
        <div class="row g-2 align-items-end mb-3">
            <div class="col-md-5">
                <label class="form-label fs-8 mb-1">ورژن قدیمی‌تر</label>
                <select class="form-select form-select-sm" @bind="fromId" @bind:after="Reload">
                    @foreach (var v in options)
                    {
                        <option value="@v.Id">@VerLabel(v)</option>
                    }
                </select>
            </div>
            <div class="col-md-1 text-center">
                <button class="btn btn-sm btn-light w-100" title="جابه‌جایی" @onclick="Swap">
                    <i class="bi bi-arrow-left-right"></i>
                </button>
            </div>
            <div class="col-md-5">
                <label class="form-label fs-8 mb-1">ورژن جدیدتر</label>
                <select class="form-select form-select-sm" @bind="toId" @bind:after="Reload">
                    @foreach (var v in options)
                    {
                        <option value="@v.Id">@VerLabel(v)</option>
                    }
                </select>
            </div>
            <div class="col-md-1">
                @if (result is not null)
                {
                    <span class="badge @(result.ChangeCount == 0 ? "bg-secondary" : "bg-primary") w-100 py-2">
                        @result.ChangeCount.Num() تغییر
                    </span>
                }
            </div>
        </div>

        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary"></div>
            </div>
        }
        else if (error is not null)
        {
            <div class="alert alert-warning fs-8 mb-0">
                <i class="bi bi-exclamation-triangle ms-1"></i> @error
            </div>
        }
        else if (result is not null)
        {
            <div class="form-check form-switch fs-8 mb-2">
                <input class="form-check-input" type="checkbox" id="onlyDiff" @bind="onlyDiff" />
                <label class="form-check-label" for="onlyDiff">فقط تفاوت‌ها را نشان بده</label>
            </div>

            @if (result.ChangeCount == 0)
            {
                <div class="alert alert-success fs-8">
                    <i class="bi bi-check-circle ms-1"></i>
                    این دو ورژن در فیلدهای قابل مقایسه هیچ تفاوتی ندارند.
                </div>
            }

            <DiffTable Title="فیلدهای مدرک" Icon="bi-card-list"
                       Rows="Filter(result.Fields)"
                       LeftHead="@Head(result.Left)" RightHead="@Head(result.Right)" />

            @if (result.Approvers.Any())
            {
                <DiffTable Title="نفرات گردش تایید" Icon="bi-people"
                           Rows="Filter(result.Approvers)"
                           LeftHead="@Head(result.Left)" RightHead="@Head(result.Right)" />
            }

            @if (result.Attachments.Any())
            {
                <DiffTable Title="پیوست‌ها" Icon="bi-paperclip"
                           Rows="Filter(result.Attachments)"
                           LeftHead="@Head(result.Left)" RightHead="@Head(result.Right)" />
            }

            @if (result.Between.Any())
            {
                <div class="card mb-2">
                    <div class="card-header fw-700 fs-8">
                        <i class="bi bi-clock-history ms-1"></i>
                        رویدادهای بین این دو ورژن (@result.Between.Count.Num())
                    </div>
                    <div class="card-body p-0" style="max-height:200px;overflow:auto;">
                        <table class="table table-sm mb-0 fs-8">
                            <tbody>
                                @foreach (var l in result.Between)
                                {
                                    <tr>
                                        <td style="width:120px" class="num text-muted">@l.CreatedAt.ToFa()</td>
                                        <td style="width:110px">@l.UserName</td>
                                        <td>@l.Detail</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="Close">بستن (Esc)</button>
    </Footer>
</Modal>

@code {
    private bool visible, loading, onlyDiff = true;
    private int docId, fromId, toId;
    private string? error;
    private DocVersionCompareDto? result;
    private List<DocVersionDto> options = new();

    /// <summary>باز کردن مودال برای یک مدرک با فهرست ورژن‌هایش.</summary>
    public async Task ShowAsync(int documentId, List<DocVersionDto> versions, int? preferFrom = null, int? preferTo = null)
    {
        docId = documentId;
        options = versions.OrderByDescending(v => v.VersionNo).ToList();
        if (options.Count < 2)
        {
            Toast.Info("برای مقایسه حداقل دو ورژن لازم است.");
            return;
        }

        // پیش‌فرض: دو ورژن آخر
        toId = preferTo ?? options[0].Id;
        fromId = preferFrom ?? options[1].Id;
        visible = true;
        error = null;
        await Reload();
    }

    private async Task Reload()
    {
        if (fromId == 0 || toId == 0) return;
        if (fromId == toId)
        {
            result = null;
            error = "دو ورژن متفاوت انتخاب کنید.";
            StateHasChanged();
            return;
        }

        loading = true;
        error = null;
        StateHasChanged();
        try
        {
            result = await Svc.CompareVersionsAsync(docId, fromId, toId);
        }
        catch (Exception ex)
        {
            error = ex.Message;
            result = null;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task Swap()
    {
        (fromId, toId) = (toId, fromId);
        await Reload();
    }

    private List<DocVersionDiffRow> Filter(List<DocVersionDiffRow> rows) =>
        onlyDiff ? rows.Where(r => r.Kind != "same").ToList() : rows;

    private static string Head(DocVersionDto? v) =>
        v is null ? "—" : $"ورژن {v.VersionNo}";

    private static string VerLabel(DocVersionDto v)
    {
        var tag = v.IsActive ? " ✔ فعال" : "";
        return $"ورژن {v.VersionNo}{tag} — {v.CreatedByName}";
    }

    private void Close() => visible = false;
}
