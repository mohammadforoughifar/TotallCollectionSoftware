@page "/hr"
@page "/radis-hr"
@page "/hr/dashboard"
@page "/radis-hr/dashboard"
@inject RadisHrApiClient Api
@inject RadisHrAuthState Auth
@inject IJSRuntime JS

<section class="page">
    <div class="welcome">
        <div>
            <p class="eyebrow">نمای کلی @(_dash?.LastMonthLabel ?? "سازمان")</p>
            <h2>روز بخیر؛ وضعیت سازمان در یک نگاه</h2>
            <p>اطلاعات مستقیم از بانک اطلاعاتی SQL Server خوانده می‌شود.</p>
        </div>
        <div class="date-box"><strong>@_today</strong><small>نسخه .NET 8 — Blazor WebAssembly</small></div>
    </div>

    <div class="stats">
        <article>
            <span>تعداد پرسنل فعال</span>
            <strong>@Fa.N(_dash?.ActiveEmployees ?? 0)</strong>
            <small>سرمایه انسانی کارخانه</small>
        </article>
        <article>
            <span>میانگین حقوق پایه</span>
            <strong>@Fa.N(_averageSalary)</strong>
            <small>ریال در ماه</small>
        </article>
        <article>
            <span>اضافه‌کار ماه آخر</span>
            <strong class="ok">@Fa.N((double)(_dash?.LastMonthOvertimeHours ?? 0))</strong>
            <small>ساعت — @(_dash?.LastMonthLabel ?? "—")</small>
        </article>
        <article>
            <span>هزینه حقوق ماهانه</span>
            <strong>@Fa.N(_dash?.LastMonthNet ?? 0)</strong>
            <small>ریال خالص پرداختی</small>
        </article>
    </div>

    <div class="dashboard-toolbar">
        <label>
            محدوده تحلیل
            <select value="@_unit" @onchange="OnUnitChanged">
                <option value="">کل کارخانه</option>
                @foreach (var unit in _units)
                {
                    <option value="@unit">@unit</option>
                }
            </select>
        </label>
        <button class="button secondary" type="button" @onclick="ExportAsync">خروجی CSV داشبورد</button>
    </div>

    <div class="charts-grid">
        <article class="panel chart-panel">
            <h3>مقایسه حقوق پایه واحدها</h3>
            <p class="muted">میانگین حقوق پایه در محدوده انتخابی</p>
            <BarChart Items="_salaryBars" />
        </article>

        <article class="panel chart-panel">
            <h3>سهم واحدها از حقوق تخصیص‌یافته</h3>
            <p class="muted">درصد از مجموع حقوق پایه</p>
            <PieChart Items="_salaryPie" />
        </article>

        <article class="panel chart-panel">
            <h3>ترکیب سابقه کارکنان</h3>
            <div class="progress-list">
                @foreach (var bucket in _tenure)
                {
                    var width = _scope.Count == 0 ? 0d : bucket.Value / (double)_scope.Count * 100d;
                    <div>
                        <span>@bucket.Key</span>
                        <i><b style="width:@width.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></b></i>
                        <strong>@Fa.N(bucket.Value) نفر</strong>
                    </div>
                }
            </div>
        </article>

        <article class="panel chart-panel">
            <h3>شاخص‌های عملیاتی</h3>
            <div class="mini-kpis">
                <div><b>@Fa.N((double)(_dash?.LastMonthShortfallHours ?? 0))</b><span>ساعت کسرکار ماه</span></div>
                <div><b>@Fa.N(_dash?.IncidentsThisYear ?? 0)</b><span>حادثه در سال جاری</span></div>
                <div><b>@Fa.N(_dash?.LostDaysThisYear ?? 0)</b><span>روزهای از دست رفته</span></div>
                <div><b>@Fa.N(_averageTenure) سال</b><span>میانگین سابقه</span></div>
            </div>
        </article>
    </div>

    <section class="executive-analytics">
        <div class="section-head">
            <div>
                <p class="eyebrow">تحلیل مقایسه‌ای مدیرعامل</p>
                <h2>روند کارکرد و پرداخت</h2>
                <p class="muted">مقایسه ماه‌های ثبت‌شده یا مشاهده کل سال</p>
            </div>
            <div class="analytics-filters">
                <label class="all-months-toggle">
                    <input type="checkbox" checked="@_allMonths" @onchange="OnAllMonthsChanged" /> کل ماه‌های ثبت‌شده
                </label>
                <label>
                    ماه‌های مورد مقایسه
                    <select multiple size="4" disabled="@_allMonths" @onchange="OnMonthsChanged">
                        @foreach (var month in _months)
                        {
                            <option value="@month.Key" selected="@_selectedMonths.Contains(month.Key)">@month.Label</option>
                        }
                    </select>
                </label>
                <label>
                    زاویه مقایسه مرخصی
                    <select value="@_leaveMode" @onchange="OnLeaveModeChanged">
                        <option value="units">مقایسه واحدها با یکدیگر</option>
                        <option value="months">مقایسه ماه‌های انتخابی</option>
                    </select>
                </label>
            </div>
        </div>

        <p class="chart-message muted">@(_exec?.Message ?? "")</p>

        <div class="executive-chart-grid">
            <article class="panel executive-chart-card">
                <div class="chart-card-head">
                    <div><h3>مقایسه اضافه‌کار</h3><p class="muted">مجموع ساعات اضافه‌کار در هر ماه</p></div>
                    <span class="chart-unit">ساعت</span>
                </div>
                <BarChart Items="Points(_exec?.Overtime)" Decimals="2" />
            </article>

            <article class="panel executive-chart-card">
                <div class="chart-card-head">
                    <div><h3>مقایسه جمع پرداختی</h3><p class="muted">مجموع خالص پرداختی ماهانه</p></div>
                    <span class="chart-unit">میلیارد ریال</span>
                </div>
                <BarChart Items="Points(_exec?.Payment)" Decimals="2" />
            </article>

            <article class="panel executive-chart-card leave-chart-card">
                <div class="chart-card-head">
                    <div><h3>مقایسه مرخصی استفاده‌شده</h3><p class="muted">@(_exec?.LeaveSubtitle ?? "")</p></div>
                    <span class="chart-unit">ساعت</span>
                </div>
                <BarChart Items="Points(_exec?.Leave)" Decimals="2" />
            </article>
        </div>
    </section>

    <div class="grid2">
        <article class="panel">
            <h3>آخرین اعلان‌ها</h3>
            @if (_notices.Count == 0)
            {
                <p class="empty">اعلان جدیدی وجود ندارد.</p>
            }
            else
            {
                @foreach (var notice in _notices.Take(5))
                {
                    <div class="message"><b>@notice.Title</b><span>@notice.Message</span></div>
                }
            }
        </article>
        <article class="panel">
            <h3>خلاصه وضعیت مالی</h3>
            <div class="message"><b>بیمه ماه آخر</b><span>@Fa.N(_dash?.LastMonthInsurance ?? 0) ریال (سهم کارگر و کارفرما)</span></div>
            <div class="message"><b>مالیات ماه آخر</b><span>@Fa.N(_dash?.LastMonthTax ?? 0) ریال</span></div>
            <div class="message"><b>مساعده‌های تعیین‌تکلیف‌نشده</b><span>@Fa.N(_dash?.OpenAdvances ?? 0) مورد</span></div>
        </article>
    </div>
</section>

@code {
    private DashboardDto? _dash;
    private ExecutiveDto? _exec;
    private List<Employee> _employees = new();
    private List<MonthOption> _months = new();
    private List<AuditNotice> _notices = new();

    private string _unit = "";
    private string _today = "";
    private bool _allMonths = true;
    private string _leaveMode = "units";
    private HashSet<string> _selectedMonths = new();

    private List<Employee> _scope = new();
    private List<string> _units = new();
    private List<BarChart.Item> _salaryBars = new();
    private List<PieChart.Slice> _salaryPie = new();
    private Dictionary<string, int> _tenure = new();
    private decimal _averageSalary;
    private double _averageTenure;

    protected override async Task OnInitializedAsync()
    {
        _dash = await Api.GetAsync<DashboardDto>("api/analytics/dashboard");
        _employees = await Api.GetListAsync<Employee>("api/employees");
        _months = await Api.GetListAsync<MonthOption>("api/analytics/months");
        _notices = await Api.GetListAsync<AuditNotice>("api/workflows/notices");
        _units = _employees.Select(e => string.IsNullOrEmpty(e.Unit) ? "بدون واحد" : e.Unit)
            .Distinct().OrderBy(u => u).ToList();

        BuildLocalCharts();
        await LoadExecutiveAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            _today = await JS.InvokeAsync<string>("radisInterop.todayLongFa");
            StateHasChanged();
        }
        catch { }
    }

    private static List<BarChart.Item> Points(List<ChartPoint>? points) =>
        points?.Select(p => new BarChart.Item(p.ShortLabel, p.Value)).ToList() ?? new();

    private void BuildLocalCharts()
    {
        _scope = string.IsNullOrEmpty(_unit)
            ? _employees
            : _employees.Where(e => (string.IsNullOrEmpty(e.Unit) ? "بدون واحد" : e.Unit) == _unit).ToList();

        var groups = _scope.GroupBy(e => string.IsNullOrEmpty(e.Unit) ? "بدون واحد" : e.Unit).ToList();

        _salaryBars = groups
            .Select(g => new BarChart.Item(g.Key, Math.Round(g.Sum(e => e.Salary) / g.Count())))
            .ToList();

        _salaryPie = groups
            .Select(g => new PieChart.Slice(g.Key, g.Sum(e => e.Salary)))
            .ToList();

        _averageSalary = _scope.Count == 0 ? 0 : Math.Round(_scope.Sum(e => e.Salary) / _scope.Count);

        // همان سه سطل نسخهٔ اصلی؛ مبنا: سال ۱۴۰۵ منهای سال جذب
        var currentYear = PersianCalendarUtil.Today().Jy;
        _tenure = new Dictionary<string, int>
        {
            ["کمتر از ۲ سال"] = 0,
            ["۲ تا ۵ سال"] = 0,
            ["بیش از ۵ سال"] = 0
        };

        var ages = new List<int>();
        foreach (var employee in _scope)
        {
            var head = Fa.ToLatin(employee.Hire ?? "").Split('/').FirstOrDefault() ?? "";
            if (!int.TryParse(head, out var hireYear)) continue;
            var age = currentYear - hireYear;
            ages.Add(age);
            if (age < 2) _tenure["کمتر از ۲ سال"]++;
            else if (age <= 5) _tenure["۲ تا ۵ سال"]++;
            else _tenure["بیش از ۵ سال"]++;
        }
        _averageTenure = ages.Count == 0 ? 0 : Math.Round(ages.Average(), 1);
    }

    private async Task LoadExecutiveAsync()
    {
        var months = _allMonths ? "" : string.Join(",", _selectedMonths);
        _exec = await Api.GetAsync<ExecutiveDto>($"api/analytics/executive?months={Uri.EscapeDataString(months)}&mode={_leaveMode}");
        StateHasChanged();
    }

    private void OnUnitChanged(ChangeEventArgs args)
    {
        _unit = args.Value?.ToString() ?? "";
        BuildLocalCharts();
    }

    private async Task OnAllMonthsChanged(ChangeEventArgs args)
    {
        _allMonths = args.Value is bool b && b;
        await LoadExecutiveAsync();
    }

    private async Task OnMonthsChanged(ChangeEventArgs args)
    {
        _selectedMonths = (args.Value as string[] ?? Array.Empty<string>()).ToHashSet();
        await LoadExecutiveAsync();
    }

    private async Task OnLeaveModeChanged(ChangeEventArgs args)
    {
        _leaveMode = args.Value?.ToString() ?? "units";
        await LoadExecutiveAsync();
    }

    private async Task ExportAsync()
    {
        var lines = new List<string> { "واحد,میانگین حقوق پایه,مجموع حقوق پایه,تعداد" };
        foreach (var group in _scope.GroupBy(e => string.IsNullOrEmpty(e.Unit) ? "بدون واحد" : e.Unit))
            lines.Add($"{group.Key},{Math.Round(group.Sum(e => e.Salary) / group.Count())},{group.Sum(e => e.Salary)},{group.Count()}");

        var csv = string.Join("\n", lines);
        var bytes = System.Text.Encoding.UTF8.GetPreamble().Concat(System.Text.Encoding.UTF8.GetBytes(csv)).ToArray();
        await JS.InvokeVoidAsync("radisInterop.downloadFile", "dashboard.csv", "text/csv", Convert.ToBase64String(bytes));
    }
}
