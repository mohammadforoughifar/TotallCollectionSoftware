@page "/hr-time"
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>زمان‌بندی و تأییدها</PageTitle>

@if (!canUse)
{
    <div class="alert alert-warning">دسترسی ندارید.</div>
    return;
}

<div class="card shadow-sm mb-3" dir="rtl">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-calendar2-range"></i>
        <strong>زمان‌بندی، اضافه‌کاری و تأییدها</strong>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button class="nav-link @(tab=="steps"?"active":"")" @onclick='() => SetTab("steps")'>تأییدها @if (pendingCount>0){<span class="badge bg-danger ms-1">@Fa.Digits(pendingCount)</span>}</button></li>
            <li class="nav-item"><button class="nav-link @(tab=="overtime"?"active":"")" @onclick='() => SetTab("overtime")'>اضافه‌کاری</button></li>
            <li class="nav-item"><button class="nav-link @(tab=="balance"?"active":"")" @onclick='() => SetTab("balance")'>موجودی مرخصی</button></li>
            <li class="nav-item"><button class="nav-link @(tab=="roster"?"active":"")" @onclick='() => SetTab("roster")'>روستِر شیفت</button></li>
            @if (isHr)
            {
                <li class="nav-item"><button class="nav-link @(tab=="device"?"active":"")" @onclick='() => SetTab("device")'>دستگاه حضوروغیاب</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="rules"?"active":"")" @onclick='() => SetTab("rules")'>قوانین</button></li>
            }
        </ul>

        @if (tab == "steps")
        {
            <div class="d-flex gap-2 mb-2 align-items-center">
                @if (isHr)
                {
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" @bind="showAllSteps" @bind:after="LoadSteps" id="allSteps" />
                        <label class="form-check-label" for="allSteps">نمایش همه</label>
                    </div>
                }
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSteps"><i class="bi bi-arrow-clockwise"></i> به‌روزرسانی</button>
            </div>
            @if (steps.Count == 0)
            {
                <div class="alert alert-info">موردی در انتظار تأیید شما نیست.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle">
                        <thead><tr><th>شماره</th><th>نوع</th><th>درخواست‌کننده</th><th>شرح</th><th>مرحله</th><th>تاریخ ثبت</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in steps)
                            {
                                var x = s;
                                <tr>
                                    <td><span dir="ltr">@x.Number</span></td>
                                    <td>@x.Title</td>
                                    <td>@x.Requester</td>
                                    <td class="small">@x.Detail</td>
                                    <td><span class="badge bg-secondary">@RoleFa(x.Role)</span></td>
                                    <td class="small">@x.CreatedAt.ToString("yyyy/MM/dd HH:mm")</td>
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-success" @onclick="() => OpenDecide(x, true)">تأیید</button>
                                        <button class="btn btn-sm btn-danger" @onclick="() => OpenDecide(x, false)">رد</button>
                                        <button class="btn btn-sm btn-outline-info" @onclick="() => OpenTimeline(x)">گردش</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (tab == "overtime")
        {
            <div class="d-flex flex-wrap gap-2 mb-2 align-items-end">
                <div>
                    <label class="form-label small">وضعیت</label>
                    <select class="form-select form-select-sm" @bind="otStatus">
                        <option value="">همه</option>
                        <option value="Pending">در انتظار</option>
                        <option value="Approved">تأییدشده</option>
                        <option value="Rejected">ردشده</option>
                    </select>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadOvertime">نمایش</button>
                <button class="btn btn-sm btn-primary" @onclick="() => showOt = true"><i class="bi bi-plus-lg"></i> درخواست اضافه‌کاری</button>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>شماره</th><th>درخواست‌کننده</th><th>تاریخ</th><th>بازه</th><th>دقیقه</th><th>نوع</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var o in ots)
                        {
                            var x = o;
                            <tr>
                                <td><span dir="ltr">@x.Number</span></td>
                                <td>@x.RequesterName</td>
                                <td>@x.WorkDate.ToString("yyyy/MM/dd")</td>
                                <td><span dir="ltr">@x.StartTime.ToString(@"hh\:mm")–@x.EndTime.ToString(@"hh\:mm")</span></td>
                                <td>@Fa.Digits(x.Minutes)</td>
                                <td>@OtTypeFa(x.Type)</td>
                                <td><span class="badge @StatusCls(x.Status)">@StatusFa(x.Status)</span></td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => OpenTimeline2(x)">گردش</button>
                                    @if (x.Status == "Pending")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOt(x.Id)">حذف</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (tab == "balance")
        {
            <div class="row g-3">
                <div class="col-lg-7">
                    <div class="d-flex gap-2 mb-2 align-items-end">
                        @if (isHr)
                        {
                            <div>
                                <label class="form-label small">کاربر</label>
                                <select class="form-select form-select-sm" @bind="balUserId">
                                    <option value="0">خودم</option>
                                    @foreach (var u in users)
                                    {
                                        <option value="@u.Id">@u.FullName (@u.Username)</option>
                                    }
                                </select>
                            </div>
                        }
                        <div>
                            <label class="form-label small">سال</label>
                            <input type="number" class="form-control form-control-sm" style="width:100px" @bind="balYear" />
                        </div>
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBalances">نمایش</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>نوع مرخصی</th><th>سهمیه</th><th>مصرف‌شده</th><th>در انتظار</th><th>مانده</th>@if (isHr){<th></th>}</tr></thead>
                            <tbody>
                                @foreach (var b in balances)
                                {
                                    var x = b;
                                    <tr>
                                        <td>@CatFa(x.Category)</td>
                                        <td>@Fa.Digits(x.Granted.ToString())</td>
                                        <td>@Fa.Digits(x.Used.ToString())</td>
                                        <td>@Fa.Digits(x.Pending.ToString())</td>
                                        <td><strong class="@(x.Remaining < 0 ? "text-danger" : "text-success")">@Fa.Digits(x.Remaining.ToString())</strong></td>
                                        @if (isHr)
                                        {
                                            <td><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenGrant(x)">سهمیه</button></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-5">
                    <div class="card">
                        <div class="card-header"><strong>ثبت درخواست مرخصی / ماموریت</strong></div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-6">
                                    <label class="form-label small">نوع</label>
                                    <select class="form-select form-select-sm" @bind="lvType">
                                        <option value="Daily">مرخصی روزانه</option>
                                        <option value="Hourly">مرخصی ساعتی</option>
                                        <option value="Mission">ماموریت روزانه</option>
                                        <option value="HourlyMission">ماموریت ساعتی</option>
                                    </select>
                                </div>
                                @if (lvType is "Daily" or "Hourly")
                                {
                                    <div class="col-6">
                                        <label class="form-label small">دسته</label>
                                        <select class="form-select form-select-sm" @bind="lvCat">
                                            <option value="Annual">استحقاقی</option>
                                            <option value="Sick">استعلاجی</option>
                                            <option value="Maternity">زایمان</option>
                                            <option value="Unpaid">بدون حقوق</option>
                                        </select>
                                    </div>
                                }
                                else
                                {
                                    <div class="col-6">
                                        <label class="form-label small">ماموریت</label>
                                        <select class="form-select form-select-sm" @bind="lvKind">
                                            <option value="Inner">داخل شهر</option>
                                            <option value="Outer">خارج شهر</option>
                                        </select>
                                    </div>
                                }
                                <div class="col-6">
                                    <label class="form-label small">از تاریخ</label>
                                    <input type="date" class="form-control form-control-sm" @bind="lvFrom" />
                                </div>
                                <div class="col-6">
                                    <label class="form-label small">تا تاریخ</label>
                                    <input type="date" class="form-control form-control-sm" @bind="lvTo" />
                                </div>
                                @if (lvType is "Hourly" or "HourlyMission")
                                {
                                    <div class="col-6">
                                        <label class="form-label small">از ساعت</label>
                                        <input class="form-control form-control-sm" dir="ltr" placeholder="08:00" @bind="lvStart" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">تا ساعت</label>
                                        <input class="form-control form-control-sm" dir="ltr" placeholder="10:00" @bind="lvEnd" />
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label small">ساعت</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="lvHours" />
                                    </div>
                                }
                                else
                                {
                                    <div class="col-6">
                                        <label class="form-label small">روز</label>
                                        <input type="number" step="0.5" class="form-control form-control-sm" @bind="lvDays" />
                                    </div>
                                }
                                @if (lvType is "Mission" or "HourlyMission")
                                {
                                    <div class="col-12">
                                        <label class="form-label small">مقصد</label>
                                        <input class="form-control form-control-sm" @bind="lvDest" />
                                    </div>
                                }
                                <div class="col-12">
                                    <label class="form-label small">علت</label>
                                    <input class="form-control form-control-sm" @bind="lvReason" />
                                </div>
                                <div class="col-12">
                                    <button class="btn btn-sm btn-primary w-100" @onclick="SubmitLeave" disabled="@busy">ثبت درخواست</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
        else if (tab == "roster")
        {
            <div class="d-flex flex-wrap gap-2 mb-2 align-items-end">
                @if (isHr)
                {
                    <div>
                        <label class="form-label small">کاربر</label>
                        <select class="form-select form-select-sm" @bind="roUserId">
                            <option value="0">خودم</option>
                            @foreach (var u in users)
                            {
                                <option value="@u.Id">@u.FullName (@u.Username)</option>
                            }
                        </select>
                    </div>
                }
                <div>
                    <label class="form-label small">از</label>
                    <input type="date" class="form-control form-control-sm" @bind="roFrom" />
                </div>
                <div>
                    <label class="form-label small">تا</label>
                    <input type="date" class="form-control form-control-sm" @bind="roTo" />
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadRoster">نمایش</button>
                @if (isHr)
                {
                    <button class="btn btn-sm btn-primary" @onclick="() => showGen = true"><i class="bi bi-arrow-repeat"></i> تولید چرخشی</button>
                }
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>تاریخ</th><th>شیفت</th>@if (isHr){<th></th>}</tr></thead>
                    <tbody>
                        @foreach (var r in roster)
                        {
                            var x = r;
                            <tr>
                                <td>@x.Date.ToString("yyyy/MM/dd")</td>
                                <td>@x.ShiftName</td>
                                @if (isHr)
                                {
                                    <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteRoster(x.Id)">حذف</button></td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (isHr)
            {
                <div class="alert alert-light small">شیفت‌ها: @string.Join("، ", shifts.Select(s => $"{s.Id}={s.Name}"))</div>
            }
        }
        else if (tab == "device" && isHr)
        {
            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card mb-3">
                        <div class="card-header"><strong>ایمپورت فایل دستگاه</strong></div>
                        <div class="card-body">
                            <label class="form-label small">کد دستگاه</label>
                            <input class="form-control form-control-sm mb-2" @bind="deviceCode" placeholder="مثلاً GATE-1" />
                            <InputFile OnChange="OnFile" accept=".xlsx,.csv,.txt" class="form-control form-control-sm mb-2" />
                            <div class="small text-muted mb-2">ستون‌ها: کد پرسنلی، تاریخ‌وساعت، جهت (In/Out — اختیاری)</div>
                            <button class="btn btn-sm btn-primary w-100" @onclick="UploadFile" disabled="@(busy || upFile == null)">آپلود و ایمپورت</button>
                            @if (importMsg != null){<div class="alert alert-info mt-2 small">@importMsg</div>}
                        </div>
                    </div>
                    <div class="card">
                        <div class="card-header"><strong>اعمال ترددها</strong></div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-6"><label class="form-label small">از</label><input type="date" class="form-control form-control-sm" @bind="apFrom" /></div>
                                <div class="col-6"><label class="form-label small">تا</label><input type="date" class="form-control form-control-sm" @bind="apTo" /></div>
                            </div>
                            <button class="btn btn-sm btn-success w-100 mt-2" @onclick="ApplyPunches" disabled="@busy">اعمال روی کارکرد</button>
                            @if (applyMsg != null){<div class="alert alert-info mt-2 small">@applyMsg</div>}
                        </div>
                    </div>
                </div>
                <div class="col-lg-8">
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <strong>نگاشت کد دستگاه به کاربر</strong>
                        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => showMap = true">افزودن</button>
                    </div>
                    <div class="table-responsive mb-3">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>کد دستگاه</th><th>کد پرسنلی</th><th>کاربر</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var m in maps)
                                {
                                    var x = m;
                                    <tr>
                                        <td>@(x.DeviceCode ?? "همه")</td>
                                        <td><span dir="ltr">@x.UserCode</span></td>
                                        <td>@UserName(x.SystemUserId)</td>
                                        <td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteMap(x.Id)">حذف</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <strong>ترددهای ایمپورت‌شده</strong>
                        <div class="form-check ms-2"><input class="form-check-input" type="checkbox" @bind="puUnmapped" @bind:after="LoadPunches" id="pu1" /><label class="form-check-label small" for="pu1">بدون نگاشت</label></div>
                        <div class="form-check"><input class="form-check-input" type="checkbox" @bind="puUnapplied" @bind:after="LoadPunches" id="pu2" /><label class="form-check-label small" for="pu2">اعمال‌نشده</label></div>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="LoadPunches">نمایش</button>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>دستگاه</th><th>کد</th><th>زمان</th><th>جهت</th><th>کاربر</th><th>اعمال</th></tr></thead>
                            <tbody>
                                @foreach (var p in punches)
                                {
                                    <tr>
                                        <td>@p.DeviceCode</td>
                                        <td><span dir="ltr">@p.UserCode</span></td>
                                        <td class="small">@p.PunchTime.ToString("yyyy/MM/dd HH:mm")</td>
                                        <td>@p.Direction</td>
                                        <td>@(p.MappedUserId == null ? "—" : UserName(p.MappedUserId.Value))</td>
                                        <td>@(p.AppliedRecordId == null ? "—" : "✓")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (tab == "rules" && isHr)
        {
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>عنوان</th><th>کلید</th><th>مقدار</th></tr></thead>
                    <tbody>
                        @foreach (var k in ruleKeys)
                        {
                            var key = k;
                            <tr>
                                <td>@RuleTitle(key)</td>
                                <td><code dir="ltr">@key</code></td>
                                <td style="max-width:220px"><input class="form-control form-control-sm" dir="ltr" @bind="ruleVals[key]" /></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <button class="btn btn-sm btn-primary" @onclick="SaveRules" disabled="@busy">ذخیره قوانین</button>
        }
    </div>
</div>

<Modal Visible="showDecide" Title="@(decideApprove ? "تأیید مرحله" : "رد مرحله")" OnClose="() => showDecide = false">
    <p class="small">@decideTarget?.Title — @decideTarget?.Requester (@decideTarget?.Number)</p>
    <label class="form-label small">توضیح (اختیاری — برای رد، علت رد)</label>
    <input class="form-control form-control-sm" @bind="decideNote" />
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-sm @(decideApprove ? "btn-success" : "btn-danger")" @onclick="DoDecide" disabled="@busy">ثبت</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => showDecide = false">انصراف</button>
    </div>
</Modal>

<Modal Visible="showTimeline" Title="گردش تأیید" OnClose="() => showTimeline = false">
    @if (timeline.Count == 0)
    {
        <div class="alert alert-info small">گردشی ثبت نشده است.</div>
    }
    else
    {
        <ol class="list-group list-group-numbered">
            @foreach (var t in timeline)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start">
                    <div class="ms-2 me-auto">
                        <div class="fw-bold">@RoleFa(t.Role) @(t.ApproverName == null ? "" : $"— {t.ApproverName}")</div>
                        <span class="small">@(t.DecidedByName ?? "در انتظار") @(t.DecidedAt == null ? "" : t.DecidedAt.Value.ToString("yyyy/MM/dd HH:mm"))</span>
                        @if (!string.IsNullOrWhiteSpace(t.Note)){<div class="small text-muted">@t.Note</div>}
                    </div>
                    <span class="badge @StatusCls(t.Status)">@StatusFa(t.Status)</span>
                </li>
            }
        </ol>
    }
</Modal>

<Modal Visible="showOt" Title="درخواست اضافه‌کاری" OnClose="() => showOt = false">
    <div class="row g-2">
        <div class="col-6"><label class="form-label small">تاریخ</label><input type="date" class="form-control form-control-sm" @bind="otDate" /></div>
        <div class="col-6">
            <label class="form-label small">نوع</label>
            <select class="form-select form-select-sm" @bind="otType">
                <option value="Normal">عادی</option>
                <option value="Holiday">تعطیل</option>
                <option value="Night">شب</option>
            </select>
        </div>
        <div class="col-6"><label class="form-label small">از ساعت</label><input class="form-control form-control-sm" dir="ltr" placeholder="17:00" @bind="otStart" /></div>
        <div class="col-6"><label class="form-label small">تا ساعت</label><input class="form-control form-control-sm" dir="ltr" placeholder="20:00" @bind="otEnd" /></div>
        <div class="col-12"><label class="form-label small">علت</label><input class="form-control form-control-sm" @bind="otReason" /></div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-sm btn-primary" @onclick="SubmitOt" disabled="@busy">ثبت</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => showOt = false">انصراف</button>
    </div>
</Modal>

<Modal Visible="showGen" Title="تولید روستِر چرخشی" OnClose="() => showGen = false">
    <div class="row g-2">
        <div class="col-12">
            <label class="form-label small">کاربر</label>
            <select class="form-select form-select-sm" @bind="genUserId">
                @foreach (var u in users)
                {
                    <option value="@u.Id">@u.FullName (@u.Username)</option>
                }
            </select>
        </div>
        <div class="col-6"><label class="form-label small">از</label><input type="date" class="form-control form-control-sm" @bind="genFrom" /></div>
        <div class="col-6"><label class="form-label small">تا</label><input type="date" class="form-control form-control-sm" @bind="genTo" /></div>
        <div class="col-12">
            <label class="form-label small">الگوی شیفت (شناسه‌ها با کاما — مثلاً 1,1,2,2)</label>
            <input class="form-control form-control-sm" dir="ltr" @bind="genPattern" />
            <div class="small text-muted mt-1">شیفت‌ها: @string.Join("، ", shifts.Select(s => $"{s.Id}={s.Name}"))</div>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-sm btn-primary" @onclick="SubmitGen" disabled="@busy">تولید</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => showGen = false">انصراف</button>
    </div>
</Modal>

<Modal Visible="showMap" Title="نگاشت کد دستگاه" OnClose="() => showMap = false">
    <div class="row g-2">
        <div class="col-6"><label class="form-label small">کد دستگاه (خالی = همه)</label><input class="form-control form-control-sm" dir="ltr" @bind="mapDevice" /></div>
        <div class="col-6"><label class="form-label small">کد پرسنلی دستگاه</label><input class="form-control form-control-sm" dir="ltr" @bind="mapCode" /></div>
        <div class="col-12">
            <label class="form-label small">کاربر سیستم</label>
            <select class="form-select form-select-sm" @bind="mapUserId">
                @foreach (var u in users)
                {
                    <option value="@u.Id">@u.FullName (@u.Username)</option>
                }
            </select>
        </div>
    </div>
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-sm btn-primary" @onclick="SubmitMap" disabled="@busy">ذخیره</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => showMap = false">انصراف</button>
    </div>
</Modal>

<Modal Visible="showGrant" Title="ویرایش سهمیه" OnClose="() => showGrant = false">
    <p class="small">@(grantCat == null ? "" : CatFa(grantCat)) — سال @Fa.Digits(balYear)</p>
    <label class="form-label small">سهمیه (روز)</label>
    <input type="number" step="0.5" class="form-control form-control-sm" @bind="grantDays" />
    <div class="d-flex gap-2 mt-3">
        <button class="btn btn-sm btn-primary" @onclick="SubmitGrant" disabled="@busy">ذخیره</button>
        <button class="btn btn-sm btn-secondary" @onclick="() => showGrant = false">انصراف</button>
    </div>
</Modal>

@code {
    private bool canUse => Auth.Has("LeaveRequests.Request") || Auth.Has("LeaveRequests.Approve") || Auth.Has("LeaveRequests.Report") || Auth.IsAdmin;
    private bool isHr => Auth.Has("LeaveRequests.Approve") || Auth.IsAdmin;

    private string tab = "steps";
    private bool busy;
    private async Task SetTab(string t) { tab = t; await LoadTab(); }
    private async Task LoadTab()
    {
        if (tab == "steps") await LoadSteps();
        else if (tab == "overtime") await LoadOvertime();
        else if (tab == "balance") { await EnsureUsers(); await LoadBalances(); }
        else if (tab == "roster") { await EnsureUsers(); await LoadShifts(); await LoadRoster(); }
        else if (tab == "device") { await EnsureUsers(); await LoadMaps(); await LoadPunches(); }
        else if (tab == "rules") await LoadRules();
    }

    protected override async Task OnInitializedAsync() => await LoadSteps();

    private static string CatFa(string c) => c switch { "Annual" => "استحقاقی", "Sick" => "استعلاجی", "Maternity" => "زایمان", "Unpaid" => "بدون حقوق", _ => c };
    private static string RoleFa(string r) => r switch { "Manager" => "مدیر مستقیم", "Hr" => "کارگزینی", _ => r };
    private static string StatusFa(string s) => s switch { "Pending" => "در انتظار", "Approved" => "تأیید", "Rejected" => "رد", "Skipped" => "منتفی", _ => s };
    private static string StatusCls(string s) => s switch { "Approved" => "bg-success", "Rejected" => "bg-danger", "Skipped" => "bg-secondary", _ => "bg-warning text-dark" };
    private static string OtTypeFa(string t) => t switch { "Normal" => "عادی", "Holiday" => "تعطیل", "Night" => "شب", _ => t };
    private static string RuleTitle(string k) => k switch
    {
        "night.start" => "شروع شب‌کاری", "night.end" => "پایان شب‌کاری",
        "ot.coef.normal" => "ضریب اضافه‌کاری عادی", "ot.coef.holiday" => "ضریب تعطیل‌کاری", "ot.coef.night" => "ضریب شب‌کاری",
        "leave.annual.grant" => "سهمیه استحقاقی (روز)", "leave.sick.grant" => "سقف استعلاجی (روز)",
        "leave.maternity.grant" => "سقف زایمان (روز)", "leave.unpaid.grant" => "سقف بدون حقوق (روز)",
        "mission.allowance.inner" => "حق ماموریت داخل شهر (ریال/روز)", "mission.allowance.outer" => "حق ماموریت خارج شهر (ریال/روز)",
        _ => k
    };

    private async Task<string?> Err(System.Net.Http.HttpResponseMessage r)
    {
        try
        {
            var d = await r.Content.ReadFromJsonAsync<Dictionary<string, object>>();
            if (d != null && d.TryGetValue("message", out var m)) return m?.ToString();
        }
        catch { }
        return $"خطا: {(int)r.StatusCode}";
    }

    // ---------- عمومی ----------
    private List<UserDto> users = new();
    private List<ShiftDto> shifts = new();
    private async Task EnsureUsers()
    {
        if (!isHr || users.Count > 0) return;
        try { users = await Http.GetFromJsonAsync<List<UserDto>>("/api/hr-time/users") ?? new(); } catch { }
    }
    private async Task LoadShifts()
    {
        if (shifts.Count > 0) return;
        try { shifts = await Http.GetFromJsonAsync<List<ShiftDto>>("/api/Attendance/shifts") ?? new(); } catch { }
    }
    private string UserName(int id) => users.FirstOrDefault(u => u.Id == id)?.FullName ?? $"#{id}";

    // ---------- تأییدها ----------
    private List<StepDto> steps = new();
    private int pendingCount;
    private bool showAllSteps;
    private async Task LoadSteps()
    {
        try
        {
            steps = await Http.GetFromJsonAsync<List<StepDto>>($"/api/hr-time/steps/pending?all={showAllSteps}") ?? new();
            pendingCount = showAllSteps ? steps.Count : steps.Count;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private bool showDecide; private StepDto? decideTarget; private bool decideApprove = true; private string? decideNote;
    private void OpenDecide(StepDto s, bool approve) { decideTarget = s; decideApprove = approve; decideNote = null; showDecide = true; }
    private async Task DoDecide()
    {
        if (decideTarget == null) return;
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync($"/api/hr-time/steps/{decideTarget.Id}/decide", new { approve = decideApprove, note = decideNote });
            if (r.IsSuccessStatusCode) { Toast.Success("ثبت شد."); showDecide = false; await LoadSteps(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private bool showTimeline; private List<TimelineDto> timeline = new();
    private async Task OpenTimeline(StepDto s)
    {
        try
        {
            timeline = await Http.GetFromJsonAsync<List<TimelineDto>>($"/api/hr-time/steps?requestType={s.RequestType}&requestId={s.RequestId}") ?? new();
            showTimeline = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task OpenTimeline2(OtDto o)
    {
        try
        {
            timeline = await Http.GetFromJsonAsync<List<TimelineDto>>($"/api/hr-time/steps?requestType=Overtime&requestId={o.Id}") ?? new();
            showTimeline = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---------- اضافه‌کاری ----------
    private List<OtDto> ots = new();
    private string? otStatus = "";
    private async Task LoadOvertime()
    {
        try
        {
            var q = string.IsNullOrEmpty(otStatus) ? "" : $"?status={otStatus}";
            ots = await Http.GetFromJsonAsync<List<OtDto>>("/api/hr-time/overtime" + q) ?? new();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task DeleteOt(int id)
    {
        var r = await Http.DeleteAsync($"/api/hr-time/overtime/{id}");
        if (r.IsSuccessStatusCode) { Toast.Success("حذف شد."); await LoadOvertime(); }
        else Toast.Error(await Err(r) ?? "خطا");
    }
    private bool showOt; private DateTime otDate = DateTime.Today; private string otType = "Normal";
    private string otStart = "17:00"; private string otEnd = "20:00"; private string? otReason;
    private async Task SubmitOt()
    {
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-time/overtime", new { workDate = otDate, startTime = otStart, endTime = otEnd, type = otType, reason = otReason });
            if (r.IsSuccessStatusCode) { Toast.Success("ثبت شد."); showOt = false; await LoadOvertime(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }

    // ---------- موجودی + درخواست ----------
    private List<BalanceDto> balances = new();
    private int balUserId; private int balYear = 1405;
    private async Task LoadBalances()
    {
        try
        {
            var q = balUserId == 0 ? $"?year={balYear}" : $"?userId={balUserId}&year={balYear}";
            var d = await Http.GetFromJsonAsync<BalanceResp>("/api/hr-time/balances" + q);
            balances = d?.Items ?? new();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private bool showGrant; private string? grantCat; private double grantDays;
    private void OpenGrant(BalanceDto b) { grantCat = b.Category; grantDays = b.Granted; showGrant = true; }
    private async Task SubmitGrant()
    {
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-time/balances/grant", new { userId = balUserId, year = balYear, category = grantCat, days = grantDays });
            if (r.IsSuccessStatusCode) { Toast.Success("ذخیره شد."); showGrant = false; await LoadBalances(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private string lvType = "Daily"; private string lvCat = "Annual"; private string lvKind = "Inner";
    private DateTime lvFrom = DateTime.Today; private DateTime lvTo = DateTime.Today;
    private string lvStart = "08:00"; private string lvEnd = "10:00";
    private double lvDays = 1; private double lvHours = 2;
    private string? lvDest; private string? lvReason;
    private async Task SubmitLeave()
    {
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-time/leaves", new
            {
                type = lvType, startDate = lvFrom, endDate = lvTo, startTime = lvStart, endTime = lvEnd,
                days = lvDays, hours = lvHours, destination = lvDest, reason = lvReason, category = lvCat, missionKind = lvKind
            });
            if (r.IsSuccessStatusCode) { Toast.Success("درخواست ثبت و وارد گردش تأیید شد."); await LoadBalances(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }

    // ---------- روستِر ----------
    private List<RosterDto> roster = new();
    private int roUserId; private DateTime roFrom = DateTime.Today; private DateTime roTo = DateTime.Today.AddDays(30);
    private async Task LoadRoster()
    {
        try
        {
            var q = roUserId == 0
                ? $"?from={roFrom:yyyy-MM-dd}&to={roTo:yyyy-MM-dd}"
                : $"?userId={roUserId}&from={roFrom:yyyy-MM-dd}&to={roTo:yyyy-MM-dd}";
            roster = await Http.GetFromJsonAsync<List<RosterDto>>("/api/hr-time/roster" + q) ?? new();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task DeleteRoster(int id)
    {
        var r = await Http.DeleteAsync($"/api/hr-time/roster/{id}");
        if (r.IsSuccessStatusCode) { Toast.Success("حذف شد."); await LoadRoster(); }
        else Toast.Error(await Err(r) ?? "خطا");
    }
    private bool showGen; private int genUserId; private DateTime genFrom = DateTime.Today; private DateTime genTo = DateTime.Today.AddDays(30);
    private string genPattern = "";
    private async Task SubmitGen()
    {
        var pat = genPattern.Split(',', '،', ';').Select(x => int.TryParse(x.Trim(), out var v) ? v : 0).Where(v => v > 0).ToList();
        if (genUserId == 0 || pat.Count == 0) { Toast.Error("کاربر و الگوی شیفت را مشخص کنید."); return; }
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-time/roster/generate", new { userIds = new[] { genUserId }, from = genFrom, to = genTo, pattern = pat, startOffset = 0 });
            if (r.IsSuccessStatusCode) { Toast.Success("روستِر تولید شد."); showGen = false; }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }

    // ---------- دستگاه ----------
    private List<MapDto> maps = new();
    private List<PunchDto> punches = new();
    private bool puUnmapped, puUnapplied = true;
    private string deviceCode = ""; private IBrowserFile? upFile; private string? importMsg, applyMsg;
    private DateTime apFrom = DateTime.Today.AddDays(-7); private DateTime apTo = DateTime.Today;
    private async Task LoadMaps()
    {
        try { maps = await Http.GetFromJsonAsync<List<MapDto>>("/api/hr-time/device/mappings") ?? new(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task LoadPunches()
    {
        try { punches = await Http.GetFromJsonAsync<List<PunchDto>>($"/api/hr-time/device/punches?unmappedOnly={puUnmapped}&unappliedOnly={puUnapplied}") ?? new(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private void OnFile(InputFileChangeEventArgs e) { upFile = e.File; importMsg = null; }
    private async Task UploadFile()
    {
        if (upFile == null || string.IsNullOrWhiteSpace(deviceCode)) { Toast.Error("کد دستگاه و فایل را مشخص کنید."); return; }
        busy = true;
        try
        {
            using var c = new MultipartFormDataContent();
            c.Add(new StreamContent(upFile.OpenReadStream(20_000_000)), "file", upFile.Name);
            c.Add(new StringContent(deviceCode.Trim()), "deviceCode");
            var r = await Http.PostAsync("/api/hr-time/device/upload", c);
            if (r.IsSuccessStatusCode)
            {
                var d = await r.Content.ReadFromJsonAsync<Dictionary<string, object>>();
                importMsg = "ایمپورت شد: " + (d?["imported"]?.ToString() ?? "?");
                await LoadPunches();
            }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private async Task ApplyPunches()
    {
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-time/device/apply", new { from = apFrom, to = apTo });
            if (r.IsSuccessStatusCode)
            {
                var d = await r.Content.ReadFromJsonAsync<Dictionary<string, object>>();
                applyMsg = $"تردد اعمال‌شده: {d?["punches"]} — رکورد: {d?["records"]}";
                await LoadPunches();
            }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private bool showMap; private string? mapDevice; private string mapCode = ""; private int mapUserId;
    private async Task SubmitMap()
    {
        if (string.IsNullOrWhiteSpace(mapCode) || mapUserId == 0) { Toast.Error("کد دستگاه و کاربر را مشخص کنید."); return; }
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-time/device/mappings", new { deviceCode = string.IsNullOrWhiteSpace(mapDevice) ? null : mapDevice!.Trim(), userCode = mapCode.Trim(), systemUserId = mapUserId });
            if (r.IsSuccessStatusCode) { Toast.Success("ذخیره شد."); showMap = false; await LoadMaps(); await LoadPunches(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private async Task DeleteMap(int id)
    {
        var r = await Http.DeleteAsync($"/api/hr-time/device/mappings/{id}");
        if (r.IsSuccessStatusCode) { Toast.Success("حذف شد."); await LoadMaps(); }
        else Toast.Error(await Err(r) ?? "خطا");
    }

    // ---------- قوانین ----------
    private List<string> ruleKeys = new();
    private Dictionary<string, string> ruleVals = new();
    private async Task LoadRules()
    {
        try
        {
            ruleVals = await Http.GetFromJsonAsync<Dictionary<string, string>>("/api/hr-time/rules") ?? new();
            ruleKeys = ruleVals.Keys.OrderBy(k => k).ToList();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task SaveRules()
    {
        busy = true;
        try
        {
            var r = await Http.PutAsJsonAsync("/api/hr-time/rules", ruleVals);
            if (r.IsSuccessStatusCode) Toast.Success("ذخیره شد.");
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }

    // ---------- مدل‌ها ----------
    private class StepDto
    {
        public int Id { get; set; }
        public string RequestType { get; set; } = "";
        public int RequestId { get; set; }
        public int StepNo { get; set; }
        public string Role { get; set; } = "";
        public string? ApproverName { get; set; }
        public DateTime CreatedAt { get; set; }
        public string? Number { get; set; }
        public string? Requester { get; set; }
        public string? Title { get; set; }
        public string? Detail { get; set; }
    }
    private class TimelineDto
    {
        public int StepNo { get; set; }
        public string Role { get; set; } = "";
        public string? ApproverName { get; set; }
        public string Status { get; set; } = "";
        public string? Note { get; set; }
        public string? DecidedByName { get; set; }
        public DateTime? DecidedAt { get; set; }
    }
    private class OtDto
    {
        public int Id { get; set; }
        public string Number { get; set; } = "";
        public string RequesterName { get; set; } = "";
        public DateTime WorkDate { get; set; }
        public TimeSpan StartTime { get; set; }
        public TimeSpan EndTime { get; set; }
        public int Minutes { get; set; }
        public string Type { get; set; } = "";
        public string Status { get; set; } = "";
    }
    private class BalanceResp { public int Year { get; set; } public List<BalanceDto> Items { get; set; } = new(); }
    private class BalanceDto
    {
        public string Category { get; set; } = "";
        public double Granted { get; set; }
        public double Used { get; set; }
        public double Pending { get; set; }
        public double Remaining { get; set; }
    }
    private class RosterDto
    {
        public int Id { get; set; }
        public int UserId { get; set; }
        public DateTime Date { get; set; }
        public int ShiftGroupId { get; set; }
        public string? ShiftName { get; set; }
    }
    private class UserDto { public int Id { get; set; } public string Username { get; set; } = ""; public string FullName { get; set; } = ""; }
    private class ShiftDto { public int Id { get; set; } public string Name { get; set; } = ""; }
    private class MapDto { public int Id { get; set; } public string? DeviceCode { get; set; } public string UserCode { get; set; } = ""; public int SystemUserId { get; set; } }
    private class PunchDto
    {
        public int Id { get; set; }
        public string DeviceCode { get; set; } = "";
        public string UserCode { get; set; } = "";
        public DateTime PunchTime { get; set; }
        public string Direction { get; set; } = "";
        public int? MappedUserId { get; set; }
        public int? AppliedRecordId { get; set; }
    }
}
