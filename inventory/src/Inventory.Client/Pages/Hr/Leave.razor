    private string FormPlaceholder => formType is "Mission" or "HourlyMission" ? "شرح کار و ضرورت مأموریت…" : "مثلاً: مرخصی استحقاقی، مشکلات شخصی…";
    private static string D0(double v) => v == (long)v ? Fa.Digits((long)v) : Fa.Digits((decimal)Math.Round(v, 2));
    private string AmountText(LeaveItem r) =>
        r.Type is "Hourly" or "HourlyMission" ? $"{D0(r.Hours)} ساعت" : $"{D0(r.Days)} روز";
