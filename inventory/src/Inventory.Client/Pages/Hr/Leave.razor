    private async Task SubmitRequest()
    {
        formError = "";
        if (formStart == null) { formError = "تاریخ شروع را انتخاب کنید."; return; }
        if (formType is "Daily" or "Mission" && formEnd == null) { formError = "تاریخ پایان را انتخاب کنید."; return; }
        if (formType is "Hourly" or "HourlyMission" && !TryParseHours(out _))
        { formError = "ساعت شروع و پایان را درست وارد کنید (ساعت پایان باید بعد از شروع و حداکثر ۸ ساعت باشد)."; return; }
        if (formType is "Mission" or "HourlyMission" && string.IsNullOrWhiteSpace(formDestination)) { formError = "مقصد ماموریت را وارد کنید."; return; }

        formBusy = true;
        try
        {
            var isHourly = formType is "Hourly" or "HourlyMission";
            var resp = await Http.PostAsJsonAsync("/api/LeaveRequests", new
            {
                Type = formType,
                StartDate = formStart.Value.Date,
                EndDate = (isHourly ? formStart.Value.Date : formEnd!.Value.Date),
                StartTime = isHourly ? formStartTime : null,
                EndTime = isHourly ? formEndTime : null,
                Days = 0, Hours = 0,
                Destination = formType is "Mission" or "HourlyMission" ? formDestination : null,
                Reason = formReason
            });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("درخواست با موفقیت ثبت شد.");
                formStart = DateTime.Today; formEnd = DateTime.Today;
                formStartTime = null; formEndTime = null; formDestination = null; formReason = "";
                await LoadBalance(); await LoadMine();
                if (IsManager) await LoadPendingAll();
            }
            else formError = await ExtractError(resp);
        }
        catch (Exception ex) { formError = ex.Message; }
        formBusy = false;
    }

    private async Task CancelRequest(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "آیا از انصراف این درخواست مطمئن هستید؟");
        if (!ok) return;
        try
        {
            var resp = await Http.DeleteAsync($"/api/LeaveRequests/{id}");
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("درخواست انصراف شد.");
                await LoadBalance(); await LoadMine();
                if (IsManager) await LoadPendingAll();
            }
            else Toast.Error(await ExtractError(resp));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task<string> ExtractError(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m)) return m.GetString() ?? "";
        }
        catch { }
        return $"سرور درخواست را نپذیرفت (کد {(int)resp.StatusCode}).";
    }

