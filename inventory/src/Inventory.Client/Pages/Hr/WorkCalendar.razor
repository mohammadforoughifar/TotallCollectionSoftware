@code {
    // ================== وضعیت ==================
    private bool loading = true;
    private bool saving, saveError, dirty;
    private bool savingSet;
    private bool importing, importError;
    private string saveMsg = "";
    private string importMsg = "";
    private string tab = "cal";
    private bool showLogic;
    private int vmYear;
    private List<YMonth> months = new();
    private Summary? summary;
    private SettingsForm set = new();
    private List<HolRow> holidayRows = new();
    private YDay? sel;
    private bool holReplace;
    private DateTime? newHolDate;
    private string newHolName = "";
    private string bulkStart = "08:00", bulkEnd = "16:30";

    private static readonly string[] WeekHeads = { "ش", "ی", "د", "س", "چ", "پ", "ج" };
    private static readonly (string Name, int Flags)[] WeekDayFlags =
    {
        ("شنبه", 64), ("یکشنبه", 1), ("دوشنبه", 2), ("سه‌شنبه", 4),
        ("چهارشنبه", 8), ("پنجشنبه", 16), ("جمعه", 32),
    };

    private static string Hm(string? t) => string.IsNullOrWhiteSpace(t) || t.Length < 5 ? "08:00" : t[..5];
    private static string Num(double v) => Fa.Digits(((decimal)v).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture));
    private static bool IsNight(string? start, string? end) =>
        TimeSpan.TryParse(start, out var st) && TimeSpan.TryParse(end, out var en) && en < st;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new("Bearer", Auth.Token);
        (vmYear, _, _) = PersianDate.FromGregorian(DateTime.Now);
        await LoadYear();
    }

    private void SetTab(string t)
    {
        tab = t;
        if (t == "hol") _ = LoadHolidays();
    }

    private void PrevYear() { vmYear--; _ = LoadYear(); }
    private void NextYear() { vmYear++; _ = LoadYear(); }
    private void GoCurrentYear() { (vmYear, _, _) = PersianDate.FromGregorian(DateTime.Now); _ = LoadYear(); }
    private void JumpYear(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var y) && y is >= 1300 and <= 1500) { vmYear = y; _ = LoadYear(); }
    }

    // ================== بارگذاری ==================
    private async Task LoadYear()
    {
        loading = true;
        saveMsg = "";
        dirty = false;
        sel = null;
        try
        {
            var r = await Http.GetFromJsonAsync<YearResp>($"/api/Attendance/calendar-year?jy={vmYear}");
            months = new();
            if (r?.months != null)
            {
                foreach (var m in r.months)
                {
                    var ym = new YMonth
                    {
                        Month = m.month,
                        MonthName = m.monthName,
                        DaysInMonth = m.daysInMonth,
                        FirstDayColumn = m.firstDayColumn,
                        WorkDays = m.workDays,
                        WorkHours = m.workHours,
                    };
                    foreach (var d in m.days)
                    {
                        var (_, _, jd) = PersianDate.FromGregorian(d.date);
                        var otHours = d.overtimeHours > 0 ? d.overtimeHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "";
                        var otMode = d.overtimeMode;
                        if (otMode == 0 && !string.IsNullOrEmpty(otHours) && !d.isWorkday) otMode = 3;
                        ym.Days.Add(new YDay
                        {
                            Date = d.date,
                            DayNumber = jd,
                            MonthOf = m.month,
                            IsToday = d.isToday,
                            IsWorkday = d.isWorkday,
                            StartText = Hm(d.start),
                            EndText = Hm(d.end),
                            OtMode = otMode,
                            OtStartText = d.overtimeStart != null ? Hm(d.overtimeStart) : "",
                            OtEndText = d.overtimeEnd != null ? Hm(d.overtimeEnd) : "",
                            OvertimeText = otHours,
                            Source = d.source,
                            IsOfficial = d.isOfficial,
                            HolidayName = d.holidayName,
                            Note = d.note,
                            HasRule = d.hasRule,
                        });
                    }
                    months.Add(ym);
                }
            }
            if (r?.summary != null) summary = new Summary
            {
                TotalWorkDays = r.summary.totalWorkDays,
                TotalOfficialHolidays = r.summary.totalOfficialHolidays,
                TotalCompanyHolidays = r.summary.totalCompanyHolidays,
                TotalRestDays = r.summary.totalRestDays,
                TotalCustomDays = r.summary.totalCustomDays,
                TotalWorkHours = r.summary.totalWorkHours,
                HasLunarCatalog = r.summary.hasLunarCatalog,
            };
            if (r?.settings != null)
            {
                set = new SettingsForm
                {
                    DefaultStart = Hm(r.settings.defaultStart),
                    DefaultEnd = Hm(r.settings.defaultEnd),
                    GraceMinutes = r.settings.graceMinutes,
                    RestDayFlags = r.settings.restDayFlags,
                    ApplyOfficialHolidays = r.settings.applyOfficialHolidays,
                };
                bulkStart = set.DefaultStart;
                bulkEnd = set.DefaultEnd;
            }
        }
        catch
        {
            months = new();
            summary = null;
        }
        loading = false;
    }

    private async Task LoadHolidays()
    {
        try
        {
            var from = PersianDate.ToGregorian(vmYear, 1, 1);
            var to = PersianDate.ToGregorian(vmYear + 1, 1, 1);
            var all = await Http.GetFromJsonAsync<List<HolDto>>("/api/LeaveRequests/holidays");
            holidayRows = (all ?? new List<HolDto>())
                .Where(h => h.holidayDate.Date >= from && h.holidayDate.Date < to)
                .Select(h => new HolRow { Id = h.id, Date = h.holidayDate, Name = h.name, IsOfficial = h.isOfficial, CreatedByName = h.createdByName })
                .OrderBy(h => h.Date).ToList();
        }
        catch { holidayRows = new List<HolRow>(); }
    }

    // ================== نمای روز ==================
    private string DayClass(YDay d)
    {
        var c = "";
        if (d.IsToday) c += " d-today";
        if (ReferenceEquals(sel, d)) c += " d-sel";
        if (!d.IsWorkday)
        {
            if (d.Source == "Holiday") c += d.IsOfficial ? " d-official" : " d-company";
            else c += " d-rest";
        }
        if (d.HasRule) c += d.IsWorkday ? " d-custom" : " d-custom-off";
        return c.Trim();
    }

    private string DayTitle(YDay d)
    {
        var t = $"{PersianDate.ToShort(d.Date)} — {PersianDate.DayName(d.Date)}";
        t += d.IsWorkday ? $" | روز کاری {d.StartText} تا {d.EndText}" : " | تعطیل";
        if (!string.IsNullOrEmpty(d.HolidayName)) t += $" | {d.HolidayName}";
        if (!string.IsNullOrEmpty(d.Note)) t += $" | {d.Note}";
        if (d.HasRule) t += " | قانون سفارشی";
        return t;
    }

    private string SourceText(YDay d) => d.Source switch
    {
        "Calendar" => "قانون سفارشی تقویم",
        "Holiday" => d.IsOfficial ? "تعطیل رسمی کشور" : "تعطیلی شرکتی",
        "Shift" => "شیفت کاربر",
        "Default" => "پیش‌فرض تنظیمات",
        _ => "پیش‌فرض",
    };

    private void SelectDay(YDay day) => sel = day;

    private void MarkDirty() { dirty = true; saveMsg = ""; }

    private void SetWorkday(YDay day, bool workday)
    {
        day.IsWorkday = workday;
        day.HasRule = true;
        dirty = true;
        saveMsg = "";
    }

    private void ResetDay(YDay day)
    {
        day.HasRule = false;
        day.Note = null;
        day.OtMode = 0;
        day.OvertimeText = "";
        day.OtStartText = "";
        day.OtEndText = "";
        dirty = true;
        saveMsg = "";
    }

    // ================== اکشن‌های گروهی ==================
    private void ApplyHoursToYear()
    {
        var n = 0;
        foreach (var d in AllDays.Where(d => d.IsWorkday))
        {
            d.StartText = bulkStart;
            d.EndText = bulkEnd;
            d.HasRule = true;
            n++;
        }
        dirty = true;
        saveMsg = $"ساعت {bulkStart} تا {bulkEnd} روی {Fa.Digits(n)} روز کاری اعمال شد — ذخیره فراموش نشود.";
        saveError = false;
    }

    private void MarkRestDaysOff()
    {
        var n = 0;
        foreach (var d in AllDays)
        {
            var isRestWeekday = (set.RestDayFlags & (1 << (int)d.Date.DayOfWeek)) != 0;
            if (isRestWeekday && d.Source != "Holiday")
            {
                d.IsWorkday = false;
                d.HasRule = true;
                n++;
            }
        }
        dirty = true;
        saveMsg = $"{Fa.Digits(n)} روز تعطیل هفته علامت‌گذاری شد — ذخیره فراموش نشود.";
        saveError = false;
    }

    private void ResetYear()
    {
        foreach (var d in AllDays) { d.HasRule = false; d.Note = null; d.OtMode = 0; d.OvertimeText = ""; d.OtStartText = ""; d.OtEndText = ""; }
        dirty = true;
        sel = null;
        saveMsg = "همه‌ی قوانین سال پاک شد (بازگشت به پیش‌فرض/تعطیلات) — ذخیره فراموش نشود.";
        saveError = false;
    }

    private async Task CopyPrevYear()
    {
        try
        {
            var r = await Http.GetFromJsonAsync<YearResp>($"/api/Attendance/calendar-year?jy={vmYear - 1}");
            if (r?.months == null) return;
            var n = 0;
            foreach (var m in r.months)
                foreach (var d in m.days.Where(d => d.hasRule))
                {
                    var (_, _, jd) = PersianDate.FromGregorian(d.date);
                    var target = months.FirstOrDefault(x => x.Month == m.month)?.Days.FirstOrDefault(x => x.DayNumber == jd);
                    if (target == null) continue;
                    target.IsWorkday = d.isWorkday;
                    target.StartText = Hm(d.start);
                    target.EndText = Hm(d.end);
                    target.OtMode = d.overtimeMode;
                    target.OtStartText = d.overtimeStart != null ? Hm(d.overtimeStart) : "";
                    target.OtEndText = d.overtimeEnd != null ? Hm(d.overtimeEnd) : "";
                    target.OvertimeText = d.overtimeHours > 0 ? d.overtimeHours.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) : "";
                    target.Note = d.note;
                    target.HasRule = true;
                    n++;
                }
            dirty = true;
            saveMsg = n > 0 ? $"{Fa.Digits(n)} قانون از سال {Fa.Digits(vmYear - 1)} کپی شد — ذخیره فراموش نشود." : "سال قبل قانونی برای کپی نداشت.";
            saveError = n == 0;
        }
        catch { saveMsg = "کپی از سال قبل ممکن نبود."; saveError = true; }
    }

    // ================== ذخیره ==================
    private async Task SaveYear()
    {
        saving = true;
        saveMsg = "";
        saveError = false;

        foreach (var d in AllDays.Where(d => d.HasRule))
        {
            if (d.IsWorkday && (!TimeSpan.TryParse(d.StartText, out _) || !TimeSpan.TryParse(d.EndText, out _)))
            {
                saveMsg = $"ساعت شروع/پایان روز {Fa.Digits(d.DayNumber)} {PersianDate.MonthName(d.MonthOf)} را کامل وارد کنید.";
                saveError = true;
                saving = false;
                return;
            }
            if (d.OtMode == 1 && (!TimeSpan.TryParse(d.OtStartText, out _) || !TimeSpan.TryParse(d.OtEndText, out _)))
            {
                saveMsg = $"ساعت‌های بازه اضافه‌کاری روز {Fa.Digits(d.DayNumber)} {PersianDate.MonthName(d.MonthOf)} را کامل وارد کنید.";
                saveError = true;
                saving = false;
                return;
            }
        }

        try
        {
            var payload = AllDays.Select(d =>
            {
                double otHours = 0;
                string? otStart = null, otEnd = null;
                int otMode = 0;
                if (d.HasRule)
                {
                    otMode = d.OtMode;
                    if (otMode == 1) { otStart = d.OtStartText; otEnd = d.OtEndText; }
                    else if (otMode == 3)
                        double.TryParse(d.OvertimeText, System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out otHours);
                }
                return new
                {
                    date = d.Date,
                    isWorkday = d.IsWorkday,
                    startTime = d.HasRule && d.IsWorkday ? d.StartText : null,
                    endTime = d.HasRule && d.IsWorkday ? d.EndText : null,
                    graceMinutes = 0,
                    overtimeHours = otHours,
                    overtimeMode = otMode,
                    overtimeStart = otStart,
                    overtimeEnd = otEnd,
                    note = d.HasRule ? d.Note : null,
                    hasRule = d.HasRule,
                };
            }).ToList();

            var resp = await Http.PutAsJsonAsync("/api/Attendance/calendar", new { year = vmYear, month = 0, days = payload });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success($"تقویم سال {Fa.Digits(vmYear)} ذخیره شد.");
                await LoadYear();
            }
            else
            {
                try
                {
                    var body = await resp.Content.ReadAsStringAsync();
                    using var doc = System.Text.Json.JsonDocument.Parse(body);
                    if (doc.RootElement.TryGetProperty("message", out var m)) saveMsg = "خطا: " + m.GetString();
                }
                catch { saveMsg = "ذخیره‌ی تقویم ممکن نبود."; }
                saveError = true;
            }
        }
        catch (Exception ex) { saveMsg = ex.Message; saveError = true; }
        saving = false;
    }

    // ================== تعطیلات رسمی ==================
    private async Task ImportHolidays()
    {
        importing = true;
        importMsg = "";
        importError = false;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/Attendance/official-holidays/import", new { year = vmYear, replace = holReplace });
            if (resp.IsSuccessStatusCode)
            {
                var body = await resp.Content.ReadFromJsonAsync<System.Text.Json.JsonElement>();
                var added = body.TryGetProperty("added", out var addedEl) ? addedEl.GetInt32() : 0;
                var hasLunar = body.TryGetProperty("hasLunarData", out var lunarEl) && lunarEl.GetBoolean();
                importMsg = hasLunar
                    ? $"{Fa.Digits(added)} تعطیل رسمی برای سال {Fa.Digits(vmYear)} وارد شد."
                    : $"{Fa.Digits(added)} تعطیل ثابت وارد شد — تعطیلات قمری این سال در کاتالوگ نیست؛ دستی اضافه کنید.";
                Toast.Success("تعطیلات رسمی وارد شد.");
                await LoadYear();
                await LoadHolidays();
            }
            else
            {
                importMsg = "واردکردن تعطیلات ممکن نشد (دسترسی کافی نیست؟).";
                importError = true;
            }
        }
        catch (Exception ex) { importMsg = ex.Message; importError = true; }
        importing = false;
    }

    private async Task AddHoliday()
    {
        if (!newHolDate.HasValue || string.IsNullOrWhiteSpace(newHolName)) return;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/Attendance/official-holidays", new { holidayDate = newHolDate, name = newHolName.Trim() });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("تعطیل رسمی افزوده شد.");
                newHolDate = null;
                newHolName = "";
                await LoadYear();
                await LoadHolidays();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                var msg = "افزودن ممکن نشد.";
                try { using var doc = System.Text.Json.JsonDocument.Parse(body); if (doc.RootElement.TryGetProperty("message", out var m)) msg = m.GetString() ?? msg; } catch { }
                Toast.Error(msg);
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteHoliday(HolRow h)
    {
        try
        {
            var url = h.IsOfficial ? $"/api/Attendance/official-holidays/{h.Id}" : $"/api/LeaveRequests/holidays/{h.Id}";
            var resp = await Http.DeleteAsync(url);
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("تعطیلی حذف شد.");
                await LoadYear();
                await LoadHolidays();
            }
            else Toast.Error("حذف ممکن نشد (دسترسی کافی نیست؟)");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

