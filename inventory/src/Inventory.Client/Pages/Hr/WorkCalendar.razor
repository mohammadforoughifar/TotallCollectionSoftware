@page "/work-calendar"
@namespace Inventory.Client.Pages
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>تقویم کاری</PageTitle>

<div class="page-head mb-4">
    <h1><i class="bi bi-calendar2-week"></i> تقویم کاری</h1>
    <div class="lead">نمای <b>سالانه (۱۲ ماه)</b> با <b>تعطیلات رسمی کشور</b>، روزهای کاری/تعطیل، ساعت شروع و پایان (با پشتیبانی شیفت شب)، اضافه‌کاری و <b>تنظیمات</b> (ساعت پیش‌فرض، روزهای تعطیل هفته و...). ورود/خروج پرسنل دقیقاً بر اساس همین تقویم ارزیابی می‌شود.</div>
</div>

@if (!Auth.Has("Attendance.SelfCheckin") && !Auth.Has("Attendance.ManageShifts") && !Auth.IsAdmin)
{
    <div class="alert alert-warning">دسترسی به تقویم کاری برای شما فعال نیست.</div>
}
else
{
    var canManage = Auth.Has("Attendance.ManageShifts") || Auth.IsAdmin;

    <div class="wc-card card border-0 shadow-sm">
        <div class="card-header bg-white">
            <div class="d-flex flex-wrap justify-content-between align-items-center gap-2">
                <div class="d-flex align-items-center gap-2">
                    <span class="fw-800 fs-5"><i class="bi bi-calendar3 text-primary"></i> سال @Fa.Digits(vmYear)</span>
                    <div class="btn-group btn-group-sm">
                        <button class="btn btn-outline-secondary" @onclick="PrevYear" title="سال قبل"><i class="bi bi-chevron-right"></i></button>
                        <button class="btn btn-outline-secondary" @onclick="GoCurrentYear">امروز</button>
                        <button class="btn btn-outline-secondary" @onclick="NextYear" title="سال بعد"><i class="bi bi-chevron-left"></i></button>
                    </div>
                    <input type="number" class="form-control form-control-sm wc-year-input" dir="ltr" min="1300" max="1500" value="@vmYear" @onchange="JumpYear" />
                </div>
                <ul class="nav nav-pills wc-tabs">
                    <li class="nav-item"><button class="nav-link @(tab == "cal" ? "active" : "")" @onclick='() => SetTab("cal")'><i class="bi bi-grid-3x3-gap me-1"></i> تقویم سال</button></li>
                    <li class="nav-item"><button class="nav-link @(tab == "hol" ? "active" : "")" @onclick='() => SetTab("hol")'><i class="bi bi-flag-fill me-1"></i> تعطیلات رسمی</button></li>
                    @if (canManage)
                    {
                        <li class="nav-item"><button class="nav-link @(tab == "set" ? "active" : "")" @onclick='() => SetTab("set")'><i class="bi bi-gear me-1"></i> تنظیمات</button></li>
                    }
                </ul>
            </div>
        </div>

        <div class="card-body">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else if (tab == "cal")
            {
                @* ================== تب تقویم سال ================== *@
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-2"><div class="wc-stat wc-stat-work"><span class="wc-stat-num">@Fa.Digits(summary?.TotalWorkDays ?? 0)</span><span class="wc-stat-lbl">روز کاری</span></div></div>
                    <div class="col-6 col-md-2"><div class="wc-stat"><span class="wc-stat-num">@Num(summary?.TotalWorkHours ?? 0)</span><span class="wc-stat-lbl">ساعت کاری سال</span></div></div>
                    <div class="col-6 col-md-2"><div class="wc-stat wc-stat-official"><span class="wc-stat-num">@Fa.Digits(summary?.TotalOfficialHolidays ?? 0)</span><span class="wc-stat-lbl">تعطیل رسمی</span></div></div>
                    <div class="col-6 col-md-2"><div class="wc-stat wc-stat-company"><span class="wc-stat-num">@Fa.Digits(summary?.TotalCompanyHolidays ?? 0)</span><span class="wc-stat-lbl">تعطیلی شرکتی</span></div></div>
                    <div class="col-6 col-md-2"><div class="wc-stat wc-stat-rest"><span class="wc-stat-num">@Fa.Digits(summary?.TotalRestDays ?? 0)</span><span class="wc-stat-lbl">روز تعطیل هفته</span></div></div>
                    <div class="col-6 col-md-2"><div class="wc-stat wc-stat-custom"><span class="wc-stat-num">@Fa.Digits(summary?.TotalCustomDays ?? 0)</span><span class="wc-stat-lbl">قانون سفارشی</span></div></div>
                </div>

                @if (summary is not null && !summary.HasLunarCatalog)
                {
                    <div class="alert alert-light border small d-flex align-items-center gap-2 py-2">
                        <i class="bi bi-info-circle text-warning"></i>
                        <span>برای سال @Fa.Digits(vmYear) تعطیلات قمری در کاتالوگ موجود نیست (تقویم رسمی آن هنوز ابلاغ نشده)؛ فقط تعطیلات ثابت (نوروز و...) از تب «تعطیلات رسمی» وارد می‌شود و موارد قمری را می‌توانید دستی اضافه کنید.</span>
                    </div>
                }

                @if (!canManage)
                {
                    <div class="alert alert-light border small py-2"><i class="bi bi-eye me-1"></i> نمای فقط-خواندنی — برای ویرایش تقویم، دسترسی «مدیریت شیفت» لازم است.</div>
                }

                @if (canManage)
                {
                    <div class="wc-bulk">
                        <div class="wc-bulk-item">
                            <label class="form-label small fw-800 mb-1">اعمال ساعت به همه‌ی روزهای کاری سال</label>
                            <div class="d-flex gap-1 align-items-center" dir="ltr">
                                <input type="time" class="form-control form-control-sm wc-bulk-time" value="@bulkStart" @onchange='e => bulkStart = e.Value?.ToString()' />
                                <span class="text-muted">-</span>
                                <input type="time" class="form-control form-control-sm wc-bulk-time" value="@bulkEnd" @onchange='e => bulkEnd = e.Value?.ToString()' />
                                <button class="btn btn-sm btn-outline-primary" @onclick="ApplyHoursToYear"><i class="bi bi-calendar2-check me-1"></i> اعمال</button>
                            </div>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button class="btn btn-sm btn-outline-secondary" @onclick="MarkRestDaysOff"><i class="bi bi-cupstraw me-1"></i> تعطیل‌کردن روزهای تعطیل هفته</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="CopyPrevYear"><i class="bi bi-calendar-plus me-1"></i> کپی از سال قبل</button>
                            <button class="btn btn-sm btn-outline-danger" @onclick="ResetYear"><i class="bi bi-eraser me-1"></i> پاک‌کردن قوانین سال</button>
                        </div>
                    </div>
                }

                <div class="wc-layout @(sel != null ? "with-editor" : "")">
                    <div class="wc-year-grid">
                        @foreach (var mo in months)
                        {
                            <div class="wc-month">
                                <div class="wc-month-head">
                                    <b>@mo.MonthName</b>
                                    <span class="wc-month-stats">@Fa.Digits(mo.WorkDays) روز کاری • @Num(mo.WorkHours) ساعت</span>
                                </div>
                                <div class="wc-week-header">
                                    @foreach (var w in WeekHeads)
                                    {
                                        <span>@w</span>
                                    }
                                </div>
                                <div class="wc-days">
                                    @for (int i = 0; i < mo.FirstDayColumn; i++)
                                    {
                                        <span></span>
                                    }
                                    @foreach (var day in mo.Days)
                                    {
                                        <button type="button" class="wc-day @DayClass(day)" title="@DayTitle(day)" @onclick='() => SelectDay(day)'>@Fa.Digits(day.DayNumber)</button>
                                    }
                                </div>
                            </div>
                        }
                    </div>

                    @if (sel != null && sel is not null)
                    {
                        var day = sel;
                        <div class="wc-editor">
                            <div class="wc-editor-card">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <b class="small"><i class="bi bi-pencil-square text-primary"></i> @Fa.Digits(vmYear)/@Fa.Digits(day.MonthOf)/@Fa.Digits(day.DayNumber) — @PersianDate.DayName(day.Date)</b>
                                    <button class="btn btn-sm btn-light" @onclick='() => sel = null' title="بستن"><i class="bi bi-x-lg"></i></button>
                                </div>

                                @if (!string.IsNullOrEmpty(day.HolidayName))
                                {
                                    <div class="alert alert-danger py-1 px-2 small mb-2">
                                        <i class="bi bi-flag-fill me-1"></i> @(day.IsOfficial ? "تعطیل رسمی:" : "تعطیلی شرکتی:") @day.HolidayName
                                        <div class="text-muted" style="font-size:.7rem">تعریف قانون سفارشی برای این روز، تعطیلی را برای ارزیابی حضور بازنویسی می‌کند.</div>
                                    </div>
                                }

                                @if (canManage)
                                {
                                    <div class="mb-2">
                                        <span class="wc-flabel">وضعیت روز</span>
                                        <div class="wc-seg2">
                                            <button type="button" class="wc-segbtn @(day.IsWorkday ? "on" : "")" @onclick='() => SetWorkday(day, true)'><i class="bi bi-briefcase me-1"></i>روز کاری</button>
                                            <button type="button" class="wc-segbtn wc-segbtn-off @(day.IsWorkday ? "" : "on")" @onclick='() => SetWorkday(day, false)'><i class="bi bi-cupstraw me-1"></i>تعطیل</button>
                                        </div>
                                    </div>

                                    @if (day.IsWorkday)
                                    {
                                        var night = IsNight(day.StartText, day.EndText);
                                        <div class="mb-2">
                                            <span class="wc-flabel">ساعت کاری <i class="bi @(night ? "bi-moon-stars-fill text-night" : "bi-clock")"></i></span>
                                            <div class="wc-times" dir="ltr">
                                                <input type="time" class="form-control form-control-sm" value="@day.StartText" @onchange='e => { day.StartText = e.Value?.ToString(); MarkDirty(); }' />
                                                <span class="wc-dash">تا</span>
                                                <input type="time" class="form-control form-control-sm" value="@day.EndText" @onchange='e => { day.EndText = e.Value?.ToString(); MarkDirty(); }' />
                                            </div>
                                            @if (night)
                                            {
                                                <div class="wc-night-hint"><i class="bi bi-moon-stars"></i> شیفت شب — عبور از نیمه‌شب ✓</div>
                                            }
                                        </div>
                                    }

                                    <div class="mb-2">
                                        <span class="wc-flabel">اضافه‌کاری</span>
                                        <select class="form-select form-select-sm" value="@day.OtMode" @onchange='e => { day.OtMode = int.Parse(e.Value?.ToString() ?? "0"); MarkDirty(); }'>
                                            <option value="0">بدون</option>
                                            <option value="1">بازه زمانی (از-تا)</option>
                                            <option value="2">کلِ روز اضافه‌کار</option>
                                            <option value="3">سقف ساعتی</option>
                                        </select>
                                        @if (day.OtMode == 1)
                                        {
                                            <div class="wc-times mt-1" dir="ltr">
                                                <input type="time" class="form-control form-control-sm" value="@day.OtStartText" @onchange='e => { day.OtStartText = e.Value?.ToString(); MarkDirty(); }' />
                                                <span class="wc-dash">تا</span>
                                                <input type="time" class="form-control form-control-sm" value="@day.OtEndText" @onchange='e => { day.OtEndText = e.Value?.ToString(); MarkDirty(); }' />
                                            </div>
                                        }
                                        else if (day.OtMode == 2)
                                        {
                                            <div class="wc-ot-hint mt-1">همه‌ی حضور این روز = اضافه‌کاری</div>
                                        }
                                        else if (day.OtMode == 3)
                                        {
                                            <div class="d-flex align-items-center gap-2 mt-1">
                                                <input type="number" min="0" max="24" step="0.5" class="form-control form-control-sm wc-hours" dir="ltr" value="@day.OvertimeText" @onchange='e => { day.OvertimeText = e.Value?.ToString(); MarkDirty(); }' placeholder="0" />
                                                <span class="small text-muted">ساعت</span>
                                            </div>
                                        }
                                    </div>

                                    <div class="mb-2">
                                        <span class="wc-flabel">یادداشت</span>
                                        <input type="text" class="form-control form-control-sm" value="@day.Note" @onchange='e => { day.Note = e.Value?.ToString(); MarkDirty(); }' placeholder="مثلاً: ایام عزاداری، نوبت‌گیری..." />
                                    </div>

                                    @if (day.HasRule)
                                    {
                                        <button class="btn btn-sm btn-outline-secondary w-100" @onclick='() => ResetDay(day)'>
                                            <i class="bi bi-arrow-counterclockwise me-1"></i> حذف قانون سفارشی (بازگشت به پیش‌فرض/تعطیلی)
                                        </button>
                                    }
                                    <div class="small text-muted mt-2">پس از تغییرات، دکمه‌ی «ذخیره‌ی تقویم سال» را بزنید.</div>
                                }
                                else
                                {
                                    <ul class="small text-muted ps-3 mb-0">
                                        <li>وضعیت: <b>@(day.IsWorkday ? "روز کاری" : "تعطیل")</b></li>
                                        @if (day.IsWorkday)
                                        {
                                            <li>ساعت: @Fa.Digits(day.StartText) تا @Fa.Digits(day.EndText)</li>
                                        }
                                        <li>منبع: @SourceText(day)</li>
                                    </ul>
                                }
                            </div>
                        </div>
                    }
                </div>

                <div class="wc-legend d-flex flex-wrap gap-3 mt-3 small text-muted">
                    <span><span class="wc-dot wc-dot-work"></span> روز کاری</span>
                    <span><span class="wc-dot wc-dot-rest"></span> تعطیل هفته (جمعه و...)</span>
                    <span><span class="wc-dot wc-dot-official"></span> تعطیل رسمی</span>
                    <span><span class="wc-dot wc-dot-company"></span> تعطیلی شرکتی</span>
                    <span><span class="wc-dot wc-dot-custom"></span> قانون سفارشی</span>
                    <span><span class="wc-dot wc-dot-today"></span> امروز</span>
                </div>

                @if (canManage)
                {
                    <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mt-3">
                        @if (saveMsg != "")
                        {
                            <span class="small @(saveError ? "text-danger" : "text-success")"><i class="bi @(saveError ? "bi-exclamation-triangle" : "bi-check-circle")"></i> @saveMsg</span>
                        }
                        <button class="btn btn-primary rounded-pill px-4 fw-800" @onclick="SaveYear" disabled="@saving">
                            @if (saving)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span> <span>در حال ذخیره…</span>
                            }
                            else
                            {
                                <i class="bi bi-save me-1"></i> <span>ذخیره‌ی تقویم سال @Fa.Digits(vmYear)@(dirty ? " (تغییرات ذخیره‌نشده)" : "")</span>
                            }
                        </button>
                    </div>
                }

                <div class="wc-logic mt-4">
                    <button type="button" class="wc-logic-toggle" @onclick='() => showLogic = !showLogic'>
                        <i class="bi @(showLogic ? "bi-chevron-up" : "bi-lightbulb")"></i>
                        <b>منطق ارزیابی — قاعده‌ی هر روز از کجا تعیین می‌شود؟</b>
                    </button>
                    @if (showLogic)
                    {
                        <div class="wc-logic-body">
                            <div class="logic-card">
                                <div class="logic-title"><i class="bi bi-list-ol"></i> اولویت قواعد هر روز</div>
                                <ol class="logic-list">
                                    <li><b>قانون سفارشی همین تقویم</b> — روزهایی که از ویرایشگر روز تغییر داده‌اید؛ بالاترین اولویت.</li>
                                    <li><b>تعطیل رسمی کشور</b> — تعطیلات رسمی (نوروز، عید فطر، ۲۲ بهمن و...) از تب «تعطیلات رسمی»؛ اگر در تنظیمات «اعمال خودکار» خاموش باشد نادیده گرفته می‌شود.</li>
                                    <li><b>تعطیلی شرکتی</b> — تعطیلی خاص مجموعه از پنل مرخصی.</li>
                                    <li><b>شیفت کاربر</b> — ساعت شروع/پایان از شیفت شخص (روزهای تعطیل هفته از تنظیمات).</li>
                                    <li><b>پیش‌فرض تنظیمات</b> — ساعت پیش‌فرض و روزهای تعطیل هفته از تب «تنظیمات».</li>
                                </ol>
                            </div>
                            <div class="logic-card">
                                <div class="logic-title"><i class="bi bi-cupstraw"></i> روزهای تعطیل و اضافه‌کاری</div>
                                <ul class="logic-list">
                                    <li>تعطیلِ بدون اضافه‌کاری: هر تردد = تردد غیرمجاز.</li>
                                    <li>بازه زمانی اضافه‌کاری: تردد داخل بازه = اضافه‌کاری (حتی عبور از نیمه‌شب).</li>
                                    <li>کلِ روز اضافه‌کار: همه‌ی حضور = اضافه‌کاری (برای روز کاری یعنی تاخیر/کسری حساب نمی‌شود).</li>
                                    <li>سقف ساعتی: تا سقف تعیین‌شده اضافه‌کاری مجاز است.</li>
                                    <li><b>شیفت شب:</b> اگر پایان قبل از شروع باشد (مثلاً ۲۲:۰۰ تا ۰۶:۰۰) شیفت از نیمه‌شب عبور می‌کند و کامل محاسبه می‌شود.</li>
                                </ul>
                            </div>
                        </div>
                    }
                </div>
            }
            else if (tab == "hol")
            {
                @* ================== تب تعطیلات رسمی ================== *@
                <div class="row g-3">
                    <div class="col-lg-5">
                        <div class="wc-panel">
                            <div class="fw-800 mb-2"><i class="bi bi-cloud-download text-primary"></i> دریافت از کاتالوگ تعطیلات</div>
                            <p class="small text-muted mb-2">
                                تعطیلات رسمی کشور برای سال @Fa.Digits(vmYear) به‌صورت گروهی وارد می‌شود:
                                تعطیلات ثابت (نوروز، ۱۲ فروردین، ۱۴ و ۱۵ خرداد، ۲۲ بهمن، ۲۹ اسفند و...) همیشه، و
                                تعطیلات قمری (عید فطر، قربان، غدیر، محرم، فاطمیه و...) برای سال‌های دارای داده (۱۴۰۴ و ۱۴۰۵).
                                تاریخ‌های ازقبل‌ثبت‌شده رد می‌شوند.
                            </p>
                            @if (canManage)
                            {
                                <div class="form-check form-switch small mb-2">
                                    <input class="form-check-input" type="checkbox" id="holReplace" @bind="holReplace" />
                                    <label class="form-check-label" for="holReplace">جایگزینی تعطیلات رسمی قبلیِ این سال (به‌روزرسانی)</label>
                                </div>
                                <button class="btn btn-sm btn-primary" @onclick="ImportHolidays" disabled="@importing">
                                    @if (importing)
                                    {
                                        <span class="spinner-border spinner-border-sm me-1"></span>
                                    }
                                    <i class="bi bi-magic me-1"></i> واردکردن تعطیلات رسمی سال @Fa.Digits(vmYear)
                                </button>
                            }
                            else
                            {
                                <div class="small text-muted">برای واردکردن تعطیلات، دسترسی مدیریت لازم است.</div>
                            }
                            @if (importMsg != "")
                            {
                                <div class="alert @(importError ? "alert-danger" : "alert-success") py-1 px-2 small mt-2 mb-0">@importMsg</div>
                            }
                        </div>

                        @if (canManage)
                        {
                            <div class="wc-panel mt-3">
                                <div class="fw-800 mb-2"><i class="bi bi-plus-circle text-primary"></i> افزودن تعطیل رسمی دستی</div>
                                <div class="small text-muted mb-2">مثلاً تعطیلات قمریِ سال‌های بدون کاتالوگ یا تعطیلی محلی.</div>
                                <label class="wc-flabel">تاریخ (شمسی)</label>
                                <DatePicker Value="@newHolDate" ValueChanged="v => newHolDate = v" CssClass="mb-2" />
                                <label class="wc-flabel">عنوان</label>
                                <input type="text" class="form-control form-control-sm mb-2" @bind="newHolName" placeholder="مثلاً: عید سعید فطر" />
                                <button class="btn btn-sm btn-outline-primary" @onclick="AddHoliday" disabled="@(!newHolDate.HasValue || string.IsNullOrWhiteSpace(newHolName))">
                                    <i class="bi bi-check2 me-1"></i> افزودن
                                </button>
                            </div>
                        }
                    </div>

                    <div class="col-lg-7">
                        <div class="wc-panel">
                            <div class="fw-800 mb-2"><i class="bi bi-list-ul text-primary"></i> تعطیلات سال @Fa.Digits(vmYear)</div>
                            @if (holidayRows.Count == 0)
                            {
                                <div class="text-muted small py-3 text-center">برای این سال تعطیلی ثبت نشده — از کاتالوگ وارد کنید.</div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table table-sm table-hover align-middle wc-hol-table">
                                        <thead><tr><th>تاریخ</th><th>عنوان</th><th>نوع</th><th>روز هفته</th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var h in holidayRows)
                                            {
                                                <tr>
                                                    <td class="text-nowrap">@Fa.Digits(PersianDate.ToShort(h.Date))</td>
                                                    <td>@h.Name <span class="small text-muted">(@h.CreatedByName)</span></td>
                                                    <td>
                                                        @if (h.IsOfficial)
                                                        {
                                                            <span class="wc-chip wc-chip-hol">رسمی</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="wc-chip wc-chip-company">شرکتی</span>
                                                        }
                                                    </td>
                                                    <td class="small text-muted">@PersianDate.DayName(h.Date)</td>
                                                    <td class="text-nowrap">
                                                        @if (canManage && h.IsOfficial)
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger py-0" @onclick='() => DeleteHoliday(h)' title="حذف"><i class="bi bi-trash"></i></button>
                                                        }
                                                        else if (Auth.Has("LeaveRequests.Approve") && !h.IsOfficial)
                                                        {
                                                            <button class="btn btn-sm btn-outline-danger py-0" @onclick='() => DeleteHoliday(h)' title="حذف تعطیلی شرکتی"><i class="bi bi-trash"></i></button>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                        <div class="small text-muted mt-2">
                            <i class="bi bi-info-circle"></i> تعطیلات رسمی به‌طور خودکار در ارزیابی حضور اعمال می‌شوند (روز تعطیل = بدون کسری) مگر در تنظیمات خاموش شوند.
                            تعطیلی شرکتی هم از «پنل مدیریت مرخصی» قابل ثبت است.
                        </div>
                    </div>
                </div>
            }
            else if (tab == "set")
            {
                @* ================== تب تنظیمات ================== *@
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="wc-panel h-100">
                            <div class="fw-800 mb-3"><i class="bi bi-clock-history text-primary"></i> ساعت کاری پیش‌فرض</div>
                            <div class="row g-2 mb-2">
                                <div class="col-6">
                                    <label class="wc-flabel">شروع</label>
                                    <input type="time" class="form-control form-control-sm" dir="ltr" value="@set.DefaultStart" @onchange='e => set.DefaultStart = e.Value?.ToString() ?? "08:00"' />
                                </div>
                                <div class="col-6">
                                    <label class="wc-flabel">پایان</label>
                                    <input type="time" class="form-control form-control-sm" dir="ltr" value="@set.DefaultEnd" @onchange='e => set.DefaultEnd = e.Value?.ToString() ?? "16:30"' />
                                </div>
                            </div>
                            <div class="small text-muted mb-3">اگر پایان قبل از شروع باشد یعنی شیفت شب (عبور از نیمه‌شب). این ساعت مبنای روزهای کاریِ بدون قانون سفارشی است.</div>
                            <label class="wc-flabel">تاخیر مجاز (دقیقه)</label>
                            <input type="number" class="form-control form-control-sm" dir="ltr" min="0" max="240" value="@set.GraceMinutes" @onchange='e => { if (e.Value is string s && int.TryParse(s, out var v)) set.GraceMinutes = Math.Clamp(v, 0, 240); }' style="width:120px" />
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="wc-panel h-100">
                            <div class="fw-800 mb-3"><i class="bi bi-calendar-x text-primary"></i> روزهای تعطیل هفته</div>
                            <div class="d-flex flex-wrap gap-2 mb-2">
                                @foreach (var wd in WeekDayFlags)
                                {
                                    var on = (set.RestDayFlags & wd.Flags) != 0;
                                    <button type="button" class="wc-wd-chip @(on ? "on" : "")" @onclick='() => ToggleRestDay(wd.Flags)'>@wd.Name</button>
                                }
                            </div>
                            <div class="small text-muted">این روزها به‌عنوان تعطیل (بدون کسری) ارزیابی می‌شوند — مثلاً «جمعه» یا «پنجشنبه و جمعه».</div>
                            <hr />
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="applyOfficial" @bind="set.ApplyOfficialHolidays" />
                                <label class="form-check-label small" for="applyOfficial"><b>اعمال خودکار تعطیلات رسمی کشور</b></label>
                            </div>
                            <div class="small text-muted mt-1">با خاموش‌کردن آن، تعطیلات رسمی در تقویم نمایش داده می‌شوند ولی روز کاری حساب می‌شوند (برای مجموعه‌هایی که تعطیلات رسمی ندارند).</div>
                        </div>
                    </div>
                    <div class="col-12 d-flex justify-content-end align-items-center gap-3">
                        @if (saveMsg != "")
                        {
                            <span class="small @(saveError ? "text-danger" : "text-success")"><i class="bi @(saveError ? "bi-exclamation-triangle" : "bi-check-circle")"></i> @saveMsg</span>
                        }
                        <button class="btn btn-primary rounded-pill px-4 fw-800" @onclick="SaveSettings" disabled="@savingSet">
                            @if (savingSet)
                            {
                                <span class="spinner-border spinner-border-sm me-1"></span>
                            }
                            else
                            {
                                <i class="bi bi-save me-1"></i>
                            }
                            ذخیره‌ی تنظیمات
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
}

