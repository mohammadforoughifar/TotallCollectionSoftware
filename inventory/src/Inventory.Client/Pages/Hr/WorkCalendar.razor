        try
        {
            var resp = await Http.PutAsJsonAsync("/api/Attendance/calendar-settings", new
            {
                defaultStart = set.DefaultStart,
                defaultEnd = set.DefaultEnd,
                graceMinutes = set.GraceMinutes,
