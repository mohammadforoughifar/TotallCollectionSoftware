@code {
    private string tab = "requests";
    private StatsInfo? stats;
    private List<LeaveItem> all = new();

    // ---------- تعطیلات شرکتی ----------
    private List<HolidayItem> holidays = new();
    private bool holLoading, holBusy;
    private DateTime? holDate = DateTime.Today;
    private string? holName;

    // ---------- ثبت به‌جای کاربر ----------
    private bool showOnBehalf, obBusy;
    private int obUserId;
    private string obType = "Hourly";
    private DateTime? obStart = DateTime.Today;
    private DateTime? obEnd = DateTime.Today;
    private string? obStartTime = "08:00";
    private string? obEndTime = "10:00";
    private string? obDestination;
    private string? obReason;
    private string obError = "";
    private bool allLoading = true;
    private string allStatus = "Pending";
    private int filterUserId; // 0 = همه

    private bool canApprove;
    private bool canReport;

    private ReportInfo? report;
    private int reportJy, reportJm;
    private bool exporting;

    // مودال رد
    private bool ShowReject;
    private LeaveItem? rejectTarget;
    private string rejectNote = "";
    private string rejectError = "";
    private bool rejectBusy;

    /// <summary>گزینه‌های فیلتر نیرو — از لیست درخواست‌ها استخراج می‌شود</summary>
    private List<UserOption> UserOptions { get; set; } = new();

    private string apiBase = "";

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        canApprove = Auth.Has("LeaveRequests.Approve");
        canReport  = Auth.Has("LeaveRequests.Report");

        // کاربر فقط گزارش می‌بیند → تب پیش‌فرض «گزارش»
        if (!canApprove) tab = "report";

        (reportJy, reportJm, _) = PersianDate.FromGregorian(DateTime.Now);
        if (canApprove) { await LoadStats(); await LoadAll(); await LoadHolidays(); }
        if (canReport)  { await LoadReport(); }

        // ================== اتصال بلادرنگ SignalR — اعلام خودکار درخواست جدید / تایید / رد ==================
        Rt.DataChanged += OnRtDataChanged;
        await Rt.EnsureStartedAsync(apiBase, Auth.UserId);
    }

    /// <summary>هر پیام datachanged با اسکوپ leaverequests → آمار، لیست درخواست‌ها و گزارش زنده رفرش می‌شوند.</summary>
    private async void OnRtDataChanged(string scope)
    {
        if (scope != "leaverequests") return;
        await InvokeAsync(async () =>
        {
            await LoadStats();
            await LoadAll();
            await LoadHolidays();
            if (tab == "report") await LoadReport();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        Rt.DataChanged -= OnRtDataChanged;
    }

    // ---------- تعطیلات شرکتی ----------
    private async Task LoadHolidays()
    {
        holLoading = true;
        try { holidays = await Http.GetFromJsonAsync<List<HolidayItem>>("/api/LeaveRequests/holidays") ?? new(); }
        catch { holidays = new(); }
        holLoading = false;
    }

    private async Task AddHoliday()
    {
        if (holDate == null) { Toast.Error("تاریخ تعطیلی را انتخاب کنید."); return; }
        holBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/LeaveRequests/holidays", new { HolidayDate = holDate.Value.Date, Name = holName });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("تعطیلی شرکتی ثبت شد؛ برای کل پرسنل اعمال می‌شود.");
                holName = null;
                await LoadHolidays();
            }
            else Toast.Error(await ExtractError(resp));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        holBusy = false;
    }

    private async Task DeleteHoliday(int id)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "این تعطیلی حذف شود؟");
        if (!ok) return;
        try
        {
            var resp = await Http.DeleteAsync($"/api/LeaveRequests/holidays/{id}");
            if (resp.IsSuccessStatusCode) { Toast.Success("تعطیلی حذف شد."); await LoadHolidays(); }
            else Toast.Error(await ExtractError(resp));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---------- ثبت به‌جای کاربر ----------
    private void OpenOnBehalf()
    {
        obUserId = 0;
        obType = "Hourly";
        obStart = DateTime.Today;
        obEnd = DateTime.Today;
        obStartTime = "08:00";
        obEndTime = "10:00";
        obDestination = null;
        obReason = null;
        obError = "";
        showOnBehalf = true;
    }

    private async Task SubmitOnBehalf()
    {
        obError = "";
        if (obUserId <= 0) { obError = "کاربر را انتخاب کنید."; return; }
        if (obStart == null) { obError = "تاریخ شروع را انتخاب کنید."; return; }
        if (obType == "Daily")
        {
            if (obEnd == null || obEnd.Value.Date < obStart.Value.Date) { obError = "تاریخ پایان معتبر نیست."; return; }
        }
        else
        {
            if (!TimeSpan.TryParse(obStartTime, out var st) || !TimeSpan.TryParse(obEndTime, out var en))
            { obError = "ساعت شروع/پایان را درست وارد کنید."; return; }
            if (en <= st) { obError = "ساعت پایان باید بعد از ساعت شروع باشد."; return; }
            if ((en - st).TotalHours > 8) { obError = "بازه نمی‌تواند بیش از ۸ ساعت باشد."; return; }
            if (obType == "HourlyMission" && string.IsNullOrWhiteSpace(obDestination)) { obError = "مقصد ماموریت را وارد کنید."; return; }
        }
        obBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/LeaveRequests/on-behalf", new
            {
                UserId = obUserId,
                Type = obType,
                StartDate = obStart.Value.Date,
                EndDate = obType == "Daily" ? obEnd!.Value.Date : obStart.Value.Date,
                StartTime = obType == "Daily" ? null : obStartTime,
                EndTime = obType == "Daily" ? null : obEndTime,
                Destination = obType == "HourlyMission" ? obDestination : null,
                Reason = obReason
            });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("درخواست توسط مدیر ثبت و تایید شد.");
                showOnBehalf = false;
                await LoadAll();
                await LoadStats();
            }
            else obError = await ExtractError(resp);
        }
        catch (Exception ex) { obError = ex.Message; }
        obBusy = false;
    }

    // ---------- مدل‌ها ----------
    public class StatsInfo { public int Total { get; set; } public int Pending { get; set; } public int Approved { get; set; } public int Rejected { get; set; } }

    public class UserOption { public int Id { get; set; } public string Name { get; set; } = ""; }

    public class LeaveItem
    {
        public int Id { get; set; }
        public string Number { get; set; } = "";
        public string Type { get; set; } = "";
        public int RequesterUserId { get; set; }
        public string RequesterName { get; set; } = "";
        public DateTime StartDate { get; set; }
        public DateTime EndDate { get; set; }
        public TimeSpan? StartTime { get; set; }
        public TimeSpan? EndTime { get; set; }
        public double Days { get; set; }
        public double Hours { get; set; }
        public string? Destination { get; set; }
        public string? Reason { get; set; }
        public string Status { get; set; } = "";
        public string? ApprovedByName { get; set; }
        public DateTime? ApprovedAt { get; set; }
        public string? ApproveNote { get; set; }
        public bool AdminCreated { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class HolidayItem
    {
        public int Id { get; set; }
        public DateTime HolidayDate { get; set; }
        public string Name { get; set; } = "";
        public string? CreatedByName { get; set; }
        public DateTime CreatedAt { get; set; }
    }

    public class ReportRow
    {
        public int UserId { get; set; }
        public string Name { get; set; } = "";
        public string? Role { get; set; }
        public double DailyDays { get; set; }
        public double HourlyHours { get; set; }
        public double TotalQuotaDays { get; set; }
        public double MissionDays { get; set; }
        public int MissionCount { get; set; }
        public double Quota { get; set; } = 2;
        public double Remaining { get; set; }
        public int PendingCount { get; set; }
        public double YearlyUsed { get; set; }
        public double YearlyRemaining { get; set; }
        public string StatusFa { get; set; } = "";
    }

    public class ReportInfo
    {
        public int Year { get; set; }
        public int Month { get; set; }
        public string MonthName { get; set; } = "";
        public double Quota { get; set; } = 2;
        public List<ReportRow> Rows { get; set; } = new();
        public double TotalUsed { get; set; }
        public int TotalMissions { get; set; }
    }

    // ---------- بارگذاری ----------
    private async Task LoadStats()
    {
        try { stats = await Http.GetFromJsonAsync<StatsInfo>("/api/LeaveRequests/stats"); }
        catch { stats = null; }
    }

    private async Task LoadAll()
    {
        allLoading = true;
        try
        {
            all = await Http.GetFromJsonAsync<List<LeaveItem>>($"/api/LeaveRequests?status={allStatus}") ?? new();
            if (filterUserId > 0) all = all.Where(x => x.RequesterUserId == filterUserId).ToList();
            RebuildUserOptions();
        }
        catch { all = new(); }
        allLoading = false;
    }

    private void RebuildUserOptions()
    {
        var opts = all
            .GroupBy(x => x.RequesterUserId)
            .Select(g => new UserOption { Id = g.Key, Name = g.First().RequesterName })
            .OrderBy(o => o.Name)
            .ToList();
        // اگر فیلتر فعال است گزینه‌ی آن نیرو حتماً باشد
        if (filterUserId > 0 && opts.All(o => o.Id != filterUserId))
            opts.Insert(0, new UserOption { Id = filterUserId, Name = all.FirstOrDefault(x => x.RequesterUserId == filterUserId)?.RequesterName ?? "نیرو" });
        UserOptions = opts;
    }

    private async Task LoadReport()
    {
        try { report = await Http.GetFromJsonAsync<ReportInfo>($"/api/LeaveRequests/report/{reportJy}/{reportJm}"); }
        catch { report = null; }
    }

    // ---------- تایید / رد ----------
    private async Task ApproveRequest(int id)
    {
        try
        {
            var resp = await Http.PostAsync($"/api/LeaveRequests/{id}/approve", null);
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("درخواست تایید شد.");
                await LoadStats(); await LoadAll();
                if (tab == "report") await LoadReport();
            }
            else Toast.Error(await ExtractError(resp));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void OpenReject(LeaveItem r)
    {
        rejectTarget = r; rejectNote = ""; rejectError = ""; ShowReject = true;
    }

    private void CloseReject() { ShowReject = false; rejectTarget = null; rejectNote = ""; }

    private async Task ConfirmReject()
    {
        if (rejectTarget == null) return;
        rejectBusy = true; rejectError = "";
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/LeaveRequests/{rejectTarget.Id}/reject", new { Note = rejectNote });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("درخواست رد شد.");
                CloseReject();
                await LoadStats(); await LoadAll();
                if (tab == "report") await LoadReport();
            }
            else rejectError = await ExtractError(resp);
        }
        catch (Exception ex) { rejectError = ex.Message; }
        rejectBusy = false;
    }

    // ---------- خروجی CSV ----------
    private async Task ExportCsv()
    {
        if (report == null) return;
        exporting = true;
        try
        {
            var sb = new System.Text.StringBuilder();
            sb.AppendLine("Name;Role;DailyDays;HourlyHours;MonthUsed;MonthRemain;YearUsed;YearRemain;MissionCount;PendingCount;Status");
            foreach (var r in report.Rows)
            {
                sb.AppendLine($"{CsvCell(r.Name)};{CsvCell(r.Role ?? "")};{r.DailyDays.ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
                              $"{r.HourlyHours};{r.TotalQuotaDays.ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
                              $"{r.Remaining.ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
                              $"{r.YearlyUsed.ToString(System.Globalization.CultureInfo.InvariantCulture)};" +
                              $"{r.YearlyRemaining.ToString(System.Globalization.CultureInfo.InvariantCulture)};{r.MissionCount};" +
                              $"{r.PendingCount};{CsvCell(r.StatusFa)}");
            }
            var bytes = System.Text.Encoding.UTF8.GetBytes("\uFEFF" + sb.ToString()); // BOM برای اکسل
            await JS.InvokeVoidAsync("saveAsFile", $"leave-report-{reportJy}-{reportJm}.csv", Convert.ToBase64String(bytes));
            Toast.Success("گزارش دانلود شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        exporting = false;
    }

    private static string CsvCell(string v) => "\"" + v.Replace("\"", "\"\"") + "\"";

    // ---------- کمک‌ها ----------
    private async Task<string> ExtractError(HttpResponseMessage resp)
    {
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m)) return m.GetString() ?? "";
        }
        catch { }
        return $"سرور درخواست را نپذیرفت (کد {(int)resp.StatusCode}).";
    }

    private Microsoft.AspNetCore.Components.MarkupString TypeBadge(string type) => type switch
    {
        "Hourly" => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-badge-hourly\"><i class=\"bi bi-clock\"></i> مرخصی ساعتی</span>"),
        "HourlyMission" => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-badge-hourlymission\"><i class=\"bi bi-clipboard2-check\"></i> ماموریت ساعتی</span>"),
        "Mission" => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-badge-mission\"><i class=\"bi bi-plane\"></i> ماموریت</span>"),
        _ => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-badge-daily\"><i class=\"bi bi-calendar2-check\"></i> روزانه</span>")
    };

    private Microsoft.AspNetCore.Components.MarkupString StatusBadge(string status) => status switch
    {
        "Approved" => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-st-approved\"><i class=\"bi bi-check-circle\"></i> تاییدشده</span>"),
        "Rejected" => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-st-rejected\"><i class=\"bi bi-x-circle\"></i> ردشده</span>"),
        _ => new Microsoft.AspNetCore.Components.MarkupString("<span class=\"badge lv-st-pending\"><i class=\"bi bi-hourglass-split\"></i> در انتظار</span>")
    };

    private static string BarColor(int pct) => pct >= 100 ? "#e0245e" : pct >= 75 ? "#f4a23c" : "#2ec47e";

    private static string D0(double v) => v == (long)v ? Fa.Digits((long)v) : Fa.Digits((decimal)Math.Round(v, 1));

    private string AmountText(LeaveItem r) =>
        r.Type is "Hourly" or "HourlyMission" ? $"{D0(r.Hours)} ساعت" :
        $"{D0(r.Days)} روز";
}
