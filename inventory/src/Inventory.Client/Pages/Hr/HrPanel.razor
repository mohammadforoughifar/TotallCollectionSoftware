@namespace Inventory.Client.Pages
@page "/hr-admin"
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS
@inject RealtimeService Rt
@implements IDisposable

<PageTitle>پنل مدیریت منابع انسانی</PageTitle>

@if (!Auth.Has("LeaveRequests.Approve") && !Auth.Has("LeaveRequests.Report"))
{
    <div class="text-center py-5">
        <i class="bi bi-shield-lock fs-1 text-danger d-block mb-3"></i>
        <h4>دسترسی ندارید</h4>
        <p class="text-muted">این پنل مخصوص مدیر منابع انسانی است. درخواست‌های خود را از کارتابل «مرخصی و ماموریت» پیگیری کنید.</p>
        <a class="btn btn-primary rounded-pill px-4" href="leave"><i class="bi bi-arrow-right me-1"></i> کارتابل من</a>
    </div>
    return;
}

@* ================== وضعیت دسترسی ================== *@
@{
    canApprove = Auth.Has("LeaveRequests.Approve");
    canReport  = Auth.Has("LeaveRequests.Report");
    if (!canApprove && tab != "report") { tab = "report"; }
}

<div class="page-head mb-4">
    <h1><i class="bi bi-people-fill"></i> پنل مدیریت منابع انسانی</h1>
    <div class="lead">تایید / رد درخواست‌های همه‌ی نیروها + گزارش ماهانه — مدیر منابع انسانی</div>
</div>

@* ================== کارت‌های آمار ================== *@
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm hr-stat h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="hr-stat-icon" style="background:#fff3e6;color:#b06a00"><i class="bi bi-hourglass-split"></i></div>
                <div>
                    <div class="hr-stat-num">@Fa.Digits(stats?.Pending ?? 0)</div>
                    <div class="hr-stat-lbl">در انتظار تایید</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm hr-stat h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="hr-stat-icon" style="background:#e6f9ef;color:#0e8a55"><i class="bi bi-check2-circle"></i></div>
                <div>
                    <div class="hr-stat-num">@Fa.Digits(stats?.Approved ?? 0)</div>
                    <div class="hr-stat-lbl">تاییدشده</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm hr-stat h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="hr-stat-icon" style="background:#fdecef;color:#b21b4c"><i class="bi bi-x-circle"></i></div>
                <div>
                    <div class="hr-stat-num">@Fa.Digits(stats?.Rejected ?? 0)</div>
                    <div class="hr-stat-lbl">ردشده</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-6 col-lg-3">
        <div class="card border-0 shadow-sm hr-stat h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="hr-stat-icon" style="background:#eef0f7;color:#1c2130"><i class="bi bi-collection"></i></div>
                <div>
                    <div class="hr-stat-num">@Fa.Digits(stats?.Total ?? 0)</div>
                    <div class="hr-stat-lbl">کل درخواست‌ها</div>
                </div>
            </div>
        </div>
    </div>
</div>

@* ================== تب‌ها ================== *@
<div class="lv-tabs d-flex gap-2 mb-3 flex-wrap">
    @if (canApprove)
    {
        <button class="lv-tab @(tab == "requests" ? "active" : "")" @onclick='() => tab = "requests"'>
            <i class="bi bi-inbox-fill"></i> درخواست‌های همه‌ی نیروها
            @if (stats?.Pending > 0) { <span class="lv-tab-badge">@Fa.Digits(stats.Pending)</span> }
        </button>
    }
    @if (canReport)
    {
        <button class="lv-tab @(tab == "report" ? "active" : "")" @onclick='() => tab = "report"'>
            <i class="bi bi-bar-chart-fill"></i> گزارش ماهانه‌ی همه‌ی کاربران
        </button>
    }
</div>

@* ================== درخواست‌های همه‌ی نیروها ================== *@
@if (tab == "requests")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <b><i class="bi bi-inbox-fill text-primary"></i> درخواست‌های همه‌ی نیروها</b>
            <div class="d-flex gap-2 flex-wrap align-items-center">
                @if (canApprove)
                {
                    <button class="btn btn-sm btn-primary rounded-pill" @onclick="OpenOnBehalf">
                        <i class="bi bi-person-plus-fill me-1"></i> ثبت به‌جای کاربر
                    </button>
                }
                <select class="form-select form-select-sm" style="width:auto" @bind="allStatus" @bind:after="LoadAll">
                    <option value="Pending">در انتظار</option>
                    <option value="Approved">تاییدشده</option>
                    <option value="Rejected">ردشده</option>
                    <option value="All">همه</option>
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="filterUserId" @bind:after="LoadAll">
                    <option value="0">همه‌ی نیروها</option>
                    @foreach (var u in UserOptions)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </div>
        </div>
        <div class="card-body p-0">
            @if (allLoading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
            }
            else if (all.Count == 0)
            {
                <div class="text-center text-muted py-5"><i class="bi bi-inbox fs-1 d-block mb-2"></i>درخواستی با این فیلتر نیست.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle lv-table mb-0">
                        <thead class="lv-thead">
                            <tr>
                                <th>شماره</th><th>نیرو</th><th>نوع</th><th>بازه</th><th>میزان</th><th>دلیل / مقصد</th><th>وضعیت</th><th>اقدام</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in all)
                            {
                                <tr class="@(r.Status == "Pending" ? "lv-pending-row" : "")">
                                    <td class="lv-num" dir="ltr">@r.Number</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <UserAvatar LoginUserId="r.RequesterUserId" Size="30" />
                                            <span class="fw-700">@r.RequesterName</span>
                                        </div>
                                    </td>
                                    <td>
                                        @TypeBadge(r.Type)
                                        @if (r.AdminCreated)
                                        {
                                            <div class="small mt-1"><span class="badge lv-badge-admin" title="این درخواست توسط مدیر به‌جای کاربر ثبت و مستقیم تایید شد"><i class="bi bi-shield-check"></i> توسط مدیر</span></div>
                                        }
                                    </td>
                                    <td class="lv-date">
                                        @if (r.Type is "Hourly" or "HourlyMission")
                                        {
                                            <span>@PersianDate.ToShort(r.StartDate)</span>
                                            @if (r.StartTime.HasValue && r.EndTime.HasValue)
                                            { <div dir="ltr" class="lv-time-range">@r.StartTime.HHMM() ← @r.EndTime.HHMM()</div> }
                                        }
                                        else
                                        { <span>@PersianDate.ToShort(r.StartDate) ← @PersianDate.ToShort(r.EndDate)</span> }
                                        @if (r.Type is "Mission" or "HourlyMission" && !string.IsNullOrWhiteSpace(r.Destination))
                                        { <div class="small text-muted"><i class="bi bi-geo-alt"></i> @(r.Destination)</div> }
                                    </td>
                                    <td class="fw-800">@AmountText(r)</td>
                                    <td class="lv-reason">@(r.Type == "Mission" ? "—" : (r.Reason ?? "—"))</td>
                                    <td>@StatusBadge(r.Status)</td>
                                    <td>
                                        @if (r.Status == "Pending" && canApprove)
                                        {
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-success lv-act" title="تایید" @onclick="() => ApproveRequest(r.Id)"><i class="bi bi-check-lg"></i></button>
                                                <button class="btn btn-sm btn-outline-danger lv-act" title="رد" @onclick="() => OpenReject(r)"><i class="bi bi-x-lg"></i></button>
                                            </div>
                                        }
                                        else if (r.Status == "Pending")
                                        {
                                            <span class="small text-muted"><i class="bi bi-hourglass-split text-warning"></i> در انتظار</span>
                                        }
                                        else
                                        {
                                            <span class="small text-muted">
                                                @r.ApprovedByName
                                                @if (!string.IsNullOrWhiteSpace(r.ApproveNote))
                                                { <div class="text-danger small">«@r.ApproveNote»</div> }
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ================== تعطیلات شرکتی (اعمال گروهی برای کل پرسنل) ================== *@
@if (tab == "requests")
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <b><i class="bi bi-calendar-x text-primary"></i> تعطیلات شرکتی <span class="small text-muted fw-normal">(اعمال می‌شود برای کل پرسنل)</span></b>
        </div>
        <div class="card-body">
            @if (canApprove)
            {
                <div class="row g-2 mb-3 align-items-end">
                    <div class="col-4 col-md-3">
                        <label class="form-label small fw-800">تاریخ تعطیلی</label>
                        <DatePicker Value="holDate" ValueChanged="v => holDate = v" CssClass="form-control-sm" />
                    </div>
                    <div class="col-6 col-md-4">
                        <label class="form-label small fw-800">عنوان / دلیل</label>
                        <input class="form-control form-control-sm" @bind="holName" placeholder="مثلاً: ایام عزاداری / نشست سازمانی" />
                    </div>
                    <div class="col-2">
                        <button class="btn btn-sm btn-primary w-100" @onclick="AddHoliday" disabled="@holBusy">
                            @if (holBusy)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                                <span>در حال ثبت…</span>
                            }
                            else
                            {
                                <i class="bi bi-plus-circle me-1"></i>
                                <span>افزودن</span>
                            }
                        </button>
                    </div>
                </div>
            }
            @if (holLoading)
            {
                <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
            }
            else if (holidays.Count == 0)
            {
                <div class="text-center text-muted py-2 small">تعطیلی شرکتی ثبت نشده است.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle lv-table mb-0">
                        <thead class="lv-thead">
                            <tr><th>تاریخ</th><th>روز</th><th>عنوان</th><th>ثبت‌کننده</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var h in holidays)
                            {
                                <tr>
                                    <td class="fw-bold" dir="ltr">@PersianDate.ToShort(h.HolidayDate)</td>
                                    <td>@PersianDate.WeekdayName(h.HolidayDate)</td>
                                    <td>@h.Name</td>
                                    <td class="small text-muted">@h.CreatedByName</td>
                                    <td>
                                        @if (canApprove)
                                        {
                                            <button class="btn btn-sm btn-outline-danger lv-act" title="حذف" @onclick="() => DeleteHoliday(h.Id)"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

@* ================== مودال ثبت به‌جای کاربر ================== *@
<Modal Visible="showOnBehalf" Title="ثبت مرخصی/ماموریت به‌جای کاربر (توسط مدیر)" OnClose="() => showOnBehalf = false">
    @if (!string.IsNullOrEmpty(obError))
    {
        <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle-fill"></i> @obError</div>
    }
    <div class="row g-2">
        <div class="col-12">
            <label class="form-label small fw-800">کاربر <span class="text-danger">*</span></label>
            <select class="form-select form-select-sm" @bind="obUserId">
                <option value="0">انتخاب کنید…</option>
                @foreach (var u in UserOptions)
                {
                    <option value="@u.Id">@u.Name</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label class="form-label small fw-800">نوع درخواست</label>
            <div class="d-flex gap-2 flex-wrap">
                <div class="lv-type-sm @(obType == "Hourly" ? "active" : "")" @onclick='() => obType = "Hourly"'><i class="bi bi-clock-history"></i> مرخصی ساعتی</div>
                <div class="lv-type-sm @(obType == "HourlyMission" ? "active" : "")" @onclick='() => obType = "HourlyMission"'><i class="bi bi-clipboard2-check"></i> ماموریت ساعتی</div>
                <div class="lv-type-sm @(obType == "Daily" ? "active" : "")" @onclick='() => obType = "Daily"'><i class="bi bi-calendar2-check"></i> مرخصی روزانه</div>
            </div>
        </div>
        <div class="col-4 col-md-3">
            <label class="form-label small fw-800">تاریخ شروع</label>
            <DatePicker Value="obStart" ValueChanged="v => obStart = v" CssClass="form-control-sm" />
        </div>
        @if (obType == "Daily")
        {
            <div class="col-4 col-md-3">
                <label class="form-label small fw-800">تاریخ پایان</label>
                <DatePicker Value="obEnd" ValueChanged="v => obEnd = v" CssClass="form-control-sm" />
            </div>
        }
        else
        {
            <div class="col-4 col-md-3">
                <label class="form-label small fw-800">ساعت شروع</label>
                <input type="time" class="form-control form-control-sm" dir="ltr" value="@obStartTime" @onchange='e => obStartTime = e.Value?.ToString()' />
            </div>
            <div class="col-4 col-md-3">
                <label class="form-label small fw-800">ساعت پایان</label>
                <input type="time" class="form-control form-control-sm" dir="ltr" value="@obEndTime" @onchange='e => obEndTime = e.Value?.ToString()' />
            </div>
        }
        @if (obType == "HourlyMission")
        {
            <div class="col-12">
                <label class="form-label small fw-800">مقصد <span class="text-danger">*</span></label>
                <input class="form-control form-control-sm" @bind="obDestination" placeholder="مثلاً: تهران" />
            </div>
        }
        <div class="col-12">
            <label class="form-label small fw-800">توضیح (اختیاری)</label>
            <input class="form-control form-control-sm" @bind="obReason" placeholder="مثلاً: هماهنگی با مدیریت" />
        </div>
        <div class="col-12 small text-muted">
            <i class="bi bi-info-circle"></i> درخواست مستقیماً با وضعیت «تاییدشده» و علامت «توسط مدیر» ثبت می‌شود و کسریِ روزهای مربوطه بازحساب می‌شود.
        </div>
    </div>
    <div class="d-flex justify-content-end mt-3 gap-2">
        <button class="btn btn-sm btn-light" @onclick="() => showOnBehalf = false">انصراف</button>
        <button class="btn btn-sm btn-primary" @onclick="SubmitOnBehalf" disabled="@obBusy">
            @if (obBusy)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <span>در حال ثبت…</span>
            }
            else
            {
                <i class="bi bi-check2-circle me-1"></i>
                <span>ثبت و تایید</span>
            }
        </button>
    </div>
</Modal>

@* ================== گزارش ماهانه ================== *@
@if (tab == "report")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <b><i class="bi bi-bar-chart-fill text-primary"></i> گزارش مصرف مرخصی همه‌ی کاربران — @if (report != null) { <span>@report.MonthName @Fa.Digits(report.Year)</span> }</b>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width:auto" @bind="reportJm" @bind:after="LoadReport">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@PersianDate.MonthName(m)</option>
                    }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportJy" @bind:after="LoadReport">
                    @for (int y = reportJy - 2; y <= reportJy + 1; y++)
                    {
                        <option value="@y">@Fa.Digits(y)</option>
                    }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportCsv" disabled="@(report == null || exporting)">
                    @if (exporting) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    <i class="bi bi-download me-1"></i> خروجی CSV
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            @if (report == null)
            {
                <div class="text-center text-muted py-5"><div class="spinner-border text-primary"></div></div>
            }
            else
            {
                @if (report.Rows.All(r => r.TotalQuotaDays == 0 && r.MissionCount == 0))
                {
                    <div class="text-center text-muted py-5">
                        <i class="bi bi-calendar-x fs-1 d-block mb-2"></i>
                        در این ماه مرخصی یا ماموریتی ثبت نشده است.
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle lv-table mb-0">
                            <thead class="lv-thead">
                                <tr>
                                    <th>نیرو</th>
                                    <th>روزانه</th>
                                    <th>ساعتی</th>
                                    <th>مصرف ماه</th>
                                    <th>مانده ماه</th>
                                    <th>مصرف سالانه</th>
                                    <th>مانده سالانه (از @Fa.Digits(24))</th>
                                    <th>ماموریت</th>
                                    <th>در انتظار</th>
                                    <th>وضعیت</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in report.Rows.Where(r => r.TotalQuotaDays > 0 || r.MissionCount > 0 || r.PendingCount > 0))
                                {
                                    var pct = Math.Min(100, (int)Math.Round(r.TotalQuotaDays / Math.Max(0.01, report.Quota) * 100));
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-2">
                                                <UserAvatar LoginUserId="r.UserId" Size="30" />
                                                <span class="fw-700">@r.Name</span>
                                            </div>
                                        </td>
                                        <td class="num">@D0(r.DailyDays) @if (r.DailyDays > 0) { <span class="small text-muted">روز</span> }</td>
                                        <td class="num">@if (r.HourlyHours > 0) { <span>@D0(r.HourlyHours) <span class="small text-muted">ساعت</span></span> } else { <span class="text-muted">—</span> }</td>
                                        <td class="fw-800 num">@D0(r.TotalQuotaDays)</td>
                                        <td class="num @(r.Remaining < 0 ? "text-danger fw-700" : "text-success")">@D0(r.Remaining)</td>
                                        <td class="num">@D0(r.YearlyUsed)</td>
                                        <td class="num @(r.YearlyRemaining < 0 ? "text-danger fw-700" : "text-success")">@D0(r.YearlyRemaining)</td>
                                        <td class="num">@if (r.MissionCount > 0) { <span>@Fa.Digits(r.MissionCount) <span class="small text-muted">سفر</span></span> } else { <span class="text-muted">—</span> }</td>
                                        <td class="num">@if (r.PendingCount > 0) { <span class="badge bg-warning text-dark">@Fa.Digits(r.PendingCount)</span> } else { <span class="text-muted">—</span> }</td>
                                        <td><span class="badge @(r.YearlyRemaining < 0 ? "bg-danger" : r.TotalQuotaDays > report.Quota ? "bg-warning text-dark" : r.PendingCount > 0 ? "bg-info text-dark" : "bg-success-subtle text-success border")">@r.StatusFa</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="lv-report-summary d-flex gap-4 flex-wrap px-3 py-2 small">
                        <span><i class="bi bi-people text-primary"></i> مجموع مصرف ماه: <b class="num">@D0(report.TotalUsed)</b> روز</span>
                        <span><i class="bi bi-plane text-info"></i> مجموع ماموریت: <b class="num">@Fa.Digits(report.TotalMissions)</b> سفر</span>
                    </div>
                }
            }
        </div>
    </div>
}

@* ================== مودال رد درخواست ================== *@
@if (ShowReject)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.55)" @onclick="CloseReject">
        <div class="modal-dialog modal-dialog-centered" @onclick="() => { }" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-x-circle text-danger"></i> رد درخواست @if (rejectTarget != null) { <span dir="ltr">@rejectTarget.Number</span> }</h5>
                    <button type="button" class="btn-close" @onclick="CloseReject"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label small fw-800">دلیل رد (اختیاری)</label>
                    <textarea class="form-control form-control-sm" rows="2" @bind="rejectNote" placeholder="مثلاً: بیش از موجودی مرخصی دارید…"></textarea>
                    @if (!string.IsNullOrEmpty(rejectError))
                    {
                        <div class="alert alert-danger py-2 mt-2">@rejectError</div>
                    }
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseReject">انصراف</button>
                    <button class="btn btn-danger rounded-pill px-4 fw-800" @onclick="ConfirmReject" disabled="@rejectBusy">
                        @if (rejectBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        else { <i class="bi bi-x-circle-fill me-1"></i> }
                        تأیید رد درخواست
                    </button>
                </div>
            </div>
        </div>
    </div>
}

