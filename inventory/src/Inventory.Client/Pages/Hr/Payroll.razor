    private int expRunId;
    private async Task DownloadExp(string kind, string fmt)
    {
        var ext = fmt;
        var name = kind == "insurance" ? $"Bimeh_{expRunId}.{ext}" : kind == "tax" ? $"Tax_{expRunId}.{ext}" : $"Bank_{expRunId}.{ext}";
        await Download($"exports/{kind}?runId={expRunId}&format={fmt}", name);
    }
    private async Task Download(string url, string fileName)
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync("/api/hr-pay/" + url);
            await JS.InvokeVoidAsync("saveAsFile", fileName, Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

