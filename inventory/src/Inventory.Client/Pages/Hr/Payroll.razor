@code {
    private bool canRead => Auth.Has("HrPay.Read") || Auth.Has("HrPay.Manage") || Auth.IsAdmin;
    private bool isMgr => Auth.Has("HrPay.Manage") || Auth.IsAdmin;

    private string tab = "myfish";
    private bool busy;
    private async Task SetTab(string t) { tab = t; await LoadTab(); }
    private async Task GotoSlips(int runId) { slipRunId = runId; await SetTab("slips"); }
    private async Task LoadTab()
    {
        if (tab == "myfish") await LoadMySlips();
        else if (tab == "runs") await LoadRuns();
        else if (tab == "slips") { if (runs.Count == 0) await LoadRuns(); if (slipRunId == 0 && runs.Count > 0) slipRunId = runs[0].Id; await LoadSlips(); }
        else if (tab == "items") await LoadItems();
        else if (tab == "loans") { await EnsureEmployees(); await LoadLoans(); await LoadArrears(); }
        else if (tab == "profiles") { await EnsureEmployees(); await LoadProfiles(); await LoadEmpItems(); }
        else if (tab == "tax") { await LoadBrackets(); await LoadRules(); }
        else if (tab == "settle") { await EnsureEmployees(); await LoadSettlements(); }
        else if (tab == "exports") { if (runs.Count == 0) await LoadRuns(); if (expRunId == 0 && runs.Count > 0) expRunId = runs[0].Id; }
    }
    protected override async Task OnInitializedAsync() => await LoadMySlips();

    private static string RunFa(string s) => s switch { "Draft" => "پیش‌نویس", "Approved" => "تأییدشده", "Locked" => "قفل", _ => s };
    private static string RunCls(string s) => s switch { "Approved" => "bg-info text-dark", "Locked" => "bg-success", _ => "bg-secondary" };
    private static string CatFa(string c) => c switch { "Hokmi" => "حکمی", "Mazaya" => "مزایا", "Kosoor" => "کسور", _ => "سایر" };
    private static string LoanFa(string s) => s switch { "Active" => "فعال", "Paid" => "تسویه", "Cancelled" => "ابطال", "Pending" => "در انتظار", "Applied" => "اعمال‌شده", _ => s };
    private static string SettleFa(string s) => s switch { "Draft" => "پیش‌نویس", "Approved" => "تأییدشده", "Paid" => "پرداخت‌شده", _ => s };
    private static string PayRuleTitle(string k) => k switch
    {
        "pay.min_wage" => "حداقل مزد ماهانه (ریال)", "pay.bon" => "بن کارگری (ریال)", "pay.maskan" => "حق مسکن (ریال)", "pay.eyab" => "ایاب پیش‌فرض (ریال)",
        "pay.ins.employee" => "بیمه کارگر ٪", "pay.ins.employer" => "بیمه کارفرما ٪", "pay.ins.unemployment" => "بیمه بیکاری ٪", "pay.ins.ceiling" => "سقف بیمه (ریال)",
        "pay.workshop.code" => "کد کارگاه", "pay.workshop.name" => "نام کارگاه", "pay.variance.pct" => "آستانه مغایرت ٪",
        "pay.acc.salaryExpense" => "کد حساب هزینه حقوق", "pay.acc.insuranceExpense" => "کد حساب هزینه بیمه کارفرما",
        "pay.acc.accrualExpense" => "کد حساب هزینه ذخیره سنوات", "pay.acc.payable" => "کد حساب حقوق پرداختنی",
        "pay.acc.taxPayable" => "کد حساب مالیات پرداختنی", "pay.acc.insurancePayable" => "کد حساب بیمه پرداختنی",
        "pay.acc.accrualPayable" => "کد حساب ذخیره سنوات", "pay.acc.otherDed" => "کد حساب سایر کسورات",
        _ => k
    };

    private async Task<string?> Err(System.Net.Http.HttpResponseMessage r)
    {
        try
        {
            var d = await r.Content.ReadFromJsonAsync<Dictionary<string, object>>();
            if (d != null && d.TryGetValue("message", out var m)) return m?.ToString();
        }
        catch { }
        return $"خطا: {(int)r.StatusCode}";
    }

    private List<EmpDto> employees = new();
    private async Task EnsureEmployees()
    {
        if (!canRead || employees.Count > 0) return;
        try { employees = await Http.GetFromJsonAsync<List<EmpDto>>("/api/hr-pay/employees") ?? new(); } catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private string EmpName(int id) => employees.FirstOrDefault(e => e.Id == id) is { } e ? $"{e.FirstName} {e.LastName}" : $"#{id}";

    private List<MySlipDto> mySlips = new();
    private async Task LoadMySlips()
    {
        try { mySlips = await Http.GetFromJsonAsync<List<MySlipDto>>("/api/hr-pay/slips/my") ?? new(); } catch { }
    }

    private List<RunDto> runs = new();
    private int newYear = 1405; private int newMonth = 6;
    private async Task LoadRuns()
    {
        try { runs = await Http.GetFromJsonAsync<List<RunDto>>("/api/hr-pay/runs") ?? new(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task CreateRun()
    {
        busy = true;
        try
        {
            var r = await Http.PostAsJsonAsync("/api/hr-pay/runs", new { year = newYear, month = newMonth });
            if (r.IsSuccessStatusCode) { Toast.Success("دوره ساخته شد."); await LoadRuns(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private async Task CalcRun(int id)
    {
        busy = true;
        try
        {
            var r = await Http.PostAsync($"/api/hr-pay/runs/{id}/calculate", null);
            if (r.IsSuccessStatusCode) { Toast.Success("محاسبه انجام شد."); await LoadRuns(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private async Task RunStatus(int id, string st)
    {
        var r = await Http.PostAsJsonAsync($"/api/hr-pay/runs/{id}/status", new { status = st });
        if (r.IsSuccessStatusCode) { Toast.Success("ثبت شد."); await LoadRuns(); }
        else Toast.Error(await Err(r) ?? "خطا");
    }
    private async Task IssueVoucher(int id)
    {
        busy = true;
        try
        {
            var r = await Http.PostAsync($"/api/hr-pay/runs/{id}/voucher", null);
            if (r.IsSuccessStatusCode) { Toast.Success("سند صادر شد."); await LoadRuns(); }
            else Toast.Error(await Err(r) ?? "خطا");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        busy = false;
    }
    private bool showCompare; private List<CompareDto> compare = new();
    private async Task OpenCompare(RunDto r)
    {
        try
        {
            compare = await Http.GetFromJsonAsync<List<CompareDto>>($"/api/hr-pay/runs/{r.Id}/compare") ?? new();
            showCompare = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private List<SlipDto> slips = new();
    private int slipRunId;
    private async Task LoadSlips()
    {
        if (slipRunId == 0) return;
        try { slips = await Http.GetFromJsonAsync<List<SlipDto>>($"/api/hr-pay/runs/{slipRunId}/slips") ?? new(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private bool showSlip; private SlipDetailDto? slipDetail;
    private async Task OpenSlip(int id)
    {
        try
        {
            slipDetail = await Http.GetFromJsonAsync<SlipDetailDto>($"/api/hr-pay/slips/{id}");
            showSlip = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task PrintSlip()
    {
        if (slipDetail == null) return;
        var s = slipDetail.Slip;
        var sb = new System.Text.StringBuilder();
        sb.Append($"<h3>فیش حقوقی {slipDetail.RunYear}/{slipDetail.RunMonth:D2}</h3><h4>{s.EmployeeName}</h4>");
        sb.Append($"<p>روزکرد: {s.DaysPaid:0.##} — پایه حکم: {s.BaseAmount:N0} ریال</p>");
        sb.Append("<table><tr><th>شرح</th><th>مبلغ (ریال)</th></tr>");
        foreach (var l in slipDetail.Lines.Where(x => x.Kind == "Earning"))
            sb.Append($"<tr><td>{l.Title}</td><td>{l.Amount:N0}</td></tr>");
        sb.Append($"<tr><td><b>جمع حقوق و مزایا</b></td><td><b>{s.GrossEarnings:N0}</b></td></tr>");
        foreach (var l in slipDetail.Lines.Where(x => x.Kind == "Deduction"))
            sb.Append($"<tr><td>{l.Title}</td><td>{l.Amount:N0}</td></tr>");
        sb.Append($"<tr><td><b>خالص پرداختی</b></td><td><b>{s.NetPay:N0}</b></td></tr></table>");
        sb.Append($"<p>مالیات: {s.TaxAmount:N0} — بیمه کارگر: {s.InsuranceAmount:N0} — بیمه کارفرما: {s.EmployerInsurance:N0}</p>");
        await JS.InvokeVoidAsync("printHtml", "فیش حقوقی", sb.ToString());
    }

    private List<ItemDto> items = new();
    private async Task LoadItems()
    {
        try { items = await Http.GetFromJsonAsync<List<ItemDto>>("/api/hr-pay/items") ?? new(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private bool showItem; private int itId; private string itCode = ""; private string itTitle = "";
    private string itKind = "Earning"; private string itCat = "Mazaya"; private string? itFormula;
    private decimal itAmount; private bool itTax = true; private bool itIns = true; private bool itAcc; private int itSort = 50;
    private string? testResult;
    private void OpenItem(ItemDto? it)
    {
        itId = it?.Id ?? 0; itCode = it?.Code ?? ""; itTitle = it?.Title ?? "";
        itKind = it?.Kind ?? "Earning"; itCat = it?.Category ?? "Mazaya"; itFormula = it?.Formula;
        itAmount = it?.DefaultAmount ?? 0; itTax = it?.IsTaxable ?? true; itIns = it?.IsInsuranceable ?? true;
        itAcc = it?.IsAccrual ?? false; itSort = it?.SortOrder ?? 50; testResult = null;
        showItem = true;
    }
    private async Task TestItemFormula()
    {
        var r = await Http.PostAsJsonAsync("/api/hr-pay/items/test", new { formula = itFormula ?? "" });
        testResult = r.IsSuccessStatusCode
            ? "نتیجه نمونه: " + ((await r.Content.ReadFromJsonAsync<Dictionary<string, object>>())?["value"]?.ToString() ?? "?")
            : await Err(r);
    }
    private async Task SubmitItem()
    {
        busy = true;
        try
        {
            var body = new { code = itCode, title = itTitle, kind = itKind, category = itCat, formula = itFormula, defaultAmount = itAmount, isTaxable = itTax, isInsuranceable = itIns, isAccrual = itAcc, isActive = true, sortOrder = itSort };
            System.Net.Http.HttpResponseMessage r = itId == 0
                ? await Http.PostAsJsonAsync("/api/hr-pay/items", body)
                : await Http.PutAsJsonAsync($"/api/hr-pay/items/{itId}", body);
            if (r.IsSuccessStatusCode) { Toast.Success("ذخیره شد."); showItem = false; await LoadItems(); }
