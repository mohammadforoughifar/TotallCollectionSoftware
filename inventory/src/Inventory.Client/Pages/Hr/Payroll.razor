@page "/payroll"
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>حقوق و دستمزد</PageTitle>

<div class="card shadow-sm mb-3" dir="rtl">
    <div class="card-header d-flex align-items-center gap-2">
        <i class="bi bi-cash-stack"></i>
        <strong>حقوق و دستمزد</strong>
    </div>
    <div class="card-body">
        <ul class="nav nav-tabs mb-3">
            <li class="nav-item"><button class="nav-link @(tab=="myfish"?"active":"")" @onclick='() => SetTab("myfish")'>فیش من</button></li>
            @if (canRead)
            {
                <li class="nav-item"><button class="nav-link @(tab=="runs"?"active":"")" @onclick='() => SetTab("runs")'>دوره‌ها</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="slips"?"active":"")" @onclick='() => SetTab("slips")'>فیش‌ها</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="items"?"active":"")" @onclick='() => SetTab("items")'>آیتم‌ها و فرمول</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="loans"?"active":"")" @onclick='() => SetTab("loans")'>وام و مساعده</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="profiles"?"active":"")" @onclick='() => SetTab("profiles")'>پروفایل</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="tax"?"active":"")" @onclick='() => SetTab("tax")'>مالیات و قوانین</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="settle"?"active":"")" @onclick='() => SetTab("settle")'>تسویه</button></li>
                <li class="nav-item"><button class="nav-link @(tab=="exports"?"active":"")" @onclick='() => SetTab("exports")'>خروجی‌ها</button></li>
            }
        </ul>

        @if (tab == "myfish")
        {
            @if (mySlips.Count == 0)
            {
                <div class="alert alert-info">فیشی برای شما ثبت نشده است.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle">
                        <thead><tr><th>دوره</th><th>ناخالص</th><th>مالیات</th><th>بیمه</th><th>سایر کسور</th><th>خالص</th><th></th></tr></thead>
                        <tbody>
                            @foreach (var s in mySlips)
                            {
                                var x = s;
                                <tr>
                                    <td>@Fa.Digits($"{x.Year}/{x.Month:D2}")</td>
                                    <td>@Fa.Digits(x.GrossEarnings.ToString("N0"))</td>
                                    <td>@Fa.Digits(x.TaxAmount.ToString("N0"))</td>
                                    <td>@Fa.Digits(x.InsuranceAmount.ToString("N0"))</td>
                                    <td>@Fa.Digits(x.OtherDeductions.ToString("N0"))</td>
                                    <td><strong>@Fa.Digits(x.NetPay.ToString("N0"))</strong></td>
                                    <td><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenSlip(x.Id)">مشاهده و چاپ</button></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (tab == "runs" && canRead)
        {
            @if (isMgr)
            {
                <div class="d-flex gap-2 mb-2 align-items-end">
                    <div><label class="form-label small">سال</label><input type="number" class="form-control form-control-sm" style="width:90px" @bind="newYear" /></div>
                    <div><label class="form-label small">ماه</label><input type="number" class="form-control form-control-sm" style="width:70px" @bind="newMonth" /></div>
                    <button class="btn btn-sm btn-primary" @onclick="CreateRun" disabled="@busy">دوره جدید</button>
                    <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="LoadRuns">به‌روزرسانی</button>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>دوره</th><th>وضعیت</th><th>فیش</th><th>ناخالص</th><th>خالص</th><th>مالیات</th><th>بیمه کارگر/کارفرما</th><th>سند</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var r in runs)
                        {
                            var x = r;
                            <tr>
                                <td>@Fa.Digits($"{x.Year}/{x.Month:D2}")</td>
                                <td><span class="badge @RunCls(x.Status)">@RunFa(x.Status)</span></td>
                                <td>@Fa.Digits(x.SlipCount.ToString())</td>
                                <td>@Fa.Digits(x.TotalGross.ToString("N0"))</td>
                                <td><strong>@Fa.Digits(x.TotalNet.ToString("N0"))</strong></td>
                                <td>@Fa.Digits(x.TotalTax.ToString("N0"))</td>
                                <td>@Fa.Digits(x.TotalInsuranceEmp.ToString("N0")) / @Fa.Digits(x.TotalInsuranceEr.ToString("N0"))</td>
                                <td>@(x.VoucherId == null ? "—" : $"#{x.VoucherId}")</td>
                                <td class="text-nowrap">
                                    <button class="btn btn-sm btn-outline-primary" @onclick="() => GotoSlips(x.Id)">فیش‌ها</button>
                                    <button class="btn btn-sm btn-outline-info" @onclick="() => OpenCompare(x)">مغایرت</button>
                                    @if (isMgr)
                                    {
                                        @if (x.Status != "Locked")
                                        {
                                            <button class="btn btn-sm btn-outline-success" @onclick="() => CalcRun(x.Id)" disabled="@busy">محاسبه</button>
                                        }
                                        @if (x.Status == "Draft")
                                        {
                                            <button class="btn btn-sm btn-outline-warning" @onclick='() => RunStatus(x.Id, "Approved")'>تأیید</button>
                                        }
                                        @if (x.Status == "Approved")
                                        {
                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => RunStatus(x.Id, "Locked")'>قفل</button>
                                        }
                                        @if (x.Status == "Locked")
                                        {
                                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => RunStatus(x.Id, "Draft")'>بازکردن</button>
                                        }
                                        @if (x.Status != "Draft" && x.VoucherId == null)
                                        {
                                            <button class="btn btn-sm btn-outline-dark" @onclick="() => IssueVoucher(x.Id)" disabled="@busy">سند</button>
                                        }
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (tab == "slips" && canRead)
        {
            <div class="d-flex gap-2 mb-2 align-items-end">
                <div>
                    <label class="form-label small">دوره</label>
                    <select class="form-select form-select-sm" @bind="slipRunId">
                        @foreach (var r in runs)
                        {
                            <option value="@r.Id">@r.Year/@r.Month:D2 (@RunFa(r.Status))</option>
                        }
                    </select>
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="LoadSlips">نمایش</button>
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>پرسنل</th><th>روزکرد</th><th>پایه</th><th>ناخالص</th><th>مالیات</th><th>بیمه</th><th>سایر</th><th>خالص</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in slips)
                        {
                            var x = s;
                            <tr>
                                <td>@x.EmployeeName</td>
                                <td>@Fa.Digits(x.DaysPaid.ToString("0.##"))</td>
                                <td>@Fa.Digits(x.BaseAmount.ToString("N0"))</td>
                                <td>@Fa.Digits(x.GrossEarnings.ToString("N0"))</td>
                                <td>@Fa.Digits(x.TaxAmount.ToString("N0"))</td>
                                <td>@Fa.Digits(x.InsuranceAmount.ToString("N0"))</td>
                                <td>@Fa.Digits(x.OtherDeductions.ToString("N0"))</td>
                                <td><strong>@Fa.Digits(x.NetPay.ToString("N0"))</strong></td>
                                <td><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenSlip(x.Id)">فیش</button></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (tab == "items" && canRead)
        {
            @if (isMgr)
            {
                <div class="d-flex gap-2 mb-2">
                    <button class="btn btn-sm btn-primary" @onclick="() => OpenItem(null)">آیتم جدید</button>
                    <span class="small text-muted">متغیرها: BASE, DAILY_WAGE, HOURLY_WAGE, MIN_WAGE, MIN_DAILY, DAYS_PAID, DAYS_WORKED, OT_H, OT_H_HOL, OT_H_NIGHT, MISSION_DAYS, LEAVE_UNPAID, CHILDREN, BON, MASKAN, EYAB, OT_COEF_N/H/NT + کد آیتم‌ها — توابع: ROUND, MIN, MAX, IF</span>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>کد</th><th>عنوان</th><th>نوع</th><th>دسته</th><th>فرمول / مبلغ</th><th>مالیات</th><th>بیمه</th><th>ذخیره</th><th>ترتیب</th>@if (isMgr){<th></th>}</tr></thead>
                    <tbody>
                        @foreach (var i in items)
                        {
                            var x = i;
                            <tr>
                                <td><code dir="ltr">@x.Code</code></td>
                                <td>@x.Title</td>
                                <td>@(x.Kind == "Earning" ? "مزایا" : "کسور")</td>
                                <td>@CatFa(x.Category)</td>
                                <td class="small" dir="ltr">@(string.IsNullOrWhiteSpace(x.Formula) ? x.DefaultAmount.ToString("N0") : x.Formula)</td>
                                <td>@(x.IsTaxable ? "✓" : "—")</td>
                                <td>@(x.IsInsuranceable ? "✓" : "—")</td>
                                <td>@(x.IsAccrual ? "✓" : "—")</td>
                                <td>@Fa.Digits(x.SortOrder.ToString())</td>
                                @if (isMgr)
                                {
                                    <td class="text-nowrap">
                                        <button class="btn btn-sm btn-outline-primary" @onclick="() => OpenItem(x)">ویرایش</button>
                                        <button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteItem(x.Id)">حذف</button>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (tab == "loans" && canRead)
        {
            <div class="row g-3">
                <div class="col-lg-6">
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <strong>وام و مساعده</strong>
                        @if (isMgr){<button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => showLoan = true">جدید</button>}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>پرسنل</th><th>نوع</th><th>مبلغ</th><th>قسط</th><th>شروع</th><th>پرداخت‌شده</th><th>وضعیت</th>@if (isMgr){<th></th>}</tr></thead>
                            <tbody>
                                @foreach (var l in loans)
                                {
                                    var x = l;
                                    <tr>
                                        <td>@x.EmployeeName</td>
                                        <td>@(x.Kind == "Advance" ? "مساعده" : "وام")</td>
                                        <td>@Fa.Digits(x.Amount.ToString("N0"))</td>
                                        <td>@Fa.Digits(x.MonthlyAmount.ToString("N0")) × @Fa.Digits(x.Installments.ToString())</td>
                                        <td>@Fa.Digits($"{x.StartYear}/{x.StartMonth}")</td>
                                        <td>@Fa.Digits(x.PaidCount.ToString())</td>
                                        <td>@LoanFa(x.Status)</td>
                                        @if (isMgr && x.Status == "Active")
                                        {
                                            <td><button class="btn btn-sm btn-outline-danger" @onclick="() => CancelLoan(x.Id)">ابطال</button></td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <strong>معوقه / علی‌الحساب (@Fa.Digits($"{aoYear}/{aoMonth}"))</strong>
                        <input type="number" class="form-control form-control-sm ms-auto" style="width:80px" @bind="aoYear" />
                        <input type="number" class="form-control form-control-sm" style="width:60px" @bind="aoMonth" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadArrears">نمایش</button>
                    </div>
                    <div class="table-responsive mb-2">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>نوع</th><th>پرسنل</th><th>مبلغ</th><th>وضعیت</th>@if (isMgr){<th></th>}</tr></thead>
                            <tbody>
                                @foreach (var a in arrears)
                                {
                                    var x = a;
                                    <tr><td>معوقه</td><td>@x.EmployeeName</td><td>@Fa.Digits(x.Amount.ToString("N0"))</td><td>@LoanFa(x.Status)</td>
                                    @if (isMgr && x.Status == "Pending"){<td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteArrear(x.Id)">حذف</button></td>}</tr>
                                }
                                @foreach (var o in onaccs)
                                {
                                    var x = o;
                                    <tr><td>علی‌الحساب</td><td>@x.EmployeeName</td><td>@Fa.Digits(x.Amount.ToString("N0"))</td><td>@LoanFa(x.Status)</td>
                                    @if (isMgr && x.Status == "Pending"){<td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteOnAcc(x.Id)">حذف</button></td>}</tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (isMgr)
                    {
                        <div class="card"><div class="card-body">
                            <div class="row g-2">
                                <div class="col-4">
                                    <label class="form-label small">نوع</label>
                                    <select class="form-select form-select-sm" @bind="aoKind"><option value="arrear">معوقه</option><option value="onacc">علی‌الحساب</option></select>
                                </div>
                                <div class="col-8">
                                    <label class="form-label small">پرسنل</label>
                                    <select class="form-select form-select-sm" @bind="aoEmp"><option value="0">—</option>@foreach (var e in employees){<option value="@e.Id">@e.FirstName @e.LastName</option>}</select>
                                </div>
                                <div class="col-6"><label class="form-label small">مبلغ</label><input type="number" class="form-control form-control-sm" @bind="aoAmount" /></div>
                                <div class="col-6"><label class="form-label small">عنوان (معوقه)</label><input class="form-control form-control-sm" @bind="aoTitle" /></div>
                                <div class="col-12"><button class="btn btn-sm btn-primary w-100" @onclick="SubmitArrear" disabled="@busy">ثبت</button></div>
                            </div>
                        </div></div>
                    }
                </div>
            </div>
        }
        else if (tab == "profiles" && canRead)
        {
            <div class="row g-3">
                <div class="col-lg-6">
                    <strong>پروفایل حقوقی</strong>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>پرسنل</th><th>اولاد</th><th>شماره بیمه</th><th>بانک/شبا</th>@if (isMgr){<th></th>}</tr></thead>
                            <tbody>
                                @foreach (var e in employees)
                                {
                                    var x = e;
                                    var p = profiles.FirstOrDefault(v => v.EmployeeId == x.Id);
                                    <tr>
                                        <td>@x.FirstName @x.LastName</td>
                                        <td>@Fa.Digits((p?.ChildrenCount ?? 0).ToString())</td>
                                        <td class="small">@(p?.InsuranceNo ?? "—")</td>
                                        <td class="small" dir="ltr">@(p?.Iban ?? "—")</td>
                                        @if (isMgr){<td><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenProfile(x.Id)">ویرایش</button></td>}
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="d-flex gap-2 mb-2 align-items-center">
                        <strong>مبالغ اختصاصی آیتم‌ها</strong>
                        @if (isMgr){<button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => showEmpItem = true">جدید</button>}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>پرسنل</th><th>آیتم</th><th>مبلغ</th>@if (isMgr){<th></th>}</tr></thead>
                            <tbody>
                                @foreach (var v in empItems)
                                {
                                    var x = v;
                                    <tr>
                                        <td>@EmpName(x.EmployeeId)</td>
                                        <td>@x.ItemTitle</td>
                                        <td>@Fa.Digits(x.Amount.ToString("N0"))</td>
                                        @if (isMgr){<td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteEmpItem(x.Id)">حذف</button></td>}
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        }
        else if (tab == "tax" && canRead)
        {
            <div class="row g-3">
                <div class="col-lg-5">
                    <div class="d-flex gap-2 mb-2 align-items-end">
                        <strong>پلکان مالیات @Fa.Digits(brYear.ToString())</strong>
                        <input type="number" class="form-control form-control-sm ms-auto" style="width:90px" @bind="brYear" />
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadBrackets">نمایش</button>
                        @if (isMgr){<button class="btn btn-sm btn-outline-primary" @onclick="() => showBracket = true">افزودن</button>}
                    </div>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>از</th><th>تا</th><th>نرخ ٪</th>@if (isMgr){<th></th>}</tr></thead>
                            <tbody>
                                @foreach (var b in brackets)
                                {
                                    var x = b;
                                    <tr>
                                        <td>@Fa.Digits(x.FromAmount.ToString("N0"))</td>
                                        <td>@(x.ToAmount <= 0 ? "∞" : Fa.Digits(x.ToAmount.ToString("N0")))</td>
                                        <td>@Fa.Digits(x.Rate.ToString("0.##"))</td>
                                        @if (isMgr){<td><button class="btn btn-sm btn-outline-danger" @onclick="() => DeleteBracket(x.Id)">حذف</button></td>}
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="alert alert-warning small">پلکان پیش‌فرض صرفاً نمونه است — حتماً مطابق قانون بودجه همان سال تنظیم شود.</div>
                </div>
                <div class="col-lg-7">
                    <strong>قوانین حقوق</strong>
                    <div class="table-responsive">
                        <table class="table table-striped table-sm align-middle">
                            <thead><tr><th>عنوان</th><th>مقدار</th></tr></thead>
                            <tbody>
                                @foreach (var k in ruleKeys)
                                {
                                    var key = k;
                                    <tr>
                                        <td>@PayRuleTitle(key)<br /><code class="small" dir="ltr">@key</code></td>
                                        <td style="max-width:200px"><input class="form-control form-control-sm" dir="ltr" @bind="ruleVals[key]" disabled="@(!isMgr)" /></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    @if (isMgr){<button class="btn btn-sm btn-primary" @onclick="SaveRules" disabled="@busy">ذخیره قوانین</button>}
                </div>
            </div>
        }
        else if (tab == "settle" && canRead)
        {
            <div class="d-flex gap-2 mb-2 align-items-center">
                <strong>تسویه خروج</strong>
                @if (isMgr){<button class="btn btn-sm btn-outline-primary ms-auto" @onclick="() => showSettle = true">محاسبه تسویه</button>}
            </div>
            <div class="table-responsive">
                <table class="table table-striped table-sm align-middle">
                    <thead><tr><th>پرسنل</th><th>تاریخ خروج</th><th>سابقه</th><th>سنوات</th><th>بازخرید مرخصی</th><th>عیدی نسبی</th><th>جمع</th><th>وضعیت</th>@if (isMgr){<th></th>}</tr></thead>
                    <tbody>
                        @foreach (var s in settlements)
                        {
                            var x = s;
                            <tr>
                                <td>@x.EmployeeName</td>
                                <td>@x.LeaveDate.ToString("yyyy/MM/dd")</td>
                                <td>@Fa.Digits(x.YearsOfService.ToString("0.##")) سال</td>
                                <td>@Fa.Digits(x.SeveranceAmount.ToString("N0"))</td>
                                <td>@Fa.Digits(x.LeaveRefund.ToString("N0"))</td>
                                <td>@Fa.Digits(x.EydiProrata.ToString("N0"))</td>
                                <td><strong>@Fa.Digits(x.TotalAmount.ToString("N0"))</strong></td>
                                <td>@SettleFa(x.Status)</td>
                                @if (isMgr)
                                {
                                    <td class="text-nowrap">
                                        @if (x.Status == "Draft"){<button class="btn btn-sm btn-outline-warning" @onclick='() => SettleStatus(x.Id, "Approved")'>تأیید</button>}
                                        @if (x.Status == "Approved"){<button class="btn btn-sm btn-outline-success" @onclick='() => SettleStatus(x.Id, "Paid")'>پرداخت شد</button>}
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else if (tab == "exports" && canRead)
        {
            <div class="d-flex gap-2 mb-3 align-items-end">
                <div>
                    <label class="form-label small">دوره</label>
                    <select class="form-select form-select-sm" @bind="expRunId">
                        @foreach (var r in runs)
                        {
                            <option value="@r.Id">@r.Year/@r.Month:D2 (@RunFa(r.Status))</option>
                        }
                    </select>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="card"><div class="card-body">
                        <h6>فایل بیمه (دیسکت)</h6>
                        <button class="btn btn-sm btn-outline-primary me-1" @onclick='() => DownloadExp("insurance", "txt")'>متنی</button>
                        <button class="btn btn-sm btn-outline-primary" @onclick='() => DownloadExp("insurance", "csv")'>CSV</button>
                    </div></div>
                </div>
                <div class="col-md-4">
                    <div class="card"><div class="card-body">
