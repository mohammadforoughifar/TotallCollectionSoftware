<Modal Visible="showSlip" Title="فیش حقوقی" Size="modal-lg" OnClose="() => showSlip = false">
    @if (slipDetail != null)
    {
        <h5 class="text-center">فیش حقوقی @Fa.Digits($"{slipDetail.RunYear}/{slipDetail.RunMonth:D2}")</h5>
        <p class="text-center">@slipDetail.Slip.EmployeeName — روزکرد: @Fa.Digits(slipDetail.Slip.DaysPaid.ToString("0.##"))</p>
        <div class="table-responsive">
            <table class="table table-bordered table-sm">
                <thead><tr><th>شرح</th><th>مبلغ (ریال)</th></tr></thead>
                <tbody>
                    @foreach (var l in slipDetail.Lines.Where(x => x.Kind == "Earning"))
                    {
                        <tr><td>@l.Title</td><td>@Fa.Digits(l.Amount.ToString("N0"))</td></tr>
                    }
                    <tr class="table-info"><td><strong>جمع حقوق و مزایا</strong></td><td><strong>@Fa.Digits(slipDetail.Slip.GrossEarnings.ToString("N0"))</strong></td></tr>
                    @foreach (var l in slipDetail.Lines.Where(x => x.Kind == "Deduction"))
                    {
                        <tr><td>@l.Title</td><td>@Fa.Digits(l.Amount.ToString("N0"))</td></tr>
                    }
                    <tr class="table-warning"><td><strong>خالص پرداختی</strong></td><td><strong>@Fa.Digits(slipDetail.Slip.NetPay.ToString("N0"))</strong></td></tr>
                </tbody>
            </table>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-sm btn-outline-dark" @onclick="PrintSlip"><i class="bi bi-printer"></i> چاپ</button>
            <button class="btn btn-sm btn-secondary" @onclick="() => showSlip = false">بستن</button>
        </div>
    }
</Modal>

<Modal Visible="showCompare" Title="مغایرت‌گیری ماهانه" Size="modal-lg" OnClose="() => showCompare = false">
    <div class="table-responsive">
        <table class="table table-striped table-sm align-middle">
