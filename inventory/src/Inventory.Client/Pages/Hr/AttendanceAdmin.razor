@namespace Inventory.Client.Pages
@page "/attendance-admin"
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject RealtimeService Rt
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>مدیریت حضور و غیاب</PageTitle>

@if (!Auth.Has("Attendance.ViewAll") && !Auth.Has("Attendance.ManageShifts") && !Auth.Has("Attendance.Report") && !Auth.IsAdmin)
{
    <div class="text-center py-5">
        <i class="bi bi-shield-lock fs-1 text-danger d-block mb-3"></i>
        <h4>دسترسی ندارید</h4>
        <a class="btn btn-primary rounded-pill px-4" href="attendance"><i class="bi bi-arrow-right me-1"></i> ورود به کارتابل من</a>
    </div>
    return;
}

<div class="page-head mb-4">
    <h1><i class="bi bi-stopwatch"></i> مدیریت حضور و غیاب</h1>
    <div class="lead">مدیریت شیفت‌ها، وضعیت امروز پرسنل و گزارش ماهانه کسری کار</div>
</div>

<!-- ===== آمار امروز ===== -->
<div class="row g-3 mb-4">
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-primary">@Fa.Digits(todayStats?.Total ?? 0)</div><div>کل پرسنل</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-success">@Fa.Digits(todayStats?.Present ?? 0)</div><div>حاضر</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-secondary">@Fa.Digits(todayStats?.Pending ?? 0)</div><div>وارد نشده</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-warning">@Fa.Digits(todayStats?.Late ?? 0)</div><div>با تاخیر</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-info">@Fa.Digits(todayStats?.OnLeave ?? 0)</div><div>مرخصی</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-danger">@Fa.Digits(todayStats?.Absent ?? 0)</div><div>غایب</div></div></div>
    </div>
</div>

<!-- ===== تب‌ها ===== -->
<div class="lv-tabs d-flex gap-2 mb-3 flex-wrap">
    <button class="lv-tab @(tab == "today" ? "active" : "")" @onclick='() => tab = "today"'><i class="bi bi-people"></i> وضعیت روز</button>
    @if (Auth.Has("Attendance.ManageShifts") || Auth.IsAdmin)
    {
        <button class="lv-tab @(tab == "shifts" ? "active" : "")" @onclick='() => tab = "shifts"'><i class="bi bi-clock-history"></i> مدیریت شیفت‌ها</button>
        <button class="lv-tab @(tab == "assign" ? "active" : "")" @onclick='() => tab = "assign"'><i class="bi bi-person-gear"></i> تخصیص شیفت</button>
    }
    <button class="lv-tab @(tab == "report" ? "active" : "")" @onclick="ShowReportTab"><i class="bi bi-journal-text"></i> گزارش روزانه</button>
    <button class="lv-tab @(tab == "monthly" ? "active" : "")" @onclick="ShowMonthlyTab"><i class="bi bi-bar-chart-fill"></i> گزارش خلاصه ماه</button>
    @if (Auth.IsAdmin || Auth.Has("Attendance.ManageShifts"))
    {
        <button class="lv-tab @(tab == "extra" ? "active" : "")" @onclick="ShowExtraTab"><i class="bi bi-hourglass-split"></i> کارتابل مازاد</button>
    }
    @if (Auth.IsAdmin || Auth.Has("Attendance.ManageShifts"))
    {
        <button class="lv-tab @(tab == "security" ? "active" : "")" @onclick="ShowSecurityTab"><i class="bi bi-shield-check"></i> امنیت حضور و غیاب</button>
    }
</div>

<!-- ==================== وضعیت امروز ==================== -->
@if (tab == "today")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b>
                <i class="bi bi-calendar2-day text-primary"></i> گزارش روزانه — @PersianDate.ToLong(dayDate)
                <span class="badge bg-light text-dark border">@PersianDate.WeekdayName(dayDate)</span>
                @if (dayDate.Date == DateTime.Today)
                {
                    <span class="badge bg-success"><i class="bi bi-dot"></i>امروز</span>
                }
            </b>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <div class="att-day-picker">
                    <DatePicker Value="dayDate" ValueChanged="OnPickDay" AllowClear="false" Placeholder="انتخاب تاریخ" />
                </div>
                <button class="btn btn-sm btn-outline-secondary" @onclick="GoToday" disabled="@(dayDate.Date == DateTime.Today)"><i class="bi bi-calendar-event me-1"></i>امروز</button>
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadToday" title="به‌روزرسانی"><i class="bi bi-arrow-clockwise"></i></button>
                <button class="btn btn-sm btn-outline-success" @onclick="ExportDayCsv" disabled="@(!todayItems.Any())"><i class="bi bi-download me-1"></i> CSV</button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(todayError))
        {
            <div class="alert alert-warning py-2 px-3 mb-0 rounded-0 border-start-0 border-end-0">
                <i class="bi bi-exclamation-triangle me-1"></i>@todayError
            </div>
        }
        @if (todayStats != null)
        {
            <div class="card-body py-2 border-bottom d-flex flex-wrap gap-2 align-items-center att-day-stats">
                <span class="badge bg-light text-dark border">کل پرسنل: <b>@Fa.Digits(todayStats.Total)</b></span>
                <span class="badge bg-success"><i class="bi bi-check2 me-1"></i>حاضر: <b>@Fa.Digits(todayStats.Present)</b></span>
                <span class="badge bg-danger"><i class="bi bi-x me-1"></i>غایب: <b>@Fa.Digits(todayStats.Absent)</b></span>
                <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i>با تاخیر: <b>@Fa.Digits(todayStats.Late)</b></span>
                <span class="badge bg-primary"><i class="bi bi-calendar2-check me-1"></i>مرخصی: <b>@Fa.Digits(todayStats.OnLeave)</b></span>
                @if (todayStats.Pending > 0)
                {
                    <span class="badge bg-secondary"><i class="bi bi-hourglass-split me-1"></i>در انتظار: <b>@Fa.Digits(todayStats.Pending)</b></span>
                }
                @if (todayStats.Holiday > 0)
                {
                    <span class="badge bg-info text-dark"><i class="bi bi-calendar-x me-1"></i>تعطیل: <b>@Fa.Digits(todayStats.Holiday)</b></span>
                }
            </div>
        }
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead>
                        <tr><th>پرسنل</th><th>شیفت</th><th>ورود</th><th>خروج</th><th>ورود/خروج</th><th>کارکرد</th><th>کسری</th><th>وضعیت</th><th>توضیح</th></tr>
                    </thead>
                    <tbody>
                        @if (todayLoading) { <tr><td colspan="9" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (!todayItems.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">@(string.IsNullOrEmpty(todayError) ? "پرسنلی ثبت نشده." : "گزارش این روز در دسترس نیست.")</td></tr> }
                        else
                        {
                            @foreach (var u in todayItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <UserAvatar LoginUserId="@u.UserId" Size="30" />
                                            <span class="fw-700">@u.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@u.ShiftName</span>
                                        @if (u.ShiftStart.HasValue) { <div class="small text-muted" dir="ltr">@FmtTime(u.ShiftStart.Value) - @FmtTime(u.ShiftEnd.Value)</div> }
                                    </td>
                                    <td dir="ltr">
                                        @if (u.EnterAt.HasValue)
                                        {
                                            <span class="fw-bold @(u.EnterStatus=="Late"?"text-danger":"text-success")">@u.EnterAt.Value.ToString("HH:mm")</span>
                                            @if (u.EnterStatus == "Late") { <span class="badge bg-danger ms-1">@Fa.Digits(u.LateMinutes) دقیقه</span> }
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td dir="ltr">@(u.ExitAt.HasValue ? u.ExitAt.Value.ToString("HH:mm") : "—")</td>
                                    <td>
                                        @if (u.InOutCount > 0) { <span class="badge bg-light text-dark border">@Fa.Digits(u.InOutCount) بار</span> }
                                        else { <span class="text-muted">—</span> }
                                        @if (u.IsInNow) { <span class="badge bg-success ms-1">در محل</span> }
                                        @if (u.UncoveredGaps > 0) { <span class="badge bg-warning ms-1" title="خروجی که با مرخصی/ماموریت ساعتی پوشش ندارد">بدون پوشش</span> }
                                    </td>
                                    <td>@WorkText(u.WorkMinutes)</td>
                                    <td>
                                        <span class="@(u.DeficitMinutes>0?"text-danger fw-700":"")">@(u.DeficitMinutes>0?WorkText(u.DeficitMinutes):"—")</span>
                                        @if (u.DeficitMinutes > 0 && CanSendDeficitLetter && u.UserId != Auth.UserId)
                                        {
                                            @if (deficitSent.Contains(DeficitKey(u.UserId, dayDate)))
                                            {
                                                <button class="btn btn-sm btn-outline-success py-0 px-1 ms-1" title="نامه کسری کار برای این نفر در همین نشست ارسال شده است" disabled>
                                                    <i class="bi bi-envelope-check"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-danger py-0 px-1 ms-1" title="ارسال نامه کسری کار به @(u.FullName)" @onclick="() => OpenDeficitLetter(new DeficitLetterTarget(u.UserId, u.FullName, dayDate, u.DeficitMinutes, u.LateMinutes, u.EnterAt))">
                                                    <i class="bi bi-envelope-exclamation"></i>
                                                </button>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @TodayStatusBadge(u.FinalStatus, u.EnterStatus, u.HasApprovedLeave)
                                    </td>
                                    <td class="small text-muted">@(u.Note ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== مدیریت شیفت‌ها ==================== -->
@if (tab == "shifts")
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <b><i class="bi bi-clock-history text-primary"></i> لیست شیفت‌ها</b>
            <button class="btn btn-sm btn-primary" @onclick="NewShift"><i class="bi bi-plus-lg"></i> شیفت جدید</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead><tr><th>نام شیفت</th><th>توضیح</th><th>شروع</th><th>پایان</th><th>تاخیر مجاز</th><th>جمعه</th><th>مازاد</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in shifts)
                        {
                            <tr>
                                <td class="fw-700">@s.Name</td>
                                <td class="small text-muted">@(s.Description ?? "—")</td>
                                <td dir="ltr"><span class="fw-bold text-success">@s.StartTime.HHMM()</span>@if (s.StartTime2 != null) { <span class="small text-success">+ @s.StartTime2?.HHMM()</span> }</td>
                                <td dir="ltr"><span class="fw-bold text-danger">@s.EndTime.HHMM()</span>@if (s.EndTime2 != null) { <span class="small text-danger">+ @s.EndTime2?.HHMM()</span> }</td>
                                <td>@Fa.Digits(s.GraceMinutes) دقیقه</td>
                                <td>@if (s.IncludeFriday) { <span class="badge bg-info">بله</span> } else { <span class="text-muted">خیر</span> }</td>
                                <td>
                                    @if (s.RequireExtraApproval == true) { <span class="badge bg-warning text-dark" title="در انتظار تصمیم مدیر">تصمیم مدیر</span> }
                                    else if (s.RequireExtraApproval == false) { <span class="badge bg-light text-dark" title="اضافه‌کار خودکار">خودکار</span> }
                                    else { <span class="text-muted small" title="پیروی از تنظیم سراسری تقویم کاری">سراسری</span> }
                                </td>
                                <td>@if (s.IsActive) { <span class="badge bg-success">فعال</span> } else { <span class="badge bg-secondary">غیرفعال</span> }</td>
                                <td>
                                    <button class="btn btn-sm btn-light" @onclick="() => EditShift(s)"><i class="bi bi-pencil text-primary"></i></button>
                                    <button class="btn btn-sm btn-light" @onclick="() => DeleteShift(s)"><i class="bi bi-trash text-danger"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== تخصیص شیفت ==================== -->
@if (tab == "assign")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><b><i class="bi bi-person-gear text-primary"></i> تخصیص شیفت به پرسنل</b></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead><tr><th>پرسنل</th><th>شیفت فعلی</th><th>تغییر شیفت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in personnel)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <UserAvatar LoginUserId="@p.Id" Size="28" />
                                        <span class="fw-700">@p.FullName</span>
                                        <span class="small text-muted" dir="ltr">(@p.Username)</span>
                                    </div>
                                </td>
                                <td>
                                    @if (p.ShiftGroupId.HasValue) { <span class="badge bg-primary">@p.ShiftName</span> }
                                    else { <span class="text-muted">تعیین نشده</span> }
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" @onchange="e => ChangeShift(p, int.TryParse(e.Value?.ToString(), out var v)?v:0)">
                                        <option value="0" selected="@(!p.ShiftGroupId.HasValue)">— بدون شیفت —</option>
                                        @foreach (var s in shifts.Where(x => x.IsActive))
                                        {
                                            <option value="@s.Id" selected="@(p.ShiftGroupId==s.Id)">@s.Name</option>
                                        }
                                    </select>
                                </td>
                                <td><span class="badge bg-success-subtle text-success" hidden="@(!p.Saved)">ذخیره شد</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== گزارش روزانه ==================== -->
@if (tab == "report")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b><i class="bi bi-journal-text text-primary"></i> گزارش روزانه — @PersianDate.MonthName(reportMonth) @Fa.Digits(reportYear)</b>
            <div class="d-flex gap-2 align-items-center flex-wrap">
                <label class="form-check mb-0 small fw-800" title="فقط سطرهایی که کسری کار دارند">
                    <input type="checkbox" class="form-check-input" @bind="reportOnlyDeficit" @bind:after="LoadReport" />
                    <span class="form-check-label">فقط روزهای دارای کسری</span>
                </label>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportUser" @bind:after="LoadReport">
                    <option value="0">همه پرسنل</option>
                    @foreach (var p in personnel) { <option value="@p.Id">@p.FullName</option> }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportMonth" @bind:after="LoadReport">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@PersianDate.MonthName(m)</option> }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportYear" @bind:after="LoadReport">
                    @for (int y = reportYear - 1; y <= reportYear + 1; y++) { <option value="@y">@Fa.Digits(y)</option> }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportCsv" disabled="@(!reportItems.Any())"><i class="bi bi-download me-1"></i> CSV</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table att-report-table">
                    <thead>
                        <tr><th>تاریخ</th><th>پرسنل</th><th>شیفت</th><th>ورود</th><th>خروج</th><th>کارکرد</th><th>تاخیر</th><th>کسری</th><th>وضعیت</th><th>نامه</th></tr>
                    </thead>
                    <tbody>
                        @if (reportLoading) { <tr><td colspan="10" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (!reportItems.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">داده‌ای برای نمایش نیست.</td></tr> }
                        else
                        {
                            @foreach (var r in reportItems)
                            {
                                var clickable = r.deficitMinutes > 0 && CanSendDeficitLetter && r.userId != Auth.UserId;
                                var sentKey = DeficitKey(r.userId, r.date);
                                var rowTitle = clickable ? "برای ارسال نامهٔ کسری کار کلیک کنید" : null;
                                <tr class="att-report-row @(r.deficitMinutes>0?"att-row-deficit":"") @(clickable?"clickable":"")"
                                    title="@rowTitle"
                                    @onclick="() => OpenDeficitLetter(new DeficitLetterTarget(r.userId, r.fullName, r.date, r.deficitMinutes, r.lateMinutes, r.enterAt))">
                                    <td dir="ltr" class="text-nowrap">@PersianDate.ToShort(r.date) <div class="small text-muted">@r.weekday</div></td>
                                    <td><div class="d-flex align-items-center gap-2"><UserAvatar LoginUserId="@r.userId" Size="26" /><span>@r.fullName</span></div></td>
                                    <td>@(r.shiftName ?? "—")</td>
                                    <td dir="ltr">
                                        @if (r.enterAt.HasValue)
                                        {
                                            <span class="fw-bold @(r.enterStatus=="Late"?"text-danger":"text-success")">@r.enterAt.Value.ToString("HH:mm")</span>
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td dir="ltr">@(r.exitAt.HasValue ? r.exitAt.Value.ToString("HH:mm") : "—")</td>
                                    <td>@WorkText(r.workMinutes)</td>
                                    <td>@if (r.lateMinutes > 0) { <span class="text-danger">@Fa.Digits(r.lateMinutes) دقیقه</span> } else { <span class="text-muted">—</span> }</td>
                                    <td class="@(r.deficitMinutes>0?"text-danger fw-700":"")">@(r.deficitMinutes>0?WorkText(r.deficitMinutes):"—")</td>
                                    <td>@TodayStatusBadge(r.finalStatus, r.enterStatus, r.hasApprovedLeave)</td>
                                    <td>
                                        @if (clickable)
                                        {
                                            @if (deficitSent.Contains(sentKey))
                                            {
                                                <button class="btn btn-sm btn-outline-success py-0 px-1" title="نامه کسری کار این روز در همین نشست ارسال شده است" disabled>
                                                    <i class="bi bi-envelope-check"></i>
                                                </button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-sm btn-outline-danger py-0 px-1" title="ارسال نامه کسری کار به @(r.fullName)" @onclick:stopPropagation="true" @onclick="() => OpenDeficitLetter(new DeficitLetterTarget(r.userId, r.fullName, r.date, r.deficitMinutes, r.lateMinutes, r.enterAt))">
                                                    <i class="bi bi-envelope-exclamation"></i>
                                                </button>
                                            }
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== گزارش خلاصه ماهانه (کسری کار) ==================== -->
@if (tab == "monthly")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b><i class="bi bi-bar-chart-fill text-primary"></i> گزارش خلاصه ماهانه — کسری کار</b>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width:auto" @bind="reportMonth" @bind:after="LoadMonthly">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@PersianDate.MonthName(m)</option> }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportYear" @bind:after="LoadMonthly">
                    @for (int y = reportYear - 1; y <= reportYear + 1; y++) { <option value="@y">@Fa.Digits(y)</option> }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportMonthlyCsv" disabled="@(!monthlyItems.Any())">
                    <i class="bi bi-download me-1"></i> CSV
                </button>
                <button class="btn btn-sm btn-outline-secondary" @onclick="RecalcMonth"
                        title="محاسبه‌ی دوباره‌ی کارکرد/کسری/مازادِ همه‌ی روزهای این ماه با قاعده‌ی فعلی شیفت و تقویم کاری">
                    @if (recalcBusy) { <span class="spinner-border spinner-border-sm me-1"></span> }
                    else { <i class="bi bi-arrow-repeat me-1"></i> }
                    بازحساب ماه
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead>
                        <tr>
                            <th>پرسنل</th><th>شیفت</th><th>روزکاری</th><th>حاضر</th><th>مرخصی</th>
                            <th>غایب</th><th>با تاخیر</th><th>تاخیر(دقیقه)</th><th>تعجیل(دقیقه)</th>
                            <th>کارکرد(ساعت)</th><th>اضافه‌کاری</th><th>مازادِ در انتظار</th><th>غیرمجاز</th><th>کسری(ساعت)</th><th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (monthlyLoading) { <tr><td colspan="15" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (!monthlyItems.Any()) { <tr><td colspan="15" class="text-center text-muted py-4">پرسنلی یافت نشد.</td></tr> }
                        else
                        {
                            @foreach (var r in monthlyItems.OrderByDescending(x => x.DeficitMinutes))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <UserAvatar LoginUserId="@r.UserId" Size="28" />
                                            <span class="fw-700">@r.UserName</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@r.ShiftName</span></td>
                                    <td>@Fa.Digits(r.Workdays)</td>
                                    <td class="text-success fw-700">@Fa.Digits(r.Present)</td>
                                    <td class="text-primary">@D2(r.LeaveDays)</td>
                                    <td class="@(r.Absent>0?"text-danger fw-700":"")">@Fa.Digits(r.Absent)</td>
                                    <td>@Fa.Digits(r.LateDays)</td>
                                    <td>@Fa.Digits(r.TotalLateMinutes)</td>
                                    <td>@Fa.Digits(r.TotalEarlyLeaveMinutes)</td>
                                    <td class="text-info">@D2(r.WorkMinutes / 60.0)</td>
                                    <td class="text-info fw-700">@(r.OvertimeMinutes>0?WorkMin(r.OvertimeMinutes):"—")</td>
                                    <td class="text-warning fw-700" title="ماندن بعد از پایان شیفت که هنوز تصمیم نشده — در تب «کارتابل مازاد» تعیین تکلیف کنید">@(r.PendingOvertimeMinutes>0?WorkMin(r.PendingOvertimeMinutes):"—")</td>
                                    <td class="text-danger fw-700">@(r.UnauthorizedMinutes>0?WorkMin(r.UnauthorizedMinutes):"—")</td>
                                    <td class="@(r.DeficitMinutes>0?"text-danger fw-700":"")">@D2(r.DeficitHours)</td>
                                    <td>@MonthlyStatusBadge(r)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== کارتابل مازاد (تصمیم مدیر درباره‌ی ماندن بعد از پایان شیفت) ==================== -->
@if (tab == "extra")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b><i class="bi bi-hourglass-split text-warning"></i> کارتابل مازاد — ماندنِ بعد از پایان شیفت</b>
            <div class="d-flex gap-2 align-items-center">
                <input type="date" class="form-control form-control-sm" style="width:auto" @bind="extraFrom" />
                <span class="small text-muted">تا</span>
                <input type="date" class="form-control form-control-sm" style="width:auto" @bind="extraTo" />
                <div class="form-check form-switch mb-0 ms-2">
                    <input type="checkbox" class="form-check-input" id="extraPendingOnly" @bind="extraPendingOnly" />
                    <label class="form-check-label small" for="extraPendingOnly">فقط در انتظار تصمیم</label>
                </div>
                <button class="btn btn-sm btn-outline-primary" @onclick="LoadExtra" disabled="@extraLoading">
                    @if (extraLoading) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-arrow-clockwise"></i> }
                </button>
            </div>
        </div>
        <div class="card-body py-2">
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead>
                        <tr>
                            <th>تاریخ</th><th>پرسنل</th><th>شیفت</th><th>بازه</th><th>خروج</th>
                            <th>مازاد</th><th>کارکرد</th><th>کسری</th><th>وضعیت تصمیم</th><th>اقدام</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (extraLoading) { <tr><td colspan="10" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (extraError != "") { <tr><td colspan="10" class="text-center text-danger py-4">@extraError</td></tr> }
                        else if (!extraItems.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">موردی برای تصمیم در این بازه نیست.</td></tr> }
                        else
                        {
                            @foreach (var r in extraItems)
                            {
                                <tr>
                                    <td dir="ltr" class="text-end">@r.DateFa</td>
                                    <td class="fw-700">@r.UserName</td>
                                    <td><span class="badge bg-light text-dark">@(r.ShiftName ?? "—")</span> <small class="text-muted" dir="ltr">@r.ShiftWindow</small></td>
                                    <td dir="ltr" class="text-end small">@Fmt(r.EnterAt) → @Fmt(r.ExitAt)</td>
                                    <td class="text-warning fw-700">@WorkMin(r.PendingMinutes)</td>
                                    <td class="text-info">@WorkMin(r.WorkMinutes)</td>
                                    <td class="@(r.DeficitMinutes > 0 ? "text-danger fw-700" : "")">@(r.DeficitMinutes > 0 ? WorkMin(r.DeficitMinutes) : "—")</td>
                                    <td>
                                        @if (r.ExtraDecision == 0)
                                        { <span class="badge bg-warning text-dark"><i class="bi bi-hourglass-split"></i> در انتظار تصمیم</span> }
                                        else if (r.ExtraDecision == 1)
                                        { <span class="badge bg-success"><i class="bi bi-check2"></i> تأیید → اضافه‌کار</span> }
                                        else
                                        { <span class="badge bg-danger"><i class="bi bi-shield-x"></i> رد → تردد غیرمجاز</span> }
                                    </td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <button class="btn btn-sm btn-success" title="تأیید مازاد به‌عنوان اضافه‌کار"
                                                    disabled="@extraBusy" @onclick="() => Decide(r, 1)">
                                                <i class="bi bi-check2"></i> تأیید
                                            </button>
                                            <button class="btn btn-sm btn-danger" title="رد مازاد = تردد غیرمجاز"
                                                    disabled="@extraBusy" @onclick="() => Decide(r, 2)">
                                                <i class="bi bi-x"></i> رد
                                            </button>
                                            @if (r.ExtraDecision != 0)
                                            {
                                                <button class="btn btn-sm btn-light" title="بازگشت به حالت در انتظار تصمیم"
                                                        disabled="@extraBusy" @onclick="() => Decide(r, 0)">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

