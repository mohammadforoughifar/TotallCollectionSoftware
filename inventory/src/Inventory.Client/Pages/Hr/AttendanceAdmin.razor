@namespace Inventory.Client.Pages
@page "/attendance-admin"
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject RealtimeService Rt
@inject IJSRuntime JS
@implements IDisposable

<PageTitle>مدیریت حضور و غیاب</PageTitle>

@if (!Auth.Has("Attendance.ViewAll") && !Auth.Has("Attendance.ManageShifts") && !Auth.Has("Attendance.Report") && !Auth.IsAdmin)
{
    <div class="text-center py-5">
        <i class="bi bi-shield-lock fs-1 text-danger d-block mb-3"></i>
        <h4>دسترسی ندارید</h4>
        <a class="btn btn-primary rounded-pill px-4" href="attendance"><i class="bi bi-arrow-right me-1"></i> ورود به کارتابل من</a>
    </div>
    return;
}

<div class="page-head mb-4">
    <h1><i class="bi bi-stopwatch"></i> مدیریت حضور و غیاب</h1>
    <div class="lead">مدیریت شیفت‌ها، وضعیت امروز پرسنل و گزارش ماهانه کسری کار</div>
</div>

<!-- ===== آمار امروز ===== -->
<div class="row g-3 mb-4">
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-primary">@Fa.Digits(todayStats?.Total ?? 0)</div><div>کل پرسنل</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-success">@Fa.Digits(todayStats?.Present ?? 0)</div><div>حاضر</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-secondary">@Fa.Digits(todayStats?.Pending ?? 0)</div><div>وارد نشده</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-warning">@Fa.Digits(todayStats?.Late ?? 0)</div><div>با تاخیر</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-info">@Fa.Digits(todayStats?.OnLeave ?? 0)</div><div>مرخصی</div></div></div>
    </div>
    <div class="col-4 col-lg-2">
        <div class="card border-0 shadow-sm att-stat-card"><div class="card-body"><div class="at-num text-danger">@Fa.Digits(todayStats?.Absent ?? 0)</div><div>غایب</div></div></div>
    </div>
</div>

<!-- ===== تب‌ها ===== -->
<div class="lv-tabs d-flex gap-2 mb-3 flex-wrap">
    <button class="lv-tab @(tab == "today" ? "active" : "")" @onclick='() => tab = "today"'><i class="bi bi-people"></i> وضعیت امروز</button>
    @if (Auth.Has("Attendance.ManageShifts") || Auth.IsAdmin)
    {
        <button class="lv-tab @(tab == "shifts" ? "active" : "")" @onclick='() => tab = "shifts"'><i class="bi bi-clock-history"></i> مدیریت شیفت‌ها</button>
        <button class="lv-tab @(tab == "assign" ? "active" : "")" @onclick='() => tab = "assign"'><i class="bi bi-person-gear"></i> تخصیص شیفت</button>
    }
    <button class="lv-tab @(tab == "report" ? "active" : "")" @onclick='() => { tab = "report"; _ = LoadReport(); }'><i class="bi bi-journal-text"></i> گزارش روزانه</button>
    <button class="lv-tab @(tab == "monthly" ? "active" : "")" @onclick='() => { tab = "monthly"; _ = LoadMonthly(); }'><i class="bi bi-bar-chart-fill"></i> گزارش خلاصه ماه</button>
</div>

<!-- ==================== وضعیت امروز ==================== -->
@if (tab == "today")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b><i class="bi bi-calendar2-day text-primary"></i> وضعیت امروز — @PersianDate.ToLong(DateTime.Now)</b>
            <button class="btn btn-sm btn-outline-primary" @onclick="LoadToday"><i class="bi bi-arrow-clockwise"></i> به‌روزرسانی</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead>
                        <tr><th>پرسنل</th><th>شیفت</th><th>ورود</th><th>خروج</th><th>ورود/خروج</th><th>کارکرد</th><th>کسری</th><th>وضعیت</th><th>توضیح</th></tr>
                    </thead>
                    <tbody>
                        @if (todayLoading) { <tr><td colspan="9" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (!todayItems.Any()) { <tr><td colspan="9" class="text-center text-muted py-4">پرسنلی ثبت نشده.</td></tr> }
                        else
                        {
                            @foreach (var u in todayItems)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <UserAvatar LoginUserId="@u.UserId" Size="30" />
                                            <span class="fw-700">@u.FullName</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark">@u.ShiftName</span>
                                        @if (u.ShiftStart.HasValue) { <div class="small text-muted" dir="ltr">@FmtTime(u.ShiftStart.Value) - @FmtTime(u.ShiftEnd.Value)</div> }
                                    </td>
                                    <td dir="ltr">
                                        @if (u.EnterAt.HasValue)
                                        {
                                            <span class="fw-bold @(u.EnterStatus=="Late"?"text-danger":"text-success")">@u.EnterAt.Value.ToString("HH:mm")</span>
                                            @if (u.EnterStatus == "Late") { <span class="badge bg-danger ms-1">@Fa.Digits(u.LateMinutes) دقیقه</span> }
                                        }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td dir="ltr">@(u.ExitAt.HasValue ? u.ExitAt.Value.ToString("HH:mm") : "—")</td>
                                    <td>
                                        @if (u.InOutCount > 0) { <span class="badge bg-light text-dark border">@Fa.Digits(u.InOutCount) بار</span> }
                                        else { <span class="text-muted">—</span> }
                                        @if (u.IsInNow) { <span class="badge bg-success ms-1">در محل</span> }
                                        @if (u.UncoveredGaps > 0) { <span class="badge bg-warning ms-1" title="خروجی که با مرخصی/ماموریت ساعتی پوشش ندارد">بدون پوشش</span> }
                                    </td>
                                    <td>@WorkText(u.WorkMinutes)</td>
                                    <td class="@(u.DeficitMinutes>0?"text-danger fw-700":"")">@(u.DeficitMinutes>0?WorkText(u.DeficitMinutes):"—")</td>
                                    <td>
                                        @TodayStatusBadge(u.FinalStatus, u.EnterStatus, u.HasApprovedLeave)
                                        @if (u.HasApprovedLeave) { <span class="badge bg-primary ms-1">مرخصی</span> }
                                    </td>
                                    <td class="small text-muted">@(u.Note ?? "—")</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== مدیریت شیفت‌ها ==================== -->
@if (tab == "shifts")
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <b><i class="bi bi-clock-history text-primary"></i> لیست شیفت‌ها</b>
            <button class="btn btn-sm btn-primary" @onclick="NewShift"><i class="bi bi-plus-lg"></i> شیفت جدید</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead><tr><th>نام شیفت</th><th>توضیح</th><th>شروع</th><th>پایان</th><th>تاخیر مجاز</th><th>جمعه</th><th>وضعیت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var s in shifts)
                        {
                            <tr>
                                <td class="fw-700">@s.Name</td>
                                <td class="small text-muted">@(s.Description ?? "—")</td>
                                <td dir="ltr"><span class="fw-bold text-success">@s.StartTime.HHMM()</span>@if (s.StartTime2 != null) { <span class="small text-success">+ @s.StartTime2?.HHMM()</span> }</td>
                                <td dir="ltr"><span class="fw-bold text-danger">@s.EndTime.HHMM()</span>@if (s.EndTime2 != null) { <span class="small text-danger">+ @s.EndTime2?.HHMM()</span> }</td>
                                <td>@Fa.Digits(s.GraceMinutes) دقیقه</td>
                                <td>@if (s.IncludeFriday) { <span class="badge bg-info">بله</span> } else { <span class="text-muted">خیر</span> }</td>
                                <td>@if (s.IsActive) { <span class="badge bg-success">فعال</span> } else { <span class="badge bg-secondary">غیرفعال</span> }</td>
                                <td>
                                    <button class="btn btn-sm btn-light" @onclick="() => EditShift(s)"><i class="bi bi-pencil text-primary"></i></button>
                                    <button class="btn btn-sm btn-light" @onclick="() => DeleteShift(s)"><i class="bi bi-trash text-danger"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== تخصیص شیفت ==================== -->
@if (tab == "assign")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white"><b><i class="bi bi-person-gear text-primary"></i> تخصیص شیفت به پرسنل</b></div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead><tr><th>پرسنل</th><th>شیفت فعلی</th><th>تغییر شیفت</th><th></th></tr></thead>
                    <tbody>
                        @foreach (var p in personnel)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <UserAvatar LoginUserId="@p.Id" Size="28" />
                                        <span class="fw-700">@p.FullName</span>
                                        <span class="small text-muted" dir="ltr">(@p.Username)</span>
                                    </div>
                                </td>
                                <td>
                                    @if (p.ShiftGroupId.HasValue) { <span class="badge bg-primary">@p.ShiftName</span> }
                                    else { <span class="text-muted">تعیین نشده</span> }
                                </td>
                                <td>
                                    <select class="form-select form-select-sm" @onchange="e => ChangeShift(p, int.TryParse(e.Value?.ToString(), out var v)?v:0)">
                                        <option value="0" selected="@(!p.ShiftGroupId.HasValue)">— بدون شیفت —</option>
                                        @foreach (var s in shifts.Where(x => x.IsActive))
                                        {
                                            <option value="@s.Id" selected="@(p.ShiftGroupId==s.Id)">@s.Name</option>
                                        }
                                    </select>
                                </td>
                                <td><span class="badge bg-success-subtle text-success" hidden="@(!p.Saved)">ذخیره شد</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== گزارش روزانه ==================== -->
@if (tab == "report")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b><i class="bi bi-journal-text text-primary"></i> گزارش روزانه</b>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width:auto" @bind="reportUser" @bind:after="LoadReport">
                    <option value="0">همه پرسنل</option>
                    @foreach (var p in personnel) { <option value="@p.Id">@p.FullName</option> }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportMonth" @bind:after="LoadReport">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@PersianDate.MonthName(m)</option> }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportYear" @bind:after="LoadReport">
                    @for (int y = reportYear - 1; y <= reportYear + 1; y++) { <option value="@y">@Fa.Digits(y)</option> }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportCsv" disabled="@(!reportItems.Any())"><i class="bi bi-download me-1"></i> CSV</button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead>
                        <tr><th>تاریخ</th><th>پرسنل</th><th>شیفت</th><th>ورود</th><th>خروج</th><th>ورود/خروج</th><th>کارکرد</th><th>تاخیر</th><th>کسری</th><th>وضعیت</th></tr>
                    </thead>
                    <tbody>
                        @if (reportLoading) { <tr><td colspan="10" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (!reportItems.Any()) { <tr><td colspan="10" class="text-center text-muted py-4">رکوردی در این ماه ثبت نشده.</td></tr> }
                        else
                        {
                            @foreach (var r in reportItems)
                            {
                                <tr>
                                    <td dir="ltr">@PersianDate.ToShort(r.WorkDate) <div class="small text-muted">@PersianDate.WeekdayName(r.WorkDate)</div></td>
                                    <td><div class="d-flex align-items-center gap-2"><UserAvatar LoginUserId="@r.UserId" Size="26" /><span>@r.UserName</span></div></td>
                                    <td>@(r.ShiftName ?? "—")</td>
                                    <td dir="ltr">@(r.EnterAt.HasValue ? r.EnterAt.Value.ToString("HH:mm") : "—")</td>
                                    <td dir="ltr">@(r.ExitAt.HasValue ? r.ExitAt.Value.ToString("HH:mm") : "—")</td>
                                    <td>
                                        @if (r.InOutCount > 1) { <span class="badge bg-light text-dark border">@Fa.Digits(r.InOutCount) بار</span> }
                                        else { <span class="text-muted">—</span> }
                                    </td>
                                    <td>@WorkText(r.WorkMinutes)</td>
                                    <td>@if (r.LateMinutes > 0) { <span class="text-danger">@Fa.Digits(r.LateMinutes) دقیقه</span> } else { <span class="text-success">بدون تاخیر</span> }</td>
                                    <td class="@(r.DeficitMinutes>0?"text-danger fw-700":"")">@(r.DeficitMinutes>0?WorkText(r.DeficitMinutes):"—")</td>
                                    <td>@TodayStatusBadge(r.FinalStatus, r.EnterStatus, r.HasApprovedLeave)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== گزارش خلاصه ماهانه (کسری کار) ==================== -->
@if (tab == "monthly")
{
    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center flex-wrap gap-2">
            <b><i class="bi bi-bar-chart-fill text-primary"></i> گزارش خلاصه ماهانه — کسری کار</b>
            <div class="d-flex gap-2">
                <select class="form-select form-select-sm" style="width:auto" @bind="reportMonth" @bind:after="LoadMonthly">
                    @for (int m = 1; m <= 12; m++) { <option value="@m">@PersianDate.MonthName(m)</option> }
                </select>
                <select class="form-select form-select-sm" style="width:auto" @bind="reportYear" @bind:after="LoadMonthly">
                    @for (int y = reportYear - 1; y <= reportYear + 1; y++) { <option value="@y">@Fa.Digits(y)</option> }
                </select>
                <button class="btn btn-sm btn-outline-primary" @onclick="ExportMonthlyCsv" disabled="@(!monthlyItems.Any())">
                    <i class="bi bi-download me-1"></i> CSV
                </button>
            </div>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 att-table">
                    <thead>
                        <tr>
                            <th>پرسنل</th><th>شیفت</th><th>روزکاری</th><th>حاضر</th><th>مرخصی</th>
                            <th>غایب</th><th>با تاخیر</th><th>تاخیر(دقیقه)</th><th>تعجیل(دقیقه)</th>
                            <th>کارکرد(ساعت)</th><th>اضافه‌کاری</th><th>غیرمجاز</th><th>کسری(ساعت)</th><th>وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (monthlyLoading) { <tr><td colspan="14" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div></td></tr> }
                        else if (!monthlyItems.Any()) { <tr><td colspan="14" class="text-center text-muted py-4">پرسنلی یافت نشد.</td></tr> }
                        else
                        {
                            @foreach (var r in monthlyItems.OrderByDescending(x => x.DeficitMinutes))
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <UserAvatar LoginUserId="@r.UserId" Size="28" />
                                            <span class="fw-700">@r.UserName</span>
                                        </div>
                                    </td>
                                    <td><span class="badge bg-light text-dark">@r.ShiftName</span></td>
                                    <td>@Fa.Digits(r.Workdays)</td>
                                    <td class="text-success fw-700">@Fa.Digits(r.Present)</td>
                                    <td class="text-primary">@D2(r.LeaveDays)</td>
                                    <td class="@(r.Absent>0?"text-danger fw-700":"")">@Fa.Digits(r.Absent)</td>
                                    <td>@Fa.Digits(r.LateDays)</td>
                                    <td>@Fa.Digits(r.TotalLateMinutes)</td>
                                    <td>@Fa.Digits(r.TotalEarlyLeaveMinutes)</td>
                                    <td class="text-info">@D2(r.WorkMinutes / 60.0)</td>
                                    <td class="@(r.OvertimeMinutes>0?"text-info fw-700":"")">@(r.OvertimeMinutes>0?WorkMin(r.OvertimeMinutes):"—")</td>
                                    <td class="@(r.UnauthorizedMinutes>0?"text-danger fw-700":"")">@(r.UnauthorizedMinutes>0?WorkMin(r.UnauthorizedMinutes):"—")</td>
                                    <td class="@(r.DeficitMinutes>0?"text-danger fw-700":"")">@D2(r.DeficitHours)</td>
                                    <td>@MonthlyStatusBadge(r)</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<!-- ==================== مودال شیفت ==================== -->
@if (ShowShiftModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.5)" @onclick="() => ShowShiftModal = false">
        <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation>
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clock-history text-primary"></i> @(editingShift?.Id > 0 ? "ویرایش شیفت" : "شیفت جدید")</h5>
                    <button type="button" class="btn-close" @onclick="() => ShowShiftModal = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrEmpty(shiftError)) { <div class="alert alert-danger py-2">@shiftError</div> }
                    <div class="mb-2">
                        <label class="form-label small fw-800">نام شیفت <span class="text-danger">*</span></label>
                        <input class="form-control form-control-sm" @bind="shiftForm.Name" placeholder="مثلاً: شیفت صبح" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small fw-800">توضیحات</label>
                        <input class="form-control form-control-sm" @bind="shiftForm.Description" />
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small fw-800">ساعت شروع</label>
                            <input type="time" class="form-control form-control-sm" value="@shiftForm.StartTime" @onchange='e => shiftForm.StartTime = e.Value?.ToString() ?? ""' />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-800">ساعت پایان</label>
                            <input type="time" class="form-control form-control-sm" value="@shiftForm.EndTime" @onchange='e => shiftForm.EndTime = e.Value?.ToString() ?? ""' />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-800 text-primary">شروع پنجره دوم <small class="text-muted fw-normal">(اختیاری)</small></label>
                            <input type="time" class="form-control form-control-sm" value="@shiftForm.StartTime2" @onchange='e => shiftForm.StartTime2 = e.Value?.ToString() ?? ""' />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-800 text-primary">پایان پنجره دوم <small class="text-muted fw-normal">(اختیاری)</small></label>
                            <input type="time" class="form-control form-control-sm" value="@shiftForm.EndTime2" @onchange='e => shiftForm.EndTime2 = e.Value?.ToString() ?? ""' />
                        </div>
                        <div class="col-12">
                            <div class="small text-muted"><i class="bi bi-info-circle"></i> <b>شیفت دوپاره:</b> اگر تیم شما دو بازه در روز کار می‌کند (مثلاً ۸ تا ۱۳ و ۱۷ تا ۲۱:۳۰)، پنجره‌ی دوم را هم پر کنید. حضور در فاصله‌ی بین دو پنجره نه کار حساب می‌شود نه تردد غیرمجاز.</div>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-800">تاخیر مجاز (دقیقه)</label>
                            <input type="number" min="0" class="form-control form-control-sm" @bind="shiftForm.GraceMinutes" />
                        </div>
                        <div class="col-6 d-flex align-items-end">
                            <label class="form-check">
                                <input type="checkbox" class="form-check-input" @bind="shiftForm.IncludeFriday" />
                                <span class="form-check-label">شامل جمعه</span>
                            </label>
                        </div>
                        <div class="col-12">
                            <label class="form-check">
                                <input type="checkbox" class="form-check-input" @bind="shiftForm.IsActive" />
                                <span class="form-check-label">فعال باشد</span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="() => ShowShiftModal = false">انصراف</button>
                    <button class="btn btn-primary" @onclick="SaveShift" disabled="@shiftBusy">ذخیره</button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .att-stat-card { border-radius:16px; border:1px solid #e8e2fb; }
    .at-num { font-size:1.6rem; font-weight:900; color:#1c2130; line-height:1.2; }
    .att-table { font-size:.88rem; }
    .att-table thead th { font-size:.78rem; background:#f8f7fd; color:#5f688a; font-weight:800; border-bottom:2px solid #e8e2fb; }
    .lv-tab { border:none; background:transparent; color:#5f688a; font-weight:800; font-size:.9rem; border-radius:10px; padding:.45rem 1rem; display:inline-flex; align-items:center; gap:.45rem; cursor:pointer; }
    .lv-tab:hover { background:#f1edfc; color:#6d4dff; }
    .lv-tab.active { background:#efeaff; color:#6d4dff; box-shadow:inset 0 -2px 0 #8e5cff; }
