    private static string FmtTime(TimeSpan t) => t.HHMM();
    private static string WorkText(int m)
    {
        if (m <= 0) return "—";
        int h = m / 60; int mm = m % 60;
        if (h == 0) return $"{Fa.Digits(mm)} دقیقه";
        if (mm == 0) return $"{Fa.Digits(h)} ساعت";
        return $"{Fa.Digits(h)}:{mm.ToString().PadLeft(2, '0')} ساعت";
    }
    private static string D2(double v) => v == (long)v ? Fa.Digits((long)v) : Fa.Digits((decimal)Math.Round(v, 1));
    private static string WorkMin(int m)
    {
        if (m <= 0) return "—";
        int h = m / 60, mm = m % 60;
        if (h == 0) return Fa.Digits(mm) + " دقیقه";
        if (mm == 0) return Fa.Digits(h) + " ساعت";
        return Fa.Digits(h) + ":" + mm.ToString().PadLeft(2, '0') + " ساعت";
    }

