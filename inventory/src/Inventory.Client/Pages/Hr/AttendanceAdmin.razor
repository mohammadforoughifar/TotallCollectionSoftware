    private async Task SaveArea()
    {
        areaError = "";
        if (double.IsNaN(areaLat) || areaLat < -90 || areaLat > 90)
        { areaError = "عرض جغرافیایی نامعتبر است."; return; }
        if (double.IsNaN(areaLng) || areaLng < -180 || areaLng > 180)
        { areaError = "طول جغرافیایی نامعتبر است."; return; }
        if (!double.TryParse(areaRadius, out var radius) || radius < 50)
        { areaError = "شعاع باید حداقل ۵۰ متر باشد."; return; }

        areaBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/Attendance/security/area", new { Latitude = areaLat, Longitude = areaLng, RadiusMeters = radius, LocationName = areaName });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("محدوده‌ی مکانی مجاز ذخیره شد.");
                areaRadiusMeters = radius;
                await LoadArea();
            }
            else areaError = await ExtractError(resp);
        }
        catch (Exception ex) { areaError = ex.Message; }
        areaBusy = false;
    }

