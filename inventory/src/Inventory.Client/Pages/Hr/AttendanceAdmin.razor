                                                {
                                                    <div class="d-flex gap-1">
                                                        @if (a.AlertType == "NewDevice")
                                                        {
                                                            <button class="btn btn-sm btn-success" @onclick='() => ApproveAlert(a.Id)' title="تأیید به‌عنوان دستگاه اصلی">
                                                                <i class="bi bi-check-lg"></i> تأیید
                                                            </button>
                                                            <button class="btn btn-sm btn-outline-danger" @onclick='() => RejectAlert(a.Id)' title="رد">
                                                                <i class="bi bi-x-lg"></i>
                                                            </button>
                                                        }
                                                        else
                                                        {
                                                            <button class="btn btn-sm btn-outline-secondary" @onclick='() => DismissAlert(a.Id)' title="بستن (رسیدگی شد)">
                                                                <i class="bi bi-check2-square"></i> بستن
                                                            </button>
                                                        }
                                                    </div>
                                                }
                                                else { <span class="text-muted small">—</span> }
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

