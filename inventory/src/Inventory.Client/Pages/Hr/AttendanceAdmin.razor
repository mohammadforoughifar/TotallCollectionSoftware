@code {
    private string tab = "today";
    private string apiBase = "";
    private bool todayLoading;
    private TodayStats? todayStats;
    private List<TodayItem> todayItems = new();
    private List<ShiftDto> shifts = new();
    private List<PersonnelItem> personnel = new();
    private bool reportLoading, monthlyLoading;
    private List<ReportItem> reportItems = new();
    private List<MonthlyRow> monthlyItems = new();
    private int reportYear, reportMonth, reportUser;
    private (int jy, int jm) _now;

    private bool ShowShiftModal;
    private ShiftForm shiftForm = new();
    private ShiftDto? editingShift;
    private string shiftError = "";
    private bool shiftBusy;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new("Bearer", Auth.Token);
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        (_now.jy, _now.jm, _) = PersianDate.FromGregorian(DateTime.Now);
        reportYear = _now.jy; reportMonth = _now.jm;

        await LoadShifts();
        await LoadPersonnel();
        await LoadToday();
        await LoadReport();

        Rt.DataChanged += OnRtChanged;
        await Rt.EnsureStartedAsync(apiBase, Auth.UserId);
    }

    private async void OnRtChanged(string scope)
    {
        if (scope != "attendance") return;
        await InvokeAsync(async () =>
        {
            await LoadToday();
            if (tab == "report") await LoadReport();
            if (tab == "monthly") await LoadMonthly();
            await LoadShifts();
            await LoadPersonnel();
            StateHasChanged();
        });
    }
    public void Dispose() => Rt.DataChanged -= OnRtChanged;

    private async Task LoadToday()
    {
        todayLoading = true;
        try
        {
            var r = await Http.GetFromJsonAsync<TodayResponse>("/api/Attendance/today-status");
            if (r != null) { todayStats = r.stats; todayItems = r.items ?? new(); }
        }
        catch { todayStats = null; todayItems = new(); }
        todayLoading = false;
    }

    private async Task LoadShifts()
    { try { shifts = await Http.GetFromJsonAsync<List<ShiftDto>>("/api/Attendance/shifts") ?? new(); } catch { shifts = new(); } }

    private async Task LoadPersonnel()
    { try { personnel = await Http.GetFromJsonAsync<List<PersonnelItem>>("/api/Attendance/personnel") ?? new(); } catch { personnel = new(); } }

    private async Task LoadReport()
    {
        reportLoading = true;
        try
        {
            var r = await Http.GetFromJsonAsync<ReportResponse>($"/api/Attendance/report?jy={reportYear}&jm={reportMonth}&userId={reportUser}");
            reportItems = r?.items?.ToList() ?? new();
        }
        catch { reportItems = new(); }
        reportLoading = false;
    }

    private async Task LoadMonthly()
    {
        monthlyLoading = true;
        try
        {
            var r = await Http.GetFromJsonAsync<MonthlyResponse>($"/api/Attendance/monthly-report?jy={reportYear}&jm={reportMonth}");
            monthlyItems = r?.items?.ToList() ?? new();
        }
        catch { monthlyItems = new(); }
        monthlyLoading = false;
    }

    private void NewShift()
    {
        editingShift = null; shiftError = "";
        shiftForm = new ShiftForm { StartTime = "08:00", EndTime = "16:30", GraceMinutes = 10, IsActive = true };
        ShowShiftModal = true;
    }
    private void EditShift(ShiftDto s)
    {
        editingShift = s; shiftError = "";
        shiftForm = new ShiftForm { Id = s.Id, Name = s.Name, Description = s.Description ?? "", StartTime = s.StartTime.HHMM(), EndTime = s.EndTime.HHMM(), StartTime2 = s.StartTime2?.HHMM() ?? "", EndTime2 = s.EndTime2?.HHMM() ?? "", GraceMinutes = s.GraceMinutes, IncludeFriday = s.IncludeFriday, IsActive = s.IsActive };
        ShowShiftModal = true;
    }

    private async Task SaveShift()
    {
        shiftError = "";
        if (string.IsNullOrWhiteSpace(shiftForm.Name)) { shiftError = "نام شیفت را وارد کنید."; return; }
        shiftBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/Attendance/shifts", shiftForm);
            if (resp.IsSuccessStatusCode) { Toast.Success("شیفت ذخیره شد."); ShowShiftModal = false; await LoadShifts(); }
            else shiftError = await ExtractError(resp);
        }
        catch (Exception ex) { shiftError = ex.Message; }
        shiftBusy = false;
    }

    private async Task DeleteShift(ShiftDto s)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"آیا از حذف شیفت «{s.Name}» مطمئن هستید؟")) return;
        try
        {
            var resp = await Http.DeleteAsync($"/api/Attendance/shifts/{s.Id}");
            if (resp.IsSuccessStatusCode) { Toast.Success("شیفت حذف شد."); await LoadShifts(); }
            else Toast.Error(await ExtractError(resp));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ChangeShift(PersonnelItem p, int shiftId)
    {
        try
        {
            var resp = await Http.PostAsJsonAsync("/api/Attendance/assign-shift", new { UserId = p.Id, ShiftGroupId = shiftId == 0 ? (int?)null : shiftId });
            if (resp.IsSuccessStatusCode) { Toast.Success("شیفت به‌روز شد."); p.Saved = true; p.ShiftGroupId = shiftId == 0 ? null : shiftId; p.ShiftName = shifts.FirstOrDefault(x => x.Id == shiftId)?.Name; }
            else Toast.Error(await ExtractError(resp));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ExportCsv()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append('\uFEFF');
        sb.AppendLine("تاریخ,نام کاربر,شیفت,ورود,خروج,کارکرد(دقیقه),تاخیر(دقیقه),کسری(دقیقه),وضعیت");
        foreach (var r in reportItems)
        {
            var enter = r.EnterAt.HasValue ? r.EnterAt.Value.ToString("HH:mm") : "";
            var exit = r.ExitAt.HasValue ? r.ExitAt.Value.ToString("HH:mm") : "";
            sb.AppendLine($"{PersianDate.ToShort(r.WorkDate)},{r.UserName},{r.ShiftName},{enter},{exit},{r.WorkMinutes},{r.LateMinutes},{r.DeficitMinutes},{r.FinalStatus}");
        }
        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        await JS.InvokeVoidAsync("saveAsFile", $"attendance-{reportYear}-{reportMonth}.csv", Convert.ToBase64String(bytes));
        Toast.Success("گزارش دانلود شد.");
    }

    private async Task ExportMonthlyCsv()
    {
        try
        {
            var bytes = await Http.GetByteArrayAsync($"/api/Attendance/monthly-report.csv?jy={reportYear}&jm={reportMonth}");
            await JS.InvokeVoidAsync("saveAsFile", $"attendance-monthly-{reportYear}-{reportMonth}.csv", Convert.ToBase64String(bytes!));
            Toast.Success("گزارش دانلود شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task<string> ExtractError(HttpResponseMessage resp)
    {
        try { var b = await resp.Content.ReadAsStringAsync(); using var d = System.Text.Json.JsonDocument.Parse(b); if (d.RootElement.TryGetProperty("message", out var m)) return m.GetString() ?? ""; } catch { }
        return "خطا در عملیات";
    }

    private static string FmtTime(TimeSpan t) => t.HHMM();
    private static string WorkText(int m)
    {
        if (m <= 0) return "—";
        int h = m / 60; int mm = m % 60;
        if (h == 0) return $"{Fa.Digits(mm)} دقیقه";
        if (mm == 0) return $"{Fa.Digits(h)} ساعت";
        return $"{Fa.Digits(h)}:{mm.ToString().PadLeft(2, '0')} ساعت";
    }
    private static string D2(double v) => v == (long)v ? Fa.Digits((long)v) : Fa.Digits((decimal)Math.Round(v, 1));
    private static string WorkMin(int m)
    {
        if (m <= 0) return "—";
        int h = m / 60, mm = m % 60;
        if (h == 0) return Fa.Digits(mm) + " دقیقه";
        if (mm == 0) return Fa.Digits(h) + " ساعت";
        return Fa.Digits(h) + ":" + mm.ToString().PadLeft(2, '0') + " ساعت";
    }

    private static Microsoft.AspNetCore.Components.MarkupString TodayStatusBadge(string? final, string? enter, bool onLeave)
    {
        if (onLeave || final == "LeaveDay")
            return new("<span class=\"badge bg-primary\"><i class=\"bi bi-calendar2-check\"></i> مرخصی</span>");
        if (final == "Present" && enter == "Late") return new("<span class=\"badge bg-warning text-dark\"><i class=\"bi bi-clock\"></i> با تاخیر</span>");
        return final switch
        {
            "Present" => new("<span class=\"badge bg-success\"><i class=\"bi bi-check2\"></i> حاضر</span>"),
            "Absent" => new("<span class=\"badge bg-danger\"><i class=\"bi bi-x\"></i> غایب</span>"),
            "Pending" => new("<span class=\"badge bg-secondary\"><i class=\"bi bi-hourglass-split\"></i> وارد نشده</span>"),
            "HalfDay" => new("<span class=\"badge bg-info text-dark\"><i class=\"bi bi-pie-chart\"></i> نیم روز</span>"),
            _ => new("<span class=\"badge bg-light text-dark\">—</span>")
        };
    }

    private static Microsoft.AspNetCore.Components.MarkupString MonthlyStatusBadge(MonthlyRow r)
    {
        if (r.DeficitHours > 4) return new("<span class=\"badge bg-danger\"><i class=\"bi bi-exclamation-triangle\"></i> کسری زیاد</span>");
        if (r.DeficitHours > 0) return new("<span class=\"badge bg-warning text-dark\"><i class=\"bi bi-dash-circle\"></i> کسری دارد</span>");
        if (r.Absent > 2) return new("<span class=\"badge bg-danger\"><i class=\"bi bi-x-circle\"></i> غیبت زیاد</span>");
        return new("<span class=\"badge bg-success\"><i class=\"bi bi-check2\"></i> منظم</span>");
    }

    // ====== Models ======
    public class TodayStats { public int Total { get; set; } public int Present { get; set; } public int Absent { get; set; } public int Pending { get; set; } public int Late { get; set; } public int OnLeave { get; set; } }
    public class TodayItem { public int UserId { get; set; } public string FullName { get; set; } = ""; public string? ShiftName { get; set; } public TimeSpan? ShiftStart { get; set; } public TimeSpan? ShiftEnd { get; set; } public DateTime? EnterAt { get; set; } public DateTime? ExitAt { get; set; } public string? EnterStatus { get; set; } public int LateMinutes { get; set; } public int EarlyLeaveMinutes { get; set; } public int WorkMinutes { get; set; } public int DeficitMinutes { get; set; } public int CoveredGapMinutes { get; set; } public bool HasApprovedLeave { get; set; } public string? FinalStatus { get; set; } public string? Note { get; set; } public int InOutCount { get; set; } public bool IsInNow { get; set; } public int UncoveredGaps { get; set; } public List<object> Segments { get; set; } = new(); }
    public class TodayResponse { public TodayStats stats { get; set; } = new(); public List<TodayItem> items { get; set; } = new(); }

    public class ShiftDto { public int Id { get; set; } public string Name { get; set; } = ""; public string? Description { get; set; } public TimeSpan StartTime { get; set; } public TimeSpan EndTime { get; set; } public TimeSpan? StartTime2 { get; set; } public TimeSpan? EndTime2 { get; set; } public int GraceMinutes { get; set; } public bool IncludeFriday { get; set; } public bool IsActive { get; set; } = true; }
    public class ShiftForm { public int Id { get; set; } public string Name { get; set; } = ""; public string? Description { get; set; } public string StartTime { get; set; } = "08:00"; public string EndTime { get; set; } = "16:30"; public string? StartTime2 { get; set; } = ""; public string? EndTime2 { get; set; } = ""; public int GraceMinutes { get; set; } = 10; public bool IncludeFriday { get; set; } public bool IsActive { get; set; } = true; }

    public class PersonnelItem { public int Id { get; set; } public string Username { get; set; } = ""; public string FullName { get; set; } = ""; public int? ShiftGroupId { get; set; } public string? ShiftName { get; set; } public bool Saved { get; set; } }

    public class ReportItem { public int Id { get; set; } public DateTime WorkDate { get; set; } public int UserId { get; set; } public string UserName { get; set; } = ""; public int? ShiftGroupId { get; set; } public string? ShiftName { get; set; } public DateTime? EnterAt { get; set; } public DateTime? ExitAt { get; set; } public string? EnterStatus { get; set; } public int LateMinutes { get; set; } public int WorkMinutes { get; set; } public int DeficitMinutes { get; set; } public bool HasApprovedLeave { get; set; } public string? FinalStatus { get; set; } public string? Note { get; set; } public int InOutCount { get; set; } public List<object> Segments { get; set; } = new(); }
    public class ReportResponse { public List<ReportItem> items { get; set; } = new(); }

    public class MonthlyRow { public int UserId { get; set; } public string UserName { get; set; } = ""; public string ShiftName { get; set; } = ""; public int Workdays { get; set; } public int Present { get; set; } public int Absent { get; set; } public double LeaveDays { get; set; } public int LateDays { get; set; } public int TotalLateMinutes { get; set; } public int TotalEarlyLeaveMinutes { get; set; } public int WorkMinutes { get; set; } public int DeficitMinutes { get; set; } public double DeficitHours { get; set; } public int OvertimeMinutes { get; set; } public int UnauthorizedMinutes { get; set; } }
    public class MonthlyResponse { public int year { get; set; } public int month { get; set; } public string monthName { get; set; } = ""; public int days { get; set; } public List<MonthlyRow> items { get; set; } = new(); }
}
