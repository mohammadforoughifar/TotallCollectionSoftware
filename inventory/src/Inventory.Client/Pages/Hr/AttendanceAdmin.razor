@code {
    private string tab = "today";
    private string apiBase = "";
    private bool todayLoading;
    private TodayStats? todayStats;
    private List<TodayItem> todayItems = new();
    private DateTime dayDate = DateTime.Today;
    private List<ShiftDto> shifts = new();
    private List<PersonnelItem> personnel = new();
    private bool reportLoading, monthlyLoading, reportOnlyDeficit;
    private List<MonthDayRow> reportItems = new();
    private List<MonthlyRow> monthlyItems = new();
    private int reportYear, reportMonth, reportUser;
    private (int jy, int jm) _now;

    private bool ShowShiftModal;
    private ShiftForm shiftForm = new();
    private ShiftDto? editingShift;
    private string shiftError = "";
    private bool shiftBusy;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new("Bearer", Auth.Token);
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        (_now.jy, _now.jm, _) = PersianDate.FromGregorian(DateTime.Now);
        reportYear = _now.jy; reportMonth = _now.jm;

        await LoadShifts();
        await LoadPersonnel();
        await LoadToday();
        await LoadReport();

        // اگر از لینک اعلان (؟tab=security) آمده‌ایم، تب امنیت باز شود
        try
        {
            var q = new Uri(Nav.Uri).Query;
            if (q.Contains("tab=security")) { tab = "security"; await LoadSecurity(); }
        }
        catch { }

        Rt.DataChanged += OnRtChanged;
        await Rt.EnsureStartedAsync(apiBase, Auth.UserId);
    }

    private async void OnRtChanged(string scope)
    {
        if (scope != "attendance") return;
        await InvokeAsync(async () =>
        {
            await LoadToday();
            if (tab == "report") await LoadReport();
            if (tab == "monthly") await LoadMonthly();
            if (tab == "security") await LoadSecurity();
            await LoadShifts();
            await LoadPersonnel();
            StateHasChanged();
        });
    }
    public void Dispose() => Rt.DataChanged -= OnRtChanged;

    private string todayError = "";

    private async Task LoadToday()
    {
        todayLoading = true;
        todayError = "";
        try
        {
            // گزارش وضعیت روزِ انتخاب‌شده (پیش‌فرض امروز) — یک سطر به ازای هر پرسنل
            var url = $"/api/Attendance/day-status?date={dayDate:yyyy-MM-dd}";
            var r = await Http.GetFromJsonAsync<TodayResponse>(url);
            if (r != null)
            {
                todayStats = r.stats;
                todayItems = r.items ?? new();
                if (r.date != default) dayDate = r.date.Date;
            }
            else
            {
                todayStats = null; todayItems = new();
                todayError = "پاسخی از سرور دریافت نشد.";
            }
        }
        catch (System.Net.Http.HttpRequestException httpEx)
        {
            todayStats = null; todayItems = new();
            var code = (int?)httpEx.StatusCode;
            todayError = code == 404
                ? "گزارش روز دریافت نشد (۴۰۴) — نسخهٔ سرور (API) قدیمی است؛ سرور را با آخرین کد به‌روز و راه‌اندازی مجدد کنید."
                : code == 403
                    ? "گزارش روز دریافت نشد (۴۰۳) — دسترسی مشاهدهٔ حضور و غیاب برای نقش شما فعال نیست."
                    : $"گزارش روز دریافت نشد{(code.HasValue ? $" ({Fa.Digits(code.Value)})" : "")} — اتصال به سرور را بررسی کنید.";
        }
        catch
        {
            todayStats = null; todayItems = new();
            todayError = "گزارش روز دریافت نشد؛ اتصال به سرور را بررسی کنید.";
        }
        todayLoading = false;
    }

