    // ==================== نامه کسری کار (ارسال به‌صورت نامه داخلی) ====================
    /// <summary>هدف نامهٔ کسری — هم از «وضعیت روز» و هم از «گزارش روزانه» پر می‌شود</summary>
    private sealed record DeficitLetterTarget(int UserId, string FullName, DateTime Date, int DeficitMinutes, int LateMinutes, DateTime? EnterAt);
    private DeficitLetterTarget? deficitTarget;
    private string deficitLetterText = "";
    private bool deficitSending;
    private readonly HashSet<string> deficitSent = new();

    /// <summary>ارسال نامه داخلی نیازمند مجوز «ایجاد نامه داخلی» یا دسترسی مدیر است</summary>
    private bool CanSendDeficitLetter => Auth.IsAdmin || Auth.Has("InnerLetters.Create");

    private static string DeficitKey(int userId, DateTime date) => $"{userId}:{date:yyyyMMdd}";

    private void OpenDeficitLetter(DeficitLetterTarget t)
    {
        // فقط سطرهای دارای کسری، برای دیگران و با مجوز نامه داخلی
        if (t.DeficitMinutes <= 0 || !CanSendDeficitLetter || t.UserId == Auth.UserId) return;
        deficitTarget = t;
        var lateNote = t.LateMinutes > 0 ? $"\nساعت ورود ثبت‌شده: {(t.EnterAt.HasValue ? t.EnterAt.Value.ToString("HH:mm") : "—")} (تأخیر {Fa.Digits(t.LateMinutes)} دقیقه)." : "";
        deficitLetterText =
            $"{t.FullName} گرامی؛\n\n" +
            $"طبق گزارش حضور و غیاب، شما در روز {PersianDate.ToLong(t.Date)} ({PersianDate.WeekdayName(t.Date)}) " +
            $"کسری کار به میزان {WorkText(t.DeficitMinutes)} داشته‌اید.{lateNote}\n\n" +
            $"لطفاً مورد را بررسی کرده و در صورت وجود توضیح، به همین نامه پاسخ دهید.";
    }

    private async Task SendDeficitLetter()
    {
        if (deficitTarget == null || deficitSending) return;
        deficitSending = true;
        try
        {
            var t = deficitTarget;
            var dto = new
            {
                title = $"اعلام کسری کار — {t.FullName} — {PersianDate.ToShort(t.Date)}",
                text = deficitLetterText,
                mahramanegi = "عادی",
                foriat = "عادی",
                reciversGirande = new[] { t.UserId }
            };
            var resp = await Http.PostAsJsonAsync("/api/letters", dto);
            if (resp.IsSuccessStatusCode)
            {
                deficitSent.Add(DeficitKey(t.UserId, t.Date));
                Toast.Success($"نامه کسری کار برای {t.FullName} ارسال شد.");
                deficitTarget = null;
            }
            else
            {
                Toast.Error(await ExtractError(resp));
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        deficitSending = false;
    }

    /// <summary>متن فارسی وضعیت روز برای خروجی CSV</summary>
    private static string DayStatusText(string? final, string? enter, bool onLeave)
    {
        if (onLeave || final == "LeaveDay") return "مرخصی";
        if (final == "Present" && enter == "Late") return "حاضر (با تاخیر)";
        return final switch
        {
            "Present" => "حاضر",
            "Absent" => "غایب",
            "Pending" => "وارد نشده",
            "HalfDay" => "نیم روز",
            "Holiday" => "تعطیل",
            _ => "—"
        };
    }

    /// <summary>خروجی CSV گزارش روزانه — ورود/خروج و وضعیت هر پرسنل در یک سطر</summary>
    private async Task ExportDayCsv()
    {
        if (!todayItems.Any()) return;
        var sb = new System.Text.StringBuilder();
        sb.Append('\uFEFF');
        sb.AppendLine($"گزارش روزانه {PersianDate.ToShort(dayDate)} ({PersianDate.WeekdayName(dayDate)})");
        sb.AppendLine("پرسنل,شیفت,ورود,خروج,تعداد تردد,کارکرد(دقیقه),تاخیر(دقیقه),کسری(دقیقه),وضعیت");
        foreach (var u in todayItems)
        {
            var enter = u.EnterAt.HasValue ? u.EnterAt.Value.ToString("HH:mm") : "";
            var exit = u.ExitAt.HasValue ? u.ExitAt.Value.ToString("HH:mm") : "";
            sb.AppendLine($"{u.FullName},{u.ShiftName},{enter},{exit},{u.InOutCount},{u.WorkMinutes},{u.LateMinutes},{u.DeficitMinutes},{DayStatusText(u.FinalStatus, u.EnterStatus, u.HasApprovedLeave)}");
        }
        var bytes = System.Text.Encoding.UTF8.GetBytes(sb.ToString());
        await JS.InvokeVoidAsync("saveAsFile", $"attendance-day-{dayDate:yyyyMMdd}.csv", Convert.ToBase64String(bytes));
        Toast.Success("گزارش روز دانلود شد.");
    }

