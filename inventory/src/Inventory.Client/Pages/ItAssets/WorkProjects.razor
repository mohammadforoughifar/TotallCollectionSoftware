@page "/work-projects"
@implements IDisposable
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav
@inject RealtimeService Rt

<PageTitle>پروژه‌های کاری</PageTitle>

@if (!accessLoaded)
{
    <div class="d-flex align-items-center gap-2 text-muted p-4">
        <span class="spinner-border spinner-border-sm"></span> در حال بارگذاری…
    </div>
}
else if (!access.CanView)
{
    <div class="alert alert-warning m-3">شما به بخش پروژه‌های کاری دسترسی ندارید.</div>
}
else
{
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3">
        <h4 class="mb-0"><i class="bi bi-briefcase ms-1"></i> پروژه‌های کاری</h4>
        @if (access.CanCreate)
        {
            <button class="btn btn-primary btn-sm" @onclick="OpenCreate">
                <i class="bi bi-plus-lg"></i> پروژه جدید
            </button>
        }
    </div>

    @* ================== فیلترها ================== *@
    <div class="card mb-3">
        <div class="card-body py-2">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label fs-8 mb-1">جستجو</label>
                    <input class="form-control form-control-sm" placeholder="عنوان، کد، مدیر یا برچسب…"
                           value="@fltQ" @oninput="OnSearchInput" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 mb-1">وضعیت</label>
                    <select class="form-select form-select-sm" value="@fltStatus" @onchange="OnStatusChanged">
                        <option value="">همه</option>
                        <option value="open">باز</option>
                        <option value="closed">بسته</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 mb-1">نقش من</label>
                    <select class="form-select form-select-sm" value="@fltMine" @onchange="OnMineChanged">
                        <option value="">همه</option>
                        <option value="owner">مدیرم</option>
                        <option value="member">عضوم</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 mb-1">مرتب‌سازی</label>
                    <select class="form-select form-select-sm" value="@fltSort" @onchange="OnSortChanged">
                        <option value="due">مهلت نزدیک</option>
                        <option value="newest">تازه‌ترین</option>
                        <option value="progressAsc">کمترین پیشرفت</option>
                        <option value="progressDesc">بیشترین پیشرفت</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <div class="form-check mt-4">
                        <input id="wp-overdue" class="form-check-input" type="checkbox" checked="@fltOverdue" @onchange="OnOverdueChanged" />
                        <label class="form-check-label fs-8" for="wp-overdue">فقط گذشته‌ازمهلت</label>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ================== لیست ================== *@
    @if (loading)
    {
        <div class="text-muted"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری لیست…</div>
    }
    else if (items.Count == 0)
    {
        <div class="alert alert-light border text-center">پروژه‌ای یافت نشد.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>پروژه</th>
                        <th>مدیر</th>
                        <th style="min-width:130px">پیشرفت</th>
                        <th>دستورها</th>
                        <th>اعضا</th>
                        <th>مهلت</th>
                        <th>آخرین فعالیت</th>
                        <th style="width:150px">عملیات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in items)
                    {
                        <tr class="@(p.Status == "Closed" ? "table-light" : "")">
                            <td>
                                <div class="fw-bold">
                                    <a href="javascript:void(0)" @onclick="() => OpenDetail(p.Id)">@p.Title</a>
                                </div>
                                <div class="fs-8 text-muted num">@p.Number</div>
                                @if (p.Status == "Closed")
                                {
                                    <span class="badge bg-secondary-subtle text-secondary border">بسته 🔒</span>
                                }
                                else if (p.IsOverdue)
                                {
                                    <span class="badge bg-danger-subtle text-danger border">⏰ گذشته از مهلت</span>
                                }
                                @PriorityBadge(p.Priority)
                            </td>
                            <td class="fs-8">@p.OwnerName</td>
                            <td>@ProgressCell(p.Progress, p.OpenOrderCount, p.ClosedOrderCount, p.OrderCount)</td>
                            <td class="fs-8 num">
                                @if (p.OrderCount == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    <span title="باز">@p.OpenOrderCount.Num() باز</span>
                                    <span class="text-muted"> / @p.OrderCount.Num()</span>
                                    @if (p.OverdueOrderCount > 0)
                                    {
                                        <div><span class="badge bg-danger-subtle text-danger border" title="دستورهای گذشته از مهلت">⏰ @p.OverdueOrderCount.Num()</span></div>
                                    }
                                }
                            </td>
                            <td class="fs-8">
                                @if (p.MemberCount == 0)
                                {
                                    <span class="text-muted">—</span>
                                }
                                else
                                {
                                    @string.Join("، ", p.MemberNames)
                                    @if (p.MemberCount > p.MemberNames.Count)
                                    {
                                        <span class="text-muted"> +@(p.MemberCount - p.MemberNames.Count) نفر</span>
                                    }
                                }
                            </td>
                            <td class="fs-8 num">
                                <div>@p.DueAt.ToFa()</div>
                                @if (p.Status == "Open")
                                {
                                    <div class="@DaysClass(p.DaysLeft)">@DaysText(p.DaysLeft)</div>
                                }
                            </td>
                            <td class="fs-8 text-muted">
                                @if (p.LastActivityAt != null)
                                {
                                    <div>@p.LastActivityText</div>
                                    <div class="num">@p.LastActivityAt.Value.ToFa()</div>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm" role="group">
                                    <button class="btn btn-outline-primary" title="جزئیات" @onclick="() => OpenDetail(p.Id)">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                    @if (p.Status == "Open" && (p.IsMine || access.CanUpdate))
                                    {
                                        <button class="btn btn-outline-secondary" title="تمدید مهلت" @onclick="() => OpenExtend(p)">
                                            <i class="bi bi-hourglass-split"></i>
                                        </button>
                                        <button class="btn btn-outline-secondary" title="ویرایش" @onclick="() => OpenEdit(p.Id)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-dark" title="بستن پروژه" @onclick="() => OpenClose(p)">
                                            <i class="bi bi-lock"></i>
                                        </button>
                                    }
                                    @if (p.Status == "Closed" && (p.IsMine || access.CanUpdate))
                                    {
                                        <button class="btn btn-outline-success" title="بازگشایی" @onclick="() => DoReopen(p.Id)">
                                            <i class="bi bi-unlock"></i>
                                        </button>
                                    }
                                    @if (access.CanDelete)
                                    {
                                        <button class="btn btn-outline-danger" title="حذف" @onclick="() => delId = p.Id">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
            <span class="fs-8 text-muted num">@totalCount.Num() پروژه</span>
            <Pager Page="page" PageCount="pageCount" OnPageChanged="GoToPage" />
        </div>
    }
}

@* ================== مودال ساخت/ویرایش ================== *@
<Modal Visible="showSave" Title="@(saveId > 0 ? "ویرایش پروژه" : "پروژه جدید")" OnClose="() => showSave = false">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <div class="alert alert-danger py-2">@saveError</div>
        }
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">عنوان <span class="text-danger">*</span></label>
                <input class="form-control" @bind="fTitle" placeholder="مثلاً: راه‌اندازی خط بسته‌بندی" />
            </div>
            <div class="col-12">
                <label class="form-label">شرح</label>
                <textarea class="form-control" rows="3" @bind="fDesc" placeholder="توضیح کوتاه درباره پروژه (اختیاری)…"></textarea>
            </div>
            <div class="col-6">
                <label class="form-label">تاریخ شروع</label>
                <DatePicker @bind-Value="fStart" />
            </div>
            <div class="col-6">
                <label class="form-label">مهلت پایان <span class="text-danger">*</span></label>
                <DatePicker @bind-Value="fDue" />
            </div>
            <div class="col-6">
                <label class="form-label">اولویت</label>
                <select class="form-select" @bind="fPriority">
                    <option value="0">کم</option>
                    <option value="1">عادی</option>
                    <option value="2">بالا</option>
                    <option value="3">فوری</option>
                </select>
            </div>
            <div class="col-6">
                <label class="form-label">برچسب‌ها <span class="text-muted fs-9">(با ویرگول جدا کنید)</span></label>
                <input class="form-control" @bind="fTagsText" placeholder="مثلاً: تولید، فاز یک" />
            </div>
            @if (saveId == 0)
            {
                <div class="col-12">
                    <label class="form-label">اعضای اولیه</label>
                    <MultiSearchSelect Items="users" Values="fMemberIds" ValuesChanged="(List<int> v) => fMemberIds = v"
                                       Placeholder="جستجوی همکاران…" />
                </div>
            }
            else
            {
                <div class="col-12 fs-8 text-muted">مدیریت اعضا از تب «اعضا» در جزئیات پروژه انجام می‌شود.</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary btn-sm" @onclick="() => showSave = false">انصراف</button>
        <button class="btn btn-primary btn-sm" disabled="@saveBusy" @onclick="DoSave">
            @if (saveBusy)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            else
            {
                <i class="bi bi-check-lg"></i>
            }
            ذخیره
        </button>
    </Footer>
</Modal>

@* ================== مودال جزئیات ================== *@
<Modal Visible="detail != null" Size="modal-xl" Title="@(detail == null ? "" : $"🏗 {detail.Number} — {detail.Title}")" OnClose="CloseDetail">
    <ChildContent>
        @if (detail != null)
        {
            var d = detail;
            <div class="d-flex gap-1 flex-wrap mb-3">
                <span class="badge @(d.Status == "Closed" ? "bg-secondary" : "bg-success")">@(d.Status == "Closed" ? "بسته 🔒" : "باز")</span>
                @PriorityBadge(d.Priority)
                @if (d.IsOverdue)
                {
                    <span class="badge bg-danger">⏰ گذشته از مهلت</span>
                }
                @if (d.ExtensionCount > 0)
                {
                    <span class="badge bg-warning-subtle text-warning border num">تمدید @d.ExtensionCount.Num() از ۵</span>
                }
            </div>
            <ul class="nav nav-tabs mb-3">
                <li class="nav-item">
                    <button type="button" class="nav-link @(detailTab == "summary" ? "active" : "")" @onclick='() => detailTab = "summary"'>خلاصه</button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(detailTab == "orders" ? "active" : "")" @onclick="OpenOrdersTab">
                        دستورها <span class="badge bg-light text-dark num">@d.OrderCount.Num()</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(detailTab == "members" ? "active" : "")" @onclick='() => detailTab = "members"'>
                        اعضا <span class="badge bg-light text-dark num">@d.Members.Count.Num()</span>
                    </button>
                </li>
                <li class="nav-item">
                    <button type="button" class="nav-link @(detailTab == "activity" ? "active" : "")" @onclick="OpenActivityTab">فعالیت‌ها</button>
                </li>
            </ul>

            @if (detailTab == "summary")
            {
                @if (!string.IsNullOrWhiteSpace(d.Description))
                {
                    <div class="alert alert-light border" style="white-space:pre-wrap">@d.Description</div>
                }
                <div class="row g-2 mb-3">
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fs-8 text-muted">مدیر پروژه</div><div class="fw-bold fs-8">@d.OwnerName</div></div></div>
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fs-8 text-muted">شروع</div><div class="fw-bold fs-8 num">@d.StartAt.ToFa()</div></div></div>
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fs-8 text-muted">مهلت</div><div class="fw-bold fs-8 num">@d.DueAt.ToFa()</div></div></div>
                    <div class="col-6 col-md-3"><div class="border rounded p-2 text-center"><div class="fs-8 text-muted">روزهای مانده</div><div class="fw-bold fs-8 num @DaysClass(d.DaysLeft)">@DaysText(d.DaysLeft)</div></div></div>
                </div>
                <div class="mb-3">
                    <div class="fs-8 text-muted mb-1">پیشرفت پروژه</div>
                    @ProgressCell(d.Progress, d.OpenOrderCount, d.ClosedOrderCount, d.OrderCount)
                </div>
                <div class="row g-2 mb-2">
                    <div class="col-4"><div class="border rounded p-2 text-center"><div class="fs-7 fw-bold num">@d.OpenOrderCount.Num()</div><div class="fs-8 text-muted">دستور باز</div></div></div>
                    <div class="col-4"><div class="border rounded p-2 text-center"><div class="fs-7 fw-bold num">@d.ClosedOrderCount.Num()</div><div class="fs-8 text-muted">دستور بسته</div></div></div>
                    <div class="col-4"><div class="border rounded p-2 text-center"><div class="fs-7 fw-bold num">@d.OverdueOrderCount.Num()</div><div class="fs-8 text-muted">گذشته‌ازمهلت</div></div></div>
                </div>
                @if (d.Tags.Count > 0)
                {
                    <div class="d-flex gap-1 flex-wrap align-items-center fs-8 mb-2">
                        <i class="bi bi-tags text-muted"></i>
                        @foreach (var t in d.Tags)
                        {
                            <span class="badge bg-light text-dark border">@t</span>
                        }
                    </div>
                }
                @if (d.Status == "Closed" && !string.IsNullOrWhiteSpace(d.CloseNote))
                {
                    <div class="fs-8"><span class="text-muted">یادداشت بستن:</span> @d.CloseNote</div>
                }
            }
            else if (detailTab == "orders")
            {
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
                    <div class="btn-group btn-group-sm" role="group">
                        <button class="btn @(ordStatus == "" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetOrdStatus("")'>همه</button>
                        <button class="btn @(ordStatus == "open" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetOrdStatus("open")'>باز</button>
                        <button class="btn @(ordStatus == "closed" ? "btn-primary" : "btn-outline-primary")" @onclick='() => SetOrdStatus("closed")'>بسته</button>
                    </div>
                    <button class="btn btn-sm btn-success" @onclick="GotoNewOrder">
                        <i class="bi bi-plus-lg"></i> دستور جدید برای این پروژه
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(ordersError))
                {
                    <div class="alert alert-warning py-2">@ordersError</div>
                }
                else if (ordersLoading)
                {
                    <div class="text-muted"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری دستورها…</div>
                }
                else if (orders.Count == 0)
                {
                    <div class="alert alert-light border text-center">دستوری به این پروژه وصل نیست.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-sm table-hover align-middle">
                            <thead>
                                <tr><th>شماره</th><th>عنوان</th><th>دستوردهنده</th><th>وضعیت</th><th>وزن</th><th style="min-width:110px">پیشرفت</th><th>مهلت</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var o in orders)
                                {
                                    <tr>
                                        <td class="num fs-8">@o.Number</td>
                                        <td class="fs-8">@o.Title</td>
                                        <td class="fs-8">@o.OwnerName</td>
                                        <td>
                                            @if (o.Status == "Closed")
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary border">بسته</span>
                                            }
                                            else if (o.DueAt < DateTime.Now)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border">⏰ گذشته</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success-subtle text-success border">باز</span>
                                            }
                                        </td>
                                        <td class="num fs-8" title="@(o.Weight == 0 ? "در پیشرفت حساب نمی‌شود" : $"وزن {o.Weight}")">
                                            @o.Weight.Num()
                                        </td>
                                        <td>
                                            <div class="d-flex align-items-center gap-1">
                                                <div class="progress flex-grow-1" style="height:8px">
                                                    <div class="progress-bar @(o.OrderProgress == 100 ? "bg-success" : "")" style="width:@o.OrderProgress%"></div>
                                                </div>
                                                <span class="fs-9 num">@o.OrderProgress.Num()٪</span>
                                            </div>
                                        </td>
                                        <td class="num fs-8">@o.DueAt.ToFa()</td>
                                        <td>
                                            <a class="btn btn-sm btn-outline-primary" title="باز کردن دستور" href="@($"/work-orders?open={o.Id}")" target="_blank">
                                                <i class="bi bi-box-arrow-up-left"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            }
            else if (detailTab == "members")
            {
                @if (d.Members.Count == 0)
                {
                    <div class="alert alert-light border text-center">این پروژه عضوی ندارد.</div>
                }
                else
                {
                    <ul class="list-group mb-3">
                        @foreach (var m in d.Members)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center">
                                <span><i class="bi bi-person ms-1"></i> @m.Name</span>
                                <span class="d-flex align-items-center gap-2">
                                    <span class="fs-8 text-muted num">@m.AddedAt.ToFa()</span>
                                    @if (d.CanManage && d.Status == "Open")
                                    {
                                        <button class="btn btn-sm btn-outline-danger" title="حذف عضو" @onclick="() => RemoveMember(m.UserId)">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    }
                                </span>
                            </li>
                        }
                    </ul>
                }
                @if (d.CanManage && d.Status == "Open")
                {
                    <div class="d-flex gap-2">
                        <div class="flex-grow-1">
                            <MultiSearchSelect Items="users" Values="addMemberIds" ValuesChanged="(List<int> v) => addMemberIds = v"
                                               Placeholder="انتخاب همکاران…" />
                        </div>
                        <button class="btn btn-primary btn-sm text-nowrap" disabled="@(addMemberIds.Count == 0 || memberBusy)" @onclick="AddMembers">
                            @if (memberBusy)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-plus-lg"></i>
                            }
                            افزودن
                        </button>
                    </div>
                }
            }
            else if (detailTab == "activity")
            {
                @if (activity.Count == 0 && !activityLoading)
                {
                    <div class="alert alert-light border text-center">فعالیتی ثبت نشده است.</div>
                }
                else
                {
                    <ul class="list-group mb-2">
                        @foreach (var a in activity)
                        {
                            <li class="list-group-item">
                                <div class="d-flex justify-content-between flex-wrap gap-1">
                                    <span class="fs-8"><b>@a.ActorName</b> — @a.ActionFa</span>
                                    <span class="fs-8 text-muted num">@a.CreatedAt.ToFa() @a.CreatedAt.ToString("HH:mm")</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(a.Text))
                                {
                                    <div class="fs-8 text-muted mt-1">@a.Text</div>
                                }
                            </li>
                        }
                    </ul>
                    @if (activityLoading)
                    {
                        <div class="text-muted fs-8"><span class="spinner-border spinner-border-sm"></span> …</div>
                    }
                    else if (activityHasMore)
                    {
                        <button class="btn btn-sm btn-outline-secondary" @onclick="LoadMoreActivity">نمایش بیشتر</button>
                    }
                }
            }
        }
    </ChildContent>
    <Footer>
        @if (detail != null && detail.CanManage)
        {
            @if (detail.Status == "Open")
            {
                <button class="btn btn-sm btn-outline-secondary" @onclick="() => OpenExtendFromDetail()">⏳ تمدید</button>
                <button class="btn btn-sm btn-outline-dark" @onclick="() => OpenCloseFromDetail()">🔒 بستن</button>
            }
            else
            {
                <button class="btn btn-sm btn-outline-success" @onclick="() => DoReopen(detail.Id)">بازگشایی</button>
            }
        }
        <button class="btn btn-sm btn-secondary" @onclick="CloseDetail">بستن</button>
    </Footer>
</Modal>

@* ================== مودال تمدید ================== *@
<Modal Visible="extId > 0" Title="تمدید مهلت پروژه" OnClose="() => extId = 0">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(extError))
        {
            <div class="alert alert-danger py-2">@extError</div>
        }
        <div class="mb-2 fs-8 text-muted num">تمدیدهای استفاده‌شده: @extUsed.Num() از ۵</div>
        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">مهلت جدید <span class="text-danger">*</span></label>
                <DatePicker @bind-Value="extDue" />
            </div>
            <div class="col-12">
                <label class="form-label">دلیل تمدید <span class="text-danger">*</span></label>
                <textarea class="form-control" rows="2" @bind="extNote" placeholder="چرا مهلت تمدید می‌شود؟"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary btn-sm" @onclick="() => extId = 0">انصراف</button>
        <button class="btn btn-primary btn-sm" disabled="@extBusy" @onclick="DoExtend">
            @if (extBusy)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            ثبت تمدید
        </button>
    </Footer>
</Modal>

@* ================== مودال بستن ================== *@
<Modal Visible="closeId > 0" Title="بستن پروژه" OnClose="() => closeId = 0">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(closeError))
        {
            <div class="alert alert-danger py-2">@closeError</div>
        }
        <p class="fs-8 text-muted">بستن فقط وقتی ممکن است که هیچ دستور بازی به پروژه وصل نباشد.</p>
        <label class="form-label">یادداشت بستن (اختیاری)</label>
        <textarea class="form-control" rows="2" @bind="closeNote"></textarea>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary btn-sm" @onclick="() => closeId = 0">انصراف</button>
        <button class="btn btn-dark btn-sm" disabled="@closeBusy" @onclick="DoClose">
            @if (closeBusy)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            بستن پروژه
        </button>
    </Footer>
</Modal>

@* ================== مودال حذف ================== *@
<Modal Visible="delId > 0" Title="حذف پروژه" OnClose="() => delId = 0">
    <ChildContent>
        @if (!string.IsNullOrWhiteSpace(delError))
        {
            <div class="alert alert-danger py-2">@delError</div>
        }
        <p>پروژه حذف شود؟ سوابق دستورهای متصل محفوظ می‌ماند. حذف فقط وقتی ممکن است که دستور بازی وصل نباشد.</p>
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary btn-sm" @onclick="() => delId = 0">انصراف</button>
        <button class="btn btn-danger btn-sm" disabled="@delBusy" @onclick="DoDelete">
            @if (delBusy)
            {
                <span class="spinner-border spinner-border-sm"></span>
            }
            بله، حذف شود
        </button>
    </Footer>
</Modal>

@code {
    private class Access
    {
        public int UserId { get; set; }
        public bool CanView { get; set; }
        public bool CanCreate { get; set; }
        public bool CanUpdate { get; set; }
        public bool CanDelete { get; set; }
    }

    private class ProjOrder
    {
        public int Id { get; set; }
        public string Number { get; set; } = "";
        public string Title { get; set; } = "";
        public string OwnerName { get; set; } = "";
        public string Status { get; set; } = "Open";
        public int Priority { get; set; }
        public DateTime DueAt { get; set; }
        public int Weight { get; set; }
        public int OrderProgress { get; set; }
    }

    private class ErrObj { public string? Message { get; set; } }

    private Access access = new();
    private bool accessLoaded, loading;
    private List<WorkProjectListItemDto> items = new();
    private int page = 1, totalCount, pageSize = 20;
    private int pageCount => Math.Max(1, (totalCount + pageSize - 1) / pageSize);

    private string fltQ = "", fltStatus = "", fltMine = "", fltSort = "due";
    private bool fltOverdue;
    private System.Threading.CancellationTokenSource? searchCts;

    private List<LookupItem> users = new();
    private bool usersLoaded;

    // ---------- مودال ساخت/ویرایش ----------
    private bool showSave, saveBusy;
    private string saveError = "";
    private int saveId;
    private string fTitle = "", fDesc = "", fTagsText = "";
    private DateTime? fStart, fDue;
    private int fPriority = 1;
    private List<int> fMemberIds = new();

    // ---------- جزئیات ----------
    private WorkProjectDetailDto? detail;
    private string detailTab = "summary";
    private List<ProjOrder> orders = new();
    private bool ordersLoading;
    private string ordersError = "", ordStatus = "";
    private List<int> addMemberIds = new();
    private bool memberBusy;
    private List<WorkProjectLogDto> activity = new();
    private bool activityLoading, activityHasMore;
    private int activitySkip;

    // ---------- تمدید/بستن/حذف ----------
    private int extId, extUsed;
    private DateTime? extDue;
    private string extNote = "", extError = "";
    private bool extBusy;
    private int closeId;
    private string closeNote = "", closeError = "";
    private bool closeBusy;
    private int delId;
    private string delError = "";
    private bool delBusy;

    protected override async Task OnInitializedAsync()
    {
        Rt.DataChanged += OnRtChanged;
        try
        {
            access = await Http.GetFromJsonAsync<Access>("/api/workprojects/my-access") ?? new();
        }
        catch { }
        accessLoaded = true;
        if (!access.CanView) return;
        await LoadList();
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (int.TryParse(qs["open"], out var openId) && openId > 0)
            await OpenDetail(openId);
    }

    public void Dispose() => Rt.DataChanged -= OnRtChanged;

    private void OnRtChanged(string scope)
    {
        if (scope != "workprojects" && scope != "workorders") return;
        _ = InvokeAsync(async () =>
        {
            await LoadList(silent: true);
            if (detail != null)
            {
                await RefreshDetail(silent: true);
                if (detailTab == "orders") await LoadOrders(silent: true);
            }
            StateHasChanged();
        });
    }

    private async Task<string> ErrMsg(HttpResponseMessage r)
    {
        try
        {
            var t = await r.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(t)) return $"خطای سرور ({(int)r.StatusCode})";
            try
            {
                var m = System.Text.Json.JsonSerializer.Deserialize<ErrObj>(t,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                return string.IsNullOrWhiteSpace(m?.Message) ? t : m.Message;
            }
            catch { return t; }
        }
        catch { return "خطای ارتباط با سرور."; }
    }

    // ================== لیست ==================

    private async Task LoadList(bool silent = false)
    {
        if (!silent) loading = true;
        try
        {
            var qs = $"page={page}&pageSize={pageSize}";
            if (!string.IsNullOrWhiteSpace(fltQ)) qs += $"&q={Uri.EscapeDataString(fltQ.Trim())}";
            if (!string.IsNullOrWhiteSpace(fltStatus)) qs += $"&status={fltStatus}";
            if (!string.IsNullOrWhiteSpace(fltMine)) qs += $"&mine={fltMine}";
            if (fltOverdue) qs += "&overdue=true";
            qs += $"&sort={fltSort}";
            var res = await Http.GetFromJsonAsync<WorkProjectPageDto>($"/api/workprojects?{qs}") ?? new();
            items = res.Items;
            totalCount = res.TotalCount;
            page = res.Page;
        }
        catch (Exception ex) { if (!silent) Toast.Error(ex.Message); }
        finally { if (!silent) loading = false; }
    }

    private async Task GoToPage(int p)
    {
        if (p < 1 || p > pageCount || p == page) return;
        page = p;
        await LoadList();
    }

    private void OnSearchInput(ChangeEventArgs e)
    {
        fltQ = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        searchCts = new System.Threading.CancellationTokenSource();
        var token = searchCts.Token;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(450, token);
                if (token.IsCancellationRequested) return;
                await InvokeAsync(async () => { page = 1; await LoadList(); StateHasChanged(); });
            }
            catch { }
        });
    }

    private async Task OnStatusChanged(ChangeEventArgs e) { fltStatus = e.Value?.ToString() ?? ""; page = 1; await LoadList(); }
    private async Task OnMineChanged(ChangeEventArgs e) { fltMine = e.Value?.ToString() ?? ""; page = 1; await LoadList(); }
    private async Task OnSortChanged(ChangeEventArgs e) { fltSort = e.Value?.ToString() ?? "due"; page = 1; await LoadList(); }
    private async Task OnOverdueChanged(ChangeEventArgs e) { fltOverdue = (bool)(e.Value ?? false); page = 1; await LoadList(); }

    private async Task EnsureUsersAsync()
    {
        if (usersLoaded) return;
        try { users = await Http.GetFromJsonAsync<List<LookupItem>>("/api/workprojects/users") ?? new(); }
        catch { users = new(); }
        usersLoaded = true;
    }

    // ================== ساخت/ویرایش ==================

    private async Task OpenCreate()
    {
        saveId = 0; saveError = "";
        fTitle = ""; fDesc = ""; fTagsText = "";
        fStart = DateTime.Today; fDue = DateTime.Today.AddDays(7);
        fPriority = 1; fMemberIds = new();
        await EnsureUsersAsync();
        showSave = true;
    }

    private async Task OpenEdit(int id)
    {
        saveError = "";
        try
        {
            var d = await Http.GetFromJsonAsync<WorkProjectDetailDto>($"/api/workprojects/{id}");
            if (d == null) return;
            saveId = d.Id;
            fTitle = d.Title; fDesc = d.Description ?? "";
            fStart = d.StartAt.Date; fDue = d.DueAt.Date;
            fPriority = d.Priority;
            fTagsText = string.Join("، ", d.Tags);
            fMemberIds = new();
            showSave = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DoSave()
    {
        saveError = "";
        if (string.IsNullOrWhiteSpace(fTitle)) { saveError = "عنوان پروژه را وارد کنید."; return; }
        if (fDue == null) { saveError = "مهلت پایان را انتخاب کنید."; return; }
        saveBusy = true;
        try
        {
            var payload = new SaveWorkProjectDto
            {
                Id = saveId, Title = fTitle.Trim(), Description = fDesc,
                StartAt = (fStart ?? DateTime.Today).Date, DueAt = fDue.Value.Date,
                Priority = fPriority, MemberIds = fMemberIds,
                Tags = fTagsText.Split(new[] { ',', '،', '\n' }, StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries).ToList()
            };
            var resp = saveId > 0
                ? await Http.PutAsJsonAsync($"/api/workprojects/{saveId}", payload)
                : await Http.PostAsJsonAsync("/api/workprojects", payload);
            if (!resp.IsSuccessStatusCode) { saveError = await ErrMsg(resp); return; }
            Toast.Success(saveId > 0 ? "تغییرات ذخیره شد." : "پروژه ساخته شد.");
            showSave = false;
            page = 1;
            await LoadList();
            if (detail != null && saveId == detail.Id) await RefreshDetail();
        }
        catch (Exception ex) { saveError = ex.Message; }
        finally { saveBusy = false; }
    }

    // ================== جزئیات ==================

    private async Task OpenDetail(int id)
    {
        detailTab = "summary";
        orders = new(); ordersError = ""; ordStatus = "";
        activity = new(); activitySkip = 0; activityHasMore = false;
        addMemberIds = new();
        try
        {
            detail = await Http.GetFromJsonAsync<WorkProjectDetailDto>($"/api/workprojects/{id}");
            if (detail != null) await EnsureUsersAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void CloseDetail()
    {
        detail = null;
        if (new Uri(Nav.Uri).Query.Contains("open=")) Nav.NavigateTo("/work-projects");
    }

    private async Task RefreshDetail(bool silent = false)
    {
        if (detail == null) return;
        try
        {
            var d = await Http.GetFromJsonAsync<WorkProjectDetailDto>($"/api/workprojects/{detail.Id}");
            if (d != null) detail = d;
        }
        catch (Exception ex) { if (!silent) Toast.Error(ex.Message); }
    }

    private async Task OpenOrdersTab()
    {
        detailTab = "orders";
        await LoadOrders();
    }

    private async Task SetOrdStatus(string s)
    {
        ordStatus = s;
        await LoadOrders();
    }

    private async Task LoadOrders(bool silent = false)
    {
        if (detail == null) return;
        ordersError = "";
        if (!silent) ordersLoading = true;
        try
        {
            var url = $"/api/workorders/by-project/{detail.Id}";
            if (!string.IsNullOrWhiteSpace(ordStatus)) url += $"?status={ordStatus}";
            orders = await Http.GetFromJsonAsync<List<ProjOrder>>(url) ?? new();
        }
        catch
        {
            orders = new();
            ordersError = "نمایش دستورها ممکن نیست (دسترسی به دستورهای کار ندارید یا خطای سرور).";
            if (!silent) StateHasChanged();
        }
        finally { if (!silent) ordersLoading = false; }
    }

    private void GotoNewOrder()
    {
        if (detail == null) return;
        Nav.NavigateTo($"/work-orders?projectId={detail.Id}");
    }

    private async Task AddMembers()
    {
        if (detail == null || addMemberIds.Count == 0) return;
        memberBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workprojects/{detail.Id}/members",
                new AddWorkProjectMembersDto { UserIds = addMemberIds });
            if (!resp.IsSuccessStatusCode) { Toast.Error(await ErrMsg(resp)); return; }
            Toast.Success("عضو اضافه شد.");
            addMemberIds = new();
            await RefreshDetail();
            await LoadList(silent: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { memberBusy = false; }
    }

    private async Task RemoveMember(int userId)
    {
        if (detail == null) return;
        try
        {
            var resp = await Http.DeleteAsync($"/api/workprojects/{detail.Id}/members/{userId}");
            if (!resp.IsSuccessStatusCode) { Toast.Error(await ErrMsg(resp)); return; }
            Toast.Success("عضو حذف شد.");
            await RefreshDetail();
            await LoadList(silent: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task OpenActivityTab()
    {
        detailTab = "activity";
        if (activity.Count == 0)
        {
            activitySkip = 0;
            await LoadActivity(more: false);
        }
    }

    private async Task LoadMoreActivity() => await LoadActivity(more: true);

    private async Task LoadActivity(bool more)
    {
        if (detail == null) return;
        activityLoading = true;
        try
        {
            var skip = more ? activitySkip : 0;
            var rows = await Http.GetFromJsonAsync<List<WorkProjectLogDto>>(
                $"/api/workprojects/{detail.Id}/activity?skip={skip}&take=20") ?? new();
            if (more) activity.AddRange(rows);
            else activity = rows;
            activitySkip = skip + rows.Count;
            activityHasMore = rows.Count >= 20;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { activityLoading = false; }
    }

    // ================== تمدید/بستن/بازگشایی/حذف ==================

    private void OpenExtend(WorkProjectListItemDto p)
    {
        extId = p.Id; extUsed = p.ExtensionCount; extError = "";
        extDue = p.DueAt.Date.AddDays(7); extNote = "";
    }

    private void OpenExtendFromDetail()
    {
        if (detail == null) return;
        OpenExtend(detail);
    }

    private async Task DoExtend()
    {
        extError = "";
        if (extDue == null) { extError = "مهلت جدید را انتخاب کنید."; return; }
        if (string.IsNullOrWhiteSpace(extNote)) { extError = "دلیل تمدید را وارد کنید."; return; }
        extBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workprojects/{extId}/extend",
                new ExtendWorkProjectDto { NewDueAt = extDue.Value.Date, Note = extNote });
            if (!resp.IsSuccessStatusCode) { extError = await ErrMsg(resp); return; }
            Toast.Success("مهلت پروژه تمدید شد.");
            extId = 0;
            await LoadList();
            if (detail != null) await RefreshDetail();
        }
        catch (Exception ex) { extError = ex.Message; }
        finally { extBusy = false; }
    }

    private void OpenClose(WorkProjectListItemDto p)
    {
        closeId = p.Id; closeNote = ""; closeError = "";
    }

    private void OpenCloseFromDetail()
    {
        if (detail == null) return;
        OpenClose(detail);
    }

    private async Task DoClose()
    {
        closeError = "";
        closeBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workprojects/{closeId}/close",
                new CloseWorkProjectDto { Note = closeNote });
            if (!resp.IsSuccessStatusCode) { closeError = await ErrMsg(resp); return; }
            Toast.Success("پروژه بسته شد.");
            closeId = 0;
            await LoadList();
            if (detail != null) await RefreshDetail();
        }
        catch (Exception ex) { closeError = ex.Message; }
        finally { closeBusy = false; }
    }

    private async Task DoReopen(int id)
    {
        try
        {
            var resp = await Http.PostAsync($"/api/workprojects/{id}/reopen", null);
            if (!resp.IsSuccessStatusCode) { Toast.Error(await ErrMsg(resp)); return; }
            Toast.Success("پروژه بازگشایی شد.");
            await LoadList();
            if (detail != null) await RefreshDetail();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DoDelete()
    {
        delError = "";
        delBusy = true;
        try
        {
            var resp = await Http.DeleteAsync($"/api/workprojects/{delId}");
            if (!resp.IsSuccessStatusCode) { delError = await ErrMsg(resp); return; }
            Toast.Success("پروژه حذف شد.");
            var wasDetail = detail?.Id == delId;
            delId = 0;
            if (wasDetail) detail = null;
            await LoadList();
        }
        catch (Exception ex) { delError = ex.Message; }
        finally { delBusy = false; }
    }

    // ================== نمایشی ==================

    private RenderFragment PriorityBadge(int p) => p switch
    {
        0 => @<span class="badge bg-light text-dark border">کم</span>,
        2 => @<span class="badge bg-warning-subtle text-warning border">بالا</span>,
        3 => @<span class="badge bg-danger-subtle text-danger border">فوری</span>,
        _ => @<span></span>
    };

    private RenderFragment ProgressCell(int? progress, int open, int closed, int total) =>
        progress == null
            ? @<span class="fs-8 text-muted">بدون دستور</span>
            : @<div class="d-flex align-items-center gap-1">
                <div class="progress flex-grow-1" style="height:10px">
                    <div class="progress-bar @(progress == 100 ? "bg-success" : "")" style="width:@progress%"></div>
                </div>
                <span class="fs-8 num fw-bold">@progress.Value.Num()٪</span>
            </div>;

    private static string DaysClass(int days) => days < 0 ? "text-danger" : days == 0 ? "text-warning fw-bold" : days <= 3 ? "text-warning" : "text-muted";
    private static string DaysText(int days) => days < 0 ? $"{(-days).Num()} روز گذشته" : days == 0 ? "امروز" : $"{days.Num()} روز مانده";
}
