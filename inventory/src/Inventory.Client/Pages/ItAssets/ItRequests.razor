@namespace Inventory.Client.Pages
@page "/it-requests"
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS
@inject LayoutState Layout
@inject NavigationManager Nav
@inject RealtimeService Rt
@implements IDisposable

<PageTitle>درخواست خدمت IT</PageTitle>

<div class="page-head">
    <div>
        <h1>درخواست خدمت از واحد IT</h1>
        <p class="lead">ثبت درخواست، ارجاع به کارشناس، پاسخ و تایید نهایی</p>
    </div>
    @if (access.CanCreate)
    {
        <button class="btn btn-primary me-auto" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> درخواست جدید
        </button>
    }
</div>

@* ================== حالت شعبه: درخواست‌های ارسال‌شده به سرور مرکزی ================== *@
@if (remoteMode)
{
    <div class="alert alert-info py-2 fs-8 mb-3">
        <i class="bi bi-hdd-network"></i>
        این نرم‌افزار به‌عنوان <b>شعبه</b> پیکربندی شده — درخواست‌ها به سرور مرکزی
        (<span class="num" dir="ltr">@remoteUrl</span>) ارسال می‌شوند.
        <button class="btn btn-sm btn-outline-primary me-2" @onclick="LoadRemote"><i class="bi bi-arrow-clockwise"></i> بروزرسانی وضعیت</button>
    </div>

    @if (loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (remoteReqs.Count == 0)
    {
        <div class="itr-empty">
            <i class="bi bi-inbox"></i>
            <h5>هنوز درخواستی ارسال نکرده‌اید</h5>
            <button class="btn btn-primary mt-2" @onclick="OpenNew"><i class="bi bi-plus-lg"></i> ثبت اولین درخواست</button>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var rr in remoteReqs)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="itr-card itr-st-@rr.Status.ToLower()">
                        <div class="itr-card-strip"></div>
                        <div class="itr-card-body">
                            <div class="d-flex align-items-start justify-content-between gap-2">
                                <div class="itr-title">@rr.Title</div>
                                @if (rr.Status == "Completed")
                                {
                                    <span class="badge bg-success-subtle text-success border">تکمیل شده ✔</span>
                                }
                                else if (rr.Status == "Rejected")
                                {
                                    <span class="badge bg-danger-subtle text-danger border">رد شده ✖</span>
                                }
                                else if (rr.Status == "ManagerApproved")
                                {
                                    <span class="badge bg-info-subtle text-info border">در انتظار تایید شما</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border">در حال بررسی در مرکز</span>
                                }
                            </div>
                            <div class="itr-number num">@rr.Number</div>
                            @if (!string.IsNullOrWhiteSpace(rr.FinalResponse))
                            {
                                <div class="itr-desc"><i class="bi bi-chat-left-text text-primary"></i> @rr.FinalResponse</div>
                            }
                            <div class="itr-foot">
                                <span class="fs-8 text-muted"><i class="bi bi-calendar3"></i> @rr.CreatedAt.ToFa()</span>
                                @if (rr.Status == "ManagerApproved")
                                {
                                    <button class="btn btn-success btn-sm" disabled="@busy" @onclick="() => RemoteComplete(rr)">
                                        <i class="bi bi-check2-all"></i> تایید و تکمیل
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
}
else
{
@* ================== تب‌ها / کارتابل‌ها ================== *@
<div class="itr-tabs mb-3">
    <button class="itr-tab @(tab == "mine" ? "active" : "")" @onclick='() => SwitchTab("mine")'>
        <i class="bi bi-person"></i> درخواست‌های من
        <span class="itr-tab-badge">@myItems.Count</span>
    </button>
    @if (access.IsExpert)
    {
        <button class="itr-tab @(tab == "expert" ? "active" : "")" @onclick='() => SwitchTab("expert")'>
            <i class="bi bi-tools"></i> کارتابل کارشناس
            <span class="itr-tab-badge">@expertItems.Count(r => r.Status == "Assigned")</span>
        </button>
    }
    @if (access.IsManager)
    {
        <button class="itr-tab @(tab == "manager" ? "active" : "")" @onclick='() => SwitchTab("manager")'>
            <i class="bi bi-person-gear"></i> کارتابل مدیر IT
            <span class="itr-tab-badge">@managerItems.Count(r => r.Status == "New")</span>
        </button>
    }
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (!CurrentItems.Any())
{
    <div class="itr-empty">
        <i class="bi bi-inbox"></i>
        <h5>درخواستی وجود ندارد</h5>
        @if (tab == "mine" && access.CanCreate)
        {
            <button class="btn btn-primary mt-2" @onclick="OpenNew"><i class="bi bi-plus-lg"></i> ثبت اولین درخواست</button>
        }
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var r in CurrentItems)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="itr-card itr-st-@r.Status.ToLower()" @onclick="() => OpenDetail(r)">
                    <div class="itr-card-strip"></div>
                    <div class="itr-card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div class="itr-title">
                                @if (!r.Seen)
                                {
                                    <span class="itr-new" title="رویت نشده"><i class="bi bi-circle-fill"></i> جدید</span>
                                }
                                @r.Title
                            </div>
                            @StatusBadge(r, tab)
                        </div>
                        <div class="itr-number num">@r.Number</div>
                        <div class="itr-meta">
                            <span class="itr-type">@TypeFa(r.RequestType)</span>
                            <span class="d-inline-flex align-items-center gap-1">
                                @if (r.RequesterUserId > 0) { <UserAvatar LoginUserId="r.RequesterUserId" Size="22" CssClass="user-avatar-sm" /> }
                                else { <i class="bi bi-person"></i> }
                                @r.RequesterName
                            </span>
                            @if (!string.IsNullOrWhiteSpace(r.SystemLabel))
                            {
                                <span><i class="bi bi-pc-display"></i> @r.SystemLabel</span>
                            }
                        </div>
                        <div class="itr-foot">
                            <span class="fs-8 text-muted"><i class="bi bi-calendar3"></i> @r.CreatedAt.ToFa()</span>
                            <div class="d-flex gap-2 align-items-center">
                                @if (r.AttachmentCount > 0)
                                {
                                    <span class="fs-8 text-muted"><i class="bi bi-paperclip"></i> @r.AttachmentCount</span>
                                }
                                @if (tab != "mine" && r.Assignments.Any())
                                {
                                    @* بند ۱۱: مدیر می‌بیند چند کارشناس پاسخ داده‌اند *@
                                    <span class="fs-8 @(r.Assignments.Count(a => a.ReportSubmitted) == r.Assignments.Count ? "text-success fw-700" : "text-warning fw-700")">
                                        <i class="bi bi-chat-dots"></i> @r.Assignments.Count(a => a.ReportSubmitted)/@r.Assignments.Count گزارش
                                    </span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>

    @* ================== صفحه‌بندی ================== *@
    @if (TotalPages > 1)
    {
        <div class="itr-pager mt-3">
            <button class="itr-page-btn" disabled="@(page <= 1)" @onclick="() => GoPage(page - 1)">
                <i class="bi bi-chevron-right"></i> قبلی
            </button>
            @for (var pn = 1; pn <= TotalPages; pn++)
            {
                var p2 = pn;
                <button class="itr-page-btn num @(page == p2 ? "active" : "")" @onclick="() => GoPage(p2)">@p2</button>
            }
            <button class="itr-page-btn" disabled="@(page >= TotalPages)" @onclick="() => GoPage(page + 1)">
                بعدی <i class="bi bi-chevron-left"></i>
            </button>
            <span class="fs-8 text-muted me-2">@AllTabItems.Count() درخواست</span>
        </div>
    }
}
}

@* ================== مودال درخواست جدید ================== *@
@if (showNew)
{
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content itr-modal">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-headset text-primary"></i> درخواست خدمت جدید</h5>
                    <button type="button" class="btn-close" @onclick="() => showNew = false"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger py-2">@formError</div>
                    }
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label">نام و نام خانوادگی درخواست‌کننده</label>
                            <div class="input-group">
                                <input class="form-control" @bind="newForm.RequesterName" disabled="@(!editName)" />
                                <button class="btn btn-outline-secondary" type="button" title="ویرایش نام"
                                        @onclick="() => editName = !editName">
                                    <i class="bi @(editName ? "bi-lock" : "bi-pencil")"></i>
                                </button>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">نوع درخواست <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="newForm.RequestType">
                                <option value="Hardware">سخت‌افزار</option>
                                <option value="Software">نرم‌افزار</option>
                                <option value="Network">شبکه و زیرساخت</option>
                                <option value="Telecom">مخابرات</option>
                            </select>
                        </div>
                        <div class="col-12">
                            <label class="form-label">سیستم مربوطه</label>
                            @* ================== کمبوی سیستم با جستجو ================== *@
                            <div class="ms-combo">
                                <div class="ms-combo-control form-control @(sysDropOpen ? "focus" : "")" @onclick="() => sysDropOpen = !sysDropOpen">
                                    @if (newForm.SystemInfoId is null)
                                    {
                                        <span class="text-muted">— بدون سیستم / سایر —</span>
                                    }
                                    else
                                    {
                                        var sel = systems.FirstOrDefault(s => s.Id == newForm.SystemInfoId);
                                        <span class="ms-chip">
                                            @SysLabel(sel)
                                            <i class="bi bi-x-circle-fill" @onclick:stopPropagation="true"
                                               @onclick="() => newForm.SystemInfoId = null"></i>
                                        </span>
                                    }
                                    <i class="bi bi-chevron-@(sysDropOpen ? "up" : "down") ms-caret"></i>
                                </div>
                                @if (sysDropOpen)
                                {
                                    <div class="ms-combo-menu shadow">
                                        <div class="p-2 border-bottom">
                                            <input class="form-control form-control-sm" placeholder="جستجو (نام سیستم، IP، مالک)..."
                                                   @bind="sysSearch" @bind:event="oninput" @onclick:stopPropagation="true" />
                                        </div>
                                        <div class="ms-combo-items">
                                            <div class="ms-combo-item" @onclick="() => PickSystem(null)">
                                                <i class="bi bi-dash-circle"></i><span>بدون سیستم / سایر</span>
                                            </div>
                                            @foreach (var s in FilteredSystems)
                                            {
                                                <div class="ms-combo-item @(newForm.SystemInfoId == s.Id ? "sel" : "")" @onclick="() => PickSystem(s.Id)">
                                                    <i class="bi bi-pc-display"></i>
                                                    <span>@s.Label</span>
                                                    @if (!string.IsNullOrWhiteSpace(s.Ip))
                                                    {
                                                        <span class="badge bg-light text-dark border num">@s.Ip</span>
                                                    }
                                                    <small class="text-muted ms-auto">@s.UserName @(string.IsNullOrWhiteSpace(s.DepartmentName) ? "" : $"— {s.DepartmentName}")</small>
                                                </div>
                                            }
                                            @if (!FilteredSystems.Any())
                                            {
                                                <div class="px-3 py-2 text-muted fs-8">سیستمی پیدا نشد.</div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label">موضوع درخواست <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="newForm.Title" placeholder="مثلاً: سیستم روشن نمی‌شود" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">شرح درخواست</label>
                            @* ================== ادیتور متن ================== *@
                            <div class="rte-toolbar">
                                <button type="button" title="پررنگ" @onclick='() => RteCmd("bold")'><i class="bi bi-type-bold"></i></button>
                                <button type="button" title="مورب" @onclick='() => RteCmd("italic")'><i class="bi bi-type-italic"></i></button>
                                <button type="button" title="زیرخط" @onclick='() => RteCmd("underline")'><i class="bi bi-type-underline"></i></button>
                                <button type="button" title="لیست" @onclick='() => RteCmd("insertUnorderedList")'><i class="bi bi-list-ul"></i></button>
                                <button type="button" title="لیست عددی" @onclick='() => RteCmd("insertOrderedList")'><i class="bi bi-list-ol"></i></button>
                                <button type="button" title="پاک‌کردن قالب" @onclick='() => RteCmd("removeFormat")'><i class="bi bi-eraser"></i></button>
                            </div>
                            <div id="rte-desc" class="rte-editor" contenteditable="true"></div>
                        </div>
                        <div class="col-12" hidden="@remoteMode">
                            <label class="form-label"><i class="bi bi-paperclip"></i> فایل پیوست (اختیاری — حداکثر ۱۰ مگابایت)</label>
                            <InputFile class="form-control" OnChange="OnNewFileSelected" multiple />
                            @if (newFiles.Count > 0)
                            {
                                <div class="fs-8 text-success mt-1">@newFiles.Count فایل انتخاب شد.</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="() => showNew = false">انصراف</button>
                    <button class="btn btn-primary px-4" disabled="@busy" @onclick="SubmitNew">
                        @if (busy) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                        <i class="bi bi-send"></i> ثبت درخواست
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ================== مودال جزئیات / گردش‌کار ================== *@
@if (detail != null)
{
    var isRequesterView = tab == "mine";
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content itr-modal">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1">@detail.Title</h5>
                        <span class="badge bg-dark-subtle text-dark border num me-1">@detail.Number</span>
                        @StatusBadge(detail, tab) <span class="itr-type">@TypeFa(detail.RequestType)</span>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseDetail"></button>
                </div>
                <div class="modal-body">
                    <div class="itr-info-grid mb-3">
                        <div><span class="itr-lbl">درخواست‌کننده</span><span class="d-inline-flex align-items-center gap-2">@if (detail.RequesterUserId > 0) { <UserAvatar LoginUserId="detail.RequesterUserId" Size="30" /> }@detail.RequesterName</span></div>
                        <div><span class="itr-lbl">تاریخ ثبت</span><span class="num">@detail.CreatedAt.ToFa()</span></div>
                        @if (!string.IsNullOrWhiteSpace(detail.SystemLabel))
                        {
                            <div><span class="itr-lbl">سیستم</span><span>@detail.SystemLabel</span></div>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(detail.Description))
                    {
                        <div class="itr-block mb-3">
                            <div class="itr-block-title"><i class="bi bi-card-text"></i> شرح درخواست</div>
                            <div class="itr-block-body">@((MarkupString)detail.Description)</div>
                        </div>
                    }

                    @* ---------- پیوست‌ها ---------- *@
                    <div class="itr-block mb-3">
                        <div class="itr-block-title"><i class="bi bi-paperclip"></i> پیوست‌ها (@attachments.Count)</div>
                        <div class="itr-block-body">
                            @if (attachments.Count == 0)
                            {
                                <span class="fs-8 text-muted">پیوستی ثبت نشده است.</span>
                            }
                            @foreach (var a in attachments)
                            {
                                <a class="itr-att" href="@($"{apiBase}/api/itrequests/attachments/{a.Id}/download")" target="_blank">
                                    <i class="bi bi-file-earmark-arrow-down"></i> @a.FileName
                                    <span class="fs-8 text-muted">(@RoleFa(a.UploaderRole) — @a.UploaderName)</span>
                                </a>
                            }
                            <div class="mt-2">
                                <InputFile class="form-control form-control-sm" OnChange="e => UploadDetailFile(e)" />
                            </div>
                        </div>
                    </div>

                    @* ================== بخش‌های داخلی واحد IT — درخواست‌دهنده نمی‌بیند (بند ۷) ================== *@
                    @if (!isRequesterView)
                    {
                        @* ---------- اقدام مستقیم مدیر: بستن یا رد ---------- *@
                        @if (access.IsManager && detail.Status is "New" or "Assigned")
                        {
                            <div class="itr-block mb-3" style="border-color:#e9d5ff">
                                <div class="itr-block-title" style="background:#faf5ff"><i class="bi bi-person-check" style="color:#7c3aed"></i> اقدام مستقیم مدیر</div>
                                <div class="itr-block-body">
                                    <textarea class="form-control mb-2" rows="2" placeholder="پاسخ / دلیل..." @bind="managerActionText"></textarea>
                                    <div class="d-flex gap-2 flex-wrap">
                                        <button class="btn btn-outline-success btn-sm" disabled="@busy" @onclick="SubmitClose">
                                            <i class="bi bi-check2-circle"></i> انجام شد — بستن توسط خودم
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="SubmitReject">
                                            <i class="bi bi-x-octagon"></i> رد درخواست
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }

                        @* ---------- ارجاع مدیر ---------- *@
                        @if (access.IsManager && detail.Status is "New" or "Assigned")
                        {
                            <div class="itr-block mb-3 itr-block-manager">
                                <div class="itr-block-title"><i class="bi bi-person-gear"></i> ارجاع به کارشناس(ها)</div>
                                <div class="itr-block-body">
                                    <label class="form-label fs-8">توضیح کلی ارجاع</label>
                                    <textarea class="form-control mb-2" rows="2" @bind="assignNote"></textarea>
                                    @foreach (var ex in experts)
                                    {
                                        <div class="itr-expert-row @(assignSelected.Contains(ex.Id) ? "sel" : "")">
                                            <div class="form-check">
                                                <input class="form-check-input" type="checkbox" id="ex-@ex.Id"
                                                       checked="@assignSelected.Contains(ex.Id)"
                                                       @onchange="e => ToggleExpert(ex.Id, (bool)e.Value!)" />
                                                <label class="form-check-label fw-600" for="ex-@ex.Id">
                                                    <i class="bi bi-person-badge text-primary"></i> @ex.Username
                                                </label>
                                            </div>
                                            @if (assignSelected.Contains(ex.Id))
                                            {
                                                <input class="form-control form-control-sm mt-1" placeholder="شرح اختصاصی برای این کارشناس (اختیاری)"
                                                       @bind="assignInstructions[ex.Id]" />
                                            }
                                        </div>
                                    }
                                    @if (experts.Count == 0)
                                    {
                                        <div class="alert alert-warning py-2 fs-8 mb-0">کارشناسی تعریف نشده — به کاربر موردنظر مجوز «کارشناس IT» بدهید.</div>
                                    }
                                    <button class="btn btn-warning mt-2" disabled="@busy" @onclick="SubmitAssign">
                                        <i class="bi bi-send"></i> @(detail.Status == "Assigned" ? "ارجاع مجدد" : "ارجاع")
                                    </button>
                                </div>
                            </div>
                        }

                        @* ---------- کارشناسان و گزارش‌ها ---------- *@
                        @if (detail.Assignments.Any())
                        {
                            <div class="itr-block mb-3">
                                <div class="itr-block-title">
                                    <i class="bi bi-people"></i> کارشناسان و گزارش‌ها
                                    <span class="badge bg-light text-dark border me-1">@detail.Assignments.Count(a => a.ReportSubmitted)/@detail.Assignments.Count پاسخ</span>
                                </div>
                                <div class="itr-block-body">
                                    @if (!string.IsNullOrWhiteSpace(detail.ManagerNote))
                                    {
                                        <div class="fs-8 mb-2"><span class="fw-600">توضیح مدیر:</span> @detail.ManagerNote</div>
                                    }
                                    @foreach (var a in detail.Assignments)
                                    {
                                        <div class="itr-asg">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                                <span class="fw-700 d-inline-flex align-items-center gap-1">
                                                    <UserAvatar LoginUserId="a.ExpertUserId" Size="24" CssClass="user-avatar-sm" />
                                                    @a.ExpertName
                                                </span>
                                                <div class="d-flex gap-1">
                                                    @if (a.ReportSubmitted)
                                                    {
                                                        <span class="badge bg-success-subtle text-success border">گزارش رسیده</span>
                                                        @if (a.Done == true)
                                                        {
                                                            <span class="badge bg-success-subtle text-success border">✅ انجام شد</span>
                                                        }
                                                        else if (a.Done == false)
                                                        {
                                                            <span class="badge bg-danger-subtle text-danger border">❌ انجام نشد</span>
                                                        }
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-warning-subtle text-warning border">در انتظار گزارش</span>
                                                    }
                                                    @if (a.ManagerDecision == "Approved")
                                                    {
                                                        <span class="badge bg-primary-subtle text-primary border">تایید مدیر ✔</span>
                                                    }
                                                    else if (a.ManagerDecision == "Rejected")
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border">رد شده</span>
                                                    }
                                                </div>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(a.ManagerInstruction))
                                            {
                                                <div class="fs-8 text-muted mt-1">شرح مدیر: @a.ManagerInstruction</div>
                                            }

                                            @* کارشناس: ثبت گزارش + انجام شد/نشد (بند ۱۰) *@
                                            @if (access.IsExpert && a.ExpertUserId == access.UserId && detail.Status == "Assigned" && a.ManagerDecision != "Approved")
                                            {
                                                <div class="mt-2">
                                                    <div class="d-flex gap-3 mb-2">
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="done-@a.Id" id="done-y-@a.Id"
                                                                   checked="@(myDone == true)" @onchange="() => myDone = true" />
                                                            <label class="form-check-label text-success fw-600" for="done-y-@a.Id">✅ انجام شد</label>
                                                        </div>
                                                        <div class="form-check">
                                                            <input class="form-check-input" type="radio" name="done-@a.Id" id="done-n-@a.Id"
                                                                   checked="@(myDone == false)" @onchange="() => myDone = false" />
                                                            <label class="form-check-label text-danger fw-600" for="done-n-@a.Id">❌ انجام نشد</label>
                                                        </div>
                                                    </div>
                                                    <textarea class="form-control" rows="3" placeholder="شرح اقدامات..."
                                                              @bind="myReport"></textarea>
                                                    <button class="btn btn-success btn-sm mt-2" disabled="@busy" @onclick="SubmitReport">
                                                        <i class="bi bi-check2"></i> ثبت گزارش
                                                    </button>
                                                </div>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(a.ExpertReport))
                                            {
                                                <div class="itr-report mt-2">@a.ExpertReport</div>
                                            }

                                            @* مدیر: تایید یا رد گزارش هر کارشناس (بند ۱۲) *@
                                            @if (access.IsManager && a.ReportSubmitted && a.ManagerDecision == null)
                                            {
                                                <div class="mt-2 p-2 rounded-3" style="background:#fffbeb;border:1px dashed #fcd34d">
                                                    <input class="form-control form-control-sm mb-2" placeholder="یادداشت مدیر (اختیاری)"
                                                           @bind="decideNotes[a.Id]" />
                                                    <div class="d-flex gap-2">
                                                        <button class="btn btn-success btn-sm" disabled="@busy" @onclick="() => Decide(a.Id, true)">
                                                            <i class="bi bi-check2"></i> تایید گزارش
                                                        </button>
                                                        <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => Decide(a.Id, false)">
                                                            <i class="bi bi-x-lg"></i> رد (برگشت به کارشناس)
                                                        </button>
                                                    </div>
                                                </div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(a.ManagerDecisionNote))
                                            {
                                                <div class="fs-8 text-muted mt-1">یادداشت مدیر: @a.ManagerDecisionNote</div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }

                        @* ---------- تایید نهایی مدیر (بند ۱۳: فقط وقتی همه تایید شده‌اند) ---------- *@
                        @if (access.IsManager && detail.Status == "Assigned" && detail.Assignments.Any())
                        {
                            var allApproved = detail.Assignments.All(a => a.ManagerDecision == "Approved");
                            <div class="itr-block mb-3 itr-block-approve">
                                <div class="itr-block-title"><i class="bi bi-patch-check"></i> پاسخ نهایی به درخواست‌کننده</div>
                                <div class="itr-block-body">
                                    @if (!allApproved)
                                    {
                                        <div class="alert alert-warning py-2 fs-8">
                                            <i class="bi bi-hourglass-split"></i>
                                            تا زمانی که گزارش <b>همه</b> کارشناسان را تایید نکنید، امکان ارسال پاسخ نهایی نیست.
                                            (@detail.Assignments.Count(a => a.ManagerDecision == "Approved")/@detail.Assignments.Count تایید شده)
                                        </div>
                                    }
                                    <textarea class="form-control mb-2" rows="3" placeholder="پاسخ نهایی که درخواست‌کننده می‌بیند..."
                                              @bind="approveNote" disabled="@(!allApproved)"></textarea>
                                    <button class="btn btn-primary" disabled="@(busy || !allApproved)" @onclick="SubmitApprove">
                                        <i class="bi bi-check2-circle"></i> تایید و ارسال به درخواست‌کننده
                                    </button>
                                </div>
                            </div>
                        }

                        @* ---------- آرشیو رفت‌وبرگشت‌ها (بند ۱۲) ---------- *@
                        @if (logs.Any())
                        {
                            <div class="itr-block mb-3">
                                <div class="itr-block-title"><i class="bi bi-clock-history"></i> آرشیو رفت‌وبرگشت‌ها</div>
                                <div class="itr-block-body p-0">
                                    <div class="itr-timeline">
                                        @foreach (var l in logs)
                                        {
                                            <div class="itr-tl-item">
                                                <div class="itr-tl-dot itr-tl-@l.Action.ToLower()"></div>
                                                <div>
                                                    <div class="fs-8"><span class="fw-700">@l.ActorName</span> <span class="text-muted">(@RoleFa(l.ActorRole))</span> — @ActionFa(l.Action)</div>
                                                    @if (!string.IsNullOrWhiteSpace(l.Text))
                                                    {
                                                        <div class="fs-8 text-muted">@l.Text</div>
                                                    }
                                                    <div class="fs-9 text-muted num">@l.CreatedAt.ToFa()</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @* ---------- نمای درخواست‌دهنده: فقط وضعیت و پاسخ نهایی ---------- *@
                        @if (detail.Status == "Assigned")
                        {
                            <div class="alert alert-info py-2 fs-8">
                                <i class="bi bi-gear-wide-connected"></i> درخواست شما در واحد IT در حال بررسی و انجام است.
                            </div>
                        }
                    }

                    @* ---------- پاسخ نهایی ---------- *@
                    @if (!string.IsNullOrWhiteSpace(detail.FinalResponse))
                    {
                        <div class="itr-block mb-3 itr-block-final">
                            <div class="itr-block-title"><i class="bi bi-chat-left-text"></i> پاسخ نهایی واحد IT</div>
                            <div class="itr-block-body" style="white-space:pre-line">@detail.FinalResponse</div>
                        </div>
                    }
                    @if (detail.Status == "ManagerApproved" && detail.RequesterUserId == access.UserId)
                    {
                        <div class="d-grid">
                            <button class="btn btn-success btn-lg" disabled="@busy" @onclick="SubmitComplete">
                                <i class="bi bi-check2-all"></i> تایید و تکمیل درخواست
                            </button>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

