    // ================== درخواست جدید ==================
    private async Task OpenNew()
    {
        formError = ""; editName = false; sysDropOpen = false; sysSearch = "";
        newForm = new NewForm { RequesterName = Auth.DisplayName };
        newFiles.Clear();
        try { systems = await Http.GetFromJsonAsync<List<SystemOpt>>("/api/itrequests/systems") ?? new(); }
        catch { systems = new(); }
        showNew = true;
        StateHasChanged();
        await Task.Delay(80);
        try { await JS.InvokeVoidAsync("rteSetHtml", "rte-desc", ""); } catch { }
    }

    private void OnNewFileSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
        => newFiles = e.GetMultipleFiles(5).ToList();

    private async Task SubmitNew()
    {
        formError = "";
        if (string.IsNullOrWhiteSpace(newForm.Title)) { formError = "موضوع درخواست را وارد کنید."; return; }

        busy = true;
        try
        {
            string desc = "";
            try { desc = await JS.InvokeAsync<string>("rteGetHtml", "rte-desc") ?? ""; } catch { }

            var sel = systems.FirstOrDefault(s => s.Id == newForm.SystemInfoId);

            if (remoteMode)
            {
                // ================== حالت شعبه: ارسال به سرور مرکزی (بدون لاگین آنجا) ==================
                var resp2 = await Http.PostAsJsonAsync($"{remoteUrl}/api/itrequests/external", new
                {
                    requesterName = newForm.RequesterName,
                    companyName = remoteCompany,
                    systemLabel = SysLabel(sel),
                    requestType = newForm.RequestType,
                    title = newForm.Title,
                    description = desc
                });
                if (!resp2.IsSuccessStatusCode)
                {
                    formError = $"ارسال به سرور مرکزی ناموفق ({(int)resp2.StatusCode}) — آدرس سرور را در تنظیمات بررسی کنید.";
                    return;
                }
                var created2 = await resp2.Content.ReadFromJsonAsync<CreatedResNum>();
                remoteReqs.Insert(0, new RemoteReq { Number = created2!.Number, Title = newForm.Title, CreatedAt = DateTime.Now });
                await SaveRemoteList();
                Toast.Success($"درخواست به سرور مرکزی ارسال شد — شماره پیگیری: {created2.Number}");
                showNew = false;
                await LoadRemote();
                return;
            }

            var resp = await Http.PostAsJsonAsync("/api/itrequests", new
            {
                requesterName = newForm.RequesterName,
                systemInfoId = newForm.SystemInfoId,
                systemLabel = SysLabel(sel),
                requestType = newForm.RequestType,
                title = newForm.Title,
                description = desc
            });
            if (!resp.IsSuccessStatusCode)
            {
                formError = $"خطا در ثبت ({(int)resp.StatusCode}): {await resp.Content.ReadAsStringAsync()}";
                return;
            }
            var created = await resp.Content.ReadFromJsonAsync<CreatedRes>();
            foreach (var f in newFiles)
                await UploadFile(created!.Id, f, "Requester");

            Toast.Success("درخواست شما ثبت شد.");
            showNew = false;
            await LoadAll();
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { busy = false; }
    }

    private async Task UploadFile(int reqId, Microsoft.AspNetCore.Components.Forms.IBrowserFile f, string role)
    {
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(f.OpenReadStream(10 * 1024 * 1024));
            sc.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
            content.Add(sc, "file", f.Name);
            await Http.PostAsync($"/api/itrequests/{reqId}/attachments?role={role}", content);
        }
        catch (Exception ex) { Toast.Error($"بارگذاری {f.Name} ناموفق: {ex.Message}"); }
    }

    // ================== جزئیات ==================
    private async Task OpenDetail(ReqItem r)
    {
        detail = r;
        managerActionText = "";
        // ثبت رویت — نشانگر «جدید» برداشته می‌شود
        if (!r.Seen)
        {
            r.Seen = true;
            try { await Http.PostAsync($"/api/itrequests/{r.Id}/seen", null); } catch { }
        }
        attachments = new(); logs = new();
        assignNote = r.ManagerNote ?? "";
        assignSelected = new HashSet<int>(r.Assignments.Select(a => a.ExpertUserId));
        assignInstructions = r.Assignments.ToDictionary(a => a.ExpertUserId, a => a.ManagerInstruction ?? "");
        var mine = r.Assignments.FirstOrDefault(a => a.ExpertUserId == access.UserId);
        myReport = mine?.ExpertReport ?? "";
        myDone = mine?.Done ?? true;
        approveNote = "";
        decideNotes = r.Assignments.ToDictionary(a => a.Id, a => "");

        try { attachments = await Http.GetFromJsonAsync<List<AttItem>>($"/api/itrequests/{r.Id}/attachments") ?? new(); }
        catch { }
        if (tab != "mine")
        {
            try { logs = await Http.GetFromJsonAsync<List<LogItem>>($"/api/itrequests/{r.Id}/logs") ?? new(); }
            catch { }
        }
        if (access.IsManager && experts.Count == 0)
        {
            try { experts = await Http.GetFromJsonAsync<List<ExpertOpt>>("/api/itrequests/experts") ?? new(); }
            catch { }
        }
    }

    private void CloseDetail() => detail = null;

    private void ToggleExpert(int id, bool on)
    {
        if (on) { assignSelected.Add(id); if (!assignInstructions.ContainsKey(id)) assignInstructions[id] = ""; }
        else assignSelected.Remove(id);
    }

    private async Task SubmitAssign()
    {
        if (detail == null) return;
        if (assignSelected.Count == 0) { Toast.Error("حداقل یک کارشناس انتخاب کنید."); return; }
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/itrequests/{detail.Id}/assign", new
            {
                managerNote = assignNote,
                experts = assignSelected.Select(id => new { userId = id, instruction = assignInstructions.GetValueOrDefault(id, "") })
            });
            if (resp.IsSuccessStatusCode) { Toast.Success("درخواست ارجاع شد."); CloseDetail(); await LoadAll(); }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SubmitReport()
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/itrequests/{detail.Id}/report", new { report = myReport, done = myDone ?? true });
            if (resp.IsSuccessStatusCode) { Toast.Success("گزارش شما ثبت شد و به مدیر اطلاع داده شد."); CloseDetail(); await LoadAll(); }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task Decide(int asgId, bool approved)
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/itrequests/{detail.Id}/assignments/{asgId}/decide",
                new { approved, note = decideNotes.GetValueOrDefault(asgId, "") });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success(approved ? "گزارش تایید شد." : "گزارش رد شد و به کارشناس برگشت.");
                var cur = detail;
                await LoadAll();
                var updated = managerItems.FirstOrDefault(x => x.Id == cur.Id) ?? expertItems.FirstOrDefault(x => x.Id == cur.Id);
                if (updated != null) await OpenDetail(updated); else CloseDetail();
            }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SubmitApprove()
    {
        if (detail == null) return;
        if (string.IsNullOrWhiteSpace(approveNote)) { Toast.Error("پاسخ نهایی را بنویسید."); return; }
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/itrequests/{detail.Id}/approve", new { finalResponse = approveNote });
            if (resp.IsSuccessStatusCode) { Toast.Success("پاسخ نهایی برای درخواست‌کننده ارسال شد."); CloseDetail(); await LoadAll(); }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
