    private async Task UploadDetailFile(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        if (detail == null) return;
        var role = tab == "manager" ? "Manager" : tab == "expert" ? "Expert" : "Requester";
        foreach (var f in e.GetMultipleFiles(5))
            await UploadFile(detail.Id, f, role);
        try { attachments = await Http.GetFromJsonAsync<List<AttItem>>($"/api/itrequests/{detail.Id}/attachments") ?? new(); }
        catch { }
        Toast.Success("پیوست بارگذاری شد.");
    }

