@code {
    private bool loading = true, busy;
    private string tab = "mine";
    private string formError = "";
    private string apiBase = "";

    private AccessInfo access = new();
    private List<ReqItem> myItems = new(), expertItems = new(), managerItems = new();
    private List<SystemOpt> systems = new();
    private List<ExpertOpt> experts = new();

    private IEnumerable<ReqItem> AllTabItems => tab switch
    {
        "expert" => expertItems,
        "manager" => managerItems,
        _ => myItems
    };

    // ================== صفحه‌بندی کارتابل‌ها ==================
    private const int PageSize = 9;
    private int page = 1;
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(AllTabItems.Count() / (double)PageSize));
    private IEnumerable<ReqItem> CurrentItems => AllTabItems.Skip((page - 1) * PageSize).Take(PageSize);
    private void GoPage(int p) { page = Math.Clamp(p, 1, TotalPages); }

    // فرم جدید
    private bool showNew, editName, sysDropOpen;
    private string sysSearch = "";
    private NewForm newForm = new();
    private List<Microsoft.AspNetCore.Components.Forms.IBrowserFile> newFiles = new();

    private IEnumerable<SystemOpt> FilteredSystems =>
        string.IsNullOrWhiteSpace(sysSearch)
            ? systems
            : systems.Where(s =>
                s.Label.Contains(sysSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (s.Ip ?? "").Contains(sysSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (s.UserName ?? "").Contains(sysSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (s.DepartmentName ?? "").Contains(sysSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    private string SysLabel(SystemOpt? s) => s == null ? "" :
        $"{s.Label}{(string.IsNullOrWhiteSpace(s.Ip) ? "" : $" ({s.Ip})")}{(string.IsNullOrWhiteSpace(s.UserName) ? "" : $" — {s.UserName}")}";

    private void PickSystem(int? id) { newForm.SystemInfoId = id; sysDropOpen = false; }

    // جزئیات
    private ReqItem? detail;
    private List<AttItem> attachments = new();
    private List<LogItem> logs = new();

    private string assignNote = "";
    private HashSet<int> assignSelected = new();
    private Dictionary<int, string> assignInstructions = new();
    private string myReport = "";
    private bool? myDone = true;
    private string approveNote = "";
    private Dictionary<int, string> decideNotes = new();
    private string managerActionText = "";

    // ================== حالت شعبه: ارسال به سرور مرکزی ==================
    private bool remoteMode;
    private string remoteUrl = "", remoteCompany = "";
    private List<RemoteReq> remoteReqs = new(); // درخواست‌های ارسال‌شده به مرکز (ذخیره محلی)
    public class RemoteReq { public string Number { get; set; } = ""; public string Title { get; set; } = ""; public DateTime CreatedAt { get; set; } public string Status { get; set; } = "New"; public string? FinalResponse { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("درخواست خدمت IT");
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        // ================== کانفیگ سرور مرکزی (حالت شعبه) ==================
        try
        {
            var cfg = await Http.GetFromJsonAsync<ItCfg>("/api/itrequests/config");
            if (!string.IsNullOrWhiteSpace(cfg?.ItServerUrl))
            {
                remoteMode = true;
                remoteUrl = cfg!.ItServerUrl.TrimEnd('/');
                remoteCompany = cfg.ItCompanyName ?? "";
            }
        }
        catch { }

        await LoadAccess();
        if (remoteMode) await LoadRemote();
        else await LoadAll();
        loading = false;

        // ================== رفرش خودکار برخط کارتابل‌ها (سرویس مشترک SignalR) ==================
        Rt.DataChanged += OnRtDataChanged;
        await Rt.EnsureStartedAsync(apiBase, access.UserId);

        // ================== باز کردن مستقیم درخواست از نوتیفیکیشن (?open=id) ==================
        await TryOpenFromQuery();
        Nav.LocationChanged += OnLocChanged;
    }

    private async void OnLocChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await TryOpenFromQuery();
        await InvokeAsync(StateHasChanged);
    }

    private async Task TryOpenFromQuery()
    {
        var uri = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(uri.Query);
        if (!int.TryParse(qs["open"], out var openId) || openId <= 0) return;

        // پیدا کردن درخواست در کارتابل‌ها + رفتن به تب درست
        var inMgr = managerItems.FirstOrDefault(x => x.Id == openId);
        var inExp = expertItems.FirstOrDefault(x => x.Id == openId);
        var inMine = myItems.FirstOrDefault(x => x.Id == openId);
        if (inMgr != null) { tab = "manager"; await OpenDetail(inMgr); }
        else if (inExp != null) { tab = "expert"; await OpenDetail(inExp); }
        else if (inMine != null) { tab = "mine"; await OpenDetail(inMine); }
    }

    private async void OnRtDataChanged(string scope)
    {
        if (scope != "itrequests") return;
        await LoadAll();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocChanged;
        Rt.DataChanged -= OnRtDataChanged;
    }

    private async Task LoadAccess()
    {
        try { access = await Http.GetFromJsonAsync<AccessInfo>("/api/itrequests/my-access") ?? new(); }
        catch { access = new(); }
    }

    private async Task LoadAll()
    {
        try { myItems = await Http.GetFromJsonAsync<List<ReqItem>>("/api/itrequests/mine") ?? new(); }
        catch { myItems = new(); }
        if (access.IsExpert)
        {
            try { expertItems = await Http.GetFromJsonAsync<List<ReqItem>>("/api/itrequests/expert") ?? new(); }
            catch { expertItems = new(); }
        }
        if (access.IsManager)
        {
            try { managerItems = await Http.GetFromJsonAsync<List<ReqItem>>("/api/itrequests/manager") ?? new(); }
            catch { managerItems = new(); }
        }
    }

    private void SwitchTab(string t) { tab = t; page = 1; }

    private async Task LoadRemote()
    {
        // لیست شماره‌های ارسال‌شده از این نرم‌افزار (ذخیره محلی)
        try
        {
            var json = await JS.InvokeAsync<string?>("localStorage.getItem", "itRemoteReqs");
            remoteReqs = string.IsNullOrWhiteSpace(json) ? new()
                : System.Text.Json.JsonSerializer.Deserialize<List<RemoteReq>>(json,
                    new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }) ?? new();
        }
        catch { remoteReqs = new(); }

        // وضعیت هر کدام از سرور مرکزی
        foreach (var rr in remoteReqs)
        {
            try
            {
                var t = await Http.GetFromJsonAsync<RemoteTrack>($"{remoteUrl}/api/itrequests/track?number={Uri.EscapeDataString(rr.Number)}");
                if (t != null) { rr.Status = t.Status; rr.FinalResponse = t.FinalResponse; }
            }
            catch { }
        }
    }
    public class RemoteTrack { public string Number { get; set; } = ""; public string Status { get; set; } = ""; public string? FinalResponse { get; set; } }

    private async Task SaveRemoteList() =>
        await JS.InvokeVoidAsync("localStorage.setItem", "itRemoteReqs", System.Text.Json.JsonSerializer.Serialize(remoteReqs));

