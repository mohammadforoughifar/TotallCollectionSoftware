    private RenderFragment StatusBadge(ReqItem r, string viewTab) => (r.Status, viewTab) switch
    {
        ("New", _) => @<span class="badge bg-secondary-subtle text-secondary border">ثبت شده</span>,
        ("Assigned", "mine") => @<span class="badge bg-warning-subtle text-warning border">در حال بررسی</span>,
        ("Assigned", _) => @<span class="badge bg-warning-subtle text-warning border">ارجاع شده</span>,
        ("ManagerApproved", "mine") => @<span class="badge bg-info-subtle text-info border">در انتظار تایید شما</span>,
        ("ManagerApproved", _) => @<span class="badge bg-info-subtle text-info border">پاسخ ارسال شده</span>,
        ("Completed", _) => @<span class="badge bg-success-subtle text-success border">تکمیل شده ✔</span>,
        ("Rejected", _) => @<span class="badge bg-danger-subtle text-danger border">رد شده ✖</span>,
        _ => @<span class="badge bg-light text-dark">@r.Status</span>
    };

