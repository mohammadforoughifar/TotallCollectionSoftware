                                                    <span class="tst @(detail.Assignees.Count > 0 && detail.Assignees.All(a => a.Done == true) ? "g" : "w")">
                                                        @(detail.Assignees.Count > 0 && detail.Assignees.All(a => a.Done == true) ? "انجام شد" : "در جریان")
                                                    </span>
                                                </div>
                                                <ul>
                                                    @foreach (var a in detail.Assignees)
                                                    {
                                                        var aa = a;
                                                        <li>
                                                            <div class="tnode">
                                                                <span class="mini"><i class="bi bi-person"></i></span>
                                                                <div><b>@aa.Name</b><small> — رویت: @(aa.SeenAt == null ? "—" : aa.SeenAt.Value.ToFa())</small></div>
                                                                <span class="tst @(aa.Done == true ? "g" : aa.Done == false ? "r" : "w")">
                                                                    @(aa.Done == true ? "انجام شد" : aa.Done == false ? "انجام نشد" : aa.SeenAt != null ? "رویت شده" : "در انتظار")
                                                                </span>
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }

                    @* ---------- نمای فلوچارتی ---------- *@
                    else
                    {
                        <div class="ltx" style="animation:none">
                            <div class="fcwrap">
                                <div class="fc">
                                    <ul>
                                        <li>
                                            <div class="fnode root">
                                                <span class="mini"><i class="bi bi-person-badge"></i></span>
                                                <div><b>@detail.OwnerName</b><small>دستوردهنده</small></div>
                                                <span class="fdot p"></span>
                                            </div>
                                            <ul>
                                                @foreach (var a in detail.Assignees)
                                                {
                                                    var aa = a;
                                                    <li>
                                                        <div class="fnode @(aa.Done == true ? "ok" : aa.Done == false ? "no" : "wt")">
                                                            <span class="mini"><i class="bi bi-person"></i></span>
                                                            <div><b>@aa.Name</b><small>@(aa.Done == true ? "انجام شد" : aa.Done == false ? "انجام نشد" : aa.SeenAt != null ? "رویت شده" : "در انتظار رویت")</small></div>
                                                            <span class="fdot @(aa.Done == true ? "g" : aa.Done == false ? "r" : "w")"></span>
                                                        </div>
                                                    </li>
                                                }
                                                @if (detail.Assignees.Count == 0)
                                                {
                                                    <li>
                                                        <div class="fnode wt">
                                                            <span class="mini"><i class="bi bi-people"></i></span>
                                                            <div><b>گیرنده‌ای ثبت نشده</b></div>
                                                            <span class="fdot w"></span>
                                                        </div>
                                                    </li>
                                                }
                                            </ul>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                            <div class="fleg">
                                <span><span class="fdot p"></span> شروع</span>
                                <span><span class="fdot g"></span> انجام‌شده</span>
                                <span><span class="fdot w"></span> در انتظار</span>
                                <span><span class="fdot r"></span> انجام‌نشده</span>
                            </div>
                        </div>
                    }

                    @* ---------- تاریخچه (لاگ) ---------- *@
                    @if (logs.Count > 0)
                    {
                        <div class="wo-block mt-3">
                            <div class="wo-block-title"><i class="bi bi-clock-history"></i> تاریخچه گردش</div>
                            <div class="wo-block-body">
                                @foreach (var l in logs)
                                {
                                    <div class="d-flex gap-2 fs-9 py-1 border-bottom">
                                        <span class="num text-muted" style="min-width:110px">@l.CreatedAt.ToFaDateTime()</span>
                                        <span style="min-width:90px">@((MarkupString)LogBadge(l.Action))</span>
                                        <span class="flex-grow-1">@l.ActorName@(string.IsNullOrWhiteSpace(l.Text) ? "" : " — " + l.Text)</span>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="() => gardeshOpen = false">بستن</button>
                </div>
            </div>
        </div>
    </div>
}

