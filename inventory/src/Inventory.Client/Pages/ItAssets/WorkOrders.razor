@namespace Inventory.Client.Pages
@page "/work-orders"
@using System.Net.Http.Headers
@using System.Globalization
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS
@inject LayoutState Layout
@inject NavigationManager Nav
@inject RealtimeService Rt
@implements IDisposable

<PageTitle>دستور کار</PageTitle>

<div class="page-head">
    <div>
        <h1>دستور کار و وظایف</h1>
        <p class="lead">ارجاع وظایف، تعیین مهلت اقدام، گردش تایید و پیگیری وضعیت اجرا</p>
    </div>
    @if (access.CanCreate)
    {
        <button class="btn btn-primary me-auto" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> دستور کار جدید
        </button>
    }
</div>

@* ================== تب‌ها ================== *@
<div class="wo-tabs mb-3">
    <button class="wo-tab @(tab == "mine" ? "active" : "")" @onclick='() => SwitchTab("mine")'>
        <i class="bi bi-send"></i> دستورهای من <span class="wo-tab-badge">@mineItems.Count</span>
    </button>
    <button class="wo-tab @(tab == "assigned" ? "active" : "")" @onclick='() => SwitchTab("assigned")'>
        <i class="bi bi-inbox"></i> محول به من <span class="wo-tab-badge">@assignedItems.Count</span>
    </button>
    <button class="wo-tab @(tab == "archive" ? "active" : "")" @onclick='() => SwitchTab("archive")'>
        <i class="bi bi-archive"></i> بایگانی <span class="wo-tab-badge">@archiveItems.Count</span>
    </button>
    <button class="wo-tab @(tab == "kanban" ? "active" : "")" @onclick='() => SwitchTab("kanban")'>
        <i class="bi bi-kanban"></i> کانبان
    </button>
    <button class="wo-tab @(tab == "calendar" ? "active" : "")" @onclick='() => SwitchTab("calendar")'>
        <i class="bi bi-calendar3"></i> تقویم
    </button>
    <button class="wo-tab @(tab == "stats" ? "active" : "")" @onclick='() => SwitchTab("stats")'>
        <i class="bi bi-bar-chart"></i> داشبورد
    </button>
</div>

@* ================== نوار جستجو و فیلتر ================== *@
@if (!loading && tab != "calendar" && tab != "stats" && tab != "kanban")
{
    <div class="wo-filterbar mb-3">
        <div class="wo-flt-search">
            <i class="bi bi-search"></i>
            <input class="form-control form-control-sm" placeholder="جستجو در شماره، عنوان یا دستوردهنده..."
                   value="@fltQ" @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(fltQ))
            {
                <button class="wo-flt-clear" title="پاک کردن" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
            }
        </div>
        <div class="wo-pr-group wo-flt-pr">
            <button type="button" class="wo-pr-btn @(fltPriority == -1 ? "active" : "")"
                    @onclick="() => SetPriorityFilter(-1)">همه</button>
            @foreach (var (val, fa) in PriorityOpts)
            {
                var v2 = val;
                <button type="button" class="wo-pr-btn wo-pr-@v2 @(fltPriority == v2 ? "active" : "")"
                        @onclick="() => SetPriorityFilter(v2)">@fa</button>
            }
        </div>
        @if (AllTabTags.Any())
        {
            <div class="d-flex gap-1 flex-wrap align-items-center">
                <i class="bi bi-tags text-muted fs-8"></i>
                @foreach (var t in AllTabTags.Take(10))
                {
                    var t2 = t;
                    <button type="button" class="wo-tag-suggest @(fltTag == t2 ? "active" : "")"
                            @onclick="() => SetTagFilter(fltTag == t2 ? null : t2)">@t2</button>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(fltQ) || fltPriority >= 0 || fltTag != null)
        {
            <span class="fs-8 text-muted">@FilteredItems.Count از @TabItems.Count مورد</span>
        }
        <div class="d-flex gap-1 ms-auto">
            <button class="btn btn-sm btn-outline-success" title="خروجی اکسل (با فیلترهای جاری)" disabled="@exporting" @onclick='() => ExportList("xlsx")'>
                @if (exporting) { <span class="spinner-border spinner-border-sm"></span> }
                else { <i class="bi bi-file-earmark-excel"></i> }
                <span class="d-none d-sm-inline">اکسل</span>
            </button>
            <button class="btn btn-sm btn-outline-danger" title="خروجی PDF (با فیلترهای جاری)" disabled="@exporting" @onclick='() => ExportList("pdf")'>
                <i class="bi bi-file-earmark-pdf"></i>
                <span class="d-none d-sm-inline">PDF</span>
            </button>
        </div>
    </div>
}

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (tab == "kanban")
{
    @* ================== نمای کانبان — ستون‌بندی بر اساس اولویت، درگ‌اند‌دراپ برای تغییر اولویت ================== *@
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <div class="wo-pr-group">
            <button type="button" class="wo-pr-btn @(kanbanScope == "mine" ? "active" : "")" @onclick='() => kanbanScope = "mine"'>دستورهای من</button>
            <button type="button" class="wo-pr-btn @(kanbanScope == "assigned" ? "active" : "")" @onclick='() => kanbanScope = "assigned"'>محول به من</button>
        </div>
        <span class="fs-9 text-muted"><i class="bi bi-info-circle"></i> کارت‌ها را بین ستون‌ها بکشید تا اولویت عوض شود (فقط دستورهای خودتان).</span>
    </div>
    <div class="wo-kanban">
        @foreach (var (pv, pfa) in PriorityOpts.Reverse())
        {
            var col = pv;
            var colItems = KanbanItems.Where(w => w.Priority == col).OrderBy(w => w.DueAt).ToList();
            <div class="wo-kb-col @(kbDragOver == col ? "dragover" : "")"
                 @ondragover:preventDefault @ondragenter="() => kbDragOver = col" @ondragleave="() => kbDragOver = -1"
                 @ondrop="() => KanbanDrop(col)">
                <div class="wo-kb-head wo-kb-head-@col">
                    <span>@pfa</span>
                    <span class="wo-kb-count num">@colItems.Count</span>
                </div>
                <div class="wo-kb-body">
                    @if (colItems.Count == 0)
                    {
                        <div class="wo-kb-empty">—</div>
                    }
                    @foreach (var w in colItems)
                    {
                        var w2 = w;
                        var draggable = w2.OwnerUserId == access.UserId;
                        var overdue = w2.DueAt < DateTime.Now;
                        <div class="wo-kb-card @(overdue ? "overdue" : "") @(draggable ? "draggable" : "")"
                             draggable="@(draggable ? "true" : "false")"
                             @ondragstart="() => kbDragId = w2.Id"
                             @onclick="() => OpenDetail(w2)">
                            <div class="d-flex justify-content-between align-items-start gap-1">
                                <span class="fw-700 fs-8">@w2.Title</span>
                                <span class="fs-9 text-muted num text-nowrap">@w2.Number</span>
                            </div>
                            <div class="fs-9 text-muted mt-1 d-flex align-items-center gap-2 flex-wrap">
                                <span class="num @(overdue ? "text-danger fw-700" : "")"><i class="bi bi-clock"></i> @w2.DueAt.ToFa() @w2.DueAt.ToString("HH:mm")</span>
                                @if (w2.ChecklistTotal > 0) { <span class="num">☑ @w2.ChecklistDone/@w2.ChecklistTotal</span> }
                                @if (w2.CommentCount > 0) { <span class="num">💬 @w2.CommentCount</span> }
                                @if (w2.Children.Count > 0) { <span class="num">🔗 @w2.Children.Count(c => c.Status == "Closed")/@w2.Children.Count</span> }
                                @if (w2.Recurrence > 0) { <span>🔁</span> }
                            </div>
                            <div class="fs-9 text-muted mt-1 d-flex align-items-center gap-1">
                                <i class="bi bi-people"></i>
                                <span>@(kanbanScope == "mine" ? string.Join("، ", w2.Assignees.Select(a => a.Name)) : w2.OwnerName)</span>
                                <span class="ms-auto num">@w2.Assignees.Count(a => a.RepliedAt != null)/@w2.Assignees.Count پاسخ</span>
                            </div>
                            @if (w2.Tags.Count > 0)
                            {
                                <div class="d-flex gap-1 flex-wrap mt-1">
                                    @foreach (var t in w2.Tags) { <span class="wo-tag wo-tag-sm">@t</span> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else if (tab == "calendar")
{
    @* ================== تقویم شمسی (بند ۱۳) — بازطراحی ================== *@
    <div class="wo-cal-card">
        <div class="wo-cal-head2">
            <div class="wo-cal-nav">
                <button class="wo-nav-btn" @onclick="() => MoveMonth(-1)"><i class="bi bi-chevron-right"></i></button>
                <div class="wo-cal-title2">
                    <div class="wo-cal-month">@MonthName(calMonth)</div>
                    <div class="wo-cal-year num">@calYear.ToString()</div>
                </div>
                <button class="wo-nav-btn" @onclick="() => MoveMonth(1)"><i class="bi bi-chevron-left"></i></button>
                <button class="wo-today-btn" @onclick="GoToday"><i class="bi bi-calendar-check"></i> امروز</button>
            </div>
            <div class="wo-cal-legend2">
                <span><i class="wo-dot wo-k-self"></i> برای خودم</span>
                <span><i class="wo-dot wo-k-others"></i> برای دیگران</span>
                <span><i class="wo-dot wo-k-mixed"></i> مشترک</span>
                <span><i class="wo-dot wo-k-assigned"></i> محول به من</span>
                <span class="wo-leg-sep"></span>
                <span><i class="bi bi-check-circle-fill" style="color:#22c55e"></i> انجام به‌موقع</span>
                <span><i class="bi bi-check-circle-fill" style="color:#a855f7"></i> با تاخیر</span>
                <span><i class="bi bi-x-circle-fill" style="color:#ef4444"></i> انجام نشده</span>
            </div>
        </div>
        <div class="wo-cal2">
            @foreach (var d in new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه" })
            {
                <div class="wo-dow2 @(d == "جمعه" ? "friday" : "")">@d</div>
            }
            @for (var i = 0; i < calOffset; i++)
            {
                <div class="wo-cell2 empty"></div>
            }
            @for (var day = 1; day <= calDays; day++)
            {
                var d2 = day;
                var g = pc.ToDateTime(calYear, calMonth, d2, 0, 0, 0, 0);
                var isToday = g.Date == DateTime.Today;
                var isFriday = g.DayOfWeek == DayOfWeek.Friday;
                var dayOrders = calItems.Where(c => c.DueAt.Date == g.Date).ToList();
                <div class="wo-cell2 @(isToday ? "today" : "") @(isFriday ? "friday" : "") @(dayOrders.Any() ? "has-items" : "")">
                    <div class="wo-day2">
                        <span class="num">@d2</span>
                        @if (isToday)
                        {
                            <span class="wo-today-tag">امروز</span>
                        }
                    </div>
                    @foreach (var o in dayOrders.Take(3))
                    {
                        <div class="wo-chip2 wo-k-@o.Kind.ToLower() @(o.Status == "Closed" && o.Tone is not ("ontime" or "latedone") ? "closed" : "")"
                             title="@o.Number — @o.Title" @onclick="() => OpenById(o.Id)">
                            @* تیک / ضربدر وضعیت — تشخیص در یک نگاه *@
                            @if (o.Tone == "ontime")
                            {
                                <i class="bi bi-check-circle-fill wo-st-ic" style="color:#22c55e"></i>
                            }
                            else if (o.Tone == "latedone")
                            {
                                <i class="bi bi-check-circle-fill wo-st-ic" style="color:#a855f7"></i>
                            }
                            else if (o.Tone == "late" || (o.Status == "Closed" && o.Tone == "closed"))
                            {
                                <i class="bi bi-x-circle-fill wo-st-ic" style="color:#ef4444"></i>
                            }
                            else if (o.Tone == "today")
                            {
                                <i class="bi bi-alarm-fill wo-st-ic" style="color:#fbbf24"></i>
                            }
                            <span class="wo-chip-txt">@o.Title</span>
                        </div>
                    }
                    @if (dayOrders.Count > 3)
                    {
                        <div class="wo-more" @onclick="() => OpenDayModal(g)">+@(dayOrders.Count - 3) مورد دیگر</div>
                    }
                </div>
            }
        </div>
    </div>
}
else if (tab == "stats")
{
    @* ================== داشبورد آماری ================== *@
    @if (stats == null)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else
    {
        <div class="wo-kpis mb-3">
            <div class="wo-kpi"><div class="wo-kpi-num num">@stats.Cards.Total</div><div class="wo-kpi-lbl">کل دستورها</div></div>
            <div class="wo-kpi k-open"><div class="wo-kpi-num num">@stats.Cards.Open</div><div class="wo-kpi-lbl">باز / در جریان</div></div>
            <div class="wo-kpi k-late"><div class="wo-kpi-num num">@stats.Cards.Overdue</div><div class="wo-kpi-lbl">گذشته از مهلت</div></div>
            <div class="wo-kpi k-today"><div class="wo-kpi-num num">@stats.Cards.DueToday</div><div class="wo-kpi-lbl">مهلت امروز</div></div>
            <div class="wo-kpi k-ontime"><div class="wo-kpi-num num">@stats.Cards.DoneOnTime</div><div class="wo-kpi-lbl">انجام به‌موقع</div></div>
            <div class="wo-kpi k-latedone"><div class="wo-kpi-num num">@stats.Cards.DoneLate</div><div class="wo-kpi-lbl">انجام با تاخیر</div></div>
        </div>

        <div class="row g-3">
            @* ---------- توزیع اولویت دستورهای باز ---------- *@
            <div class="col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="fw-700 mb-3"><i class="bi bi-flag text-primary"></i> اولویت دستورهای باز</h6>
                        @if (!stats.ByPriority.Any())
                        {
                            <div class="text-muted fs-8 text-center py-3">دستور بازی نیست</div>
                        }
                        @{ var prMax = Math.Max(1, stats.ByPriority.Any() ? stats.ByPriority.Max(x => x.Count) : 1); }
                        @foreach (var p in stats.ByPriority)
                        {
                            <div class="d-flex align-items-center gap-2 mb-2">
                                <span class="fs-8" style="width:44px">@PriorityFa(p.Priority)</span>
                                <div class="wo-bar-track flex-grow-1">
                                    <div class="wo-bar wo-bar-p@(p.Priority)" style="width:@(p.Count * 100 / prMax)%"></div>
                                </div>
                                <span class="fs-8 fw-700 num" style="width:24px">@p.Count</span>
                            </div>
                        }
                    </div>
                </div>
            </div>

            @* ---------- روند ۶ ماه اخیر ---------- *@
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-body">
                        <h6 class="fw-700 mb-3"><i class="bi bi-graph-up text-primary"></i> روند ۶ ماه اخیر</h6>
                        @{ var moMax = Math.Max(1, stats.Months.Any() ? stats.Months.Max(m => m.Created) : 1); }
                        <div class="wo-chart">
                            @foreach (var m in stats.Months)
                            {
                                <div class="wo-chart-col">
                                    <div class="wo-chart-bars">
                                        <div class="wo-cb wo-cb-ontime" style="height:@(m.OnTime * 100 / moMax)%" title="به‌موقع: @m.OnTime"></div>
                                        <div class="wo-cb wo-cb-late" style="height:@(m.Late * 100 / moMax)%" title="با تاخیر: @m.Late"></div>
                                        <div class="wo-cb wo-cb-notdone" style="height:@(m.NotDone * 100 / moMax)%" title="انجام نشده: @m.NotDone"></div>
                                        <div class="wo-cb wo-cb-created" style="height:@(m.Created * 100 / moMax)%" title="ایجادشده: @m.Created"></div>
                                    </div>
                                    <div class="fs-9 text-muted num">@MonthName(m.Month)</div>
                                </div>
                            }
                        </div>
                        <div class="d-flex gap-3 mt-2 fs-9 text-muted flex-wrap">
                            <span><i class="wo-dot" style="background:#94a3b8"></i> ایجادشده</span>
                            <span><i class="wo-dot" style="background:#22c55e"></i> به‌موقع</span>
                            <span><i class="wo-dot" style="background:#a855f7"></i> با تاخیر</span>
                            <span><i class="wo-dot" style="background:#ef4444"></i> انجام نشده</span>
                        </div>
                    </div>
                </div>
            </div>

            @* ---------- عملکرد گیرندگان ---------- *@
            <div class="col-12">
                <div class="card">
                    <div class="card-body p-0">
                        <div class="p-3 pb-0"><h6 class="fw-700"><i class="bi bi-people text-primary"></i> عملکرد گیرندگان (دستورهایی که من داده‌ام)</h6></div>
                        @if (!stats.PerAssignee.Any())
                        {
                            <div class="text-muted fs-8 text-center py-4">هنوز دستوری به دیگران نداده‌اید</div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr><th>گیرنده</th><th>کل</th><th>انجام شد</th><th>به‌موقع</th><th>انجام نشد</th><th>بی‌پاسخ</th><th style="min-width:140px">نرخ موفقیت</th></tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var a in stats.PerAssignee)
                                        {
                                            var rate = a.Total == 0 ? 0 : a.Done * 100 / a.Total;
                                            <tr>
                                                <td class="fw-600"><span class="d-inline-flex align-items-center gap-1"><UserAvatar LoginUserId="a.UserId" Size="22" CssClass="user-avatar-sm" /> @a.Name</span></td>
                                                <td class="num">@a.Total</td>
                                                <td class="num text-success">@a.Done</td>
                                                <td class="num text-primary">@a.OnTime</td>
                                                <td class="num text-danger">@a.NotDone</td>
                                                <td class="num text-warning">@a.Pending</td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="wo-bar-track flex-grow-1"><div class="wo-bar" style="width:@rate%;background:@(rate >= 70 ? "#22c55e" : rate >= 40 ? "#f59e0b" : "#ef4444")"></div></div>
                                                        <span class="fs-9 num">@rate%</span>
                                                    </div>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}
else if (!PagedItems.Any())
{
    <div class="wo-empty"><i class="bi bi-clipboard-x"></i><h5>دستور کاری وجود ندارد</h5></div>
}
else
{
    @* ================== دیتاگرید با سطرهای بازشو (بند ۸) — دسکتاپ ================== *@
    <div class="card grid-desktop">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:44px"></th>
                            <th>شماره</th><th>عنوان</th><th>دستوردهنده</th>
                            <th>مهلت</th><th>گیرندگان</th><th>وضعیت</th><th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in PagedItems)
                        {
                            var tone = Tone(w);
                            <tr class="wo-row wo-tone-@tone">
                                <td>
                                    <button class="wo-expander" @onclick="() => ToggleExpand(w.Id)">
                                        <i class="bi @(expanded.Contains(w.Id) ? "bi-dash-lg" : "bi-plus-lg")"></i>
                                    </button>
                                </td>
                                <td class="num fw-700 text-primary">@w.Number</td>
                                <td class="fw-600">
                                    @PriorityBadge(w.Priority) @w.Title @SourceLink(w.SourceModule, w.SourceId)
                                    @if (w.Recurrence > 0)
                                    {
                                        <i class="bi bi-arrow-repeat text-info" title="تکرار @RecurrenceFa(w.Recurrence)"></i>
                                    }
                                    @if (w.ChecklistTotal > 0)
                                    {
                                        <span class="badge bg-light text-dark border fs-9 num" title="چک‌لیست">☑ @w.ChecklistDone/@w.ChecklistTotal</span>
                                    }
                                    @if (w.CommentCount > 0)
                                    {
                                        <span class="badge bg-light text-dark border fs-9 num" title="کامنت‌ها">💬 @w.CommentCount</span>
                                    }
                                    @if (w.ParentOrderId != null)
                                    {
                                        <span class="badge bg-light text-dark border fs-9" title="زیر-دستورِ @w.ParentNumber">🔗 زیر-دستور</span>
                                    }
                                    @if (w.Children.Count > 0)
                                    {
                                        <span class="badge bg-light text-dark border fs-9 num" title="زیر-دستورها (بسته از کل)">🔗 @w.Children.Count(c => c.Status == "Closed")/@w.Children.Count</span>
                                    }
                                    @foreach (var t in w.Tags)
                                    {
                                        var t2 = t;
                                        <span class="wo-tag wo-tag-sm" title="فیلتر با این برچسب" @onclick="() => SetTagFilter(t2)" @onclick:stopPropagation="true">@t2</span>
                                    }
                                </td>
                                <td>@w.OwnerName</td>
                                <td class="num">@w.DueAt.ToFa() @w.DueAt.ToString("HH:mm")</td>
                                <td>
                                    <span class="badge bg-light text-dark border">@w.Assignees.Count نفر</span>
                                    <span class="fs-8 text-muted">(@w.Assignees.Count(a => a.RepliedAt != null) پاسخ)</span>
                                </td>
                                <td>@ToneBadge(w, tone)</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end align-items-center">
                                        <button class="btn btn-sm btn-light" title="جزئیات" @onclick="() => OpenDetail(w)"><i class="bi bi-eye text-primary"></i></button>
                                        @if (CanEdit(w))
                                        {
                                            <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditFromList(w)"><i class="bi bi-pencil text-primary"></i></button>
                                        }
                                        <ArchiveButton Module="WorkOrders" RefId="@w.Id"
                                                       Title="@($"{w.Number} — {w.Title}")"
                                                       Link="@($"/work-orders?open={w.Id}")"
                                                       Compact="true" />
                                    </div>
                                </td>
                            </tr>
                            @if (expanded.Contains(w.Id))
                            {
                                <tr class="wo-subrow">
                                    <td></td>
                                    <td colspan="7">
                                        <table class="table table-sm mb-0 wo-subtable">
                                            <thead>
                                                <tr>
                                                    <th>گیرنده</th><th>رویت</th><th>پاسخ</th>
                                                    <th>نتیجه</th><th>شرح پاسخ</th><th>تصمیم دستوردهنده</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var a in w.Assignees)
                                                {
                                                    <tr>
                                                        <td class="fw-600"><span class="d-inline-flex align-items-center gap-1"><UserAvatar LoginUserId="a.UserId" Size="22" CssClass="user-avatar-sm" /> @a.Name</span></td>
                                                        <td class="num fs-8">@(a.SeenAt == null ? "—" : $"{a.SeenAt.Value.ToFa()} {a.SeenAt:HH:mm}")</td>
                                                        <td class="num fs-8">@(a.RepliedAt == null ? "—" : $"{a.RepliedAt.Value.ToFa()} {a.RepliedAt:HH:mm}")</td>
                                                        <td>
                                                            @if (a.Done == true)
                                                            {
                                                                <span class="badge bg-success-subtle text-success border">✅ انجام شد</span>
                                                            }
                                                            else if (a.Done == false)
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border">❌ انجام نشد</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning border">در انتظار</span>
                                                            }
                                                        </td>
                                                        <td class="fs-8">@(a.ReplyText ?? "—")</td>
                                                        <td>
                                                            @if (a.OwnerDecision == "Approved")
                                                            {
                                                                <span class="badge bg-primary-subtle text-primary border">تایید ✔</span>
                                                            }
                                                            else if (a.OwnerDecision == "Rejected")
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border">رد شده</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted fs-8">—</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ================== کارت‌ویو موبایل (بند ۱۴) ================== *@
    <div class="cards-mobile">
        @foreach (var w in PagedItems)
        {
            var tone = Tone(w);
            <div class="wo-mcard wo-tone-@tone" @onclick="() => OpenDetail(w)">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="fw-700">@PriorityBadge(w.Priority) @w.Title</div>
                    @ToneBadge(w, tone)
                </div>
                <div class="fs-8 text-muted num">@w.Number — مهلت: @w.DueAt.ToFa() @w.DueAt.ToString("HH:mm") @SourceLink(w.SourceModule, w.SourceId)</div>
                <div class="d-flex justify-content-between align-items-center">
                    <div class="fs-8 d-flex align-items-center gap-1"><UserAvatar LoginUserId="w.OwnerUserId" Size="22" CssClass="user-avatar-sm" /> @w.OwnerName — @w.Assignees.Count گیرنده (@w.Assignees.Count(a => a.RepliedAt != null) پاسخ)</div>
                    <div class="d-flex gap-1" @onclick:stopPropagation="true">
                        @if (CanEdit(w))
                        {
                            <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditFromList(w)"><i class="bi bi-pencil text-primary"></i></button>
                        }
                        <ArchiveButton Module="WorkOrders" RefId="@w.Id"
                                       Title="@($"{w.Number} — {w.Title}")"
                                       Link="@($"/work-orders?open={w.Id}")"
                                       Compact="true" />
                    </div>
                </div>
            </div>
        }
    </div>

    @* ================== صفحه‌بندی ================== *@
    @if (TotalPages > 1)
    {
        <div class="wo-pager mt-3">
            <button class="wo-page-btn" disabled="@(page <= 1)" @onclick="() => page--"><i class="bi bi-chevron-right"></i></button>
            @for (var pn = 1; pn <= TotalPages; pn++)
            {
                var p2 = pn;
                <button class="wo-page-btn num @(page == p2 ? "active" : "")" @onclick="() => page = p2">@p2</button>
            }
            <button class="wo-page-btn" disabled="@(page >= TotalPages)" @onclick="() => page++"><i class="bi bi-chevron-left"></i></button>
        </div>
    }
}

@* ================== مودال همه دستورهای یک روز ================== *@
@if (dayModalDate != null)
{
    var dayList = calItems.Where(c => c.DueAt.Date == dayModalDate.Value.Date).OrderBy(c => c.DueAt).ToList();
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content wo-modal">
                <div class="modal-header" style="background:linear-gradient(135deg,#1e3a8a,#2563eb);color:#fff;border:0">
                    <h6 class="modal-title">
                        <i class="bi bi-calendar-day"></i>
                        دستورهای کار @(pc.GetYear(dayModalDate.Value))/@(pc.GetMonth(dayModalDate.Value).ToString("00"))/@(pc.GetDayOfMonth(dayModalDate.Value).ToString("00"))
                        <span class="badge bg-light text-primary me-2">@dayList.Count مورد</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => dayModalDate = null"></button>
                </div>
                <div class="modal-body p-2">
                    @foreach (var o in dayList)
                    {
                        <div class="wo-day-item" @onclick="async () => { dayModalDate = null; await OpenById(o.Id); }">
                            <span class="wo-day-kind wo-k-@o.Kind.ToLower()"></span>
                            @if (o.Tone == "ontime")
                            {
                                <i class="bi bi-check-circle-fill" style="color:#22c55e"></i>
                            }
                            else if (o.Tone == "latedone")
                            {
                                <i class="bi bi-check-circle-fill" style="color:#a855f7"></i>
                            }
                            else if (o.Tone == "late" || (o.Status == "Closed" && o.Tone == "closed"))
                            {
                                <i class="bi bi-x-circle-fill" style="color:#ef4444"></i>
                            }
                            else if (o.Tone == "today")
                            {
                                <i class="bi bi-alarm-fill" style="color:#f59e0b"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle" style="color:#cbd5e1"></i>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-700 fs-8 text-truncate">@o.Title</div>
                                <div class="fs-9 text-muted num">@o.Number — ساعت @o.DueAt.ToString("HH:mm")</div>
                            </div>
                            <span class="fs-9 text-muted">@KindFa(o.Kind)</span>
                            <i class="bi bi-chevron-left text-muted"></i>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ================== مودال دستور کار جدید ================== *@
@if (showNew)
{
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down">
            <div class="modal-content wo-modal wo-form-modal">
                <div class="modal-header">
                    <h5 class="modal-title d-flex align-items-center flex-wrap gap-1">
                        <i class="bi bi-list-task text-primary"></i> @(editingId > 0 ? "ویرایش دستور کار" : "دستور کار جدید")
                        @if (chainParent != null)
                        {
                            <span class="badge bg-info-subtle text-info border ms-2" title="این دستور به‌صورت زیر-دستورِ متصل ساخته می‌شود">
                                🔗 زیر-دستورِ @chainParent.Number — @chainParent.Title
                            </span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_sourceLabel))
                        {
                            if (_sourceModule == "Document" && _sourceId is > 0)
                            {
                                @* پیوند مدرک مبدأ: آیکون (لگو) + شماره فرم — کلیک = باز شدن مدرک در آرشیو *@
                                <a class="wo-att ms-2" href="@($"/doc-archive/documents/{_sourceId}")" target="_blank" rel="noopener noreferrer"
                                   title="@($"مدرک {_sourceDocTitle} — کلیک کنید تا در آرشیو اسناد باز شود")">
                                    <i class="bi bi-file-earmark-text"></i><span>@_sourceLabel</span>
                                    @if (!string.IsNullOrWhiteSpace(_sourceDocTitle))
                                    {
                                        <span class="wo-att-sub">@_sourceDocTitle</span>
                                    }
                                </a>
                            }
                            else if (_sourceModule == "InnerLetter" && _sourceId is > 0)
                            {
                                <a class="wo-att ms-2" href="@($"/letters?open={_sourceId}")" target="_blank" rel="noopener noreferrer"
                                   title="باز کردن نامهٔ مبدأ">
                                    <i class="bi bi-envelope"></i><span>@_sourceLabel</span>
                                </a>
                            }
                            else
                            {
                                <span class="badge bg-primary-subtle text-primary border ms-2">از @_sourceLabel</span>
                            }
                        }
                    </h5>
                    <button type="button" class="btn-close" @onclick="CloseNewForm"></button>
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger py-2">@formError</div>
                    }
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label">عنوان <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="newTitle" placeholder="مثلاً: تهیه گزارش فروش ماهانه" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">گیرندگان <span class="text-danger">*</span></label>
                            @* کمبوی چندانتخابی با جستجو (بند ۷) *@
                            <div class="ms-combo">
                                <div class="ms-combo-control form-control @(tDropOpen ? "focus" : "")" @ref="_tComboEl" @onclick="ToggleTargetsCombo">
                                    @if (selTargets.Count == 0)
                                    {
                                        <span class="text-muted">— انتخاب افراد —</span>
                                    }
                                    @foreach (var t in targets.Where(t => selTargets.Contains(t.Id)))
                                    {
                                        <span class="ms-chip">@t.Username <i class="bi bi-x-circle-fill" @onclick:stopPropagation="true" @onclick="() => selTargets.Remove(t.Id)"></i></span>
                                    }
                                    <i class="bi bi-chevron-@(tDropOpen ? "up" : "down") ms-caret"></i>
                                </div>
                                @if (tDropOpen)
                                {
                                    <div class="pop-overlay" @onclick="() => tDropOpen = false" @onclick:stopPropagation="true"></div>
                                    <div class="ms-combo-menu shadow" style="@TargetsMenuStyle" @onclick:stopPropagation="true">
                                        <div class="p-2 border-bottom">
                                            <input class="form-control form-control-sm" placeholder="جستجو..." @bind="tSearch" @bind:event="oninput" @onclick:stopPropagation="true" />
                                        </div>
                                        <div class="ms-combo-items">
                                            @foreach (var t in targets.Where(t => string.IsNullOrWhiteSpace(tSearch) || t.Username.Contains(tSearch.Trim(), StringComparison.OrdinalIgnoreCase)))
                                            {
                                                var isSel = selTargets.Contains(t.Id);
                                                <div class="ms-combo-item @(isSel ? "sel" : "")" @onclick="() => { if (isSel) selTargets.Remove(t.Id); else selTargets.Add(t.Id); }">
                                                    <i class="bi @(isSel ? "bi-check-square-fill" : "bi-square")"></i> @t.Username
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!access.CanAssignOthers)
                            {
                                <div class="fs-8 text-muted mt-1">شما فقط مجاز به ثبت دستور کار برای خودتان هستید.</div>
                            }
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <label class="form-label">تاریخ مقرر (شمسی) <span class="text-danger">*</span></label>
                            <DatePicker @bind-Value="newDueDate" />
                        </div>
                        <div class="col-sm-6 col-lg-4">
                            <label class="form-label">ساعت مقرر</label>
                            <input type="time" class="form-control num" dir="ltr" @bind="newDueTime" />
                        </div>
                        <div class="col-12 col-lg-4">
                            <label class="form-label">اولویت</label>
                            <div class="wo-pr-group">
                                @foreach (var (val, fa) in PriorityOpts)
                                {
                                    var v2 = val;
                                    <button type="button" class="wo-pr-btn wo-pr-@v2 @(newPriority == v2 ? "active" : "")"
                                            @onclick="() => newPriority = v2">@fa</button>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-arrow-repeat"></i> تکرار خودکار
                                <span class="fs-9 text-muted">— بعد از «بستن»، نوبت بعدی با همان مشخصات ساخته می‌شود</span></label>
                            <div class="wo-pr-group">
                                @foreach (var (val, fa) in RecurrenceOpts)
                                {
                                    var v3 = val;
                                    <button type="button" class="wo-pr-btn @(newRecurrence == v3 ? "active" : "")"
                                            @onclick="() => newRecurrence = v3">@fa</button>
                                }
                            </div>
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-tags"></i> برچسب‌ها (اختیاری)
                                <span class="fs-9 text-muted">— حداکثر ۵ برچسب برای دسته‌بندی و فیلتر</span></label>
                            <div class="d-flex gap-2 mb-2">
                                <input class="form-control form-control-sm" placeholder="برچسب را بنویسید و Enter بزنید... (مثلاً: برق، کارگاه، فوری‌ها)"
                                       maxlength="30" @bind="newTagText" @bind:event="oninput" @onkeydown="OnTagKeyDown" />
                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                                        disabled="@(newTags.Count >= 5)" @onclick="AddTag">
                                    <i class="bi bi-plus-lg"></i> افزودن
                                </button>
                            </div>
                            @if (newTags.Count > 0)
                            {
                                <div class="d-flex gap-1 flex-wrap mb-1">
                                    @for (var ti = 0; ti < newTags.Count; ti++)
                                    {
                                        var tidx = ti;
                                        <span class="wo-tag">
                                            <i class="bi bi-tag-fill"></i> @newTags[tidx]
                                            <button type="button" class="wo-tag-x" title="حذف" @onclick="() => newTags.RemoveAt(tidx)"><i class="bi bi-x"></i></button>
                                        </span>
                                    }
                                </div>
                            }
                            @if (myTags.Count > 0)
                            {
                                <div class="d-flex gap-1 flex-wrap align-items-center">
                                    <span class="fs-9 text-muted">پیشنهاد:</span>
                                    @foreach (var t in myTags.Where(t => !newTags.Contains(t)).Take(8))
                                    {
                                        var t2 = t;
                                        <button type="button" class="wo-tag-suggest" @onclick="() => AddSuggestedTag(t2)">@t2</button>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-check2-square"></i> چک‌لیست زیرکار (اختیاری)</label>
                            <div class="d-flex gap-2 mb-2">
                                <input class="form-control form-control-sm" placeholder="گام بعدی را بنویسید و Enter بزنید..."
                                       @bind="newClText" @bind:event="oninput" @onkeydown="OnClKeyDown" />
                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" @onclick="AddChecklistItem">
                                    <i class="bi bi-plus-lg"></i> افزودن
                                </button>
                            </div>
                            @if (newChecklist.Count > 0)
                            {
                                <div class="wo-cl-editor">
                                    @for (var ci = 0; ci < newChecklist.Count; ci++)
                                    {
                                        var idx = ci;
                                        <div class="wo-cl-row">
                                            <span class="wo-cl-num num">@(idx + 1)</span>
                                            <span class="flex-grow-1">@newChecklist[idx]</span>
                                            <button type="button" class="btn btn-sm btn-light text-danger" title="حذف"
                                                    @onclick="() => RemoveChecklistItem(idx)"><i class="bi bi-x"></i></button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                        <div class="col-12">
                            <label class="form-label">شرح (بند ۳ — ادیتور)</label>
                            <RteEditor @ref="rte" />
                        </div>
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-paperclip"></i> پیوست (اختیاری)</label>
                            <InputFile class="form-control" OnChange="OnFilesSelected" multiple />
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" @onclick="CloseNewForm">انصراف</button>
                    <button class="btn btn-primary px-4" disabled="@busy" @onclick="SubmitNew">
                        @if (busy) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                        <i class="bi bi-send"></i> @(editingId > 0 ? "ذخیره تغییرات" : "ثبت دستور کار")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ================== مودال جزئیات ================== *@
@if (detail != null)
{
    var isOwner = detail.OwnerUserId == access.UserId;
    var myAsg = detail.Assignees.FirstOrDefault(a => a.UserId == access.UserId);
    var tone = Tone(detail);
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content wo-modal">
                <div class="modal-header">
                    <div>
                        <h5 class="modal-title mb-1">@detail.Title</h5>
                        <span class="badge bg-dark-subtle text-dark border num me-1">@detail.Number</span>
                        @PriorityBadge(detail.Priority)
                        @if (detail.Recurrence > 0)
                        {
                            <span class="badge bg-info-subtle text-info border">🔁 @RecurrenceFa(detail.Recurrence)</span>
                        }
                        @foreach (var t in detail.Tags)
                        {
                            <span class="wo-tag wo-tag-sm"><i class="bi bi-tag-fill"></i> @t</span>
                        }
                        @ToneBadge(detail, tone)
                        @if (detail.ExtensionCount > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning border">تمدید @detail.ExtensionCount از ۵</span>
                        }
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        @if (Auth.HasModule("Chat") && ChatTargets(detail).Any())
                        {
                            <div class="wo-chat-wrap">
                                <button type="button" class="btn btn-sm btn-outline-info" title="گفتگو دربارهٔ این دستور در پیام‌رسان"
                                        disabled="@chatBusy" @onclick="ToggleChatMenu">
                                    @if (chatBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-chat-dots"></i> }
                                    گفتگو
                                </button>
                                @if (chatMenuOpen)
                                {
                                    <div class="wo-chat-menu shadow">
                                        @foreach (var t in ChatTargets(detail))
                                        {
                                            var t2 = t;
                                            <button type="button" class="wo-chat-item" @onclick="() => StartChatAbout(t2.Id, t2.Name)">
                                                <UserAvatar LoginUserId="t2.Id" Size="22" CssClass="user-avatar-sm" />
                                                <span>@t2.Name</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenGardesh">
                            <i class="bi bi-diagram-3"></i> گردش کار
                        </button>
                        @if (isOwner && detail.Status == "Open")
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenEditFromDetail">
                                <i class="bi bi-pencil"></i> ویرایش
                            </button>
                        }
                        <button type="button" class="btn-close" @onclick="() => detail = null"></button>
                    </div>
                </div>
                <div class="modal-body">
                        <div class="wo-info mb-3">
                            <div><span class="wo-lbl">دستوردهنده</span><span>@detail.OwnerName</span></div>
                            <div><span class="wo-lbl">مهلت</span><span class="num">@detail.DueAt.ToFa() @detail.DueAt.ToString("HH:mm")</span></div>
                            <div><span class="wo-lbl">تاریخ ثبت</span><span class="num">@detail.CreatedAt.ToFa()</span></div>
                            @if (!string.IsNullOrWhiteSpace(detail.SourceModule) && detail.SourceId is > 0)
                            {
                                <div>
                                    <span class="wo-lbl">منبع</span><span class="d-inline-flex align-items-center flex-wrap gap-1">
                                        @SourceLink(detail.SourceModule, detail.SourceId)
                                        @if (detail.SourceModule == "Document" && _docRefs.TryGetValue(detail.Id, out var docRef))
                                        {
                                            <span class="text-muted fs-9">@docRef.Code — @docRef.Title</span>
                                        }
                                    </span>
                                </div>
                            }
                        </div>
                    @if (!string.IsNullOrWhiteSpace(detail.Description))
                    {
                        <div class="wo-block mb-3">
                            <div class="wo-block-title"><i class="bi bi-card-text"></i> شرح</div>
                            <div class="wo-block-body">@((MarkupString)detail.Description)</div>
                        </div>
                    }

                    @* ---------- چک‌لیست زیرکار + درصد پیشرفت ---------- *@
                    @if (detailChecklist.Count > 0)
                    {
                        var clDone = detailChecklist.Count(c => c.IsDone);
                        var clPct = clDone * 100 / detailChecklist.Count;
                        <div class="wo-block mb-3">
                            <div class="wo-block-title d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="bi bi-check2-square"></i> چک‌لیست (@clDone از @detailChecklist.Count)</span>
                                <div class="d-flex align-items-center gap-2" style="min-width:160px">
                                    <div class="wo-bar-track flex-grow-1">
                                        <div class="wo-bar" style="width:@clPct%;background:@(clPct == 100 ? "#22c55e" : "#3b82f6")"></div>
                                    </div>
                                    <span class="fs-9 num fw-700">@clPct%</span>
                                </div>
                            </div>
                            <div class="wo-block-body">
                                @foreach (var c in detailChecklist.OrderBy(x => x.SortOrder))
                                {
                                    var canTick = detail.Status == "Open" &&
                                        (isOwner || detail.Assignees.Any(a => a.UserId == access.UserId));
                                    <div class="wo-cl-item @(c.IsDone ? "done" : "") @(canTick ? "tickable" : "")"
                                         @onclick="async () => { if (canTick) await ToggleChecklist(c); }">
                                        <i class="bi @(c.IsDone ? "bi-check-square-fill text-success" : "bi-square")"></i>
                                        <span class="flex-grow-1">@c.Text</span>
                                        @if (c.IsDone && !string.IsNullOrWhiteSpace(c.DoneByName))
                                        {
                                            <span class="fs-9 text-muted">@c.DoneByName@(c.DoneAt != null ? $" — {c.DoneAt.Value.ToFa()}" : "")</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                    @* ---------- پیوست‌ها — کامپوننت جامع (یک کد برای همه فرم‌ها) ---------- *@
                    <div class="mb-3 d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="flex-grow-1">
                            <AttachmentBox Module="WorkOrders" RefId="@detail.Id" CanUpload="@(detail.Status == "Open")" />
                        </div>
                        <ArchiveButton Module="WorkOrders" RefId="@detail.Id"
                                       Title="@($"{detail.Number} — {detail.Title}")"
                                       Link="@($"/work-orders?open={detail.Id}")" />
                    </div>

                    @* ---------- گیرندگان + عملیات ---------- *@
                    <div class="wo-block mb-3">
                        <div class="wo-block-title"><i class="bi bi-people"></i> گیرندگان (@detail.Assignees.Count(a => a.RepliedAt != null)/@detail.Assignees.Count پاسخ)</div>
                        <div class="wo-block-body">
                            @foreach (var a in detail.Assignees)
                            {
                                <div class="wo-asg">
                                    <div class="d-flex justify-content-between flex-wrap gap-1 align-items-center">
                                        <span class="fw-700 d-inline-flex align-items-center gap-1"><UserAvatar LoginUserId="a.UserId" Size="24" CssClass="user-avatar-sm" /> @a.Name</span>
                                        <div class="d-flex gap-1 flex-wrap">
                                            <span class="badge bg-light text-dark border fs-9">رویت: @(a.SeenAt == null ? "—" : a.SeenAt.Value.ToFa())</span>
                                            @if (a.Done == true)
                                            {
                                                <span class="badge bg-success-subtle text-success border">✅ انجام شد</span>
                                            }
                                            else if (a.Done == false)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border">❌ انجام نشد</span>
                                            }
                                            @if (a.OwnerDecision == "Approved")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border">تایید ✔</span>
                                            }
                                            else if (a.OwnerDecision == "Rejected")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border">رد شده</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(a.ReplyText))
                                    {
                                        <div class="wo-reply mt-1">@a.ReplyText</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.OwnerDecisionNote))
                                    {
                                        <div class="fs-8 text-muted mt-1">یادداشت دستوردهنده: @a.OwnerDecisionNote</div>
                                    }

                                    @* پاسخ گیرنده *@
                                    @if (detail.Status == "Open" && a.UserId == access.UserId && a.RepliedAt == null)
                                    {
                                        <div class="mt-2 p-2 rounded-3" style="background:#f0fdf4;border:1px dashed #86efac">
                                            <div class="d-flex gap-3 mb-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="wodone" id="wod-y" checked="@(myDone == true)" @onchange="() => myDone = true" />
                                                    <label class="form-check-label text-success fw-600" for="wod-y">✅ انجام شد</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="wodone" id="wod-n" checked="@(myDone == false)" @onchange="() => myDone = false" />
                                                    <label class="form-check-label text-danger fw-600" for="wod-n">❌ انجام نشد</label>
                                                </div>
                                            </div>
                                            <textarea class="form-control form-control-sm" rows="2" placeholder="شرح پاسخ..." @bind="myReply"></textarea>
                                            <button class="btn btn-success btn-sm mt-2" disabled="@busy" @onclick="SubmitReply"><i class="bi bi-check2"></i> ثبت پاسخ</button>
                                        </div>
                                    }

                                    @* تصمیم دستوردهنده *@
                                    @if (detail.Status == "Open" && isOwner && a.RepliedAt != null && a.OwnerDecision == null)
                                    {
                                        <div class="mt-2 p-2 rounded-3" style="background:#fffbeb;border:1px dashed #fcd34d">
                                            <input class="form-control form-control-sm mb-2" placeholder="یادداشت (اختیاری)" @bind="decideNotes[a.Id]" />
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-success btn-sm" disabled="@busy" @onclick="() => Decide(a.Id, true)"><i class="bi bi-check2"></i> تایید</button>
                                                <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => Decide(a.Id, false)"><i class="bi bi-x-lg"></i> رد (برگشت)</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    @* ---------- تمدید و بستن (فقط دستوردهنده) ---------- *@
                    @if (detail.Status == "Open" && isOwner)
                    {
                        <div class="wo-block mb-3" style="border-color:#e9d5ff">
                            <div class="wo-block-title" style="background:#faf5ff"><i class="bi bi-sliders" style="color:#7c3aed"></i> عملیات دستوردهنده</div>
                            <div class="wo-block-body">
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-md-4">
                                        <label class="form-label fs-8">تمدید مهلت (@detail.ExtensionCount از ۵)</label>
                                        <DatePicker @bind-Value="extDate" />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="time" class="form-control num" dir="ltr" @bind="extTime" />
                                    </div>
                                    <div class="col-md-5">
                                        <button class="btn btn-warning btn-sm w-100" disabled="@(busy || detail.ExtensionCount >= 5)" @onclick="SubmitExtend">
                                            <i class="bi bi-clock-history"></i> تمدید مهلت
                                        </button>
                                    </div>
                                </div>
                                <hr />
                                <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="یادداشت بستن (اختیاری)..." @bind="closeNote"></textarea>
                                <button class="btn btn-danger" disabled="@busy" @onclick="SubmitClose">
                                    <i class="bi bi-lock"></i> تایید نهایی و بستن دستور کار
                                </button>
                                <div class="fs-8 text-muted mt-1">حتی اگر کار انجام نشده باشد، می‌توانید ببندید — بعد از بستن هیچ‌کس نمی‌تواند تغییری بدهد.</div>
                            </div>
                        </div>
                    }
                    @if (detail.Status == "Closed")
                    {
                        <div class="alert alert-secondary py-2 fs-8">
                            <i class="bi bi-lock-fill"></i> این دستور کار در @(detail.ClosedAt?.ToFa()) نهایی و بسته شده است.
                            @if (!string.IsNullOrWhiteSpace(detail.CloseNote))
                            {
                                <div class="mt-1">یادداشت: @detail.CloseNote</div>
                            }
                        </div>
                    }

                    @* ---------- ارجاع زنجیره‌ای (والد / زیر-دستورها) ---------- *@
                    @{
                        var canChain = detail.Status == "Open" && access.CanCreate &&
                            (isOwner || detail.Assignees.Any(a => a.UserId == access.UserId));
                    }
                    @if (detail.ParentOrderId != null || detail.Children.Count > 0 || canChain)
                    {
                        <div class="wo-block mb-3">
                            <div class="wo-block-title d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="bi bi-link-45deg"></i> زنجیرهٔ ارجاع</span>
                                @if (canChain)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 fs-8" @onclick="OpenChainForm">
                                        <i class="bi bi-diagram-2"></i> ارجاع بخشی از کار (زیر-دستور)
                                    </button>
                                }
                            </div>
                            <div class="wo-block-body">
                                @if (detail.ParentOrderId != null)
                                {
                                    <div class="wo-chain-row">
                                        <i class="bi bi-arrow-up-left-circle text-secondary"></i>
                                        <span class="fs-8 text-muted">والد:</span>
                                        <a class="wo-chain-link" @onclick="() => OpenById(detail.ParentOrderId.Value)" @onclick:preventDefault="true" href="">
                                            @detail.ParentNumber — @detail.ParentTitle
                                        </a>
                                    </div>
                                }
                                @if (detail.Children.Count > 0)
                                {
                                    <div class="fs-8 text-muted mb-1 mt-1">
                                        زیر-دستورها (@detail.Children.Count(c => c.Status == "Closed") از @detail.Children.Count بسته):
                                    </div>
                                    @foreach (var ch in detail.Children)
                                    {
                                        var ch2 = ch;
                                        <div class="wo-chain-row">
                                            <i class="bi @(ch2.Status == "Closed" ? "bi-check-circle-fill text-success" : "bi-circle text-warning")"></i>
                                            <a class="wo-chain-link" @onclick="() => OpenById(ch2.Id)" @onclick:preventDefault="true" href="">
                                                @ch2.Number — @ch2.Title
                                            </a>
                                            <span class="fs-9 text-muted">(@ch2.OwnerName)</span>
                                            <span class="badge @(ch2.Status == "Closed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") border fs-9">
                                                @(ch2.Status == "Closed" ? "بسته" : "باز")
                                            </span>
                                        </div>
                                    }
                                    @if (detail.Children.Any(c => c.Status == "Open") && isOwner)
                                    {
                                        <div class="fs-9 text-muted mt-1"><i class="bi bi-info-circle"></i> تا بسته‌شدن همهٔ زیر-دستورهای باز، این دستور قابل بستن نیست.</div>
                                    }
                                }
                                else if (detail.ParentOrderId == null && canChain)
                                {
                                    <div class="fs-8 text-muted">می‌توانید بخشی از این کار را به‌صورت زیر-دستورِ متصل به نفر بعدی ارجاع دهید — پیشرفت آن همین‌جا دیده می‌شود.</div>
                                }
                            </div>
                        </div>
                    }

                    @* ---------- رشتهٔ گفتگو (کامنت‌ها) ---------- *@
                    @{
                        var canComment = detail.Status == "Open" &&
                            (isOwner || detail.Assignees.Any(a => a.UserId == access.UserId));
                    }
                    <div class="wo-block mb-3">
                        <div class="wo-block-title"><i class="bi bi-chat-left-text"></i> گفتگو (@comments.Count(c => !c.IsDeleted))</div>
                        <div class="wo-block-body">
                            @if (comments.Count == 0)
                            {
                                <div class="fs-8 text-muted">هنوز کامنتی ثبت نشده است.</div>
                            }
                            @foreach (var cm in comments)
                            {
                                var mine = cm.AuthorUserId == access.UserId;
                                <div class="wo-cm @(mine ? "mine" : "")" id="wo-cm-@cm.Id">
                                    <UserAvatar LoginUserId="cm.AuthorUserId" Size="28" CssClass="user-avatar-sm" />
                                    <div class="wo-cm-bubble">
                                        <div class="wo-cm-head">
                                            <span class="fw-700 fs-8">@cm.AuthorName</span>
                                            <span class="fs-9 text-muted num">@cm.CreatedAt.ToFa() @cm.CreatedAt.ToString("HH:mm")</span>
                                            @if (cm.EditedAt != null && !cm.IsDeleted)
                                            {
                                                <span class="fs-9 text-muted">(ویرایش‌شده)</span>
                                            }
                                        </div>
                                        @if (cm.ReplyToId != null)
                                        {
                                            var parent = comments.FirstOrDefault(x => x.Id == cm.ReplyToId);
                                            <div class="wo-cm-quote">
                                                <i class="bi bi-reply-fill"></i>
                                                @(parent == null || parent.IsDeleted ? "کامنت حذف‌شده" : $"{parent.AuthorName}: {Brief(parent.Text)}")
                                            </div>
                                        }
                                        @if (cm.IsDeleted)
                                        {
                                            <div class="fs-8 text-muted fst-italic"><i class="bi bi-trash"></i> این کامنت حذف شده است.</div>
                                        }
                                        else if (editingCommentId == cm.Id)
                                        {
                                            <textarea class="form-control form-control-sm mb-1" rows="2" @bind="editingCommentText"></textarea>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-primary py-0 fs-8" disabled="@cmBusy" @onclick="SubmitEditComment">ذخیره</button>
                                                <button class="btn btn-sm btn-light py-0 fs-8" @onclick="CancelEditComment">انصراف</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="wo-cm-text">@cm.Text</div>
                                            @if (canComment)
                                            {
                                                <div class="wo-cm-actions">
                                                    <button class="wo-cm-link" @onclick="() => SetReplyTo(cm)"><i class="bi bi-reply"></i> پاسخ</button>
                                                    @if (mine)
                                                    {
                                                        <button class="wo-cm-link" @onclick="() => StartEditComment(cm)"><i class="bi bi-pencil"></i> ویرایش</button>
                                                    }
                                                    @if (mine || isOwner)
                                                    {
                                                        <button class="wo-cm-link text-danger" @onclick="() => DeleteComment(cm)"><i class="bi bi-trash"></i> حذف</button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (canComment)
                            {
                                <div class="mt-2 pt-2 border-top">
                                    @if (replyTo != null)
                                    {
                                        <div class="wo-cm-quote d-flex justify-content-between align-items-center mb-1">
                                            <span><i class="bi bi-reply-fill"></i> پاسخ به @replyTo.AuthorName: @Brief(replyTo.Text)</span>
                                            <button class="wo-cm-link" @onclick="() => replyTo = null"><i class="bi bi-x-lg"></i></button>
                                        </div>
                                    }
                                    <div class="d-flex gap-2 align-items-start">
                                        <textarea class="form-control form-control-sm" rows="2" maxlength="2000"
                                                  placeholder="کامنت خود را بنویسید... (برای همهٔ طرف‌های دستور اعلان می‌رود)"
                                                  @bind="newCommentText" @bind:event="oninput"></textarea>
                                        <button class="btn btn-primary btn-sm" style="white-space:nowrap"
                                                disabled="@(cmBusy || string.IsNullOrWhiteSpace(newCommentText))" @onclick="SubmitComment">
                                            @if (cmBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                            else { <i class="bi bi-send"></i> }
                                            ارسال
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (detail.Status == "Closed")
                            {
                                <div class="fs-9 text-muted mt-2"><i class="bi bi-lock"></i> دستور بسته شده — ثبت کامنت جدید ممکن نیست.</div>
                            }
                        </div>
                    </div>

                    @* ---------- تاریخچه (بند ۱۷ و ۱۸) ---------- *@
                    @if (logs.Any())
                    {
                        <div class="wo-block mb-2">
                            <div class="wo-block-title"><i class="bi bi-clock-history"></i> تاریخچه رفت‌وبرگشت‌ها</div>
                            <div class="wo-block-body p-0">
                                <div class="wo-timeline">
                                    @foreach (var l in logs)
                                    {
                                        <div class="wo-tl-item">
                                            <div class="wo-tl-dot wo-tl-@l.Action.ToLower()"></div>
                                            <div>
                                                <div class="fs-8"><span class="fw-700">@l.ActorName</span> — @ActionFa(l.Action)</div>
                                                @if (!string.IsNullOrWhiteSpace(l.Text))
                                                {
                                                    <div class="fs-8 text-muted">@l.Text</div>
                                                }
                                                <div class="fs-9 text-muted num">@l.CreatedAt.ToFa() @l.CreatedAt.ToString("HH:mm")</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .wo-tabs { display: flex; gap: .5rem; flex-wrap: wrap; }
    .wo-tab { border: 1px solid #e2e8f0; background: #fff; border-radius: 12px; padding: .5rem 1rem; font-size: .88rem; font-weight: 600; color: #475569; display: inline-flex; align-items: center; gap: .45rem; cursor: pointer; transition: all .15s; }
    .wo-tab:hover { border-color: #93c5fd; color: #2563eb; }
    .wo-tab.active { background: #2563eb; border-color: #2563eb; color: #fff; box-shadow: 0 4px 12px rgba(37,99,235,.3); }
    .wo-tab-badge { background: rgba(0,0,0,.08); border-radius: 999px; padding: 0 .5rem; font-size: .75rem; }
    .wo-tab.active .wo-tab-badge { background: rgba(255,255,255,.25); }

    /* ---------- نوار جستجو و فیلتر ---------- */
    .wo-filterbar { display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
    .wo-flt-search { position: relative; flex: 1 1 240px; max-width: 380px; }
    .wo-flt-search > i.bi-search { position: absolute; right: .65rem; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: .85rem; pointer-events: none; }
    .wo-flt-search input { padding-right: 2rem; padding-left: 1.8rem; border-radius: 10px; }
    .wo-flt-clear { position: absolute; left: .35rem; top: 50%; transform: translateY(-50%); border: 0; background: none; color: #94a3b8; padding: .15rem .3rem; }
    .wo-flt-clear:hover { color: #ef4444; }

    /* ---------- دکمه‌های اولویت (فرم + فیلتر) ---------- */
    .wo-pr-group { display: inline-flex; gap: .35rem; flex-wrap: wrap; }
    .wo-pr-btn { border: 1px solid var(--border, #e2e8f0); background: #fff; border-radius: 999px; padding: .3rem .8rem; font-size: .8rem; color: #475569; transition: all .15s; }
    .wo-pr-btn:hover { border-color: #94a3b8; }
    .wo-pr-btn.active { background: #1e293b; border-color: #1e293b; color: #fff; font-weight: 700; }
    .wo-pr-btn.wo-pr-3.active { background: #dc2626; border-color: #dc2626; }
    .wo-pr-btn.wo-pr-2.active { background: #ea580c; border-color: #ea580c; }
    .wo-pr-btn.wo-pr-0.active { background: #64748b; border-color: #64748b; }

    /* ---------- نشان اولویت در لیست/جزئیات ---------- */
    .wo-prb-3 { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .wo-prb-2 { background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; }
    .wo-prb-0 { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }

    /* ---------- چک‌لیست زیرکار ---------- */
    .wo-cl-editor { border: 1px solid var(--border, #e2e8f0); border-radius: 10px; overflow: hidden; }
    .wo-cl-row { display: flex; align-items: center; gap: .5rem; padding: .35rem .6rem; border-bottom: 1px solid #f1f5f9; font-size: .85rem; }
    .wo-cl-row:last-child { border-bottom: 0; }
    .wo-cl-num { width: 22px; height: 22px; border-radius: 50%; background: #eef2ff; color: #4f46e5; display: inline-flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 700; flex-shrink: 0; }
    .wo-cl-item { display: flex; align-items: center; gap: .55rem; padding: .4rem .5rem; border-radius: 8px; font-size: .88rem; }
    .wo-cl-item.tickable { cursor: pointer; }
    .wo-cl-item.tickable:hover { background: #f8fafc; }
    .wo-cl-item.done > span.flex-grow-1 { text-decoration: line-through; color: #94a3b8; }
    .wo-cl-item i.bi { font-size: 1.05rem; color: #94a3b8; }

    /* ---------- داشبورد آماری ---------- */
    .wo-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .75rem; }
    .wo-kpi { background: #fff; border: 1px solid var(--border, #e2e8f0); border-radius: 14px; padding: .9rem 1rem; text-align: center; }
    .wo-kpi-num { font-size: 1.6rem; font-weight: 800; line-height: 1.2; }
    .wo-kpi-lbl { font-size: .75rem; color: #64748b; margin-top: .15rem; }
    .wo-kpi.k-open .wo-kpi-num { color: #2563eb; }
    .wo-kpi.k-late .wo-kpi-num { color: #ef4444; }
    .wo-kpi.k-today .wo-kpi-num { color: #f59e0b; }
    .wo-kpi.k-ontime .wo-kpi-num { color: #22c55e; }
    .wo-kpi.k-latedone .wo-kpi-num { color: #a855f7; }
    .wo-bar-track { height: 8px; background: #f1f5f9; border-radius: 999px; overflow: hidden; }
    .wo-bar { height: 100%; border-radius: 999px; background: #3b82f6; transition: width .3s; }
    .wo-bar-p3 { background: #dc2626; }
    .wo-bar-p2 { background: #ea580c; }
    .wo-bar-p1 { background: #3b82f6; }
    .wo-bar-p0 { background: #94a3b8; }
    .wo-chart { display: flex; gap: .5rem; align-items: stretch; height: 160px; }
    .wo-chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: .25rem; }
    .wo-chart-bars { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 3px; }
    .wo-cb { width: 12px; border-radius: 4px 4px 0 0; min-height: 2px; }
    .wo-cb-created { background: #94a3b8; }
    .wo-cb-ontime { background: #22c55e; }
    .wo-cb-late { background: #a855f7; }
    .wo-cb-notdone { background: #ef4444; }
    .wo-empty { text-align: center; padding: 3.5rem 1rem; color: #94a3b8; }
