    private Dictionary<int, string> decideNotes = new();
    private DateTime? extDate;
    private TimeOnly extTime = new(14, 0);

    // تقویم
    private int calYear, calMonth, calDays, calOffset;
    private DateTime? dayModalDate;

    private void OpenDayModal(DateTime day) => dayModalDate = day;

    private static string KindFa(string k) => k switch
    {
        "Self" => "برای خودم", "Others" => "برای دیگران",
        "Mixed" => "مشترک", _ => "محول به من"
    };

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("دستور کار");
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        try { access = await Http.GetFromJsonAsync<AccessInfo>("/api/workorders/my-access") ?? new(); } catch { }
        await LoadAll();

        var now = DateTime.Now;
        calYear = pc.GetYear(now); calMonth = pc.GetMonth(now);
        RecalcCal();
        loading = false;

        Rt.DataChanged += OnRtChanged;
        await Rt.EnsureStartedAsync(apiBase, access.UserId);
        await TryOpenFromQuery();
        Nav.LocationChanged += OnLocChanged;
    }

    private async void OnRtChanged(string scope)
    {
        if (scope != "workorders") return;
        await LoadAll();
        if (tab == "calendar") await LoadCal();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await TryOpenFromQuery();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Rt.DataChanged -= OnRtChanged;
        Nav.LocationChanged -= OnLocChanged;
    }

    private async Task TryOpenFromQuery()
    {
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (qs["tab"] == "calendar" && tab != "calendar") { tab = "calendar"; await LoadCal(); }

        // باز کردن فرم «دستور کار جدید» از یک مبدأ (سورس) — مثلاً تبدیل نامه به دستور کار
        var srcModule = qs["sourceModule"];
        if (!string.IsNullOrWhiteSpace(srcModule) && int.TryParse(qs["sourceId"], out var srcId) && srcId > 0 && !_sourceHandled)
        {
            _sourceHandled = true;
            await OpenFromSourceAsync(srcModule, srcId);
            return;
        }

        if (!int.TryParse(qs["open"], out var id) || id <= 0) return;
        await OpenById(id);
    }

    private async Task OpenById(int id)
    {
        var w = mineItems.FirstOrDefault(x => x.Id == id)
             ?? assignedItems.FirstOrDefault(x => x.Id == id)
             ?? archiveItems.FirstOrDefault(x => x.Id == id);
        // اگر در لیست‌های من نبود (مثلاً لینک «دستورکار شده» یک نامه)، مستقیم واکشی می‌کنیم
        if (w == null)
        {
            try { w = await Http.GetFromJsonAsync<WoItem>($"/api/workorders/{id}"); } catch { }
        }
        if (w != null)
        {
            tab = w.Status == "Closed" ? "archive" : (w.OwnerUserId == access.UserId ? "mine" : "assigned");
            await OpenDetail(w);
        }
    }

    private async Task LoadAll()
    {
        try { mineItems = await Http.GetFromJsonAsync<List<WoItem>>("/api/workorders/mine") ?? new(); } catch { }
        try { assignedItems = await Http.GetFromJsonAsync<List<WoItem>>("/api/workorders/assigned") ?? new(); } catch { }
        try { archiveItems = await Http.GetFromJsonAsync<List<WoItem>>("/api/workorders/archive") ?? new(); } catch { }
    }

    private void SwitchTab(string t)
    {
        tab = t; page = 1;
        if (t == "calendar") _ = LoadCal();
    }

    private void ToggleExpand(int id)
    {
        if (!expanded.Add(id)) expanded.Remove(id);
    }

    // ================== رنگ‌بندی مهلت (بند ۱۱ و ۱۲) ==================
    private string Tone(WoItem w)
    {
        var allDone = w.Assignees.Count > 0 && w.Assignees.All(a => a.Done == true);
        if (allDone)
        {
            // بند ۱۲: ملاک، زمان «پاسخ» است نه زمان تایید دستوردهنده
            var lastReply = w.Assignees.Max(a => a.RepliedAt) ?? DateTime.MaxValue;
            return lastReply <= w.DueAt ? "ontime" : "latedone";
        }
        if (w.Status == "Closed") return "none";
        if (w.DueAt < DateTime.Now && w.DueAt.Date != DateTime.Today) return "late";
        if (w.DueAt.Date == DateTime.Today) return DateTime.Now > w.DueAt ? "late" : "today";
        return "none";
    }

    /// <summary>لینک به نامهٔ مبدأ (سورس) در کارتابل نامه داخلی — برای اتصال برگشتی.</summary>
    private RenderFragment? SourceLink(string? module, int? sourceId)
        => !string.IsNullOrWhiteSpace(module) && sourceId is > 0
            ? @<a class="wo-att" href="@($"/letters?open={sourceId}")" target="_blank" title="رفتن به نامه مبدأ">
                <i class="bi bi-envelope"></i> نامه
              </a>
            : null;

    private RenderFragment ToneBadge(WoItem w, string tone) => tone switch
    {
        "late" => @<span class="badge bg-danger-subtle text-danger border">⏰ گذشته از مهلت</span>,
        "today" => @<span class="badge bg-warning-subtle text-warning border">📅 مهلت امروز</span>,
        "ontime" => @<span class="badge bg-success-subtle text-success border">✅ انجام به‌موقع</span>,
        "latedone" => @<span class="badge" style="background:#faf5ff;color:#a855f7;border:1px solid #e9d5ff">🕓 انجام با تاخیر</span>,
        _ => w.Status == "Closed"
            ? @<span class="badge bg-secondary-subtle text-secondary border">بسته شده 🔒</span>
            : @<span class="badge bg-light text-dark border">در جریان</span>
    };

    // ================== دستور کار جدید ==================
    private async Task OpenNew()
    {
        _sourceModule = null; _sourceId = null; _sourceLabel = "";
        await ShowNewFormAsync("", "");
    }

    /// <summary>باز کردن فرم ایجاد از یک مبدأ (سورس) — پیش‌پُرش عنوان/شرح/گیرندگان از نامه.</summary>
    private async Task OpenFromSourceAsync(string module, int sourceId)
    {
        if (!access.CanCreate)
        {
            Toast.Error("شما مجوز ایجاد دستور کار را ندارید.");
            return;
        }
        _sourceModule = module; _sourceId = sourceId; _sourceLabel = module;
        // فقط برای نامه داخلی، جزئیات نامه را می‌گیریم تا فرم پیش‌پُر شود
        if (module == "InnerLetter")
        {
            try
            {
                var letter = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.InnerLetterDetailDto>($"/api/letters/{sourceId}");
                if (letter != null)
                {
                    _sourceLabel = $"نامه # {letter.LetterNumber}";
                    await ShowNewFormAsync(letter.Title, letter.Text ?? "");

                    // پیش‌انتخاب گیرندگانِ گردش نامه (گیرنده/ارجاع/هامش) — قابل ویرایش/حذف
                    foreach (var u in letter.ReciversGirande) selTargets.Add(u.UserId);
                    foreach (var u in letter.ReciversErja) selTargets.Add(u.UserId);
                    foreach (var u in letter.ReciversHamesh) selTargets.Add(u.UserId);
                    AugmentTargets(letter);
                }
                else await ShowNewFormAsync("", "");
            }
            catch (Exception ex)
            {
                Toast.Error($"بارگذاری نامه ناموفق بود: {ex.Message}");
                await ShowNewFormAsync("", "");
            }
        }
        else
        {
            await ShowNewFormAsync("", "");
        }
        StateHasChanged();
    }

    /// <summary>باز کردن فرم (ریست + لود لیست افراد مجاز + تنظیم ادیتور).</summary>
    private async Task ShowNewFormAsync(string title, string desc)
    {
        formError = ""; newTitle = title; selTargets = new(); tDropOpen = false; tSearch = "";
        newDueDate = DateTime.Today.AddDays(1); newDueTime = new(14, 0);
        newFiles.Clear();
        try { targets = await Http.GetFromJsonAsync<List<TargetOpt>>("/api/workorders/targets") ?? new(); } catch { }
        showNew = true;
        StateHasChanged();
        await Task.Delay(80);
        try { await JS.InvokeVoidAsync("rteSetHtml", "rte-wo", desc ?? ""); } catch { }
    }

    /// <summary>گیرندگان گردش نامه که در لیست مجاز نیستند را به‌عنوان گزینه اضافه می‌کند تا چیپ قابل نمایش باشند.</summary>
    private void AugmentTargets(Inventory.Shared.Dtos.InnerLetterDetailDto letter)
    {
        var known = targets.Select(t => t.Id).ToHashSet();
        foreach (var u in letter.ReciversGirande.Concat(letter.ReciversErja).Concat(letter.ReciversHamesh))
        {
            if (u.UserId > 0 && !known.Contains(u.UserId))
                targets.Add(new TargetOpt { Id = u.UserId, Username = string.IsNullOrWhiteSpace(u.FullName) ? $"کاربر {u.UserId}" : u.FullName });
        }
    }

    private void OnFilesSelected(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
        => newFiles = e.GetMultipleFiles(5).ToList();

    private async Task RteCmd(string cmd) { try { await JS.InvokeVoidAsync("rteExec", cmd); } catch { } }

    private async Task SubmitNew()
    {
        formError = "";
        if (string.IsNullOrWhiteSpace(newTitle)) { formError = "عنوان را وارد کنید."; return; }
        if (selTargets.Count == 0) { formError = "حداقل یک نفر را انتخاب کنید."; return; }
        if (newDueDate == null) { formError = "تاریخ مقرر را انتخاب کنید."; return; }
        // بند ۱: تاریخ/ساعت مقرر نباید قبل از الان باشد
        var dueCheck = newDueDate.Value.Date.Add(newDueTime.ToTimeSpan());
        if (dueCheck <= DateTime.Now)
        { formError = "تاریخ و ساعت مقرر نمی‌تواند قبل از زمان ثبت باشد."; return; }

        busy = true;
        try
        {
            string desc = "";
            try { desc = await JS.InvokeAsync<string>("rteGetHtml", "rte-wo") ?? ""; } catch { }
            var due = newDueDate.Value.Date.Add(newDueTime.ToTimeSpan());

            var resp = await Http.PostAsJsonAsync("/api/workorders", new
            {
                title = newTitle, description = desc, dueAt = due,
                assigneeUserIds = selTargets.ToList(),
                sourceModule = _sourceModule, sourceId = _sourceId
            });
            if (!resp.IsSuccessStatusCode)
            {
                formError = await resp.Content.ReadAsStringAsync();
                return;
            }
            var created = await resp.Content.ReadFromJsonAsync<CreatedRes>();
            foreach (var f in newFiles)
                await UploadFile(created!.Id, f);

            Toast.Success($"دستور کار ثبت شد — {created!.Number}");
            showNew = false;
            await LoadAll();
            // پاک‌سازی پارامترهای مبدأ (سورس) بعد از ثبت
            if (!string.IsNullOrWhiteSpace(_sourceModule))
            {
                _sourceModule = null; _sourceId = null; _sourceLabel = "";
                Nav.NavigateTo("/work-orders");
            }
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { busy = false; }
    }

    private async Task UploadFile(int id, Microsoft.AspNetCore.Components.Forms.IBrowserFile f)
    {
        // پیوست از طریق API جامع — /api/attachments/{module}/{refId}
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(f.OpenReadStream(10 * 1024 * 1024));
            sc.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
            content.Add(sc, "file", f.Name);
            await Http.PostAsync($"/api/attachments/WorkOrders/{id}", content);
        }
        catch (Exception ex) { Toast.Error($"بارگذاری {f.Name} ناموفق: {ex.Message}"); }
    }

    // ================== جزئیات ==================
    private async Task OpenDetail(WoItem w)
    {
        detail = w;
        myDone = true; myReply = ""; closeNote = "";
        decideNotes = w.Assignees.ToDictionary(a => a.Id, a => "");
        extDate = w.DueAt.Date; extTime = TimeOnly.FromDateTime(w.DueAt);
        attachments = new(); logs = new();

        // ثبت رویت (بند ۸)
        if (w.Assignees.Any(a => a.UserId == access.UserId && a.SeenAt == null))
        {
            try { await Http.PostAsync($"/api/workorders/{w.Id}/seen", null); } catch { }
            var mine = w.Assignees.First(a => a.UserId == access.UserId);
            mine.SeenAt = DateTime.Now;
        }

        try { logs = await Http.GetFromJsonAsync<List<LogItem>>($"/api/workorders/{w.Id}/logs") ?? new(); } catch { }
    }



    private async Task SubmitReply()
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{detail.Id}/reply", new { done = myDone ?? true, text = myReply });
            if (resp.IsSuccessStatusCode) { Toast.Success("پاسخ شما ثبت شد."); detail = null; await LoadAll(); }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task Decide(int asgId, bool approved)
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{detail.Id}/assignees/{asgId}/decide",
                new { approved, note = decideNotes.GetValueOrDefault(asgId, "") });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success(approved ? "پاسخ تایید شد." : "پاسخ رد شد و به گیرنده برگشت.");
                var id = detail.Id;
                detail = null;
                await LoadAll();
                await OpenById(id);
            }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SubmitExtend()
    {
        if (detail == null || extDate == null) return;
        busy = true;
        try
        {
            var due = extDate.Value.Date.Add(extTime.ToTimeSpan());
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{detail.Id}/extend", new { newDueAt = due, note = "" });
            if (resp.IsSuccessStatusCode) { Toast.Success("مهلت تمدید شد."); var id = detail.Id; detail = null; await LoadAll(); await OpenById(id); }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task SubmitClose()
    {
        if (detail == null) return;
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{detail.Id}/close", new { note = closeNote });
            if (resp.IsSuccessStatusCode) { Toast.Success("دستور کار نهایی و بسته شد. 🔒"); detail = null; await LoadAll(); }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    // ================== تقویم شمسی ==================
    private void RecalcCal()
    {
        calDays = pc.GetDaysInMonth(calYear, calMonth);
        var first = pc.ToDateTime(calYear, calMonth, 1, 0, 0, 0, 0);
        calOffset = ((int)first.DayOfWeek + 1) % 7; // شنبه = ستون اول
    }

    private async Task LoadCal()
    {
        RecalcCal();
        var from = pc.ToDateTime(calYear, calMonth, 1, 0, 0, 0, 0);
        var to = from.AddDays(calDays);
        try
        {
            calItems = await Http.GetFromJsonAsync<List<CalItem>>(
                $"/api/workorders/calendar?from={from:yyyy-MM-ddTHH:mm:ss}&to={to:yyyy-MM-ddTHH:mm:ss}") ?? new();
        }
        catch { calItems = new(); }
        StateHasChanged();
    }

    private async Task MoveMonth(int delta)
    {
        calMonth += delta;
        if (calMonth > 12) { calMonth = 1; calYear++; }
        if (calMonth < 1) { calMonth = 12; calYear--; }
        await LoadCal();
    }

    private async Task GoToday()
    {
        var now = DateTime.Now;
        calYear = pc.GetYear(now); calMonth = pc.GetMonth(now);
        await LoadCal();
    }

