    // ================== تقویم شمسی ==================
    private void RecalcCal()
    {
        calDays = pc.GetDaysInMonth(calYear, calMonth);
        var first = pc.ToDateTime(calYear, calMonth, 1, 0, 0, 0, 0);
        calOffset = ((int)first.DayOfWeek + 1) % 7; // شنبه = ستون اول
    }

    private async Task LoadCal()
    {
        RecalcCal();
        var from = pc.ToDateTime(calYear, calMonth, 1, 0, 0, 0, 0);
        var to = from.AddDays(calDays);
        try
        {
            calItems = await Http.GetFromJsonAsync<List<CalItem>>(
                $"/api/workorders/calendar?from={from:yyyy-MM-ddTHH:mm:ss}&to={to:yyyy-MM-ddTHH:mm:ss}") ?? new();
        }
        catch { calItems = new(); }
        StateHasChanged();
    }

    private async Task MoveMonth(int delta)
    {
        calMonth += delta;
        if (calMonth > 12) { calMonth = 1; calYear++; }
        if (calMonth < 1) { calMonth = 12; calYear--; }
        await LoadCal();
    }

    private async Task GoToday()
    {
        var now = DateTime.Now;
        calYear = pc.GetYear(now); calMonth = pc.GetMonth(now);
        await LoadCal();
    }

