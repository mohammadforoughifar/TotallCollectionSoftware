                                || w.OwnerName.Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            if (fltPriority >= 0) it = it.Where(w => w.Priority == fltPriority);
            if (fltTag != null) it = it.Where(w => w.Tags.Contains(fltTag));
            return it.ToList();
        }
    }
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(FilteredItems.Count / (double)PageSize));
    private IEnumerable<WoItem> PagedItems => FilteredItems.Skip((page - 1) * PageSize).Take(PageSize);

    private void OnSearchInput(ChangeEventArgs e) { fltQ = e.Value?.ToString() ?? ""; page = 1; }
