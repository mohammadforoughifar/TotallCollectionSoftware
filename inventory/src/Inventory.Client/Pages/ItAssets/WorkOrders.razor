    {
        "Created" => "ثبت دستور کار", "Seen" => "رویت", "Reply" => "ثبت پاسخ",
        "Approved" => "تایید پاسخ", "Rejected" => "رد پاسخ",
        "Extended" => "تمدید مهلت", "Closed" => "بستن نهایی", _ => a
    };

