@namespace Inventory.Client.Pages
@page "/system-id"
@page "/system-id/{Id:int}"
@using Microsoft.AspNetCore.SignalR.Client
@inject HttpClient Http
@inject IAuthState Auth
@inject ApiOptions ApiCfg
@implements IDisposable

<PageTitle>شناسنامه سیستم — جزئیات</PageTitle>

<div class="page-head mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h1><i class="bi bi-cpu-fill"></i> شناسنامه سیستم</h1>
        <div class="lead">جزئیات اطلاعات سخت‌افزار — اختصاص کاربر و تأیید</div>
    </div>
    @if (item != null && Id > 0)
    {
        <button class="btn btn-outline-danger rounded-pill px-4 fw-800 pdf-btn" @onclick="DownloadPdf" disabled="@(pdfLoading)">
            @if (pdfLoading)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <text>در حال ساخت…</text>
            }
            else
            {
                <i class="bi bi-file-earmark-pdf-fill me-1"></i>
                <text>PDF شناسنامه</text>
            }
        </button>
    }
</div>

@if (item == null)
{
    <div class="alert alert-info">در حال بارگذاری داده‌ها از ایجنت...</div>
    <a href="/system-info" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> بازگشت به لیست</a>
}
else
{
    @if (item.UserId > 0)
    {
        <div class="alert assigned-alert d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-person-check-fill fs-4"></i>
            <div class="d-flex align-items-center gap-2">
                <b>کاربر اختصاص‌یافته:</b>
                <UserAvatar SystemUserId="item.UserId ?? 0" Size="34" />
                <span>
                @(allUsers.FirstOrDefault(u => u.Id == item.UserId) is { } au ? $" {au.FirstName} {au.LastName} ({au.StaffNumber})" : $" #{item.UserId}")
                @if (companies.FirstOrDefault(c => c.Id == item.CompanyId) is { } ac)
                { <span class="badge bg-white text-dark ms-1">@ac.Name</span> }
                </span>
            </div>
        </div>
    }

    @if (ItemNotFound)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-exclamation-triangle-fill fs-4"></i>
            <div>این شناسه هنوز توسط ایجنت در بانک ثبت نشده است — اطلاعات واقعی سخت‌افزار اینجا نمایش داده نمی‌شود.
            ابتدا <b>Agent.Console</b> را روی سیستم مقصد اجرا کنید (<code>dotnet run --project src/Agent.Console</code>)،
            سپس این صفحه را دوباره باز کنید.</div>
        </div>
    }

    @if (item.IsApproved)
    {
        <div class="alert alert-success d-flex align-items-center gap-2 mb-3">
            <i class="bi bi-check-circle-fill fs-4"></i>
            <div><b>تأیید شده</b> — این سیستم در بانک اطلاعاتی ذخیره شده است.</div>
        </div>
    }


@* ============ امتیاز سلامت سیستم (0-100) ============ *@
<div class="card border-0 shadow-sm mb-4 health-card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <b><i class="bi bi-heart-pulse-fill" style="color:#e0245e;"></i> امتیاز سلامت سیستم</b>
        @if (health != null)
        {
            <span class="badge health-grade" style="background:@health.Color;">@health.GradeFa</span>
        }
        else if (ItemNotFound)
        {
            <span class="badge bg-secondary">در انتظار ایجنت</span>
        }
    </div>
    <div class="card-body">
        @if (health == null)
        {
            <div class="text-muted small py-2">
                <i class="bi bi-hourglass-split"></i> هنوز اطلاعات سخت‌افزاری کافی برای محاسبه‌ی سلامت ثبت نشده — بعد از اجرای ایجنت و ثبت قطعات، امتیاز اینجا نمایش داده می‌شود.
            </div>
        }
        else
        {
            <div class="row align-items-center g-3">
                <div class="col-auto text-center hc-gauge-col">
                    <HealthGauge Score="health.Score" Size="150" ShowLabel="true" Label="@health.GradeFa"
                                 Tooltip="@HealthTip(health.Score, health.GradeFa)" />
                    <div class="hc-out-of">از ۱۰۰</div>
                </div>
                <div class="col">
                    <div class="hc-list">
                        @foreach (var c in health.Categories)
                        {
                            var pct = c.Max > 0 ? (int)(c.Score * 100.0 / c.Max) : 0;
                            <div class="hc-row" title="@($"{c.Fa}: {c.Score} از {c.Max} — {c.Note}")">
                                <span class="hc-icon"><i class="bi @c.Icon"></i></span>
                                <div class="hc-info">
                                    <div class="hc-lbl">
                                        <b>@c.Fa</b>
                                        <span class="hc-note">@c.Note</span>
                                    </div>
                                    <div class="hc-bar">
                                        <div class="hc-fill" style="width:@pct%;background:@HcBarColor(pct);"></div>
                                    </div>
                                </div>
                                <span class="hc-score num">@c.Score<span class="hc-max">/@c.Max</span></span>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>

    @* ============ پایش زنده ============ *@
<div class="card border-0 shadow-sm mb-4 live-card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <b><i class="bi bi-broadcast text-primary"></i> پایش زنده <span class="live-badge @(liveConnected ? "lb-on" : "lb-off")">@(liveConnected ? "🟢 برخط (SignalR)" : "⚪ در حال اتصال…")</span></b>
        <button class="btn btn-sm btn-outline-primary rounded-pill fw-700" @onclick="PingNow" disabled="@(livePingBusy || !liveConnected)">
            @if (livePingBusy)
            {
                <span class="spinner-border spinner-border-sm me-1"></span>
                <text>در حال پینگ…</text>
            }
            else
            {
                <i class="bi bi-broadcast-pin"></i>
                <text>بررسی فوری</text>
            }
        </button>
    </div>
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-auto">
                <span class="live-dot @(liveOnline == true ? "ld-on" : liveOnline == false ? "ld-off" : "ld-na")"></span>
            </div>
            <div class="col-md-3">
                <div class="live-lbl">وضعیت سیستم</div>
                <div class="fw-800 fs-6 @(liveOnline == true ? "text-success" : liveOnline == false ? "text-danger" : "text-secondary")">
                    @(liveOnline == true ? "روشن / آنلاین" : liveOnline == false ? "خاموش / آفلاین" : "بدون IP قابل بررسی")
                </div>
            </div>
            <div class="col-md-3">
                <div class="live-lbl">آدرس IP</div>
                <div class="fw-800 fs-6 num" dir="ltr">@(LiveIp ?? "—")</div>
            </div>
            <div class="col-md-3">
                <div class="live-lbl">آخرین پینگ سرور</div>
                <div class="fw-700 fs-6">@(lastSweep != null && lastSweep.Value.Year > 2000 ? lastSweep.Value.ToString("yyyy/MM/dd HH:mm:ss") : "—")</div>
            </div>
            <div class="col-md-3">
                <div class="live-lbl">آخرین گزارش ایجنت</div>
                <div class="fw-700 fs-6">@(item != null ? item.ReceivedAt.ToFa() : "—")</div>
            </div>
        </div>
    </div>
</div>

@* ============ تغییرات در انتظار تایید (مقایسه دو ستونه) ============ *@
@if (pending != null && pending.HasPending)
{
    <div class="card border-0 shadow-sm mb-3 cmp-card">
        <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2 cmp-head">
            <b><i class="bi bi-arrow-left-right"></i> تغییرات جدید ایجنت — @pending.ChangeCount اختلاف، در انتظار تایید</b>
            <label class="small fw-700"><input type="checkbox" class="form-check-input me-1" @bind="onlyChanged" /> فقط موارد تغییرکرده</label>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-3 cmp-table">
                    <thead>
                        <tr>
                            <th style="width:15%;">قطعه</th>
                            <th style="width:42%;">مقدار فعلی (بانک اطلاعاتی)</th>
                            <th style="width:43%;">مقدار جدید (ایجنت) ⬅</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in pending.Diffs.Where(d => !onlyChanged || d.Changed))
                        {
                            <tr class="@(d.Changed ? "diff-changed" : "diff-same")">
                                <td class="fw-800">@(d.Changed ? "⚠️ " : "")@d.Field</td>
                                <td class="@(d.Changed ? "text-danger" : "text-muted")">@(d.Old ?? "—")</td>
                                <td class="@(d.Changed ? "text-success fw-800" : "text-muted")">@(d.New ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="d-flex gap-2 flex-wrap">
                <button class="btn btn-success rounded-pill px-4 fw-800" @onclick="ApplyChanges">
                    <i class="bi bi-check-circle-fill"></i> تایید — اطلاعات جدید جایگزین شود
                </button>
                <button class="btn btn-outline-secondary rounded-pill px-4 fw-700" @onclick="DiscardChanges">
                    <i class="bi bi-x-circle"></i> رد کردن
                </button>
            </div>
        </div>
    </div>
}

@* ============ تاریخچه تغییرات — تایم‌لاین گرافیکی ============ *@
@if (history.Count > 0)
{
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
            <b><i class="bi bi-clock-history"></i> تایم‌لاین تغییرات سخت‌افزار</b>
            <span class="badge bg-light text-dark border">@history.Count رکورد</span>
        </div>
        <div class="card-body">
            <ChangeTimeline Entries="history.Select(h => new ChangeTimeline.TimelineEntry
            {
                Id = h.Id,
                ChangedAt = h.ChangedAt,
                ChangeCount = h.ChangeCount,
                Diffs = h.Diffs.Select(d => new ChangeTimeline.TimelineDiff { Field = d.Field, Old = d.Old, New = d.New, Changed = d.Changed }).ToList()
            }).ToList()" />
        </div>
    </div>
}

<div class="card shadow-sm mb-4">
        <div class="card-header fw-700 d-flex justify-content-between">
            <span><i class="bi bi-cpu"></i> اطلاعات سیستم #@item.Id</span>
            <span class="badge bg-info">@item.AgentId</span>
        </div>
        <div class="card-body">
            @if (hw != null)
            {
                <div class="row g-3 mb-3">
                    @if (!string.IsNullOrWhiteSpace(hw.ComputerModel) || !string.IsNullOrWhiteSpace(hw.Board))
                    {
                        <div class="col-12">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-pc-display"></i></div>
                                <div class="hw-body">
                                    <div class="hw-title">سیستم / مادربرد</div>
                                    <div class="hw-value">@(hw.ComputerModel ?? "—")</div>
                                    @if (!string.IsNullOrWhiteSpace(hw.Board))
                                    { <div class="hw-sub">مادربرد: @hw.Board @(string.IsNullOrWhiteSpace(hw.BoardSerial) ? "" : " — سریال: " + hw.BoardSerial)</div> }
                                </div>
                            </div>
                        </div>
                    }
                    @foreach (var c in hw.Cpus)
                    {
                        <div class="col-md-8">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-cpu-fill"></i></div>
                                <div class="hw-body">
                                    <div class="hw-title">پردازنده</div>
                                    <div class="hw-value">@c.Name</div>
                                    <div class="hw-sub">
                                        @if (c.Cores > 0)
                                        { <span class="badge bg-info-subtle me-1">@c.Cores هسته / @c.Threads رشته</span> }
                                        @if (c.ClockGhz > 0)
                                        { <span class="badge bg-info-subtle">@c.ClockGhz.ToString("0.00") GHz</span> }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (hw.RamSticks.Count > 0)
                    {
                        var totalRam = hw.RamSticks.Sum(r => r.CapacityGb);
                        <div class="col-md-4">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-memory"></i></div>
                                <div class="hw-body">
                                    <div class="hw-title">حافظه رم</div>
                                    <div class="hw-value">@totalRam GB <span class="badge bg-info">@hw.RamSticks.Count ماژول</span></div>
                                </div>
                            </div>
                        </div>
                        <div class="col-12">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-list-columns-reverse"></i></div>
                                <div class="hw-body w-100">
                                    <div class="hw-title">ماژول‌های رم</div>
                                    <div class="ram-bar">
                                        @for (var i = 0; i < hw.RamSticks.Count; i++)
                                        {
                                            var r = hw.RamSticks[i];
                                            var pct = totalRam > 0 ? (int)Math.Round(r.CapacityGb * 100.0 / totalRam) : 0;
                                            <div class="ram-seg" style="width:@pct%;background:@SegColor(i);">@r.CapacityGb GB</div>
                                        }
                                    </div>
                                    <div class="row g-2 mt-2">
                                        @for (var i = 0; i < hw.RamSticks.Count; i++)
                                        {
                                            var r = hw.RamSticks[i];
                                            <div class="col-md-6 col-lg-4">
                                                <div class="stick-chip">
                                                    <span class="dot" style="background:@SegColor(i);"></span>
                                                    <div>
                                                        <b>@r.CapacityGb GB @(r.Type)</b>
                                                        @if (r.SpeedMhz > 0)
                                                        { <span class="text-muted small">@r.SpeedMhz MHz</span> }
                                                        <div class="small text-muted">@r.Slot — @(string.IsNullOrWhiteSpace(r.Manufacturer) ? "" : r.Manufacturer) @(r.PartNumber)</div>
                                                        @if (!string.IsNullOrWhiteSpace(r.SerialNumber) && r.SerialNumber != "None")
                                                        { <div class="tiny">سریال: @r.SerialNumber</div> }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                    @if (hw.Disks.Count > 0)
                    {
                        var maxGb = Math.Max(1, hw.Disks.Max(d => d.SizeGb));
                        <div class="col-12">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-device-hdd-fill"></i></div>
                                <div class="hw-body w-100">
                                    <div class="hw-title">هارد دیسک‌ها <span class="badge bg-info ms-1">@hw.Disks.Count</span></div>
                                    @for (var i = 0; i < hw.Disks.Count; i++)
                                    {
                                        var d = hw.Disks[i];
                                        var pct = (int)Math.Round(d.SizeGb * 100.0 / maxGb);
                                        <div class="disk-row @(d.SmartStatus == "PredFail" || d.SmartStatus == "Failed" ? "smart-bad" : "")">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                                <b><i class="bi bi-hdd"></i> @(i + 1). @d.Model</b>
                                                <span class="d-flex gap-1 flex-wrap">
                                                    @if (!string.IsNullOrWhiteSpace(d.Interface))
                                                    { <span class="badge bg-secondary">@d.Interface</span> }
                                                    <span class="badge bg-primary">@d.SizeGb GB</span>
                                                    @SmartBadge(d.SmartStatus)
                                                </span>
                                            </div>
                                            <div class="disk-bar"><div class="disk-fill" style="width:@pct%;"></div></div>
                                            @if (!string.IsNullOrWhiteSpace(d.SerialNumber) && d.SerialNumber != "None")
                                            { <div class="tiny mt-1">سریال: @d.SerialNumber</div> }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @if (hw.NetAdapters.Count > 0)
                    {
                        <div class="col-12">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-ethernet"></i></div>
                                <div class="hw-body w-100">
                                    <div class="hw-title">شبکه و آی‌پی <span class="badge bg-info ms-1">@hw.NetAdapters.Count کارت</span></div>
                                    @foreach (var n in hw.NetAdapters)
                                    {
                                        <div class="disk-row">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                                <b><i class="bi bi-hdd-network"></i> @n.Name</b>
                                                <span>
                                                    <span class="badge bg-info-subtle">@NetTypeName(n.Type)</span>
                                                    @if (!string.IsNullOrWhiteSpace(n.Ipv4))
                                                    { <span class="badge bg-success">@n.Ipv4</span> }
                                                </span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(n.Gateway))
                                            { <div class="tiny mt-1">گیت‌وی: @n.Gateway</div> }
                                            @if (!string.IsNullOrWhiteSpace(n.MacAddress))
                                            { <div class="tiny">MAC: @n.MacAddress</div> }
                                            @if (!string.IsNullOrWhiteSpace(n.Description) && n.Description != n.Name)
                                            { <div class="hw-sub small">@n.Description</div> }
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @if (hw.Volumes.Count > 0)
                    {
                        <div class="col-12">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-pie-chart-fill"></i></div>
                                <div class="hw-body w-100">
                                    <div class="hw-title">درایوها — حجم استفاده‌شده</div>
                                    @for (var i = 0; i < hw.Volumes.Count; i++)
                                    {
                                        var v = hw.Volumes[i];
                                        var usedPct = v.TotalGb > 0 ? (int)Math.Round(v.UsedGb * 100.0 / v.TotalGb) : 0;
                                        <div class="disk-row">
                                            <div class="d-flex justify-content-between align-items-center flex-wrap gap-1">
                                                <b><i class="bi bi-hard-drive"></i> @v.Letter @(string.IsNullOrWhiteSpace(v.Label) ? "" : "— " + v.Label)</b>
                                                <span class="badge bg-primary">@v.UsedGb GB از @v.TotalGb GB</span>
                                            </div>
                                            <div class="vol-bar">
                                                <div class="vol-fill" style="width:@(usedPct > 100 ? 100 : usedPct)%;"></div>
                                                <span class="vol-text">@usedPct٪ استفاده‌شده — @(v.TotalGb - v.UsedGb) GB آزاد</span>
                                            </div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                    @foreach (var g in hw.Gpus)
                    {
                        <div class="col-md-6">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-gpu-card"></i></div>
                                <div class="hw-body">
                                    <div class="hw-title">کارت گرافیک</div>
                                    <div class="hw-value">@g.Name</div>
                                    @if (!string.IsNullOrEmpty(g.Resolution))
                                    { <div class="hw-sub">رزولوشن: @g.Resolution</div> }
                                </div>
                            </div>
                        </div>
                    }
                    @foreach (var m in hw.Monitors)
                    {
                        <div class="col-md-6">
                            <div class="hw-card">
                                <div class="hw-icon"><i class="bi bi-display-fill"></i></div>
                                <div class="hw-body">
                                    <div class="hw-title">مانیتور @(m.IsPrimary ? "★ اصلی" : "")</div>
                                    <div class="hw-value">@m.Name</div>
                                    @if (!string.IsNullOrEmpty(m.Resolution))
                                    { <div class="hw-sub">رزولوشن: @m.Resolution</div> }
                                    @if (!string.IsNullOrWhiteSpace(m.SerialNumber) && m.SerialNumber != "None" && m.SerialNumber != "0")
                                    { <div class="tiny">سریال: @m.SerialNumber</div> }
                                </div>
                            </div>
                        </div>
                    }
                    <div class="col-md-6">
                        <div class="hw-card">
                            <div class="hw-icon"><i class="bi bi-windows"></i></div>
                            <div class="hw-body">
                                <div class="hw-title">سیستم‌عامل</div>
                                <div class="hw-value">@(string.IsNullOrEmpty(item.OsName) ? "—" : item.OsName)</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="alert alert-info py-2">
                    این رکورد با نسخه‌ی قدیمی ایجنت ثبت شده و جزئیات ساختاریافته ندارد.
                    ایجنت جدید را اجرا کنید تا جزئیات کامل (همه هاردها و همه ماژول‌های رم) ارسال شود.
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-8"><div class="hw-card"><div class="hw-icon"><i class="bi bi-cpu-fill"></i></div><div class="hw-body"><div class="hw-title">پردازنده</div><div class="hw-value">@(string.IsNullOrEmpty(SplitPart(item.Cpu, 0)) ? "—" : SplitPart(item.Cpu, 0))</div>@if (!string.IsNullOrEmpty(SplitPart(item.Cpu, 1))){<div class="hw-sub">@SplitPart(item.Cpu, 1)</div>}</div></div></div>
                    <div class="col-md-4"><div class="hw-card"><div class="hw-icon"><i class="bi bi-memory"></i></div><div class="hw-body"><div class="hw-title">رم</div><div class="hw-value">@(item.TotalRamGb > 0 ? item.TotalRamGb + " GB" : "—")</div>@if (!string.IsNullOrEmpty(SplitPart(item.Ram, 1))){<div class="hw-sub">@SplitPart(item.Ram, 1)</div>}</div></div></div>
                    <div class="col-12"><div class="hw-card"><div class="hw-icon"><i class="bi bi-device-hdd-fill"></i></div><div class="hw-body w-100"><div class="hw-title">هارد دیسک‌ها</div>@foreach (var d in DiskList){<div class="hw-disk"><i class="bi bi-hdd"></i><span>@d</span></div>}</div></div></div>
                    <div class="col-md-6"><div class="hw-card"><div class="hw-icon"><i class="bi bi-gpu-card"></i></div><div class="hw-body"><div class="hw-title">گرافیک</div><div class="hw-value">@(string.IsNullOrEmpty(item.Graphics) ? "—" : item.Graphics)</div></div></div></div>
                    <div class="col-md-6"><div class="hw-card"><div class="hw-icon"><i class="bi bi-display-fill"></i></div><div class="hw-body"><div class="hw-title">مانیتور</div><div class="hw-value">@(string.IsNullOrEmpty(item.Monitor) || item.Monitor == "نامشخص" ? "—" : item.Monitor)</div></div></div></div>
                    <div class="col-md-6"><div class="hw-card"><div class="hw-icon"><i class="bi bi-windows"></i></div><div class="hw-body"><div class="hw-title">سیستم‌عامل</div><div class="hw-value">@(string.IsNullOrEmpty(item.OsName) ? "—" : item.OsName)</div></div></div></div>
                    <div class="col-md-6"><div class="hw-card"><div class="hw-icon"><i class="bi bi-motherboard-fill"></i></div><div class="hw-body"><div class="hw-title">مادربرد</div><div class="hw-value">@(string.IsNullOrEmpty(item.Motherboard) ? "—" : item.Motherboard)</div></div></div></div>
                </div>
            }

            @* ================== سوابق درخواست‌های IT این سیستم ================== *@
            @if (itHistory.Count > 0)
            {
                <hr />
                <div class="card mb-3">
                    <div class="card-header">
                        <i class="bi bi-headset text-primary"></i>
                        <span class="card-title">سوابق درخواست‌های IT این سیستم (@itHistory.Count)</span>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th>شماره</th><th>موضوع</th><th>نوع</th><th>درخواست‌کننده</th>
                                        <th>کارشناس(ها)</th><th>وضعیت</th><th>تاریخ</th><th>اقدام انجام‌شده</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var h in itHistory)
                                    {
                                        <tr>
                                            <td class="num fw-700 text-primary">@h.Number</td>
                                            <td>@h.Title</td>
                                            <td><span class="badge bg-light text-dark border">@ItTypeFa(h.RequestType)</span></td>
                                            <td>@h.RequesterName</td>
                                            <td>@(h.Experts.Count == 0 ? "—" : string.Join("، ", h.Experts))</td>
                                            <td>
                                                @if (h.Status == "Completed")
                                                {
                                                    <span class="badge bg-success-subtle text-success border">تکمیل شده</span>
                                                }
                                                else if (h.Status == "Rejected")
                                                {
                                                    <span class="badge bg-danger-subtle text-danger border">رد شده</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning-subtle text-warning border">در جریان</span>
                                                }
                                            </td>
                                            <td class="num">@h.CreatedAt.ToFa()</td>
                                            <td class="fs-8 text-muted">@(string.IsNullOrWhiteSpace(h.FinalResponse) ? "—" : h.FinalResponse)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            }

            <!-- === بخش اختصاص کاربر — بازطراحی‌شده === -->
            <hr />
            <div class="assign-card p-3 mb-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
                    <h6 class="fw-800 mb-0"><i class="bi bi-person-badge-fill"></i> اختصاص کاربر به این سیستم</h6>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-primary rounded-pill fw-700" @onclick="QuickAddUser" title="تعریف سریع کاربر جدید">
                            <i class="bi bi-person-plus-fill"></i> تعریف سریع
                        </button>

                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label small fw-800 mb-1"><i class="bi bi-building"></i> شرکت</label>
                        <SearchSelect Items="CompanyLookups"
                                      Value="selectedCompanyId"
                                      ValueChanged="OnCompanySelected"
                                      Placeholder="جستجو و انتخاب شرکت…"
                                      CssClass="form-select-sm" />
                        @if (CompanyLookups.Count == 0)
                        {
                            <div class="picker-hint">هنوز شرکتی ثبت نشده — از بخش شرکت‌ها بسازید</div>
                        }
                    </div>

                    <div class="col-md-6">
                        <label class="form-label small fw-800 mb-1"><i class="bi bi-person"></i> کاربر</label>
                        @if (selectedCompanyId == 0)
                        {
                            <input type="text" class="form-control form-control-sm" placeholder="اول شرکت را انتخاب کنید…" disabled />
                        }
                        else
                        {
                            <SearchSelect Items="UserLookups"
                                          Value="SelectedUserIdInt"
                                          ValueChanged="OnUserSelected"
                                          Placeholder="جستجوی نام / شماره پرسنلی…"
                                          CssClass="form-select-sm" />
                            @if (UserLookups.Count == 0)
                            {
                                <div class="picker-hint">کاربری برای این شرکت نیست — «تعریف سریع» را بزنید</div>
                            }
                        }
                    </div>
                </div>

                <div class="d-flex justify-content-end mt-3">
                    <button class="btn btn-sm rounded-pill px-4 fw-800 shadow-sm assign-btn"
                            @onclick="AssignUser"
                            disabled="@(selectedCompanyId == 0 || !int.TryParse(selectedUserId, out var _uid) || _uid <= 0)">
                        <i class="bi bi-link-45deg"></i> اختصاص کاربر
                    </button>
                </div>
            </div>

@if (ShowQuickUserForm)
{
    <Modal Visible="ShowQuickUserForm" Title="تعریف سریع کاربر جدید" OnClose="() => ShowQuickUserForm = false">
        <ChildContent>
            <div class="photo-pick mb-3">
                <label class="form-label small fw-800 mb-1"><i class="bi bi-camera"></i> عکس کاربر (اختیاری)</label>
                <div class="d-flex align-items-center gap-3">
                    <div class="pp-preview">
                        @if (quickUserPhotoPreview != null) { <img src="@quickUserPhotoPreview" alt="پیش‌نمایش" /> }
                        else { <i class="bi bi-person-circle"></i> }
                    </div>
                    <div class="d-flex flex-column gap-1">
                        <InputFile OnChange="OnQuickUserPhotoPicked" Accept="image/*" class="btn btn-sm btn-outline-primary" style="max-width:220px">
                            <i class="bi bi-cloud-arrow-up-fill"></i> انتخاب عکس
                        </InputFile>
                        @if (quickUserPhotoPreview != null)
                        { <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="ClearQuickUserPhoto"><i class="bi bi-x-circle"></i> حذف عکس</button> }
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">نام <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="quickUser.FirstName" placeholder="نام" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">نام خانوادگی</label>
                    <input class="form-control" @bind="quickUser.LastName" placeholder="نام خانوادگی" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">شماره پرسنلی <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="quickUser.StaffNumber" placeholder="شماره پرسنلی" />
                </div>
            </div>
            <div class="row g-3 mt-1">
                <div class="col-md-6">
                    <label class="form-label">کمپانی</label>
                    <select class="form-select" @bind="selectedCompanyId" @bind:event="onchange">
                        <option value="0">-- کمپانی --</option>
                        @foreach(var c in companies.Where(x => x.IsActive)){<option value="@c.Id">@c.Name</option>}
                    </select>
                </div>
            </div>
            <div class="col-12 mt-3">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="quickUserActive" @bind="quickUser.IsActive" />
                    <label class="form-check-label" for="quickUserActive">فعال باشد</label>
                </div>
            </div>
        </ChildContent>
        <Footer>
            <button class="btn btn-light" @onclick="() => ShowQuickUserForm = false">انصراف (Esc)</button>
            <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="SaveQuickUser" disabled="@(string.IsNullOrWhiteSpace(quickUser.FirstName) || string.IsNullOrWhiteSpace(quickUser.StaffNumber) || selectedCompanyId == 0)">ذخیره سریع</button>
        </Footer>
    </Modal>
}
            </div>

@* ================== تاریخچه کاربران ================== *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-800"><i class="bi bi-people-fill text-primary"></i> تاریخچه کاربران — چه کسی قبلاً از این سیستم استفاده می‌کرده؟</div>
    <div class="card-body">
        @if (userHistory.Count == 0)
        {
            <div class="text-muted small">هنوز سابقه‌ی کاربری برای این سیستم ثبت نشده است. با هر «اختصاص کاربر» یک رکورد جدید ثبت می‌شود.</div>
        }
        else
        {
            <div class="uh-list">
                @foreach (var u in userHistory)
                {
                    <div class="uh-item @(u.ToAt == null ? "uh-current" : "")">
                        @if (u.UserId is > 0)
                        {
                            <UserAvatar SystemUserId="u.UserId.Value" Size="42" />
                        }
                        else
                        {
                            <span class="uh-avatar"><i class="bi bi-person-fill"></i></span>
                        }
                        <div class="uh-info">
                            <b>@u.UserName</b>
                            @if (!string.IsNullOrWhiteSpace(u.StaffNumber))
                            { <span class="uh-staff" dir="ltr">@u.StaffNumber</span> }
                            @if (!string.IsNullOrWhiteSpace(u.CompanyName))
                            { <span class="badge bg-light text-dark border ms-1">@u.CompanyName</span> }
                        </div>
                        <div class="uh-dates">@u.FromAt.ToFa() تا @(u.ToAt != null ? u.ToAt.Value.ToFa() : "هم‌اکنون")</div>
                        @if (u.ToAt == null)
                        {
                            <span class="badge bg-success-subtle text-success border fw-800"><i class="bi bi-check-circle"></i> در حال استفاده</span>
                        }
                        else
                        {
                            <span class="badge bg-light text-dark border">سابقه</span>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ================== چک‌لیست تحویل دیجیتال با امضا ================== *@
<div class="card border-0 shadow-sm mb-4 handover-card">
    <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
        <b><i class="bi bi-box-seam-fill text-success"></i> چک‌لیست تحویل دیجیتال با امضا</b>
        <button class="btn btn-sm btn-primary rounded-pill fw-800" @onclick="OpenHandover" disabled="@(handoverBusy)">
            <i class="bi bi-plus-lg"></i> ثبت تحویل جدید
        </button>
    </div>
    <div class="card-body">
        @if (handoverBusy)
        {
            <div class="text-center py-3"><span class="spinner-border spinner-border-sm text-primary me-1"></span> در حال ثبت…</div>
        }
        else if (handovers.Count == 0)
        {
            <div class="text-muted small">هنوز تحویلی ثبت نشده است. با «ثبت تحویل جدید»، چک‌لیست را تکمیل و با امضای دیجیتال تحویل را ثبت کنید.</div>
        }
        else
        {
            @foreach (var h in handovers)
            {
                <div class="hv-item">
                    <div class="hv-main">
                        <div class="hv-title"><i class="bi bi-box-arrow-in-left"></i> تحویل #@h.Id</div>
                        <div class="hv-parties d-flex align-items-center gap-2 flex-wrap">
                            <span class="text-muted small">@h.FromUserName</span>
                            <i class="bi bi-arrow-left"></i>
                            <UserAvatar SystemUserId="h.ToUserId ?? 0" Size="30" />
                            <b class="text-success">@h.ToUserName</b>
                        </div>
                        <div class="small text-muted mt-1">
                            <i class="bi bi-calendar3"></i> @(h.CompletedAt != null ? h.CompletedAt.Value.ToFa() : h.CreatedAt.ToFa())
                            <span class="ms-2">— @(h.Checklist.Count(c => c.Checked)) از @h.Checklist.Count آیتم چک‌شده</span>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(h.Note))
                        { <div class="small text-muted">یادداشت: @h.Note</div> }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(h.SignatureDataUrl))
                    {
                        <img src="@h.SignatureDataUrl" alt="امضا" class="hv-sig" />
                        <div class="tiny text-center text-muted" style="max-width:170px;">امضای دیجیتال</div>
                    }
                    <span class="badge hv-signed"><i class="bi bi-pen-fill"></i> امضا شده</span>
                </div>
            }
        }
    </div>
</div>

@* ================== دستور از راه دور ================== *@
<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-800"><i class="bi bi-rocket-takeoff-fill text-danger"></i> دستور از راه دور <span class="small text-muted fw-600">(اجرا توسط ایجنت سیستم)</span></div>
    <div class="card-body">
        <div class="d-flex flex-wrap gap-2 mb-3">
            <button class="btn btn-outline-warning rounded-pill fw-800 rc-btn" @onclick='() => SendCommand("Reboot")' disabled="@(cmdBusy)">
                <i class="bi bi-arrow-repeat"></i> ری‌استارت سیستم
            </button>
            <button class="btn btn-outline-danger rounded-pill fw-800 rc-btn" @onclick='() => SendCommand("Shutdown")' disabled="@(cmdBusy)">
                <i class="bi bi-power"></i> خاموش کردن
            </button>
            <button class="btn btn-outline-secondary rounded-pill fw-800 rc-btn" @onclick='() => SendCommand("Lock")' disabled="@(cmdBusy)">
                <i class="bi bi-lock-fill"></i> قفل صفحه
            </button>
        </div>
        @if (commands.Count == 0)
        {
            <div class="text-muted small">هنوز دستوری ارسال نشده است. دستورهای ارسال‌شده توسط ایجنت سیستم اجرا و نتیجه‌شان اینجا ثبت می‌شود.</div>
        }
        else
        {
            <div class="rc-list">
                @foreach (var c in commands)
                {
                    <div class="rc-item rc-@c.Status.ToLowerInvariant()">
                        <span class="rc-icon"><i class="bi @CmdIcon(c.Action)"></i></span>
                        <div class="rc-info">
                            <b>@CmdFa(c.Action)</b>
                            <div class="small text-muted">@(c.CreatedAt.ToFa()) — توسط @(string.IsNullOrWhiteSpace(c.ByUserName) ? "—" : c.ByUserName)</div>
                            @if (!string.IsNullOrWhiteSpace(c.Result))
                            { <div class="small text-muted">@(c.Result)</div> }
                        </div>
                        <span class="badge @CmdBadgeClass(c.Status)">@CmdStatusFa(c.Status)</span>
                    </div>
                }
            </div>
        }
    </div>
</div>

@* ================== مودال تحویل دیجیتال ================== *@
@if (ShowHandoverModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(0,0,0,.55)" @onclick="CloseHandover">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable" @onclick="() => { }" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-box-seam-fill text-success"></i> چک‌لیست تحویل دیجیتال — سیستم #@Id</h5>
                    <button type="button" class="btn-close" @onclick="CloseHandover"></button>
                </div>
                <div class="modal-body">
                    @if (handoverError.Length > 0)
                    {
                        <div class="alert alert-danger py-2"><i class="bi bi-exclamation-triangle-fill"></i> @handoverError</div>
                    }
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label small fw-800 mb-1">گیرنده‌ی سیستم <span class="text-danger">*</span></label>
                            <SearchSelect Items="HandoverUserLookups"
                                          Value="handoverToUserId"
                                          ValueChanged="OnHandoverUserSelected"
                                          Placeholder="جستجوی کاربر گیرنده…"
                                          CssClass="form-select-sm" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-800 mb-1">تحویل‌دهنده</label>
                            <input type="text" class="form-control form-control-sm" @bind="handoverFromName" />
                        </div>
                    </div>

                    <div class="hv-checklist">
                        <div class="fw-800 small mb-2"><i class="bi bi-list-check"></i> چک‌لیست تحویل <span class="text-danger">*</span> — همه‌ی موارد الزامی است</div>
                        @foreach (var it in handoverItems)
                        {
                            <div class="form-check hv-chk">
                                <input class="form-check-input" type="checkbox" id="hchk_@it.Key"
                                       checked="@it.Checked"
                                       @onchange="e => ToggleCheck(it.Key, e)" />
                                <label class="form-check-label" for="hchk_@it.Key">@it.Fa</label>
                            </div>
                        }
                    </div>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label small fw-800 mb-0">امضای دیجیتال <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearSignature"><i class="bi bi-eraser"></i> پاک کردن</button>
                        </div>
                        <div class="sig-wrap">
                            <canvas id="sigCanvas" width="640" height="200"></canvas>
                            @if (string.IsNullOrWhiteSpace(signatureDataUrl))
                            { <div class="sig-hint">با موس یا لمس، امضا را اینجا بنویسید</div> }
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="form-label small fw-800 mb-1">یادداشت (اختیاری)</label>
                        <input type="text" class="form-control form-control-sm" @bind="handoverNote" placeholder="مثلاً: همراه سیستم یک مانیتور اضافی" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light" @onclick="CloseHandover">انصراف</button>
                    <button class="btn btn-success rounded-pill px-4 fw-800" @onclick="SubmitHandover" disabled="@(handoverToUserId <= 0 || string.IsNullOrWhiteSpace(signatureDataUrl))">
                        <i class="bi bi-pen-fill"></i> ثبت و امضای تحویل
                    </button>
                </div>
            </div>
        </div>
    </div>
}

            <!-- === تأیید و ذخیره در بانک — آخر === -->
            @if (!item.IsApproved)
            {
                <hr />
                <div class="p-3" style="background:rgba(255,255,255,.05);border-radius:16px;border:1px solid rgba(255,255,255,.12);box-shadow:0 2px 8px rgba(0,0,0,.06);">
                    <h5><i class="bi bi-shield-check"></i> تأیید و ذخیره در بانک</h5>

                    <button class="btn btn-success rounded-pill px-4 fw-700 shadow-sm" @onclick="ApproveItem" disabled="@(string.IsNullOrEmpty(selectedUserId) || selectedCompanyId == 0 || !int.TryParse(selectedUserId, out int uid2) || uid2 <= 0)">
                        <i class="bi bi-check-circle-fill"></i> تأیید و ذخیره در بانک
                    </button>
                    <span class="ms-2 text-muted small">ذخیره غیرفعال تا انتخاب کاربر و کمپانی</span>
                </div>
            }

            <div class="mt-3 d-flex justify-content-between align-items-center">
                <span><b>زمان دریافت:</b> @item.ReceivedAt.ToString("yyyy/MM/dd HH:mm")</span>
                <a href="/system-info" class="btn back-btn rounded-pill px-4 fw-700 shadow-sm"><i class="bi bi-arrow-right"></i> بازگشت به لیست سیستم‌ها</a>
            </div>
        </div>
    
}

<style>
.detail-box{padding:1rem;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.08);border-radius:14px;}
.detail-box h5{font-weight:700;font-size:1rem;margin-bottom:.5rem;color:#e8e8f0;}
.detail-box p{margin:0;color:#c8c9d8;font-size:.95rem;}
.hw-card{display:flex;gap:.9rem;align-items:flex-start;background:#ffffff;border:1px solid #e2e6f1;border-left:4px solid #8e5cff;border-radius:14px;padding:1rem 1.1rem;height:100%;transition:all .18s ease;box-shadow:0 4px 16px rgba(45,55,110,.12);font-family:'Vazirmatn','Vazir',Tahoma,'Segoe UI',sans-serif;margin-bottom:.65rem;}
.hw-card:hover{border-color:#8e5cff;box-shadow:0 8px 22px rgba(120,90,255,.16);transform:translateY(-2px);}
.hw-icon{font-size:1.4rem;color:#6d4dff;background:#efeaff;border:1px solid #ded2ff;border-radius:12px;width:52px;height:52px;display:flex;align-items:center;justify-content:center;flex-shrink:0;}
.hw-title{font-size:.78rem;color:#5f688a;margin-bottom:.3rem;font-weight:800;letter-spacing:.2px;}
