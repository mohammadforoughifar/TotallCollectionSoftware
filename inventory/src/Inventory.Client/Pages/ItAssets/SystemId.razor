    // کاربران با پیش‌فرض رزرو و سرور
    private List<SystemUserItem> FilteredUsersWithDefaults
    {
        get
        {
            var list = new List<SystemUserItem>();
            // همیشه رزرو و سرور برای هر کمپانی
            var reserve = new SystemUserItem { Id = -1, FirstName = "رزرو", LastName = "", StaffNumber = "RESERVE", Role = "User", IsActive = true, CompanyId = selectedCompanyId, DepartmentId = null };
            var server = new SystemUserItem { Id = -2, FirstName = "سرور", LastName = "", StaffNumber = "SERVER", Role = "User", IsActive = true, CompanyId = selectedCompanyId, DepartmentId = null };
            list.Add(reserve);
            list.Add(server);

            if (selectedCompanyId > 0)
            {
                var companyUsers = allUsers.Where(u => u.CompanyId == selectedCompanyId).ToList();
                if (!string.IsNullOrWhiteSpace(userSearchText))
                {
                    companyUsers = companyUsers.Where(u =>
                        (u.FirstName != null && u.FirstName.Contains(userSearchText, StringComparison.OrdinalIgnoreCase)) ||
                        (u.LastName != null && u.LastName.Contains(userSearchText, StringComparison.OrdinalIgnoreCase)) ||
                        (u.StaffNumber != null && u.StaffNumber.Contains(userSearchText, StringComparison.OrdinalIgnoreCase))
                    ).ToList();
                }
                list.AddRange(companyUsers);
            }
            return list;
        }
    }

