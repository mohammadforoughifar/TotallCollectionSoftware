    private async Task DownloadPdf()
    {
        pdfLoading = true;
        StateHasChanged();
        try
        {
            var bytes = await Http.GetByteArrayAsync($"/api/SystemInfo/{Id}/pdf");
            var base64 = Convert.ToBase64String(bytes);
            await JsR.InvokeVoidAsync("eval", $"var a=document.createElement('a');a.href='data:application/pdf;base64,{base64}';a.download='System-Identity-{Id}.pdf';document.body.appendChild(a);a.click();a.remove();");
        }
        catch (Exception ex)
        {
            Console.WriteLine("PDF error: " + ex.Message);
        }
        pdfLoading = false;
        StateHasChanged();
    }

