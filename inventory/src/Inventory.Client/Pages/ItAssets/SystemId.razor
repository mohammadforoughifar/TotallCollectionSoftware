    private async Task OnQuickUserPhotoPicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size == 0) return;
        if (file.Size > 5 * 1024 * 1024) return;
        var buf = new byte[file.Size];
        await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).ReadAsync(buf);
        quickUserPhoto = buf;
        quickUserPhotoName = file.Name;
        quickUserPhotoPreview = "data:" + (file.ContentType ?? "image/jpeg") + ";base64," + Convert.ToBase64String(buf);
        StateHasChanged();
    }

    private async Task SaveQuickUser()
    {
        try
        {
            quickUser.CompanyId = selectedCompanyId > 0 ? selectedCompanyId : quickUser.CompanyId;
            var resp = await Http.PostAsJsonAsync("/api/SystemUsers", quickUser);
            if (resp.IsSuccessStatusCode)
            {
                if (quickUserPhoto != null)
                {
                    try
                    {
                        int newId = 0;
                        using var doc = System.Text.Json.JsonDocument.Parse(await resp.Content.ReadAsStringAsync());
                        if (doc.RootElement.TryGetProperty("id", out var idEl)) newId = idEl.GetInt32();
                        if (newId > 0)
                        {
                            using var form = new MultipartFormDataContent();
                            var content = new ByteArrayContent(quickUserPhoto);
                            content.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
                            form.Add(content, "file", quickUserPhotoName ?? "photo.jpg");
                            await Http.PostAsync($"/api/SystemUsers/photo/{newId}", form);
                        }
                    }
                    catch { }
                }
                ShowQuickUserForm = false;
                quickUser = new() { Role = "User", IsActive = true, CreatedAt = DateTime.Now };
                quickUserPhoto = null; quickUserPhotoName = null; quickUserPhotoPreview = null;
                await LoadUsers();
                await LoadItem();
                await LoadData();
            }
        }
        catch { }
    }

