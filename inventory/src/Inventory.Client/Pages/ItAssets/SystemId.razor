    private List<SystemCompanyItem> PickerCompanies
    {
        get
        {
            var q = (companySearchText ?? "").Trim();
            var list = companies.Where(x => x.IsActive);
            if (!string.IsNullOrWhiteSpace(q))
                list = list.Where(x => x.Name.Contains(q, StringComparison.OrdinalIgnoreCase));
            return list.OrderBy(x => x.Name).ToList();
        }
    }

    private List<SystemUserItem> PickerUsers
    {
        get
        {
            if (selectedCompanyId <= 0) return new();
            var q = (userSearchText ?? "").Trim();
            var list = allUsers.Where(u => u.CompanyId == selectedCompanyId && u.Id > 0);
            if (!string.IsNullOrWhiteSpace(q))
                list = list.Where(u =>
                    (u.FirstName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (u.LastName ?? "").Contains(q, StringComparison.OrdinalIgnoreCase) ||
                    (u.StaffNumber ?? "").Contains(q, StringComparison.OrdinalIgnoreCase));
            return list.OrderBy(u => u.FirstName).ThenBy(u => u.LastName).ToList();
        }
    }

