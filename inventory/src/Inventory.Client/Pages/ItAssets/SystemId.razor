    [Inject] private IJSRuntime JsR { get; set; } = null!;

    private HubConnection? liveHub;
    private bool? liveOnline;
    private DateTime? lastSweep;
    private bool liveConnected;
    private bool livePingBusy;

    private string? LiveIp
    {
        get
        {
            if (hw != null && hw.NetAdapters.Count > 0)
                return hw.NetAdapters.FirstOrDefault(n => !string.IsNullOrEmpty(n.Ipv4))?.Ipv4;
            return null;
        }
    }

    private async Task StartLive()
    {
        if (Id <= 0) return;
        try
        {
            liveHub = new HubConnectionBuilder()
                .WithUrl($"{ApiCfg.BaseUrl}/hubs/dashboard")
                .WithAutomaticReconnect()
                .Build();
            liveHub.On<System.Text.Json.JsonElement>("ReceiveHardwareStats", el =>
            {
                try
                {
                    var stats = System.Text.Json.JsonSerializer.Deserialize<LiveStats>(el.GetRawText(),
                        new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    if (stats != null)
                    {
                        var dev = stats.Devices.FirstOrDefault(d => d.Kind == "system" && d.Id == Id);
                        liveOnline = dev?.Online;
                        lastSweep = stats.LastSweepAt;
                    }
                }
                catch { }
                _ = InvokeAsync(StateHasChanged);
            });
            await liveHub.StartAsync();
            liveConnected = true;
            await InvokeAsync(StateHasChanged);
        }
        catch { liveConnected = false; }
    }

    private async Task PingNow()
    {
        if (liveHub is not { State: HubConnectionState.Connected }) return;
        livePingBusy = true;
        try { await liveHub.InvokeAsync("RequestHardwareCheck"); }
        catch { }
        await Task.Delay(3500);
        livePingBusy = false;
        StateHasChanged();
    }

    public void Dispose()
    {
        try { _sigRef?.Dispose(); } catch { }
        try { _ = liveHub?.DisposeAsync(); } catch { }
    }

