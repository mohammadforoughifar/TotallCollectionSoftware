    private async Task SubmitHandover()
    {
        handoverError = "";
        if (handoverToUserId <= 0) { handoverError = "گیرنده را انتخاب کنید."; StateHasChanged(); return; }
        if (string.IsNullOrWhiteSpace(signatureDataUrl)) { handoverError = "امضا الزامی است."; StateHasChanged(); return; }
        if (handoverItems.Any(x => !x.Checked)) { handoverError = "همه‌ی آیتم‌های چک‌لیست را تیک بزنید."; StateHasChanged(); return; }

        handoverBusy = true;
        StateHasChanged();
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/SystemInfo/handover/{Id}", new
            {
                FromUserName = handoverFromName,
                ToUserId = handoverToUserId,
                ToUserName = "",
                Checklist = handoverItems,
                SignatureDataUrl = signatureDataUrl,
                Note = handoverNote
            });
            if (resp.IsSuccessStatusCode)
            {
                ShowHandoverModal = false;
                await LoadHandovers();
                await LoadItem();
                await LoadUserHistory();
            }
            else
            {
                var body = await resp.Content.ReadAsStringAsync();
                handoverError = "ثبت تحویل ناموفق بود.";
                try
                {
                    using var doc = System.Text.Json.JsonDocument.Parse(body);
                    if (doc.RootElement.TryGetProperty("message", out var m)) handoverError = m.GetString() ?? handoverError;
                }
                catch { }
            }
        }
        catch (Exception ex)
        {
            handoverError = ex.Message;
        }
        handoverBusy = false;
        StateHasChanged();
    }

