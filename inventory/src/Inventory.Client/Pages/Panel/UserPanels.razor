@page "/panels"
@using Inventory.Client.Services
@inject IAuthState Auth
@inject NavigationManager Nav

<PageTitle>پنل‌های کاربری — نرم افزار یکپارچه فروغ آریا</PageTitle>

<div class="container-fluid py-3 panels-page">
    <div class="mb-4">
        <h1 class="h3 fw-bold mb-1"><i class="bi bi-grid-1x2-fill text-primary me-2"></i>پنل‌های کاربری</h1>
        <p class="text-muted mb-0">دسترسی سریع به بخش‌های متناسب با نوع کاربری شما</p>
    </div>

    <div class="row g-4">
        <div class="col-12 col-md-6 col-xl-4">
            <div class="panel-card customer">
                <div class="panel-icon"><i class="bi bi-person-badge"></i></div>
                <h2>پنل مشتری</h2>
                <p>پیگیری رزروها، معرف، پرداختی‌ها و موارد مورد علاقه.</p>
                <div class="panel-links">
                    <a href="/panels/customer"><i class="bi bi-arrow-left"></i> ورود به پنل مشتری</a>
                    @if (Auth.CanSee("ReferrerPanel")) { <a href="/my-dashboard"><i class="bi bi-speedometer2"></i> داشبورد اختصاصی</a> }
                    @if (Auth.CanSee("ReferrerWallets")) { <a href="/referrer-wallets"><i class="bi bi-wallet2"></i> پرداختی‌ها</a> }
                </div>
            </div>
        </div>

        @if (Auth.IsAdmin)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="panel-card admin">
                    <div class="panel-icon"><i class="bi bi-shield-lock"></i></div>
                    <h2>پنل ادمین</h2>
                    <p>مدیریت اطلاعات پایه، کاربران، نقش‌ها، شرکت‌ها، واحدها و داده‌های مرجع.</p>
                    <div class="panel-links"><a href="/panels/admin"><i class="bi bi-arrow-left"></i> ورود به پنل ادمین</a></div>
                </div>
            </div>
        }

        @if (HasPersonnelPanel)
        {
            <div class="col-12 col-md-6 col-xl-4">
                <div class="panel-card personnel">
                    <div class="panel-icon"><i class="bi bi-people"></i></div>
                    <h2>پنل پرسنل</h2>
                    <p>خدمات کامل پرسنلی، قراردادها، حضور و غیاب، حقوق، آموزش و ارتباطات داخلی.</p>
                    <div class="panel-links"><a href="/panels/personnel"><i class="bi bi-arrow-left"></i> ورود به پنل پرسنل</a></div>
                </div>
            </div>
        }
    </div>
</div>

<style>
    .panel-card { height:100%; min-height:245px; padding:1.35rem; border:1px solid #e2e8f0; border-radius:18px; background:#fff; box-shadow:0 8px 24px rgba(15,23,42,.06); transition:.18s; }
    .panel-card:hover { transform:translateY(-3px); box-shadow:0 14px 32px rgba(15,23,42,.12); }
    .panel-card h2 { font-size:1.2rem; font-weight:800; margin:.8rem 0 .45rem; }
    .panel-card p { color:#64748b; min-height:45px; }
    .panel-icon { width:48px; height:48px; display:grid; place-items:center; border-radius:15px; font-size:1.35rem; }
    .customer .panel-icon { color:#0369a1; background:#e0f2fe; } .admin .panel-icon { color:#7c3aed; background:#ede9fe; } .personnel .panel-icon { color:#047857; background:#d1fae5; }
    .panel-links { display:flex; flex-wrap:wrap; gap:.45rem; margin-top:1rem; }
    .panel-links a { text-decoration:none; padding:.45rem .7rem; border-radius:9px; background:#f8fafc; color:#334155; font-size:.83rem; }
    .panel-links a:hover { background:#e0e7ff; color:#3730a3; }
</style>

@code {
    private bool HasPersonnelPanel => Auth.IsAdmin || Auth.HasModule("HrCore") || Auth.HasModule("HrMain") || Auth.HasModule("FaAtt") || Auth.HasModule("FaPay") || Auth.HasModule("FaLms") || Auth.HasModule("FaCom");
}
