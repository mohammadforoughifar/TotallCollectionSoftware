@page "/"
@layout MainLayout
@inject IAuthState Auth
@inject IAuthApi AuthApi
@inject IDashboardService DashboardSvc
@inject IReportService ReportSvc
@inject IToastService Toast
@inject LayoutState Layout

@if (Auth.IsReferrer)
{
    <PageTitle>داشبورد من</PageTitle>

    @if (loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
    }
    else if (dash is not null)
    {
        <div class="page-head">
            <div>
                <h1>سلام، @dash.ReferrerName 👋</h1>
                <p class="lead">
                    @(string.IsNullOrWhiteSpace(dash.CompanyName) ? "پنل معرف" : dash.CompanyName)
                    — پورسانت کالا @dash.GoodsCommissionPercent.Num()٪ از سود | خدمات @dash.ServiceCommissionPercent.Num()٪ از مبلغ
                </p>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-6 col-lg-3">
                <div class="ref-stat ref-grad-1">
                    <i class="bi bi-wallet2 bg-ico"></i>
                    <div class="fs-8 opacity-75">مانده کیف پول</div>
                    <div class="fs-4 fw-800 num">@dash.WalletBalance.Money()</div>
                    <div class="fs-8 opacity-75">ریال</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ref-stat ref-grad-2">
                    <i class="bi bi-graph-up-arrow bg-ico"></i>
                    <div class="fs-8 opacity-75">جمع پورسانت</div>
                    <div class="fs-4 fw-800 num">@dash.TotalCommission.Money()</div>
                    <div class="fs-8 opacity-75">ریال</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ref-stat ref-grad-3">
                    <i class="bi bi-cash-stack bg-ico"></i>
                    <div class="fs-8 opacity-75">جمع دریافتی</div>
                    <div class="fs-4 fw-800 num">@dash.TotalPaid.Money()</div>
                    <div class="fs-8 opacity-75">ریال</div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="ref-stat ref-grad-4">
                    <i class="bi bi-calendar-month bg-ico"></i>
                    <div class="fs-8 opacity-75">پورسانت ماه جاری</div>
                    <div class="fs-4 fw-800 num">@dash.MonthCommission.Money()</div>
                    <div class="fs-8 opacity-75">ریال — @dash.OrderCount.Num() سند فروش</div>
                </div>
            </div>
        </div>

        <div class="row g-3 mt-1">
            <div class="col-lg-7">
                <div class="card h-100">
                    <div class="card-header">
                        <i class="bi bi-receipt text-primary"></i>
                        <span class="card-title">آخرین فروش‌های دارای پورسانت</span>
                    </div>
                    <div class="card-body p-0">
                        @if (dash.RecentSales.Count == 0)
                        {
                            <div class="empty-state"><i class="bi bi-receipt"></i><h5>فروشی ثبت نشده است</h5></div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>سند</th>
                                            <th>تاریخ</th>
                                            <th>مشتری</th>
                                            <th class="text-start">مبلغ</th>
                                            <th class="text-start">پورسانت</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var s in dash.RecentSales)
                                        {
                                            <tr>
                                                <td class="doc-number text-primary fw-700">@s.Number</td>
                                                <td class="num fs-8">@s.Date.ToFa()</td>
                                                <td>@(s.CustomerName ?? "—")</td>
                                                <td class="text-start num">@s.Amount.Money()</td>
                                                <td class="text-start num fw-700 text-success">@s.Commission.Money()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
            <div class="col-lg-5">
                <div class="card h-100">
                    <div class="card-header">
                        <i class="bi bi-cash-stack text-primary"></i>
                        <span class="card-title">آخرین دریافتی‌ها</span>
                    </div>
                    <div class="card-body p-0">
                        @if (dash.RecentPayments.Count == 0)
                        {
                            <div class="empty-state"><i class="bi bi-cash-stack"></i><h5>پرداختی ثبت نشده است</h5></div>
                        }
                        else
                        {
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead>
                                        <tr>
                                            <th>سند</th>
                                            <th>تاریخ</th>
                                            <th class="text-start">مبلغ</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var p in dash.RecentPayments)
                                        {
                                            <tr>
                                                <td class="doc-number fw-700">@p.Number</td>
                                                <td class="num fs-8">@p.Date.ToFa()</td>
                                                <td class="text-start num fw-700 text-success">@p.Amount.Money()</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mt-3">
            <i class="bi bi-info-circle"></i>
            هنوز معرفی به حساب کاربری شما متصل نشده است. برای اتصال معرف با مدیر سیستم تماس بگیرید.
        </div>
    }
}
else
{
    @if (Auth.Has("Dashboards.Financial"))
    {
        <AdminHome />
    }
    else
    {
        <div class="alert alert-warning mt-3">
            <i class="bi bi-shield-exclamation"></i>
            شما به «داشبورد مالی» دسترسی ندارید. از منو یکی از بخش‌های مجاز را انتخاب کنید.
        </div>
    }
}

@code {
    private ReferrerDashboard? dash;
    private bool loading;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsReferrer) return;
        Layout.SetTitle("داشبورد من");
        if (Auth.ReferrerId is not > 0) { loading = false; return; } // معرفی متصل نیست — پیام راهنما نمایش داده می‌شود
        loading = true;
        try { dash = await AuthApi.GetMyDashboardAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }
}
