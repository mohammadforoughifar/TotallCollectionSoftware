@page "/panels/admin"
@inject IAuthState Auth
<PageTitle>پنل ادمین</PageTitle>
@if (!Auth.IsAdmin) { <div class="alert alert-danger m-3">این پنل فقط برای مدیر سامانه است.</div> }
else
{
<div class="container-fluid py-3"><h1 class="h3 fw-bold">پنل ادمین</h1><p class="text-muted">مدیریت اطلاعات پایه و تنظیمات موجودیت‌های سامانه</p><div class="row g-3 mt-2">
    <PanelLink Icon="bi-people" Title="کاربران" Description="مدیریت کاربران سامانه" Href="/users" />
    <PanelLink Icon="bi-shield-lock" Title="نقش‌ها و دسترسی‌ها" Description="تعریف نقش و مجوزهای ماژولار" Href="/settings/roles" />
    <PanelLink Icon="bi-building" Title="شرکت‌ها" Description="اطلاعات پایه شرکت‌ها" Href="/system-company" />
    <PanelLink Icon="bi-diagram-3" Title="واحدها" Description="واحدها و ساختار سازمانی" Href="/system-department" />
    <PanelLink Icon="bi-box-seam" Title="کالاها" Description="کالا، گروه و واحد شمارش" Href="/products" />
    <PanelLink Icon="bi-shop" Title="انبارها" Description="تعریف انبار و اطلاعات پایه آن" Href="/warehouses" />
    <PanelLink Icon="bi-person-lines-fill" Title="طرف حساب‌ها" Description="مشتری، تأمین‌کننده و طرف حساب" Href="/parties" />
    <PanelLink Icon="bi-person-badge" Title="معرف‌ها" Description="معرف‌ها و پرداختی‌های آن‌ها" Href="/referrers" />
    <PanelLink Icon="bi-envelope-at" Title="حساب‌های ایمیل" Description="تنظیمات ایمیل سازمانی" Href="/office/email" />
    <PanelLink Icon="bi-gear" Title="تنظیمات عمومی" Description="تنظیمات پایه نرم‌افزار" Href="/settings" />
</div></div>
}
