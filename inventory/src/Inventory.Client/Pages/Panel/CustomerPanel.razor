@page "/panels/customer"
@inject IAuthState Auth
<PageTitle>پنل مشتری</PageTitle>
<div class="container-fluid py-3"><h1 class="h3 fw-bold">پنل مشتری</h1><p class="text-muted">رزروها، معرف، پرداختی‌ها و موارد مورد علاقه</p><div class="row g-3 mt-2">
    <PanelLink Icon="bi-calendar-check" Title="رزروها" Description="ورود به بخش سفارش‌ها و پیگیری درخواست‌ها" Href="/orders/sale" />
    <PanelLink Icon="bi-person-badge" Title="معرف" Description="اطلاعات معرف و ارتباط با معرف" Href="/my-card" />
    <PanelLink Icon="bi-wallet2" Title="پرداختی‌ها" Description="مشاهده پرداختی‌ها و سوابق مالی" Href="/my-wallet" />
    <PanelLink Icon="bi-heart" Title="موارد مورد علاقه" Description="فهرست کالاها و موارد نشان‌شده" Href="/my-products" />
</div></div>
@code { [Parameter] public string? Unused { get; set; } }
