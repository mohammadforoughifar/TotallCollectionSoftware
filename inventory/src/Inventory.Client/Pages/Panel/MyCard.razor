@page "/my-card"
@inject IAuthState Auth
@inject IAuthApi AuthApi
@inject IToastService Toast
@inject LayoutState Layout

<PageTitle>کارت ویزیت من</PageTitle>

@if (!Auth.IsReferrer)
{
    <div class="alert alert-warning">این صفحه مخصوص معرف‌هاست.</div>
}
else if (Auth.ReferrerId is not > 0)
{
    <div class="alert alert-info mt-3">
        <i class="bi bi-info-circle"></i>
        هنوز معرفی به حساب کاربری شما متصل نشده است. برای اتصال معرف با مدیر سیستم تماس بگیرید.
    </div>
}
else if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (dash is not null)
{
    <div class="page-head no-print">
        <div>
            <h1>کارت ویزیت من</h1>
            <p class="lead">پیش‌نمایش کارت — دکمه چاپ، فقط کارت را چاپ می‌کند</p>
        </div>
    </div>

    <BusinessCard Name="@dash.ReferrerName" Shop="@dash.CompanyName" Phone="@dash.Phone" />
}

@code {
    private ReferrerDashboard? dash;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.IsReferrer) { loading = false; return; }
        Layout.SetTitle("کارت ویزیت من");
        if (Auth.ReferrerId is not > 0) { loading = false; return; } // معرفی متصل نیست
        try { dash = await AuthApi.GetMyDashboardAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }
}
