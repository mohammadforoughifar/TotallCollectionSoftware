@page "/inv/settings"
@inject IInvSettingsService SettingsSvc
@inject IToastService Toast
@inject LayoutState Layout

<PageTitle>تنظیمات انبارداری و ساختار کدینگ</PageTitle>

<div class="page-head">
    <div>
        <h1>تنظیمات انبارداری و ساختار کدینگ کالا</h1>
        <p class="lead">پیکربندی ساختار کد هوشمند کالا و گروه‌ها، تعداد ارقام هر سطح، مالیات ارزش افزوده و قواعد انبارداری</p>
    </div>
</div>

@if (loading)
{
    <div class="d-flex align-items-center justify-content-center p-5">
        <div class="spinner-border text-primary me-3" role="status"></div>
        <span>در حال بارگذاری تنظیمات…</span>
    </div>
}
else
{
    <div class="row g-4">
        @* ================= کارت ۱: ساختار کدینگ کالا و گروه‌بندی (کد هوشمند کالا) ================= *@
        <div class="col-12 col-xl-10 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 border-bottom">
                    <span class="fw-700 fs-6 text-dark">
                        <i class="bi bi-upc-scan text-primary me-2"></i>ساختار و فرمت کدینگ کالا و گروه‌بندی (کد هوشمند کالا)
                    </span>
                    <span class="badge badge-soft-primary">سلسله‌مراتبی درختی ERP</span>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-light border py-2 mb-4 d-flex align-items-start gap-2" style="font-size: .84rem;">
                        <i class="bi bi-info-circle-fill text-primary mt-1"></i>
                        <div>
                            <b>قاعده کدینگ سلسله‌مراتبی کالا:</b>
                            کد کالا به صورت خودکار از ترکیب کد گروه‌های والد و زیرگروه تشکیل می‌شود و یک بخش پایانی به عنوان کد اختصاصی کالا (سریال/گام کالا) قرار می‌گیرد.
                            طول کد هر گروه و تعداد کاراکترهای مجاز بخش کالا در زیر قابل تعیین است.
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-600">
                                طول کد هر سطح گروه کالا (تعداد ارقام) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number" min="1" max="6" class="form-control num"
                                       @bind="settings.CategoryCodeLength" @bind:after="UpdatePreview" dir="ltr" />
                                <span class="input-group-text bg-light text-muted">رقم</span>
                            </div>
                            <div class="fs-8 text-muted mt-1">
                                تعداد ارقام مجاز برای کد هر گروه و زیرگروه (پیش‌فرض: ۲ رقم، مثلاً ۰۱، ۰۲، …)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-600">
                                طول کد اختصاصی کالا (گام کد کالا) <span class="text-danger">*</span>
                            </label>
                            <div class="input-group">
                                <input type="number" min="1" max="10" class="form-control num"
                                       @bind="settings.ProductCodeLength" @bind:after="UpdatePreview" dir="ltr" />
                                <span class="input-group-text bg-light text-muted">کاراکتر</span>
                            </div>
                            <div class="fs-8 text-muted mt-1">
                                تعداد کاراکترهای بخش پایانی کالا (مثلاً اگر ۴ انتخاب شود، کاربر تا ۴ کاراکتر می‌تواند قرار دهد: ۰۰۰۱ تا ۹۹۹۹)
                            </div>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label fw-600">جداکننده اجزای کد کالا</label>
                            <select class="form-select" @bind="settings.CodeDelimiter" @bind:after="UpdatePreview">
                                <option value="">بدون جداکننده (پیوسته عددی مانند ۰۱۰۲۰۰۰۱)</option>
                                <option value="-">خط تیره (- مانند ۰۱-۰۲-۰۰۰۱)</option>
                                <option value="/">اسلش (/ مانند ۰۱/۰۲/۰۰۰۱)</option>
                                <option value=".">نقطه (. مانند ۰۱.۰۲.۰۰۰۱)</option>
                            </select>
                            <div class="fs-8 text-muted mt-1">کاراکتر جداکننده اختیاری بین کدهای گروه‌ها و بخش کالا</div>
                        </div>

                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="autoCodeSwitch"
                                       @bind="settings.AutoCodeFromCategory" @bind:after="UpdatePreview" />
                                <label class="form-check-label fw-600" for="autoCodeSwitch">
                                    تولید خودکار کد کالا بر اساس سلسله‌مراتب گروه
                                </label>
                                <div class="fs-8 text-muted">ترکیب کدهای گروه‌های مافوق با بخش سریال کالا در فرم ثبت کالای جدید</div>
                            </div>
                        </div>

                        @* جعبه پیش‌نمایش گرافیکی ساختار کدینگ *@
                        <div class="col-12 mt-4">
                            <div class="p-3 bg-light border rounded-3">
                                <div class="d-flex align-items-center justify-content-between mb-3">
                                    <span class="fw-700 text-dark fs-8">
                                        <i class="bi bi-eye text-primary me-1"></i> پیش‌نمایش زنده ساختار کد کالا با تنظیمات جاری:
                                    </span>
                                    <span class="badge bg-secondary font-monospace">طول کل: @previewTotalLength کاراکتر</span>
                                </div>

                                <div class="d-flex flex-wrap align-items-center gap-2 p-3 bg-white rounded border font-monospace justify-content-center" dir="ltr">
                                    <div class="text-center p-2 px-3 rounded border border-primary bg-primary bg-opacity-10">
                                        <div class="fs-8 text-muted">گروه اصلی (سطح ۱)</div>
                                        <b class="text-primary fs-6">@previewCat1</b>
                                    </div>
                                    @if (!string.IsNullOrEmpty(settings.CodeDelimiter))
                                    {
                                        <span class="fw-bold text-muted fs-5">@settings.CodeDelimiter</span>
                                    }
                                    <div class="text-center p-2 px-3 rounded border border-info bg-info bg-opacity-10">
                                        <div class="fs-8 text-muted">زیرگروه (سطح ۲)</div>
                                        <b class="text-info fs-6">@previewCat2</b>
                                    </div>
                                    @if (!string.IsNullOrEmpty(settings.CodeDelimiter))
                                    {
                                        <span class="fw-bold text-muted fs-5">@settings.CodeDelimiter</span>
                                    }
                                    <div class="text-center p-2 px-3 rounded border border-success bg-success bg-opacity-10">
                                        <div class="fs-8 text-muted">کد کالا (گام آخر)</div>
                                        <b class="text-success fs-6">@previewProduct</b>
                                    </div>
                                    <span class="fw-bold text-muted fs-5 px-1">→</span>
                                    <div class="text-center p-2 px-4 rounded border border-dark bg-dark text-white shadow-sm">
                                        <div class="fs-8 text-white-50">کد کامل نهایی کالا</div>
                                        <b class="fs-6 text-warning">@previewFullCode</b>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ================= کارت ۲: روش و نرخ‌های ارزش افزوده ================= *@
        <div class="col-12 col-xl-10 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 border-bottom">
                    <span class="fw-700 fs-6 text-dark">
                        <i class="bi bi-calculator-fill text-primary me-2"></i>روش و فرمول محاسبه مالیات بر ارزش افزوده (VAT)
                    </span>
                    <span class="badge badge-soft-success">استاندارد مودیان و حسابداری</span>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-info py-2 mb-3" style="font-size: .84rem;">
                        <i class="bi bi-info-circle-fill me-1"></i>
                        <b>قاعده محاسبه ریالی ارزش افزوده در فاکتورها و اسناد انبار:</b>
                        ارزش افزوده تنها به اقلام مشمول تعلق می‌گیرد و تخفیف‌ها پیش از محاسبه ارزش افزوده از مبلغ ناخالص کسر می‌گردند.
                    </div>

                    <div class="p-3 bg-light border rounded-3 mb-4">
                        <div class="fw-600 mb-2 text-dark"><i class="bi bi-diagram-3 text-secondary me-1"></i> فرمول محاسباتی سامانه:</div>
                        <div class="font-monospace fs-8 p-2 bg-white rounded border mb-2" dir="ltr">
                            مبلغ مشمول سطر = (تعداد × فی واحد) − تخفیف
                        </div>
                        <div class="font-monospace fs-8 p-2 bg-white rounded border mb-2 text-primary" dir="ltr">
                            ارزش افزوده = مبلغ مشمول سطر × (نرخ ارزش افزوده ٪)
                        </div>
                        <div class="font-monospace fs-8 p-2 bg-white rounded border text-success fw-bold" dir="ltr">
                            مبلغ کل سطر = مبلغ مشمول سطر + مالیات بر ارزش افزوده
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-600">نرخ پیش‌فرض ارزش افزوده در سیستم (٪)</label>
                            <input type="number" step="any" class="form-control num" @bind="settings.DefaultVatRate" dir="ltr" />
                            <div class="fs-8 text-muted mt-1">نرخ پایه اعمال شده روی کالاهای جدید (پیش‌فرض: ۱۰٪)</div>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-600">نرخ پیش‌فرض عوارض قانونی (٪)</label>
                            <input type="number" step="any" class="form-control num" @bind="settings.DefaultDutyRate" dir="ltr" />
                            <div class="fs-8 text-muted mt-1">نرخ عوارض در صورت نیاز به تفکیک از مالیات</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ================= کارت ۳: روش قیمت‌گذاری و کنترل موجودی ================= *@
        <div class="col-12 col-xl-10 mx-auto">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white d-flex align-items-center justify-content-between py-3 border-bottom">
                    <span class="fw-700 fs-6 text-dark">
                        <i class="bi bi-gear-wide-connected text-primary me-2"></i>روش قیمت‌گذاری پیش‌فرض و کنترل موجودی انبار
                    </span>
                    <span class="badge badge-soft-warning">قواعد اسناد</span>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label fw-600">روش قیمت‌گذاری پیش‌فرض انبارداری</label>
                            <select class="form-select" @bind="settings.CostingMethod">
                                <option value="Average">میانگین موزون (Average)</option>
                                <option value="FIFO">اولین صادره از اولین وارده (FIFO)</option>
                                <option value="LIFO">اولین صادره از آخرین وارده (LIFO)</option>
                            </select>
                            <div class="fs-8 text-muted mt-1">روش پایه محاسبه بهای تمام شده خروج انبار</div>
                        </div>
                        <div class="col-md-6 d-flex align-items-center">
                            <div class="form-check form-switch mt-2">
                                <input class="form-check-input" type="checkbox" id="negStock" @bind="settings.AllowNegativeStock" />
                                <label class="form-check-label fw-600" for="negStock">
                                    اجازه منفی شدن موجودی در اسناد
                                </label>
                                <div class="fs-8 text-muted">صدور حواله حتی در صورت کسری موجودی کالا در انبار</div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="card-footer bg-light p-3 d-flex justify-content-end">
                    <button class="btn btn-primary px-4 py-2 fw-600" @onclick="SaveAllSettings" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <span>در حال ذخیره…</span>
                        }
                        else
                        {
                            <i class="bi bi-check2-circle me-1"></i>
                            <span>ذخیره تمامی تنظیمات انبار و کدینگ</span>
                        }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private WarehousingSettingsDto settings = new();
    private bool loading = true;
    private bool saving = false;

    // متغیرهای پیش‌نمایش ساختار کدینگ
    private string previewCat1 = "01";
    private string previewCat2 = "02";
    private string previewProduct = "0001";
    private string previewFullCode = "01020001";
    private int previewTotalLength = 8;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("تنظیمات انبارداری و کدینگ");
        await LoadSettings();
    }

    private async Task LoadSettings()
    {
        loading = true;
        try
        {
            settings = await SettingsSvc.GetSettingsAsync() ?? new WarehousingSettingsDto();
            UpdatePreview();
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در بارگذاری تنظیمات: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void UpdatePreview()
    {
        var catLen = settings.CategoryCodeLength > 0 ? settings.CategoryCodeLength : 2;
        var prodLen = settings.ProductCodeLength > 0 ? settings.ProductCodeLength : 4;
        var delim = settings.CodeDelimiter ?? "";

        previewCat1 = "1".PadLeft(catLen, '0');
        previewCat2 = "2".PadLeft(catLen, '0');
        previewProduct = "1".PadLeft(prodLen, '0');

        if (settings.AutoCodeFromCategory)
        {
            previewFullCode = string.IsNullOrEmpty(delim)
                ? $"{previewCat1}{previewCat2}{previewProduct}"
                : $"{previewCat1}{delim}{previewCat2}{delim}{previewProduct}";
        }
        else
        {
            previewFullCode = previewProduct;
        }

        previewTotalLength = previewFullCode.Length;
    }

    private async Task SaveAllSettings()
    {
        saving = true;
        try
        {
            settings.CategoryCodeLength = Math.Clamp(settings.CategoryCodeLength, 1, 10);
            settings.ProductCodeLength = Math.Clamp(settings.ProductCodeLength, 1, 15);
            settings = await SettingsSvc.SaveSettingsAsync(settings);
            UpdatePreview();
            Toast.Success("تنظیمات ساختار کدینگ، انبارداری و نرخ‌های ارزش افزوده با موفقیت ذخیره شدند.");
        }
        catch (Exception ex)
        {
            Toast.Error($"خطا در ذخیره تنظیمات: {ex.Message}");
        }
        finally
        {
            saving = false;
        }
    }
}
