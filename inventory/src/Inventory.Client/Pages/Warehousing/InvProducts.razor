@page "/inv/products"
@inject IInvProductService ProductSvc
@inject IInvCategoryService CategorySvc
@inject IInvWarehouseService WarehouseSvc
@inject IUnitService UnitSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS
@inject IServiceProvider ServiceProvider

<PageTitle>تعریف کالا</PageTitle>

<div class="page-head">
    <div>
        <h1>تعریف کالا</h1>
        <p class="lead">مشخصات کامل کالا: اطلاعات پایه، مالیات، انبار و ویژگی‌ها</p>
    </div>
    <div class="ms-auto d-flex gap-2">
        <button class="btn btn-primary" @onclick="() => OpenNew()">
            <i class="bi bi-plus-lg"></i> کالای جدید
        </button>
    </div>
</div>

<!-- ================= فیلترها ================= -->
<div class="card">
    <div class="card-body">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" placeholder="جستجوی نام، کد، بارکد، کد مالیاتی…" @bind="search" @onkeydown="OnSearchKey" />
                    <button class="btn btn-primary" @onclick="OnSearch">جستجو</button>
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @bind="filterCategoryStr" @bind:after="OnSearch">
                    <option value="0">همه گروه‌ها</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@(new string('\u00A0', c.Depth * 3))@(c.Depth > 0 ? "└ " : "")@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select" @bind="filterWarehouseStr" @bind:after="OnSearch">
                    <option value="0">همه انبارها</option>
                    @foreach (var w in warehouses)
                    {
                        <option value="@w.Id">@w.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-auto">
                <div class="form-check ms-2">
                    <input class="form-check-input" type="checkbox" id="belowChk" checked="@belowOnly" @onchange="OnBelowChanged" />
                    <label class="form-check-label" for="belowChk">فقط زیر نقطه سفارش</label>
                </div>
            </div>
            <div class="col-auto ms-auto fs-8 text-muted">@total.Num() کالا</div>
        </div>
    </div>
</div>

<!-- ================= فهرست ================= -->
<div class="card mt-3">
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-box-seam"></i><h5>کالایی یافت نشد</h5></div>
        }
        else
        {
            <div class="table-responsive grid-desktop">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>کد</th>
                            <th>نام کالا</th>
                            <th>گروه</th>
                            <th>کد مالیاتی</th>
                            <th>واحد</th>
                            <th>روش قیمت‌گذاری</th>
                            <th class="text-start">قیمت خرید</th>
                            <th class="text-start">قیمت فروش</th>
                            <th class="text-start">موجودی</th>
                            <th>وضعیت</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in items)
                        {
                            <tr>
                                <td class="doc-number text-muted">@p.Code.FaDigits()</td>
                                <td>
                                    <div class="fw-500">@p.Name</div>
                                    @if (!string.IsNullOrWhiteSpace(p.Brand))
                                    {
                                        <div class="fs-8 text-muted">@p.Brand @p.Model</div>
                                    }
                                </td>
                                <td class="fs-8">@(p.CategoryName ?? "—")</td>
                                <td class="num fs-8">@(string.IsNullOrWhiteSpace(p.TaxCode) ? "—" : p.TaxCode.FaDigits())</td>
                                <td>@p.Unit</td>
                                <td>
                                    <span class="badge @(p.Valuation is null ? "badge-soft-muted" : "badge-soft-primary") fs-8">
                                        @MethodTitle(p.EffectiveValuation)
                                    </span>
                                </td>
                                <td class="text-start num">@p.PurchasePrice.Money()</td>
                                <td class="text-start num fw-500">@p.SalePrice.Money()</td>
                                <td class="text-start num">@p.TotalStock.Num()</td>
                                <td>
                                    @if (!p.IsActive)
                                    {
                                        <span class="badge badge-soft-muted">غیرفعال</span>
                                    }
                                    else if (p.BelowReorder)
                                    {
                                        <span class="badge badge-soft-danger"><i class="bi bi-exclamation-triangle"></i> زیر نقطه سفارش</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-success"><i class="bi bi-check2"></i> فعال</span>
                                    }
                                </td>
                                <td class="text-end">
                                    <a class="btn btn-sm btn-light" title="کاردکس" href="inv/kardex?productId=@p.Id"><i class="bi bi-journal-text text-info"></i></a>
                                    <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEdit(p)"><i class="bi bi-pencil text-primary"></i></button>
                                    <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(p)"><i class="bi bi-trash text-danger"></i></button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ---------- نمای کارتی (موبایل) ---------- *@
            <div class="cards-mobile">
                @foreach (var p in items)
                {
                    <div class="m-card @(p.BelowReorder ? "st-cancelled" : "st-ready")">
                        <div class="m-card-head">
                            <div class="m-card-icon"><i class="bi bi-box-seam"></i></div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="doc-number text-muted fs-8">@p.Code.FaDigits()</span>
                                    <span class="badge badge-soft-primary fs-8">@MethodTitle(p.EffectiveValuation)</span>
                                </div>
                                <div class="fw-700 text-truncate">@p.Name</div>
                                <div class="fs-8 text-muted text-truncate">@(p.CategoryName ?? "بدون گروه") — @p.Unit</div>
                            </div>
                        </div>
                        <div class="m-card-body">
                            <div class="m-card-row"><span><i class="bi bi-boxes text-muted"></i> موجودی</span><b class="num">@p.TotalStock.Num()</b></div>
                            <div class="m-card-money">
                                <div>
                                    <div class="fs-8 text-muted">قیمت خرید</div>
                                    <div class="num fw-500">@p.PurchasePrice.Money()</div>
                                </div>
                                <div class="text-end">
                                    <div class="fs-8 text-muted">قیمت فروش</div>
                                    <div class="num fw-800 text-primary">@p.SalePrice.Money()</div>
                                </div>
                            </div>
                        </div>
                        <div class="m-card-actions">
                            <button class="btn btn-light text-primary" @onclick="() => OpenEdit(p)"><i class="bi bi-pencil"></i> ویرایش</button>
                            <button class="btn btn-light text-danger" @onclick="() => Delete(p)"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                }
            </div>

            <Pager Page="page" PageCount="pageCount" OnPageChanged="GoToPage" />
        }
    </div>
</div>

<!-- ================= مودال تعریف کالا (چند مرحله‌ای) ================= -->
<Modal Visible="showModal" Title="@ModalTitle" Size="modal-xl" OnClose="CloseModal">
    <ChildContent>
        @* ---------- نوار مرحله ---------- *@
        <div class="wiz-bar">
            @for (var i = 0; i < TabTitles.Length; i++)
            {
                var idx = i;
                <span class="wiz-dot @(idx == tab ? "active" : idx < tab ? "done" : "")">@((idx + 1).FaDigits())</span>
                if (idx < TabTitles.Length - 1)
                {
                    <span class="wiz-line @(idx < tab ? "done" : "")"></span>
                }
            }
        </div>

        @* ---------- تب‌ها ---------- *@
        <div class="mtabs">
            @for (var i = 0; i < TabTitles.Length; i++)
            {
                var idx = i;
                <button type="button" class="mtab @(tab == idx ? "active" : "")" @onclick="() => tab = idx">
                    <i class="bi @TabIcons[idx]"></i>
                    <span>@TabTitles[idx]</span>
                </button>
            }
        </div>

        @* ============ تب ۱: اطلاعات اصلی ============ *@
        @if (tab == 0)
        {
            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label">کد کالا <span class="text-danger">*</span></label>
                    <input class="form-control num" @bind="form.Code" dir="ltr" />
                </div>
                <div class="col-md-6">
                    <label class="form-label">نام کالا <span class="text-danger">*</span></label>
                    <input class="form-control" @bind="form.Name" placeholder="مثلاً: روغن موتور ۲۰-۵۰" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">نام لاتین</label>
                    <input class="form-control" @bind="form.EnName" dir="ltr" />
                </div>

                <div class="col-md-5">
                    <label class="form-label">گروه کالا</label>
                    <select class="form-select" @bind="categoryStr" @bind:after="OnCategoryChanged">
                        <option value="0">— بدون گروه —</option>
                        @foreach (var c in categories)
                        {
                            <option value="@c.Id">@(new string('\u00A0', c.Depth * 4))@(c.Depth > 0 ? "└ " : "")@c.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label">واحد اصلی <span class="text-danger">*</span></label>
                    <input class="form-control" list="unitList" @bind="form.Unit" />
                    <datalist id="unitList">
                        @foreach (var u in units)
                        {
                            <option value="@u.Name"></option>
                        }
                    </datalist>
                </div>
                <div class="col-md-2">
                    <label class="form-label">واحد فرعی</label>
                    <input class="form-control" @bind="form.SecondUnit" placeholder="کارتن، بسته…" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">ضریب تبدیل</label>
                    <input type="number" step="any" class="form-control num" @bind="form.UnitFactor" dir="ltr" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">برند</label>
                    <input class="form-control" @bind="form.Brand" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">مدل</label>
                    <input class="form-control" @bind="form.Model" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">شماره فنی (Part No)</label>
                    <input class="form-control" @bind="form.PartNumber" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">بارکد</label>
                    <input class="form-control num" @bind="form.Barcode" dir="ltr" />
                </div>

                <div class="col-12">
                    <div class="d-flex flex-wrap gap-4">
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="pActive" checked="@form.IsActive"
                                   @onchange="e => form.IsActive = (bool)(e.Value ?? false)" />
                            <label class="form-check-label" for="pActive">کالا فعال است</label>
                        </div>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" id="pService" checked="@form.IsService"
                                   @onchange="e => form.IsService = (bool)(e.Value ?? false)" />
                            <label class="form-check-label" for="pService">خدمات است (بدون موجودی انبار)</label>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ تب ۲: قیمت و مالیات ============ *@
        else if (tab == 1)
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">قیمت خرید (ریال)</label>
                    <input class="form-control num" value="@fPurchase" @oninput="@(e => fPurchase = FormatMoney(e.Value))" inputmode="decimal" dir="ltr" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">قیمت فروش (ریال)</label>
                    <input class="form-control num" value="@fSale" @oninput="@(e => fSale = FormatMoney(e.Value))" inputmode="decimal" dir="ltr" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">قیمت فروش عمده (ریال)</label>
                    <input class="form-control num" value="@fSale2" @oninput="@(e => fSale2 = FormatMoney(e.Value))" inputmode="decimal" dir="ltr" />
                </div>

                <div class="col-12"><hr class="my-1" /></div>

                <div class="col-md-4">
                    <label class="form-label">
                        شناسه کالای مالیاتی <span class="fs-8 text-muted">(سامانه مودیان — ۱۳ رقمی)</span>
                    </label>
                    <input class="form-control num" @bind="form.TaxCode" dir="ltr" maxlength="20" placeholder="2710000000000" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">کد واحد سنجش مالیاتی</label>
                    <input class="form-control num" @bind="form.TaxUnitCode" dir="ltr" placeholder="164" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">کد گمرکی / تعرفه</label>
                    <input class="form-control num" @bind="form.CustomsCode" dir="ltr" />
                </div>
                <div class="col-md-2">
                    <label class="form-label">کشور سازنده</label>
                    <input class="form-control" @bind="form.CountryOfOrigin" />
                </div>

                <div class="col-md-3">
                    <label class="form-label d-block">مشمول ارزش افزوده</label>
                    <div class="form-check form-switch mt-1">
                        <input class="form-check-input" type="checkbox" id="pVat" checked="@form.IsVatIncluded"
                               @onchange="e => form.IsVatIncluded = (bool)(e.Value ?? false)" />
                        <label class="form-check-label" for="pVat">@(form.IsVatIncluded ? "بله" : "خیر")</label>
                    </div>
                </div>
                <div class="col-md-3">
                    <label class="form-label">نرخ ارزش افزوده (٪)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.VatRate" dir="ltr" disabled="@(!form.IsVatIncluded)" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">نرخ عوارض (٪)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.DutyRate" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">سایر مالیات و عوارض (٪)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.OtherTaxRate" dir="ltr" />
                </div>

                <div class="col-12">
                    <div class="doc-total-bar">
                        <div>
                            <div class="lbl">قیمت فروش</div>
                            <div class="val">@Fa.ParseDecimal(fSale).Money()</div>
                        </div>
                        <div>
                            <div class="lbl">مالیات و عوارض</div>
                            <div class="val text-warning">@TaxAmount.Money()</div>
                        </div>
                        <div class="ms-auto">
                            <div class="lbl">قیمت نهایی با مالیات</div>
                            <div class="val text-primary fs-5">@((Fa.ParseDecimal(fSale) + TaxAmount).Money()) <span class="fs-8 text-muted">ریال</span></div>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ============ تب ۳: انبار و موجودی ============ *@
        else if (tab == 2)
        {
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label">انبار پیش‌فرض</label>
                    <select class="form-select" @bind="warehouseStr">
                        <option value="0">— همه انبارها —</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">روش قیمت‌گذاری کالا</label>
                    <select class="form-select" @bind="valuationStr">
                        <option value="">— ارث‌بری از گروه کالا / تنظیمات —</option>
                        <option value="0">میانگین موزون</option>
                        <option value="1">اولین صادره از اولین وارده (FIFO)</option>
                        <option value="2">اولین صادره از آخرین وارده (LIFO)</option>
                    </select>
                    <div class="fs-8 text-muted mt-1">
                        <i class="bi bi-info-circle"></i> روش فعلی: <b>@MethodTitle(form.EffectiveValuation)</b>
                        @if (!string.IsNullOrWhiteSpace(form.ValuationSource))
                        {
                            <span>— منبع: @form.ValuationSource</span>
                        }
                    </div>
                </div>
                <div class="col-md-4">
                    <label class="form-label">محل قفسه / آدرس انبارش</label>
                    <input class="form-control" @bind="form.ShelfCode" placeholder="مثلاً: A-12-3" />
                </div>

                <div class="col-md-3">
                    <label class="form-label">نقطه سفارش</label>
                    <input class="form-control num" value="@fReorder" @oninput="@(e => fReorder = FormatMoney(e.Value))" inputmode="decimal" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">حداکثر موجودی</label>
                    <input class="form-control num" value="@fMax" @oninput="@(e => fMax = FormatMoney(e.Value))" inputmode="decimal" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">حداقل مقدار سفارش</label>
                    <input class="form-control num" value="@fMinOrder" @oninput="@(e => fMinOrder = FormatMoney(e.Value))" inputmode="decimal" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">مدت اعتبار (روز)</label>
                    <input type="number" class="form-control num" @bind="form.ShelfLifeDays" dir="ltr" />
                </div>

                <div class="col-12">
                    <div class="attr-box">
                        <div class="fw-500 mb-2 fs-8 text-muted">ردیابی موجودی</div>
                        <div class="d-flex flex-wrap gap-4">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="tBatch" checked="@form.TrackBatch"
                                       @onchange="e => form.TrackBatch = (bool)(e.Value ?? false)" />
                                <label class="form-check-label" for="tBatch">ردیابی شماره بچ / سری ساخت</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="tSerial" checked="@form.TrackSerial"
                                       @onchange="e => form.TrackSerial = (bool)(e.Value ?? false)" />
                                <label class="form-check-label" for="tSerial">ردیابی شماره سریال</label>
                            </div>
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" id="tExpiry" checked="@form.TrackExpiry"
                                       @onchange="e => form.TrackExpiry = (bool)(e.Value ?? false)" />
                                <label class="form-check-label" for="tExpiry">ردیابی تاریخ انقضا</label>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label">وزن (کیلوگرم)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.Weight" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">طول (سانتی‌متر)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.Length" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">عرض (سانتی‌متر)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.Width" dir="ltr" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">ارتفاع (سانتی‌متر)</label>
                    <input type="number" step="any" class="form-control num" @bind="form.Height" dir="ltr" />
                </div>

                @if (editing)
                {
                    <div class="col-12">
                        <div class="doc-total-bar">
                            <div>
                                <div class="lbl">موجودی فعلی</div>
                                <div class="val">@form.TotalStock.Num() <span class="fs-8 text-muted">@form.Unit</span></div>
                            </div>
                            <div>
                                <div class="lbl">بهای میانگین</div>
                                <div class="val">@form.AvgCost.Money()</div>
                            </div>
                            <div class="ms-auto">
                                <div class="lbl">ارزش موجودی</div>
                                <div class="val text-primary">@form.StockValue.Money() <span class="fs-8 text-muted">ریال</span></div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @* ============ تب ۴: ویژگی‌ها (گرید با کمبو + مقدار بر اساس نوع) ============ *@
        else if (tab == 3)
        {
            <div class="attr-box">
                @if (availableAttributes.Count == 0 && form.Attributes.Count == 0)
                {
                    <div class="attr-empty">
                        <i class="bi bi-sliders fs-3 d-block mb-2"></i>
                        برای این گروه کالا ویژگی‌ای تعریف نشده است.
                        <div class="mt-2">
                            <a href="inv/attributes" class="btn btn-sm btn-outline-primary">
                                <i class="bi bi-plus-lg"></i> تعریف ویژگی جدید
                            </a>
                        </div>
                    </div>
                }
                else
                {
                    <div class="d-flex align-items-center mb-3">
                        <span class="fw-600"><i class="bi bi-sliders text-primary"></i> ویژگی‌های کالا</span>
                        <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="AddAttributeRow">
                            <i class="bi bi-plus-lg"></i> افزودن ویژگی
                        </button>
                    </div>

                    @if (form.Attributes.Count > 0)
                    {
                        <div class="doc-grid">
                            <table class="table table-sm table-hover align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th style="width:40px">#</th>
                                        <th style="width:35%">ویژگی</th>
                                        <th>مقدار</th>
                                        <th style="width:60px"></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @for (var i = 0; i < form.Attributes.Count; i++)
                                    {
                                        var idx = i;
                                        var a = form.Attributes[idx];
                                        <tr>
                                            <td><span class="row-no">@((idx + 1).FaDigits())</span></td>
                                            <td>
                                                <select class="form-select form-select-sm"
                                                        value="@a.AttributeId"
                                                        @onchange="e => OnAttributeChanged(idx, e)">
                                                    <option value="0">— انتخاب ویژگی —</option>
                                                    @foreach (var attr in availableAttributes)
                                                    {
                                                        <option value="@attr.Id">@attr.Name @(!string.IsNullOrWhiteSpace(attr.Unit) ? $"({attr.Unit})" : "")</option>
                                                    }
                                                </select>
                                            </td>
                                            <td>
                                                @switch (a.ValueType)
                                                {
                                                    case AttrValueType.Text:
                                                        <input class="form-control form-control-sm" @bind="a.TextValue" placeholder="مقدار متنی" />
                                                        break;
                                                    case AttrValueType.Number:
                                                        <input type="number" step="any" class="form-control form-control-sm num" @bind="a.NumberValue" dir="ltr" placeholder="مقدار عددی" />
                                                        break;
                                                    case AttrValueType.Boolean:
                                                        <select class="form-select form-select-sm" value="@BoolStr(a)" @onchange="e => SetBool(a, e)">
                                                            <option value="">—</option>
                                                            <option value="true">بله</option>
                                                            <option value="false">خیر</option>
                                                        </select>
                                                        break;
                                                    case AttrValueType.Date:
                                                        <DatePicker Value="a.DateValue" ValueChanged="v => a.DateValue = v" AllowClear="true" />
                                                        break;
                                                    case AttrValueType.List:
                                                        <select class="form-select form-select-sm" value="@(a.OptionId?.ToString() ?? "")"
                                                                @onchange="e => a.OptionId = int.TryParse(e.Value?.ToString(), out var oid) ? oid : null">
                                                            <option value="">— انتخاب کنید —</option>
                                                            @foreach (var o in a.Options)
                                                            {
                                                                <option value="@o.Id">@o.Title</option>
                                                            }
                                                        </select>
                                                        break;
                                                }
                                            </td>
                                            <td>
                                                <button class="btn btn-sm btn-light" title="حذف" @onclick="() => RemoveAttributeRow(idx)">
                                                    <i class="bi bi-trash text-danger"></i>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                }
            </div>
        }

        @* ============ تب ۵: شرح و تصویر ============ *@
        else
        {
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label">شرح کالا</label>
                    <textarea class="form-control" rows="3" @bind="form.Description" placeholder="توضیحاتی که در فاکتور و گزارش‌ها دیده می‌شود…"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">یادداشت داخلی</label>
                    <textarea class="form-control" rows="2" @bind="form.Note"></textarea>
                </div>
                <div class="col-12">
                    <label class="form-label">آدرس تصویر کالا</label>
                    <input class="form-control" @bind="form.ImageUrl" dir="ltr" placeholder="https://…" />
                </div>
                @if (editing)
                {
                    <div class="col-12 fs-8 text-muted">
                        <i class="bi bi-clock-history"></i> تاریخ ایجاد: @form.CreatedAt.ToFaDateTime()
                    </div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseModal">انصراف (Esc)</button>
        @if (tab > 0)
        {
            <button class="btn btn-outline-primary" @onclick="() => tab--"><i class="bi bi-chevron-right"></i> مرحله قبل</button>
        }
        @if (tab < TabTitles.Length - 1)
        {
            <button class="btn btn-outline-primary" @onclick="() => tab++">مرحله بعد <i class="bi bi-chevron-left"></i></button>
        }
        <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            ذخیره کالا
        </button>
    </Footer>
</Modal>

@code {
    private List<InvProduct> items = new();
    private List<InvCategory> categories = new();
    private List<InvWarehouse> warehouses = new();
    private List<MeasureUnit> units = new();

    private int total, page = 1, pageCount = 1;
    private const int PageSize = 12;
    private string search = "", filterCategoryStr = "0", filterWarehouseStr = "0";
    private bool belowOnly, loading = true;

    private InvProduct form = new();
    private bool showModal, saving;
    private int tab;
    private string categoryStr = "0", warehouseStr = "0", valuationStr = "";
    private string fSale = "", fSale2 = "", fPurchase = "", fReorder = "", fMax = "", fMinOrder = "";
    private bool editing => form.Id != 0;

    private static readonly string[] TabTitles = { "اطلاعات اصلی", "قیمت و مالیات", "انبار و موجودی", "ویژگی‌ها", "شرح و تصویر" };
    private static readonly string[] TabIcons = { "bi-info-circle", "bi-cash-coin", "bi-boxes", "bi-sliders", "bi-card-text" };

    private string ModalTitle => editing ? $"ویرایش کالا — {form.Name}" : "تعریف کالای جدید";

    private decimal TaxAmount
    {
        get
        {
            var basePrice = Fa.ParseDecimal(fSale);
            var rate = (form.IsVatIncluded ? form.VatRate : 0) + form.DutyRate + form.OtherTaxRate;
            return Math.Round(basePrice * rate / 100m, 0);
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("تعریف کالا");
        await LoadLookups();
        await Load();
    }

    private async Task LoadLookups()
    {
        try
        {
            categories = await CategorySvc.GetFlatAsync(activeOnly: true);
            warehouses = await WarehouseSvc.GetAllAsync(activeOnly: true);
            units = await UnitSvc.GetAllAsync(activeOnly: true);
        }
        catch { /* نبود اطلاعات پایه مانع کار صفحه نیست */ }
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            var catId = int.TryParse(filterCategoryStr, out var c) ? c : 0;
            var whId = int.TryParse(filterWarehouseStr, out var w) ? w : 0;
            var res = await ProductSvc.GetAllAsync(search, catId, whId, belowOnly, false, page, PageSize);
            items = res.Items;
            total = res.TotalCount;
            pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task OnSearch() { page = 1; await Load(); }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { page = 1; await Load(); }
    }

    private async Task OnBelowChanged(ChangeEventArgs e)
    {
        belowOnly = e.Value is bool b && b;
        page = 1;
        await Load();
    }

    private async Task GoToPage(int p) { page = p; await Load(); }

    // ---------- مودال ----------
    private async Task OpenNew()
    {
        await LoadLookups();
        try
        {
            form = await ProductSvc.NewAsync(int.TryParse(filterCategoryStr, out var c) && c > 0 ? c : null);
        }
        catch (Exception ex) { Toast.Error(ex.Message); return; }

        categoryStr = (form.CategoryId ?? 0).ToString();
        warehouseStr = "0";
        valuationStr = "";
        fSale = fSale2 = fPurchase = fReorder = fMax = fMinOrder = "";
        tab = 0;
        showModal = true;
        await LoadAvailableAttributes();
    }

    private async Task OpenEdit(InvProduct p)
    {
        await LoadLookups();
        try { form = await ProductSvc.GetAsync(p.Id); }
        catch (Exception ex) { Toast.Error(ex.Message); return; }

        categoryStr = (form.CategoryId ?? 0).ToString();
        warehouseStr = (form.WarehouseId ?? 0).ToString();
        valuationStr = form.Valuation is null ? "" : ((int)form.Valuation.Value).ToString();
        fSale = Fa.Money(form.SalePrice);
        fSale2 = Fa.Money(form.SalePrice2);
        fPurchase = Fa.Money(form.PurchasePrice);
        fReorder = Fa.Money(form.ReorderPoint);
        fMax = Fa.Money(form.MaxStock);
        fMinOrder = Fa.Money(form.MinOrderQty);
        tab = 0;
        showModal = true;
        await LoadAvailableAttributes();
    }

    private void CloseModal() => showModal = false;

    /// <summary>با تغییر گروه، ویژگی‌های همان گروه بارگذاری می‌شوند (مقادیر واردشده حفظ می‌شود).</summary>
    private async Task OnCategoryChanged()
    {
        form.CategoryId = int.TryParse(categoryStr, out var c) && c > 0 ? c : null;
        try
        {
            var fresh = await ProductSvc.NewAsync(form.CategoryId);
            foreach (var a in fresh.Attributes)
            {
                var old = form.Attributes.FirstOrDefault(x => x.AttributeId == a.AttributeId);
                if (old is null) continue;
                a.TextValue = old.TextValue;
                a.NumberValue = old.NumberValue;
                a.BoolValue = old.BoolValue;
                a.DateValue = old.DateValue;
                a.OptionId = old.OptionId;
            }
            form.Attributes = fresh.Attributes;
            form.EffectiveValuation = fresh.EffectiveValuation;
            form.ValuationSource = fresh.ValuationSource;
            await LoadAvailableAttributes();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Name)) { Toast.Error("نام کالا را وارد کنید."); tab = 0; return; }

        form.CategoryId = int.TryParse(categoryStr, out var c) && c > 0 ? c : null;
        form.WarehouseId = int.TryParse(warehouseStr, out var w) && w > 0 ? w : null;
        form.Valuation = int.TryParse(valuationStr, out var v) ? (ValuationMethod)v : null;
        form.SalePrice = Fa.ParseDecimal(fSale);
        form.SalePrice2 = Fa.ParseDecimal(fSale2);
        form.PurchasePrice = Fa.ParseDecimal(fPurchase);
        form.ReorderPoint = Fa.ParseDecimal(fReorder);
        form.MaxStock = Fa.ParseDecimal(fMax);
        form.MinOrderQty = Fa.ParseDecimal(fMinOrder);

        saving = true;
        try
        {
            await ProductSvc.SaveAsync(form);
            Toast.Success(editing ? "کالا ویرایش شد." : "کالا ثبت شد.");
            showModal = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Delete(InvProduct p)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف «{p.Name}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await ProductSvc.DeleteAsync(p.Id);
            Toast.Success("کالا حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---------- کمکی ----------
    private static string FormatMoney(object? value)
    {
        var raw = Fa.ToEn(value?.ToString() ?? "").Replace(",", "");
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var parts = raw.Split('.', 2);
        var intPart = new string(parts[0].Where(char.IsDigit).ToArray());
        if (intPart.Length == 0) intPart = "0";

        var formatted = decimal.Parse(intPart).ToString("#,##0");
        if (parts.Length == 2)
        {
            var frac = new string(parts[1].Where(char.IsDigit).ToArray());
            return $"{formatted}.{frac}";
        }
        return formatted;
    }

    // ---------- ویژگی‌ها: لیست ویژگی‌های قابل انتخاب ----------
    private List<InvAttribute> availableAttributes = new();

    private async Task LoadAvailableAttributes()
    {
        try
        {
            var attrSvc = (IInvAttributeService)ServiceProvider.GetService(typeof(IInvAttributeService))!;
            var all = await attrSvc.GetAllAsync(true);
            availableAttributes = all.Where(a => a.CategoryId == null || a.CategoryId == form.CategoryId).ToList();
        }
        catch { availableAttributes = new(); }
    }

    private void AddAttributeRow()
    {
        form.Attributes.Add(new InvProductAttrValue());
    }

    private async Task OnAttributeChanged(int idx, ChangeEventArgs e)
    {
        var attrId = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        var attr = availableAttributes.FirstOrDefault(a => a.Id == attrId);
        var row = form.Attributes[idx];
        row.AttributeId = attrId;
        if (attr != null)
        {
            row.AttributeName = attr.Name;
            row.ValueType = attr.ValueType;
            row.Unit = attr.Unit;
            row.IsRequired = attr.IsRequired;
            row.Options = attr.Options.Select(o => new InvAttributeOption
            {
                Id = o.Id, AttributeId = o.AttributeId, Title = o.Title, SortOrder = o.SortOrder
            }).ToList();
        }
        else
        {
            row.AttributeName = "";
            row.ValueType = AttrValueType.Text;
            row.Unit = "";
            row.Options.Clear();
        }
        await InvokeAsync(StateHasChanged);
    }

    private void RemoveAttributeRow(int idx)
    {
        if (idx >= 0 && idx < form.Attributes.Count)
            form.Attributes.RemoveAt(idx);
    }

    private static string BoolStr(InvProductAttrValue a) => a.BoolValue is null ? "" : (a.BoolValue.Value ? "true" : "false");

    private static void SetBool(InvProductAttrValue a, ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        a.BoolValue = string.IsNullOrEmpty(raw) ? null : raw == "true";
    }

    private static string MethodTitle(ValuationMethod m) => m switch
    {
        ValuationMethod.Fifo => "FIFO",
        ValuationMethod.Lifo => "LIFO",
        _ => "میانگین موزون"
    };
}
