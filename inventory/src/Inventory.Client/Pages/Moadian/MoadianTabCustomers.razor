@using Inventory.Shared.Dtos.Moadian
@inject IMoadianService Moadian
@inject IToastService Toast
@inject MoadianCompanyContext Ctx
@implements IDisposable

@if (Ctx.CpInfoId <= 0)
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-building-add"></i>
            <h5>ابتدا شرکت را ثبت کنید</h5>
            <NavLink class="btn btn-primary" href="moadian/basic-info/company">ثبت شرکت</NavLink>
        </div>
    </div></div>
}
else if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else
{
    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <span><i class="bi bi-people text-warning"></i> فهرست مشتریان <span class="text-muted small">— صورتحساب به نام آن‌ها صادر می‌شود</span></span>
            <span class="badge badge-soft-primary num">@(Customers?.Count ?? 0).Num() مشتری</span>
            <button class="btn btn-primary btn-sm ms-auto" @onclick="() => OpenForm(null)">
                <i class="bi bi-person-plus"></i> مشتری جدید
            </button>
        </div>
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="alert alert-danger small m-3 mb-0" style="white-space:pre-wrap">
                <i class="bi bi-exclamation-triangle"></i> بارگذاری فهرست مشتریان ناموفق بود:
                @loadError
            </div>
        }
        <div class="card-body p-0">
            @if (Customers is null || Customers.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-people"></i>
                    <h5>مشتری‌ای تعریف نشده است</h5>
                    <p class="text-muted">برای صدور صورتحساب، ابتدا مشتریان خود را ثبت کنید.</p>
                </div>
            }
            else
            {
                <div class="table-responsive grid-desktop">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>نام</th>
                                <th>نوع</th>
                                <th>کد ملی / ثبت شرکت</th>
                                <th>شماره اقتصادی</th>
                                <th>پست‌کد</th>
                                <th>تلفن</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Customers)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>
                                        <span class="badge @(c.Type == "حقوقی" ? "badge-soft-primary" : "badge-soft-success")">
                                            @(string.IsNullOrEmpty(c.Type) ? "—" : c.Type)
                                        </span>
                                    </td>
                                    <td class="num">@c.NationalID</td>
                                    <td class="num">@c.EconomicNumber</td>
                                    <td class="num">@c.PostalCode</td>
                                    <td class="num" dir="ltr">@c.Phone</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" title="ویرایش" @onclick="() => OpenForm(c)"><i class="bi bi-pencil"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<Modal Visible="showForm" Title="@(form.CustomerId > 0 ? "ویرایش مشتری" : "مشتری جدید")" Size="modal-lg" OnClose="CloseForm">
        <ChildContent>
    <div class="row g-2">
        <div class="col-md-8">
            <label class="form-label">نام مشتری <span class="text-danger">*</span></label>
            <input class="form-control" value="@form.Name" @oninput="e => form.Name = e.Value?.ToString()" placeholder="نام فرد یا شرکت" />
        </div>
        <div class="col-md-4">
            <label class="form-label">نوع</label>
            <select class="form-select" value="@form.Type" @onchange="e => form.Type = e.Value?.ToString()">
                <option value="حقیقی">حقیقی</option>
                <option value="حقوقی">حقوقی</option>
            </select>
        </div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-md-6">
            <label class="form-label">@(form.Type == "حقوقی" ? "شماره ثبت شرکت" : "کد ملی")</label>
            <input class="form-control num" dir="ltr" value="@form.NationalID" @oninput="e => form.NationalID = e.Value?.ToString()" />
        </div>
        <div class="col-md-6">
            <label class="form-label">شماره اقتصادی</label>
            <input class="form-control num" dir="ltr" value="@form.EconomicNumber" @oninput="e => form.EconomicNumber = e.Value?.ToString()" />
        </div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-md-6">
            <label class="form-label">پست‌کد</label>
            <input class="form-control num" dir="ltr" value="@form.PostalCode" @oninput="e => form.PostalCode = e.Value?.ToString()" />
        </div>
        <div class="col-md-6">
            <label class="form-label">تلفن</label>
            <input class="form-control num" dir="ltr" value="@form.Phone" @oninput="e => form.Phone = e.Value?.ToString()" placeholder="0912..." />
        </div>
    </div>
    <div class="mt-1">
        <label class="form-label">نشانی</label>
        <textarea class="form-control" rows="2" value="@form.Address" @oninput="e => form.Address = e.Value?.ToString()"></textarea>
    </div>
    @if (!string.IsNullOrEmpty(formError))
    {
        <div class="alert alert-danger py-2 small mt-2">@formError</div>
    }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="CloseForm">انصراف</button>
        <button class="btn btn-primary" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-check-lg"></i> }
            @(form.CustomerId > 0 ? "ذخیرهٔ تغییرات" : "ثبت مشتری")
        </button>
    </Footer>
</Modal>

@code {
    private List<VMCustomerList>? Customers;
    private bool loading = true;
    private string? loadError;

    private bool showForm;
    private VMCustomerList form = new() { Type = "حقیقی" };
    private string? formError;
    private bool saving;

    protected override void OnInitialized()
    {
        Ctx.Changed += OnCtxChanged;
        _ = LoadAsync();
    }

    private void OnCtxChanged() => _ = LoadAsync();

    private async Task LoadAsync()
    {
        if (Ctx.CpInfoId <= 0) { loading = false; StateHasChanged(); return; }
        loading = true; StateHasChanged();
        loadError = null;
        try { Customers = await Moadian.GetCustomersAsync(Ctx.CpInfoId); }
        catch (Exception ex) { loadError = ex.Message; Toast.Error(ex.Message); }
        finally { loading = false; StateHasChanged(); }
    }

    private void OpenForm(VMCustomerList? c)
    {
        form = c is null
            ? new VMCustomerList { CpInfoId = Ctx.CpInfoId, Type = "حقیقی" }
            : new VMCustomerList
            {
                CustomerId = c.CustomerId,
                CpInfoId = Ctx.CpInfoId,
                Name = c.Name,
                PostalCode = c.PostalCode,
                Phone = c.Phone,
                NationalID = c.NationalID,
                Type = string.IsNullOrEmpty(c.Type) ? "حقیقی" : c.Type,
                EconomicNumber = c.EconomicNumber,
                Address = c.Address
            };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Name)) { formError = "نام مشتری الزامی است."; return; }
        saving = true; StateHasChanged();
        try
        {
            var r = form.CustomerId > 0
                ? await Moadian.UpdateCustomerAsync(form)
                : await Moadian.InsertCustomerAsync(form);
            if (r.Success)
            {
                Toast.Success(form.CustomerId > 0 ? "تغییرات ذخیره شد." : "مشتری ثبت شد.");
                CloseForm();
                await LoadAsync();
            }
            else formError = r.Message ?? "خطا در ذخیره.";
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { saving = false; StateHasChanged(); }
    }

    public void Dispose() => Ctx.Changed -= OnCtxChanged;
}
