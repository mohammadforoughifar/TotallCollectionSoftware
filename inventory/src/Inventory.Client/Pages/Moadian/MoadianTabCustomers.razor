@using Inventory.Shared.Dtos.Moadian
@inject IMoadianService Moadian
@inject IToastService Toast
@inject MoadianCompanyContext Ctx
@implements IDisposable

@if (Ctx.CpInfoId <= 0)
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-building-add"></i>
            <h5>ابتدا شرکت را ثبت کنید</h5>
            <NavLink class="btn btn-primary" href="moadian/basic-info/company">ثبت شرکت</NavLink>
        </div>
    </div></div>
}
else
{
    <div class="card mi-blocked">
        <div class="card-header d-flex align-items-center gap-2 flex-wrap">
            <span><i class="bi bi-people" aria-hidden="true"></i> فهرست مشتریان <span class="text-muted small">— صورتحساب به نام آن‌ها صادر می‌شود</span></span>
            <span class="badge badge-soft-primary num">@(FilteredCustomers.Count.Num()) مشتری</span>
            <div class="ms-auto d-flex gap-2 align-items-center flex-wrap">
                <div class="mi-flt-search" style="max-width:none;min-width:230px">
                    <i class="bi bi-search" aria-hidden="true"></i>
                    <input class="form-control" placeholder="جستجو در نام، کد ملی/ثبت، شمارهٔ اقتصادی، تلفن" value="@search" @oninput="OnSearch" aria-label="جستجو در مشتریان" />
                </div>
                <button type="button" class="btn btn-primary btn-sm" @onclick="() => OpenForm(null)">
                    <i class="bi bi-person-plus" aria-hidden="true"></i> مشتری جدید
                </button>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="mi-error" role="alert">
                <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
                <div class="mi-error-text">
                    <div class="fw-bold">بارگذاری فهرست مشتریان ناموفق بود</div>
                    <div class="small" style="white-space:pre-wrap">@loadError</div>
                </div>
                <button type="button" class="btn btn-sm btn-outline-danger ms-auto" @onclick="() => LoadAsync()">
                    <i class="bi bi-arrow-repeat" aria-hidden="true"></i> تلاش دوباره
                </button>
            </div>
        }
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="mi-skeleton" role="status" aria-label="در حال بارگذاری مشتریان">
                    @for (int si = 0; si < 4; si++)
                    {
                        <div class="mi-sk-row">
                            <div class="mi-sk" style="width:26%"></div>
                            <div class="mi-sk" style="width:12%"></div>
                            <div class="mi-sk" style="width:18%"></div>
                            <div class="mi-sk" style="width:16%"></div>
                            <div class="mi-sk" style="width:10%"></div>
                            <div class="mi-sk" style="width:12%"></div>
                        </div>
                    }
                </div>
            }
            else if (FilteredCustomers.Count == 0)
            {
                <div class="empty-state">
                    <div class="mi-empty-icon" aria-hidden="true"><i class="bi bi-people"></i></div>
                    <h5>@(string.IsNullOrWhiteSpace(search) ? "مشتری‌ای تعریف نشده است" : $"مشتری‌ای با «{search}» یافت نشد")</h5>
                    <p class="text-muted mb-3">@(string.IsNullOrWhiteSpace(search)
                        ? "برای صدور صورتحساب، ابتدا مشتریان خود را ثبت کنید."
                        : "عبارت جستجو را تغییر دهید یا آن را پاک کنید.")</p>
                    <div class="d-flex gap-2 justify-content-center flex-wrap">
                        @if (!string.IsNullOrWhiteSpace(search))
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="ClearSearch"><i class="bi bi-x-lg" aria-hidden="true"></i> پاک‌کردن جستجو</button>
                        }
                        <button type="button" class="btn btn-primary" @onclick="() => OpenForm(null)"><i class="bi bi-person-plus" aria-hidden="true"></i> مشتری جدید</button>
                    </div>
                </div>
            }
            else
            {
                <div class="table-responsive grid-desktop mi-table">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>نام</th>
                                <th>نوع</th>
                                <th>کد ملی / ثبت شرکت</th>
                                <th>شماره اقتصادی</th>
                                <th>پست‌کد</th>
                                <th>تلفن</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in FilteredCustomers)
                            {
                                <tr>
                                    <td class="fw-semibold">@c.Name</td>
                                    <td>
                                        <span class="badge @(c.Type == "حقوقی" ? "badge-soft-primary" : "badge-soft-success")">
                                            @(string.IsNullOrEmpty(c.Type) ? "—" : c.Type)
                                        </span>
                                    </td>
                                    <td class="num">@c.NationalID</td>
                                    <td class="num">@c.EconomicNumber</td>
                                    <td class="num">@c.PostalCode</td>
                                    <td class="num" dir="ltr">@c.Phone</td>
                                    <td class="text-end">
                                        <button type="button" class="mpa mpa-green mpa-ic" title="ویرایش" @onclick="() => OpenForm(c)"><i class="bi bi-pencil" aria-hidden="true"></i></button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}

<Modal Visible="showForm" Title="@(form.CustomerId > 0 ? "ویرایش مشتری" : "مشتری جدید")" Size="modal-lg" OnClose="CloseForm">
        <ChildContent>
    <div class="row g-2">
        <div class="col-md-8">
            <label class="form-label">نام مشتری <span class="text-danger">*</span></label>
            <input class="form-control" value="@form.Name" @oninput="e => form.Name = e.Value?.ToString()" placeholder="نام فرد یا شرکت" />
        </div>
        <div class="col-md-4">
            <label class="form-label">نوع</label>
            <select class="form-select" value="@form.Type" @onchange="e => form.Type = e.Value?.ToString()">
                <option value="حقیقی">حقیقی</option>
                <option value="حقوقی">حقوقی</option>
            </select>
        </div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-md-6">
            <label class="form-label">@(form.Type == "حقوقی" ? "شماره ثبت شرکت" : "کد ملی")</label>
            <input class="form-control num" dir="ltr" value="@form.NationalID" @oninput="e => form.NationalID = e.Value?.ToString()" />
        </div>
        <div class="col-md-6">
            <label class="form-label">شماره اقتصادی</label>
            <input class="form-control num" dir="ltr" value="@form.EconomicNumber" @oninput="e => form.EconomicNumber = e.Value?.ToString()" />
        </div>
    </div>
    <div class="row g-2 mt-1">
        <div class="col-md-6">
            <label class="form-label">پست‌کد</label>
            <input class="form-control num" dir="ltr" value="@form.PostalCode" @oninput="e => form.PostalCode = e.Value?.ToString()" />
        </div>
        <div class="col-md-6">
            <label class="form-label">تلفن</label>
            <input class="form-control num" dir="ltr" value="@form.Phone" @oninput="e => form.Phone = e.Value?.ToString()" placeholder="0912..." />
        </div>
    </div>
    <div class="mt-1">
        <label class="form-label">نشانی</label>
        <textarea class="form-control" rows="2" value="@form.Address" @oninput="e => form.Address = e.Value?.ToString()"></textarea>
    </div>
    @if (!string.IsNullOrEmpty(formError))
    {
        <div class="alert alert-danger py-2 small mt-2">@formError</div>
    }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="CloseForm">انصراف</button>
        <button class="btn btn-primary" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-check-lg"></i> }
            @(form.CustomerId > 0 ? "ذخیرهٔ تغییرات" : "ثبت مشتری")
        </button>
    </Footer>
</Modal>

@code {
    private List<VMCustomerList>? Customers;
    private bool loading = true;
    private string? loadError;
    private string search = "";

    /// <summary>جستجوی سمت کلاینت — API فهرست مشتریان پارامتر جستجو ندارد.</summary>
    private List<VMCustomerList> FilteredCustomers
    {
        get
        {
            var all = Customers ?? new List<VMCustomerList>();
            if (string.IsNullOrWhiteSpace(search)) return all;
            var q = search.Trim();
            return all.Where(c =>
                (c.Name?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.NationalID?.Contains(q, StringComparison.Ordinal) ?? false)
                || (c.EconomicNumber?.Contains(q, StringComparison.OrdinalIgnoreCase) ?? false)
                || (c.Phone?.Contains(q, StringComparison.Ordinal) ?? false)).ToList();
        }
    }

    private void OnSearch(ChangeEventArgs e) { search = e.Value?.ToString() ?? ""; }
    private void ClearSearch() { search = ""; }

    private bool showForm;
    private VMCustomerList form = new() { Type = "حقیقی" };
    private string? formError;
    private bool saving;

    protected override void OnInitialized()
    {
        Ctx.Changed += OnCtxChanged;
        _ = LoadAsync();
    }

    private void OnCtxChanged() => _ = LoadAsync();

    private async Task LoadAsync()
    {
        if (Ctx.CpInfoId <= 0) { loading = false; StateHasChanged(); return; }
        loading = true; StateHasChanged();
        loadError = null;
        try { Customers = await Moadian.GetCustomersAsync(Ctx.CpInfoId); }
        catch (Exception ex) { loadError = ex.Message; Toast.Error(ex.Message); }
        finally { loading = false; StateHasChanged(); }
    }

    private void OpenForm(VMCustomerList? c)
    {
        form = c is null
            ? new VMCustomerList { CpInfoId = Ctx.CpInfoId, Type = "حقیقی" }
            : new VMCustomerList
            {
                CustomerId = c.CustomerId,
                CpInfoId = Ctx.CpInfoId,
                Name = c.Name,
                PostalCode = c.PostalCode,
                Phone = c.Phone,
                NationalID = c.NationalID,
                Type = string.IsNullOrEmpty(c.Type) ? "حقیقی" : c.Type,
                EconomicNumber = c.EconomicNumber,
                Address = c.Address
            };
        formError = null;
        showForm = true;
    }

    private void CloseForm() => showForm = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Name)) { formError = "نام مشتری الزامی است."; return; }
        saving = true; StateHasChanged();
        try
        {
            var r = form.CustomerId > 0
                ? await Moadian.UpdateCustomerAsync(form)
                : await Moadian.InsertCustomerAsync(form);
            if (r.Success)
            {
                Toast.Success(form.CustomerId > 0 ? "تغییرات ذخیره شد." : "مشتری ثبت شد.");
                CloseForm();
                await LoadAsync();
            }
            else formError = r.Message ?? "خطا در ذخیره.";
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { saving = false; StateHasChanged(); }
    }

    public void Dispose() => Ctx.Changed -= OnCtxChanged;
}
