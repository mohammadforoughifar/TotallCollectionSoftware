@page "/moadian/invoices"
@using Inventory.Shared.Dtos.Moadian
@using InvoiceVM = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.InvoiceVM
@using InvoiceResponse = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.InvoiceResponse
@inject IMoadianService Moadian
@inject IToastService Toast
@inject MoadianCompanyContext Ctx
@implements IDisposable

<PageTitle>سامانه مودیان — صورتحساب‌ها</PageTitle>

<div class="page-head">
    <div>
        <h1><i class="bi bi-journal-text text-primary"></i> صورتحساب‌های الکترونیکی</h1>
        <p class="lead">فهرست، صدور و پیگیری وضعیت صورتحساب در کارپوشهٔ مالیاتی</p>
    </div>
    <div class="ms-auto d-flex gap-2">
        <NavLink class="btn btn-primary" href="moadian/invoices/new"><i class="bi bi-plus-lg"></i> صورتحساب جدید</NavLink>
    </div>
</div>

<MoadianCompanyBar />

@if (Ctx.CpInfoId <= 0)
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-building-add"></i>
            <h5>برای مشاهدهٔ صورتحساب، ابتدا شرکت را ثبت کنید</h5>
            <NavLink class="btn btn-primary" href="moadian/basic-info/connection">ثبت شرکت و اتصال</NavLink>
        </div>
    </div></div>
}
else
{
    @* ---------- تب‌های وضعیت ---------- *@
    <div class="mtabs mb-3">
        @foreach (var (code, title, icon) in Tabs)
        {
            <button class="mtab @(fOp == code ? "active" : "")" @onclick="() => SetOp(code)">
                <i class="bi @icon"></i> @title
                @if (labels is not null)
                {
                    <span class="badge badge-soft-primary num ms-1">@(CountOf(code).Num())</span>
                }
            </button>
        }
    </div>

    @* ---------- فیلترها ---------- *@
    <div class="card mb-3">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label">جستجو</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="موضوع، شماره، شمارهٔ مالیاتی، مشتری، وضعیت…"
                               value="@search" @oninput="OnSearchInput" @onkeyup="OnSearchKey" />
                    </div>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">از تاریخ</label>
                    <DatePicker Value="fFrom" ValueChanged="OnFrom" AllowClear="true" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label">تا تاریخ</label>
                    <DatePicker Value="fTo" ValueChanged="OnTo" AllowClear="true" />
                </div>
                <div class="col-12 col-md-2">
                    <button class="btn btn-outline-secondary w-100" @onclick="() => ResetFilters()">
                        <i class="bi bi-arrow-counterclockwise"></i> حذف فیلترها
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ---------- جدول ---------- *@
    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <span><i class="bi bi-receipt text-primary"></i> @(MoadianUi.StatusLabel(fOp == "همه" ? null : fOp) == "—" ? "همهٔ صورتحساب‌ها" : MoadianUi.StatusLabel(fOp))</span>
            <span class="badge badge-soft-primary num ms-auto">@((data?.TotalCount ?? 0).Num()) مورد</span>
        </div>
        @if (!string.IsNullOrEmpty(loadError))
        {
            <div class="alert alert-danger small m-3 mb-0" style="white-space:pre-wrap">
                <i class="bi bi-exclamation-triangle"></i> بارگذاری فهرست صورتحساب‌ها ناموفق بود:
                @loadError
            </div>
        }
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (items is null || items.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-receipt"></i>
                    <h5>صورتحسابی یافت نشد</h5>
                    <p class="text-muted">با دکمهٔ «صورتحساب جدید» اولین صورتحساب را صادر کنید.</p>
                </div>
            }
            else
            {
                <div class="table-responsive grid-desktop">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th style="width:56px">ردیف</th>
                                <th>موضوع</th>
                                <th style="width:90px">شماره صورتحساب</th>
                                <th style="width:105px">تاریخ صدور</th>
                                <th>نام مشتری</th>
                                <th class="text-center" style="width:140px">مجموع صورتحساب</th>
                                <th style="width:80px">نوع پرداخت</th>
                                <th style="width:80px">الگوی صورتحساب</th>
                                <th style="width:150px">وضعیت</th>
                                <th class="text-end" style="min-width:320px">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int ix = 0; ix < items.Count; ix++)
                            {
                                var inv = items[ix];
                                <tr>
                                    <td class="num text-muted">@(((pno - 1) * PageSize + ix + 1).Num())</td>
                                    <td>
                                        <span class="badge @(inv.Subject == "اصلی" ? "badge-soft-primary" : inv.Subject == "اصلاحی" ? "badge-soft-warning" : "badge-soft-danger")">
                                            @inv.Subject
                                        </span>
                                    </td>
                                    <td class="num fw-semibold">@((inv.NumberInvoice ?? 0).Num())</td>
                                    <td class="num">@MoadianUi.Shamsi(inv.DateOrder)</td>
                                    <td>@inv.CustomerName</td>
                                    <td class="text-center num">@MoadianUi.Money(inv.TotallMoney)</td>
                                    <td>@inv.PaymentType</td>
                                    <td class="small">@inv.TypePattern</td>
                                    <td>
                                        <span class="badge @MoadianUi.StatusBadge(inv.StatusSentToSystemInt)">@inv.StatusSentToSystem</span>
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm" role="group">
                                            @* a) جزئیات *@
                                            <NavLink class="btn btn-outline-primary" href="@($"moadian/invoices/{inv.Id}")" title="جزئیات صورتحساب">
                                                <i class="bi bi-eye"></i>
                                            </NavLink>
                                            @* d) ویرایش *@
                                            @if (inv.StatusSentToSystemInt == "0")
                                            {
                                                <NavLink class="btn btn-outline-success" href="@($"moadian/invoices/{inv.Id}/edit")" title="ویرایش صورتحساب">
                                                    <i class="bi bi-pencil"></i>
                                                </NavLink>
                                            }
                                            @* e) کپی *@
                                            <NavLink class="btn btn-outline-secondary" href="@($"moadian/invoices/{inv.Id}/copy")" title="کپی صورتحساب">
                                                <i class="bi bi-copy"></i>
                                            </NavLink>
                                            @* b) چاپ *@
                                            <NavLink class="btn btn-outline-dark" href="@($"moadian/invoices/{inv.Id}?print=1")" title="چاپ صورتحساب">
                                                <i class="bi bi-printer"></i>
                                            </NavLink>
                                            @* ارسال *@
                                            @if (inv.ShowButtons && inv.StatusSentToSystemInt == "0")
                                            {
                                                <button type="button" class="btn btn-outline-success" title="ارسال به سامانه مودیان"
                                                        disabled="@acting" @onclick="() => SendToMoadian(inv)">
                                                    <i class="bi bi-send"></i>
                                                </button>
                                            }
                                            @if (!string.IsNullOrEmpty(inv.ReferenceId))
                                            {
                                                <button type="button" class="btn btn-outline-info" title="استعلام صورتحساب از سامانه مودیان"
                                                        disabled="@acting" @onclick="() => EstelamRow(inv)">
                                                    <i class="bi bi-arrow-repeat"></i>
                                                </button>
                                                <button type="button" class="btn btn-outline-danger" title="نمایش خطاهای صورتحساب"
                                                        disabled="@acting" @onclick="() => ShowErrorsRow(inv)">
                                                    <i class="bi bi-bug"></i>
                                                </button>
                                                @if (inv.ShowButtons)
                                                {
                                                    <NavLink class="btn btn-outline-warning" href="@($"moadian/invoices/{inv.Id}/eslahi")" title="صدور صورتحساب اصلاحی">
                                                        <i class="bi bi-pencil-square"></i>
                                                    </NavLink>
                                                    <button type="button" class="btn btn-outline-primary" title="صدور برگشت از فروش"
                                                            disabled="@acting" @onclick="() => SalesReturnRow(inv)">
                                                        <i class="bi bi-arrow-counterclockwise"></i>
                                                    </button>
                                                    <button type="button" class="btn btn-outline-dark" title="ابطال صورتحساب در سامانه مودیان"
                                                            disabled="@acting" @onclick="() => EbtalRow(inv)">
                                                        <i class="bi bi-x-octagon"></i>
                                                    </button>
                                                }
                                            }
                                            @if (inv.ShowButtons && inv.StatusSentToSystemInt == "0")
                                            {
                                                <button type="button" class="btn btn-outline-secondary" title="حذف صورتحساب (فقط ارسال‌نشده)"
                                                        disabled="@acting" @onclick="() => DeleteRow(inv)">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* ---------- صفحه‌بندی ---------- *@
                @if ((data?.TotalPages ?? 0) > 1)
                {
                    <div class="card-footer d-flex align-items-center gap-2">
                        <span class="text-muted small num">صفحهٔ @(pno.Num()) از @((data?.TotalPages ?? 1).Num())</span>
                        <div class="ms-auto d-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary" disabled="@(pno <= 1)" @onclick="() => GoPage(pno - 1)">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                            @for (int p = 1; p <= (data?.TotalPages ?? 1); p++)
                            {
                                int pp = p;
                                <button class="btn btn-sm @(pp == pno ? "btn-primary" : "btn-outline-secondary") num" @onclick="() => GoPage(pp)">@(pp.Num())</button>
                            }
                            <button class="btn btn-sm btn-outline-secondary" disabled="@(pno >= (data?.TotalPages ?? 1))" @onclick="() => GoPage(pno + 1)">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

@* ---------- پنجرهٔ نتیجهٔ استعلام / خطاها ---------- *@
@if (modalOpen)
{
    <div class="modal d-block" tabindex="-1" style="background:rgba(15,23,42,.45)">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title"><i class="bi bi-clipboard2-pulse text-primary"></i> @modalTitle</h5>
                    <button type="button" class="btn-close" @onclick="() => modalOpen = false" aria-label="بستن"></button>
                </div>
                <div class="modal-body">
                    <pre class="mb-0 small" dir="rtl" style="white-space:pre-wrap;max-height:50vh;overflow:auto">@modalBody</pre>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="() => modalOpen = false">بستن</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private static readonly (string Code, string Title, string Icon)[] Tabs =
    {
        ("همه", "همه", "bi-collection"),
        ("0", "ارسال نشده", "bi-inbox"),
        ("4", "در انتظار واکنش", "bi-hourglass-split"),
        ("2", "در انتظار بررسی", "bi-search"),
        ("5", "دارای خطا", "bi-exclamation-triangle"),
        ("6", "بدون نیاز به واکنش", "bi-archive"),
    };

    private PagedList<InvoiceVM>? data;
    private List<InvoiceVM>? items;
    private InvoiceVM? labels;
    private string fOp = "همه";
    private string search = "";
    private DateTime? fFrom, fTo;
    private int pno = 1;
    private const int PageSize = 10;
    private bool loading;
    private string? loadError;
    private System.Timers.Timer? searchTimer;

    // ---------- عملیات ردیف‌ها: ارسال / استعلام / خطاها ----------
    private bool acting;
    private bool modalOpen;
    private string modalTitle = "";
    private string modalBody = "";

    [Inject] private IJSRuntime JS { get; set; }

    private List<InvoiceVM> Items => items ?? new();

    protected override void OnInitialized()
    {
        Ctx.Changed += OnCtxChanged;
        searchTimer = new System.Timers.Timer(350) { AutoReset = false };
        searchTimer.Elapsed += (sender, e) => _ = InvokeAsync(() => LoadAsync(1));
        if (Ctx.CpInfoId > 0) _ = LoadAsync(1);
    }

    private void OnCtxChanged() => _ = LoadAsync(1);

    private int CountOf(string code) => (code, labels) switch
    {
        ("همه", var l) => l?.lblAll ?? 0,
        ("0", var l) => l?.lblNotSentToSystem ?? 0,
        ("4", var l) => l?.lblSentToSystem ?? 0,
        ("2", var l) => l?.lblLackOfResponsiveness ?? 0,
        ("5", var l) => l?.lblError ?? 0,
        ("6", _) => 0,
        _ => 0
    };

    private void SetOp(string code)
    {
        fOp = code;
        _ = LoadAsync(1);
    }

    private void OnSearchInput(ChangeEventArgs e) { search = e.Value?.ToString() ?? ""; searchTimer?.Stop(); searchTimer?.Start(); }
    private void OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { searchTimer?.Stop(); _ = LoadAsync(1); }
    }
    private void OnFrom(DateTime? v) { fFrom = v; _ = LoadAsync(1); }
    private void OnTo(DateTime? v) { fTo = v; _ = LoadAsync(1); }

    private void ResetFilters()
    {
        search = ""; fFrom = null; fTo = null; fOp = "همه";
        _ = LoadAsync(1);
    }

    private void GoPage(int p) => _ = LoadAsync(p);

    private async Task LoadAsync(int p)
    {
        if (Ctx.CpInfoId <= 0) return;
        loading = true;
        StateHasChanged();
        try
        {
            loadError = null;
            var model = await Moadian.GetAllInvoicesAsync(fOp, Ctx.CpInfoId, fFrom, fTo, search, p, PageSize);
            var resp = MoadianService.AsStrict<InvoiceResponse>(model, "دریافت فهرست صورتحساب‌ها");
            data = resp?.Invoices;
            items = resp?.Invoices?.Items?.ToList();
            labels = resp?.Labels;
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Toast.Error(ex.Message);
        }
        finally
        {
            pno = p;
            loading = false;
            StateHasChanged();
        }
    }

    private async Task CopyText(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            InvokeAsync(() => Toast.Info("شمارهٔ مالیاتی کپی شد."));
        }
        catch { InvokeAsync(() => Toast.Error("کپی ممکن نبود.")); }
    }

    /// <summary>a) ارسال ردیف به سامانهٔ مودیان — ابتدا جزئیات کامل صورتحساب واکشی، سپس همان فلوی صفحهٔ جزئیات ارسال می‌شود.</summary>
    private async Task SendToMoadian(InvoiceVM inv)
    {
        acting = true; StateHasChanged();
        try
        {
            var full = await Moadian.GetInvoiceAsync(inv.Id);
            if (full is null) { Toast.Error("جزئیات صورتحساب برای ارسال یافت نشد."); return; }
            var r = await Moadian.SendInvoiceAsync(full);
            if (r.Success)
            {
                Toast.Success($"صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"} به سامانهٔ مودیان ارسال شد.");
                await LoadAsync(pno);
            }
            else Toast.Error(r.Message ?? "خطا در ارسال به سامانه.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    /// <summary>برگشت از فروش — یک صورتحساب «برگشت از فروش» (Ins=4) بر اساس صورتحساب اصلی به سامانه ارسال می‌شود.</summary>
    private async Task SalesReturnRow(InvoiceVM inv)
    {
        if (string.IsNullOrEmpty(inv.ReferenceId)) { Toast.Info("برگشت از فروش فقط برای صورتحساب‌های ارسال‌شده ممکن است."); return; }
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"برای صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"} یک صورتحساب «برگشت از فروش» صادر و به سامانه ارسال می‌شود. ادامه می‌دهید؟");
        if (!ok) return;
        acting = true; StateHasChanged();
        try
        {
            var full = await Moadian.GetInvoiceAsync(inv.Id);
            if (full is null) { Toast.Error("جزئیات صورتحساب برای برگشت از فروش یافت نشد."); return; }
            full.Subject = "برگشت از فروش";
            var r = await Moadian.SendInvoiceAsync(full);
            if (r.Success)
            {
                Toast.Success($"برگشت از فروش صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"} ارسال شد.");
                await LoadAsync(pno);
            }
            else Toast.Error(r.Message ?? "خطا در ارسال برگشت از فروش.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    /// <summary>ابطال صورتحساب در سامانهٔ مودیان — با تایید کاربر؛ صورتحساب ابطالی جدید (الگوی ابطال) ثبت می‌شود.</summary>
    private async Task EbtalRow(InvoiceVM inv)
    {
        if (string.IsNullOrEmpty(inv.ReferenceId)) { Toast.Info("فقط صورتحساب‌های ارسال‌شده قابل ابطال‌اند."); return; }
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"} در سامانه مودیان ابطال می‌شود. ادامه می‌دهید؟");
        if (!ok) return;
        acting = true; StateHasChanged();
        try
        {
            var full = await Moadian.GetInvoiceAsync(inv.Id);
            if (full is null) { Toast.Error("جزئیات صورتحساب برای ابطال یافت نشد."); return; }
            var r = await Moadian.EbtalInvoiceAsync(full);
            if (r.Success)
            {
                Toast.Success($"ابطال صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"} ثبت شد.");
                await LoadAsync(pno);
            }
            else Toast.Error(r.Message ?? "خطا در ابطال صورتحساب.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    /// <summary>حذف صورتحساب ارسال‌نشده از دیتابیس محلی — با تایید کاربر.</summary>
    private async Task DeleteRow(InvoiceVM inv)
    {
        if (inv.StatusSentToSystemInt != "0") { Toast.Info("فقط صورتحساب‌های ارسال‌نشده قابل حذف‌اند."); return; }
        var ok = await JS.InvokeAsync<bool>("confirm",
            $"صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"} حذف می‌شود؛ این کار قابل بازگشت نیست. ادامه می‌دهید؟");
        if (!ok) return;
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.DeleteInvoiceAsync(inv.Id);
            if (r.Success)
            {
                Toast.Success("صورتحساب حذف شد.");
                await LoadAsync(pno);
            }
            else Toast.Error(r.Message ?? "خطا در حذف صورتحساب.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    /// <summary>b) استعلام وضعیت صورتحساب از سامانهٔ مودیان (با شمارهٔ مرجع) — نتیجه در پنجره نمایش داده و وضعیت ردیف به‌روزرسانی می‌شود.</summary>
    private async Task EstelamRow(InvoiceVM inv)
    {
        if (string.IsNullOrEmpty(inv.ReferenceId)) { Toast.Info("برای استعلام، ابتدا صورتحساب باید ارسال شده باشد."); return; }
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.EstelamInvoiceAsync(inv.ReferenceId!, inv.Id,
                (inv.DateOrder ?? DateOnly.FromDateTime(DateTime.Today)).ToString("yyyy-MM-dd"));
            modalTitle = $"استعلام صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"}";
            modalBody = r.Data?.ToString() ?? r.Message ?? "پاسخی از سامانه دریافت نشد.";
            modalOpen = true;
            if (r.Success) Toast.Success("وضعیت صورتحساب به‌روزرسانی شد.");
            else Toast.Error(r.Message ?? "استعلام ناموفق بود.");
            await LoadAsync(pno);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    /// <summary>c) نمایش خطاهای صورتحساب — کد، پیام و شرح خطاها/هشدارها از سامانهٔ مودیان.</summary>
    private async Task ShowErrorsRow(InvoiceVM inv)
    {
        if (string.IsNullOrEmpty(inv.ReferenceId)) { Toast.Info("این صورتحساب هنوز به سامانه ارسال نشده است."); return; }
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.ErrorInvoiceAsync(inv.ReferenceId!);
            var err = MoadianService.As<ErroreMesage>(r);
            modalTitle = $"خطاهای صورتحساب شمارهٔ {inv.NumberInvoice?.Num() ?? "—"}";
            var sb = new System.Text.StringBuilder();
            if (!string.IsNullOrWhiteSpace(err?.code)) sb.AppendLine($"کد: {err!.code}");
            if (!string.IsNullOrWhiteSpace(err?.message)) sb.AppendLine($"پیام: {err!.message}");
            if (!string.IsNullOrWhiteSpace(err?.errorsAndWarnings)) sb.AppendLine($"خطاها و هشدارها: {err!.errorsAndWarnings}");
            modalBody = sb.Length == 0 ? (r.Success ? "خطایی برای این صورتحساب ثبت نشده است." : (r.Message ?? "دریافت خطاها ناموفق بود.")) : sb.ToString();
            modalOpen = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    public void Dispose()
    {
        Ctx.Changed -= OnCtxChanged;
        searchTimer?.Dispose();
    }
}
