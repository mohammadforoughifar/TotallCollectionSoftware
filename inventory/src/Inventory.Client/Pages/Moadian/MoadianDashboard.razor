@page "/moadian"
@using Inventory.Shared.Dtos.Moadian
@using InvoiceVM = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.InvoiceVM
@using InvoiceResponse = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.InvoiceResponse
@inject IMoadianService Moadian
@inject IToastService Toast
@inject MoadianCompanyContext Ctx
@implements IDisposable

<PageTitle>سامانه مودیان — نمای کلی</PageTitle>

<div class="page-head">
    <div>
        <h1><i class="bi bi-receipt text-primary"></i> سامانهٔ مودیان</h1>
        <p class="lead">صورتحساب الکترونیکی مطابق الزامات مالیاتی — اتصال، صدور، ارسال و پیگیری وضعیت در کارپوشه</p>
    </div>
    <div class="ms-auto d-flex gap-2">
        <NavLink class="btn btn-primary" href="moadian/invoices/new"><i class="bi bi-plus-lg"></i> صورتحساب جدید</NavLink>
        <NavLink class="btn btn-outline-secondary" href="moadian/connection"><i class="bi bi-plug"></i> تنظیمات اتصال</NavLink>
    </div>
</div>

<MoadianCompanyBar />

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (Ctx.CpInfoId > 0)
{
    @* ---------- کارت‌های وضعیت صورتحساب ---------- *@
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon bg-soft-primary"><i class="bi bi-receipt text-primary"></i></div>
                <div>
                    <div class="stat-label">همهٔ صورتحساب‌ها</div>
                    <div class="stat-value num text-primary">@(labels?.lblAll ?? 0).Num()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon bg-soft-muted"><i class="bi bi-inbox text-secondary"></i></div>
                <div>
                    <div class="stat-label">ارسال نشده</div>
                    <div class="stat-value num">@(labels?.lblNotSentToSystem ?? 0).Num()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon bg-soft-warning"><i class="bi bi-hourglass-split text-warning"></i></div>
                <div>
                    <div class="stat-label">در انتظار واکنش</div>
                    <div class="stat-value num text-warning">@(labels?.lblSentToSystem ?? 0).Num()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon bg-soft-warning"><i class="bi bi-search text-warning"></i></div>
                <div>
                    <div class="stat-label">در انتظار بررسی</div>
                    <div class="stat-value num text-warning">@(labels?.lblLackOfResponsiveness ?? 0).Num()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon bg-soft-danger"><i class="bi bi-exclamation-triangle text-danger"></i></div>
                <div>
                    <div class="stat-label">دارای خطا</div>
                    <div class="stat-value num text-danger">@(labels?.lblError ?? 0).Num()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-2">
            <div class="stat-card">
                <div class="stat-icon bg-soft-success"><i class="bi bi-check-circle text-success"></i></div>
                <div>
                    <div class="stat-label">تأیید شده</div>
                    <div class="stat-value num text-success">@(labels?.lblInquiry ?? 0).Num()</div>
                </div>
            </div>
        </div>
    </div>

    @* ---------- وضعیت اتصال ---------- *@
    <div class="card mb-3">
        <div class="card-header d-flex align-items-center gap-2">
            <i class="bi bi-plug text-primary"></i> وضعیت اتصال به سامانه
            <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="TestConnection" disabled="@testing">
                @if (testing) { <span class="spinner-border spinner-border-sm"></span> }
                else { <i class="bi bi-lightning"></i> } تست اتصال
            </button>
        </div>
        <div class="card-body">
            @if (connection is null)
            {
                <div class="empty-state">
                    <i class="bi bi-unplug"></i>
                    <h5>این شرکت هنوز به سامانهٔ مودیان متصل نشده است</h5>
                    <p class="text-muted">کلید خصوصی و آدرس سرویس را در تنظیمات اتصال ثبت کنید.</p>
                    <NavLink class="btn btn-primary" href="moadian/connection"><i class="bi bi-plug"></i> شروع اتصال</NavLink>
                </div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="text-muted small">آدرس سرویس</label>
                        <div class="num" dir="ltr">@connection.WebServiceAddress</div>
                    </div>
                    <div class="col-md-4">
                        <label class="text-muted small">شناسهٔ حافظه (TaxMemoryID)</label>
                        <div class="num" dir="ltr">@connection.TaxMemoryID</div>
                    </div>
                    <div class="col-md-4">
                        <label class="text-muted small">کلید خصوصی</label>
                        <div><i class="bi bi-key text-success"></i> @connection.FilePrivatekey?.DisplayName ?? "—"</div>
                    </div>
                </div>
            }
        </div>
    </div>

    @* ---------- دسترسی سریع ---------- *@
    <div class="row g-3">
        <div class="col-6 col-lg-3">
            <NavLink class="card text-decoration-none h-100" href="moadian/invoices">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-soft-primary"><i class="bi bi-journal-text text-primary"></i></div>
                    <div>
                        <div class="fw-semibold">صورتحساب‌ها</div>
                        <div class="small text-muted">فهرست، صدور و پیگیری</div>
                    </div>
                </div>
            </NavLink>
        </div>
        <div class="col-6 col-lg-3">
            <NavLink class="card text-decoration-none h-100" href="moadian/goods">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-soft-success"><i class="bi bi-box text-success"></i></div>
                    <div>
                        <div class="fw-semibold">کالاهای من</div>
                        <div class="small text-muted">کالا/خدمت با شناسهٔ CPC</div>
                    </div>
                </div>
            </NavLink>
        </div>
        <div class="col-6 col-lg-3">
            <NavLink class="card text-decoration-none h-100" href="moadian/customers">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-soft-warning"><i class="bi bi-people text-warning"></i></div>
                    <div>
                        <div class="fw-semibold">مشتریان</div>
                        <div class="small text-muted">حقیقی و حقوقی</div>
                    </div>
                </div>
            </NavLink>
        </div>
        <div class="col-6 col-lg-3">
            <NavLink class="card text-decoration-none h-100" href="moadian/units">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="stat-icon bg-soft-danger"><i class="bi bi-rulers text-danger"></i></div>
                    <div>
                        <div class="fw-semibold">واحدهای سنجش</div>
                        <div class="small text-muted">واحدهای معتبر سامانه</div>
                    </div>
                </div>
            </NavLink>
        </div>
    </div>
}

@code {
    private InvoiceVM? labels;
    private VMConnection? connection;
    private bool loading = true, testing;

    protected override void OnInitialized()
    {
        Ctx.Changed += OnCtxChanged;
        _ = LoadAsync();
    }

    private void OnCtxChanged() => _ = LoadAsync();

    private async Task LoadAsync()
    {
        if (Ctx.CpInfoId <= 0) { loading = false; return; }
        loading = true;
        StateHasChanged();
        try
        {
            var model = await Moadian.GetAllInvoicesAsync("همه", Ctx.CpInfoId, null, null, null, 1, 1);
            var resp = MoadianService.As<InvoiceResponse>(model);
            labels = resp?.Labels;
            connection = await Moadian.GetConnectionAsync(Ctx.CpInfoId);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private async Task TestConnection()
    {
        if (connection is null) { Toast.Info("ابتدا اطلاعات اتصال را ثبت کنید."); return; }
        testing = true;
        StateHasChanged();
        try
        {
            var r = await Moadian.IsConnectAsync(new VMConnection
            {
                cpinfoid = Ctx.CpInfoId,
                TaxMemoryID = connection.TaxMemoryID,
                WebServiceAddress = connection.WebServiceAddress,
                FilePrivatekey = connection.FilePrivatekey
            });
            if (r.Success)
                Toast.Success("اتصال به سامانه مودیان برقرار است.");
            else
                Toast.Error($"تست اتصال ناموفق بود: {r.Message}");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { testing = false; }
    }

    public void Dispose() => Ctx.Changed -= OnCtxChanged;
}
