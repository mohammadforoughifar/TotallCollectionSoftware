@page "/moadian/goods"
@using Inventory.Shared.Dtos.Moadian
@inject IMoadianService Moadian
@inject IToastService Toast
@inject MoadianCompanyContext Ctx
@implements IDisposable

<PageTitle>سامانه مودیان — کالاهای من</PageTitle>

<div class="page-head">
    <div>
        <h1><i class="bi bi-box text-success"></i> کالاهای من</h1>
        <p class="lead">کالاها و خدمات با شناسهٔ CPC (مطابق لیست کالا و خدمات سازمان مالیاتی)</p>
    </div>
    <div class="ms-auto">
        <button class="btn btn-primary" @onclick="() => OpenForm(null)" disabled="@(Ctx.CpInfoId <= 0)">
            <i class="bi bi-plus-lg"></i> کالا/خدمت جدید
        </button>
    </div>
</div>

<MoadianCompanyBar />

@if (Ctx.CpInfoId > 0)
{
    <div class="card">
        <div class="card-header d-flex align-items-center gap-2">
            <span><i class="bi bi-box-seam text-success"></i> فهرست کالاها</span>
            <span class="badge badge-soft-primary num ms-auto">@(data?.TotalCount ?? 0).Num() کالا</span>
        </div>
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (items is null || items.Count == 0)
            {
                <div class="empty-state">
                    <i class="bi bi-box-seam"></i>
                    <h5>کالایی تعریف نشده است</h5>
                    <p class="text-muted">برای صدور صورتحساب، ابتدا کالا/خدمات خود را با شناسهٔ CPC ثبت کنید.</p>
                </div>
            }
            else
            {
                <div class="table-responsive grid-desktop">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>نام کالا / خدمت</th>
                                <th>شناسهٔ CPC</th>
                                <th>واحد سنجش</th>
                                <th class="text-center">ارزش افزوده</th>
                                <th class="text-center">قیمت</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in items)
                            {
                                <tr>
                                    <td class="fw-semibold">@g.Name</td>
                                    <td><code class="num" dir="ltr">@g.UniqueIdentifier</code></td>
                                    <td class="num">@g.UnitOfMeasurement</td>
                                    <td class="text-center num">@(g.ValueAddedPercentage ?? 0).Num()٪</td>
                                    <td class="text-center num">@MoadianUi.Money(g.Price)</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-primary" title="ویرایش" @onclick="() => OpenForm(g)">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if ((data?.TotalPages ?? 0) > 1)
                {
                    <div class="card-footer d-flex align-items-center gap-2">
                        <span class="text-muted small num">صفحهٔ @pno.Num() از @(data?.TotalPages).Num()</span>
                        <div class="ms-auto d-flex gap-1">
                            <button class="btn btn-sm btn-outline-secondary" disabled="@(pno <= 1)" @onclick="() => LoadAsync(pno - 1)"><i class="bi bi-chevron-right"></i></button>
                            <button class="btn btn-sm btn-outline-secondary" disabled="@(pno >= (data?.TotalPages ?? 1))" @onclick="() => LoadAsync(pno + 1)"><i class="bi bi-chevron-left"></i></button>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
}

<Modal Visible="showForm" Title="@(form.GoodsOrServicesId > 0 ? "ویرایش کالا/خدمت" : "کالا/خدمت جدید")" OnClose="CloseForm">
        <ChildContent>
    <div class="mb-2">
        <label class="form-label">نام کالا / خدمت <span class="text-danger">*</span></label>
        <input class="form-control" value="@form.Name" @oninput="e => form.Name = e.Value?.ToString()" placeholder="مثلاً: پست الکترونیکی سازمانی" />
    </div>
    <div class="row g-2">
        <div class="col-7">
            <label class="form-label">شناسهٔ CPC (۱۱ رقم) <span class="text-danger">*</span></label>
            <input class="form-control num" dir="ltr" maxlength="11" value="@form.UniqueIdentifier" @oninput="e => form.UniqueIdentifier = e.Value?.ToString()" placeholder="01010101010" />
        </div>
        <div class="col-5">
            <label class="form-label">واحد سنجش</label>
            <select class="form-select" value="@form.UnitOfMeasurementId" @onchange="OnUnit">
                <option value="0">— انتخاب —</option>
                @foreach (var u in Units)
                {
                    <option value="@u.UnitOfMeasurementId">@u.Name (@u.Code)</option>
                }
            </select>
        </div>
    </div>
    <div class="row g-2 mt-2">
        <div class="col-6">
            <label class="form-label">نرخ ارزش افزوده ٪</label>
            <input type="number" min="0" max="100" step="any" class="form-control num" value="@form.ValueAddedPercentage" @onchange="OnVat" />
        </div>
        <div class="col-6">
            <label class="form-label">قیمت واحد</label>
            <input type="number" min="0" step="any" class="form-control num" value="@form.Price" @onchange="OnPrice" />
        </div>
    </div>
    @if (!string.IsNullOrEmpty(formError))
    {
        <div class="alert alert-danger py-2 small mt-2">@formError</div>
    }
    </ChildContent>
    <Footer>
        <button class="btn btn-secondary" @onclick="CloseForm">انصراف</button>
        <button class="btn btn-primary" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-check-lg"></i> }
            @(form.GoodsOrServicesId > 0 ? "ذخیرهٔ تغییرات" : "ثبت کالا")
        </button>
    </Footer>
</Modal>

@code {
    private PagedList<VMGoodsOrService>? data;
    private List<VMGoodsOrService>? items;
    private List<VMUnitOfMeasurement> Units = new();
    private bool loading = true;
    private int pno = 1;
    private const int PageSize = 10;

    private bool showForm;
    private VMGoodsOrService form = new();
    private string? formError;
    private bool saving;

    protected override void OnInitialized()
    {
        Ctx.Changed += OnCtxChanged;
        _ = InitAsync();
    }

    private void OnCtxChanged() => _ = InitAsync();

    private async Task InitAsync()
    {
        if (Ctx.CpInfoId <= 0) { loading = false; StateHasChanged(); return; }
        loading = true; StateHasChanged();
        try
        {
            Units = await Moadian.GetUnitsComboAsync();
            await LoadAsync(1);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; StateHasChanged(); }
    }

    private async Task LoadAsync(int p)
    {
        if (Ctx.CpInfoId <= 0) return;
        loading = true; StateHasChanged();
        try
        {
            var model = await Moadian.GetGoodsAsync(Ctx.CpInfoId, null, p, PageSize);
            var paged = MoadianService.As<PagedList<VMGoodsOrService>>(model);
            data = paged;
            items = paged?.Items?.ToList();
            pno = p;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; StateHasChanged(); }
    }

    private void OpenForm(VMGoodsOrService? g)
    {
        form = g is null
            ? new VMGoodsOrService { CpInfoId = Ctx.CpInfoId, ValueAddedPercentage = 0, Price = 0 }
            : new VMGoodsOrService
            {
                GoodsOrServicesId = g.GoodsOrServicesId,
                CpInfoId = Ctx.CpInfoId,
                Name = g.Name,
                UniqueIdentifier = g.UniqueIdentifier,
                UnitOfMeasurementId = g.UnitOfMeasurementId,
                UnitOfMeasurement = g.UnitOfMeasurement,
                ValueAddedPercentage = g.ValueAddedPercentage,
                Price = g.Price
            };
        formError = null;
        showForm = true;
    }

    private void CloseForm() { showForm = false; }

    private void OnUnit(ChangeEventArgs e)
    {
        form.UnitOfMeasurementId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        form.UnitOfMeasurement = Units.FirstOrDefault(u => u.UnitOfMeasurementId == form.UnitOfMeasurementId)?.Name;
    }

    private void OnVat(ChangeEventArgs e)
        => form.ValueAddedPercentage = decimal.TryParse(e.Value?.ToString(), out var v) ? (double)v : 0;

    private void OnPrice(ChangeEventArgs e)
        => form.Price = decimal.TryParse(e.Value?.ToString(), out var v) ? v : 0;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Name)) { formError = "نام کالا الزامی است."; return; }
        if (string.IsNullOrWhiteSpace(form.UniqueIdentifier)) { formError = "شناسهٔ CPC الزامی است."; return; }
        if (!string.IsNullOrEmpty(form.UniqueIdentifier) && form.UniqueIdentifier.Length != 11)
        { formError = "شناسهٔ CPC باید ۱۱ رقم باشد."; return; }
        if (form.Price <= 0) { formError = "قیمت واحد باید بیشتر از صفر باشد."; return; }

        saving = true; StateHasChanged();
        try
        {
            var r = form.GoodsOrServicesId > 0
                ? await Moadian.UpdateGoodAsync(form)
                : await Moadian.InsertGoodAsync(form);
            if (r.Success)
            {
                Toast.Success(form.GoodsOrServicesId > 0 ? "تغییرات ذخیره شد." : "کالا ثبت شد.");
                CloseForm();
                await LoadAsync(pno);
            }
            else formError = r.Message ?? "خطا در ذخیره.";
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { saving = false; StateHasChanged(); }
    }

    public void Dispose() => Ctx.Changed -= OnCtxChanged;
}
