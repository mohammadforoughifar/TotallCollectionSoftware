@page "/moadian/invoices/{Id:int}"
@using Inventory.Shared.Dtos.Moadian
@using InvoiceVM = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.InvoiceVM
@using ErroreMesage = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.ErroreMesage
@inject IMoadianService Moadian
@inject IToastService Toast
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>سامانه مودیان — جزئیات صورتحساب</PageTitle>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (vm is null)
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-question-circle"></i>
            <h5>جزئیات صورتحساب بارگذاری نشد</h5>
            <p class="text-muted mb-3">شناسهٔ درخواستی: <b class="num">@Id</b></p>
            @if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="alert alert-warning text-start" dir="rtl">@loadError</div>
            }
            else
            {
                <p class="text-muted">صورتحساب با این شناسه یافت نشد.</p>
            }
            <NavLink class="btn btn-primary" href="moadian/invoices">بازگشت به فهرست</NavLink>
        </div>
    </div></div>
}
else
{
    <div class="invoice-screen mi-detail">
    @* ---------- سربرگ صورتحساب (عنوان + اطلاعات کلیدی + عملیات) ---------- *@
    <header class="mi-d-head no-print">
        <div class="mi-d-top">
            <div class="mi-d-titlebox">
                <div class="mi-d-tags">
                    <span class="badge @MoadianUi.SubjectBadge(vm.Subject)">@vm.Subject</span>
                    <span class="mi-status @MoadianUi.StatusPillClass(vm.StatusSentToSystemInt)"><span class="mi-dot" aria-hidden="true"></span>@MoadianUi.StatusLabel(vm.StatusSentToSystemInt)</span>
                </div>
                <h1 class="mi-d-title">
                    <span class="cap">صورتحساب</span>
                    <span class="no num">#@(vm.Id.NoGroup())</span>
                </h1>
                <div class="mi-d-meta">
                    <span><i class="bi bi-calendar3" aria-hidden="true"></i><b class="num">@MoadianUi.Shamsi(vm.DateOrder)</b></span>
                    <span><i class="bi bi-person" aria-hidden="true"></i>@vm.CustomerName</span>
                    <span><i class="bi bi-cash-coin" aria-hidden="true"></i>@vm.PaymentType</span>
                    <span><i class="bi bi-wallet2" aria-hidden="true"></i><b class="num">@MoadianUi.Money(GrandTotal)</b> ریال</span>
                </div>
            </div>
            @* دکمه‌ها عمداً در پایان‌خط قرار می‌گیرند تا در چیدمان راست‌به‌چپ، سمت چپ صفحه دیده شوند. *@
            <div class="mi-d-actions">
                <NavLink class="btn btn-light" href="moadian/invoices"><i class="bi bi-arrow-right" aria-hidden="true"></i> فهرست</NavLink>
                <button type="button" class="btn btn-primary" @onclick="Print"><i class="bi bi-printer" aria-hidden="true"></i> چاپ</button>
            </div>
        </div>
        <div class="mi-d-ops">
            @if (MoadianUi.CanSend(vm.StatusSentToSystemInt, vm.ShowButtons))
            {
                @* پیش‌نمایش برای ارسال‌نشده (۰) و خطای قطعی (۵) فعال است — همان دو وضعیتی که
                   «ارسال/ارسال مجدد» و سرور اجازه می‌دهند؛ کاربر برای رفع خطای سامانه نیاز دارد
                   JSON ارسال‌مجدد را ببیند. *@
                @if (CanPreview && vm.StatusSentToSystemInt is "0" or "5")
                {
                    <button class="btn btn-outline-primary" @onclick="PreviewPayload" disabled="@acting">
                        <i class="bi bi-braces"></i> پیش‌نمایش JSON
                    </button>
                }
                @if (CanSend)
                {
                    <button class="btn btn-primary" @onclick="Send" disabled="@acting">
                        @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-send"></i> }
                        @(vm.StatusSentToSystemInt == "5" ? "ارسال مجدد به سامانه" : "ارسال به سامانه")
                    </button>
                }
            }
            @if (CanInquiry && MoadianUi.CanInquiry(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <button class="btn btn-outline-primary" @onclick="Estelam" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-search"></i> }
                    استعلام وضعیت
                </button>
            }
            @if (CanInquiry && MoadianUi.CanShowErrors(vm.StatusSentToSystemInt))
            {
                <button class="btn btn-outline-danger" @onclick="ShowError" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-exclamation-octagon"></i> }
                    مشاهده خطاها
                </button>
            }
            @if (CanInquiry && MoadianUi.CanViewWorkFolder(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <a class="btn btn-outline-info" href="@MoadianUi.WorkFolderUrl" target="_blank" rel="noopener">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i> مشاهده در کارپوشه
                </a>
            }
            @* ثبت دستی واکنش خریدار: فقط روی اسناد منتظر واکنش در کارپوشه (۲/۳/۴) — SDK فعلی واکنش‌ها را برنمی‌گرداند *@
            @if (CanUpdate && MoadianUi.CanReactManually(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <button class="btn btn-warning" @onclick="() => reactOpen = true" disabled="@acting">
                    <i class="bi bi-person-check"></i> ثبت وضعیت خریدار
                </button>
            }
            @if (CanUpdate && MoadianUi.CanReference(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <NavLink class="btn btn-outline-warning" href="@($"moadian/invoices/{vm.Id}/eslahi")"><i class="bi bi-pencil"></i> اصلاحی</NavLink>
            }
            @if (CanUpdate && MoadianUi.CanEbtal(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <button class="btn btn-outline-danger" @onclick="Ebtal" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-x-octagon"></i> }
                    ابطال
                </button>
            }
            @if (CanDelete && MoadianUi.CanDelete(vm.StatusSentToSystemInt, vm.ShowButtons))
            {
                <button class="btn btn-outline-secondary mi-push-end" @onclick="Delete" disabled="@acting">
                    <i class="bi bi-trash"></i> حذف
                </button>
            }
            @if (vm.ShowButtons == false)
            {
                <span class="text-muted small align-self-center">این صورتحساب (مثلاً ابطالی) قابل ویرایش و عملیات نیست.</span>
            }
        </div>
    </header>

    @* ---------- مودال ثبت دستی وضعیت واکنش خریدار ---------- *@
    @if (reactOpen)
    {
        <div class="modal d-block mi-modal" tabindex="-1" style="background:rgba(15,23,42,.45)" @onclick="() => { if (!acting) reactOpen = false; }">
            <div class="modal-dialog modal-dialog-centered" @onclick:stopPropagation="true">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title"><i class="bi bi-person-check text-warning"></i> ثبت وضعیت خریدار</h5>
                        <button type="button" class="btn-close" @onclick="() => reactOpen = false" aria-label="بستن"></button>
                    </div>
                    <div class="modal-body">
                        <p class="fs-8 text-muted mb-2">
                            وضعیت فعلی: <span class="badge @MoadianUi.StatusBadge(vm.StatusSentToSystemInt)">@MoadianUi.StatusLabel(vm.StatusSentToSystemInt)</span>
                        </p>
                        <p class="fs-8 text-muted">
                            واکنش «پایانی» است — پس از ثبت، دیگر قابل تغییر نیست.
                            نسخهٔ فعلی SDK واکنش‌های خریدار را در استعلام برنمی‌گرداند؛ این وضعیت را
                            بعد از مشاهده در کارپوشه دستی ثبت کنید.
                        </p>
                        @if (vm.Subject == "اصلاحی")
                        {
                            <div class="alert alert-warning fs-8 py-2 mb-2">
                                این سند «اصلاحی» است: اگر تأیید یا تأیید سیستمی شود، صورتحساب اصلی به‌طور خودکار «اصلاحی (۱۰)» می‌شود و قفل خواهد شد. اگر رد شود، اصلی زنده می‌ماند.
                            </div>
                        }
                        else
                        {
                            <div class="alert alert-info fs-8 py-2 mb-2">
                                تأیید سیستمی = خریدار واکنش نشان نداده و سامانه پس از ۳۰ روز خودکار سند را تأیید می‌کند.
                            </div>
                        }
                    </div>
                    <div class="modal-footer d-flex gap-2 flex-wrap">
                        <button type="button" class="btn btn-success" disabled="@acting" @onclick='() => SubmitReact("7")'>
                            @if (acting && reactTarget == "7") { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-check2-circle"></i> }
                            تأیید شده (خریدار)
                        </button>
                        <button type="button" class="btn btn-danger" disabled="@acting" @onclick='() => SubmitReact("8")'>
                            @if (acting && reactTarget == "8") { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-x-octagon"></i> }
                            رد شده (خریدار)
                        </button>
                        <button type="button" class="btn btn-primary" disabled="@acting" @onclick='() => SubmitReact("11")'>
                            @if (acting && reactTarget == "11") { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-clock-history"></i> }
                            تأیید سیستمی (۳۰ روزه)
                        </button>
                    </div>
                </div>
            </div>
        </div>
    }

    @* ---------- نتیجه استعلام / خطا ---------- *@
    @if (ActionResult != null)
    {
        <div class="alert no-print @(ActionIsError ? "alert-danger" : "alert-info") d-flex align-items-start gap-2">
            <i class="bi @(ActionIsError ? "bi-exclamation-triangle" : "bi-info-circle")"></i>
            <div>
                <div class="fw-semibold">@(ActionIsError ? "جزئیات خطای صورتحساب" : "نتیجهٔ استعلام")</div>
                <div>@ActionResult</div>
                @if (ErrorItem_ != null)
                {
                    <div class="num small mt-1" dir="ltr">code: @ErrorItem_.code</div>
                }
            </div>
            <button type="button" class="btn-close ms-auto" @onclick="() => { ActionResult = null; ErrorItem_ = null; }"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(PreviewRequestJson) || !string.IsNullOrWhiteSpace(ActualRequestJson) || !string.IsNullOrWhiteSpace(SdkResponseJson))
    {
        <div class="card mi-blocked mb-3 no-print">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-braces"></i> JSON صورتحساب
                <span class="small text-muted ms-auto">نمایش DTO پیش از بسته‌بندی/امضا/رمزگذاری SDK</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(PreviewRequestJson))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <strong>پیش از ارسال — پیش‌نمایش</strong>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => CopyText(PreviewRequestJson)"><i class="bi bi-clipboard"></i> کپی</button>
                    </div>
                    <pre class="mi-code" dir="ltr">@PreviewRequestJson</pre>
                }
                @if (!string.IsNullOrWhiteSpace(ActualRequestJson))
                {
                    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
                        <strong>پس از ارسال — درخواست واقعی ساخته‌شده</strong>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => CopyText(ActualRequestJson)"><i class="bi bi-clipboard"></i> کپی</button>
                    </div>
                    <pre class="mi-code" dir="ltr">@ActualRequestJson</pre>
                }
                @if (!string.IsNullOrWhiteSpace(SdkResponseJson))
                {
                    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
                        <strong>پاسخ SDK/سامانه</strong>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => CopyText(SdkResponseJson)"><i class="bi bi-clipboard"></i> کپی</button>
                    </div>
                    <pre class="mi-code" dir="ltr">@SdkResponseJson</pre>
                }
                <div class="alert alert-warning small mb-0">این JSON حاوی شناسه‌های مالیاتی و اطلاعات خریدار/فروشنده است؛ آن را عمومی منتشر نکنید. زمان/TaxID در پیش‌نمایش ممکن است با درخواست واقعیِ بعدی متفاوت باشد.</div>
            </div>
        </div>
    }

    <div class="row g-3">
        @* ---------- ردیف‌ها (محتوای اصلی — ستون عریض‌تر) ---------- *@
        <div class="col-lg-8">
            <section class="mi-panel">
                <div class="mi-panel-head">
                    <i class="bi bi-list-ol" aria-hidden="true"></i> ردیف‌های صورتحساب
                    <span class="mi-count num">@((vm.InvoiceItems.Count).Num()) ردیف</span>
                </div>
                <div class="table-responsive mi-table">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width:56px">ردیف</th>
                                <th>کالا / خدمت</th>
                                <th class="mi-col-optional" style="width:76px">واحد</th>
                                <th class="text-center">تعداد</th>
                                <th class="text-center mi-col-optional">نرخ</th>
                                <th class="text-center mi-col-optional">ارزش افزوده</th>
                                <th class="text-center mi-col-optional">تخفیف</th>
                                <th class="text-center">مبلغ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int ii = 0; ii < vm.InvoiceItems.Count; ii++)
                            {
                                var it = vm.InvoiceItems[ii];
                                <tr>
                                    <td><span class="mi-rowno num">@MoadianUi.Num(ii + 1)</span></td>
                                    <td>
                                        <div class="mi-item-name">@it.Name</div>
                                        @if (!string.IsNullOrEmpty(it.UniqueIdentifier))
                                        {
                                            <div class="mi-item-code num" dir="ltr">@it.UniqueIdentifier</div>
                                        }
                                    </td>
                                    <td class="small num mi-col-optional">@it.UnitOfMeasurement</td>
                                    <td class="text-center num">@((it.Count ?? 0).Qty())</td>
                                    <td class="text-center num mi-col-optional">@MoadianUi.Money(it.PriceUnit)</td>
                                    <td class="text-center num text-info mi-col-optional">@(((decimal)(it.ValueAddedPercentage ?? 0)).Qty())٪</td>
                                    <td class="text-center num mi-col-optional">@MoadianUi.Money(it.Discount)</td>
                                    <td class="text-center num mi-amount">@MoadianUi.Money(it.CalculatedPay)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="mi-moneyfoot num">
                    <span class="lbl">جمع کل صورتحساب</span>
                    <span class="amt">@MoadianUi.Money(GrandTotal) <small>ریال</small></span>
                </div>
            </section>
        </div>

        @* ---------- ستون کناری: مشتری + اطلاعات صورتحساب ---------- *@
        <div class="col-lg-4 d-flex flex-column gap-3">

            @* اطلاعات کامل مشتری (نام، نوع، شناسهٔ ملی/ثبت، شمارهٔ اقتصادی، تماس، نشانی) *@
            <section class="mi-panel">
                <div class="mi-panel-head"><i class="bi bi-person-vcard" aria-hidden="true"></i> اطلاعات مشتری</div>
                <div class="mi-customer">
                    <div class="mi-customer-id">
                        <div class="mi-avatar" aria-hidden="true"><i class="bi bi-person"></i></div>
                        <div class="mi-customer-main">
                            <div class="mi-customer-name">@(string.IsNullOrWhiteSpace(vm.CustomerName) ? "مشتری ثبت نشده" : vm.CustomerName)</div>
                            @if (!string.IsNullOrWhiteSpace(vm.CustomerType))
                            {
                                <span class="mi-type-badge @(vm.CustomerType == "حقوقی" ? "legal" : "real")">@vm.CustomerType</span>
                            }
                        </div>
                    </div>

                    <div class="mi-kv mi-kv-tight">
                        @if (!string.IsNullOrWhiteSpace(vm.CustomerNationalId))
                        {
                            <div class="mi-kv-row">
                                <span class="mi-kv-lbl"><i class="bi bi-person-badge" aria-hidden="true"></i> @(vm.CustomerType == "حقوقی" ? "شمارهٔ ثبت" : "کد ملی")</span>
                                <div class="mi-codechip" title="کپی" @onclick="() => CopyText(vm.CustomerNationalId!)">
                                    <i class="bi bi-clipboard" aria-hidden="true"></i><span>@vm.CustomerNationalId</span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(vm.CustomerEconomicNumber))
                        {
                            <div class="mi-kv-row">
                                <span class="mi-kv-lbl"><i class="bi bi-hash" aria-hidden="true"></i> شمارهٔ اقتصادی</span>
                                <div class="mi-codechip" title="کپی" @onclick="() => CopyText(vm.CustomerEconomicNumber!)">
                                    <i class="bi bi-clipboard" aria-hidden="true"></i><span>@vm.CustomerEconomicNumber</span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(vm.CustomerPhone))
                        {
                            <div class="mi-kv-row">
                                <span class="mi-kv-lbl"><i class="bi bi-telephone" aria-hidden="true"></i> تلفن</span>
                                <a class="mi-kv-val mi-link num" href="tel:@vm.CustomerPhone" dir="ltr">@vm.CustomerPhone</a>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(vm.CustomerPostalCode))
                        {
                            <div class="mi-kv-row">
                                <span class="mi-kv-lbl"><i class="bi bi-mailbox" aria-hidden="true"></i> کد پستی</span>
                                <span class="mi-kv-val num" dir="ltr">@vm.CustomerPostalCode</span>
                            </div>
                        }
                        @if (!string.IsNullOrWhiteSpace(vm.CustomerAddress))
                        {
                            <div class="mi-kv-row wrap-row">
                                <span class="mi-kv-lbl"><i class="bi bi-geo-alt" aria-hidden="true"></i> نشانی</span>
                                <span class="mi-kv-val soft">@vm.CustomerAddress</span>
                            </div>
                        }
                    </div>
                </div>
            </section>

            @* اطلاعات صورتحساب — فقط موارد لازم برای عملیات؛ شمارهٔ مالیاتی و شناسهٔ حافظه عمداً نمایش داده نمی‌شوند. *@
            <section class="mi-panel">
                <div class="mi-panel-head"><i class="bi bi-info-circle" aria-hidden="true"></i> اطلاعات صورتحساب</div>
                <div class="mi-kv">
                    <div class="mi-kv-row">
                        <span class="mi-kv-lbl"><i class="bi bi-tags" aria-hidden="true"></i> نوع صورتحساب</span>
                        <span class="mi-kv-val">@(string.IsNullOrWhiteSpace(vm.TypePattern) ? "—" : vm.TypePattern)</span>
                    </div>
                    <div class="mi-kv-row">
                        <span class="mi-kv-lbl"><i class="bi bi-credit-card" aria-hidden="true"></i> نوع پرداخت</span>
                        <span class="mi-kv-val">@(string.IsNullOrWhiteSpace(vm.PaymentType) ? "—" : vm.PaymentType)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(vm.Description))
                    {
                        <div class="mi-kv-row">
                            <span class="mi-kv-lbl"><i class="bi bi-text-left" aria-hidden="true"></i> شرح</span>
                            <span class="mi-kv-val soft">@vm.Description</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(vm.ReferenceId))
                    {
                        <div class="mi-kv-row">
                            <span class="mi-kv-lbl"><i class="bi bi-link-45deg" aria-hidden="true"></i> شمارهٔ مرجع (ReferenceID)</span>
                            <div class="mi-codechip" title="کپی شمارهٔ مرجع" @onclick="() => CopyText(vm.ReferenceId!)">
                                <i class="bi bi-clipboard" aria-hidden="true"></i><span>@vm.ReferenceId</span>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </div>
    </div>
    </div>

    <div class="moadian-print" lang="fa" dir="rtl">
        <article class="mprint-sheet">
            <header class="mprint-official-head">
                <div class="mprint-head-side mprint-head-serial">
                    <div><span>سریال صورتحساب:</span><b class="num" dir="ltr">@Text(vm.Serial)</b></div>
                    <div><span>تاریخ صدور:</span><b class="num">@MoadianUi.Shamsi(vm.DateOrder)</b></div>
                </div>
                <div class="mprint-document-title">صورت حساب الکترونیکی</div>
                <div class="mprint-head-side mprint-head-number">
                    <div><span>شماره فاکتور:</span><b class="num">@(vm.NumberInvoice?.NoGroup() ?? vm.Id.NoGroup())</b></div>
                    <div><span>شماره منحصر به‌فرد مالیاتی:</span><b class="num" dir="ltr">@Text(vm.NewTaxNumber ?? vm.TaxNumber)</b></div>
                    <div><span>شناسه یکتای حافظه مالیاتی:</span><b class="num" dir="ltr">@Text(vm.TaxMemoryID)</b></div>
                </div>
            </header>

            <section class="mprint-party-section">
                <h2>مشخصات فروشنده</h2>
                <table class="mprint-party-table" aria-label="مشخصات فروشنده">
                    <tbody>
                        <tr>
                            <td><span>نام / نام تجاری:</span><b>@Text(seller?.PersianName)</b></td>
                            <td><span>شناسه ملی / شماره اقتصادی:</span><b class="num" dir="ltr">@Text(SellerTaxIdentity)</b></td>
                        </tr>
                        <tr>
                            <td><span>نوع شخص:</span><b>@Text(seller?.Type)</b></td>
                            <td><span>کد پستی:</span><b class="num" dir="ltr">@Text(seller?.PostalCode)</b></td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="mprint-party-section">
                <h2>مشخصات خریدار</h2>
                <table class="mprint-party-table" aria-label="مشخصات خریدار">
                    <tbody>
                        <tr>
                            <td><span>نام / نام تجاری:</span><b>@Text(buyer?.Name ?? vm.CustomerName)</b></td>
                            <td><span>شناسه ملی / شماره اقتصادی:</span><b class="num" dir="ltr">@Text(BuyerTaxIdentity)</b></td>
                        </tr>
                        <tr>
                            <td><span>نوع شخص:</span><b>@Text(buyer?.Type)</b></td>
                            <td><span>کد پستی:</span><b class="num" dir="ltr">@Text(buyer?.PostalCode)</b></td>
                        </tr>
                    </tbody>
                </table>
            </section>

            <section class="mprint-lines-section">
                <h2>مشخصات کالا و خدمات مورد معامله</h2>
                <table class="mprint-lines-table">
                    <colgroup>
                        <col class="pl-no" /><col class="pl-code" /><col class="pl-name" /><col class="pl-unit" />
                        <col class="pl-qty" /><col class="pl-money" /><col class="pl-money" /><col class="pl-money" />
                        <col class="pl-money" /><col class="pl-rate" /><col class="pl-money" /><col class="pl-money" />
                    </colgroup>
                    <thead>
                        @* این ردیف با table-header-group در تمام صفحه‌های بعدی هم تکرار می‌شود. *@
                        <tr class="mprint-continuation-head">
                            <th colspan="12">
                                <span>صورت حساب الکترونیکی</span>
                                <span>شماره فاکتور: <b class="num">@(vm.NumberInvoice?.NoGroup() ?? vm.Id.NoGroup())</b></span>
                                <span>شماره مالیاتی: <b class="num" dir="ltr">@Text(vm.NewTaxNumber ?? vm.TaxNumber)</b></span>
                                <span>خریدار: <b>@Text(buyer?.Name ?? vm.CustomerName)</b></span>
                                <span>تاریخ: <b class="num">@MoadianUi.Shamsi(vm.DateOrder)</b></span>
                            </th>
                        </tr>
                        <tr>
                            <th>ردیف</th>
                            <th>شناسه کالا/خدمت</th>
                            <th>شرح کالا یا خدمت</th>
                            <th>واحد</th>
                            <th>تعداد</th>
                            <th>مبلغ واحد<br />(ریال)</th>
                            <th>مبلغ قبل از تخفیف<br />(ریال)</th>
                            <th>مبلغ تخفیف<br />(ریال)</th>
                            <th>مبلغ بعد از تخفیف<br />(ریال)</th>
                            <th>نرخ مالیات<br />(٪)</th>
                            <th>مالیات و عوارض<br />(ریال)</th>
                            <th>جمع کل ردیف<br />(ریال)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < vm.InvoiceItems.Count; i++)
                        {
                            var item = vm.InvoiceItems[i];
                            <tr>
                                <td class="num mprint-plain-number">@((i + 1).Num())</td>
                                <td class="num mprint-plain-number" dir="ltr">@Text(item.UniqueIdentifier)</td>
                                <td class="mprint-line-name">@Text(item.Name ?? item.DescriptionKala)</td>
                                <td>@Text(item.UnitOfMeasurement)</td>
                                <td class="num mprint-plain-number">@((item.Count ?? 0).Qty())</td>
                                <td class="num mprint-plain-number">@MoadianUi.Money(item.PriceUnit)</td>
                                <td class="num mprint-plain-number">@MoadianUi.Money(LineGross(item))</td>
                                <td class="num mprint-plain-number">@MoadianUi.Money(item.Discount)</td>
                                <td class="num mprint-plain-number">@MoadianUi.Money(LineNet(item))</td>
                                <td class="num mprint-plain-number">@(((decimal)(item.ValueAddedPercentage ?? 0)).Qty())</td>
                                <td class="num mprint-plain-number">@MoadianUi.Money(LineVat(item))</td>
                                <td class="num mprint-plain-number mprint-line-total">@MoadianUi.Money(LineTotal(item))</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="6">جمع</th>
                            <th class="num">@MoadianUi.Money(TotalGross)</th>
                            <th class="num">@MoadianUi.Money(TotalDiscount)</th>
                            <th class="num">@MoadianUi.Money(TotalNet)</th>
                            <th>—</th>
                            <th class="num">@MoadianUi.Money(TotalVat)</th>
                            <th class="num">@MoadianUi.Money(GrandTotal)</th>
                        </tr>
                    </tfoot>
                </table>
            </section>

            <section class="mprint-payment-section">
                @* اگر جمع‌ها به صفحهٔ آخر منتقل شوند، شمارهٔ سند و خریدار همراه آن‌ها چاپ می‌شود. *@
                <div class="mprint-final-reference">
                    <span>شماره فاکتور: <b class="num">@(vm.NumberInvoice?.NoGroup() ?? vm.Id.NoGroup())</b></span>
                    <span>شماره مالیاتی: <b class="num" dir="ltr">@Text(vm.NewTaxNumber ?? vm.TaxNumber)</b></span>
                    <span>خریدار: <b>@Text(buyer?.Name ?? vm.CustomerName)</b></span>
                </div>
                <div class="mprint-payment-content">
                    <div class="mprint-payment-box">
                        <div><span>نوع صورتحساب:</span><b>@Text(vm.TypePattern)</b></div>
                        <div><span>روش تسویه:</span><b>@Text(vm.PaymentType)</b></div>
                        <div><span>موضوع صورتحساب:</span><b>@Text(vm.Subject)</b></div>
                    </div>
                    <div class="mprint-grand-total">
                        <span>جمع کل صورتحساب</span>
                        <strong class="num">@MoadianUi.Money(GrandTotal) <small>ریال</small></strong>
                    </div>
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(vm.Description))
            {
                <div class="mprint-description"><b>توضیحات:</b><span>@vm.Description</span></div>
            }

            <footer class="mprint-footer">
                <div class="mprint-signatures">
                    <div><span>روش تسویه (اختیاری / نقدی):</span><b>@Text(vm.PaymentType)</b></div>
                    <div class="mprint-signature-cell">مهر و امضای فروشنده</div>
                </div>
                <p>این صورتحساب توسط نرم‌افزار یکپارچه فروغ آریا صادر شده است.</p>
            </footer>
        </article>
    </div>
}

<style>
    .moadian-print { display:none; }
    /* برگهٔ رسمی A4 افقی؛ margin صفر باعث حذف سربرگ و پابرگ مرورگر می‌شود. */
    @@page { size: A4 landscape; margin: 0; }
    @@media print {
        body:has(.moadian-print) * { visibility:hidden !important; }
        body:has(.moadian-print) .moadian-print,
        body:has(.moadian-print) .moadian-print * { visibility:visible !important; }
        body:has(.moadian-print) .invoice-screen { display:none !important; }
        body:has(.moadian-print) .moadian-print {
            display:block !important; position:static !important; inset:auto !important;
            width:100% !important; color:#111 !important; background:#fff !important;
            /* فونت Yekan.woff2 در wwwroot/fonts و در app.css با نام «Yekan» ثبت شده است. */
            font-family:'Yekan', Tahoma, Arial, sans-serif; font-size:6.8pt; line-height:1.25;
            direction:rtl; padding:4mm; box-sizing:border-box; -webkit-print-color-adjust:exact; print-color-adjust:exact;
        }
        /* ارتفاع اجباری نگذارید؛ با این کار محتوای کوتاه به‌دلیل فقط چند میلی‌متر اضافه، صفحهٔ دوم نمی‌سازد. */
        .mprint-sheet { border:1.25px solid #202020; padding:3mm 4mm 2mm; box-sizing:border-box; }
        .mprint-official-head { display:grid; grid-template-columns:28% 1fr 38%; align-items:start; min-height:16mm; }
        .mprint-document-title { padding-top:6mm; text-align:center; font-size:12pt; font-weight:800; color:#374151; white-space:nowrap; }
        .mprint-head-side { font-size:6.3pt; line-height:1.55; }
        .mprint-head-side > div { white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .mprint-head-side span { margin-left:2px; font-weight:600; }
        .mprint-head-serial { padding-top:3mm; text-align:left; direction:rtl; }
        .mprint-head-number { padding-top:2mm; text-align:right; }
        .mprint-head-number b { font-size:6.1pt; }
        .mprint-party-section { margin-top:1mm; }
        .mprint-party-section h2, .mprint-lines-section h2 { margin:0; text-align:center; font-size:6.8pt; font-weight:800; line-height:1.4; }
        .mprint-party-table, .mprint-lines-table { width:100%; border-collapse:collapse; table-layout:fixed; }
        .mprint-party-table { border:1px solid #252525; }
        .mprint-party-table td { width:50%; border:1px solid #252525; padding:.85mm 1.4mm; text-align:right; vertical-align:middle; }
        .mprint-party-table span { color:#333; margin-left:2px; }
        .mprint-party-table b { font-weight:700; }
        .mprint-lines-section { margin-top:1.1mm; }
        .mprint-lines-table { border:1px solid #252525; }
        /* مرورگر این بخش را در ابتدای هر صفحهٔ ادامه‌دار چاپ می‌کند. */
        .mprint-lines-table thead { display:table-header-group; }
        /* جمع نهایی فقط بعد از آخرین ردیف باشد، نه پایین هر صفحهٔ ادامه‌دار. */
        .mprint-lines-table tfoot { display:table-row-group; }
        .mprint-lines-table tr { break-inside:avoid; page-break-inside:avoid; }
        .mprint-lines-table th, .mprint-lines-table td { border:1px solid #252525; padding:.65mm .45mm; text-align:center; vertical-align:middle; overflow-wrap:anywhere; }
        .mprint-lines-table th { background:#f0f0f0 !important; font-weight:800; line-height:1.15; }
        .mprint-lines-table thead th { font-size:5.9pt; }
        .mprint-lines-table tbody td { font-size:6pt; line-height:1.15; }
        .mprint-lines-table tfoot th { background:#f6f6f6 !important; font-size:6.1pt; }
        .mprint-continuation-head th { background:#fff !important; text-align:right; padding:.75mm 1.2mm; font-size:5.9pt !important; }
        .mprint-continuation-head span { margin-left:4mm; white-space:nowrap; }
        /* مقادیر عددی و شناسه‌ها به شکل متن ساده داخل ستون می‌مانند، نه چیپ/باکس مستقل. */
        .mprint-lines-table tbody td.mprint-plain-number { background:transparent !important; border-left-color:transparent; border-right-color:transparent; }
        .mprint-lines-table .mprint-line-name { text-align:right; padding-right:.9mm; }
        .mprint-lines-table .mprint-line-total { font-weight:800; }
        .pl-no { width:3%; } .pl-code { width:9%; } .pl-name { width:17%; } .pl-unit { width:5%; }
        .pl-qty { width:5%; } .pl-money { width:9%; } .pl-rate { width:7%; }
        .mprint-payment-section { margin-top:1.2mm; break-inside:avoid; page-break-inside:avoid; }
        .mprint-final-reference { display:flex; gap:4mm; align-items:center; padding:.7mm 1.3mm; border:1px solid #252525; border-bottom:0; font-size:5.9pt; }
        .mprint-final-reference span { white-space:nowrap; }
        .mprint-payment-content { display:grid; grid-template-columns:1fr 31%; gap:1.5mm; }
        .mprint-payment-box { min-height:9mm; border:1px solid #252525; display:grid; grid-template-columns:repeat(3, 1fr); align-items:center; }
        .mprint-payment-box > div { padding:.8mm 1.3mm; border-left:1px solid #252525; min-width:0; }
        .mprint-payment-box > div:last-child { border-left:0; }
        .mprint-payment-box span { color:#333; margin-left:2px; }
        .mprint-grand-total { border:1.5px solid #151515; display:flex; flex-direction:column; justify-content:center; align-items:center; text-align:center; padding:.7mm 1.4mm; }
        .mprint-grand-total span { font-size:7pt; font-weight:800; }
        .mprint-grand-total strong { margin-top:.3mm; font-size:8.5pt; }
        .mprint-grand-total small { font-size:5.7pt; }
        .mprint-description { min-height:5mm; border:1px solid #252525; display:flex; gap:3px; align-items:flex-start; padding:.8mm 1.3mm; margin-top:1.2mm; }
        .mprint-description b { white-space:nowrap; }
        .mprint-footer { margin-top:1.2mm; break-inside:avoid; page-break-inside:avoid; }
        .mprint-signatures { width:42%; min-height:13mm; border:1px solid #252525; display:grid; grid-template-columns:1fr 1fr; }
        .mprint-signatures > div { padding:.9mm 1.3mm; border-left:1px solid #252525; }
        .mprint-signatures > div:last-child { border-left:0; }
        .mprint-signature-cell { display:flex; justify-content:center; align-items:flex-start; text-align:center; font-weight:700; }
        .mprint-footer p { margin:1.1mm 0 0; text-align:center; font-size:5.7pt; color:#3f3f46; }
        .num { font-variant-numeric:tabular-nums; }
