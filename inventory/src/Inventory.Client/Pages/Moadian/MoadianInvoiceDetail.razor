@page "/moadian/invoices/{Id:int}"
@using Inventory.Shared.Dtos.Moadian
@using InvoiceVM = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.InvoiceVM
@using ErroreMesage = Inventory.Shared.Dtos.Moadian.VmInvoiceItems.ErroreMesage
@inject IMoadianService Moadian
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>سامانه مودیان — جزئیات صورتحساب</PageTitle>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (vm is null)
{
    <div class="card"><div class="card-body">
        <div class="empty-state">
            <i class="bi bi-question-circle"></i>
            <h5>جزئیات صورتحساب بارگذاری نشد</h5>
            <p class="text-muted mb-3">شناسهٔ درخواستی: <b class="num">@Id</b></p>
            @if (!string.IsNullOrWhiteSpace(loadError))
            {
                <div class="alert alert-warning text-start" dir="rtl">@loadError</div>
            }
            else
            {
                <p class="text-muted">صورتحساب با این شناسه یافت نشد.</p>
            }
            <NavLink class="btn btn-primary" href="moadian/invoices">بازگشت به فهرست</NavLink>
        </div>
    </div></div>
}
else
{
    <div class="invoice-screen">
    @* ---------- سربرگ صورتحساب (اطلاعات + عملیات در یک کارت) ---------- *@
    <div class="card mi-hero mb-3 no-print">
        <div class="card-body">
            <div class="d-flex align-items-start gap-3 flex-wrap">
                <div class="mi-hero-icon" aria-hidden="true"><i class="bi bi-receipt"></i></div>
                <div class="mi-hero-main">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <span class="mi-hero-title">صورتحساب #@(vm.Id.Num())</span>
                        <span class="mi-status @MoadianUi.StatusPillClass(vm.StatusSentToSystemInt)"><span class="mi-dot" aria-hidden="true"></span>@MoadianUi.StatusLabel(vm.StatusSentToSystemInt)</span>
                        <span class="badge @MoadianUi.SubjectBadge(vm.Subject)">@vm.Subject</span>
                    </div>
                    <div class="mi-meta mt-2">
                        <span><i class="bi bi-calendar3" aria-hidden="true"></i>تاریخ: <b class="num">@MoadianUi.Shamsi(vm.DateOrder)</b></span>
                        <span><i class="bi bi-person" aria-hidden="true"></i>مشتری: <b>@vm.CustomerName</b></span>
                        <span><i class="bi bi-cash-coin" aria-hidden="true"></i>پرداخت: <b>@vm.PaymentType</b></span>
                        <span><i class="bi bi-wallet2" aria-hidden="true"></i>مجموع: <b class="num">@MoadianUi.Money(GrandTotal)</b></span>
                    </div>
                </div>
                <div class="d-flex gap-2 ms-auto flex-wrap">
                    <NavLink class="btn btn-outline-secondary" href="moadian/invoices"><i class="bi bi-arrow-right" aria-hidden="true"></i> فهرست</NavLink>
                    <button type="button" class="btn btn-outline-primary" @onclick="Print"><i class="bi bi-printer" aria-hidden="true"></i> چاپ</button>
                </div>
            </div>
            <div class="mi-hero-bar d-flex gap-2 flex-wrap align-items-center">
            @if (MoadianUi.CanSend(vm.StatusSentToSystemInt, vm.ShowButtons))
            {
                @if (vm.StatusSentToSystemInt == "0")
                {
                    <button class="btn btn-outline-primary" @onclick="PreviewPayload" disabled="@acting">
                        <i class="bi bi-braces"></i> پیش‌نمایش JSON
                    </button>
                }
                <button class="btn btn-primary" @onclick="Send" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-send"></i> }
                    @(vm.StatusSentToSystemInt == "5" ? "ارسال مجدد به سامانه" : "ارسال به سامانه")
                </button>
            }
            @if (MoadianUi.CanInquiry(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <button class="btn btn-outline-primary" @onclick="Estelam" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-search"></i> }
                    استعلام وضعیت
                </button>
            }
            @if (MoadianUi.CanShowErrors(vm.StatusSentToSystemInt))
            {
                <button class="btn btn-outline-danger" @onclick="ShowError" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-exclamation-octagon"></i> }
                    مشاهده خطاها
                </button>
            }
            @if (MoadianUi.CanViewWorkFolder(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <a class="btn btn-outline-info" href="@MoadianUi.WorkFolderUrl" target="_blank" rel="noopener">
                    <i class="bi bi-folder2-open" aria-hidden="true"></i> مشاهده در کارپوشه
                </a>
            }
            @if (MoadianUi.CanReference(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <NavLink class="btn btn-outline-warning" href="@($"moadian/invoices/{vm.Id}/eslahi")"><i class="bi bi-pencil"></i> اصلاحی</NavLink>
            }
            @if (MoadianUi.CanEbtal(vm.StatusSentToSystemInt, vm.ReferenceId))
            {
                <button class="btn btn-outline-danger" @onclick="Ebtal" disabled="@acting">
                    @if (acting) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-x-octagon"></i> }
                    ابطال
                </button>
            }
            @if (MoadianUi.CanDelete(vm.StatusSentToSystemInt, vm.ShowButtons))
            {
                <button class="btn btn-outline-secondary ms-auto" @onclick="Delete" disabled="@acting">
                    <i class="bi bi-trash"></i> حذف
                </button>
            }
            @if (vm.ShowButtons == false)
            {
                <span class="text-muted small align-self-center">این صورتحساب (مثلاً ابطالی) قابل ویرایش و عملیات نیست.</span>
            }
            </div>
        </div>
    </div>

    @* ---------- بنر وضعیت زمینه‌ای ---------- *@
    @if (vm.StatusSentToSystemInt == "5" && !string.IsNullOrEmpty(vm.ReferenceId))
    {
        <div class="alert alert-danger mi-banner d-flex align-items-center gap-2 no-print" role="status">
            <i class="bi bi-exclamation-octagon" aria-hidden="true"></i>
            <div>این صورتحساب دارای خطا از سمت سامانهٔ مالیاتی است؛ می‌توانید جزئیات خطا را مشاهده یا صورتحساب اصلاحی صادر کنید.</div>
        </div>
    }
    else if (vm.ShowButtons && (vm.StatusSentToSystemInt == "1" || vm.StatusSentToSystemInt == "4"))
    {
        <div class="alert alert-info mi-banner d-flex align-items-center gap-2 no-print" role="status">
            <i class="bi bi-hourglass-split" aria-hidden="true"></i>
            <div>صورتحساب در جریان بررسی در سامانهٔ مالیاتی است؛ برای دیدن آخرین وضعیت، دکمهٔ «استعلام وضعیت» در بخش عملیات را بزنید.</div>
        </div>
    }

    @* ---------- نتیجه استعلام / خطا ---------- *@
    @if (ActionResult != null)
    {
        <div class="alert no-print @(ActionIsError ? "alert-danger" : "alert-info") d-flex align-items-start gap-2">
            <i class="bi @(ActionIsError ? "bi-exclamation-triangle" : "bi-info-circle")"></i>
            <div>
                <div class="fw-semibold">@(ActionIsError ? "جزئیات خطای صورتحساب" : "نتیجهٔ استعلام")</div>
                <div>@ActionResult</div>
                @if (ErrorItem_ != null)
                {
                    <div class="num small mt-1" dir="ltr">code: @ErrorItem_.code</div>
                }
            </div>
            <button type="button" class="btn-close ms-auto" @onclick="() => { ActionResult = null; ErrorItem_ = null; }"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(PreviewRequestJson) || !string.IsNullOrWhiteSpace(ActualRequestJson) || !string.IsNullOrWhiteSpace(SdkResponseJson))
    {
        <div class="card mi-blocked mb-3 no-print">
            <div class="card-header d-flex align-items-center gap-2">
                <i class="bi bi-braces"></i> JSON صورتحساب
                <span class="small text-muted ms-auto">نمایش DTO پیش از بسته‌بندی/امضا/رمزگذاری SDK</span>
            </div>
            <div class="card-body">
                @if (!string.IsNullOrWhiteSpace(PreviewRequestJson))
                {
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <strong>پیش از ارسال — پیش‌نمایش</strong>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => CopyText(PreviewRequestJson)"><i class="bi bi-clipboard"></i> کپی</button>
                    </div>
                    <pre class="mi-code" dir="ltr">@PreviewRequestJson</pre>
                }
                @if (!string.IsNullOrWhiteSpace(ActualRequestJson))
                {
                    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
                        <strong>پس از ارسال — درخواست واقعی ساخته‌شده</strong>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => CopyText(ActualRequestJson)"><i class="bi bi-clipboard"></i> کپی</button>
                    </div>
                    <pre class="mi-code" dir="ltr">@ActualRequestJson</pre>
                }
                @if (!string.IsNullOrWhiteSpace(SdkResponseJson))
                {
                    <div class="d-flex align-items-center gap-2 mb-2 mt-3">
                        <strong>پاسخ SDK/سامانه</strong>
                        <button class="btn btn-sm btn-outline-secondary ms-auto" @onclick="() => CopyText(SdkResponseJson)"><i class="bi bi-clipboard"></i> کپی</button>
                    </div>
                    <pre class="mi-code" dir="ltr">@SdkResponseJson</pre>
                }
                <div class="alert alert-warning small mb-0">این JSON حاوی شناسه‌های مالیاتی و اطلاعات خریدار/فروشنده است؛ آن را عمومی منتشر نکنید. زمان/TaxID در پیش‌نمایش ممکن است با درخواست واقعیِ بعدی متفاوت باشد.</div>
            </div>
        </div>
    }

    <div class="row g-3">
        @* ---------- اطلاعات ---------- *@
        <div class="col-lg-4">
            <div class="card mi-blocked h-100">
                <div class="card-header"><i class="bi bi-info-circle"></i> اطلاعات صورتحساب</div>
                <div class="card-body">
                    <div class="mi-info">
                        <div class="mi-info-cell">
                            <span class="mi-info-lbl"><i class="bi bi-cash-stack"></i> مبلغ نهایی</span>
                            <span class="mi-info-val num" style="color:var(--primary)">@MoadianUi.Money(GrandTotal)</span>
                        </div>
                        <div class="mi-info-cell">
                            <span class="mi-info-lbl"><i class="bi bi-credit-card"></i> نوع پرداخت</span>
                            <span class="mi-info-val">@vm.PaymentType</span>
                        </div>
                        <div class="mi-info-cell">
                            <span class="mi-info-lbl"><i class="bi bi-tags"></i> نوع صورتحساب</span>
                            <span class="mi-info-val">@vm.TypePattern</span>
                        </div>
                        @if (!string.IsNullOrEmpty(vm.Description))
                        {
                            <div class="mi-info-cell" style="grid-column:1/-1">
                                <span class="mi-info-lbl"><i class="bi bi-text-left"></i> شرح</span>
                                <span class="mi-info-val" style="font-weight:500">@vm.Description</span>
                            </div>
                        }
                    </div>
                    <div class="mt-3 d-flex flex-column gap-2">
                        <div>
                            <div class="text-muted small mb-1">شمارهٔ مالیاتی (TaxID)</div>
                            @if (!string.IsNullOrEmpty(vm.NewTaxNumber))
                            {
                                <div class="mi-codechip" title="کپی شمارهٔ مالیاتی" @onclick="() => CopyText(vm.NewTaxNumber!)">
                                    <i class="bi bi-clipboard"></i><span>@vm.NewTaxNumber</span>
                                </div>
                            }
                            else
                            {
                                <div class="mi-codechip" style="cursor:default"><i class="bi bi-hourglass"></i><span style="color:#94a3b8">هنوز صادر نشده (پس از ارسال)</span></div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(vm.ReferenceId))
                        {
                            <div>
                                <div class="text-muted small mb-1">شمارهٔ مرجع (ReferenceID)</div>
                                <div class="mi-codechip" title="کپی شمارهٔ مرجع" @onclick="() => CopyText(vm.ReferenceId!)">
                                    <i class="bi bi-clipboard"></i><span>@vm.ReferenceId</span>
                                </div>
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(vm.TaxMemoryID))
                        {
                            <div>
                                <div class="text-muted small mb-1">شناسهٔ حافظه</div>
                                <div class="mi-codechip" style="cursor:default"><i class="bi bi-hdd"></i><span>@vm.TaxMemoryID</span></div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        @* ---------- ردیف‌ها ---------- *@
        <div class="col-lg-8">
            <div class="card mi-blocked h-100">
                <div class="card-header d-flex align-items-center gap-2">
                    <span><i class="bi bi-list-ol"></i> ردیف‌ها</span>
                    <span class="badge badge-soft-primary num ms-auto">@((vm.InvoiceItems.Count).Num()) ردیف</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive mi-table">
                        <table class="table align-middle mb-0">
                            <thead>
                                <tr>
                                    <th style="width:52px">ردیف</th>
                                    <th>کالا / خدمت</th>
                                    <th>واحد</th>
                                    <th class="text-center">تعداد</th>
                                    <th class="text-center">نرخ</th>
                                    <th class="text-center">ارزش افزوده</th>
                                    <th class="text-center">تخفیف</th>
                                    <th class="text-center">مبلغ</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int ii = 0; ii < vm.InvoiceItems.Count; ii++)
                                {
                                    var it = vm.InvoiceItems[ii];
                                    <tr>
                                        <td class="num text-muted">@(ii + 1).Num()</td>
                                        <td>
                                            @it.Name
                                            @if (!string.IsNullOrEmpty(it.UniqueIdentifier))
                                            {
                                                <div class="num small text-muted" dir="ltr">@it.UniqueIdentifier</div>
                                            }
                                        </td>
                                        <td class="small num">@it.UnitOfMeasurement</td>
                                        <td class="text-center num">@((it.Count ?? 0).Qty())</td>
                                        <td class="text-center num">@MoadianUi.Money(it.PriceUnit)</td>
                                        <td class="text-center num">@(((decimal)(it.ValueAddedPercentage ?? 0)).Qty())٪</td>
                                        <td class="text-center num">@MoadianUi.Money(it.Discount)</td>
                                        <td class="text-center num fw-semibold">@MoadianUi.Money(it.CalculatedPay)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="mi-total-banner num">
                        <span class="text-muted">مجموع صورتحساب</span>
                        <span class="v">@MoadianUi.Money(GrandTotal) <small>ریال</small></span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    </div>

    <div class="moadian-print" lang="fa" dir="rtl">
        <table class="moadian-print-table">
            <colgroup>
                <col style="width:4%" /><col style="width:22%" /><col style="width:14%" /><col style="width:6%" />
                <col style="width:6%" /><col style="width:11%" /><col style="width:10%" /><col style="width:7%" />
                <col style="width:10%" /><col style="width:10%" />
            </colgroup>
            <thead>
                <tr><th colspan="10">
                    <div class="mprint-brand">@(seller?.PersianName ?? "صورتحساب الکترونیکی")</div>
                    <div class="mprint-subtitle">صورتحساب فروش کالا / خدمت</div>
                    <div class="mprint-seller">
                        @if (!string.IsNullOrWhiteSpace(seller?.Nationalid)) { <span>شناسهٔ ملی فروشنده: <b dir="ltr">@seller!.Nationalid</b></span> }
                        @if (!string.IsNullOrWhiteSpace(seller?.EconomicNumber)) { <span>شمارهٔ اقتصادی: <b dir="ltr">@seller!.EconomicNumber</b></span> }
                        @if (!string.IsNullOrWhiteSpace(vm.TaxMemoryID)) { <span>شناسهٔ حافظهٔ مالیاتی: <b dir="ltr">@vm.TaxMemoryID</b></span> }
                    </div>
                    <div class="mprint-meta">
                        <div><span>شمارهٔ صورتحساب</span><b class="num">@(vm.NumberInvoice?.Num() ?? "—")</b></div>
                        <div><span>شناسهٔ داخلی</span><b class="num">@vm.Id.Num()</b></div>
                        <div><span>تاریخ صدور</span><b class="num">@MoadianUi.Shamsi(vm.DateOrder)</b></div>
                        <div><span>موضوع</span><b>@(vm.Subject ?? "—")</b></div>
                        <div><span>وضعیت</span><b>@MoadianUi.StatusLabel(vm.StatusSentToSystemInt)</b></div>
                        <div><span>نوع صورتحساب</span><b>@(vm.TypePattern ?? "—")</b></div>
                        <div><span>مشتری</span><b>@(vm.CustomerName ?? "—")</b></div>
                        <div><span>روش پرداخت</span><b>@(vm.PaymentType ?? "—")</b></div>
                        @if (!string.IsNullOrWhiteSpace(vm.NewTaxNumber ?? vm.TaxNumber))
                        {
                            <div class="mprint-wide"><span>شمارهٔ مالیاتی</span><b dir="ltr">@(vm.NewTaxNumber ?? vm.TaxNumber)</b></div>
                        }
                        @if (!string.IsNullOrWhiteSpace(vm.ReferenceId))
                        {
                            <div class="mprint-wide"><span>شمارهٔ مرجع</span><b dir="ltr">@vm.ReferenceId</b></div>
                        }
                    </div>
                </th></tr>
                <tr class="mprint-columns">
                    <th class="mprint-no">ردیف</th>
                    <th>شرح کالا / خدمت</th>
                    <th>شناسهٔ کالا</th>
                    <th>واحد</th>
                    <th>تعداد</th>
                    <th>مبلغ واحد (ریال)</th>
                    <th>تخفیف (ریال)</th>
                    <th>نرخ مالیات</th>
                    <th>مالیات (ریال)</th>
                    <th>جمع ردیف (ریال)</th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < vm.InvoiceItems.Count; i++)
                {
                    var item = vm.InvoiceItems[i];
                    <tr>
                        <td class="num">@((i + 1).Num())</td>
                        <td>@(item.Name ?? item.DescriptionKala ?? "—")</td>
                        <td class="num" dir="ltr">@(item.UniqueIdentifier ?? "—")</td>
                        <td>@(item.UnitOfMeasurement ?? "—")</td>
                        <td class="num">@((item.Count ?? 0).Qty())</td>
                        <td class="num">@MoadianUi.Money(item.PriceUnit)</td>
                        <td class="num">@MoadianUi.Money(item.Discount)</td>
                        <td class="num">@(((decimal)(item.ValueAddedPercentage ?? 0)).Qty())٪</td>
                        <td class="num">@MoadianUi.Money(item.ValueAddedAmount)</td>
                        <td class="num fw-bold">@MoadianUi.Money(item.CalculatedPay)</td>
                    </tr>
                }
            </tbody>
        </table>
        <div class="mprint-summary">
            @if (!string.IsNullOrWhiteSpace(vm.Description))
            {
                <div class="mprint-description"><b>توضیحات:</b> @vm.Description</div>
            }
            <div class="mprint-total"><span>جمع کل صورتحساب</span><strong class="num">@MoadianUi.Money(GrandTotal) <small>ریال</small></strong></div>
        </div>
        <div class="mprint-footer">نسخهٔ چاپی صورتحساب — شناسهٔ رکورد: <span class="num">@vm.Id.Num()</span></div>
    </div>
}

<style>
    .moadian-print { display:none; }
    @@page { size: A4 landscape; margin: 8mm; }
    @@media print {
        body:has(.moadian-print) * { visibility:hidden !important; }
        body:has(.moadian-print) .moadian-print,
        body:has(.moadian-print) .moadian-print * { visibility:visible !important; }
        body:has(.moadian-print) .invoice-screen { display:none !important; }
        body:has(.moadian-print) .moadian-print {
            display:block !important; position:static !important; inset:auto !important;
            width:100% !important; color:#111827 !important; background:#fff !important;
            font-family:Tahoma,Arial,sans-serif; font-size:9pt; direction:rtl;
        }
        .moadian-print-table { width:100%; border-collapse:collapse; table-layout:fixed; }
        .moadian-print-table thead { display:table-header-group; }
        .moadian-print-table tr { break-inside:avoid; page-break-inside:avoid; }
        .moadian-print-table th, .moadian-print-table td { border:1px solid #64748b; padding:4px 5px; text-align:center; vertical-align:middle; overflow-wrap:anywhere; }
        .moadian-print-table thead tr:first-child th { border:0; padding:0 0 6px; }
        .mprint-brand { font-size:17pt; font-weight:800; text-align:center; margin:0 0 2px; }
        .mprint-subtitle { font-size:12pt; font-weight:700; text-align:center; margin-bottom:5px; }
        .mprint-seller { display:flex; flex-wrap:wrap; justify-content:center; gap:4px 18px; font-size:8pt; margin-bottom:6px; }
        .mprint-meta { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); border:1px solid #64748b; text-align:right; }
        .mprint-meta > div { display:flex; gap:5px; padding:4px 6px; border-left:1px solid #cbd5e1; border-bottom:1px solid #cbd5e1; min-width:0; }
        .mprint-meta span { color:#475569; white-space:nowrap; }
        .mprint-meta b { overflow-wrap:anywhere; }
        .mprint-meta .mprint-wide { grid-column:span 2; }
        .mprint-columns th { background:#e2e8f0 !important; -webkit-print-color-adjust:exact; print-color-adjust:exact; font-size:8pt; }
        .moadian-print-table tbody td { font-size:8pt; }
        .mprint-no { width:5%; }
        .mprint-summary { margin-top:7px; break-inside:avoid; page-break-inside:avoid; }
        .mprint-description { border:1px solid #94a3b8; padding:6px; margin-bottom:6px; min-height:24px; }
        .mprint-total { display:flex; justify-content:space-between; align-items:center; border:2px solid #334155; padding:7px 10px; font-size:11pt; font-weight:700; }
        .mprint-total strong { font-size:13pt; }
        .mprint-total small { font-size:8pt; }
        .mprint-footer { margin-top:6px; padding-top:4px; border-top:1px solid #94a3b8; text-align:center; font-size:7pt; color:#475569; }
        .num { font-variant-numeric:tabular-nums; }
    }
</style>

@code {
    [Parameter] public int Id { get; set; }
    private InvoiceVM? vm;
    private VMShowCpinfoByCompany? seller;
    private bool loading = true, acting;
    private string? loadError;
    private string? ActionResult;
    private string? PreviewRequestJson;
    private string? ActualRequestJson;
    private string? SdkResponseJson;
    private bool ActionIsError;
    private ErroreMesage? ErrorItem_;

    private decimal GrandTotal => vm?.InvoiceItems.Sum(i => i.CalculatedPay ?? 0) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            loadError = null;
            vm = await Moadian.GetInvoiceAsync(Id);
            if (vm is not null && vm.CPInfoId.HasValue)
            {
                try
                {
                    var companies = await Moadian.GetCpInfosAsync();
                    seller = companies.FirstOrDefault(c => c.cpinfoid == vm.CPInfoId.Value);
                }
                catch
                {
                    // اطلاعات فروشنده تکمیلی است؛ شکست دریافت آن نباید جزئیات یا چاپ صورتحساب را مختل کند.
                    seller = null;
                }
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Toast.Error(ex.Message);
        }
        finally { loading = false; StateHasChanged(); }
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // چاپ خودکار هنگام ورود با ?print=1 (مثلاً از دکمهٔ چاپ لیست)
        if (firstRender) return;
        if (!_printHandled && !loading && vm is not null && Nav.Uri.Contains("print=1", StringComparison.OrdinalIgnoreCase))
        {
            _printHandled = true;
            await JS.InvokeVoidAsync("window.print");
        }
    }

    private bool _printHandled;

    private async Task PreviewPayload()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            vm.Subject = "ارسال به سامانه";
            var r = await Moadian.PreviewSendInvoiceAsync(vm);
            if (r.Success)
            {
                PreviewRequestJson = r.RequestJson;
                Toast.Success("پیش‌نمایش JSON آماده شد؛ هیچ صورتحسابی ارسال نشد.");
            }
            else Toast.Error(r.Message ?? "ساخت پیش‌نمایش ناموفق بود.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Send()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            // Subject برگشتی از جزئیات عنوان رکورد («اصلی») است، نه فرمان عملیات.
            // فرمان ارسال عادی را صریح می‌فرستیم تا با برگشت از فروش اشتباه نشود.
            vm.Subject = "ارسال به سامانه";
            var r = await Moadian.SendInvoiceAsync(vm);
            ActualRequestJson = r.RequestJson;
            SdkResponseJson = r.ResponseJson;
            if (r.Success) { Toast.Success("صورتحساب به سامانه مودیان ارسال شد."); await LoadAsync(); }
            else Toast.Error(r.Message ?? "خطا در ارسال.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Estelam()
    {
        if (vm is null || string.IsNullOrEmpty(vm.ReferenceId)) { Toast.Info("برای استعلام، ابتدا باید صورتحساب ارسال شده باشد."); return; }
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.EstelamInvoiceAsync(vm.ReferenceId!, vm.Id, (vm.DateOrderPicker ?? DateTime.Today).ToString("yyyy-MM-dd"));
            ActionResult = r.Data?.ToString() ?? r.Message;
            ActionIsError = !r.Success;
            if (r.Success) Toast.Success("وضعیت به‌روزرسانی شد.");
            else Toast.Error(r.Message ?? "استعلام ناموفق بود.");
            await LoadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task ShowError()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.ErrorInvoiceAsync(vm.ReferenceId!);
            ErrorItem_ = MoadianService.As<ErroreMesage>(r);
            ActionResult = ErrorItem_?.message ?? r.Message;
            ActionIsError = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Ebtal()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.EbtalInvoiceAsync(vm);
            if (r.Success) { Toast.Success("صورتحساب ابطال شد."); await LoadAsync(); }
            else Toast.Error(r.Message ?? "خطا در ابطال.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Delete()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "این صورتحساب حذف می‌شود. ادامه می‌دهید؟");
        if (!ok) return;
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.DeleteInvoiceAsync(vm!.Id);
            if (r.Success) { Toast.Success("صورتحساب حذف شد."); Nav.NavigateTo("moadian/invoices"); }
            else Toast.Error(r.Message ?? "خطا در حذف.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task CopyText(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            InvokeAsync(() => Toast.Info("کپی شد."));
        }
        catch { InvokeAsync(() => Toast.Error("کپی ممکن نبود.")); }
    }
}
