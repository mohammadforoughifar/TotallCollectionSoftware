@code {
    [Parameter] public int Id { get; set; }
    private InvoiceVM? vm;
    private VMShowCpinfoByCompany? seller;
    private VMCustomerList? buyer;
    private bool loading = true, acting;
    private string? loadError;

    private bool Can(string permission) => Auth.IsAdmin || Auth.Has(permission);
    private bool CanPreview => Can("Moadian.InvoicePreview");
    private bool CanSend => Can("Moadian.InvoiceSend");
    private bool CanInquiry => Can("Moadian.InvoiceInquiry");
    private bool CanUpdate => Can("Moadian.InvoiceUpdate");
    private bool CanDelete => Can("Moadian.InvoiceDelete");
    private string? ActionResult;
    private string? PreviewRequestJson;
    private string? ActualRequestJson;
    private string? SdkResponseJson;
    private bool ActionIsError;
    private ErroreMesage? ErrorItem_;

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value.Trim();

    private string? SellerTaxIdentity => FirstValue(seller?.Nationalid, seller?.EconomicNumber);
    private string? BuyerTaxIdentity => FirstValue(buyer?.NationalID, buyer?.EconomicNumber);

    private static string? FirstValue(params string?[] values) =>
        values.FirstOrDefault(v => !string.IsNullOrWhiteSpace(v));

    // فرمول‌های چاپ با فرم ثبت و قواعد محاسباتی مودیان یکسان هستند.
    private static decimal LineGross(VmInvoiceItems item) => (item.Count ?? 0) * (item.PriceUnit ?? 0);
    private static decimal LineDiscount(VmInvoiceItems item) => Math.Max(0m, item.Discount ?? 0m);
    private static decimal LineNet(VmInvoiceItems item) => Math.Max(0m, LineGross(item) - LineDiscount(item));
    private static decimal LineVat(VmInvoiceItems item) => item.ValueAddedAmount
        ?? Math.Truncate(LineNet(item) * (decimal)(item.ValueAddedPercentage ?? 0) / 100m);
    private static decimal LineTotal(VmInvoiceItems item) => item.CalculatedPay ?? Math.Truncate(LineNet(item)) + LineVat(item);

    private decimal TotalGross => vm?.InvoiceItems.Sum(LineGross) ?? 0;
    private decimal TotalDiscount => vm?.InvoiceItems.Sum(LineDiscount) ?? 0;
    private decimal TotalNet => vm?.InvoiceItems.Sum(LineNet) ?? 0;
    private decimal TotalVat => vm?.InvoiceItems.Sum(LineVat) ?? 0;
    private decimal GrandTotal => vm?.InvoiceItems.Sum(LineTotal) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        StateHasChanged();
        try
        {
            loadError = null;
            seller = null;
            buyer = null;
            vm = await Moadian.GetInvoiceAsync(Id);
            if (vm is not null && vm.CPInfoId.HasValue)
            {
                try
                {
                    var companies = await Moadian.GetCpInfosAsync();
                    seller = companies.FirstOrDefault(c => c.cpinfoid == vm.CPInfoId.Value);
                }
                catch
                {
                    // اطلاعات فروشنده تکمیلی است؛ شکست دریافت آن نباید جزئیات یا چاپ صورتحساب را مختل کند.
                    seller = null;
                }

                if (vm.CustomerId.HasValue)
                {
                    try
                    {
                        var customers = await Moadian.GetCustomersAsync(vm.CPInfoId.Value);
                        buyer = customers.FirstOrDefault(c => c.CustomerId == vm.CustomerId.Value);
                    }
                    catch
                    {
                        // کاربر ممکن است مجوز فهرست مشتری‌ها را نداشته باشد؛ نام ذخیره‌شدهٔ
                        // روی صورتحساب همچنان برای چاپ نمایش داده می‌شود.
                        buyer = null;
                    }
                }
            }
        }
        catch (Exception ex)
        {
            loadError = ex.Message;
            Toast.Error(ex.Message);
        }
        finally { loading = false; StateHasChanged(); }
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // پنجرهٔ کپیِ دستی: متنِ داخل فیلد انتخاب شود
        if (copyFallbackOpen && !_copyFallbackSelected)
        {
            _copyFallbackSelected = true;
            await OnCopyFallbackShown();
        }
        else if (!copyFallbackOpen) _copyFallbackSelected = false;

        // چاپ خودکار هنگام ورود با ?print=1 (مثلاً از دکمهٔ چاپ لیست)
        if (firstRender) return;
        if (!_printHandled && !loading && vm is not null && Nav.Uri.Contains("print=1", StringComparison.OrdinalIgnoreCase))
        {
            _printHandled = true;
            await JS.InvokeVoidAsync("window.print");
        }
    }

    private bool _printHandled;

    private async Task PreviewPayload()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            vm.Subject = "ارسال به سامانه";
            var r = await Moadian.PreviewSendInvoiceAsync(vm);
            if (r.Success)
            {
                PreviewRequestJson = r.RequestJson;
                Toast.Success("پیش‌نمایش JSON آماده شد؛ هیچ صورتحسابی ارسال نشد.");
            }
            else Toast.Error(r.Message ?? "ساخت پیش‌نمایش ناموفق بود.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Send()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            // Subject برگشتی از جزئیات عنوان رکورد («اصلی») است، نه فرمان عملیات.
            // فرمان ارسال عادی را صریح می‌فرستیم تا با برگشت از فروش اشتباه نشود.
            vm.Subject = "ارسال به سامانه";
            var r = await Moadian.SendInvoiceAsync(vm);
            ActualRequestJson = r.RequestJson;
            SdkResponseJson = r.ResponseJson;
            if (r.Success) { Toast.Success("صورتحساب به سامانه مودیان ارسال شد."); await LoadAsync(); }
            else Toast.Error(r.Message ?? "خطا در ارسال.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Estelam()
    {
        if (vm is null || string.IsNullOrEmpty(vm.ReferenceId)) { Toast.Info("برای استعلام، ابتدا باید صورتحساب ارسال شده باشد."); return; }
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.EstelamInvoiceAsync(vm.ReferenceId!, vm.Id, (vm.DateOrderPicker ?? DateTime.Today).ToString("yyyy-MM-dd"));
            ActionResult = r.Data?.ToString() ?? r.Message;
            ActionIsError = !r.Success;
            if (r.Success) Toast.Success("وضعیت به‌روزرسانی شد.");
            else Toast.Error(r.Message ?? "استعلام ناموفق بود.");
            await LoadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    // ---------- ثبت دستی وضعیت واکنش خریدار ----------
    private bool reactOpen;
    private string? reactTarget;

    private async Task SubmitReact(string status)
    {
        if (vm is null) return;
        reactTarget = status; acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.SetInvoiceStatusAsync(vm.Id, status);
            if (r.Success)
            {
                reactOpen = false;
                Toast.Success(r.Message ?? "وضعیت صورتحساب ثبت شد.");
                ActionResult = r.Message;
                await LoadAsync();
            }
            else
            {
                Toast.Error(r.Message ?? "ثبت وضعیت ناموفق بود.");
                ActionResult = r.Message;
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { reactTarget = null; acting = false; StateHasChanged(); }
    }

    private async Task ShowError()
    {
        if (vm is null) return;
        // وضعیت «۵» (خطای قطعی) می‌تواند بدون شماره مرجع رخ دهد؛ گارد نبودنِ مرجع
        // باعث خطای ArgumentNull در EscapeDataString می‌شد — همان رفتار لیست (Toast.Info).
        if (!MoadianUi.HasReference(vm.ReferenceId)) { Toast.Info("این صورتحساب هنوز به سامانه ارسال نشده است (شماره مرجع ندارد)."); return; }
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.ErrorInvoiceAsync(vm.ReferenceId!);
            ErrorItem_ = MoadianService.As<ErroreMesage>(r);
            ActionResult = ErrorItem_?.message ?? r.Message;
            ActionIsError = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Ebtal()
    {
        if (vm is null) return;
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.EbtalInvoiceAsync(vm);
            if (r.Success) { Toast.Success("صورتحساب ابطال شد."); await LoadAsync(); }
            else Toast.Error(r.Message ?? "خطا در ابطال.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    private async Task Delete()
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "این صورتحساب حذف می‌شود. ادامه می‌دهید؟");
        if (!ok) return;
        acting = true; StateHasChanged();
        try
        {
            var r = await Moadian.DeleteInvoiceAsync(vm!.Id);
            if (r.Success) { Toast.Success("صورتحساب حذف شد."); Nav.NavigateTo("moadian/invoices"); }
            else Toast.Error(r.Message ?? "خطا در حذف.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { acting = false; StateHasChanged(); }
    }

    /// <summary>
    /// کپی با فالبک: روی http (شبکهٔ داخلی) navigator.clipboard وجود ندارد و کپی
    /// با execCommand انجام می‌شود؛ اگر مرورگر باز هم اجازه نداد، متن در پنجره‌ای
    /// انتخاب‌شده نشان داده می‌شود تا کاربر دستی Ctrl+C کند.
    /// </summary>
    private async Task CopyText(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) { Toast.Info("مقداری برای کپی وجود ندارد."); return; }
        var ok = await ClipboardInterop.CopyAsync(JS, text);
        if (ok) { Toast.Info("کپی شد."); return; }
        copyFallbackText = text;
        copyFallbackOpen = true;
        StateHasChanged();
    }

    private bool copyFallbackOpen;
    private string copyFallbackText = "";
    private bool _copyFallbackSelected;
    private const string CopyFallbackInputId = "mid-copy-fallback";

    private async Task OnCopyFallbackShown()
        => await ClipboardInterop.SelectAllAsync(JS, CopyFallbackInputId);

    private void CloseCopyFallback() { copyFallbackOpen = false; copyFallbackText = ""; }

}
