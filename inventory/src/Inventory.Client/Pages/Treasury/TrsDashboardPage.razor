@page "/trs/dashboard"
@inject ITrsReportService ReportSvc
@inject IToastService Toast
@inject LayoutState Layout

<PageTitle>داشبورد خزانه</PageTitle>

<div class="page-head">
    <div>
        <h1>داشبورد خزانه</h1>
        <p class="lead">موجودی صندوق‌ها و بانک‌ها، گردش دوره و وضعیت چک‌ها</p>
    </div>
    <div class="ms-auto d-flex gap-2">
        <a class="btn btn-primary" href="/trs/vouchers/new/Receipt"><i class="bi bi-plus-lg"></i> سند دریافت</a>
    </div>
</div>

<div class="card mb-3 d-print-none">
    <div class="card-body py-3">
        <div class="row g-2 align-items-end">
            <div class="col-6 col-md-3">
                <label class="form-label">گردش از تاریخ</label>
                <DatePicker Value="from" ValueChanged="OnFrom" AllowClear="true" />
            </div>
            <div class="col-6 col-md-3">
                <label class="form-label">تا تاریخ</label>
                <DatePicker Value="to" ValueChanged="OnTo" AllowClear="true" />
            </div>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
}
else if (data is null)
{
    <div class="card"><div class="card-body"><div class="empty-state"><i class="bi bi-wallet2"></i><h5>داده‌ای موجود نیست</h5></div></div></div>
}
else
{
    <!-- ---------- کارت‌های اصلی ---------- -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-success"><i class="bi bi-wallet2 text-success"></i></div>
                <div>
                    <div class="stat-label">جمع موجودی</div>
                    <div class="stat-value num text-success">@data.TotalBalance.Money()</div>
                    <div class="fs-8 text-muted num">@data.Accounts.Count.Num() حساب فعال</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-primary"><i class="bi bi-cash-stack text-primary"></i></div>
                <div>
                    <div class="stat-label">صندوق‌ها</div>
                    <div class="stat-value num">@data.TotalCashBalance.Money()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-info"><i class="bi bi-bank text-info"></i></div>
                <div>
                    <div class="stat-label">بانک‌ها</div>
                    <div class="stat-value num">@data.TotalBankBalance.Money()</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon @(NetFlow >= 0 ? "bg-soft-success" : "bg-soft-danger")">
                    <i class="bi @(NetFlow >= 0 ? "bi-graph-up-arrow text-success" : "bi-graph-down-arrow text-danger")"></i>
                </div>
                <div>
                    <div class="stat-label">خالص گردش دوره</div>
                    <div class="stat-value num @(NetFlow >= 0 ? "text-success" : "text-danger")">@Math.Abs(NetFlow).Money()</div>
                    <div class="fs-8 text-muted">دریافت − پرداخت</div>
                </div>
            </div>
        </div>
    </div>

    <!-- ---------- گردش و چک ---------- -->
    <div class="row g-3 mb-3">
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-success"><i class="bi bi-box-arrow-in-down text-success"></i></div>
                <div>
                    <div class="stat-label">دریافت دوره</div>
                    <div class="stat-value num">@data.PeriodIn.Money()</div>
                    <div class="fs-8 text-muted num">@data.ReceiptCount.Num() سند</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-danger"><i class="bi bi-box-arrow-up text-danger"></i></div>
                <div>
                    <div class="stat-label">پرداخت دوره</div>
                    <div class="stat-value num">@data.PeriodOut.Money()</div>
                    <div class="fs-8 text-muted num">@data.PaymentCount.Num() سند</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-info"><i class="bi bi-card-checklist text-info"></i></div>
                <div>
                    <div class="stat-label">چک‌های دریافتی باز</div>
                    <div class="stat-value num">@data.ReceivedChequeTotal.Money()</div>
                    <div class="fs-8 text-muted num">@data.ReceivedChequeCount.Num() برگ</div>
                </div>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="stat-card">
                <div class="stat-icon bg-soft-warning"><i class="bi bi-card-checklist text-warning"></i></div>
                <div>
                    <div class="stat-label">چک‌های پرداختی باز</div>
                    <div class="stat-value num">@data.IssuedChequeTotal.Money()</div>
                    <div class="fs-8 text-muted num">@data.IssuedChequeCount.Num() برگ</div>
                </div>
            </div>
        </div>
    </div>

    @if (data.OverdueChequeCount > 0)
    {
        <div class="alert alert-danger d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <b class="num">@data.OverdueChequeCount.Num()</b> چک به مبلغ
                <b class="num">@data.OverdueChequeTotal.Money()</b> سررسید گذشته و تعیین تکلیف نشده است.
            </div>
            <a class="btn btn-sm btn-danger ms-auto" href="/trs/cheques">مشاهده</a>
        </div>
    }

    <div class="row g-3">
        <!-- ---------- مانده حساب‌ها ---------- -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-wallet2 text-primary"></i>
                    <span class="card-title">مانده صندوق‌ها و بانک‌ها</span>
                    <a class="btn btn-sm btn-outline-primary ms-auto" href="/trs/accounts">مدیریت</a>
                </div>
                <div class="card-body p-0">
                    @if (data.Accounts.Count == 0)
                    {
                        <div class="empty-state"><i class="bi bi-inbox"></i><h5>حسابی تعریف نشده است</h5></div>
                    }
                    else
                    {
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr><th>حساب</th><th class="text-center">وارده</th><th class="text-center">صادره</th><th class="text-center">مانده</th><th></th></tr>
                            </thead>
                            <tbody>
                                @foreach (var a in data.Accounts)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-600">@a.Name</div>
                                            <div class="fs-8 text-muted">@a.KindTitle</div>
                                        </td>
                                        <td class="text-center num text-success fs-8">@a.TotalIn.Money()</td>
                                        <td class="text-center num text-danger fs-8">@a.TotalOut.Money()</td>
                                        <td class="text-center num fw-700 @(a.Balance >= 0 ? "" : "text-danger")">@a.Balance.Money()</td>
                                        <td class="text-end">
                                            <a class="btn btn-sm btn-outline-secondary" href="@($"/trs/reports/flow?accountId={a.Id}")" title="گردش">
                                                <i class="bi bi-list-columns"></i>
                                            </a>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="table-light">
                                <tr>
                                    <th>جمع</th>
                                    <th class="text-center num">@data.Accounts.Sum(a => a.TotalIn).Money()</th>
                                    <th class="text-center num">@data.Accounts.Sum(a => a.TotalOut).Money()</th>
                                    <th class="text-center num">@data.TotalBalance.Money()</th>
                                    <th></th>
                                </tr>
                            </tfoot>
                        </table>
                    }
                </div>
            </div>
        </div>

        <!-- ---------- چک‌های نزدیک سررسید ---------- -->
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-calendar-event text-primary"></i>
                    <span class="card-title">چک‌های سررسید نزدیک (۳۰ روز)</span>
                    <a class="btn btn-sm btn-outline-primary ms-auto" href="/trs/cheques">دفتر چک</a>
                </div>
                <div class="card-body p-0">
                    @if (data.UpcomingCheques.Count == 0)
                    {
                        <div class="empty-state">
                            <i class="bi bi-check2-circle"></i>
                            <h5>چکی در ۳۰ روز آینده سررسید ندارد</h5>
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm table-hover align-middle mb-0">
                            <thead>
                                <tr><th>نوع</th><th>شماره</th><th>طرف حساب</th><th class="text-center">مبلغ</th><th class="text-center">سررسید</th></tr>
                            </thead>
                            <tbody>
                                @foreach (var c in data.UpcomingCheques)
                                {
                                    <tr class="@(c.IsOverdue ? "table-warning" : "")">
                                        <td>
                                            <span class="badge @(c.Kind == ChequeKind.Received ? "badge-soft-success" : "badge-soft-danger") fs-8">
                                                @(c.Kind == ChequeKind.Received ? "دریافتی" : "پرداختی")
                                            </span>
                                        </td>
                                        <td class="num">@c.Number.FaDigits()</td>
                                        <td class="fs-8">@(c.PartyName ?? "—")</td>
                                        <td class="text-center num fw-600">@c.Amount.Money()</td>
                                        <td class="text-center">
                                            <div class="num">@c.DueDate.ToFaDate()</div>
                                            <div class="fs-8 @(c.IsOverdue ? "text-danger" : "text-muted") num">
                                                @(c.IsOverdue ? $"{Math.Abs(c.DaysToDue)} روز گذشته" : $"{c.DaysToDue} روز مانده")
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private TrsDashboard? data;
    private DateTime? from, to;
    private bool loading = true;

    private decimal NetFlow => data is null ? 0 : data.PeriodIn - data.PeriodOut;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("داشبورد خزانه");
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try { data = await ReportSvc.GetDashboardAsync(from, to); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task OnFrom(DateTime? d) { from = d; await Load(); }
    private async Task OnTo(DateTime? d) { to = d; await Load(); }
}
