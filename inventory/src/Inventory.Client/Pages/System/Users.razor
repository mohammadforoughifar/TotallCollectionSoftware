@namespace Inventory.Client.Pages
@page "/users"
@inject HttpClient Http
@inject IAuthApi AuthApi
@inject IAuthState Auth
@inject IReferrerService ReferrerSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>کاربران</PageTitle>

@if (!Auth.IsAdmin && !Auth.IsOperator)
{
    <div class="alert alert-warning">دسترسی به این صفحه مخصوص مدیر و اپراتور است.</div>
}
else
{
    <div class="page-head">
        <div>
            <h1>کاربران</h1>
            <p class="lead">تعریف نام کاربری و رمز عبور — مدیر یا معرف</p>
        </div>
        <div class="d-flex gap-2 me-auto">
            <button class="btn btn-primary" @onclick="OpenNew">
                <i class="bi bi-person-plus"></i> کاربر جدید
            </button>
            <button class="btn btn-outline-success" title="تطبیق مخاطبین ربات بله با موبایل کاربران" disabled="@syncing" @onclick="SyncBale">
                @if (syncing) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                <i class="bi bi-arrow-repeat"></i> همگام‌سازی بله
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (items.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-people"></i><h5>کاربری یافت نشد</h5></div>
            }
            else
            {
                <div class="table-responsive grid-desktop">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>نام کاربری</th>
                                <th>نقش</th>
                                <th>معرف مرتبط</th>
                                <th>تاریخ ایجاد</th>
                                <th>وضعیت</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var u in items)
                            {
                                <tr>
                                    <td class="fw-500" dir="ltr" style="text-align:right">
                                        <span class="d-inline-flex align-items-center gap-2">
                                        <UserAvatar LoginUserId="u.Id" Size="28" CacheBust="@photoBust" />
                                        <i class="bi bi-person-circle text-muted ms-1"></i> @u.Username
                                        </span>
                                        @if (!string.IsNullOrWhiteSpace(u.BaleChatId))
                                        {
                                            <span class="msgr-badge msgr-bale" title="کاربر بله دارد">بله</span>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(u.EitaaChatId))
                                        {
                                            <span class="msgr-badge msgr-eitaa" title="کاربر ایتا دارد">ایتا</span>
                                        }
                                    </td>
                                    <td>
                                        @if (u.RoleNames is { Count: > 0 })
                                        {
                                            @* نمایش همه‌ی نقش‌های RBAC کاربر — نام‌های فارسی نقش‌های منابع انسانی هم در اینجا *@
                                            @foreach (var rn in u.RoleNames)
                                            {
                                                <span class="badge @RoleBadgeClass(rn) me-1 mb-1">@RoleLabel(rn)</span>
                                            }
                                        }
                                        else if (u.Role == "Admin")
                                        {
                                            <span class="badge badge-soft-primary">مدیر</span>
                                        }
                                        else if (u.Role == "Operator")
                                        {
                                            <span class="badge badge-soft-warning">اپراتور</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-success">معرف</span>
                                        }
                                    </td>
                                    <td>@(u.ReferrerName ?? "—")</td>
                                    <td class="num">@u.CreatedAt.ToFa()</td>
                                    <td>
                                        @if (u.IsActive)
                                        {
                                            <span class="badge badge-soft-success">فعال</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-muted">غیرفعال</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (Auth.IsAdmin || u.Role != "Admin")
                                        {
                                            <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEdit(u)"><i class="bi bi-pencil text-primary"></i></button>
                                            <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(u)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                        else
                                        {
                                            <span class="fs-8 text-muted"><i class="bi bi-lock"></i></span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* ---------- نمای کارتی (موبایل) ---------- *@
                <div class="cards-mobile">
                    @foreach (var u in items)
                    {
                        <div class="m-card @(u.Role == "Admin" ? "st-received" : u.Role == "Operator" ? "st-progress" : "st-ready")">
                            <div class="m-card-head">
                                <div class="m-card-icon"><i class="bi @(u.Role == "Admin" ? "bi-shield-lock" : u.Role == "Operator" ? "bi-person-workspace" : "bi-person-badge")"></i></div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <UserAvatar LoginUserId="u.Id" Size="32" CacheBust="@photoBust" />
                                        <span class="fw-700" dir="ltr">@u.Username</span>
                                        @if (u.RoleNames is { Count: > 0 })
                                        {
                                            @foreach (var rn in u.RoleNames)
                                            {
                                                <span class="badge @RoleBadgeClass(rn) fs-8">@RoleLabel(rn)</span>
                                            }
                                        }
                                        else if (u.Role == "Admin")
                                        {
                                            <span class="badge badge-soft-primary fs-8">مدیر</span>
                                        }
                                        else if (u.Role == "Operator")
                                        {
                                            <span class="badge badge-soft-warning fs-8">اپراتور</span>
                                        }
                                        else
                                        {
                                            <span class="badge badge-soft-success fs-8">معرف</span>
                                        }
                                        @if (!u.IsActive)
                                        {
                                            <span class="badge badge-soft-muted fs-8">غیرفعال</span>
                                        }
                                    </div>
                                    <div class="fs-8 text-muted">@(u.ReferrerName is null ? "" : $"معرف: {u.ReferrerName} — ")ایجاد: @u.CreatedAt.ToFa()</div>
                                </div>
                            </div>
                            <div class="m-card-actions">
                                @if (Auth.IsAdmin || u.Role != "Admin")
                                {
                                    <button class="btn btn-light text-primary" @onclick="() => OpenEdit(u)"><i class="bi bi-pencil"></i> ویرایش</button>
                                    <button class="btn btn-light text-danger" @onclick="() => Delete(u)"><i class="bi bi-trash"></i></button>
                                }
                                else
                                {
                                    <span class="fs-8 text-muted align-self-center me-auto"><i class="bi bi-lock"></i> فقط مدیر</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <Modal Visible="showModal" Title="@(editing ? "ویرایش کاربر" : "کاربر جدید")" OnClose="CloseModal">
        <ChildContent>
        @if (!string.IsNullOrWhiteSpace(saveError))
        {
            <div class="alert alert-danger py-2 mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i> @saveError
            </div>
        }
        <div class="photo-pick mb-3">
            <label class="form-label small fw-800 mb-1"><i class="bi bi-camera"></i> عکس کاربر (اختیاری)</label>
            <div class="d-flex align-items-center gap-3">
                <div class="pp-preview">
                    @if (luPhotoPreview != null) { <img src="@luPhotoPreview" alt="پیش‌نمایش" /> }
                    else { <i class="bi bi-person-circle"></i> }
                </div>
                <div class="d-flex flex-column gap-1">
                    <InputFile OnChange="OnLoginUserPhotoPicked" Accept="image/*" class="btn btn-sm btn-outline-primary" style="max-width:220px">
                        <i class="bi bi-cloud-arrow-up-fill"></i> انتخاب عکس (JPG/PNG، حداکثر ۵MB)
                    </InputFile>
                    @if (luPhotoPreview != null)
                    { <button type="button" class="btn btn-sm btn-link text-danger p-0" @onclick="ClearLoginUserPhoto"><i class="bi bi-x-circle"></i> حذف عکس</button> }
                </div>
            </div>
        </div>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">نام کاربری <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.Username" dir="ltr" />
            </div>
            <div class="col-md-6">
                <label class="form-label">رمز عبور @(editing ? "(خالی = بدون تغییر)" : "")<span class="text-danger">@(editing ? "" : " *")</span></label>
                <input type="password" class="form-control" @bind="form.Password" dir="ltr" />
            </div>
            <div class="col-md-6">
                <label class="form-label">نام <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.FirstName" placeholder="مثلاً: علی" />
            </div>
            <div class="col-md-6">
                <label class="form-label">نام خانوادگی <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.LastName" />
            </div>
            <div class="col-md-6">
                <label class="form-label">شماره موبایل <span class="fs-8 text-muted">(برای پیام بله/ایتا)</span></label>
                <input class="form-control num" dir="ltr" placeholder="09xxxxxxxxx" @bind="form.Mobile" />
                <div class="fs-8 text-muted mt-1">
                    @if (!string.IsNullOrWhiteSpace(form.BaleChatId))
                    {
                        <span class="msgr-badge msgr-bale">بله ✓</span>
                    }
                    @if (!string.IsNullOrWhiteSpace(form.EitaaChatId))
                    {
                        <span class="msgr-badge msgr-eitaa">ایتا ✓</span>
                    }
                    @if (string.IsNullOrWhiteSpace(form.BaleChatId) && string.IsNullOrWhiteSpace(form.EitaaChatId))
                    {
                        <span>هنوز به بله/ایتا متصل نشده — بعد از استارت ربات، «همگام‌سازی بله» را بزنید.</span>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">شناسه چت ایتا <span class="fs-8 text-muted">(اختیاری — دستی)</span></label>
                <input class="form-control num" dir="ltr" @bind="form.EitaaChatId" />
            </div>
            @if (Auth.IsAdmin && editing)
            {
                <div class="col-12">
                    <label class="form-label d-block">افراد مجاز برای دستور کار <span class="fs-8 text-muted">(این کاربر به چه کسانی می‌تواند دستور کار بدهد)</span></label>
                    <div class="border rounded p-2">
                        <input class="form-control form-control-sm mb-2" placeholder="جستجو..." @bind="woSearch" @bind:event="oninput" />
                        <div style="max-height:150px;overflow-y:auto">
                            @foreach (var u2 in items.Where(x => x.Id != form.Id && (string.IsNullOrWhiteSpace(woSearch) || x.Username.Contains(woSearch.Trim(), StringComparison.OrdinalIgnoreCase))))
                            {
                                <div class="form-check form-check-inline mb-1">
                                    <input class="form-check-input" type="checkbox" id="wot-@u2.Id"
                                           checked="@woAllowed.Contains(u2.Id)"
                                           @onchange="e => { if ((bool)e.Value!) woAllowed.Add(u2.Id); else woAllowed.Remove(u2.Id); }" />
                                    <label class="form-check-label" for="wot-@u2.Id">@u2.Username</label>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
            <div class="col-12">
                <label class="form-label d-block">نقش‌ها (از بخش «نقش‌ها و دسترسی‌ها») <span class="text-danger">*</span></label>
                @if (allRoles.Count == 0)
                {
                    <div class="alert alert-warning py-2 mb-0 fs-8">
                        نقشی تعریف نشده — از «تنظیمات ← مدیریت نقش‌ها و دسترسی‌ها» نقش بسازید.
                    </div>
                }
                else
                {
                    @* ================== کمبوی چندانتخابی با جستجو ================== *@
                    <div class="ms-combo">
                        <div class="ms-combo-control form-control @(roleDropdownOpen ? "focus" : "")" @onclick="ToggleRoleDropdown">
                            @if (selectedRoleIds.Count == 0)
                            {
                                <span class="text-muted">— انتخاب نقش(ها) —</span>
                            }
                            else
                            {
                                @foreach (var r in allRoles.Where(r => selectedRoleIds.Contains(r.Id)))
                                {
                                    <span class="ms-chip">
                                        @r.Name
                                        <i class="bi bi-x-circle-fill" @onclick:stopPropagation="true"
                                           @onclick="() => ToggleRole(r.Id, false)"></i>
                                    </span>
                                }
                            }
                            <i class="bi bi-chevron-@(roleDropdownOpen ? "up" : "down") ms-caret"></i>
                        </div>
                        @if (roleDropdownOpen)
                        {
                            <div class="ms-combo-menu shadow">
                                <div class="p-2 border-bottom">
                                    <input class="form-control form-control-sm" placeholder="جستجوی نقش..."
                                           @bind="roleSearch" @bind:event="oninput" @onclick:stopPropagation="true" />
                                </div>
                                <div class="ms-combo-items">
                                    @if (!FilteredRoles.Any())
                                    {
                                        <div class="px-3 py-2 text-muted fs-8">نقشی پیدا نشد.</div>
                                    }
                                    @foreach (var r in FilteredRoles)
                                    {
                                        var isSel = selectedRoleIds.Contains(r.Id);
                                        <div class="ms-combo-item @(isSel ? "sel" : "")" title="@r.Description"
                                             @onclick="() => ToggleRole(r.Id, !isSel)">
                                            <i class="bi @(isSel ? "bi-check-square-fill" : "bi-square")"></i>
                                            <span>@r.Name</span>
                                            @if (!string.IsNullOrWhiteSpace(r.Description))
                                            {
                                                <small class="text-muted ms-auto">@r.Description</small>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="fs-8 text-muted mt-1">
                        سطح ورود کاربر (مدیر / اپراتور / معرف) به‌صورت خودکار از نقش‌های انتخابی تعیین می‌شود.
                    </div>
                }
            </div>
            @if (IsReferrerSelected)
            {
                <div class="col-12">
                    <label class="form-label">معرف مرتبط <span class="text-danger">*</span></label>
                    <select class="form-select" @bind="referrerIdStr">
                        <option value="0">— بدون معرف —</option>
                        @foreach (var r in referrers)
                        {
                            <option value="@r.Id">@r.Name@(string.IsNullOrWhiteSpace(r.CompanyName) ? "" : $" ({r.CompanyName})")</option>
                        }
                    </select>
                </div>
            }
            <div class="col-12">
                <label class="form-label d-block">وضعیت</label>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="userStatus" id="userActive"
                           checked="@form.IsActive" @onchange="@(() => form.IsActive = true)" />
                    <label class="form-check-label" for="userActive">فعال</label>
                </div>
                <div class="form-check form-check-inline">
                    <input class="form-check-input" type="radio" name="userStatus" id="userInactive"
                           checked="@(!form.IsActive)" @onchange="@(() => form.IsActive = false)" />
                    <label class="form-check-label" for="userInactive">غیرفعال</label>
                </div>
            </div>
        </div>
        </ChildContent>
        <Footer>
            <button class="btn btn-light" @onclick="CloseModal">انصراف (Esc)</button>
            <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                ذخیره (F1)
            </button>
        </Footer>
    </Modal>
}

@code {
    private List<UserDto> items = new();
    private List<Referrer> referrers = new();
    private bool loading = true;

    private UserDto form = new();

    // ================== عکس کاربر لاگین ==================
    private long photoBust;
    private byte[]? luPhotoBytes;
    private string? luPhotoPreview;

    private async Task OnLoginUserPhotoPicked(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null || file.Size == 0) return;
        if (file.Size > 5 * 1024 * 1024) { saveError = "حداکثر حجم عکس ۵ مگابایت است."; StateHasChanged(); return; }
        var buf = new byte[file.Size];
        await file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024).ReadAsync(buf);
        luPhotoBytes = buf;
        luPhotoPreview = "data:" + (file.ContentType ?? "image/jpeg") + ";base64," + Convert.ToBase64String(buf);
        StateHasChanged();
    }

    private void ClearLoginUserPhoto()
    {
        luPhotoBytes = null;
        luPhotoPreview = null;
        StateHasChanged();
    }
    private string referrerIdStr = "0";
    private bool showModal, saving, syncing;

    private async Task SyncBale()
    {
        syncing = true;
        try
        {
            if (!string.IsNullOrWhiteSpace(Auth.Token))
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);
            var resp = await Http.PostAsync("/api/notifications/sync-bale", null);
            var res = await resp.Content.ReadFromJsonAsync<SyncRes>();
            if ((res?.Matched ?? 0) > 0) Toast.Success(res!.Message);
            else Toast.Error(res?.Message ?? "همگام‌سازی انجام نشد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { syncing = false; }
    }
    private class SyncRes { public int Matched { get; set; } public string Message { get; set; } = ""; }

    // ================== افراد مجاز دستور کار (بند ۶) ==================
    private HashSet<int> woAllowed = new();
    private string woSearch = "";

    private async Task LoadWoAllowed(int userId)
    {
        try
        {
            if (!string.IsNullOrWhiteSpace(Auth.Token))
                Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);
            var ids = await Http.GetFromJsonAsync<List<int>>($"/api/workorders/allowed/{userId}") ?? new();
            woAllowed = new HashSet<int>(ids);
        }
        catch { woAllowed = new(); }
    }

    private async Task SaveWoAllowed(int userId)
    {
        try { await Http.PostAsJsonAsync($"/api/workorders/allowed/{userId}", woAllowed.ToList()); } catch { }
    }
    private bool editing => form.Id != 0;

    // ================== نقش‌های RBAC (از بخش نقش‌ها و دسترسی‌ها) ==================
    private List<RoleOpt> allRoles = new();
    private HashSet<int> selectedRoleIds = new();

    // اپراتور نمی‌تواند نقش مدیر بدهد
    private IEnumerable<RoleOpt> SelectableRoles =>
        Auth.IsAdmin ? allRoles : allRoles.Where(r => !IsAdminRole(r.Name));

    private static bool IsAdminRole(string n) =>
        n.Equals("Admin", StringComparison.OrdinalIgnoreCase) || n.Contains("مدیر") || n.Contains("ادمین");

    private static bool IsReferrerRole(string n) =>
        n.Equals("Referrer", StringComparison.OrdinalIgnoreCase) || n.Contains("معرف");

    private bool IsReferrerSelected =>
        allRoles.Any(r => selectedRoleIds.Contains(r.Id) && IsReferrerRole(r.Name));

    private void ToggleRole(int roleId, bool isChecked)
    {
        if (isChecked) selectedRoleIds.Add(roleId);
        else selectedRoleIds.Remove(roleId);
    }

    // ================== کمبوی چندانتخابی نقش‌ها ==================
    private bool roleDropdownOpen;
    private string roleSearch = "";

    private void ToggleRoleDropdown() => roleDropdownOpen = !roleDropdownOpen;

    private IEnumerable<RoleOpt> FilteredRoles =>
        string.IsNullOrWhiteSpace(roleSearch)
            ? SelectableRoles
            : SelectableRoles.Where(r =>
                r.Name.Contains(roleSearch.Trim(), StringComparison.OrdinalIgnoreCase) ||
                (r.Description ?? "").Contains(roleSearch.Trim(), StringComparison.OrdinalIgnoreCase));

    public class RoleOpt
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("کاربران");
        if (!Auth.IsAdmin && !Auth.IsOperator) { loading = false; return; }
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            items = await AuthApi.GetUsersAsync();
            referrers = await ReferrerSvc.GetAllAsync(activeOnly: true);
            try { allRoles = (await Http.GetFromJsonAsync<List<RoleOpt>>("/api/roles") ?? new()).Where(r => r.IsActive).ToList(); }
            catch { allRoles = new(); }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenNew()
    {
        form = new UserDto { Role = Auth.IsAdmin ? "Admin" : "Operator", IsActive = true };
        referrerIdStr = "0";
        selectedRoleIds = new();
        roleDropdownOpen = false; roleSearch = "";
        saveError = "";
        luPhotoBytes = null; luPhotoPreview = null;
        showModal = true;
    }

    private void OpenEdit(UserDto u)
    {
        form = new UserDto
        {
            Id = u.Id, Username = u.Username, Role = u.Role,
            ReferrerId = u.ReferrerId, IsActive = u.IsActive, CreatedAt = u.CreatedAt
        };
        referrerIdStr = (u.ReferrerId ?? 0).ToString();
        selectedRoleIds = new HashSet<int>(u.RoleIds ?? new List<int>());
        roleDropdownOpen = false; roleSearch = "";
        saveError = "";
        woSearch = "";
        _ = LoadWoAllowed(u.Id);
        luPhotoBytes = null; luPhotoPreview = null;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private string saveError = "";

    private async Task Save()
    {
        saveError = "";

        if (string.IsNullOrWhiteSpace(form.Username))
        { saveError = "نام کاربری را وارد کنید."; return; }

        if (!editing && string.IsNullOrWhiteSpace(form.Password))
        { saveError = "رمز عبور را وارد کنید."; return; }

        if (allRoles.Count > 0 && selectedRoleIds.Count == 0)
        { saveError = "حداقل یک نقش برای کاربر انتخاب کنید."; return; }

        form.RoleIds = selectedRoleIds.ToList();
        form.ReferrerId = int.TryParse(referrerIdStr, out var rid) && rid > 0 ? rid : null;
        saving = true;
        try
        {
            var saved = await AuthApi.SaveUserAsync(form);
            if (luPhotoBytes != null)
            {
                try
                {
                    using var pf = new MultipartFormDataContent();
                    var pc = new ByteArrayContent(luPhotoBytes);
                    pc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue("image/jpeg");
                    pf.Add(pc, "file", "photo.jpg");
                    var pr = await Http.PostAsync($"/api/auth/users/photo/{saved.Id}", pf);
                    if (!pr.IsSuccessStatusCode)
                        Toast.Error("کاربر ذخیره شد ولی عکس ذخیره نشد.");
                }
                catch { Toast.Error("خطا در آپلود عکس."); }
            }
            luPhotoBytes = null; luPhotoPreview = null;
            photoBust++;
            if (Auth.IsAdmin && editing) await SaveWoAllowed(saved.Id);
            Toast.Success(editing ? "کاربر ویرایش شد." : "کاربر ثبت شد.");
            showModal = false;
            await Load();
        }
        catch (Exception ex) { saveError = ex.Message; Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Delete(UserDto u)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف کاربر «{u.Username}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await AuthApi.DeleteUserAsync(u.Id);
            Toast.Success("کاربر حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ================== برچسب و رنگ فارسی نقش‌های RBAC ==================
    private static string RoleLabel(string name) => name switch
    {
        "Admin"       => "مدیر کل",
        "Operator"    => "اپراتور",
        "Accountant"  => "حسابدار",
        "Referrer"    => "معرف",
        "HrManager"   => "مدیر منابع انسانی",
        "Employee"    => "کارمند",
        _             => name
    };

    private static string RoleBadgeClass(string name) => name switch
    {
        "Admin"      => "badge-soft-danger",
        "Operator"   => "badge-soft-warning",
        "Accountant" => "badge-soft-info",
        "Referrer"   => "badge-soft-success",
        "HrManager"  => "badge-soft-primary",
        "Employee"   => "badge-soft-muted",
        _            => "badge-soft-primary"
    };
}

