@namespace Inventory.Client.Pages
@page "/hr-main/section/{SectionId}"
@inject IAuthState Auth
<PageTitle>@(section?.Title ?? "منابع انسانی")</PageTitle>
<div class="page-head"><h1>@(section?.Title ?? "منابع انسانی")</h1><a class="btn btn-sm btn-outline-secondary" href="hr-main"><i class="bi bi-arrow-right" aria-hidden="true"></i> خانه منابع انسانی</a></div>
@if (section is null)
{
    <div class="alert alert-warning" role="alert">این بخش در دسترس شما نیست.</div>
}
else
{
    @if (section.Legacy)
    {
        <div class="small text-muted mb-3">مسیرهای پیشین بدون تغییر در داده‌ها و محاسبات نگه داشته شده‌اند.</div>
    }
    <HrLinkGrid Items="section.Items" />
}
@code {
    [Parameter] public string? SectionId { get; set; }
    private HrNavigation.Section? section;
    protected override void OnParametersSet() => section = HrNavigation.Visible(Auth.Has, Auth.IsAdmin).FirstOrDefault(s => s.Id == SectionId);
}
