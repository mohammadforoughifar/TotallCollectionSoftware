@namespace Inventory.Client.Pages
@* گره بازگشتی چارت بصری سازمانی *@

<li>
    <div class="org-box org-lv-@Node.Level @(!Node.IsActive ? "org-off" : "")">
        <div class="org-box-head"><i class="bi @HrMainUi.LevelIcon(Node.Level)"></i> @HrMainUi.OrgLevel(Node.Level)</div>
        <div class="org-box-name">@Node.Name</div>
        <div class="org-box-code num">@Node.Code</div>
        @if (!string.IsNullOrWhiteSpace(Node.ManagerTitle))
        {
            <div class="org-box-mgr">@Node.ManagerTitle</div>
        }
        @if (!string.IsNullOrWhiteSpace(Node.BranchName))
        {
            <div class="org-box-branch">@Node.BranchName</div>
        }
        @if (Node.EmployeeCount > 0 || Node.PositionCount > 0)
        {
            <div class="org-box-counts">
                @if (Node.EmployeeCount > 0)
                {
                    <span title="پرسنل فعال این واحد"><i class="bi bi-people-fill"></i> @Node.EmployeeCount.Num()</span>
                }
                @if (Node.PositionCount > 0)
                {
                    <span title="پست‌های سازمانی این واحد"><i class="bi bi-person-badge"></i> @Node.PositionCount.Num()</span>
                }
            </div>
        }
    </div>
    @if (Node.Children.Count > 0)
    {
        <ul>
            @foreach (var c in Node.Children)
            {
                <OrgChartNode Node="c" />
            }
        </ul>
    }
</li>

@code {
    [Parameter] public HrMainOrgNodeDto Node { get; set; } = default!;
}
