@namespace Inventory.Client.Pages
@page "/hr-main/settings"
@inject IAuthState Auth
<PageTitle>سازمان و تنظیمات</PageTitle>
<div class="page-head"><h1>سازمان و تنظیمات</h1><a class="btn btn-sm btn-outline-secondary" href="hr-main"><i class="bi bi-arrow-right" aria-hidden="true"></i> خانه منابع انسانی</a></div>
@if (items.Length == 0)
{
    <div class="alert alert-warning" role="alert">به بخش تنظیمات دسترسی ندارید.</div>
}
else
{
    <HrLinkGrid Items="items" />
}
@code {
    private HrNavigation.Entry[] items = [];
    protected override void OnParametersSet() => items = HrNavigation.Visible(Auth.Has, Auth.IsAdmin).Where(s => s.Id is "org" or "setup").SelectMany(s => s.Items).Where(i => i.Href != "hr-main/settings").ToArray();
}
