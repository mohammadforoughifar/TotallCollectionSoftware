@namespace Inventory.Client.Pages
@page "/hr-main/my"
@inject IHrTalentService Svc
@inject IToastService Toast

<PageTitle>پرونده‌ی من</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1><i class="bi bi-person-vcard"></i> پرونده‌ی من</h1>
        <div class="lead">مشاهده‌ی اطلاعات پرسنلی و درخواست اصلاح اطلاعات تماس</div>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    return;
}

@if (profile is null)
{
    <div class="alert alert-info">
        پرونده‌ی پرسنلی برای حساب کاربری شما ثبت نشده است. در صورت نیاز با واحد منابع انسانی تماس بگیرید.
    </div>
    return;
}

@if (profile.PendingRequestId is > 0)
{
    <div class="alert alert-warning">
        <i class="bi bi-hourglass-split"></i>
        درخواست ویرایش شماره‌ی <span class="num">@profile.PendingRequestId.Value.Num()</span> شما در انتظار تأیید منابع انسانی است.
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-bold"><i class="bi bi-person text-primary"></i> مشخصات</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">کد پرسنلی</span><b class="num">@profile.Code</b></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">نام و نام خانوادگی</span><b>@profile.FirstName @profile.LastName</b></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">کد ملی</span><span class="num">@profile.NationalCode</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">تاریخ تولد</span><span>@(profile.BirthDate?.ToFa() ?? "—")</span></li>
            </ul>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white fw-bold"><i class="bi bi-briefcase text-primary"></i> وضعیت شغلی</div>
            <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">تاریخ استخدام</span><span>@profile.HireDate.ToFa()</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">واحد سازمانی</span><span>@(profile.OrgNodeName ?? profile.PostTitle ?? "—")</span></li>
                <li class="list-group-item d-flex justify-content-between"><span class="text-muted">پست سازمانی</span><span>@(profile.PositionTitle ?? "—")</span></li>
            </ul>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-4">
    <div class="card-header bg-white fw-bold"><i class="bi bi-telephone text-primary"></i> اطلاعات تماس (فعلی)</div>
    <ul class="list-group list-group-flush">
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">موبایل</span><span class="num">@(profile.Mobile ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">ایمیل</span><span>@(profile.Email ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">تلفن ثابت</span><span class="num">@(profile.Landline ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">نشانی</span><span>@(profile.Address ?? "—")</span></li>
        <li class="list-group-item d-flex justify-content-between"><span class="text-muted">تماس اضطراری</span><span>@(string.IsNullOrWhiteSpace(profile.EmergencyContactName) ? "—" : $"{profile.EmergencyContactName}{(string.IsNullOrWhiteSpace(profile.EmergencyContactRelation) ? "" : $" ({profile.EmergencyContactRelation})")} — {profile.EmergencyContactPhone}")</span></li>
    </ul>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold"><i class="bi bi-pencil-square text-primary"></i> درخواست اصلاح اطلاعات تماس</div>
    <div class="card-body">
        <div class="alert alert-secondary small">
            فقط فیلدهایی را پر کنید که می‌خواهید تغییر کنند؛ فیلدهای خالی ارسال نمی‌شوند. تغییرات پس از تأیید واحد منابع انسانی اعمال می‌شود.
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">موبایل جدید</label><input class="form-control num" @bind="form.Mobile" placeholder="@profile.Mobile" /></div>
            <div class="col-md-6"><label class="form-label">ایمیل جدید</label><input class="form-control" @bind="form.Email" placeholder="@profile.Email" /></div>
            <div class="col-md-6"><label class="form-label">تلفن ثابت جدید</label><input class="form-control num" @bind="form.Landline" placeholder="@profile.Landline" /></div>
            <div class="col-md-6"><label class="form-label">نام تماس اضطراری جدید</label><input class="form-control" @bind="form.EmergencyContactName" /></div>
            <div class="col-md-6"><label class="form-label">نسبت تماس اضطراری</label><input class="form-control" @bind="form.EmergencyContactRelation" /></div>
            <div class="col-md-6"><label class="form-label">شماره تماس اضطراری</label><input class="form-control num" @bind="form.EmergencyContactPhone" /></div>
            <div class="col-12"><label class="form-label">نشانی جدید</label><input class="form-control" @bind="form.Address" /></div>
            <div class="col-12"><label class="form-label">دلیل درخواست (اختیاری)</label><input class="form-control" @bind="form.Reason" /></div>
            <div class="col-12">
                <button class="btn btn-primary" disabled="@(saving || profile.PendingRequestId is > 0)" @onclick="Submit">
                    <i class="bi bi-send"></i> @(saving ? "در حال ارسال…" : "ارسال درخواست")
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private HrMyProfileDto? profile;
    private HrProfileEditRequestSaveDto form = new();
    private bool loading = true, saving;

    protected override async Task OnInitializedAsync()
    {
        try { profile = await Svc.GetMyProfileAsync(); }
        catch { profile = null; }
        finally { loading = false; }
    }

    private async Task Submit()
    {
        saving = true;
        try
        {
            await Svc.SubmitMyProfileEditAsync(form);
            Toast.Success("درخواست شما ثبت شد و پس از تأیید منابع انسانی اعمال می‌شود.");
            form = new HrProfileEditRequestSaveDto();
            profile = await Svc.GetMyProfileAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }
}
