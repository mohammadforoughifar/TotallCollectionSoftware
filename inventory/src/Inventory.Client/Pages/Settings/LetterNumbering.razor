@page "/settings/letter-numbering"
@inject ILetterService LetterSvc
@inject IToastService Toast
@inject LayoutState Layout

@* ============================================================
   تنظیمات ساختار شماره نامه (اندیکاتور)
   • انتخاب اجزای شماره و تعیین ترتیب آن‌ها (بالا/پایین)
   • جداکننده، پیشوند/پسوند، متن‌های دلخواه
   • تعداد ارقام سال و سریال، شماره شروع، گام، قاعده‌ی ریست
   • پیش‌نمایش زنده — همین ساختار روی نامه‌های جدید اعمال می‌شود
   ============================================================ *@

<PageTitle>ساختار شماره نامه</PageTitle>

<div class="page-head">
    <div>
        <h1><i class="bi bi-123"></i> ساختار شماره نامه</h1>
        <p class="lead">اجزای شماره اندیکاتور، ترتیب آن‌ها و قاعده‌ی شمارنده — روی نامه‌های جدید اعمال می‌شود</p>
    </div>
    <a href="/settings" class="btn btn-outline-secondary"><i class="bi bi-arrow-right"></i> بازگشت به تنظیمات</a>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-3">

        @* ---------------- اجزا و ترتیب ---------------- *@
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-list-ol text-primary"></i>
                    <span class="card-title">اجزای شماره و ترتیب آن‌ها</span>
                </div>
                <div class="card-body">
                    <p class="fs-8 text-muted">
                        اجزای انتخاب‌شده به همین ترتیب (از راست به چپ در شماره) کنار هم قرار می‌گیرند.
                        جزء «شماره ترتیبی» الزامی است.
                    </p>

                    <div class="lnum-list">
                        @for (int i = 0; i < model.Parts.Count; i++)
                        {
                            var idx = i;
                            var code = model.Parts[i];
                            <div class="lnum-item">
                                <span class="ord">@((idx + 1).ToString().FaDigits())</span>
                                <span class="ttl">@PartTitle(code)</span>
                                <span class="smp">@SampleOf(code)</span>
                                <span class="acts">
                                    <button class="btn btn-sm btn-light" title="بالا" disabled="@(idx == 0)" @onclick="() => Move(idx, -1)"><i class="bi bi-chevron-up"></i></button>
                                    <button class="btn btn-sm btn-light" title="پایین" disabled="@(idx == model.Parts.Count - 1)" @onclick="() => Move(idx, 1)"><i class="bi bi-chevron-down"></i></button>
                                    <button class="btn btn-sm btn-outline-danger" title="حذف" @onclick="() => RemovePart(idx)"><i class="bi bi-x-lg"></i></button>
                                </span>
                            </div>
                        }
                        @if (model.Parts.Count == 0)
                        {
                            <div class="text-muted small py-2">هیچ جزئی انتخاب نشده — از پایین اضافه کنید.</div>
                        }
                    </div>

                    <div class="mt-3">
                        <label class="form-label small fw-700">افزودن جزء</label>
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var p in parts.Where(p => !model.Parts.Contains(p.Code)))
                            {
                                var pp = p;
                                <button class="btn btn-sm btn-outline-primary rounded-pill" @onclick="() => AddPart(pp.Code)">
                                    <i class="bi bi-plus-lg"></i> @pp.Title
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- پارامترها ---------------- *@
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-sliders text-primary"></i>
                    <span class="card-title">پارامترهای شماره‌گذاری</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label small fw-700">جداکننده</label>
                            <input class="form-control form-control-sm num" dir="ltr" maxlength="5"
                                   value="@model.Separator" @onchange="OnSeparatorChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-700">پیشوند ثابت</label>
                            <input class="form-control form-control-sm" placeholder="مثلاً ف‌آ"
                                   value="@model.Prefix" @onchange="OnPrefixChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-700">پسوند ثابت</label>
                            <input class="form-control form-control-sm"
                                   value="@model.Suffix" @onchange="OnSuffixChanged" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-700">متن دلخواه ۱</label>
                            <input class="form-control form-control-sm"
                                   value="@model.Text1" @onchange="OnText1Changed" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-700">متن دلخواه ۲</label>
                            <input class="form-control form-control-sm"
                                   value="@model.Text2" @onchange="OnText2Changed" />
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-700">تعداد ارقام سال</label>
                            <select class="form-select form-select-sm" @onchange="OnYearDigitsChanged">
                                <option value="4" selected="@(model.YearDigits == 4)">۴ رقمی (۱۴۰۴)</option>
                                <option value="2" selected="@(model.YearDigits == 2)">۲ رقمی (۰۴)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-700">تعداد ارقام سریال (۰ = بدون صفر ابتدایی)</label>
                            <input type="number" min="0" max="10" class="form-control form-control-sm num" dir="ltr"
                                   value="@model.SerialDigits" @onchange="OnSerialDigitsChanged" />
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-700">شماره شروع</label>
                            <input type="number" min="0" class="form-control form-control-sm num" dir="ltr"
                                   value="@model.StartNumber" @onchange="OnStartNumberChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-700">گام افزایش</label>
                            <input type="number" min="1" class="form-control form-control-sm num" dir="ltr"
                                   value="@model.Step" @onchange="OnStepChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-700">صفر شدن شمارنده</label>
                            <select class="form-select form-select-sm" @onchange="OnResetPolicyChanged">
                                <option value="Yearly" selected="@(model.ResetPolicy == "Yearly")">هر سال شمسی</option>
                                <option value="Monthly" selected="@(model.ResetPolicy == "Monthly")">هر ماه شمسی</option>
                                <option value="Never" selected="@(model.ResetPolicy == "Never")">هرگز (پیوسته)</option>
                            </select>
                        </div>

                        <div class="col-md-4">
                            <label class="form-label small fw-700">کد واحد پیش‌فرض</label>
                            <input class="form-control form-control-sm"
                                   value="@model.DefaultDeptCode" @onchange="OnDeptCodeChanged" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-700">کد شرکت پیش‌فرض</label>
                            <input class="form-control form-control-sm"
                                   value="@model.DefaultCompanyCode" @onchange="OnCompanyCodeChanged" />
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="faDig" checked="@model.UsePersianDigits"
                                       @onchange="OnFaDigitsChanged" />
                                <label class="form-check-label small fw-700" for="faDig">ذخیره‌ی شماره با ارقام فارسی</label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        @* ---------------- پیش‌نمایش ---------------- *@
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-eye text-primary"></i>
                    <span class="card-title">پیش‌نمایش شماره‌ی نامه‌ی بعدی</span>
                </div>
                <div class="card-body d-flex flex-wrap align-items-center gap-3">
                    <div class="lnum-preview num">@(string.IsNullOrEmpty(preview) ? "—" : preview)</div>
                    <div class="small text-muted">
                        <div><i class="bi bi-hash"></i> شماره ترتیبی بعدی: <b class="num">@model.NextSerial.ToString().FaDigits()</b></div>
                        <div><i class="bi bi-info-circle"></i> این ساختار دقیقاً روی نامه‌های داخلی جدید اعمال می‌شود (نامه‌های قبلی تغییر نمی‌کنند).</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-outline-secondary" @onclick="Reload"><i class="bi bi-arrow-counterclockwise"></i> بازخوانی</button>
        <button class="btn btn-primary" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-check2"></i> ذخیره ساختار شماره
        </button>
    </div>
}

<style>
    .lnum-list { display: flex; flex-direction: column; gap: .4rem; }
    .lnum-item { display: flex; align-items: center; gap: .6rem; border: 1px solid #e8e2fb; border-radius: 12px; padding: .45rem .7rem; background: #fbfaff; }
    .lnum-item .ord { width: 24px; height: 24px; border-radius: 8px; background: #ede9fe; color: #6d28d9; font-weight: 800; font-size: .78rem; display: flex; align-items: center; justify-content: center; }
    .lnum-item .ttl { font-weight: 700; font-size: .86rem; }
    .lnum-item .smp { font-size: .76rem; color: #8a90a5; direction: ltr; }
    .lnum-item .acts { margin-inline-start: auto; display: flex; gap: .25rem; }
    .lnum-preview { font-size: 1.6rem; font-weight: 900; color: #6d28d9; background: #f5f3ff; border: 1px dashed #ddd6fe; border-radius: 14px; padding: .5rem 1.4rem; direction: ltr; }
</style>

@code {
    private LetterNumberSettingDto model = new();
    private List<LetterNumberPartDto> parts = new();
    private string preview = "";
    private bool loading = true, saving;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("ساختار شماره نامه");
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try
        {
            parts = await LetterSvc.GetNumberPartsAsync();
            model = await LetterSvc.GetNumberSettingsAsync();
            preview = model.Preview ?? "";
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private string PartTitle(string code) =>
        parts.FirstOrDefault(p => p.Code == code)?.Title ?? code;

    /// <summary>نمونه‌ی مقدار هر جزء برای راهنمایی کاربر</summary>
    private string SampleOf(string code) => code switch
    {
        "prefix" => model.Prefix ?? "(خالی)",
        "suffix" => model.Suffix ?? "(خالی)",
        "text1" => model.Text1 ?? "(خالی)",
        "text2" => model.Text2 ?? "(خالی)",
        "year" => model.YearDigits == 2 ? "04" : "1404",
        "month" => "06",
        "day" => "19",
        "dept" => model.DefaultDeptCode ?? "کد واحد کاربر",
        "company" => model.DefaultCompanyCode ?? "کد شرکت کاربر",
        "user" => "شناسه کاربر",
        "serial" => model.SerialDigits > 0 ? new string('0', Math.Max(0, model.SerialDigits - 2)) + "12" : "12",
        _ => ""
    };

    private async Task OnPrefixChanged(ChangeEventArgs e)
    {
        model.Prefix = e.Value?.ToString();
        await Preview();
    }

    private async Task OnSuffixChanged(ChangeEventArgs e)
    {
        model.Suffix = e.Value?.ToString();
        await Preview();
    }

    private async Task OnText1Changed(ChangeEventArgs e)
    {
        model.Text1 = e.Value?.ToString();
        await Preview();
    }

    private async Task OnText2Changed(ChangeEventArgs e)
    {
        model.Text2 = e.Value?.ToString();
        await Preview();
    }

    private async Task OnSerialDigitsChanged(ChangeEventArgs e)
    {
        model.SerialDigits = Math.Clamp(ToInt(e.Value, 0), 0, 10);
        await Preview();
    }

    private async Task OnStartNumberChanged(ChangeEventArgs e)
    {
        model.StartNumber = Math.Max(0, ToInt(e.Value, 1));
        await Preview();
    }

    private async Task OnStepChanged(ChangeEventArgs e)
    {
        model.Step = Math.Max(1, ToInt(e.Value, 1));
        await Preview();
    }

    private async Task OnDeptCodeChanged(ChangeEventArgs e)
    {
        model.DefaultDeptCode = e.Value?.ToString();
        await Preview();
    }

    private async Task OnCompanyCodeChanged(ChangeEventArgs e)
    {
        model.DefaultCompanyCode = e.Value?.ToString();
        await Preview();
    }

    private async Task OnFaDigitsChanged(ChangeEventArgs e)
    {
        model.UsePersianDigits = e.Value is bool b && b;
        await Preview();
    }

    private async Task OnSeparatorChanged(ChangeEventArgs e)
    {
        model.Separator = e.Value?.ToString() ?? "";
        await Preview();
    }

    private async Task OnYearDigitsChanged(ChangeEventArgs e)
    {
        model.YearDigits = ToInt(e.Value, 4);
        await Preview();
    }

    private async Task OnResetPolicyChanged(ChangeEventArgs e)
    {
        model.ResetPolicy = e.Value?.ToString() ?? "Yearly";
        await Preview();
    }

    private static int ToInt(object? v, int fallback) =>
        int.TryParse(v?.ToString(), out var n) ? n : fallback;

    private async Task AddPart(string code)
    {
        if (!model.Parts.Contains(code)) model.Parts.Add(code);
        await Preview();
    }

    private async Task RemovePart(int idx)
    {
        if (idx >= 0 && idx < model.Parts.Count) model.Parts.RemoveAt(idx);
        await Preview();
    }

    /// <summary>جابه‌جایی جزء در ترتیب شماره (بالا/پایین)</summary>
    private async Task Move(int idx, int delta)
    {
        var to = idx + delta;
        if (to < 0 || to >= model.Parts.Count) return;
        (model.Parts[idx], model.Parts[to]) = (model.Parts[to], model.Parts[idx]);
        await Preview();
    }

    /// <summary>پیش‌نمایش زنده از سرور (تا دقیقاً همان چیزی که ذخیره می‌شود دیده شود)</summary>
    private async Task Preview()
    {
        if (model.Parts.Count == 0) { preview = ""; StateHasChanged(); return; }
        try
        {
            preview = await LetterSvc.PreviewNumberAsync(model);
        }
        catch { /* پیش‌نمایش حیاتی نیست */ }
        StateHasChanged();
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            model = await LetterSvc.SaveNumberSettingsAsync(model);
            preview = model.Preview ?? "";
            Toast.Success("ساختار شماره نامه ذخیره شد و روی نامه‌های جدید اعمال می‌شود.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }
}
