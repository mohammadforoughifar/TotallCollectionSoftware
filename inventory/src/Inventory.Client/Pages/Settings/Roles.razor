@page "/settings/roles"
@inject HttpClient Http
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>مدیریت نقش‌ها و دسترسی‌ها</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1 class="mb-1">نقش‌ها و دسترسی‌ها</h1>
        <p class="lead text-muted">مدیریت نقش‌ها و تخصیص دسترسی‌های ماژولار</p>
    </div>
    <button class="btn btn-primary btn-lg shadow-sm" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-2"></i> ایجاد نقش جدید
    </button>
</div>

<!-- Stats -->
<div class="row g-3 mb-4">
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                        <i class="bi bi-shield-lock fs-2"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">تعداد نقش‌ها</div>
                    <div class="fs-3 fw-bold">@roles.Count</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3">
                        <i class="bi bi-check2-circle fs-2"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">نقش‌های فعال</div>
                    <div class="fs-3 fw-bold">@roles.Count(r => r.IsActive)</div>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 col-sm-6 col-md-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body d-flex align-items-center gap-3">
                <div class="flex-shrink-0">
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3">
                        <i class="bi bi-key fs-2"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small">تعداد دسترسی‌ها</div>
                    <div class="fs-3 fw-bold">@allPermissions.Count</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Roles Table -->
<div class="card shadow-sm">
    <div class="card-header bg-white">
        <h6 class="mb-0 fw-bold">لیست نقش‌ها</h6>
    </div>
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (roles.Count == 0)
        {
            <div class="text-center py-5">
                <i class="bi bi-shield-slash fs-1 text-muted"></i>
                <p class="mt-3 text-muted">هیچ نقشی تعریف نشده است</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4">نام نقش</th>
                            <th>توضیحات</th>
                            <th>وضعیت</th>
                            <th class="text-end pe-4">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var role in roles)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-700">@role.Name</div>
                                </td>
                                <td class="text-muted">@role.Description</td>
                                <td>
                                    @if (role.IsActive)
                                    {
                                        <span class="badge bg-success-subtle text-success px-3 py-2">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary px-3 py-2">غیرفعال</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex gap-2 justify-content-end">
                                        <button class="role-btn role-btn-edit" title="ویرایش نقش" @onclick="() => OpenEditModal(role)">
                                            <i class="bi bi-pencil-fill"></i>
                                        </button>
                                        <button class="role-btn role-btn-del" title="حذف نقش" @onclick="() => DeleteRole(role)">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@* Professional Modal *@
@if (showModal)
{
    <div class="modal fade show d-block" style="background:rgba(0,0,0,.6)" @onclick="CloseModal">
        <div class="modal-dialog modal-xl modal-dialog-centered" @onclick:stopPropagation="true">
            <div class="modal-content border-0 shadow-lg" style="border-radius:16px;">
                <div class="modal-header border-0 pb-0">
                    <div>
                        <h5 class="modal-title fw-bold">@(editingRole != null ? "ویرایش نقش" : "ایجاد نقش جدید")</h5>
                        <p class="text-muted small mb-0">تعیین دسترسی‌های ماژولار</p>
                    </div>
                    <button type="button" class="btn-close" @onclick="CloseModal"></button>
                </div>

                <div class="modal-body pt-3">
                    <!-- Role Info -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <label class="form-label small fw-600">نام نقش <span class="text-danger">*</span></label>
                            <input class="form-control form-control-lg" @bind="form.Name" placeholder="مثال: مدیر سیستم" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-600">توضیحات</label>
                            <input class="form-control form-control-lg" @bind="form.Description" placeholder="توضیح مختصر نقش" />
                        </div>
                        <div class="col-12">
                            <div class="form-check form-switch">
                                <input class="form-check-input" type="checkbox" role="switch" id="isActive" @bind="form.IsActive" />
                                <label class="form-check-label fw-500" for="isActive">نقش فعال باشد</label>
                            </div>
                        </div>
                    </div>

                    <div class="border-top pt-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="fw-bold mb-0">دسترسی‌ها</h6>
                            <span class="badge bg-light text-dark">@selectedPermissionIds.Count از @allPermissions.Count</span>
                        </div>

                        @if (allPermissions.Any())
                        {
                            @* ================== دسترسی‌ها دسته‌بندی‌شده بر اساس ماژول ================== *@
                            @foreach (var cat in ModuleCategories)
                            {
                                var catGroups = allPermissions
                                    .Where(p => cat.Modules.Contains(p.Module))
                                    .GroupBy(p => p.Module)
                                    .OrderBy(g => Array.IndexOf(cat.Modules, g.Key))
                                    .ToList();
                                if (!catGroups.Any()) continue;

                                <div class="perm-cat mb-4">
                                    <div class="perm-cat-head">
                                        <i class="bi @cat.Icon"></i>
                                        <span>@cat.Title</span>
                                        <span class="perm-cat-line"></span>
                                    </div>
                                    <div class="row g-3">
                                        @foreach (var group in catGroups)
                                        {
                                            <div class="col-lg-4 col-md-6">
                                                <div class="card border h-100">
                                                    <div class="card-header bg-light py-2 px-3">
                                                        <strong class="text-primary mb-0">@(ModuleNames.GetValueOrDefault(group.Key, group.Key))</strong>
                                                    </div>
                                                    <div class="card-body py-2">
                                                        <!-- Select All -->
                                                        <div class="form-check py-1 border-bottom pb-2 mb-1">
                                                            <input class="form-check-input" type="checkbox"
                                                                   checked="@group.All(p => selectedPermissionIds.Contains(p.Id))"
                                                                   @onchange="e => ToggleModuleAll(group.Key, (bool)e.Value!)" />
                                                            <label class="form-check-label fw-bold text-primary">همه</label>
                                                        </div>

                                                        @foreach (var perm in group.OrderBy(p => p.Action))
                                                        {
                                                            <div class="form-check py-1">
                                                                <input class="form-check-input" type="checkbox"
                                                                       checked="@selectedPermissionIds.Contains(perm.Id)"
                                                                       @onchange="e => TogglePermission(perm.Id, (bool)e.Value!)" />
                                                                <label class="form-check-label">@(ActionNames.GetValueOrDefault(perm.Action, perm.Action))</label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }

                            @* ماژول‌هایی که در هیچ دسته‌ای نیستند *@
                            var knownModules = ModuleCategories.SelectMany(c => c.Modules).ToHashSet();
                            var otherGroups = allPermissions.Where(p => !knownModules.Contains(p.Module)).GroupBy(p => p.Module).ToList();
                            if (otherGroups.Any())
                            {
                                <div class="perm-cat mb-4">
                                    <div class="perm-cat-head">
                                        <i class="bi bi-three-dots"></i>
                                        <span>سایر</span>
                                        <span class="perm-cat-line"></span>
                                    </div>
                                    <div class="row g-3">
                                        @foreach (var group in otherGroups)
                                        {
                                            <div class="col-lg-4 col-md-6">
                                                <div class="card border h-100">
                                                    <div class="card-header bg-light py-2 px-3">
                                                        <strong class="text-primary mb-0">@(ModuleNames.GetValueOrDefault(group.Key, group.Key))</strong>
                                                    </div>
                                                    <div class="card-body py-2">
                                                        <div class="form-check py-1 border-bottom pb-2 mb-1">
                                                            <input class="form-check-input" type="checkbox"
                                                                   checked="@group.All(p => selectedPermissionIds.Contains(p.Id))"
                                                                   @onchange="e => ToggleModuleAll(group.Key, (bool)e.Value!)" />
                                                            <label class="form-check-label fw-bold text-primary">همه</label>
                                                        </div>
                                                        @foreach (var perm in group.OrderBy(p => p.Action))
                                                        {
                                                            <div class="form-check py-1">
                                                                <input class="form-check-input" type="checkbox"
                                                                       checked="@selectedPermissionIds.Contains(perm.Id)"
                                                                       @onchange="e => TogglePermission(perm.Id, (bool)e.Value!)" />
                                                                <label class="form-check-label">@(ActionNames.GetValueOrDefault(perm.Action, perm.Action))</label>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button class="btn btn-light px-4" @onclick="CloseModal">انصراف</button>
                    <button class="btn btn-primary px-4" @onclick="SaveRole" disabled="@saving">
                        @if (saving)
                        {
                            <span class="spinner-border spinner-border-sm me-2"></span>
                        }
                        ذخیره نقش
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .page-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: .75rem;
    }
    .modal-xl {
        max-width: 1100px;
    }
    /* ===== دکمه‌های ویرایش/حذف ===== */
    .role-btn {
        width: 36px; height: 32px;
        display: inline-flex; align-items: center; justify-content: center;
        padding: 0; border-radius: 10px; border: 1px solid transparent;
        font-size: .85rem; cursor: pointer; transition: all .15s ease;
    }
    .role-btn-edit { background: #eef4ff; color: #2563eb; }
    .role-btn-edit:hover { background: #2563eb; color: #fff; transform: translateY(-1px); box-shadow: 0 4px 10px rgba(37,99,235,.35); }
    .role-btn-del { background: #fdecec; color: #dc3545; }
    .role-btn-del:hover { background: #dc3545; color: #fff; transform: translateY(-1px); box-shadow: 0 4px 10px rgba(220,53,69,.35); }
    /* ===== هدر دسته‌بندی دسترسی‌ها ===== */
    .perm-cat-head {
        display: flex; align-items: center; gap: .5rem;
        font-weight: 700; font-size: .95rem; color: #334155;
        margin-bottom: .75rem;
    }
    .perm-cat-head i { color: var(--bs-primary, #2563eb); font-size: 1.1rem; }
    .perm-cat-line { flex: 1; height: 1px; background: linear-gradient(to left, #e2e8f0, transparent); }
    /* ===== رسپانسیو کارت‌های آمار ===== */
    @@media (max-width: 575.98px) {
        .fs-3.fw-bold { font-size: 1.35rem !important; }
    }
</style>

@code {
    private List<RoleDto> roles = new();
    private List<PermissionDto> allPermissions = new();
    private bool loading = true;
    private bool showModal = false;
    private bool saving = false;
    private RoleDto? editingRole = null;

    private RoleForm form = new();
    private HashSet<int> selectedPermissionIds = new();

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        loading = true;
        try
        {
            roles = await Http.GetFromJsonAsync<List<RoleDto>>("/api/roles") ?? new();
            allPermissions = await Http.GetFromJsonAsync<List<PermissionDto>>("/api/permissions") ?? new();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenCreateModal()
    {
        editingRole = null;
        form = new RoleForm { IsActive = true };
        selectedPermissionIds.Clear();
        showModal = true;
    }

    private async Task OpenEditModal(RoleDto role)
    {
        editingRole = role;
        form = new RoleForm { Name = role.Name, Description = role.Description, IsActive = role.IsActive };

        try
        {
            var perms = await Http.GetFromJsonAsync<List<int>>($"/api/roles/{role.Id}/permissions") ?? new();
            selectedPermissionIds = new HashSet<int>(perms);
        }
        catch { selectedPermissionIds.Clear(); }

        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private void TogglePermission(int id, bool isChecked)
    {
        if (isChecked) selectedPermissionIds.Add(id);
        else selectedPermissionIds.Remove(id);
    }

    private void ToggleModuleAll(string module, bool isChecked)
    {
        var modulePerms = allPermissions.Where(p => p.Module == module).Select(p => p.Id);
        if (isChecked)
        {
            foreach (var id in modulePerms)
                selectedPermissionIds.Add(id);
        }
        else
        {
            foreach (var id in modulePerms)
                selectedPermissionIds.Remove(id);
        }
    }

    private async Task SaveRole()
    {
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            Toast.Error("نام نقش الزامی است");
            return;
        }

        saving = true;
        try
        {
            var payload = new RoleDto
            {
                Id = editingRole?.Id ?? 0,
                Name = form.Name,
                Description = form.Description,
                IsActive = form.IsActive,
                PermissionIds = selectedPermissionIds.ToList()
            };

            if (editingRole == null)
                await Http.PostAsJsonAsync("/api/roles", payload);
            else
                await Http.PutAsJsonAsync($"/api/roles/{editingRole.Id}", payload);

            Toast.Success("نقش با موفقیت ذخیره شد");
            CloseModal();
            await LoadData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteRole(RoleDto role)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"آیا از حذف نقش «{role.Name}» مطمئن هستید؟")) return;

        try
        {
            await Http.DeleteAsync($"/api/roles/{role.Id}");
            Toast.Success("نقش حذف شد");
            await LoadData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private class RoleForm
    {
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; } = true;
    }

    public class RoleDto
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string? Description { get; set; }
        public bool IsActive { get; set; }
        public List<int> PermissionIds { get; set; } = new();
