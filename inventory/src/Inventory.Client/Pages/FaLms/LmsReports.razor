@namespace Inventory.Client.Pages
@page "/fa-lms/reports"
@inject IFaLmsService Svc
@inject IHrCoreService EmpSvc
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>اثربخشی آموزش</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1><i class="bi bi-bar-chart"></i> اثربخشی آموزش</h1>
        <div class="lead">گزارش عملکرد دوره‌ها و کارنامه آموزشی هر پرسنل</div>
    </div>
</div>

@if (!faManage)
{
    <div class="alert alert-warning">این صفحه مخصوص واحد آموزش است.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-bold"><i class="bi bi-collection"></i> گزارش دوره</div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-md-6"><select class="form-select" @bind="repCourseId">@foreach (var c in courses){<option value="@c.Id">@c.Title (@c.Code)</option>}</select></div>
            <div class="col-md-2"><button class="btn btn-primary" @onclick="LoadCourseReport">نمایش</button></div>
        </div>
        @if (courseRep != null)
        {
            <div class="row g-2">
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(courseRep.ApprovedCount)<span class="text-muted small"> / @FaLmsUi.Num(courseRep.EnrolledCount)</span></div><div class="text-muted small">تأییدشده / کل</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(courseRep.AvgScore)</div><div class="text-muted small">میانگین نمره</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold text-success num">@FaLmsUi.Num(courseRep.PassRate)٪</div><div class="text-muted small">نرخ قبولی</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(courseRep.AvgAttendance)٪</div><div class="text-muted small">میانگین حضور</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(courseRep.SessionsCount)</div><div class="text-muted small">جلسات</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(courseRep.IssuedCerts)</div><div class="text-muted small">گواهی</div></div></div>
            </div>
        }
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-bold"><i class="bi bi-person-lines-fill"></i> کارنامه آموزشی پرسنل</div>
    <div class="card-body">
        <div class="row g-2 mb-3">
            <div class="col-md-6"><select class="form-select" @bind="repEmpId">@foreach (var e in emps){<option value="@e.Id">@e.FirstName @e.LastName</option>}</select></div>
            <div class="col-md-2"><button class="btn btn-primary" @onclick="LoadEmpReport">نمایش</button></div>
        </div>
        @if (empRep != null)
        {
            <div class="row g-2 mb-3">
                <div class="col-6 col-md-3"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(empRep.CoursesCount)</div><div class="text-muted small">دوره</div></div></div>
                <div class="col-6 col-md-3"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(empRep.HoursTotal)</div><div class="text-muted small">ساعت آموزش</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(empRep.AvgScore)</div><div class="text-muted small">میانگین نمره</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(empRep.AvgAttendance)٪</div><div class="text-muted small">میانگین حضور</div></div></div>
                <div class="col-6 col-md-2"><div class="border rounded text-center py-2"><div class="fw-bold num">@FaLmsUi.Num(empRep.CertsCount)</div><div class="text-muted small">گواهی</div></div></div>
            </div>
            @if (empRep.Rows.Count == 0)
            {
                <div class="text-center text-muted py-3">سابقه آموزشی ثبت نشده است.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-hover align-middle">
                    <thead class="table-light"><tr><th>دوره</th><th>سال</th><th>ساعت</th><th>وضعیت</th><th>نمره</th><th>حضور٪</th><th>گواهی</th></tr></thead>
                    <tbody>
                        @foreach (var r in empRep.Rows)
                        {
                            <tr>
                                <td><a href="@CourseUrl(r.CourseId)">@r.CourseTitle</a></td>
                                <td class="num">@FaLmsUi.Num(r.Year)</td>
                                <td class="num">@FaLmsUi.Num(r.Hours)</td>
                                <td><span class="badge @FaLmsUi.EnrollBadge(r.Status)">@FaLmsUi.EnrollStatus(r.Status)</span></td>
                                <td class="num">@FaLmsUi.Num(r.Score)</td>
                                <td class="num">@FaLmsUi.Num(r.Attendance)</td>
                                <td>@if (r.HasCert){<i class="bi bi-award-fill text-success"></i>}else{<span class="text-muted">—</span>}</td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        }
    </div>
</div>

@code {
    private static string CourseUrl(int id) => "fa-lms/courses/" + id;
    private bool faManage => Auth.Has("FaLms.Manage") || Auth.IsAdmin;
    private List<FaLmsCourseDto> courses = new();
    private List<HrEmployeeDto> emps = new();
    private int repCourseId, repEmpId;
    private FaLmsCourseReportDto? courseRep;
    private FaLmsEmployeeReportDto? empRep;

    protected override async Task OnInitializedAsync()
    {
        if (!faManage) return;
        try
        {
            courses = await Svc.ListCoursesAsync(null, null, null, null);
            emps = (await EmpSvc.SearchEmployeesAsync(null, null, 0, 0, 500)).Items;
            repCourseId = courses.FirstOrDefault()?.Id ?? 0;
            repEmpId = emps.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task LoadCourseReport()
    {
        try { courseRep = await Svc.GetCourseReportAsync(repCourseId); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task LoadEmpReport()
    {
        try { empRep = await Svc.EmployeeReportAsync(repEmpId); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
