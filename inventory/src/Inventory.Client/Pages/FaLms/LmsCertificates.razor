@namespace Inventory.Client.Pages
@page "/fa-lms/certificates"
@inject IFaLmsService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>گواهی‌های آموزشی</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1><i class="bi bi-award"></i> گواهی‌های آموزشی</h1>
        <div class="lead">فهرست گواهی‌های داخلی + استعلام اصالت با کد رهگیری</div>
    </div>
</div>

@if (!faRead)
{
    <div class="alert alert-warning">دسترسی مشاهده برای شما فعال نیست.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white fw-bold"><i class="bi bi-shield-check"></i> استعلام اصالت گواهی</div>
    <div class="card-body">
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label small text-muted">شماره گواهی</label><input class="form-control num" dir="ltr" placeholder="FA-1404-0001" @bind="vNo" /></div>
            <div class="col-md-4"><label class="form-label small text-muted">کد رهگیری</label><input class="form-control num" dir="ltr" @bind="vCode" /></div>
            <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" @onclick="DoVerify"><i class="bi bi-search"></i> استعلام</button></div>
        </div>
        @if (verified != null)
        {
            @if (verified.Found)
            {
                <div class="alert alert-success mt-3 mb-0"><i class="bi bi-check-circle-fill"></i> گواهی معتبر است — <b>@verified.EmployeeName</b> | دوره «@verified.CourseTitle» | صدور: <span class="num">@verified.IssueDate?.ToFa()</span> | نمره: <span class="num">@FaLmsUi.Num(verified.Score)</span></div>
            }
            else
            {
                <div class="alert alert-danger mt-3 mb-0"><i class="bi bi-x-circle-fill"></i> گواهی با این مشخصات یافت نشد.</div>
            }
        }
    </div>
</div>

@if (faManage)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-2">
                <div class="col-md-5"><label class="form-label small text-muted">دوره</label><select class="form-select" @bind="fCourse"><option value="">همه دوره‌ها</option>@foreach (var c in courses){<option value="@c.Id">@c.Title</option>}</select></div>
                <div class="col-md-2"><label class="form-label small text-muted">سال</label><input type="number" class="form-control" @bind="fYear" /></div>
                <div class="col-md-2 d-flex align-items-end"><button class="btn btn-primary" @onclick="Reload"><i class="bi bi-search"></i> جستجو</button></div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
            }
            else if (certs.Count == 0)
            {
                <div class="text-center text-muted py-5">گواهی ثبت نشده است.</div>
            }
            else
            {
                <div class="table-responsive"><table class="table table-hover mb-0 align-middle">
                    <thead class="table-light"><tr><th>شماره</th><th>پرسنل</th><th>دوره</th><th>تاریخ صدور</th><th>نمره</th><th>کد رهگیری</th><th style="width:60px"></th></tr></thead>
                    <tbody>
                        @foreach (var c in certs)
                        {
                            <tr>
                                <td class="num fw-bold">@c.CertNo</td>
                                <td><b>@c.EmployeeName</b></td>
                                <td><a href="@CourseUrl(c.CourseId)">@c.CourseTitle</a></td>
                                <td class="num">@c.IssueDate.ToFa()</td>
                                <td class="num">@FaLmsUi.Num(c.Score)</td>
                                <td class="num">@c.VerifyCode</td>
                                <td class="text-end"><button class="btn btn-sm btn-outline-danger" title="ابطال" @onclick="() => Delete(c)"><i class="bi bi-trash"></i></button></td>
                            </tr>
                        }
                    </tbody>
                </table></div>
            }
        </div>
    </div>
}

@code {
    private static string CourseUrl(int id) => "fa-lms/courses/" + id;
    private bool faRead => Auth.Has("FaLms.Read") || Auth.IsAdmin;
    private bool faManage => Auth.Has("FaLms.Manage") || Auth.IsAdmin;
    private bool loading = true;
    private List<FaLmsCertificateDto> certs = new();
    private List<FaLmsCourseDto> courses = new();
    private string? fCourse;
    private int? fYear = FaLmsUi.CurrentYear;
    private string vNo = "", vCode = "";
    private FaLmsVerifyResultDto? verified;

    protected override async Task OnInitializedAsync()
    {
        if (!faRead) { loading = false; return; }
        if (!faManage) { loading = false; return; }
        try { courses = await Svc.ListCoursesAsync(null, null, null, null); await Reload(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task Reload()
    {
        loading = true;
        try
        {
            int? c = int.TryParse(fCourse, out var x) ? x : null;
            certs = await Svc.ListCertificatesAsync(c, null, fYear);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task DoVerify()
    {
        try { verified = await Svc.VerifyAsync(vNo, vCode); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Delete(FaLmsCertificateDto c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "گواهی " + c.CertNo + " ابطال شود؟")) return;
        try { await Svc.DeleteCertificateAsync(c.Id); Toast.Success("ابطال شد."); await Reload(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
