@namespace Inventory.Client.Pages
@page "/fa-lms"
@inject IFaLmsService Svc
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>آموزش و توسعه</PageTitle>

<div class="page-head mb-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
        <div>
            <h1><i class="bi bi-mortarboard"></i> آموزش و توسعه</h1>
            <div class="lead">نمای کلی نیازسنجی، دوره‌ها، آزمون‌ها و بودجه آموزش</div>
        </div>
        <div class="d-flex gap-2 align-items-end">
            <div><label class="form-label small text-muted mb-1">سال</label><input type="number" class="form-control" style="width:110px" @bind="year" /></div>
            <button class="btn btn-primary" @onclick="Reload"><i class="bi bi-arrow-clockwise"></i></button>
        </div>
    </div>
</div>

@if (!faRead)
{
    <div class="alert alert-warning">دسترسی مشاهده برای شما فعال نیست.</div>
    return;
}

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else if (dash != null)
{
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center py-3"><div class="fs-3 fw-bold text-success num">@FaLmsUi.Num(dash.OpenCourses)</div><div class="text-muted small">دوره باز</div></div></div>
        <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center py-3"><div class="fs-3 fw-bold text-primary num">@FaLmsUi.Num(dash.RunningCourses)</div><div class="text-muted small">در حال برگزاری</div></div></div>
        <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center py-3"><div class="fs-3 fw-bold text-warning num">@FaLmsUi.Num(dash.PendingEnrolls)</div><div class="text-muted small">ثبت‌نام در انتظار</div></div></div>
        <div class="col-6 col-md-3"><div class="card border-0 shadow-sm text-center py-3"><div class="fs-3 fw-bold text-info num">@FaLmsUi.Num(dash.UpcomingSessions)</div><div class="text-muted small">جلسه ۷ روز آینده</div></div></div>
    </div>

    <div class="row g-3">
        @if (faManage)
        {
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-bold"><i class="bi bi-wallet2"></i> بودجه سال @FaLmsUi.Num(dash.Year)</div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between small mb-1"><span>مصوب: <b class="num">@FaLmsUi.Money(dash.BudgetAmount)</b> ریال</span><span>هزینه‌شده: <b class="num">@FaLmsUi.Money(dash.SpentAmount)</b></span></div>
                        <div class="progress" style="height:20px">
                            <div class="progress-bar @(SpendPct > 90 ? "bg-danger" : SpendPct > 70 ? "bg-warning" : "bg-success")" style="@SpendStyle">@FaLmsUi.Num(SpendPct)٪</div>
                        </div>
                        <a class="btn btn-sm btn-outline-primary mt-3" href="fa-lms/budgets"><i class="bi bi-graph-up"></i> گزارش بودجه</a>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white fw-bold"><i class="bi bi-patch-check"></i> آخرین گواهی‌ها</div>
                    <div class="card-body p-0">
                        @if (dash.RecentCerts.Count == 0)
                        {
                            <div class="text-center text-muted py-4">گواهی صادر نشده است.</div>
                        }
                        else
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var c in dash.RecentCerts)
                                {
                                    <li class="list-group-item d-flex justify-content-between"><span>@c.EmployeeName <span class="text-muted">— @c.CourseTitle</span></span><span class="badge text-bg-success num">@c.CertNo</span></li>
                                }
                            </ul>
                        }
                    </div>
                </div>
            </div>
        }
        <div class="col-md-12">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white fw-bold"><i class="bi bi-lightning-charge"></i> دسترسی سریع</div>
                <div class="card-body d-flex flex-wrap gap-2">
                    <a class="btn btn-outline-success" href="fa-lms/my"><i class="bi bi-person-video3"></i> دوره‌های من</a>
                    <a class="btn btn-outline-primary" href="fa-lms/courses"><i class="bi bi-collection"></i> دوره‌ها</a>
                    <a class="btn btn-outline-primary" href="fa-lms/calendar"><i class="bi bi-calendar3"></i> تقویم سالانه</a>
                    @if (faManage)
                    {
                        <a class="btn btn-outline-warning" href="fa-lms/needs"><i class="bi bi-clipboard-data"></i> نیازسنجی (@FaLmsUi.Num(dash.PendingNeeds))</a>
                        <a class="btn btn-outline-warning" href="fa-lms/enrollments"><i class="bi bi-inbox"></i> ثبت‌نام‌ها</a>
                        <a class="btn btn-outline-info" href="fa-lms/certificates"><i class="bi bi-award"></i> گواهی‌ها</a>
                        <a class="btn btn-outline-secondary" href="fa-lms/reports"><i class="bi bi-bar-chart"></i> اثربخشی</a>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool faRead => Auth.Has("FaLms.Read") || Auth.IsAdmin;
    private bool faManage => Auth.Has("FaLms.Manage") || Auth.IsAdmin;
    private bool loading = true;
    private int year = FaLmsUi.CurrentYear;
    private FaLmsDashboardDto? dash;
    private double SpendPct => dash == null || dash.BudgetAmount <= 0 ? 0 : Math.Round(dash.SpentAmount * 100 / dash.BudgetAmount, 1);
    private string SpendStyle => "width:" + SpendPct + "%";

    protected override async Task OnInitializedAsync()
    {
        if (!faRead) { loading = false; return; }
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try { dash = await Svc.GetDashboardAsync(year); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }
}
