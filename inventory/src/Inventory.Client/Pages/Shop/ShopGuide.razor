@page "/shop-guide"
@using Inventory.Client.Pages.Office.Guides
@inject NavigationManager Nav
@inject IAuthState Auth

<PageTitle>سامانه فروشگاهی — راهنمای کاربری</PageTitle>

@if (!Auth.CanSee("ShopGuide"))
{
    <div class="card">
        <div class="card-body text-center py-5">
            <i class="bi bi-shield-lock text-muted" style="font-size:2.4rem"></i>
            <h5 class="mt-3">دسترسی به راهنمای سامانه فروشگاهی ندارید</h5>
            <p class="text-muted fs-8 mb-3">
                برای دیدن این راهنما، مدیر سامانه باید در «تنظیمات ← نقش‌ها و دسترسی‌ها»
                مجوز <b>«راهنمای سامانه فروشگاهی»</b> را به نقش شما بدهد.
            </p>
            <button class="btn btn-outline-secondary btn-sm" @onclick="Back">
                <i class="bi bi-arrow-right"></i> بازگشت
            </button>
        </div>
    </div>
}
else
{
    <OfficeGuide
        Title="راهنمای سامانه فروشگاهی"
        Description="از تعریف اطلاعات پایه و ثبت خرید و فروش تا تسویه، چاپ فاکتور، بیجک، تعمیرات و گزارش‌ها؛ همهٔ بخش‌های سامانه فروشگاهی را گام‌به‌گام ببینید."
        Eyebrow="سامانه فروشگاهی / راهنمای کاربری"
        Icon="bi-shop"
        BackLabel="بازگشت به سامانه فروشگاهی"
        QuickStartTitle="شروع کار در چهار گام"
        Steps="QuickSteps"
        Sections="GuideSections"
        OnBack="Back">

        <OfficeGuideSection Id="shop-overview" Index="1" Title="سامانه فروشگاهی در یک نگاه" Kicker="نمای کلی">
            <p>
                «سامانه فروشگاهی» محل کار روزمرهٔ خرید و فروش است: تعریف کالا و طرف حساب، ثبت رسید خرید و
                فاکتور فروش، ثبت نحوهٔ تسویه، چاپ اسناد، صدور بیجک، پیگیری تعمیرات و دیدن گزارش‌ها.
                همهٔ اسناد به <b>شرکت فعال</b> (انتخاب‌شده در نوار بالای صفحه) و <b>انبار</b> مربوط‌اند؛
                پس پیش از هر کار مطمئن شوید شرکت و انبار درست انتخاب شده‌اند.
            </p>
            <div class="anatomy-grid">
                <article class="anatomy-card violet">
                    <span class="card-icon"><i class="bi bi-cart-plus"></i></span>
                    <h3>خرید و فروش</h3>
                    <p>ثبت رسید خرید از تأمین‌کننده و فاکتور فروش به مشتری، همراه با ردیف کالاها، تخفیف، مالیات و روش تسویه.</p>
                </article>
                <article class="anatomy-card blue">
                    <span class="card-icon"><i class="bi bi-database"></i></span>
                    <h3>اطلاعات پایه</h3>
                    <p>کالاها، گروه‌های کالا، واحدهای شمارش، انبارها، طرف حساب‌ها و معرف‌ها؛ پیش‌نیاز هر سند.</p>
                </article>
                <article class="anatomy-card green">
                    <span class="card-icon"><i class="bi bi-box-seam"></i></span>
                    <h3>بیجک و تعمیرات</h3>
                    <p>حوالهٔ تحویل کالا بدون قیمت (بیجک) و ثبت و پیگیری تعمیرات کالاهای مشتری.</p>
                </article>
                <article class="anatomy-card amber">
                    <span class="card-icon"><i class="bi bi-graph-up-arrow"></i></span>
                    <h3>گزارش و داشبورد</h3>
                    <p>کاردکس تعداد و ریالی، گزارش خرید و فروش و داشبورد جامع عملیات.</p>
                </article>
            </div>
            <div class="guide-note info">
                <i class="bi bi-receipt"></i>
                <div>
                    <strong>سامانه مودیان، ماژول جداگانه است</strong>
                    <span>
                        صدور و ارسال صورتحساب الکترونیکی در منوی مستقل «سامانه مودیان» انجام می‌شود و
                        راهنمای خودش را دارد. فروشگاه برای فروش روزمره و سند داخلی است؛ برای ارسال به سازمان
                        مالیاتی از همان ماژول استفاده کنید.
                    </span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-menu" Index="2" Title="منوها و ساختار صفحه" Kicker="جست‌وجو در سامانه">
            <p>
                همهٔ بخش‌ها زیر گروه «سامانه فروشگاهی» در منوی کناری جمع شده‌اند و هر آیتم فقط وقتی دیده می‌شود
                که مجوزش را داشته باشید:
            </p>
            <table class="guide-table">
                <thead><tr><th>بخش</th><th>چه کاری انجام می‌دهد</th></tr></thead>
                <tbody>
                    <tr><td>خرید</td><td>فهرست و ثبت رسیدهای خرید از تأمین‌کننده.</td></tr>
                    <tr><td>فروش</td><td>فهرست و ثبت فاکتورهای فروش به مشتری و چاپ فاکتور.</td></tr>
                    <tr><td>بیجک</td><td>حوالهٔ تحویل کالا <b>بدون قیمت</b> برای همراهی بار.</td></tr>
                    <tr><td>تعمیرات</td><td>پذیرش، ارجاع و پیگیری تعمیر کالا.</td></tr>
                    <tr><td>هزینه‌ها</td><td>ثبت هزینه‌های جاری فروشگاه.</td></tr>
                    <tr><td>تسویه فاکتورها</td><td>ثبت دریافت/پرداخت مرتبط با فاکتورها و چک‌ها.</td></tr>
                    <tr><td>گزارش</td><td>کاردکس تعداد و ریالی، گزارش خرید و فروش، داشبورد عملیات.</td></tr>
                    <tr><td>اطلاعات پایه</td><td>کالاها، گروه‌های کالا، واحدهای شمارش، انبارها، طرف حساب‌ها، معرف‌ها.</td></tr>
                    <tr><td>راهنمای سامانه</td><td>همین صفحه.</td></tr>
                </tbody>
            </table>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-base" Index="3" Title="اطلاعات پایه" Kicker="پیش‌نیاز اسناد">
            <ol class="instruction-list">
                <li>
                    <span>۱</span>
                    <div>
                        <b>واحدهای شمارش:</b> واحدهای مورد استفاده (عدد، کیلوگرم، متر، بسته…) را تعریف کنید؛
                        هر کالا به یکی از این واحدها وصل می‌شود.
                    </div>
                </li>
                <li>
                    <span>۲</span>
                    <div>
                        <b>گروه‌های کالا:</b> برای دسته‌بندی و گزارش‌گیری، گروه بسازید. گروه می‌تواند
                        «گروه پدر» داشته باشد و به شکل درختی مرتب شود.
                    </div>
                </li>
                <li>
                    <span>۳</span>
                    <div>
                        <b>کالاها:</b> کد، نام، گروه، واحد، قیمت خرید و قیمت فروش، موجودی حداقل/حداکثر و
                        بارکد را ثبت کنید. کالای بدون واحد در سند قابل انتخاب نیست.
                    </div>
                </li>
                <li>
                    <span>۴</span>
                    <div>
                        <b>انبارها:</b> حداقل یک انبار بسازید؛ موجودی و کاردکس بر اساس انبار محاسبه می‌شود.
                    </div>
                </li>
                <li>
                    <span>۵</span>
                    <div>
                        <b>طرف حساب‌ها:</b> مشتری و تأمین‌کننده را با نوع حساب مشخص کنید؛ گردش حساب و
                        مانده هر طرف حساب از همین اسناد ساخته می‌شود.
                    </div>
                </li>
                <li>
                    <span>۶</span>
                    <div>
                        <b>معرف‌ها:</b> اگر فروش از طریق معرف انجام می‌شود، معرف را تعریف کنید تا سهم و
                        کیف پول او محاسبه شود.
                    </div>
                </li>
            </ol>
            <div class="guide-note">
                <i class="bi bi-info-circle"></i>
                <div>
                    <strong>ترتیب پیشنهادی</strong>
                    <span>واحد ← گروه کالا ← کالا ← انبار ← طرف حساب ← معرف. با رعایت این ترتیب هنگام ثبت سند، کمبود گزینه ندارید.</span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-purchase" Index="4" Title="ثبت خرید" Kicker="رسید خرید">
            <ol class="instruction-list">
                <li><span>۱</span><div>از منوی «سامانه فروشگاهی ← خرید» وارد فهرست رسیدهای خرید شوید.</div></li>
                <li><span>۲</span><div>دکمهٔ <b>«خرید جدید»</b> را بزنید؛ فرم سند باز می‌شود.</div></li>
                <li><span>۳</span><div>انبار، تأمین‌کننده و تاریخ سند را مشخص کنید (این سه الزامی‌اند).</div></li>
                <li><span>۴</span><div>ردیف‌های کالا را اضافه کنید: کالا، تعداد، قیمت واحد و تخفیف/مالیات هر ردیف.</div></li>
                <li><span>۵</span><div>روش تسویه را انتخاب کنید: نقدی، کارت‌خوان، کارت‌به‌کارت، نسیه، چک یا اقساط.</div></li>
                <li><span>۶</span><div>سند را ثبت کنید؛ موجودی انبار و گردش حساب تأمین‌کننده به‌روز می‌شود.</div></li>
            </ol>
            <div class="guide-note info">
                <i class="bi bi-cash-stack"></i>
                <div>
                    <strong>پیش‌پرداخت نقدی</strong>
                    <span>در فرم خرید می‌توانید مبلغی پیش‌پرداخت ثبت کنید؛ باقی‌مانده به‌صورت نسیه/چک در گردش حساب می‌ماند.</span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-sale" Index="5" Title="ثبت فروش" Kicker="فاکتور فروش">
            <ol class="instruction-list">
                <li><span>۱</span><div>از منوی «سامانه فروشگاهی ← فروش» وارد فهرست اسناد فروش شوید.</div></li>
                <li><span>۲</span><div>دکمهٔ <b>«فروش جدید»</b> را بزنید.</div></li>
                <li><span>۳</span><div>انبار، مشتری و تاریخ سند را انتخاب کنید، سپس ردیف کالاها را وارد کنید.</div></li>
                <li><span>۴</span><div>در صورت نیاز پیش‌دریافت نقدی ثبت کنید و روش تسویهٔ باقی‌مانده را مشخص کنید.</div></li>
                <li><span>۵</span><div>سند را ثبت و از همان ردیف فهرست، فاکتور را <b>چاپ</b> کنید.</div></li>
            </ol>
            <div class="guide-note warning">
                <i class="bi bi-exclamation-triangle"></i>
                <div>
                    <strong>موجودی کافی</strong>
                    <span>
                        اگر موجودی انبار کافی نباشد، سامانه هشدار می‌دهد. اول رسید خرید را ثبت کنید یا
                        موجودی اول دوره را وارد کنید تا فروش بدون منفی‌شدن انبار انجام شود.
                    </span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-payment" Index="6" Title="تسویه، نسیه، چک و اقساط" Kicker="گردش مالی">
            <p>
                در فرم سند، بخش «روش تسویه» تعیین می‌کند پول چگونه دریافت/پرداخت می‌شود. برای حالت‌های
                غیرنقدی، سامانه جزئیات را می‌پرسد:
            </p>
            <table class="guide-table">
                <thead><tr><th>روش</th><th>چه اطلاعاتی لازم است</th></tr></thead>
                <tbody>
                    <tr><td>نقدی</td><td>حساب صندوق/بانک و نوع دریافت (وجه نقد، کارت‌خوان، کارت‌به‌کارت).</td></tr>
                    <tr><td>نسیه</td><td>تاریخ سررسید؛ مبلغ به ماندهٔ طرف حساب اضافه می‌شود.</td></tr>
                    <tr><td>چک</td><td>شمارهٔ چک/صیاد، بانک، مبلغ، تاریخ سررسید و صاحب چک/در وجه.</td></tr>
                    <tr><td>اقساط</td><td>تعداد اقساط و تاریخ اولین قسط؛ سررسیدها خودکار ساخته می‌شوند.</td></tr>
                </tbody>
            </table>
            <div class="guide-note">
                <i class="bi bi-wallet2"></i>
                <div>
                    <strong>تسویهٔ بعدی</strong>
                    <span>برای تسویهٔ فاکتورهای نسیه‌شده از «تسویه فاکتورها» استفاده کنید؛ وصولی/پرداخت به همان سند وصل می‌شود و مانده به‌روز می‌گردد.</span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-print" Index="7" Title="چاپ و خروجی" Kicker="اسناد">
            <ul>
                <li><b>چاپ فاکتور فروش:</b> از آیکن چاپ در ردیف فاکتور یا از نوار عملیات همان سند.</li>
                <li><b>چاپ رسید خرید:</b> همان مسیر، با قالب رسید خرید.</li>
                <li><b>خروجی فهرست:</b> دکمه‌های خروجی، همان فیلترهای فعال را در اکسل/PDF می‌آورند.</li>
                <li><b>فیلترها:</b> بازهٔ تاریخ، انبار و طرف حساب؛ دکمهٔ «اعمال فیلتر» فهرست را به‌روز می‌کند.</li>
            </ul>
            <div class="guide-note info">
                <i class="bi bi-printer"></i>
                <div>
                    <strong>سربرگ چاپ</strong>
                    <span>سربرگ و اطلاعات شرکتِ چاپ از همان شرکت فعال خوانده می‌شود؛ اگر سربرگ خالی بود، اطلاعات شرکت را در تنظیمات شرکت‌ها تکمیل کنید.</span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-issue" Index="8" Title="بیجک (حوالهٔ بدون قیمت)" Kicker="تحویل بار">
            <p>
                بیجک برای وقتی است که کالا از انبار خارج می‌شود ولی نمی‌خواهید قیمت روی برگه دیده شود
                (همراهی بار، تحویل به واحد دیگر یا ارسال با پیک). در بیجک کالا، تعداد و انبار ثبت می‌شود
                ولی مبلغ/قیمت نمایش داده نمی‌شود.
            </p>
            <div class="guide-note">
                <i class="bi bi-box-seam"></i>
                <div>
                    <strong>تفاوت بیجک و حوالهٔ فروش</strong>
                    <span>فاکتور فروش سند مالی است و روی گردش حساب اثر دارد؛ بیجک سند «فقط مقدار» است و بدون قیمت صادر می‌شود.</span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-repairs" Index="9" Title="تعمیرات" Kicker="سرویس کالا">
            <ol class="instruction-list">
                <li><span>۱</span><div>در «تعمیرات» یک پروندهٔ تازه بسازید: مشتری، کالا، ایراد و توضیحات.</div></li>
                <li><span>۲</span><div>پرونده را به کارشناس یا واحد مربوط ارجاع دهید و وضعیت را به‌روز نگه دارید.</div></li>
                <li><span>۳</span><div>هزینهٔ تعمیر را ثبت و پس از تحویل کالا، پرونده را ببندید.</div></li>
            </ol>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-reports" Index="10" Title="گزارش‌ها و داشبورد" Kicker="تحلیل">
            <table class="guide-table">
                <thead><tr><th>گزارش</th><th>به چه کاری می‌آید</th></tr></thead>
                <tbody>
                    <tr><td>کاردکس تعداد کالا</td><td>گردش موجودی هر کالا در بازهٔ زمانی، بر اساس تعداد.</td></tr>
                    <tr><td>کاردکس ریالی کالا</td><td>همان گردش، با مبالغ؛ برای بهای تمام‌شده و ارزش موجودی.</td></tr>
                    <tr><td>گزارش خرید</td><td>جمع خرید در بازه، به تفکیک تأمین‌کننده و انبار.</td></tr>
                    <tr><td>گزارش فروش</td><td>جمع فروش در بازه، به تفکیک مشتری، کالا و معرف.</td></tr>
                    <tr><td>داشبورد عملیات</td><td>نمای کلی خرید، فروش، تعمیرات و معرف.</td></tr>
                </tbody>
            </table>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-access" Index="11" Title="دسترسی‌ها و نقش‌ها" Kicker="مدیریت سامانه">
            <p>
                دسترسی این سامانه در «تنظیمات ← نقش‌ها و دسترسی‌ها» و در دستهٔ
                <b>«سامانه فروشگاهی — فروش، مالی و مودیان»</b> مدیریت می‌شود. برای هر ماژول اکشن‌های
                جداگانه وجود دارد و برداشتن تیک «مشاهده» آن آیتم را از منو هم پنهان می‌کند.
            </p>
            <ul>
                <li><b>خرید / فروش (<code>Orders</code>):</b> ایجاد، مشاهده، ویرایش، حذف، خروجی و «مشاهده سود».</li>
                <li><b>بیجک (<code>GoodsIssues</code>) و تعمیرات (<code>Repairs</code>):</b> پنج اکشن استاندارد.</li>
                <li><b>اطلاعات پایه:</b> کالاها، انبارها، طرف حساب‌ها و معرف‌ها هر کدام مجوز مستقل دارند.</li>
                <li><b>راهنمای سامانه (<code>ShopGuide</code>):</b> فقط «مشاهده»؛ همین صفحه را باز می‌کند.</li>
            </ul>
            <div class="guide-note info">
                <i class="bi bi-person-check"></i>
                <div>
                    <strong>دیدن راهنما بدون دیدن اسناد</strong>
                    <span>
                        می‌توانید فقط مجوز «راهنمای سامانه فروشگاهی» را به یک نقش بدهید؛ در این حالت آن کاربر
                        منوی «سامانه فروشگاهی ← راهنمای سامانه» را می‌بیند و به اسناد و اطلاعات پایه دسترسی ندارد.
                    </span>
                </div>
            </div>
        </OfficeGuideSection>

        <OfficeGuideSection Id="shop-faq" Index="12" Title="پرسش‌های متداول" Kicker="رفع ابهام">
            <div class="faq-list">
                <details open>
                    <summary>فاکتور فروش را ثبت کردم ولی موجودی کم نشد؛ چرا؟ <i class="bi bi-chevron-down"></i></summary>
                    <p>احتمالاً سند هنوز نهایی نشده یا در انبار دیگری ثبت شده است. انبار سند و وضعیت آن را بررسی کنید؛ موجودی بر اساس انبارِ همان سند کم می‌شود.</p>
                </details>
                <details>
                    <summary>چرا نمی‌توانم کالایی را در سند انتخاب کنم؟ <i class="bi bi-chevron-down"></i></summary>
