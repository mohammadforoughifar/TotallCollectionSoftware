@namespace Inventory.Client.Pages
@page "/dev-team"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IDevTeamClient Api
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav

<PageTitle>میز کار توسعه</PageTitle>

<div class="dt-page">
    <div class="page-head dt-head">
        <div>
            <h1><i class="bi bi-code-slash"></i> میز کار توسعه</h1>
            <div class="text-muted fs-8">مدیریت تیم نرم‌افزار — تسک، ماژول، خطا، changelog و گیت</div>
        </div>
        <div class="d-flex flex-wrap gap-2">
            @if (access.CanCreate)
            {
                <button class="btn btn-primary btn-sm" @onclick="OpenNewTask"><i class="bi bi-plus-lg"></i> تسک جدید</button>
                <button class="btn btn-outline-danger btn-sm" @onclick="OpenNewProblem"><i class="bi bi-bug"></i> ثبت مشکل</button>
                <button class="btn btn-outline-secondary btn-sm" @onclick="OpenNewChange"><i class="bi bi-git"></i> ثبت تغییر</button>
            }
        </div>
    </div>

    @* تب‌ها *@
    <div class="dt-tabs mb-3">
        @foreach (var (key, label, icon) in TabDefs)
        {
            <button class="dt-tab @(tab == key ? "active" : "")" @onclick="() => SwitchTab(key)">
                <i class="bi @icon"></i> @label
            </button>
        }
    </div>

    @if (loading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (!access.CanView)
    {
        <div class="alert alert-warning">دسترسی مشاهدهٔ میز کار توسعه را ندارید.</div>
    }
    else
    {
        @* ========== فیلتر مشترک ========== *@
        @if (tab == "board" || tab == "list")
        {
            <div class="dt-filters card border-0 shadow-sm mb-3">
                <div class="card-body py-2">
                    <div class="row g-2 align-items-center">
                        <div class="col-12 col-md-3">
                            <div class="input-group input-group-sm">
                                <span class="input-group-text"><i class="bi bi-search"></i></span>
                                <input class="form-control" placeholder="جستجو عنوان / شماره / برچسب…"
                                       @bind="fltQ" @bind:event="oninput" @bind:after="ReloadTasks" />
                            </div>
                        </div>
                        <div class="col-6 col-md-2">
                            <select class="form-select form-select-sm" @bind="fltModuleId" @bind:after="ReloadTasks">
                                <option value="0">همه ماژول‌ها</option>
                                @foreach (var m in lookups.Modules)
                                {
                                    <option value="@m.Id">@m.NameFa</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <select class="form-select form-select-sm" @bind="fltSprintId" @bind:after="ReloadTasks">
                                <option value="0">همه اسپرینت‌ها</option>
                                @foreach (var s in lookups.Sprints)
                                {
                                    <option value="@s.Id">@s.Name (@s.StatusFa)</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <select class="form-select form-select-sm" @bind="fltAssigneeId" @bind:after="ReloadTasks">
                                <option value="0">همه افراد</option>
                                @foreach (var u in lookups.Users)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-6 col-md-2">
                            <select class="form-select form-select-sm" @bind="fltType" @bind:after="ReloadTasks">
                                <option value="">همه انواع</option>
                                @foreach (var t in lookups.TaskTypes)
                                {
                                    <option value="@t">@TypeFa(t)</option>
                                }
                            </select>
                        </div>
                        <div class="col-12 col-md-1 d-flex gap-1">
                            <button class="btn btn-sm @(onlyMine ? "btn-primary" : "btn-outline-secondary") flex-fill" title="فقط من"
                                    @onclick="ToggleMine">
                                <i class="bi bi-person"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ========== کانبان ========== *@
        @if (tab == "board")
        {
            <div class="dt-board">
                @foreach (var st in lookups.Statuses.Where(s => s.IsActive).OrderBy(s => s.SortOrder))
                {
                    var col = boardTasks.Where(t => t.StatusId == st.Id).ToList();
                    <div class="dt-col">
                        <div class="dt-col-head" style="border-top-color:@st.Color">
                            <span class="dt-col-dot" style="background:@st.Color"></span>
                            <strong>@st.NameFa</strong>
                            <span class="badge rounded-pill text-bg-light">@col.Count</span>
                        </div>
                        <div class="dt-col-body">
                            @foreach (var t in col.OrderByDescending(x => x.Priority).ThenBy(x => x.DueAt))
                            {
                                <div class="dt-card" @onclick="() => OpenTask(t.Id)">
                                    <div class="dt-card-top">
                                        <span class="dt-num">@t.Number</span>
                                        <span class="dt-pri dt-pri-@t.Priority">@t.PriorityFa</span>
                                    </div>
                                    <div class="dt-card-title">@t.Title</div>
                                    <div class="dt-card-meta">
                                        @if (!string.IsNullOrEmpty(t.ModuleName))
                                        {
                                            <span class="dt-mod" style="background:@(t.ModuleColor)22;color:@t.ModuleColor">@t.ModuleName</span>
                                        }
                                        <span class="dt-type">@t.TypeFa</span>
                                    </div>
                                    <div class="dt-card-foot">
                                        <span class="text-muted fs-8">@(t.AssigneeName ?? "—")</span>
                                        @if (t.IsOverdue)
                                        {
                                            <span class="badge text-bg-danger">معوق</span>
                                        }
                                        else if (t.DueAt is DateTime d)
                                        {
                                            <span class="fs-8 text-muted">@PersianDate.ToShort(d)</span>
                                        }
                                        @if (t.GitLinkCount > 0)
                                        {
                                            <span title="لینک گیت"><i class="bi bi-git"></i> @t.GitLinkCount</span>
                                        }
                                        @if (t.OpenProblemCount > 0)
                                        {
                                            <span class="text-danger" title="مشکل باز"><i class="bi bi-bug"></i> @t.OpenProblemCount</span>
                                        }
                                        @if (t.WorkOrderId is not null)
                                        {
                                            <span class="badge text-bg-light border" title="دستور کار">@t.WorkOrderNumber</span>
                                        }
                                        @if (t.SubTaskCount > 0)
                                        {
                                            <span class="badge text-bg-light border" title="ساب‌تسک">
                                                <i class="bi bi-diagram-3"></i> @t.SubTaskDoneCount/@t.SubTaskCount
                                            </span>
                                        }
                                        @if (t.IsDependencyBlocked)
                                        {
                                            <span class="badge text-bg-warning" title="وابستگی باز">
                                                <i class="bi bi-lock"></i> @t.OpenBlockerCount
                                            </span>
                                        }
                                    </div>
                                    @if (access.CanUpdate)
                                    {
                                        <div class="dt-card-moves" @onclick:stopPropagation="true">
                                            @foreach (var ns in lookups.Statuses.Where(s => s.IsActive && s.Id != st.Id).Take(4))
                                            {
                                                var ns2 = ns;
                                                <button class="dt-move" style="border-color:@ns2.Color;color:@ns2.Color"
                                                        title="انتقال به @ns2.NameFa"
                                                        @onclick="() => MoveTask(t.Id, ns2.Id)">
                                                    @ns2.NameFa
                                                </button>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                            @if (col.Count == 0)
                            {
                                <div class="dt-empty">خالی</div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @* ========== لیست ========== *@
        else if (tab == "list")
        {
            <div class="card border-0 shadow-sm">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 dt-table">
                        <thead class="table-light">
                            <tr>
                                <th>شماره</th>
                                <th>عنوان</th>
                                <th>وضعیت</th>
                                <th>ماژول</th>
                                <th>نوع</th>
                                <th>اولویت</th>
                                <th>مسئول</th>
                                <th>مهلت</th>
                                <th>ساعت</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var t in listTasks)
                            {
                                <tr style="cursor:pointer" @onclick="() => OpenTask(t.Id)">
                                    <td class="font-monospace fs-8">@t.Number</td>
                                    <td>
                                        <div class="fw-semibold">
                                            @t.Title
                                            @if (t.SubTaskCount > 0)
                                            {
                                                <span class="badge text-bg-light border ms-1 fs-8">@t.SubTaskDoneCount/@t.SubTaskCount زیر</span>
                                            }
                                            @if (t.IsDependencyBlocked)
                                            {
                                                <span class="badge text-bg-warning ms-1 fs-8"><i class="bi bi-lock"></i></span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(t.Tags))
                                        {
                                            <div class="fs-8 text-muted">@t.Tags</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="dt-st-badge" style="background:@t.StatusColor">@t.StatusName</span>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(t.ModuleName))
                                        {
                                            <span class="dt-mod" style="background:@(t.ModuleColor)22;color:@t.ModuleColor">@t.ModuleName</span>
                                        }
                                    </td>
                                    <td>@t.TypeFa</td>
                                    <td><span class="dt-pri dt-pri-@t.Priority">@t.PriorityFa</span></td>
                                    <td>@(t.AssigneeName ?? "—")</td>
                                    <td class="@(t.IsOverdue ? "text-danger fw-bold" : "")">
                                        @(t.DueAt is DateTime d ? PersianDate.ToShort(d) : "—")
                                    </td>
                                    <td class="fs-8">@(t.SpentHours)/@(t.EstimateHours?.ToString() ?? "—")</td>
                                    <td @onclick:stopPropagation="true">
                                        @if (access.CanDelete)
                                        {
                                            <button class="btn btn-sm btn-link text-danger" @onclick="() => DeleteTask(t.Id)"><i class="bi bi-trash"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                @if (listTasks.Count == 0)
                {
                    <div class="text-center text-muted py-4">تسکی یافت نشد.</div>
                }
            </div>
        }

        @* ========== مشکلات ========== *@
        else if (tab == "problems")
        {
            <div class="dt-filters card border-0 shadow-sm mb-3">
                <div class="card-body py-2 row g-2">
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" @bind="probSeverity" @bind:after="LoadProblems">
                            <option value="">همه شدت‌ها</option>
                            <option value="Error">خطا</option>
                            <option value="Warning">هشدار</option>
                            <option value="Info">اطلاع</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" @bind="probStatus" @bind:after="LoadProblems">
                            <option value="">همه وضعیت‌ها</option>
                            <option value="Open">باز</option>
                            <option value="Investigating">در حال بررسی</option>
                            <option value="Resolved">رفع‌شده</option>
                            <option value="WontFix">رفع نمی‌شود</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <select class="form-select form-select-sm" @bind="probModuleId" @bind:after="LoadProblems">
                            <option value="0">همه ماژول‌ها</option>
                            @foreach (var m in lookups.Modules)
                            {
                                <option value="@m.Id">@m.NameFa</option>
                            }
                        </select>
                    </div>
                </div>
            </div>
            <div class="row g-2">
                @foreach (var p in problems)
                {
                    <div class="col-12 col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100 dt-prob dt-prob-@p.Severity.ToLowerInvariant()">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <h6 class="mb-1">@p.Title</h6>
                                    <span class="badge @SevBadge(p.Severity)">@p.SeverityFa</span>
                                </div>
                                <div class="fs-8 text-muted mb-2">
                                    @p.StatusFa
                                    @if (!string.IsNullOrEmpty(p.ModuleName))
                                    {
                                        <span> · </span><span style="color:@p.ModuleColor">@p.ModuleName</span>
                                    }
                                    @if (!string.IsNullOrEmpty(p.TaskNumber))
                                    {
                                        <span> · </span><a href="javascript:void(0)" @onclick="() => OpenTask(p.TaskId!.Value)">@p.TaskNumber</a>
                                    }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(p.Description))
                                {
                                    <div class="fs-8 text-muted mb-2 dt-clamp">@p.Description</div>
                                }
                                <div class="d-flex justify-content-between align-items-center fs-8">
                                    <span>@(p.AssigneeName ?? p.ReporterName)</span>
                                    <span>@PersianDate.ToShort(p.CreatedAt)</span>
                                </div>
                                @if (access.CanUpdate && (p.Status == "Open" || p.Status == "Investigating"))
                                {
                                    <div class="mt-2 d-flex gap-1">
                                        <button class="btn btn-sm btn-outline-success" @onclick="() => ResolveProblem(p)">رفع شد</button>
                                        <button class="btn btn-sm btn-outline-secondary" @onclick='() => SetProblemStatus(p, "Investigating")'>بررسی</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
                @if (problems.Count == 0)
                {
                    <div class="col-12 text-center text-muted py-4">مشکلی ثبت نشده.</div>
                }
            </div>
        }

        @* ========== ماژول‌ها + changelog ========== *@
        else if (tab == "modules")
        {
            <div class="row g-3">
                <div class="col-lg-5">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold">ماژول‌های محصول</div>
                        <div class="list-group list-group-flush">
                            @foreach (var m in lookups.Modules)
                            {
                                <button class="list-group-item list-group-item-action d-flex justify-content-between align-items-center @(chgModuleId == m.Id ? "active" : "")"
                                        @onclick="() => SelectModule(m.Id)">
                                    <span>
                                        <i class="bi @(m.Icon ?? "bi-box")" style="color:@(chgModuleId == m.Id ? "inherit" : m.Color)"></i>
                                        @m.NameFa
                                    </span>
                                    <span class="d-flex gap-1">
                                        @if (m.OpenTaskCount > 0)
                                        {
                                            <span class="badge text-bg-primary">@m.OpenTaskCount تسک</span>
                                        }
                                        @if (m.OpenProblemCount > 0)
                                        {
                                            <span class="badge text-bg-danger">@m.OpenProblemCount</span>
                                        }
                                        @if (m.RecentChangeCount > 0)
                                        {
                                            <span class="badge text-bg-secondary">@m.RecentChangeCount تغییر</span>
                                        }
                                    </span>
                                </button>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-7">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center">
                            <span class="fw-semibold">Changelog @(chgModuleId > 0 ? lookups.Modules.FirstOrDefault(m => m.Id == chgModuleId)?.NameFa : "همه")</span>
                            @if (access.CanCreate)
                            {
                                <button class="btn btn-sm btn-outline-primary" @onclick="OpenNewChange"><i class="bi bi-plus"></i> تغییر</button>
                            }
                        </div>
                        <div class="card-body p-0">
                            @if (changes.Count == 0)
                            {
                                <div class="text-center text-muted py-4">تغییری ثبت نشده.</div>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var c in changes)
                                    {
                                        <li class="list-group-item">
                                            <div class="d-flex justify-content-between gap-2">
                                                <div>
                                                    <div class="fw-semibold">@c.Summary</div>
                                                    <div class="fs-8 text-muted">
                                                        <span style="color:@c.ModuleColor">@c.ModuleName</span>
                                                        · @c.AuthorName · @PersianDate.ToShortDateTime(c.ChangedAt)
                                                        @if (!string.IsNullOrEmpty(c.CommitSha))
                                                        {
                                                            <span class="font-monospace"> · @ShortSha(c.CommitSha)</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(c.Branch))
                                                        {
                                                            <span> · <i class="bi bi-diagram-3"></i> @c.Branch</span>
                                                        }
                                                        @if (!string.IsNullOrEmpty(c.TaskNumber))
                                                        {
                                                            <span> · @c.TaskNumber</span>
                                                        }
                                                    </div>
                                                    @if (!string.IsNullOrWhiteSpace(c.Details))
                                                    {
                                                        <div class="fs-8 mt-1">@c.Details</div>
                                                    }
                                                </div>
                                                @if (!string.IsNullOrEmpty(c.CommitUrl))
                                                {
                                                    <a class="btn btn-sm btn-outline-secondary" href="@c.CommitUrl" target="_blank" rel="noopener">گیت</a>
                                                }
                                            </div>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }

        @* ========== اسپرینت ========== *@
        else if (tab == "sprints")
        {
            <div class="d-flex justify-content-between mb-3">
                <h5 class="mb-0">اسپرینت‌ها / بازه‌های زمانی</h5>
                @if (access.CanManage || access.CanCreate)
                {
                    <button class="btn btn-sm btn-primary" @onclick="OpenNewSprint"><i class="bi bi-plus"></i> اسپرینت</button>
                }
            </div>
            <div class="row g-3">
                @foreach (var s in lookups.Sprints)
                {
                    var pct = s.TaskCount == 0 ? 0 : Math.Round(100.0 * s.DoneTaskCount / s.TaskCount, 0);
                    <div class="col-md-6 col-lg-4">
                        <div class="card border-0 shadow-sm h-100">
                            <div class="card-body">
                                <div class="d-flex justify-content-between">
                                    <h6>@s.Name</h6>
                                    <span class="badge @SprintBadge(s.Status)">@s.StatusFa</span>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(s.Goal))
                                {
                                    <div class="fs-8 text-muted mb-2">@s.Goal</div>
                                }
                                <div class="fs-8 mb-1">@PersianDate.ToShort(s.StartDate) تا @PersianDate.ToShort(s.EndDate)</div>
                                <div class="progress mb-2" style="height:8px">
                                    <div class="progress-bar" style="width:@(pct)%"></div>
                                </div>
                                <div class="d-flex justify-content-between fs-8 text-muted">
                                    <span>@s.DoneTaskCount / @s.TaskCount تسک</span>
                                    <span>@s.TotalSpent / @s.TotalEstimate س</span>
                                </div>
                                <button class="btn btn-sm btn-link px-0 mt-1" @onclick="() => FilterBySprint(s.Id)">مشاهده تسک‌ها</button>
                            </div>
                        </div>
                    </div>
                }
                @if (lookups.Sprints.Count == 0)
                {
                    <div class="col-12 text-muted text-center py-4">اسپرینتی تعریف نشده.</div>
                }
            </div>
        }

        @* ========== داشبورد ========== *@
        else if (tab == "dashboard" && dash is not null)
        {
            <div class="row g-3 mb-3">
                <div class="col-6 col-md-3"><div class="dt-kpi"><div class="dt-kpi-v">@dash.TotalOpenTasks</div><div class="dt-kpi-l">تسک باز</div></div></div>
                <div class="col-6 col-md-3"><div class="dt-kpi danger"><div class="dt-kpi-v">@dash.OverdueTasks</div><div class="dt-kpi-l">معوق</div></div></div>
                <div class="col-6 col-md-3"><div class="dt-kpi warn"><div class="dt-kpi-v">@dash.BlockedTasks</div><div class="dt-kpi-l">مسدود</div></div></div>
                <div class="col-6 col-md-3"><div class="dt-kpi err"><div class="dt-kpi-v">@dash.OpenErrors</div><div class="dt-kpi-l">خطای باز</div></div></div>
            </div>

            @if (!string.IsNullOrEmpty(dash.ActiveSprintName))
            {
                <div class="alert alert-primary d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-lightning"></i> اسپرینت فعال: <b>@dash.ActiveSprintName</b></span>
                    <span>پیشرفت: @(dash.ActiveSprintProgressPct?.ToString("0") ?? "—")٪ · تخمین @dash.SprintEstimateHours س / صرف‌شده @dash.SprintSpentHours س</span>
                </div>
            }

            <div class="row g-3">
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white fw-semibold">بار افراد</div>
                        <div class="card-body p-0">
                            <table class="table table-sm mb-0">
                                <thead><tr><th>فرد</th><th>باز</th><th>فعال</th><th>معوق</th><th>ساعت</th></tr></thead>
                                <tbody>
                                @foreach (var m in dash.MemberLoads)
                                {
                                    <tr>
                                        <td>@m.Name</td>
                                        <td>@m.OpenTasks</td>
                                        <td>@m.DoingTasks</td>
                                        <td class="@(m.OverdueTasks>0?"text-danger":"")">@m.OverdueTasks</td>
                                        <td class="fs-8">@m.SpentHours/@m.EstimateHours</td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                            @if (dash.MemberLoads.Count == 0)
                            {
                                <div class="text-muted text-center py-3 fs-8">داده‌ای نیست</div>
                            }
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white fw-semibold">ماژول‌های پرترافیک</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var m in dash.ModuleLoads)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span><span class="dt-col-dot" style="background:@m.Color;display:inline-block;width:8px;height:8px;border-radius:50%"></span> @m.Name</span>
                                    <span class="fs-8">
                                        <span class="badge text-bg-primary">@m.OpenTasks</span>
                                        @if (m.OpenProblems > 0) { <span class="badge text-bg-danger">@m.OpenProblems</span> }
                                        @if (m.ChangesLast7Days > 0) { <span class="badge text-bg-secondary">@m.ChangesLast7Days</span> }
                                    </span>
                                </li>
                            }
                            @if (dash.ModuleLoads.Count == 0)
                            {
                                <li class="list-group-item text-muted text-center">—</li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card border-0 shadow-sm h-100">
                        <div class="card-header bg-white fw-semibold">توزیع وضعیت</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var s in dash.StatusCounts)
                            {
                                <li class="list-group-item d-flex justify-content-between">
                                    <span><span class="dt-col-dot" style="background:@s.Color;display:inline-block;width:8px;height:8px;border-radius:50%"></span> @s.Name</span>
                                    <b>@s.Count</b>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            </div>

            <div class="row g-3 mt-1">
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold">آخرین تسک‌ها</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var t in dash.RecentTasks)
                            {
                                <li class="list-group-item list-group-item-action" style="cursor:pointer" @onclick="() => OpenTask(t.Id)">
                                    <span class="font-monospace fs-8">@t.Number</span> @t.Title
                                    <div class="fs-8 text-muted">@t.StatusName · @(t.AssigneeName ?? "—")</div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
                <div class="col-lg-6">
                    <div class="card border-0 shadow-sm">
                        <div class="card-header bg-white fw-semibold">آخرین مشکلات باز</div>
                        <ul class="list-group list-group-flush">
                            @foreach (var p in dash.RecentProblems)
                            {
                                <li class="list-group-item">
                                    <span class="badge @SevBadge(p.Severity)">@p.SeverityFa</span> @p.Title
                                    <div class="fs-8 text-muted">@p.ModuleName · @PersianDate.ToShort(p.CreatedAt)</div>
                                </li>
                            }
                            @if (dash.RecentProblems.Count == 0)
                            {
                                <li class="list-group-item text-muted text-center">مشکل بازی نیست 🎉</li>
                            }
                        </ul>
                    </div>
                </div>
            </div>
        }

        @* ========== تنظیمات ========== *@
        else if (tab == "settings")
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-header bg-white fw-semibold"><i class="bi bi-git"></i> وب‌هوک گیت (GitHub / GitLab)</div>
                <div class="card-body fs-8">
                    <p class="mb-2">بعد از هر push، کامیت‌هایی که به تسک ارجاع دهند خودکار لینک و changelog می‌سازند.</p>
                    <ul class="mb-2">
                        <li>GitHub: <code>POST /api/dev-team/hooks/github</code> — Secret در تنظیمات سرور + رویداد push</li>
                        <li>GitLab: <code>POST /api/dev-team/hooks/gitlab</code> — Secret token همان مقدار</li>
                        <li>سلامت: <code>GET /api/dev-team/hooks/health</code></li>
                    </ul>
                    <p class="mb-1">در پیام کامیت بنویسید:</p>
                    <pre class="bg-light border rounded p-2 mb-0" style="direction:ltr;text-align:left">fix(office): pagination DT-1405-0003
# یا: task:12   و اختیاری  mod:Office</pre>
                    <p class="text-muted mt-2 mb-0">Secret را در <code>appsettings</code> با کلید <code>DevTeam:GitWebhookSecret</code> یا متغیر <code>DEVTEAM_GIT_WEBHOOK_SECRET</code> بگذارید.</p>
                </div>
            </div>
            @if (!access.CanManage)
            {
                <div class="alert alert-info">فقط با مجوز Manage می‌توانید وضعیت‌ها و کاتالوگ ماژول را ویرایش کنید.</div>
            }
            else
            {
                <div class="row g-3">
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white d-flex justify-content-between">
                                <span class="fw-semibold">وضعیت‌های workflow</span>
                                <button class="btn btn-sm btn-outline-primary" @onclick="OpenNewStatus"><i class="bi bi-plus"></i></button>
                            </div>
                            <ul class="list-group list-group-flush">
                                @foreach (var s in allStatuses.OrderBy(x => x.SortOrder))
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <span>
                                            <span class="dt-col-dot" style="background:@s.Color;display:inline-block;width:10px;height:10px;border-radius:50%"></span>
                                            <b>@s.NameFa</b>
                                            <code class="fs-8">@s.Key</code>
                                            @if (s.IsInitial) { <span class="badge text-bg-info">شروع</span> }
                                            @if (s.IsDone) { <span class="badge text-bg-success">پایان</span> }
                                            @if (s.IsBlocked) { <span class="badge text-bg-danger">مسدود</span> }
                                            @if (!s.IsActive) { <span class="badge text-bg-secondary">غیرفعال</span> }
                                        </span>
                                        <button class="btn btn-sm btn-link" @onclick="() => EditStatus(s)"><i class="bi bi-pencil"></i></button>
                                    </li>
                                }
                            </ul>
                        </div>
                    </div>
                    <div class="col-lg-6">
                        <div class="card border-0 shadow-sm">
                            <div class="card-header bg-white d-flex justify-content-between">
                                <span class="fw-semibold">کاتالوگ ماژول‌ها</span>
                                <button class="btn btn-sm btn-outline-primary" @onclick="OpenNewModule"><i class="bi bi-plus"></i></button>
                            </div>
                            <div class="list-group list-group-flush" style="max-height:480px;overflow:auto">
                                @foreach (var m in allModules.OrderBy(x => x.SortOrder))
                                {
                                    <div class="list-group-item d-flex justify-content-between">
                                        <span>
                                            <i class="bi @(m.Icon ?? "bi-box")" style="color:@m.Color"></i>
                                            @m.NameFa <code class="fs-8">@m.Key</code>
                                            @if (!m.IsActive) { <span class="badge text-bg-secondary">خاموش</span> }
                                        </span>
                                        <button class="btn btn-sm btn-link" @onclick="() => EditModule(m)"><i class="bi bi-pencil"></i></button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        }
    }
</div>

@* ===================== مودال تسک ===================== *@
@if (showTaskModal)
{
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.45)" @onclick="CloseTaskModal">
        <div class="modal-dialog modal-lg modal-dialog-scrollable" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@(editingTaskId is null ? "تسک جدید" : $"تسک {taskFormNumber}")</h5>
                    <button type="button" class="btn-close" @onclick="CloseTaskModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label">عنوان *</label>
                            <input class="form-control" @bind="taskForm.Title" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">نوع</label>
                            <select class="form-select" @bind="taskForm.Type">
                                @foreach (var t in lookups.TaskTypes)
                                {
                                    <option value="@t">@TypeFa(t)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">اولویت</label>
                            <select class="form-select" @bind="taskForm.Priority">
                                <option value="0">کم</option>
                                <option value="1">عادی</option>
                                <option value="2">بالا</option>
                                <option value="3">بحرانی</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">وضعیت</label>
                            <select class="form-select" @bind="taskFormStatusId">
                                @foreach (var s in lookups.Statuses.Where(x => x.IsActive))
                                {
                                    <option value="@s.Id">@s.NameFa</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">ماژول</label>
                            <select class="form-select" @bind="taskFormModuleId">
                                <option value="0">—</option>
                                @foreach (var m in lookups.Modules)
                                {
                                    <option value="@m.Id">@m.NameFa</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">اسپرینت</label>
                            <select class="form-select" @bind="taskFormSprintId">
                                <option value="0">—</option>
                                @foreach (var s in lookups.Sprints)
                                {
                                    <option value="@s.Id">@s.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">مسئول</label>
                            <select class="form-select" @bind="taskFormAssigneeId">
                                <option value="0">—</option>
                                @foreach (var u in lookups.Users)
                                {
                                    <option value="@u.Id">@u.Name</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">مهلت (شمسی مثل 1405/01/15)</label>
                            <input class="form-control" @bind="taskDueInput" placeholder="1405/01/15" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">تخمین ساعت</label>
                            <input type="number" step="0.5" min="0" class="form-control" @bind="taskForm.EstimateHours" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">پیشرفت ٪</label>
                            <input type="number" min="0" max="100" class="form-control" @bind="taskForm.Progress" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">برچسب‌ها (با کاما)</label>
                            <input class="form-control" @bind="taskForm.Tags" placeholder="api,ui,urgent" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">شرح</label>
                            <textarea class="form-control" rows="4" @bind="taskForm.Description"></textarea>
                        </div>
                    </div>

                    @if (taskDetail is not null)
                    {
                        <hr />
                        @if (taskDetail.ParentTaskId is int parentId)
                        {
                            <div class="alert alert-secondary py-2 d-flex flex-wrap align-items-center gap-2">
                                <i class="bi bi-diagram-2"></i>
                                <span>ساب‌تسکِ</span>
                                <button type="button" class="btn btn-sm btn-link p-0" @onclick="() => OpenTask(parentId)">
                                    @(taskDetail.ParentTaskNumber) — @(taskDetail.ParentTaskTitle)
                                </button>
                                @if (access.CanUpdate)
                                {
                                    <button class="btn btn-sm btn-outline-primary ms-auto" @onclick="PromoteCurrent">ارتقا به تسک اصلی</button>
                                }
                            </div>
                        }
                        @if (taskDetail.IsDependencyBlocked)
                        {
                            <div class="alert alert-warning py-2 fs-8">
                                <i class="bi bi-lock-fill"></i>
                                این تسک @taskDetail.OpenBlockerCount وابستگی باز دارد و تا اتمام آن‌ها «انجام‌شده» نمی‌شود.
                            </div>
                        }
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3 p-2 rounded border bg-light">
                            <i class="bi bi-card-checklist"></i>
                            <span class="fw-semibold">دستور کار:</span>
                            @if (taskDetail.WorkOrderId is int woid)
                            {
                                <a class="badge text-bg-primary text-decoration-none" href="work-orders?open=@woid">@taskDetail.WorkOrderNumber</a>
                                @if (access.CanUpdate)
                                {
                                    <button class="btn btn-sm btn-outline-secondary" @onclick="UnlinkWo">قطع اتصال</button>
                                }
                            }
                            else if (access.CanCreate || access.CanUpdate)
                            {
                                <button class="btn btn-sm btn-outline-primary" disabled="@saving" @onclick="CreateWoFromTask">
                                    <i class="bi bi-plus-lg"></i> ساخت دستور کار از این تسک
                                </button>
                                <div class="input-group input-group-sm" style="max-width:220px">
                                    <input type="number" class="form-control" placeholder="شناسه WO موجود" @bind="linkWoId" />
                                    <button class="btn btn-outline-secondary" @onclick="LinkExistingWo">اتصال</button>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted fs-8">متصل نیست</span>
                            }
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <h6 class="mb-0"><i class="bi bi-diagram-3"></i> ساب‌تسک‌ها
                                        @if (taskDetail.SubTaskCount > 0)
                                        {
                                            <span class="badge text-bg-light border">@taskDetail.SubTaskDoneCount/@taskDetail.SubTaskCount</span>
                                        }
                                    </h6>
                                </div>
                                @if (taskDetail.SubTaskCount > 0)
                                {
                                    <div class="progress mb-2" style="height:6px">
                                        @{
                                            var spct = taskDetail.SubTaskCount == 0 ? 0 :
                                                (int)Math.Round(100.0 * taskDetail.SubTaskDoneCount / taskDetail.SubTaskCount);
                                        }
                                        <div class="progress-bar" style="width:@(spct)%"></div>
                                    </div>
                                }
                                @foreach (var st in taskDetail.SubTasks)
                                {
                                    <div class="d-flex align-items-center gap-2 border-bottom py-1 fs-8" style="cursor:pointer" @onclick="() => OpenTask(st.Id)">
                                        <span class="dt-col-dot" style="background:@st.StatusColor;display:inline-block;width:8px;height:8px;border-radius:50%"></span>
                                        <code>@st.Number</code>
                                        <span class="flex-grow-1">@st.Title</span>
                                        <span class="text-muted">@st.StatusName</span>
                                        @if (st.IsDependencyBlocked)
                                        {
                                            <i class="bi bi-lock text-warning" title="مسدود"></i>
                                        }
                                    </div>
                                }
                                @if (access.CanCreate)
                                {
                                    <div class="input-group input-group-sm mt-2">
                                        <input class="form-control" placeholder="عنوان ساب‌تسک جدید…" @bind="subTaskTitle" @onkeydown="OnSubTaskKey" />
                                        <button class="btn btn-outline-primary" disabled="@saving" @onclick="AddSubTask">+</button>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6><i class="bi bi-link-45deg"></i> وابستگی‌ها</h6>
                                <div class="fs-8 text-muted mb-1">مسدودکننده‌ها (باید اول تمام شوند):</div>
                                @foreach (var d in taskDetail.BlockedBy)
                                {
                                    <div class="d-flex align-items-center gap-2 border-bottom py-1 fs-8">
                                        <span class="badge @(d.DependsOnIsDone ? "text-bg-success" : "text-bg-warning")">@d.KindFa</span>
                                        <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => OpenTask(d.DependsOnTaskId)">
                                            @d.DependsOnNumber — @d.DependsOnTitle
                                        </button>
                                        <span class="text-muted">@d.DependsOnStatusName</span>
                                        @if (access.CanUpdate)
                                        {
                                            <button class="btn btn-sm btn-link text-danger p-0 ms-auto" @onclick="() => RemoveDep(d.Id)"><i class="bi bi-x"></i></button>
                                        }
                                    </div>
                                }
                                @if (taskDetail.BlockedBy.Count == 0)
                                {
                                    <div class="fs-8 text-muted mb-2">وابستگی مسدودکننده‌ای نیست.</div>
                                }
                                @if (taskDetail.Blocking.Count > 0)
                                {
                                    <div class="fs-8 text-muted mt-2 mb-1">تسک‌های منتظر این مورد:</div>
                                    @foreach (var d in taskDetail.Blocking)
                                    {
                                        <div class="fs-8">
                                            <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => OpenTask(d.TaskId)">@d.TaskNumber</button>
                                            — @d.TaskTitle
                                        </div>
                                    }
                                }
                                @if (access.CanUpdate || access.CanCreate)
                                {
                                    <div class="input-group input-group-sm mt-2">
                                        <input class="form-control" placeholder="جستجو شماره/عنوان برای وابستگی…"
                                               @bind="depSearch" @bind:event="oninput" @bind:after="SearchDeps" />
                                    </div>
                                    @if (depResults.Count > 0)
                                    {
                                        <div class="list-group list-group-flush border rounded mt-1" style="max-height:140px;overflow:auto">
                                            @foreach (var r in depResults)
                                            {
                                                <button type="button" class="list-group-item list-group-item-action py-1 fs-8"
                                                        @onclick="() => AddDep(r.Id)">
                                                    <code>@r.Number</code> @r.Title
                                                </button>
                                            }
                                        </div>
                                    }
                                }
                            </div>
                        </div>

                        <div class="row g-3">
                            <div class="col-md-6">
                                <h6><i class="bi bi-git"></i> لینک‌های گیت</h6>
                                @foreach (var g in taskDetail.GitLinks)
                                {
                                    <div class="d-flex justify-content-between fs-8 border-bottom py-1">
                                        <span>
                                            <span class="badge text-bg-light">@g.KindFa</span>
                                            @if (!string.IsNullOrEmpty(g.Url))
                                            {
                                                <a href="@g.Url" target="_blank" rel="noopener">@g.Ref</a>
                                            }
                                            else { <code>@g.Ref</code> }
                                            @if (!string.IsNullOrEmpty(g.Title)) { <span class="text-muted"> — @g.Title</span> }
                                        </span>
                                        @if (access.CanUpdate)
                                        {
                                            <button class="btn btn-sm btn-link text-danger p-0" @onclick="() => RemoveGit(g.Id)"><i class="bi bi-x"></i></button>
                                        }
                                    </div>
                                }
                                @if (access.CanUpdate || access.CanCreate)
                                {
                                    <div class="row g-1 mt-2">
                                        <div class="col-3">
                                            <select class="form-select form-select-sm" @bind="gitKind">
                                                @foreach (var k in lookups.GitLinkKinds)
                                                {
                                                    <option value="@k">@GitFa(k)</option>
                                                }
                                            </select>
                                        </div>
                                        <div class="col-4"><input class="form-control form-control-sm" placeholder="SHA / branch / #PR" @bind="gitRef" /></div>
                                        <div class="col-3"><input class="form-control form-control-sm" placeholder="URL" @bind="gitUrl" /></div>
                                        <div class="col-2"><button class="btn btn-sm btn-outline-primary w-100" @onclick="AddGit">+</button></div>
                                    </div>
                                }
                            </div>
                            <div class="col-md-6">
                                <h6><i class="bi bi-clock"></i> زمان</h6>
                                <div class="fs-8 mb-2">صرف‌شده: <b>@taskDetail.SpentHours</b> س از @(taskDetail.EstimateHours?.ToString() ?? "—")</div>
                                @foreach (var e in taskDetail.TimeEntries.Take(5))
                                {
                                    <div class="fs-8">@e.UserName — @e.Hours س — @PersianDate.ToShort(e.WorkDate)</div>
                                }
                                @if (access.CanUpdate || access.CanCreate)
                                {
                                    <div class="input-group input-group-sm mt-2">
                                        <input type="number" step="0.25" min="0.25" max="24" class="form-control" @bind="timeHours" placeholder="ساعت" />
                                        <input class="form-control" @bind="timeNote" placeholder="یادداشت" />
                                        <button class="btn btn-outline-primary" @onclick="AddTime">ثبت</button>
                                    </div>
                                }

                                <h6 class="mt-3"><i class="bi bi-chat"></i> نظرات</h6>
                                @foreach (var c in taskDetail.Comments.Take(10))
                                {
                                    <div class="fs-8 border-bottom py-1">
                                        <b>@c.AuthorName</b> <span class="text-muted">@PersianDate.ToShortDateTime(c.CreatedAt)</span>
                                        <div>@c.Text</div>
                                    </div>
                                }
                                <div class="input-group input-group-sm mt-2">
                                    <input class="form-control" @bind="commentText" placeholder="نظر…" />
                                    <button class="btn btn-outline-primary" @onclick="AddComment">ارسال</button>
                                </div>

                                <h6 class="mt-3"><i class="bi bi-activity"></i> فعالیت</h6>
                                <div style="max-height:160px;overflow:auto">
                                    @foreach (var a in taskDetail.Activities.Take(20))
                                    {
                                        <div class="fs-8 text-muted">@PersianDate.ToShortDateTime(a.CreatedAt) — @a.ActorName: @a.ActionFa @(a.Detail)</div>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    @if (editingTaskId is not null && access.CanDelete)
                    {
                        <button class="btn btn-outline-danger me-auto" @onclick="() => DeleteTask(editingTaskId.Value)">حذف</button>
                    }
                    <button class="btn btn-light" @onclick="CloseTaskModal">انصراف</button>
                    <button class="btn btn-primary" disabled="@saving" @onclick="SaveTask">
                        @if (saving) { <span class="spinner-border spinner-border-sm"></span> } else { <span>ذخیره</span> }
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ===================== مودال مشکل ===================== *@
@if (showProblemModal)
{
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.45)" @onclick="() => showProblemModal = false">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">ثبت مشکل / خطا / هشدار</h5>
                    <button type="button" class="btn-close" @onclick="() => showProblemModal = false"></button>
                </div>
                <div class="modal-body row g-2">
                    <div class="col-12"><label class="form-label">عنوان *</label><input class="form-control" @bind="probForm.Title" /></div>
                    <div class="col-md-6">
                        <label class="form-label">شدت</label>
                        <select class="form-select" @bind="probForm.Severity">
                            <option value="Error">خطا</option>
                            <option value="Warning">هشدار</option>
