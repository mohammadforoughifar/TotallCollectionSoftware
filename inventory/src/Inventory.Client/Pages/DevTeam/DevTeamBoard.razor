    // ----- helpers -----
    private static string TypeFa(string t) => t switch
    {
        "Feature" => "فیچر", "Bug" => "باگ", "Improvement" => "بهبود",
        "Spike" => "تحقیق", "Chore" => "کار فنی", "Docs" => "مستند", _ => t
    };
    private static string GitFa(string k) => k switch
    {
        "Commit" => "کامیت", "Branch" => "شاخه", "PullRequest" => "PR", "Tag" => "تگ", _ => k
    };
    private static string ShortSha(string sha) => sha.Length <= 8 ? sha : sha[..8];
    private static string SevBadge(string s) => s switch
    {
        "Error" => "text-bg-danger", "Warning" => "text-bg-warning", _ => "text-bg-info"
    };
    private static string SprintBadge(string s) => s switch
    {
        "Active" => "text-bg-success", "Closed" => "text-bg-secondary", _ => "text-bg-primary"
    };
}
