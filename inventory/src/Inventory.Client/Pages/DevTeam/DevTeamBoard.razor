</style>

@code {
    private static readonly (string key, string label, string icon)[] TabDefs =
    {
        ("board", "کانبان", "bi-kanban"),
        ("list", "لیست", "bi-list-ul"),
        ("problems", "مشکلات", "bi-bug"),
        ("modules", "ماژول‌ها", "bi-boxes"),
        ("sprints", "اسپرینت", "bi-calendar-range"),
        ("dashboard", "داشبورد", "bi-speedometer2"),
        ("settings", "تنظیمات", "bi-gear"),
    };

    private string tab = "board";
    private bool loading = true, saving;
    private DtAccessDto access = new();
    private DtLookupsDto lookups = new();
    private DtDashboardDto? dash;
    private List<DtTaskListItemDto> boardTasks = new();
    private List<DtTaskListItemDto> listTasks = new();
    private List<DtProblemDto> problems = new();
    private List<DtModuleChangeDto> changes = new();
    private List<DtWorkflowStatusDto> allStatuses = new();
    private List<DtProductModuleDto> allModules = new();

    // filters
    private string fltQ = "";
    private int fltModuleId, fltSprintId, fltAssigneeId;
    private string fltType = "";
    private bool onlyMine;
    private string probSeverity = "", probStatus = "";
    private int probModuleId, chgModuleId;

    // task modal
    private bool showTaskModal;
    private int? editingTaskId;
    private string taskFormNumber = "";
    private DtTaskUpsertDto taskForm = new();
    private DtTaskDetailDto? taskDetail;
    private int taskFormStatusId, taskFormModuleId, taskFormSprintId, taskFormAssigneeId;
    private string taskDueInput = "";
    private string gitKind = "Commit", gitRef = "", gitUrl = "", commentText = "", timeNote = "";
    private decimal timeHours = 1;
    private int linkWoId;
    private string subTaskTitle = "";
    private string depSearch = "";
    private List<DtTaskListItemDto> depResults = new();

    // other modals
    private bool showProblemModal, showChangeModal, showSprintModal, showStatusModal, showModuleModal;
    private DtProblemUpsertDto probForm = new();
    private int probFormModuleId, probFormAssigneeId;
    private DtModuleChangeCreateDto chgForm = new();
    private int chgFormModuleId;
    private DtSprintDto sprintForm = new();
    private string sprintStartInput = "", sprintEndInput = "";
    private DtWorkflowStatusDto statusForm = new();
    private DtProductModuleDto moduleForm = new();

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = uri.Query.TrimStart('?');
        string? tabQ = null; int openId = 0;
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            var key = Uri.UnescapeDataString(kv[0]);
            var val = kv.Length > 1 ? Uri.UnescapeDataString(kv[1]) : "";
            if (key == "tab") tabQ = val;
            if (key == "open") int.TryParse(val, out openId);
        }
        if (!string.IsNullOrWhiteSpace(tabQ) && TabDefs.Any(x => x.key == tabQ))
            tab = tabQ!;
        await BootstrapAsync();
        if (openId > 0) await OpenTask(openId);
    }

    private async Task BootstrapAsync()
    {
        loading = true;
        try
        {
            access = await Api.GetAccessAsync();
            if (!access.CanView) { loading = false; return; }
            lookups = await Api.GetLookupsAsync();
            await LoadTabData();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally { loading = false; }
    }

    private async Task SwitchTab(string key)
    {
        tab = key;
        await LoadTabData();
    }

    private async Task LoadTabData()
    {
        try
        {
            switch (tab)
            {
                case "board":
                    boardTasks = await Api.BoardAsync(
                        fltSprintId > 0 ? fltSprintId : null,
                        fltModuleId > 0 ? fltModuleId : null,
                        fltAssigneeId > 0 ? fltAssigneeId : null);
                    if (onlyMine && access.UserId > 0)
                        boardTasks = boardTasks.Where(t => t.AssigneeUserId == access.UserId).ToList();
                    if (!string.IsNullOrWhiteSpace(fltQ))
                    {
                        var term = fltQ.Trim();
                        boardTasks = boardTasks.Where(t =>
                            (t.Title?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (t.Number?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false) ||
                            (t.Tags?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)).ToList();
                    }
                    if (!string.IsNullOrWhiteSpace(fltType))
                        boardTasks = boardTasks.Where(t => t.Type == fltType).ToList();
                    break;
                case "list":
                    await ReloadTasks();
                    break;
                case "problems":
                    await LoadProblems();
                    break;
                case "modules":
                    lookups.Modules = await Api.GetModulesAsync();
                    changes = await Api.QueryChangesAsync(chgModuleId > 0 ? chgModuleId : null, 80);
                    break;
                case "sprints":
                    lookups.Sprints = await Api.GetSprintsAsync();
                    break;
                case "dashboard":
                    dash = await Api.GetDashboardAsync(fltSprintId > 0 ? fltSprintId : null);
                    break;
                case "settings":
                    if (access.CanManage)
                    {
                        allStatuses = await Api.GetStatusesAsync(true);
                        allModules = await Api.GetModulesAsync(true);
                    }
                    break;
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ReloadTasks()
    {
        if (tab == "board")
        {
            await LoadTabData();
            return;
        }
        try
        {
            var res = await Api.QueryTasksAsync(new DtTaskQuery
            {
                Q = string.IsNullOrWhiteSpace(fltQ) ? null : fltQ,
                ModuleId = fltModuleId > 0 ? fltModuleId : null,
                SprintId = fltSprintId > 0 ? fltSprintId : null,
                AssigneeUserId = fltAssigneeId > 0 ? fltAssigneeId : null,
                Type = string.IsNullOrWhiteSpace(fltType) ? null : fltType,
                OnlyMine = onlyMine ? true : null,
                IncludeDone = true,
                Page = 1,
                PageSize = 200
            });
            listTasks = res.Items;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ToggleMine()
    {
        onlyMine = !onlyMine;
        await ReloadTasks();
    }

    private async Task LoadProblems()
    {
        problems = await Api.QueryProblemsAsync(
            string.IsNullOrWhiteSpace(probSeverity) ? null : probSeverity,
            string.IsNullOrWhiteSpace(probStatus) ? null : probStatus,
            probModuleId > 0 ? probModuleId : null);
    }

    private async Task SelectModule(int id)
    {
        chgModuleId = chgModuleId == id ? 0 : id;
        changes = await Api.QueryChangesAsync(chgModuleId > 0 ? chgModuleId : null, 80);
    }

    private async Task FilterBySprint(int id)
    {
        fltSprintId = id;
        tab = "board";
        await LoadTabData();
    }

    private async Task MoveTask(int id, int statusId)
    {
        try
        {
            await Api.MoveTaskAsync(id, statusId);
            Toast.Success("وضعیت عوض شد");
            await LoadTabData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteTask(int id)
    {
        try
        {
            await Api.DeleteTaskAsync(id);
            Toast.Success("حذف شد");
            showTaskModal = false;
            await LoadTabData();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ----- task modal -----
    private void OpenNewTask()
    {
        editingTaskId = null;
        taskFormNumber = "";
        taskDetail = null;
        taskForm = new DtTaskUpsertDto { Type = "Feature", Priority = 1 };
        taskFormStatusId = lookups.Statuses.FirstOrDefault(s => s.IsInitial)?.Id
            ?? lookups.Statuses.FirstOrDefault()?.Id ?? 0;
        taskFormModuleId = fltModuleId;
        taskFormSprintId = fltSprintId;
        taskFormAssigneeId = 0;
        taskDueInput = "";
        showTaskModal = true;
    }

    private async Task OpenTask(int id)
    {
        try
        {
            taskDetail = await Api.GetTaskAsync(id);
            if (taskDetail is null) { Toast.Error("تسک یافت نشد"); return; }
            editingTaskId = id;
            taskFormNumber = taskDetail.Number;
            taskForm = new DtTaskUpsertDto
            {
                Title = taskDetail.Title,
                Description = taskDetail.Description,
                Type = taskDetail.Type,
                Priority = taskDetail.Priority,
                EstimateHours = taskDetail.EstimateHours,
                Progress = taskDetail.Progress,
                Tags = taskDetail.Tags,
                DueAt = taskDetail.DueAt
            };
            taskFormStatusId = taskDetail.StatusId;
            taskFormModuleId = taskDetail.ModuleId ?? 0;
            taskFormSprintId = taskDetail.SprintId ?? 0;
            taskFormAssigneeId = taskDetail.AssigneeUserId ?? 0;
            taskDueInput = taskDetail.DueAt is DateTime d ? PersianDate.ToInput(d) : "";
            gitKind = "Commit"; gitRef = ""; gitUrl = ""; commentText = ""; timeHours = 1; timeNote = "";
            showTaskModal = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void CloseTaskModal() => showTaskModal = false;

    private async Task SaveTask()
    {
        saving = true;
        try
        {
            taskForm.StatusId = taskFormStatusId > 0 ? taskFormStatusId : null;
            taskForm.ModuleId = taskFormModuleId > 0 ? taskFormModuleId : null;
            taskForm.SprintId = taskFormSprintId > 0 ? taskFormSprintId : null;
            taskForm.AssigneeUserId = taskFormAssigneeId > 0 ? taskFormAssigneeId : null;
            taskForm.DueAt = string.IsNullOrWhiteSpace(taskDueInput) ? null : PersianDate.TryParse(taskDueInput);

            if (editingTaskId is int id)
                taskDetail = await Api.UpdateTaskAsync(id, taskForm);
            else
                taskDetail = await Api.CreateTaskAsync(taskForm);

            editingTaskId = taskDetail.Id;
            taskFormNumber = taskDetail.Number;
            Toast.Success("ذخیره شد");
            await LoadTabData();
            // refresh detail
            taskDetail = await Api.GetTaskAsync(taskDetail.Id);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task AddGit()
    {
        if (editingTaskId is not int id) { Toast.Info("ابتدا تسک را ذخیره کنید"); return; }
        try
        {
