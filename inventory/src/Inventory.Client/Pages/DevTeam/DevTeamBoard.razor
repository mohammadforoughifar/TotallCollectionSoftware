    .dt-pri-2 { background:#ffedd5; color:#c2410c; }
    .dt-pri-3 { background:#fee2e2; color:#b91c1c; }
    .dt-st-badge { color:#fff; font-size:.72rem; padding:.2rem .5rem; border-radius:.35rem; white-space:nowrap; }
    .dt-kpi { background:#fff; border-radius:.75rem; padding:1rem; box-shadow:0 1px 3px rgba(15,23,42,.06); text-align:center; }
    .dt-kpi-v { font-size:1.6rem; font-weight:700; color:#0f172a; }
    .dt-kpi-l { font-size:.8rem; color:#64748b; }
    .dt-kpi.danger .dt-kpi-v { color:#dc2626; }
    .dt-kpi.warn .dt-kpi-v { color:#d97706; }
    .dt-kpi.err .dt-kpi-v { color:#e11d48; }
