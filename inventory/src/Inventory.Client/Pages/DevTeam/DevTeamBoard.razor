    // ----- sprint -----
    private void OpenNewSprint()
    {
        sprintForm = new DtSprintDto { Status = "Planned", StartDate = DateTime.Today, EndDate = DateTime.Today.AddDays(13) };
        sprintStartInput = PersianDate.ToInput(sprintForm.StartDate);
        sprintEndInput = PersianDate.ToInput(sprintForm.EndDate);
        showSprintModal = true;
    }

    private async Task SaveSprint()
    {
        saving = true;
        try
        {
            var s = PersianDate.TryParse(sprintStartInput);
            var e = PersianDate.TryParse(sprintEndInput);
            if (s is null || e is null) throw new InvalidOperationException("تاریخ شروع/پایان نامعتبر است.");
            sprintForm.StartDate = s.Value;
            sprintForm.EndDate = e.Value;
            await Api.UpsertSprintAsync(sprintForm);
            showSprintModal = false;
            lookups.Sprints = await Api.GetSprintsAsync();
            Toast.Success("اسپرینت ذخیره شد");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

