@page "/report-works"
@inject IReportWorkService ReportSvc
@inject IProjectService ProjectSvc
@inject IToastService Toast
@inject IAuthState Auth
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>گزارش‌های کار</PageTitle>

<style>
    .re-code {
        display: inline-block; background: #fef3c7; color: #92400e; border: 1px solid #fcd34d;
        border-radius: 7px; padding: 1px 8px; font-weight: 800; letter-spacing: .02em; font-size: .82rem;
    }

    /* ---------- مرتب‌سازی سرستون‌ها ---------- */
    th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
    th.sortable:hover { background: #f8fafc; }
    .sort-ic { font-size: .68rem; margin-right: .15rem; vertical-align: middle; }
    .sort-ic.muted { color: #cbd5e1; }
    .sort-ic.active { color: #6366f1; }

    /* ---------- سوییچ نمای جدول/کارت ---------- */
    .view-toggle { display: inline-flex; background: rgba(255,255,255,.22); border-radius: 9px; padding: 2px; }
    .view-toggle button {
        border: 0; background: transparent; color: #fff; opacity: .75;
        border-radius: 7px; padding: .2rem .6rem; font-size: .82rem;
    }
    .view-toggle button.on { background: #fff; color: #92400e; opacity: 1; font-weight: 800; }

    /* ---------- نمای کارت گزارش‌ها ---------- */
    .rw-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: .85rem; padding: 1rem; }
    .rw-card {
        border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; padding: .9rem 1rem;
        box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 6px 18px rgba(15,23,42,.05);
        display: flex; flex-direction: column; gap: .5rem; transition: box-shadow .15s ease, transform .15s ease;
    }
    .rw-card:hover { box-shadow: 0 3px 6px rgba(15,23,42,.06), 0 14px 30px rgba(15,23,42,.1); transform: translateY(-2px); }
    .rw-top { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
    .rw-date { font-weight: 800; color: #0f172a; }
    .rw-project { font-weight: 700; font-size: .9rem; color: #334155; }
    .rw-user { font-size: .8rem; color: #64748b; }
    .rw-times { display: flex; gap: .9rem; font-size: .78rem; color: #475569; flex-wrap: wrap; }
    .rw-times b { color: #334155; }
    .rw-spent { background: #eef2ff; color: #3730a3; border-radius: 999px; font-size: .74rem; font-weight: 800; padding: .2rem .7rem; }
    .rw-desc { font-size: .8rem; color: #334155; background: #f8fafc; border-radius: 9px; padding: .45rem .6rem; }
</style>

<div class="card shadow-sm mb-4">
    <div class="card-header fw-700 d-flex justify-content-between align-items-center flex-wrap gap-2"
         style="background:linear-gradient(135deg,#f59e0b,#ef4444);color:#fff;border-radius:14px 14px 0 0;">
        <span><i class="bi bi-clock-history me-2"></i>گزارش‌های کار
            <span class="badge bg-light text-dark ms-1">@items.Count.FaDigits()</span>
        </span>
        <div class="d-flex gap-2 align-items-center">
            <div class="view-toggle" title="تغییر حالت نمایش لیست">
                <button class="@(!viewCards ? "on" : "")" title="نمای جدولی" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                <button class="@(viewCards ? "on" : "")" title="نمای کارت" @onclick="() => SetView(true)"><i class="bi bi-grid-3x2-gap"></i></button>
            </div>
            @if (Auth.Has("ReportWorks.Read") && items.Count > 0)
            {
                <button class="btn btn-light btn-sm fw-700 shadow-sm" style="border-radius:8px;color:#065f46;"
                        title="چاپ گزارش‌های همین لیست (طبق فیلتر جاری)" @onclick="PrintList" disabled="@printing">
                    @if (printing) { <span class="spinner-border spinner-border-sm"></span> }
                    else { <i class="bi bi-printer"></i> }
                    چاپ
                </button>
            }
            @if (Auth.Has("ReportWorks.Create"))
            {
                <button class="btn btn-light btn-sm fw-700 shadow-sm" style="border-radius:8px;color:#92400e;"
                        data-hotkey="f2" title="کلید میانبر: F2" @onclick="OpenNew">
                    <i class="bi bi-plus-lg"></i> گزارش کار جدید (F2)
                </button>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-3"><SearchSelect Items="lookups.Projects" @bind-Value="filterProject" Placeholder="همه پروژه‌ها" /></div>
                <div class="col-md-2"><SearchSelect Items="lookups.Users" @bind-Value="filterUser" Placeholder="همه ثبت‌کننده‌ها" /></div>
                <div class="col-md-2"><SearchSelect Items="lookups.Operators" @bind-Value="filterOperator" Placeholder="همه اپراتورها" /></div>
                <div class="col-md-2"><DatePicker @bind-Value="filterFrom" Placeholder="از تاریخ" /></div>
                <div class="col-md-2"><DatePicker @bind-Value="filterTo" Placeholder="تا تاریخ" /></div>
                <div class="col-md-1">
                    <button class="btn btn-light w-100" title="اعمال فیلتر" @onclick="Load"><i class="bi bi-funnel"></i></button>
                </div>
                <div class="col-12 text-end fs-8 text-muted">جمع: @Fmt(SumSpent())</div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3">
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (Paged.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-clock"></i><h5>گزارش کاری یافت نشد</h5></div>
        }
        else
        {
        @if (!viewCards)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => SortBy("date")'>تاریخ @((MarkupString)SortIcon("date"))</th>
                            <th class="sortable" @onclick='() => SortBy("code")'>کد پروژه @((MarkupString)SortIcon("code"))</th>
                            <th class="sortable" @onclick='() => SortBy("project")'>پروژه @((MarkupString)SortIcon("project"))</th>
                            <th class="sortable" @onclick='() => SortBy("operator")'>اپراتور @((MarkupString)SortIcon("operator"))</th>
                            <th class="sortable" @onclick='() => SortBy("user")'>ثبت‌کننده @((MarkupString)SortIcon("user"))</th>
                            <th class="sortable" @onclick='() => SortBy("start")'>شروع @((MarkupString)SortIcon("start"))</th>
                            <th class="sortable" @onclick='() => SortBy("end")'>پایان @((MarkupString)SortIcon("end"))</th>
                            <th class="sortable" @onclick='() => SortBy("rest")'>استراحت @((MarkupString)SortIcon("rest"))</th>
                            <th class="sortable" @onclick='() => SortBy("spent")'>ساعت خالص @((MarkupString)SortIcon("spent"))</th>
                            <th>شرح کار</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Paged)
                        {
                            <tr>
                                <td class="num">@r.ReportDate.ToFaDate()</td>
                                <td class="num">
                                    @if (string.IsNullOrWhiteSpace(r.CodeProject))
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                    else if (r.CodeProject.StartsWith("RE", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="re-code" dir="ltr">@r.CodeProject</span>
                                    }
                                    else
                                    {
                                        <b class="text-primary">@r.CodeProject.FaDigits()</b>
                                    }
                                </td>
                                <td class="fw-500">@r.ProjectName</td>
                                <td>
                                    @if (string.IsNullOrWhiteSpace(r.OperatorName)) { <span class="text-muted">—</span> }
                                    else { <i class="bi bi-person-gear text-muted ms-1"></i>@r.OperatorName }
                                </td>
                                <td><i class="bi bi-person text-muted ms-1"></i>@r.UserName</td>
                                <td class="num">@r.StartTime.TimeFa()</td>
                                <td class="num">@r.EndTime.TimeFa()</td>
                                <td class="num fs-8 text-muted" title="صبحانه + ناهار">@FmtRest(r)</td>
                                <td class="num fw-700 text-primary">@Fmt(r.SpentTime)</td>
                                <td class="text-truncate" style="max-width:220px" title="@r.WorkDescription">@r.WorkDescription</td>
                                <td class="text-end">
                                    @if (Auth.Has("ReportWorks.Update"))
                                    {
                                        <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil text-primary"></i></button>
                                    }
                                    @if (Auth.Has("ReportWorks.Delete"))
                                    {
                                        <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(r)"><i class="bi bi-trash text-danger"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            @* ---------- نمای کارت ---------- *@
            <div class="rw-cards">
                @foreach (var r in Paged)
                {
                    <div class="rw-card">
                        <div class="rw-top">
                            <span class="rw-date"><i class="bi bi-calendar-event ms-1"></i>@r.ReportDate.ToFaDate()</span>
                            @if (!string.IsNullOrWhiteSpace(r.CodeProject))
                            {
                                if (r.CodeProject.StartsWith("RE", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="re-code" dir="ltr">@r.CodeProject</span>
                                }
                                else
                                {
                                    <b class="text-primary">@r.CodeProject.FaDigits()</b>
                                }
                            }
                            <span class="flex-grow-1"></span>
                            <span class="rw-spent">@Fmt(r.SpentTime)</span>
                        </div>
                        <div class="rw-project" title="@r.ProjectName"><i class="bi bi-folder2-open ms-1 text-muted"></i>@r.ProjectName</div>
                        <div class="rw-user">
                            @if (!string.IsNullOrWhiteSpace(r.OperatorName)) { <span class="ms-2"><i class="bi bi-person-gear ms-1"></i>اپراتور: <b>@r.OperatorName</b></span> }
                            <span><i class="bi bi-person ms-1"></i>ثبت: @r.UserName</span>
                        </div>
                        <div class="rw-times">
                            <span>شروع: <b>@r.StartTime.TimeFa()</b></span>
                            <span>پایان: <b>@r.EndTime.TimeFa()</b></span>
                            <span title="صبحانه + ناهار">استراحت: <b>@FmtRest(r)</b></span>
                        </div>
                        <div class="rw-desc">@r.WorkDescription</div>
                        <div class="d-flex gap-1 justify-content-end">
                            @if (Auth.Has("ReportWorks.Update"))
                            {
                                <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEdit(r)"><i class="bi bi-pencil text-primary"></i></button>
                            }
                            @if (Auth.Has("ReportWorks.Delete"))
                            {
                                <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(r)"><i class="bi bi-trash text-danger"></i></button>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        <Pager Page="page" PageCount="PageCount" OnPageChanged="p => page = p" />
        }
    </div>
</div>

@* ======================= فرم گزارش کار ======================= *@
<Modal Visible="showModal" Title="@(editing ? "ویرایش گزارش کار" : "گزارش کار جدید")" OnClose="CloseModal">
    <ChildContent>
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label">پروژه <span class="text-danger">*</span></label>
            @* فقط پروژه‌های تاییدشدهٔ مدیر — پروژه‌های در انتظار تایید یا ردشده گزارش‌پذیر نیستند *@
            <SearchSelect Items="FormProjects" @bind-Value="form.ProjectId" Placeholder="جستجو و انتخاب پروژه…" />
            <div class="fs-8 text-muted mt-1">
                <i class="bi bi-info-circle ms-1"></i>
                فقط پروژه‌های <b>تاییدشدهٔ مدیر</b> در این فهرست هستند؛ پروژه‌های «در انتظار تایید» و «رد شده» گزارش‌پذیر نیستند.
            </div>
        </div>
        <div class="col-md-6">
            <label class="form-label">ثبت‌کننده</label>
            <div class="form-control bg-light d-flex align-items-center gap-1" style="height:auto;min-height:38px;">
                <i class="bi bi-person-check-fill text-success"></i>
                <b>@(editing ? editUserName : Auth.DisplayName)</b>
                <span class="fs-8 text-muted">(ثبت خودکار با کاربر جاری)</span>
            </div>
        </div>
        <div class="col-md-12">
            <label class="form-label"><i class="bi bi-person-gear text-muted ms-1"></i>اپراتور <span class="fs-8 text-muted">(کسی که کار را انجام داده — از لیست کاربران)</span></label>
            <SearchSelect Items="lookups.Operators" Value="form.OperatorId ?? 0" ValueChanged="v => form.OperatorId = v > 0 ? v : null" Placeholder="انتخاب اپراتور… (اختیاری)" />
        </div>
        <div class="col-md-4">
            <label class="form-label">تاریخ گزارش <span class="text-danger">*</span></label>
            <DatePicker Value="reportDate" ValueChanged="d => reportDate = d ?? DateTime.Today" />
        </div>
        <div class="col-md-4">
            <label class="form-label">ساعت شروع</label>
            <TimeInput @bind-Value="form.StartTime" />
        </div>
        <div class="col-md-4">
            <label class="form-label">ساعت پایان</label>
            <TimeInput @bind-Value="form.EndTime" />
        </div>
        <div class="col-md-6">
            <label class="form-label">مدت صبحانه <span class="fs-8 text-muted">(ساعت : دقیقه)</span></label>
            <TimeInput @bind-Value="form.BreakfastTime" MaxHour="8" Suffix="مدت استراحت — نه ساعت روز" />
        </div>
        <div class="col-md-6">
            <label class="form-label">مدت ناهار <span class="fs-8 text-muted">(ساعت : دقیقه)</span></label>
            <TimeInput @bind-Value="form.LunchTime" MaxHour="8" Suffix="مدت استراحت — نه ساعت روز" />
        </div>
        <div class="col-12">
            <label class="form-label">شرح کار <span class="text-danger">*</span></label>
            <textarea class="form-control" rows="3" @bind="form.WorkDescription" placeholder="شرح فعالیت انجام‌شده…"></textarea>
        </div>
    </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseModal">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-check-lg ms-1"></i> ذخیره (F1)
        </button>
    </Footer>
</Modal>

@code {
    private List<ReportWorkDto> items = new();
    private ProjectLookups lookups = new();
    private bool loading = true;
    private int filterProject, filterUser, filterOperator;
    private DateTime? filterFrom, filterTo;

    private ReportWorkDto form = new();
    private bool showModal, saving;
    private bool editing => form.Id != 0;
    private bool printing;

    /// <summary>
    /// کمبوی پروژه در فرم ثبت/ویرایش: فقط پروژه‌های تاییدشده (ReportableProjects).
    /// در حالت ویرایش، اگر پروژهٔ فعلیِ گزارش دیگر در آن فهرست نباشد (مثلاً وضعیتش عوض شده)
    /// همان یک مورد اضافه می‌شود تا کمبو خالی/گمراه‌کننده نشود.
    /// </summary>
    private List<LookupItem> FormProjects
    {
        get
        {
            var list = lookups.ReportableProjects.Count > 0 ? lookups.ReportableProjects : lookups.Projects;
            if (editing && form.ProjectId > 0 && list.All(x => x.Id != form.ProjectId))
            {
                var current = lookups.Projects.FirstOrDefault(x => x.Id == form.ProjectId);
                if (current is not null) return list.Prepend(current).ToList();
            }
            return list;
        }
    }

    private DateTime reportDate = DateTime.Today;

    private int page = 1;
    private const int PageSize = 12;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(items.Count / (double)PageSize));
    private List<ReportWorkDto> Paged
    {
        get
        {
            if (page > PageCount) page = PageCount;
            return SortedList().Skip((page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

    // ---------- مرتب‌سازی (صعودی/نزولی) ----------
    private string sortKey = "date";
    private bool sortAsc; // پیش‌فرض: روی تاریخ، نزولی (جدیدترین‌ها اول)

    private void SortBy(string key)
    {
        if (sortKey == key) sortAsc = !sortAsc;
        else { sortKey = key; sortAsc = true; }
        page = 1;
    }

    private string SortIcon(string key)
        => key != sortKey
            ? "<i class=\"bi bi-arrow-down-up sort-ic muted\"></i>"
            : sortAsc
                ? "<i class=\"bi bi-caret-up-fill sort-ic active\"></i>"
                : "<i class=\"bi bi-caret-down-fill sort-ic active\"></i>";

    private IEnumerable<T> ApplyDir<T, K>(IEnumerable<T> src, Func<T, K> key)
        => sortAsc ? src.OrderBy(key) : src.OrderByDescending(key);

    /// <summary>کدهای عددی عددی و قبل از کدهای RE مرتب شوند</summary>
    private static string CodeKey(string? s)
    {
        var t = (s ?? "").Trim();
        return long.TryParse(Fa.ToEn(t), out var n) ? "0" + n.ToString("D20") : "1" + t.ToLowerInvariant();
    }

    private List<ReportWorkDto> SortedList()
    {
        var src = items.AsEnumerable();
        IEnumerable<ReportWorkDto> q = sortKey switch
        {
            "code" => ApplyDir(src, r => CodeKey(r.CodeProject)),
            "project" => ApplyDir(src, r => r.ProjectName ?? ""),
            "user" => ApplyDir(src, r => r.UserName ?? ""),
            "operator" => ApplyDir(src, r => r.OperatorName ?? ""),
            "start" => ApplyDir(src, r => r.StartTime.Ticks),
            "end" => ApplyDir(src, r => r.EndTime.Ticks),
            "rest" => ApplyDir(src, r => (r.BreakfastTime.ToTimeSpan() + r.LunchTime.ToTimeSpan()).Ticks),
            "spent" => ApplyDir(src, r => r.SpentTime.Ticks),
            _ => ApplyDir(src, r => (r.ReportDate.Ticks / TimeSpan.TicksPerDay) * 100000L + r.Id),
        };
        return q.ToList();
    }

    // ---------- نمای جدول/کارت (با حفظ انتخاب کاربر) ----------
    private bool viewCards;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                viewCards = (await JS.InvokeAsync<string?>("localStorage.getItem", "reportsViewMode")) == "cards";
                StateHasChanged();
            }
            catch { /* در دسترس نیست */ }
        }
    }

    private async Task SetView(bool cards)
    {
        viewCards = cards;
        try { await JS.InvokeVoidAsync("localStorage.setItem", "reportsViewMode", cards ? "cards" : "table"); }
        catch { /* حافظه در دسترس نیست */ }
    }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("گزارش‌های کار");
        try { lookups = await ProjectSvc.GetLookupsAsync(); } catch { /* دسترسی نداشت */ }
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            items = await ReportSvc.GetAllAsync(
                filterProject > 0 ? filterProject : null,
                filterUser > 0 ? filterUser : null,
                filterFrom, filterTo,
                filterOperator > 0 ? filterOperator : null);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private string? editUserName;

    private void OpenNew()
    {
        if (showModal) return; // وقتی مودال باز است F2 کاری نکند
        form = new ReportWorkDto
        {
            ReportDate = DateTime.Today,
            StartTime = new TimeOnly(8, 0),
            EndTime = new TimeOnly(17, 0)
        };
        reportDate = DateTime.Today;
        editUserName = null;
        showModal = true;
    }

    private void OpenEdit(ReportWorkDto r)
    {
        form = new ReportWorkDto
        {
            Id = r.Id,
            ReportDate = r.ReportDate,
            ProjectId = r.ProjectId,
            UserId = r.UserId,
            OperatorId = r.OperatorId,
            WorkDescription = r.WorkDescription,
            StartTime = r.StartTime,
            EndTime = r.EndTime,
            BreakfastTime = r.BreakfastTime,
            LunchTime = r.LunchTime
        };
        reportDate = r.ReportDate;
        editUserName = r.UserName;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task Save()
    {
        if (form.ProjectId <= 0) { Toast.Error("پروژه را انتخاب کنید."); return; }
        if (string.IsNullOrWhiteSpace(form.WorkDescription)) { Toast.Error("شرح کار را وارد کنید."); return; }
        if (form.EndTime == form.StartTime) { Toast.Error("ساعت شروع و پایان نمی‌توانند یکسان باشند."); return; }

        form.ReportDate = reportDate;
        saving = true;
        try
        {
            if (editing)
                await ReportSvc.UpdateAsync(form.Id, form);
            else
                await ReportSvc.CreateAsync(form);
            Toast.Success(editing ? "گزارش کار ویرایش شد." : "گزارش کار ثبت شد.");
            showModal = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Delete(ReportWorkDto r)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", "آیا از حذف این گزارش کار مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await ReportSvc.DeleteAsync(r.Id);
            Toast.Success("گزارش کار حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ==================== چاپ لیست (طبق فیلتر جاری) ====================

    private async Task PrintList()
    {
        if (items.Count == 0) { Toast.Error("گزارشی برای چاپ وجود ندارد."); return; }
        printing = true;
        try
        {
            var opt = new PrintTableOptions
            {
                Title = "گزارش‌های کار",
                SubTitle = "سامانه مدیریت پروژه‌ها",
                Meta = new List<string>
                {
                    $"پروژه: {(filterProject > 0 ? lookups.Projects.FirstOrDefault(x => x.Id == filterProject)?.Name ?? "—" : "همه پروژه‌ها")}",
                    $"ثبت‌کننده: {(filterUser > 0 ? lookups.Users.FirstOrDefault(x => x.Id == filterUser)?.Name ?? "—" : "همه")}",
                    $"اپراتور: {(filterOperator > 0 ? lookups.Operators.FirstOrDefault(x => x.Id == filterOperator)?.Name ?? "—" : "همه")}",
                    $"از تاریخ: {(filterFrom?.ToFaDate() ?? "—")}",
                    $"تا تاریخ: {(filterTo?.ToFaDate() ?? "—")}",
                    $"تعداد گزارش‌ها: {items.Count.FaDigits()}"
                },
                Headers = new List<string> { "ردیف", "تاریخ", "کد پروژه", "پروژه", "اپراتور", "ثبت‌کننده", "شروع", "پایان", "استراحت", "ساعت خالص", "شرح کار" },
                Rows = items.Select((r, i) => new List<string>
                {
                    (i + 1).FaDigits(),
                    r.ReportDate.ToFaDate(),
                    r.CodeProject ?? "—",
                    r.ProjectName ?? "",
                    r.OperatorName ?? "—",
                    r.UserName ?? "",
                    r.StartTime.TimeFa(),
                    r.EndTime.TimeFa(),
                    FmtRest(r),
                    r.SpentTime.HoursFa(),
                    r.WorkDescription ?? ""
                }).ToList(),
                FooterTotal = $"جمع ساعت کار خالص: {SumSpent().HoursFa()} ساعت — تعداد گزارش‌ها: {items.Count.FaDigits()}",
                PrintedAt = DateTime.Now.ToFaDateTime().FaDigits(),
                PrintedBy = Auth.DisplayName
            };
            await JS.InvokeVoidAsync("printTableReport", opt);
        }
        catch (Exception ex) { Toast.Error($"چاپ ناموفق بود: {ex.Message}"); }
        finally { printing = false; }
    }

    // ==================== محاسبات نمایشی ====================

    private TimeSpan SumSpent() => TimeSpan.FromTicks(items.Sum(r => r.SpentTime.Ticks));

    /// <summary>نمایش بازه زمانی با ارقام فارسی — مثلاً «۸:۳۰ ساعت»</summary>
    private static string Fmt(TimeSpan t) => $"{t.HoursFa()} ساعت";

    private static string FmtRest(ReportWorkDto r)
    {
        var rest = r.BreakfastTime.ToTimeSpan() + r.LunchTime.ToTimeSpan();
        return rest.HoursFa();
    }
}
