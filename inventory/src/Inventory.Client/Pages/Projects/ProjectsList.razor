        && (string.IsNullOrEmpty(fStatus) || p.FlowStatus.ToString() == fStatus)
    ).ToList();

    private int PageCount => Math.Max(1, (int)Math.Ceiling(Filtered.Count / (double)PageSize));
    private List<ProjectEntryExitDto> Paged
    {
        get
        {
            if (page > PageCount) page = PageCount;
            return SortedFiltered().Skip((page - 1) * PageSize).Take(PageSize).ToList();
        }
    }

