    private async Task LoadImages()
    {
        if (imageProject is null) return;
        imagesLoading = true;
        try
        {
            var all = await Http.GetFromJsonAsync<List<AttachItem>>($"/api/projectattach/project/{imageProject.Id}") ?? new();
            imageItems = all.Where(a => ImageExts.Contains(Path.GetExtension(a.FileName)?.ToLowerInvariant())).ToList();
        }
        catch { imageItems = new(); }
        finally { imagesLoading = false; }
    }

    private async Task UploadImages(InputFileChangeEventArgs e)
    {
        if (imageProject is null) return;
        imageUploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(imageProject.Id.ToString()), "projectId");
            content.Add(new StringContent("4"), "type");
            var count = 0;
            foreach (var f in e.GetMultipleFiles(10))
            {
                if (!ImageExts.Contains(Path.GetExtension(f.Name)?.ToLowerInvariant())) { Toast.Error($"«{f.Name}» فایل تصویری نیست."); return; }
                var sc = new StreamContent(f.OpenReadStream(250L * 1024 * 1024));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "files", f.Name);
                count++;
            }
            if (count > 0)
            {
                var resp = await Http.PostAsync("/api/projectattach", content);
                if (resp.IsSuccessStatusCode) Toast.Success("تصویر ذخیره شد.");
                else Toast.Error($"بارگذاری ناموفق بود. (HTTP {(int)resp.StatusCode})");
            }
        }
        catch (Exception ex) { Toast.Error($"بارگذاری تصویر: {ex.Message}"); }
        finally { imageUploading = false; }
        await LoadImages();
        await Load();
    }

    private async Task ViewImage(AttachItem a)
    {
        try
        {
            var resp = await Http.GetAsync($"/api/projectattach/{a.Id}/download");
            if (!resp.IsSuccessStatusCode) { Toast.Error("نمایش تصویر ناموفق بود."); return; }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var ct = resp.Content.Headers.ContentType?.MediaType ?? "image/jpeg";
            await JS.InvokeVoidAsync("openBlob", ct, Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DownloadAttach(AttachItem a)
