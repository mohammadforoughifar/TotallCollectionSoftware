    private async Task ExportAll()
    {
        exportingAll = true;
        try
        {
            var resp = await Http.GetAsync("/api/projects/export");
            if (!resp.IsSuccessStatusCode)
            {
                var msg = "خروجی اکسل ناموفق بود.";
                try
                {
                    var body = await resp.Content.ReadAsStringAsync();
                    using var doc = System.Text.Json.JsonDocument.Parse(body);
                    if (doc.RootElement.TryGetProperty("message", out var m)) msg = m.GetString() ?? msg;
                }
                catch { msg += $" (HTTP {(int)resp.StatusCode})"; }
                Toast.Error(msg);
                return;
            }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            await JS.InvokeVoidAsync("downloadBlob", $"projects_all_{DateTime.Now:yyyyMMdd_HHmm}.xlsx",
                "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet", Convert.ToBase64String(bytes));
            Toast.Success("خروجی اکسل کل پروژه‌ها آماده شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { exportingAll = false; }
    }

    private async Task PrintReports(ProjectEntryExitDto p)
    {
        CloseMenu();
        printingId = p.Id;
        try
        {
            var reports = await ReportSvc.GetAllAsync(projectId: p.Id);
            if (reports.Count == 0)
            {
                Toast.Error("برای این پروژه هنوز گزارش کاری ثبت نشده است.");
                return;
            }
            var totalTicks = reports.Sum(r => r.SpentTime.Ticks);
            var opt = new PrintTableOptions
            {
                Title = "گزارش‌های کار پروژه",
                SubTitle = $"{p.ProjectName} — کد پروژه: {(p.ReturnProjectId > 0 ? p.CodeProject : Fa.Digits(p.CodeProject))}",
                Meta = new List<string>
                {
                    $"کارفرما: {p.KarFarmaName}",
                    $"شماره سریال: {p.SerialNumber.FaDigits()}",
                    $"تحویل گیرنده: {p.ProjectReceiver}",
                    $"تاریخ ورود: {(p.EntryDate?.ToFaDate() ?? "—")}",
                    $"تاریخ خروج: {(p.ExitDate?.ToFaDate() ?? "—")}",
                    $"تعداد گزارش‌ها: {reports.Count.FaDigits()}"
                },
                Headers = new List<string> { "ردیف", "تاریخ", "اپراتور", "ثبت‌کننده", "شروع", "پایان", "استراحت", "ساعت خالص", "شرح کار" },
                Rows = reports.OrderBy(r => r.ReportDate).Select((r, i) => new List<string>
                {
                    (i + 1).FaDigits(),
                    r.ReportDate.ToFaDate(),
                    r.OperatorName ?? "—",
                    r.UserName ?? "",
                    r.StartTime.TimeFa(),
                    r.EndTime.TimeFa(),
                    (r.BreakfastTime.ToTimeSpan() + r.LunchTime.ToTimeSpan()).HoursFa(),
                    r.SpentTime.HoursFa(),
                    r.WorkDescription ?? ""
                }).ToList(),
                FooterTotal = $"جمع ساعت کار خالص: {TimeSpan.FromTicks(totalTicks).HoursFa()} ساعت — تعداد گزارش‌ها: {reports.Count.FaDigits()}",
                PrintedAt = DateTime.Now.ToFaDateTime().FaDigits(),
                PrintedBy = Auth.DisplayName
            };
            await JS.InvokeVoidAsync("printTableReport", opt);
        }
        catch (Exception ex) { Toast.Error($"چاپ ناموفق بود: {ex.Message}"); }
        finally { printingId = 0; }
    }

