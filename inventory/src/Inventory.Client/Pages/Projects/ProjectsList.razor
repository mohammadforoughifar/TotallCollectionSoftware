    private async Task OnReturnProjectChanged(int id)
    {
        selectedReturnId = id;
        existingReturns = new();
        if (id <= 0) { reNum = 1; parentCode = ""; return; }

        var src = items.FirstOrDefault(x => x.Id == id);
        if (src is null)
        {
            try { src = await ProjectSvc.GetAsync(id); } catch { }
        }
        if (src is not null)
        {
            parentCode = src.CodeProject;
            if (string.IsNullOrWhiteSpace(form.ProjectName)) form.ProjectName = src.ProjectName;
            if (string.IsNullOrWhiteSpace(form.ProjectReceiver)) form.ProjectReceiver = src.ProjectReceiver;
            form.KarFarmaId = src.KarFarmaId;
        }
        else parentCode = id.ToString();

        try
        {
            var returns = await ProjectSvc.GetAllAsync(returned: true);
            existingReturns = returns
                .Where(x => x.CodeProject.EndsWith($"-{parentCode}"))
                .OrderBy(x => ReNumOf(x.CodeProject))
                .Select(x => x.CodeProject)
                .ToList();
        }
        catch
        {
            existingReturns = items
                .Where(x => x.ReturnProjectId > 0 && x.CodeProject.EndsWith($"-{parentCode}"))
                .OrderBy(x => ReNumOf(x.CodeProject))
                .Select(x => x.CodeProject)
                .ToList();
        }
        reNum = existingReturns.Count + 1;
    }

    private static int ReNumOf(string? code)
    {
        if (string.IsNullOrEmpty(code) || !code.StartsWith("RE")) return 0;
        var dash = code.IndexOf('-');
        return dash > 2 && int.TryParse(code.Substring(2, dash - 2), out var n) ? n : 0;
    }

    private void CloseModal() => showModal = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.ProjectName)) { Toast.Error("نام پروژه را وارد کنید."); return; }
        if (string.IsNullOrWhiteSpace(form.SerialNumber)) { Toast.Error("شماره سریال را دستی وارد کنید (مستقل از کد پروژه)."); return; }
        if (string.IsNullOrWhiteSpace(form.ProjectReceiver)) { Toast.Error("تحویل گیرنده را وارد کنید."); return; }
        if (form.KarFarmaId <= 0) { Toast.Error("کارفرما را انتخاب کنید."); return; }

        if (!editing && isReturnMode)
        {
            if (selectedReturnId <= 0) { Toast.Error("پروژه برگشتی را انتخاب کنید."); return; }
            if (reNum < 1) { Toast.Error("عدد برگشتی باید حداقل ۱ باشد."); return; }
            form.ReturnOfProjectId = selectedReturnId;
            form.ReturnProjectId = reNum;
            form.EntryDate = null;
            form.ProjectRegistrationDate = null;
        }
        else if (!editing)
        {
            form.ReturnProjectId = 0;
            form.ReturnOfProjectId = 0;
        }

        saving = true;
        try
        {
            if (editing)
            {
                await ProjectSvc.UpdateAsync(form.Id, form);
                Toast.Success("پروژه ویرایش شد.");
            }
            else
            {
                var (newId, code) = await ProjectSvc.CreateAsync(form);
                var (okFiles, failFiles) = await UploadPendingAsync(newId);
                var msg = isReturnMode ? $"پروژه برگشتی با کد «{code}» ثبت شد." : $"پروژه با کد «{code}» ثبت شد.";
                if (okFiles > 0) msg += $" {okFiles.Num()} فایل هم پیوست شد.";
                if (failFiles > 0)
                    Toast.Error(msg + $" اما {failFiles.Num()} فایل بارگذاری نشد — از منوی سطر (⋮ ← مستندات/تصاویر) دوباره اضافه کنید.");
                else
                    Toast.Success(msg);
            }
            showModal = false;
            try { lookups = await ProjectSvc.GetLookupsAsync(); } catch { }
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    // ==================== آپلود هنگام ثبت ====================

    private void AddPendingImages(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(6))
        {
            if (!ImageExts.Contains(Path.GetExtension(f.Name)?.ToLowerInvariant())) { Toast.Error($"«{f.Name}» فایل تصویری نیست."); continue; }
            if (pendingImages.Any(x => x.Name == f.Name && x.Size == f.Size)) continue;
            if (pendingImages.Count >= 6) { Toast.Error("حداکثر ۶ تصویر در هر ثبت."); break; }
            pendingImages.Add(f);
        }
    }

    private void AddPendingDocs(InputFileChangeEventArgs e)
    {
        foreach (var f in e.GetMultipleFiles(6))
        {
            if (pendingDocs.Any(x => x.Name == f.Name && x.Size == f.Size)) continue;
            if (pendingDocs.Count >= 6) { Toast.Error("حداکثر ۶ سند در هر ثبت."); break; }
            pendingDocs.Add(f);
        }
    }

    private async Task<(int Ok, int Fail)> UploadPendingAsync(int projectId)
    {
        if (pendingImages.Count == 0 && pendingDocs.Count == 0) return (0, 0);
        var ok = 0; var fail = 0;
        foreach (var (file, type) in pendingImages.Select(f => (f, 4)).Concat(pendingDocs.Select(f => (f, pendingDocType))))
        {
            try
            {
                using var content = new MultipartFormDataContent();
                content.Add(new StringContent(projectId.ToString()), "projectId");
                content.Add(new StringContent(type.ToString()), "type");
                var sc = new StreamContent(file.OpenReadStream(250L * 1024 * 1024));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(file.ContentType) ? "application/octet-stream" : file.ContentType);
                content.Add(sc, "files", file.Name);
                var resp = await Http.PostAsync("/api/projectattach", content);
                if (resp.IsSuccessStatusCode) ok++; else fail++;
            }
            catch { fail++; }
        }
        pendingImages = new();
        pendingDocs = new();
        return (ok, fail);
    }

