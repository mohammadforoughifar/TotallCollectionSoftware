    private static bool CanReport(ProjectEntryExitDto p) => p.FlowStatus is 1 or 3;

    private static string ReportBlockReason(ProjectEntryExitDto p) => p.FlowStatus switch
    {
        0 => "این پروژه در کارتابل مدیر و «در انتظار تایید» است — تا تایید مدیر، ثبت گزارش کار ممکن نیست.",
        2 => "این پروژه توسط مدیر «رد» شده است — ابتدا آن را اصلاح و دوباره به مدیر ارسال کنید.",
        _ => "ثبت/نمایش گزارش کار برای این پروژه"
    };

