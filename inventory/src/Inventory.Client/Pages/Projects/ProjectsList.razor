    // ==================== کمکی ====================

    private static string Fmt(TimeSpan t) => $"{t.HoursFa()} ساعت";

    private static string ShowCode(string? code) => string.IsNullOrEmpty(code) ? "—" : Fa.Digits(code);

    private static string ShowDetailCode(ProjectEntryExitDto p)
        => string.IsNullOrWhiteSpace(p.CodeProject)
            ? Fa.Digits(p.Id)
            : (p.ReturnProjectId > 0 || p.CodeProject.StartsWith("RE", StringComparison.OrdinalIgnoreCase))
                ? p.CodeProject
                : Fa.Digits(p.CodeProject);

    private static string Dash(string? s) => string.IsNullOrWhiteSpace(s) ? "—" : Fa.Digits(s);

    private static string FormatSize(long b) =>
        Fa.Digits(b < 1024 ? $"{b}B" : b < 1024 * 1024 ? $"{b / 1024}KB" : $"{b / 1024.0 / 1024:0.#}MB");

    private static string Norm(string? s)
    {
        if (string.IsNullOrWhiteSpace(s)) return "";
        var t = s.Trim();
        var sb = new System.Text.StringBuilder(t.Length);
        foreach (var c in t)
        {
            if (c is ' ' or '_' or '\u200c') continue;
            sb.Append(
                c >= '۰' && c <= '۹' ? (char)('0' + (c - '۰')) :
                c >= '٠' && c <= '٩' ? (char)('0' + (c - '٠')) :
                c == 'ي' ? 'ی' : c == 'ك' ? 'ک' :
                char.ToLowerInvariant(c));
        }
        return sb.ToString();
    }

    private static bool Match(string? value, string filter) =>
        string.IsNullOrWhiteSpace(filter) || Norm(value).Contains(Norm(filter));
}
