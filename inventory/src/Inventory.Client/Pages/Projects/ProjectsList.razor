    // ---------- مرتب‌سازی (صعودی/نزولی) ----------
    private string sortKey = "id";
    private bool sortAsc; // پیش‌فرض: جدیدترین‌ها اول (نزولی بر اساس Id)

    private void SortBy(string key)
    {
        if (sortKey == key) sortAsc = !sortAsc;
        else { sortKey = key; sortAsc = true; }
        page = 1;
    }

    private string SortIcon(string key)
        => key != sortKey
            ? "<i class=\"bi bi-arrow-down-up sort-ic muted\"></i>"
            : sortAsc
                ? "<i class=\"bi bi-caret-up-fill sort-ic active\"></i>"
                : "<i class=\"bi bi-caret-down-fill sort-ic active\"></i>";

    private IEnumerable<T> ApplyDir<T, K>(IEnumerable<T> src, Func<T, K> key)
        => sortAsc ? src.OrderBy(key) : src.OrderByDescending(key);

    /// <summary>کلید مرتب‌سازی متن عددی: عددها عددی مرتب شوند و قبل از متن‌ها بیایند</summary>
    private static string NumStrKey(string? s)
    {
        var t = (s ?? "").Trim();
        return long.TryParse(Fa.ToEn(t), out var n) ? "0" + n.ToString("D20") : "1" + t.ToLowerInvariant();
    }

    /// <summary>کلید مرتب‌سازی کد پروژه: کدهای عددی اول و عددی؛ کدهای RE بعد و بر اساس عددشان</summary>
    private static string CodeKey(string? code) => NumStrKey(code);

    /// <summary>کلید تاریخ: خالی‌ها به انتها (در حالت نزولی که رایج‌تر است)</summary>
    private static long DateKey(DateTime? dt) => dt?.Ticks ?? long.MinValue;

    private List<ProjectEntryExitDto> SortedFiltered()
    {
        var src = Filtered;
        IEnumerable<ProjectEntryExitDto> q = sortKey switch
        {
            "code" => ApplyDir(src, p => CodeKey(p.CodeProject)),
            "name" => ApplyDir(src, p => p.ProjectName ?? ""),
            "serial" => ApplyDir(src, p => NumStrKey(p.SerialNumber)),
            "karfarma" => ApplyDir(src, p => p.KarFarmaName ?? ""),
            "entry" => ApplyDir(src, p => DateKey(p.EntryDate)),
            "exit" => ApplyDir(src, p => DateKey(p.ExitDate)),
            "factor" => ApplyDir(src, p => NumStrKey(p.FactorNumber)),
            "factortype" => ApplyDir(src, p => p.FactorTypeName ?? ""),
            "karshenasi" => ApplyDir(src, p => NumStrKey(p.KarshenasiAvalie)),
            "sabt" => ApplyDir(src, p => DateKey(p.ProjectRegistrationDate)),
            "need" => ApplyDir(src, p => DateKey(p.CustomerRequiredDate)),
            "spent" => ApplyDir(src, p => p.TotalSpentTime.Ticks),
            "folder" => ApplyDir(src, p => p.IsFolder == true),
            "status" => ApplyDir(src, p => p.FlowStatus),
            _ => ApplyDir(src, p => p.Id),
        };
        return q.ToList();
    }

