@page "/projects"
@inject IProjectService ProjectSvc
@inject IProjectCartableService CartableSvc
@inject IReportWorkService ReportSvc
@inject IToastService Toast
@inject IAuthState Auth
@inject LayoutState Layout
@inject IJSRuntime JS
@inject HttpClient Http
@inject RealtimeService Rt
@implements IDisposable

<PageTitle>ورود و خروج پروژه‌ها</PageTitle>

<style>
    /* ---------- منوی عملیات هر سطر ---------- */
    .row-actions { position: relative; display: inline-block; }
    .row-menu {
        position: absolute; top: 100%; left: 0; z-index: 1050;
        min-width: 200px; padding: 4px; text-align: right;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 12px;
        box-shadow: 0 12px 32px rgba(15,23,42,.18);
    }
    .row-menu-item {
        display: flex; align-items: center; gap: .5rem; width: 100%;
        padding: .45rem .7rem; border: 0; background: none;
        border-radius: 8px; font-size: .85rem; text-align: right; color: #1f2937;
    }
    .row-menu-item:hover { background: #f1f5f9; }
    .row-menu-item.danger { color: #dc2626; }
    .row-menu-divider { border-top: 1px solid #e5e7eb; margin: 4px 6px; }
    .menu-overlay { position: fixed; inset: 0; z-index: 3990; background: transparent; }
    /* منوی شناور — در نقطه کلیک روی صفحه قرار می‌گیرد و ارتفاعش محدود است تا بریده نشود */
    .row-menu.floating { position: fixed; top: 0; left: 0; z-index: 4000; max-height: calc(100vh - 24px); overflow-y: auto; }
    .proj-grid td { white-space: nowrap; }
    .detail-row td { padding: .35rem .5rem; border-bottom: 1px dashed #e5e7eb; }
    .detail-row td:first-child { color: #64748b; width: 42%; }
    .re-badge { background: #fef3c7; color: #92400e; border-radius: 6px; padding: 0 .35rem; font-size: .75rem; }

    /* ---------- جستجوی سرستون ---------- */
    .col-filter-row th { padding: 4px 6px !important; background: #f8fafc; vertical-align: middle; }
    .col-filter-row th:first-child { border-top-right-radius: 8px; }
    .col-filter-input {
        width: 100%; min-width: 72px; border: 1px solid #e2e8f0; border-radius: 7px;
        padding: 2px 8px; font-size: .75rem; text-align: center; color: #334155; background: #fff;
    }
    .col-filter-input:focus { outline: 0; border-color: #818cf8; box-shadow: 0 0 0 2px rgba(99,102,241,.15); }
    .col-filter-input::placeholder { color: #cbd5e1; }
    .col-filter-clear {
        border: 0; background: #fff1f2; color: #e11d48; border-radius: 7px;
        font-size: .75rem; padding: 3px 10px; white-space: nowrap;
    }
    .col-filter-clear:hover { background: #ffe4e6; }

    /* شماره پروژه برگشتی RE */
    .re-pnum {
        display: inline-block; background: #fef3c7; color: #92400e; border: 1px solid #fcd34d;
        border-radius: 7px; padding: 1px 8px; font-weight: 800; letter-spacing: .02em;
    }

    /* ---------- فرم زیبای ثبت پروژه ---------- */
    .section-pill {
        display: flex; align-items: center; gap: .5rem; font-size: .8rem; font-weight: 800;
        color: #4338ca; padding: .4rem .8rem; margin: .6rem 0 0 0;
        background: linear-gradient(90deg, #eef2ff, transparent); border-radius: 10px;
        border-right: 3px solid #6366f1;
    }
    .section-pill i { font-size: 1rem; }
    .section-pill.gold { color: #92400e; background: linear-gradient(90deg, #fef3c7, transparent); border-right-color: #f59e0b; }
    .section-pill.green { color: #065f46; background: linear-gradient(90deg, #d1fae5, transparent); border-right-color: #10b981; }

    .reg-card {
        flex: 1; display: flex; align-items: center; gap: .7rem; cursor: pointer;
        border: 2px solid #e5e7eb; border-radius: 14px; padding: .8rem 1rem;
        background: #fff; transition: all .15s ease;
    }
    .reg-card:hover { border-color: #c7d2fe; background: #f8faff; }
    .reg-card.active { border-color: #6366f1; background: #eef2ff; box-shadow: 0 4px 14px rgba(99,102,241,.16); }
    .reg-card.active.re { border-color: #f59e0b; background: #fffbeb; box-shadow: 0 4px 14px rgba(245,158,11,.18); }
    .reg-card .ic {
        width: 42px; height: 42px; border-radius: 12px; display: flex; align-items: center; justify-content: center;
        font-size: 1.25rem; background: #eef2ff; color: #6366f1; flex-shrink: 0;
    }
    .reg-card.active.re .ic { background: #fef3c7; color: #d97706; }
    .reg-card b { display: block; font-size: .9rem; }
    .reg-card small { color: #64748b; font-size: .72rem; }

    .locked-field {
        display: flex; align-items: center; gap: .5rem; min-height: 38px;
        background: linear-gradient(135deg, #f1f5f9, #e2e8f0); border: 1px dashed #94a3b8;
        border-radius: .375rem; padding: .375rem .75rem; font-weight: 800; font-size: 1.05rem; color: #1e293b;
    }
    .locked-field i { color: #64748b; font-size: .9rem; }
    .locked-field.gold {
        background: linear-gradient(135deg, #fffbeb, #fef3c7); border-color: #f59e0b; color: #92400e;
        font-size: 1.15rem; letter-spacing: .03em;
    }

    .serial-final { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 8px; padding: .3rem .6rem; margin-top: .4rem; font-size: .8rem; }
    .by-user-chip {
        display: inline-flex; align-items: center; gap: .45rem; background: #ecfdf5; color: #065f46;
        border: 1px solid #a7f3d0; border-radius: 999px; padding: .3rem .9rem; font-size: .85rem; font-weight: 700;
    }

    /* ---------- مودال فاکتور ---------- */
    .factor-head {
        display: flex; align-items: center; gap: .8rem; padding: .8rem 1rem; margin-bottom: 1rem;
        background: linear-gradient(135deg, #ecfdf5, #f0fdf4); border: 1px solid #bbf7d0; border-radius: 12px;
    }
    .factor-head .fi {
        width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: #d1fae5; color: #059669; font-size: 1.3rem;
    }
    .kbd-hint {
        display: inline-block; background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe;
        border-radius: 6px; padding: 0 .4rem; font-size: .7rem; font-weight: 800;
    }

    /* ---------- مودال تاریخ‌های پروژه ---------- */
    .date-count-chip {
        margin-right: auto; background: #eef2ff; color: #4338ca; border-radius: 999px;
        font-size: .68rem; font-weight: 800; padding: 0 .45rem;
    }
    .dates-head {
        display: flex; align-items: center; gap: .8rem; padding: .8rem 1rem; margin-bottom: 1rem;
        background: linear-gradient(135deg, #eff6ff, #eef2ff); border: 1px solid #bfdbfe; border-radius: 12px;
    }
    .dates-head .di {
        width: 44px; height: 44px; border-radius: 12px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        background: #dbeafe; color: #2563eb; font-size: 1.3rem;
    }
    .date-field { border: 1px solid #eef2f7; border-radius: 12px; padding: .6rem .75rem; background: #fff; height: 100%; }
    .date-field.filled { border-color: #a7f3d0; background: #fbfefc; }
    .date-field .df-title { display: flex; align-items: center; gap: .4rem; font-size: .82rem; font-weight: 700; color: #334155; margin-bottom: .4rem; }
    .date-field .df-hint { font-size: .7rem; color: #94a3b8; margin-top: .3rem; }
    .date-field .df-clear { border: 0; background: #fff1f2; color: #e11d48; border-radius: 6px; font-size: .68rem; padding: 0 .45rem; }
    .date-field .df-clear:hover { background: #ffe4e6; }
    .entry-ref { background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 9px; padding: .4rem .7rem; font-size: .78rem; color: #475569; }

    /* ---------- باکس آپلود تصاویر/مستندات در فرم جدید ---------- */
    .upload-box { border: 1.5px dashed #c7d2fe; border-radius: 12px; padding: .7rem .9rem; background: #fbfcff; height: 100%; }
    .upload-box.green { border-color: #a7f3d0; background: #fbfefc; }
    .upload-btn {
        display: inline-flex; align-items: center; gap: .4rem; background: #eef2ff; color: #4338ca;
        border-radius: 8px; padding: .35rem .8rem; font-size: .8rem; font-weight: 700; cursor: pointer; margin: 0;
    }
    .upload-box.green .upload-btn { background: #ecfdf5; color: #047857; }
    .upload-btn:hover { filter: brightness(.97); }
    .pending-list {
        list-style: none; margin: .6rem 0 0 0; padding: 0; display: flex; flex-direction: column;
        gap: .3rem; max-height: 108px; overflow: auto;
    }
    .pending-list li {
        display: flex; align-items: center; gap: .4rem; font-size: .78rem;
        background: #fff; border: 1px solid #eef2f7; border-radius: 8px; padding: .25rem .5rem;
    }
    .pending-list li > span { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .pending-x { border: 0; background: #fff1f2; color: #e11d48; border-radius: 6px; padding: 0 .4rem; flex-shrink: 0; }
    .pending-x:hover { background: #ffe4e6; }
    .doc-type-select { max-width: 132px; }

    /* ---------- مرتب‌سازی سرستون‌ها ---------- */
    th.sortable { cursor: pointer; user-select: none; white-space: nowrap; }
    th.sortable:hover { background: #f8fafc; }
    .sort-ic { font-size: .68rem; margin-right: .15rem; vertical-align: middle; }
    .sort-ic.muted { color: #cbd5e1; }
    .sort-ic.active { color: #6366f1; }

    /* ---------- سوییچ نمایش جدول/کارت ---------- */
    .view-toggle { display: inline-flex; background: rgba(255,255,255,.22); border-radius: 9px; padding: 2px; }
    .view-toggle button {
        border: 0; background: transparent; color: #fff; opacity: .75;
        border-radius: 7px; padding: .2rem .6rem; font-size: .82rem;
    }
    .view-toggle button.on { background: #fff; color: #4338ca; opacity: 1; font-weight: 800; }

    /* ---------- نمای کارت پروژه ---------- */
    .proj-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: .85rem; padding: 1rem; }
    .proj-card {
        border: 1px solid #e5e7eb; border-radius: 14px; background: #fff; padding: .9rem 1rem;
        box-shadow: 0 1px 2px rgba(15,23,42,.04), 0 6px 18px rgba(15,23,42,.05);
        display: flex; flex-direction: column; gap: .5rem; transition: box-shadow .15s ease, transform .15s ease;
    }
    .proj-card:hover { box-shadow: 0 3px 6px rgba(15,23,42,.06), 0 14px 30px rgba(15,23,42,.1); transform: translateY(-2px); }
    .pc-top { display: flex; align-items: center; justify-content: space-between; gap: .5rem; }
    .pc-code { font-weight: 800; color: #4f46e5; font-size: 1.02rem; }
    .pc-name { font-weight: 800; font-size: .95rem; color: #0f172a; }
    .pc-rows { display: flex; flex-direction: column; gap: .28rem; font-size: .8rem; color: #334155; }
    .pc-rows .lbl { color: #94a3b8; font-size: .72rem; margin-left: .35rem; }
    .pc-foot { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; border-top: 1px dashed #e5e7eb; padding-top: .5rem; }
    .pc-chip { background: #eef2ff; color: #3730a3; border-radius: 999px; font-size: .72rem; font-weight: 700; padding: .15rem .6rem; }
    .pc-chip.green { background: #d1fae5; color: #065f46; }
</style>

<div class="card shadow-sm mb-4" style="position: relative; z-index: 30;">
    <div class="card-header fw-700 d-flex justify-content-between align-items-center flex-wrap gap-2"
         style="background:linear-gradient(135deg,#8e5cff,#06b6d4);color:#fff;border-radius:14px 14px 0 0;">
        <span><i class="bi bi-arrow-left-right me-2"></i>ورود و خروج پروژه‌ها
            <span class="badge bg-light text-dark ms-1">
                @(HasColFilter ? $"{Filtered.Count.FaDigits()} از {items.Count.FaDigits()}" : items.Count.FaDigits())
            </span>
        </span>
        <div class="d-flex gap-2 align-items-center">
            <div class="view-toggle" title="تغییر حالت نمایش لیست">
                <button class="@(!viewCards ? "on" : "")" title="نمای جدولی" @onclick="() => SetView(false)"><i class="bi bi-table"></i></button>
                <button class="@(viewCards ? "on" : "")" title="نمای کارت" @onclick="() => SetView(true)"><i class="bi bi-grid-3x2-gap"></i></button>
            </div>
            @if (Auth.Has("Projects.Export"))
            {
                <button class="btn btn-light btn-sm fw-700 shadow-sm" style="border-radius:8px;color:#047857;"
                        title="خروجی اکسل از کل پروژه‌ها (همه سطرها، بدون توجه به فیلتر)" @onclick="ExportAll" disabled="@exportingAll">
                    @if (exportingAll)
                    {
                        <span class="spinner-border spinner-border-sm"></span>
                        <text> در حال آماده‌سازی…</text>
                    }
                    else
                    {
                        <i class="bi bi-file-earmark-excel"></i>
                    }
                    خروجی اکسل کل پروژه‌ها
                </button>
            }
            @if (Auth.Has("Projects.Create"))
            {
                <button class="btn btn-light btn-sm fw-700 shadow-sm" style="border-radius:8px;color:#4f5b8a;"
                        data-hotkey="f2" title="کلید میانبر: F2" @onclick="OpenNew">
                    <i class="bi bi-plus-lg"></i> پروژه جدید (F2)
                </button>
            }
        </div>
    </div>

    <div class="card">
        <div class="card-body">
            <div class="row g-2 align-items-center">
                <div class="col-md-3">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input class="form-control" placeholder="نام، سریال، گیرنده، شماره فاکتور…" @bind="search" @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-2"><SearchSelect Items="lookups.KarFarmas" @bind-Value="filterKarfarma" Placeholder="همه کارفرماها" /></div>
                @if (canViewFactor)
                {
                    <div class="col-md-2"><SearchSelect Items="lookups.TypeFactors" @bind-Value="filterTypeFactor" Placeholder="همه انواع فاکتور" /></div>
                }
                <div class="col-md-2"><SearchSelect Items="lookups.Users" @bind-Value="filterUser" Placeholder="همه کاربران" /></div>
                <div class="col-md-2">
                    <div class="form-check mt-2">
                        <input class="form-check-input" type="checkbox" id="retChk" @bind="filterReturned" />
                        <label class="form-check-label" for="retChk">فقط برگشتی‌ها</label>
                    </div>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-light w-100" title="اعمال فیلتر" @onclick="Load"><i class="bi bi-funnel"></i></button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mt-3" style="position: relative; z-index: 1;">
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-folder2-open"></i><h5>پروژه‌ای یافت نشد</h5></div>
        }
        else
        {
        @if (!viewCards)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle proj-grid">
                    <thead>
                        <tr>
                            <th class="sortable" @onclick='() => SortBy("code")'>شماره پروژه @((MarkupString)SortIcon("code"))</th>
                            <th class="sortable" @onclick='() => SortBy("name")'>نام پروژه @((MarkupString)SortIcon("name"))</th>
                            <th class="sortable" @onclick='() => SortBy("serial")'>شماره سریال @((MarkupString)SortIcon("serial"))</th>
                            <th class="sortable" @onclick='() => SortBy("karfarma")'>کارفرما @((MarkupString)SortIcon("karfarma"))</th>
                            <th class="sortable" @onclick='() => SortBy("entry")'>تاریخ ورود @((MarkupString)SortIcon("entry"))</th>
                            <th class="sortable" @onclick='() => SortBy("exit")'>تاریخ خروج @((MarkupString)SortIcon("exit"))</th>
                            @if (canViewFactor)
                            {
                                <th class="sortable" @onclick='() => SortBy("factor")'>شماره فاکتور @((MarkupString)SortIcon("factor"))</th>
                                <th class="sortable" @onclick='() => SortBy("factortype")'>نوع فاکتور @((MarkupString)SortIcon("factortype"))</th>
                            }
                            <th class="sortable" @onclick='() => SortBy("karshenasi")'>کارشناسی اولیه @((MarkupString)SortIcon("karshenasi"))</th>
                            <th class="sortable" @onclick='() => SortBy("sabt")'>تاریخ ثبت پروژه @((MarkupString)SortIcon("sabt"))</th>
                            <th class="sortable" @onclick='() => SortBy("need")'>تاریخ نیاز مشتری @((MarkupString)SortIcon("need"))</th>
                            <th class="sortable" @onclick='() => SortBy("spent")'>کل زمان مصرفی @((MarkupString)SortIcon("spent"))</th>
                            <th class="sortable" @onclick='() => SortBy("folder")'>پوشه @((MarkupString)SortIcon("folder"))</th>
                            <th class="sortable" @onclick='() => SortBy("status")'>وضعیت @((MarkupString)SortIcon("status"))</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                        <tr class="col-filter-row">
                            <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fNum" @bind:event="oninput" /></th>
                            <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fName" @bind:event="oninput" /></th>
                            <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fSerial" @bind:event="oninput" /></th>
                            <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fKarfarma" @bind:event="oninput" /></th>
                            <th><DateFilterInput @bind-Text="fEntry" /></th>
                            <th><DateFilterInput @bind-Text="fExit" /></th>
                            @if (canViewFactor)
                            {
                                <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fFactor" @bind:event="oninput" /></th>
                                <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fFactorType" @bind:event="oninput" /></th>
                            }
                            <th><input class="col-filter-input" placeholder="🔍 جستجو" @bind="fKarshenasi" @bind:event="oninput" /></th>
                            <th><DateFilterInput @bind-Text="fSabt" /></th>
                            <th><DateFilterInput @bind-Text="fNeed" /></th>
                            <th>
                                <input class="col-filter-input" placeholder="ساعت — مثلا 2:" @bind="fSpent" @bind:event="oninput" dir="ltr" />
                            </th>
                            <th>
                                <select class="col-filter-input" @bind="fFolder">
                                    <option value="">همه</option>
                                    <option value="y">دارد</option>
                                    <option value="n">ندارد</option>
                                </select>
                            </th>
                            <th>
                                <select class="col-filter-input" @bind="fStatus">
                                    <option value="">همه</option>
                                    <option value="0">در انتظار تایید مدیر</option>
                                    <option value="1">در انتظار کارشناسی</option>
                                    <option value="2">رد شده</option>
                                    <option value="3">نهایی</option>
                                </select>
                            </th>
                            <th class="text-end">
                                @if (HasColFilter)
                                {
                                    <button class="col-filter-clear" title="پاک کردن جستجوی ستون‌ها" @onclick="ClearColFilters">
                                        <i class="bi bi-x-lg"></i> پاک کردن
                                    </button>
                                }
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Paged)
                        {
                            <tr>
                                <td class="num fw-700">
                                    @if (p.ReturnProjectId > 0)
                                    {
                                        <span class="re-pnum" dir="ltr">@p.CodeProject</span>
                                    }
                                    else
                                    {
                                        <span class="text-primary">@ShowCode(p.CodeProject)</span>
                                    }
                                </td>
                                <td class="fw-500">
                                    @p.ProjectName
                                    @if (p.ReturnProjectId > 0) { <span class="re-badge ms-1">برگشتی</span> }
                                </td>
                                <td class="num">@p.SerialNumber.FaDigits()</td>
                                <td>@p.KarFarmaName</td>
                                <td class="num">@(p.EntryDate?.ToFaDate() ?? "—")</td>
                                <td class="num">@(p.ExitDate?.ToFaDate() ?? "—")</td>
                                @if (canViewFactor)
                                {
                                    <td class="num">@Dash(p.FactorNumber)</td>
                                    <td>@p.FactorTypeName</td>
                                }
                                <td class="num">@Dash(p.KarshenasiAvalie)</td>
                                <td class="num">@(p.ProjectRegistrationDate?.ToFaDate() ?? "—")</td>
                                <td class="num">@(p.CustomerRequiredDate?.ToFaDate() ?? "—")</td>
                                <td class="num" title="جمع گزارش‌های کار">@Fmt(p.TotalSpentTime)</td>
                                <td>
                                    @if (p.IsFolder == true)
                                    {
                                        <span class="badge badge-soft-success"><i class="bi bi-folder-fill"></i> دارد</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-soft-muted">ندارد</span>
                                    }
                                </td>
                                <td><FlowChip Status="p.FlowStatus" /></td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-light" title="عملیات" @onclick="e => ToggleMenu(p, e)" @onclick:stopPropagation>
                                        <i class="bi bi-three-dots-vertical"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
                @if (Filtered.Count == 0)
                {
                    <div class="text-center text-muted fs-8 py-4">
                        <i class="bi bi-search"></i> با این جستجوی ستون‌ها موردی پیدا نشد.
                        <button class="btn btn-link btn-sm" @onclick="ClearColFilters">پاک کردن جستجوها</button>
                    </div>
                }
            </div>
        }
        else
        {
            @* ---------- نمای کارت ---------- *@
            @if (Paged.Count == 0)
            {
                <div class="text-center text-muted fs-8 py-4">
                    <i class="bi bi-search"></i> با این جستجوی ستون‌ها موردی پیدا نشد.
                    <button class="btn btn-link btn-sm" @onclick="ClearColFilters">پاک کردن جستجوها</button>
                </div>
            }
            else
            {
                <div class="proj-cards">
                    @foreach (var p in Paged)
                    {
                        <div class="proj-card">
                            <div class="pc-top">
                                @if (p.ReturnProjectId > 0)
                                {
                                    <span class="re-pnum" dir="ltr">@p.CodeProject</span>
                                    <span class="re-badge">برگشتی</span>
                                }
                                else
                                {
                                    <span class="pc-code">@ShowCode(p.CodeProject)</span>
                                }
                                <span class="flex-grow-1"></span>
                                <button class="btn btn-sm btn-light" title="عملیات" @onclick="e => ToggleMenu(p, e)" @onclick:stopPropagation>
                                    <i class="bi bi-three-dots-vertical"></i>
                                </button>
                            </div>
                            <div class="pc-name" title="@p.ProjectName">@p.ProjectName</div>
                            <div class="pc-rows">
                                <div><span class="lbl">سریال:</span><b>@p.SerialNumber.FaDigits()</b><span class="lbl me-3">کارفرما:</span>@p.KarFarmaName</div>
                                <div><span class="lbl">ورود:</span>@(p.EntryDate?.ToFaDate() ?? "—")<span class="lbl me-3">خروج:</span>@(p.ExitDate?.ToFaDate() ?? "—")</div>
                                @if (canViewFactor)
                                {
                                    <div><span class="lbl">فاکتور:</span>@(p.FactorTypeName ?? "—") @Dash(p.FactorNumber)</div>
                                }
                                <div><span class="lbl">کارشناسی:</span>@Dash(p.KarshenasiAvalie)</div>
                                <div><span class="lbl">تاریخ ثبت:</span>@(p.ProjectRegistrationDate?.ToFaDate() ?? "—")<span class="lbl me-3">نیاز مشتری:</span>@(p.CustomerRequiredDate?.ToFaDate() ?? "—")</div>
                            </div>
                            <div class="pc-foot">
                                <span class="pc-chip" title="جمع گزارش‌های کار"><i class="bi bi-clock-history ms-1"></i>@Fmt(p.TotalSpentTime)</span>
                                @if (p.IsFolder == true)
                                {
                                    <span class="pc-chip green"><i class="bi bi-folder-fill ms-1"></i>پوشه دارد</span>
                                }
                                <FlowChip Status="p.FlowStatus" />
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <Pager Page="page" PageCount="PageCount" OnPageChanged="p => page = p" />
        }
    </div>
</div>

@* ======================= منوی شناور عملیات سطر — در نقطه کلیک باز می‌شود (داخل جدول بریده نمی‌شود) ======================= *@
@if (menuProject is not null)
{
    <div class="menu-overlay" @onclick="CloseMenu"></div>
    <div class="row-menu floating" style="@MenuStyle" @onclick:stopPropagation>
        @if (Auth.Has("Projects.Update"))
        {
            <button class="row-menu-item" @onclick="() => OpenEdit(menuProject)">
                <i class="bi bi-pencil text-primary"></i> ویرایش اطلاعات
            </button>
            <button class="row-menu-item" @onclick="() => OpenFactor(menuProject)">
                <i class="bi bi-receipt text-success"></i> ثبت/ویرایش فاکتور
            </button>
            <button class="row-menu-item" @onclick="() => OpenDates(menuProject)">
                <i class="bi bi-calendar2-check text-primary"></i> ثبت/ویرایش تاریخ‌ها
                @if (DateFilledCount(menuProject) > 0)
                {
                    <span class="date-count-chip">@DateFilledCount(menuProject).FaDigits()/۵</span>
                }
            </button>
            @if (menuProject.FlowStatus == 2)
            {
                <button class="row-menu-item" @onclick="() => OpenResubmit(menuProject)">
                    <i class="bi bi-arrow-repeat text-warning"></i> ارسال مجدد به مدیر
                </button>
            }
        }
        @if (Auth.Has("ReportWorks.Create") || Auth.Has("ReportWorks.Read"))
        {
            @* لیست گزارش‌های کار پروژه (و امکان افزودن گزارش کار از همان‌جا) *@
            <button class="row-menu-item" disabled="@(!CanReport(menuProject))"
                    title="@ReportBlockReason(menuProject)" @onclick="() => OpenProjectReportsList(menuProject)">
                <i class="bi bi-clock-history @(CanReport(menuProject) ? "text-warning" : "text-muted")"></i> گزارش‌های کار / ثبت جدید
                @if (!CanReport(menuProject))
                {
                    <i class="bi bi-lock-fill text-muted ms-auto fs-8"></i>
                }
            </button>
        }
        @if (Auth.Has("ReportWorks.Read"))
        {
            <button class="row-menu-item" disabled="@(printingId == menuProject.Id)" @onclick="() => PrintReports(menuProject)">
                @if (printingId == menuProject.Id)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-printer text-primary"></i>
                }
                چاپ گزارش‌های پروژه
            </button>
        }
        @if (Auth.Has("Projects.Read"))
        {
            <button class="row-menu-item" @onclick="() => OpenDetails(menuProject)">
                <i class="bi bi-info-circle text-info"></i> نمایش جزئیات پروژه
            </button>
        }
        @if (Auth.HasModule("ProjectAttach"))
        {
            <button class="row-menu-item" @onclick="() => OpenAttach(menuProject)">
                <i class="bi bi-paperclip text-secondary"></i> مستندات (@menuProject.AttachCount.Num())
            </button>
            <button class="row-menu-item" @onclick="() => OpenImages(menuProject)">
                <i class="bi bi-images text-success"></i> تصاویر پروژه
            </button>
        }
        @if (Auth.Has("Projects.Export"))
        {
            <div class="row-menu-divider"></div>
            <button class="row-menu-item" disabled="@(exportingId == menuProject.Id)" @onclick="() => Export(menuProject)">
                @if (exportingId == menuProject.Id)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                else
                {
                    <i class="bi bi-file-earmark-excel text-success"></i>
                }
                خروجی اکسل
            </button>
        }
        @if (Auth.Has("Projects.Delete"))
        {
            <div class="row-menu-divider"></div>
            <button class="row-menu-item danger" @onclick="() => Delete(menuProject)">
                <i class="bi bi-trash"></i> حذف اطلاعات
            </button>
        }
    </div>
}

@* ======================= فرم ثبت/ویرایش پروژه (بزرگ و زیبا) ======================= *@
<Modal Visible="showModal" Size="modal-xl" Title="@(editing ? $"ویرایش پروژه «{form.ProjectName}»" : "ثبت پروژه جدید")" OnClose="CloseModal">
    <ChildContent>
    <div class="row g-3">
        @if (!editing)
        {
            <div class="col-12 section-pill"><i class="bi bi-tag-fill"></i> نوع ثبت</div>
            <div class="col-12 d-flex gap-3 flex-wrap">
                <div class="reg-card @(!isReturnMode ? "active" : "")" @onclick="() => isReturnMode = false">
                    <div class="ic"><i class="bi bi-box-arrow-in-right"></i></div>
                    <div class="flex-grow-1">
                        <b>ورود جدید</b>
                        <small>پروژه برای اولین بار وارد مجموعه می‌شود — شماره پروژه خودکار صادر می‌شود</small>
                    </div>
                    @if (!isReturnMode) { <i class="bi bi-check-circle-fill" style="color:#6366f1;"></i> }
                </div>
                <div class="reg-card re @(isReturnMode ? "active" : "")" @onclick="() => isReturnMode = true">
                    <div class="ic"><i class="bi bi-arrow-counterclockwise"></i></div>
                    <div class="flex-grow-1">
                        <b>پروژه برگشتی</b>
                        <small>پروژه‌ای که قبلاً خارج شده دوباره برمی‌گردد — شماره‌اش «REn-کد پروژه مبدأ» می‌شود</small>
                    </div>
                    @if (isReturnMode) { <i class="bi bi-check-circle-fill" style="color:#d97706;"></i> }
                </div>
            </div>

            @if (isReturnMode)
            {
                <div class="col-12 section-pill gold"><i class="bi bi-arrow-counterclockwise"></i> انتخاب پروژه برگشتی</div>
                <div class="col-md-5">
                    <label class="form-label">پروژه برگشتی <span class="text-danger">*</span></label>
                    <SearchSelect Items="lookups.BaseProjects" Value="selectedReturnId"
                                  ValueChanged="OnReturnProjectChanged" Placeholder="جستجو بر اساس نام یا کد پروژه…" />
                    <div class="fs-8 text-muted mt-1"><i class="bi bi-info-circle ms-1"></i>فقط پروژه‌های اصلی (RE‌ندارن) نمایش داده می‌شوند.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label"><i class="bi bi-123 text-muted ms-1"></i>عدد برگشتی <span class="text-danger">*</span></label>
                    <input class="form-control" type="number" min="1" max="9999" @bind="reNum" @bind:event="oninput" />
                    <div class="fs-8 text-muted mt-1">دستی وارد کنید (مثلاً 1 ← RE1)</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label"><i class="bi bi-lock-fill text-muted ms-1"></i>کد پروژه (خودکار)</label>
                    <div class="locked-field gold" dir="ltr">
                        <i class="bi bi-arrow-counterclockwise"></i>
                        <span>@(selectedReturnId > 0 && reNum >= 1 ? $"RE{reNum}-{parentCode}" : "RE…-…")</span>
                    </div>
                    <div class="fs-8 text-muted mt-1">از «عدد برگشتی» + «کد پروژه مبدأ» ساخته می‌شود.</div>
                </div>
                @if (selectedReturnId > 0)
                {
                    <div class="col-12">
                        <div class="alert border-0 py-2 mb-0 fs-8 d-flex align-items-center flex-wrap gap-2" style="background:#fffbeb;">
                            <i class="bi bi-arrow-counterclockwise" style="color:#d97706;"></i>
                            @if (existingReturns.Count == 0)
                            {
                                <span>برای پروژه «@parentCode» هنوز برگشتی ثبت نشده — این <b>اولین برگشتی (RE1)</b> است.</span>
                            }
                            else
                            {
                                <span>برگشتی‌های ثبت‌شده برای این پروژه (<b>@existingReturns.Count.FaDigits()</b> مورد):</span>
                                @foreach (var c in existingReturns)
                                {
                                    <span class="re-pnum" dir="ltr">@c</span>
                                }
                                <span class="text-muted">← عدد بعدی پیشنهادی: <b>@Fa.Digits(reNum)</b></span>
                            }
                        </div>
                    </div>
                }
            }
        }

        <div class="col-12 section-pill"><i class="bi bi-info-circle-fill"></i> اطلاعات اصلی</div>

        @if (!editing && !isReturnMode)
        {
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-lock-fill text-muted ms-1"></i>کد پروژه</label>
                <div class="locked-field">
                    <span>@(string.IsNullOrWhiteSpace(nextSerialSuggestion) ? "…" : Fa.Digits(nextSerialSuggestion))</span>
                    <span class="fs-8 text-muted fw-normal">(خودکار — آخرین کد + ۱)</span>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-hash text-muted ms-1"></i>شماره سریال <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.SerialNumber" placeholder="دستی وارد کنید — مثلاً 234589" />
                <div class="fs-8 text-muted mt-1">مستقل از شماره پروژه است.</div>
            </div>
        }
        @if (editing)
        {
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-lock-fill text-muted ms-1"></i>کد پروژه</label>
                <div class="locked-field @(form.ReturnProjectId > 0 ? "gold" : "")" dir="@(form.ReturnProjectId > 0 ? "ltr" : "rtl")">
                    <span>@ShowDetailCode(form)</span>
                    <span class="fs-8 text-muted fw-normal">(غیرقابل تغییر)</span>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-hash text-muted ms-1"></i>شماره سریال <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.SerialNumber" />
            </div>
        }
        @if (!editing && isReturnMode)
        {
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-hash text-muted ms-1"></i>شماره سریال <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.SerialNumber" placeholder="دستی وارد کنید — مثلاً 234589" />
                <div class="fs-8 text-muted mt-1">سریال کاملاً مستقل از شماره پروژه (RE) است.</div>
            </div>
        }

        <div class="col-md-4">
            <label class="form-label"><i class="bi bi-folder-fill text-warning ms-1"></i>نام پروژه <span class="text-danger">*</span></label>
            <input class="form-control" @bind="form.ProjectName" />
        </div>
        <div class="col-md-4">
            <label class="form-label"><i class="bi bi-briefcase-fill text-muted ms-1"></i>کارفرما <span class="text-danger">*</span></label>
            <SearchSelect Items="lookups.KarFarmas" @bind-Value="form.KarFarmaId" Placeholder="جستجوی کارفرما…" />
        </div>
        <div class="col-md-4">
            <label class="form-label"><i class="bi bi-person-lines-fill text-muted ms-1"></i>تحویل گیرنده <span class="text-danger">*</span></label>
            <input class="form-control" @bind="form.ProjectReceiver" />
        </div>
        <div class="col-md-4 d-flex align-items-end gap-2">
            <span class="by-user-chip" title="ثبت با کاربر جاری شما انجام می‌شود">
                <i class="bi bi-person-check-fill"></i>
                ثبت‌کننده: @(editing ? (editUserName ?? Auth.DisplayName) : Auth.DisplayName)
            </span>
        </div>
        <div class="col-md-4 d-flex align-items-end">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" id="folderChk" @bind="isFolder" />
                <label class="form-check-label" for="folderChk">دارای پوشه</label>
            </div>
        </div>

        @* تاریخ ورود و تاریخ ثبت — فقط در فرم «ثبت» پروژه (ورود جدید) *@
        @if (!editing && !isReturnMode)
        {
            <div class="col-12 section-pill green"><i class="bi bi-calendar3"></i> تاریخ‌های ثبت</div>
            <div class="col-md-3"><label class="form-label">تاریخ ورود پروژه</label><DatePicker @bind-Value="form.EntryDate" AllowClear /></div>
            <div class="col-md-3"><label class="form-label">تاریخ ثبت پروژه</label><DatePicker @bind-Value="form.ProjectRegistrationDate" AllowClear /></div>
        }

        <div class="col-12 section-pill"><i class="bi bi-file-text-fill"></i> جزئیات فنی</div>
        <div class="col-md-4">
            <label class="form-label">قبض خروج</label>
            <input class="form-control" @bind="form.GhabzExit" />
        </div>
        <div class="col-md-4">
            <label class="form-label">کارشناسی اولیه</label>
            <input class="form-control" @bind="form.KarshenasiAvalie" />
        </div>
        <div class="col-12">
            <label class="form-label">شرح</label>
            <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
        </div>

        @if (!editing)
        {
            <div class="col-12">
                <div class="alert alert-light border py-2 mb-0 fs-8 d-flex align-items-center gap-2">
                    <i class="bi bi-receipt text-success"></i>
                    شماره فاکتور و نوع فاکتور را می‌توانید <b>بعداً</b> از منوی سطر (⋮) با گزینه «ثبت/ویرایش فاکتور» تکمیل کنید.
                </div>
            </div>
        }

        @* ---------- آپلود تصاویر و مستندات (هنگام ثبت — خودکار بعد از ایجاد پروژه) ---------- *@
        @if (!editing && Auth.Has("ProjectAttach.Create"))
        {
            <div class="col-12 section-pill green"><i class="bi bi-cloud-upload-fill"></i> تصاویر و مستندات (اختیاری)</div>
            <div class="col-md-6">
                <div class="upload-box green">
                    <div class="d-flex align-items-center gap-2">
                        <label class="upload-btn">
                            <i class="bi bi-images"></i> افزودن تصویر…
                            <InputFile OnChange="AddPendingImages" multiple accept="image/*" style="display:none" />
                        </label>
                        <span class="fs-8 text-muted">فقط فایل تصویری — حداکثر ۶ فایل</span>
                    </div>
                    @if (pendingImages.Count > 0)
                    {
                        <ul class="pending-list">
                            @foreach (var f in pendingImages)
                            {
                                <li>
                                    <i class="bi bi-file-image text-success"></i>
                                    <span title="@f.Name">@f.Name</span>
                                    <small class="text-muted" style="flex-shrink:0">@FormatSize(f.Size)</small>
                                    <button type="button" class="pending-x" title="حذف از لیست" @onclick="() => pendingImages.Remove(f)"><i class="bi bi-x-lg"></i></button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
            <div class="col-md-6">
                <div class="upload-box">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <label class="upload-btn">
                            <i class="bi bi-paperclip"></i> افزودن سند…
                            <InputFile OnChange="AddPendingDocs" multiple style="display:none" />
                        </label>
                        <select class="form-select form-select-sm doc-type-select" @bind="pendingDocType" title="نوع سند">
                            <option value="1">قرارداد</option>
                            <option value="2">مدارک فنی</option>
                            <option value="3">تاییدیه تحویل</option>
                            <option value="4">سایر</option>
                        </select>
                        <span class="fs-8 text-muted">حداکثر ۶ فایل</span>
                    </div>
                    @if (pendingDocs.Count > 0)
                    {
                        <ul class="pending-list">
                            @foreach (var f in pendingDocs)
                            {
                                <li>
                                    <i class="bi bi-file-earmark-text text-primary"></i>
                                    <span title="@f.Name">@f.Name</span>
                                    <small class="text-muted" style="flex-shrink:0">@FormatSize(f.Size)</small>
                                    <button type="button" class="pending-x" title="حذف از لیست" @onclick="() => pendingDocs.Remove(f)"><i class="bi bi-x-lg"></i></button>
                                </li>
                            }
                        </ul>
                    }
                </div>
            </div>
        }
    </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseModal">انصراف (Esc)</button>
        <button class="btn btn-primary px-4" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-check-lg ms-1"></i> ذخیره پروژه (F1)
        </button>
    </Footer>
</Modal>

@* ======================= ثبت/ویرایش فاکتور (فرم مجزا) ======================= *@
<Modal Visible="showFactor" Title="@("فاکتور پروژه «" + (factorProject?.ProjectName ?? "") + "»")" OnClose="() => showFactor = false">
    <ChildContent>
        @if (factorProject is not null)
        {
            <div class="factor-head">
                <div class="fi"><i class="bi bi-receipt"></i></div>
                <div class="flex-grow-1">
                    <div class="fw-800">@factorProject.ProjectName</div>
                    <div class="fs-8 text-muted">
                        کد پروژه: <b dir="@(factorProject.ReturnProjectId > 0 ? "ltr" : "rtl")">@ShowDetailCode(factorProject)</b>
                        — سریال: @factorProject.SerialNumber.FaDigits()
                    </div>
                </div>
            </div>
            <div class="row g-3">
                <div class="col-12">
                    <label class="form-label"><i class="bi bi-card-list text-muted ms-1"></i>نوع فاکتور <span class="text-danger">*</span></label>
                    <SearchSelect Items="lookups.TypeFactors" @bind-Value="factorTypeId" Placeholder="جستجوی نوع فاکتور…" />
                </div>
                <div class="col-12">
                    <label class="form-label"><i class="bi bi-123 text-muted ms-1"></i>شماره فاکتور</label>
                    <input class="form-control" @bind="factorNumber" placeholder="مثلاً F-1024" />
                </div>
                <div class="col-12">
                    <div class="alert alert-light border py-2 mb-0 fs-8">
                        <i class="bi bi-shield-lock ms-1"></i>
                        این اطلاعات را می‌توانید هر زمان از منوی سطر بازگردید و ویرایش کنید.
                        رویت ستون‌های فاکتور در لیست، نیازمند مجوز «رویت ستون‌های فاکتور» است.
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showFactor = false">انصراف (Esc)</button>
        <button class="btn btn-success px-4" data-hotkey="f1" title="کلید میانبر: F1" @onclick="SaveFactor" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-check-lg ms-1"></i> ثبت فاکتور (F1)
        </button>
    </Footer>
</Modal>

@* ======================= ثبت/ویرایش تاریخ‌های پروژه (فرم مجزا — مثل فاکتور) ======================= *@
<Modal Visible="showDates" Size="modal-lg" Title="@("تاریخ‌های پروژه «" + (datesProject?.ProjectName ?? "") + "»")" OnClose="() => showDates = false">
    <ChildContent>
        @if (datesProject is not null)
        {
            <div class="dates-head">
                <div class="di"><i class="bi bi-calendar2-check"></i></div>
                <div class="flex-grow-1">
                    <div class="fw-800">@datesProject.ProjectName</div>
                    <div class="fs-8 text-muted">
                        کد پروژه: <b dir="@(datesProject.ReturnProjectId > 0 ? "ltr" : "rtl")">@ShowDetailCode(datesProject)</b>
                        — سریال: @datesProject.SerialNumber.FaDigits()
                        — کارفرما: @datesProject.KarFarmaName
                    </div>
                </div>
                <span class="entry-ref">
                    <i class="bi bi-box-arrow-in-right ms-1"></i>
                    تاریخ ورود: <b>@datesProject.EntryDate.ToFaDate()</b>
                </span>
            </div>

            <div class="row g-3">
                <div class="col-md-6">
                    <div class="date-field @(datesForm.CustomerRequiredDate is not null ? "filled" : "")">
                        <div class="df-title">
                            <i class="bi bi-person-check text-info"></i> تاریخ نیاز مشتری
                            @if (datesForm.CustomerRequiredDate is not null)
                            {
                                <button class="df-clear ms-auto" title="پاک کردن" @onclick="() => datesForm.CustomerRequiredDate = null">
                                    <i class="bi bi-x-lg"></i> پاک
                                </button>
                            }
                        </div>
                        <DatePicker @bind-Value="datesForm.CustomerRequiredDate" AllowClear Placeholder="انتخاب تاریخ…" />
                        <div class="df-hint">تاریخی که مشتری پروژه را برای آن می‌خواهد (موعد تعهد).</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="date-field @(datesForm.DeliveryDate is not null ? "filled" : "")">
                        <div class="df-title">
                            <i class="bi bi-truck text-success"></i> تاریخ تحویل پروژه
                            @if (datesForm.DeliveryDate is not null)
                            {
                                <button class="df-clear ms-auto" title="پاک کردن" @onclick="() => datesForm.DeliveryDate = null">
                                    <i class="bi bi-x-lg"></i> پاک
                                </button>
                            }
                        </div>
                        <DatePicker @bind-Value="datesForm.DeliveryDate" AllowClear Placeholder="انتخاب تاریخ…" />
                        <div class="df-hint">تاریخی که پروژه عملاً به مشتری تحویل داده شد.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="date-field @(datesForm.TemporaryExitDate is not null ? "filled" : "")">
                        <div class="df-title">
                            <i class="bi bi-box-arrow-up-right text-warning"></i> تاریخ خروج موقت
                            @if (datesForm.TemporaryExitDate is not null)
                            {
                                <button class="df-clear ms-auto" title="پاک کردن" @onclick="() => datesForm.TemporaryExitDate = null">
                                    <i class="bi bi-x-lg"></i> پاک
                                </button>
                            }
                        </div>
                        <DatePicker @bind-Value="datesForm.TemporaryExitDate" AllowClear Placeholder="انتخاب تاریخ…" />
                        <div class="df-hint">خروج موقت پروژه از مجموعه (قرار است برگردد).</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="date-field @(datesForm.ExitDate is not null ? "filled" : "")">
                        <div class="df-title">
                            <i class="bi bi-box-arrow-right text-danger"></i> تاریخ خروج
                            @if (datesForm.ExitDate is not null)
                            {
                                <button class="df-clear ms-auto" title="پاک کردن" @onclick="() => datesForm.ExitDate = null">
                                    <i class="bi bi-x-lg"></i> پاک
                                </button>
                            }
                        </div>
                        <DatePicker @bind-Value="datesForm.ExitDate" AllowClear Placeholder="انتخاب تاریخ…" />
                        <div class="df-hint">خروج نهایی پروژه از مجموعه.</div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="date-field @(datesForm.FileDate is not null ? "filled" : "")">
                        <div class="df-title">
                            <i class="bi bi-folder-check text-secondary"></i> تاریخ تحویل پرونده
                            @if (datesForm.FileDate is not null)
                            {
                                <button class="df-clear ms-auto" title="پاک کردن" @onclick="() => datesForm.FileDate = null">
                                    <i class="bi bi-x-lg"></i> پاک
                                </button>
                            }
                        </div>
                        <DatePicker @bind-Value="datesForm.FileDate" AllowClear Placeholder="انتخاب تاریخ…" />
                        <div class="df-hint">تاریخ تحویل پروندهٔ مستندات پروژه.</div>
                    </div>
                </div>

                <div class="col-md-6 d-flex align-items-center">
                    <div class="alert alert-light border py-2 mb-0 fs-8 w-100">
                        <i class="bi bi-info-circle text-primary ms-1"></i>
                        هر فیلد <b>اختیاری</b> است — می‌توانید حالا خالی بگذارید و بعداً از همین فرم تکمیل یا ویرایش کنید.
                        تاریخ‌های خالی در لیست و جزئیات با «—» نمایش داده می‌شوند.
                    </div>
                </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showDates = false">انصراف (Esc)</button>
        <button class="btn btn-primary px-4" data-hotkey="f1" title="کلید میانبر: F1" @onclick="SaveDates" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-check-lg ms-1"></i> ثبت تاریخ‌ها (F1)
        </button>
    </Footer>
</Modal>

@* ======================= ارسال مجدد پروژهٔ ردشده به مدیر ======================= *@
<Modal Visible="showResubmit" Title="@("ارسال مجدد پروژه «" + (resubmitProject?.ProjectName ?? "") + "» به مدیر")" OnClose="() => showResubmit = false">
    <ChildContent>
        @if (resubmitProject is not null)
        {
            @if (!string.IsNullOrWhiteSpace(resubmitProject.ManagerNote))
            {
                <div class="alert py-2 fs-8 border-0" style="background:#fef2f2;color:#991b1b;">
                    <i class="bi bi-x-circle ms-1"></i>
                    <b>دلیل رد مدیر:</b> @resubmitProject.ManagerNote
                </div>
            }
            <label class="form-label">توضیح اصلاحات انجام‌شده <span class="fs-8 text-muted">(اختیاری — برای مدیر ارسال می‌شود)</span></label>
            <textarea class="form-control" rows="3" @bind="resubmitNote"
                      placeholder="مثلاً: مدارک فنی ناقص تکمیل و پیوست شد."></textarea>
            <div class="alert alert-light border py-2 mt-3 mb-0 fs-8">
                <i class="bi bi-arrow-repeat text-warning ms-1"></i>
                با ارسال مجدد، وضعیت پروژه به <b>«در انتظار تایید مدیر»</b> برمی‌گردد و تا زمان تایید،
                امکان ثبت گزارش کار برای آن وجود نخواهد داشت.
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showResubmit = false">انصراف (Esc)</button>
        <button class="btn btn-warning px-4 fw-700" data-hotkey="f1" @onclick="SaveResubmit" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-send ms-1"></i> ارسال به کارتابل مدیر (F1)
        </button>
    </Footer>
</Modal>

@* ======================= جزئیات پروژه ======================= *@
<Modal Visible="showDetails" Title="@("جزئیات پروژه «" + (detail?.ProjectName ?? "") + "»")" OnClose="() => showDetails = false">
    <ChildContent>
        @if (detail is not null)
        {
            <table class="table table-sm mb-0">
                <tbody>
                    <tr class="detail-row">
                        <td>وضعیت گردش‌کار</td>
                        <td>
                            <FlowChip Status="detail.FlowStatus" />
                            @if (detail.FlowStatus is 0 or 2)
                            {
                                <span class="fs-8 text-muted ms-2">(ثبت گزارش کار غیرفعال است)</span>
                            }
                        </td>
                    </tr>
                    @if (!string.IsNullOrWhiteSpace(detail.ManagerNote))
                    {
                        <tr class="detail-row">
                            <td>@(detail.FlowStatus == 2 ? "دلیل رد مدیر" : "یادداشت مدیر")</td>
                            <td class="@(detail.FlowStatus == 2 ? "text-danger" : "")">
                                @detail.ManagerNote
                                @if (detail.ManagerActionAt is not null)
                                {
                                    <span class="fs-8 text-muted ms-2">(@detail.ManagerActionAt.ToFaDate())</span>
                                }
                            </td>
                        </tr>
                    }
                    @if (!string.IsNullOrWhiteSpace(detail.ExpertNote))
                    {
                        <tr class="detail-row">
                            <td>یادداشت کارشناسی</td>
                            <td>
                                @detail.ExpertNote
                                @if (detail.ExpertActionAt is not null)
                                {
                                    <span class="fs-8 text-muted ms-2">(@detail.ExpertActionAt.ToFaDate())</span>
                                }
                            </td>
                        </tr>
                    }
                    <tr class="detail-row"><td>کد پروژه</td><td class="num fw-700 text-primary" dir="@(detail.ReturnProjectId > 0 ? "ltr" : "rtl")">@ShowDetailCode(detail)</td></tr>
                    <tr class="detail-row"><td>شماره سریال</td><td class="num">@detail.SerialNumber.FaDigits()</td></tr>
                    <tr class="detail-row"><td>کارفرما</td><td>@detail.KarFarmaName</td></tr>
                    @if (canViewFactor)
                    {
                        <tr class="detail-row"><td>نوع فاکتور / شماره فاکتور</td><td class="num">@(detail.FactorTypeName ?? "—") / @Dash(detail.FactorNumber)</td></tr>
                    }
                    <tr class="detail-row"><td>ثبت‌کننده</td><td>@detail.UserName</td></tr>
                    <tr class="detail-row"><td>تحویل گیرنده</td><td>@detail.ProjectReceiver</td></tr>
                    <tr class="detail-row"><td>کارشناسی اولیه</td><td class="num">@Dash(detail.KarshenasiAvalie)</td></tr>
                    <tr class="detail-row"><td>تاریخ ورود</td><td class="num">@(detail.EntryDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>تاریخ ثبت پروژه</td><td class="num">@(detail.ProjectRegistrationDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>تاریخ نیاز مشتری</td><td class="num">@(detail.CustomerRequiredDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>تاریخ تحویل</td><td class="num">@(detail.DeliveryDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>تاریخ تحویل پرونده</td><td class="num">@(detail.FileDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>تاریخ خروج</td><td class="num">@(detail.ExitDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>تاریخ خروج موقت</td><td class="num">@(detail.TemporaryExitDate?.ToFaDate() ?? "—")</td></tr>
                    <tr class="detail-row"><td>قبض خروج</td><td class="num">@Dash(detail.GhabzExit)</td></tr>
                    <tr class="detail-row"><td>پوشه</td><td>@(detail.IsFolder == true ? "دارد" : "ندارد")</td></tr>
                    <tr class="detail-row"><td>کل زمان مصرفی</td><td class="num">@Fmt(detail.TotalSpentTime)</td></tr>
                    <tr class="detail-row"><td>گزارش‌های کار / مستندات</td><td class="num">@detail.ReportWorkCount.Num() گزارش — @detail.AttachCount.Num() پیوست</td></tr>
                    @if (!string.IsNullOrWhiteSpace(detail.Description))
                    {
                        <tr class="detail-row"><td>شرح</td><td>@detail.Description</td></tr>
                    }
                </tbody>
            </table>
        }
    </ChildContent>
</Modal>

@* ======================= لیست گزارش‌های کار پروژه (بازشدن اول با کلیک روی «گزارش‌های کار / ثبت جدید») ======================= *@
<Modal Visible="showProjectReportsList" Size="modal-xl" Title="@("گزارش‌های کار پروژه «" + (reportsProject?.ProjectName ?? "") + "»")" OnClose="() => showProjectReportsList = false">
    <ChildContent>
        @if (reportsProject is not null)
        {
            <div class="d-flex align-items-center justify-content-between flex-wrap gap-2 mb-3 p-3 rounded-3" style="background:#f8fafc;border:1px solid #e2e8f0;">
                <div>
                    <span class="fw-800 fs-6 text-dark">@reportsProject.ProjectName</span>
                    <span class="ms-2 fs-8 text-muted">کد پروژه: <b dir="ltr">@ShowDetailCode(reportsProject)</b> — سریال: @reportsProject.SerialNumber.FaDigits()</span>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary fs-7 p-2"><i class="bi bi-clock-history ms-1"></i>جمع زمان مصرفی: @Fmt(reportsProject.TotalSpentTime)</span>
                    @if (Auth.Has("ReportWorks.Create"))
                    {
                        <button class="btn btn-warning btn-sm fw-700 shadow-sm px-3" disabled="@(!CanReport(reportsProject))"
                                title="@ReportBlockReason(reportsProject)" @onclick="() => OpenReportFromList(reportsProject)">
                            <i class="bi bi-plus-lg ms-1"></i> ثبت گزارش کار جدید
                        </button>
                    }
                </div>
            </div>

            @if (projectReportsLoading)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (projectReportItems.Count == 0)
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-clock fs-2 d-block mb-2 text-primary opacity-50"></i>
                    <span>هنوز هیچ گزارش کاری برای این پروژه ثبت نشده است.</span>
                    @if (Auth.Has("ReportWorks.Create") && CanReport(reportsProject))
                    {
                        <div class="mt-2">
                            <button class="btn btn-sm btn-outline-primary fw-700" @onclick="() => OpenReportFromList(reportsProject)">
                                <i class="bi bi-plus-lg ms-1"></i> اولین گزارش کار را ثبت کنید
                            </button>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="table-light">
                                <th>ردیف</th>
                                <th>تاریخ</th>
                                <th>ثبت‌کننده</th>
                                <th>شروع</th>
                                <th>پایان</th>
                                <th>استراحت</th>
                                <th>ساعت خالص</th>
                                <th>شرح فعالیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (r, idx) in projectReportItems.Select((r, i) => (r, i + 1)))
                            {
                                <tr>
                                    <td class="num">@idx.FaDigits()</td>
                                    <td class="num fw-700">@r.ReportDate.ToFaDate()</td>
                                    <td><i class="bi bi-person text-muted ms-1"></i>@r.UserName</td>
                                    <td class="num">@r.StartTime.TimeFa()</td>
                                    <td class="num">@r.EndTime.TimeFa()</td>
                                    <td class="num fs-8 text-muted">@((r.BreakfastTime.ToTimeSpan() + r.LunchTime.ToTimeSpan()).HoursFa())</td>
                                    <td class="num fw-700 text-primary">@Fmt(r.SpentTime)</td>
                                    <td>@r.WorkDescription</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showProjectReportsList = false">بستن</button>
    </Footer>
</Modal>

@* ======================= افزودن گزارش کار (فرم ثبت) ======================= *@
<Modal Visible="showReport" Title="@("ثبت گزارش کار برای «" + (reportProject?.ProjectName ?? "") + "»")" OnClose="() => showReport = false">
    <ChildContent>
    <div class="row g-3">
        <div class="col-12 d-flex align-items-center gap-2 flex-wrap">
            <span class="by-user-chip"><i class="bi bi-person-check-fill"></i> ثبت‌کننده: @Auth.DisplayName</span>
            @if (!string.IsNullOrWhiteSpace(reportProject?.CodeProject))
            {
                <span class="fs-8 text-muted">کد پروژه:</span>
                <span class="@(reportProject.CodeProject.StartsWith("RE", StringComparison.OrdinalIgnoreCase) ? "re-pnum" : "fw-800 text-primary")"
                      dir="@(reportProject.CodeProject.StartsWith("RE", StringComparison.OrdinalIgnoreCase) ? "ltr" : "rtl")">@ShowDetailCode(reportProject)</span>
            }
        </div>
        <div class="col-md-6">
            <label class="form-label">تاریخ گزارش <span class="text-danger">*</span></label>
            <DatePicker Value="reportDate" ValueChanged="d => reportDate = d ?? DateTime.Today" />
        </div>
        <div class="col-md-6">
            <label class="form-label"><i class="bi bi-person-gear text-muted ms-1"></i>اپراتور <span class="fs-8 text-muted">(انجام‌دهندهٔ کار — اختیاری)</span></label>
            <SearchSelect Items="lookups.Operators" Value="reportForm.OperatorId ?? 0" ValueChanged="v => reportForm.OperatorId = v > 0 ? v : null" Placeholder="انتخاب اپراتور…" />
        </div>
        <div class="col-md-3">
            <label class="form-label">ساعت شروع</label>
            <TimeInput @bind-Value="reportForm.StartTime" />
        </div>
        <div class="col-md-3">
            <label class="form-label">ساعت پایان</label>
            <TimeInput @bind-Value="reportForm.EndTime" />
        </div>
        <div class="col-md-6">
            <label class="form-label">مدت صبحانه <span class="fs-8 text-muted">(ساعت : دقیقه)</span></label>
            <TimeInput @bind-Value="reportForm.BreakfastTime" MaxHour="8" Suffix="مدت استراحت — نه ساعت روز" />
        </div>
        <div class="col-md-6">
            <label class="form-label">مدت ناهار <span class="fs-8 text-muted">(ساعت : دقیقه)</span></label>
            <TimeInput @bind-Value="reportForm.LunchTime" MaxHour="8" Suffix="مدت استراحت — نه ساعت روز" />
        </div>
        <div class="col-12">
            <label class="form-label">شرح کار <span class="text-danger">*</span></label>
            <textarea class="form-control" rows="3" @bind="reportForm.WorkDescription" placeholder="شرح فعالیت انجام‌شده…"></textarea>
        </div>
    </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showReport = false">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="SaveReport" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            <i class="bi bi-check-lg ms-1"></i> ثبت گزارش (F1)
        </button>
    </Footer>
</Modal>

@* ======================= مستندات (پیوست‌ها) ======================= *@
<Modal Visible="showAttach" Title="@("مستندات پروژه «" + (attachProject?.ProjectName ?? "") + "»")" OnClose="() => showAttach = false">
    <ChildContent>
        @if (attachProject is not null)
