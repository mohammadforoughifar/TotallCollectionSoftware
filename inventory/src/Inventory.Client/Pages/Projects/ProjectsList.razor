@* ======================= تصاویر پروژه ======================= *@
<Modal Visible="showImages" Title="@("تصاویر پروژه «" + (imageProject?.ProjectName ?? "") + "»")" OnClose="() => showImages = false">
    <ChildContent>
        @if (Auth.Has("ProjectAttach.Create"))
        {
            <div class="border rounded-3 p-2 mb-2" style="background:#f8fafc;">
                <label class="btn btn-sm btn-outline-success mb-0 @(imageUploading ? "disabled" : "")">
                    <i class="bi bi-image-add"></i> افزودن تصویر…
                    <InputFile OnChange="UploadImages" multiple accept="image/*" style="display:none" />
                </label>
                @if (imageUploading)
                {
                    <span class="spinner-border spinner-border-sm text-success ms-2"></span>
                    <span class="fs-8 text-muted">در حال رمزنگاری و بارگذاری…</span>
                }
            </div>
        }
        @if (imagesLoading)
        {
            <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
        }
        else if (imageItems.Count == 0)
        {
            <div class="text-muted fs-8 text-center py-3"><i class="bi bi-images"></i> تصویری برای این پروژه ثبت نشده است.</div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var a in imageItems)
                {
                    <div class="list-group-item px-1 d-flex align-items-center gap-2">
                        <i class="bi bi-file-image text-success"></i>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-500 text-truncate">@a.FileName</div>
                            <div class="fs-8 text-muted">@FormatSize(a.FileSize) — @a.DateSabt.ToFaDateTime().FaDigits()</div>
                        </div>
                        <button class="btn btn-sm btn-light" title="نمایش در تب جدید" @onclick="() => ViewImage(a)"><i class="bi bi-eye text-primary"></i></button>
                        <button class="btn btn-sm btn-light" title="دانلود" @onclick="() => DownloadAttach(a)"><i class="bi bi-download text-success"></i></button>
                        @if (Auth.Has("ProjectAttach.Delete"))
                        {
                            <button class="btn btn-sm btn-light" title="حذف" @onclick="() => DeleteImage(a)"><i class="bi bi-trash text-danger"></i></button>
                        }
                    </div>
                }
            </div>
        }
    </ChildContent>
</Modal>

@code {
    private List<ProjectEntryExitDto> items = new();
    private ProjectLookups lookups = new();
    private bool loading = true;
    private string search = "";
