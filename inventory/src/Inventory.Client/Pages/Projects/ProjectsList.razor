    private async Task LoadProjectReports()
    {
        if (reportsProject is null) return;
        projectReportsLoading = true;
        try
        {
            projectReportItems = await ReportSvc.GetAllAsync(projectId: reportsProject.Id);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
            projectReportItems = new();
        }
        finally
        {
            projectReportsLoading = false;
        }
    }

    private void OpenReportFromList(ProjectEntryExitDto p)
    {
        if (!CanReport(p)) { Toast.Error(ReportBlockReason(p)); return; }
        reportProject = p;
        reportForm = new ReportWorkDto
        {
            ProjectId = p.Id,
            StartTime = new TimeOnly(8, 0),
            EndTime = new TimeOnly(17, 0)
        };
        reportDate = DateTime.Today;
        showReport = true;
    }

    private async Task SaveReport()
    {
        if (string.IsNullOrWhiteSpace(reportForm.WorkDescription)) { Toast.Error("شرح کار را وارد کنید."); return; }
        if (reportForm.EndTime == reportForm.StartTime) { Toast.Error("ساعت شروع و پایان نمی‌توانند یکسان باشند."); return; }
        reportForm.ReportDate = reportDate;
        saving = true;
        try
        {
            await ReportSvc.CreateAsync(reportForm);
            Toast.Success("گزارش کار ثبت شد.");
            showReport = false;
            if (showProjectReportsList && reportsProject?.Id == reportForm.ProjectId)
            {
                await LoadProjectReports();
            }
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

