        try
        {
            var resp = await Http.GetAsync($"/api/projectattach/{a.Id}/download");
            if (!resp.IsSuccessStatusCode) { Toast.Error("دانلود ناموفق بود."); return; }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var ct = resp.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
