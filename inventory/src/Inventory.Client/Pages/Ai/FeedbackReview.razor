@page "/ai-feedback"
@inject AiAssistantService Ai

@* =====================================================================
   بازبینی بازخوردهای دستیار (§۲۴) — فقط مدیر (AiAssistant.Manage)
   ===================================================================== *@

<div class="fb-page">
    <div class="fb-head">
        <h5>👍👎 بازبینی بازخوردهای فروغ آریا</h5>
        <span class="text-muted small">امتیازهایی که کاربران به پاسخ‌های دستیار داده‌اند</span>
    </div>

    @if (loading)
    {
        <div class="text-muted p-3">در حال بارگذاری...</div>
    }
    else if (noAccess)
    {
        <div class="alert alert-warning">این صفحه فقط برای مدیر سیستم است. ⛔</div>
    }
    else if (error != null)
    {
        <div class="alert alert-danger">@error</div>
    }
    else if (stats != null)
    {
        <div class="fb-cards">
            <div class="fb-card">
                <div class="fb-num">@stats.Total</div>
                <div class="fb-lbl">کل آرا (@days روز)</div>
            </div>
            <div class="fb-card up">
                <div class="fb-num">👍 @stats.Up</div>
                <div class="fb-lbl">پسندیدم</div>
            </div>
            <div class="fb-card down">
                <div class="fb-num">👎 @stats.Down</div>
                <div class="fb-lbl">نپسندیدم</div>
            </div>
            <div class="fb-card">
                <div class="fb-num">@(stats.SatisfactionPct == null ? "—" : stats.SatisfactionPct + "٪")</div>
                <div class="fb-lbl">رضایت</div>
            </div>
        </div>

        @if (stats.ByReason.Count > 0 || stats.TopToolsDown.Count > 0)
        {
            <div class="fb-cols">
                @if (stats.ByReason.Count > 0)
                {
                    <div class="fb-panel">
                        <b>دلیل‌های نارضایتی</b>
                        @foreach (var r in stats.ByReason)
                        {
                            <div class="fb-row"><span>@r.Key</span><span class="badge bg-danger">@r.Count</span></div>
                        }
                    </div>
                }
                @if (stats.TopToolsDown.Count > 0)
                {
                    <div class="fb-panel">
                        <b>ابزارهای دخیل در پاسخ‌های ضعیف</b>
                        @foreach (var t in stats.TopToolsDown)
                        {
                            <div class="fb-row"><code>@t.Key</code><span class="badge bg-warning text-dark">@t.Count</span></div>
                        }
                    </div>
                }
            </div>
        }

        <div class="fb-filters">
            <button class="btn btn-sm @(filter == null ? "btn-primary" : "btn-outline-primary")" @onclick="() => SetFilter(null)">همه</button>
            <button class="btn btn-sm @(filter == -1 ? "btn-danger" : "btn-outline-danger")" @onclick="() => SetFilter(-1)">👎 ضعیف‌ها</button>
            <button class="btn btn-sm @(filter == 1 ? "btn-success" : "btn-outline-success")" @onclick="() => SetFilter(1)">👍 خوب‌ها</button>
        </div>

        @if (items.Count == 0)
        {
            <div class="text-muted p-2">موردی نیست.</div>
        }
        @foreach (var it in items)
        {
            <div class="fb-item @(it.Rating == 1 ? "up" : "down")">
                <div class="fb-item-head">
                    <span class="fb-badge">@(it.Rating == 1 ? "👍" : "👎")</span>
                    <b>@it.User</b>
                    <span class="text-muted small">@it.CreatedAt.ToString("yyyy/MM/dd HH:mm")</span>
                    @if (it.Reason != null)
                    {
                        <span class="badge bg-danger">@it.Reason</span>
                    }
                    @if (it.UsedFallback)
                    {
                        <span class="badge bg-warning text-dark">آفلاین</span>
                    }
                </div>
                <div class="fb-excerpt">@it.Excerpt</div>
                @if (!string.IsNullOrWhiteSpace(it.Comment))
                {
                    <div class="fb-comment">💬 @it.Comment</div>
                }
                @if (it.Tools.Count > 0)
                {
                    <div class="fb-tools">
                        @foreach (var t in it.Tools)
                        {
                            <code>@t</code>
                        }
                    </div>
                }
            </div>
        }
        @if (hasMore)
        {
            <button class="btn btn-outline-primary w-100 mt-2" disabled="@loadingMore" @onclick="LoadMore">
                @if (loadingMore)
                {
                    <span class="spinner-border spinner-border-sm"></span>
                }
                نمایش بیشتر
            </button>
        }
    }
</div>

<style>
    .fb-page { max-width: 900px; margin: 0 auto; padding: 1rem; display: flex; flex-direction: column; gap: .8rem; }
    .fb-head h5 { margin: 0; }
    .fb-cards { display: flex; gap: .6rem; flex-wrap: wrap; }
    .fb-card { flex: 1; min-width: 140px; background: #fff; border: 1px solid #e2e8f0; border-radius: .8rem; padding: .7rem; text-align: center; }
    .fb-card.up { border-color: #86efac; background: #f0fdf4; }
    .fb-card.down { border-color: #fca5a5; background: #fef2f2; }
    .fb-num { font-size: 1.4rem; font-weight: 700; }
    .fb-lbl { font-size: .8rem; color: #64748b; }
    .fb-cols { display: flex; gap: .6rem; flex-wrap: wrap; }
    .fb-panel { flex: 1; min-width: 240px; background: #fff; border: 1px solid #e2e8f0; border-radius: .8rem; padding: .7rem .9rem; }
    .fb-panel .fb-row { display: flex; justify-content: space-between; align-items: center; padding: .25rem 0; border-top: 1px solid #f1f5f9; font-size: .85rem; }
    .fb-filters { display: flex; gap: .4rem; }
    .fb-item { background: #fff; border: 1px solid #e2e8f0; border-right-width: 4px; border-radius: .7rem; padding: .6rem .8rem; }
    .fb-item.up { border-right-color: #22c55e; }
    .fb-item.down { border-right-color: #ef4444; }
    .fb-item-head { display: flex; gap: .5rem; align-items: center; flex-wrap: wrap; font-size: .85rem; }
    .fb-excerpt { margin-top: .35rem; font-size: .87rem; color: #334155; line-height: 1.9; white-space: pre-wrap; }
    .fb-comment { margin-top: .3rem; font-size: .85rem; background: #fffbeb; border: 1px solid #fde68a; border-radius: .5rem; padding: .3rem .5rem; }
    .fb-tools { margin-top: .3rem; display: flex; gap: .3rem; flex-wrap: wrap; }
    .fb-tools code { font-size: .72rem; background: #f1f5f9; padding: .05rem .4rem; border-radius: .4rem; }
</style>

@code {
    private bool loading = true;
    private bool loadingMore;
    private bool noAccess;
    private string? error;
    private int days = 14;
    private AiFeedbackStats? stats;
    private List<AiFeedbackItem> items = new();
    private int? filter;
    private int skip;
    private bool hasMore;
    private const int PageSize = 20;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            stats = await Ai.GetFeedbackStatsAsync(days);
            await LoadPage(true);
        }
        catch (Exception ex)
        {
            if (ex.Message.Contains("403") || ex.Message.Contains("Forbidden") || ex.Message.Contains("دسترسی"))
                noAccess = true;
            else
                error = ex.Message;
        }
        finally
        {
            loading = false;
        }
    }

    private async Task SetFilter(int? r)
    {
        filter = r;
        await LoadPage(true);
    }

    private async Task LoadPage(bool reset)
    {
        if (reset) { skip = 0; items.Clear(); }
        loadingMore = true;
        error = null;
        try
        {
            var page = await Ai.GetFeedbackListAsync(filter, skip, PageSize);
            items.AddRange(page);
            skip += page.Count;
            hasMore = page.Count == PageSize;
        }
        catch (Exception ex) { error = ex.Message; }
        finally { loadingMore = false; }
    }

    private async Task LoadMore() => await LoadPage(false);
}
