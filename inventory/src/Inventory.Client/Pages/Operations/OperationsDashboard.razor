@page "/operations/reports/dashboard"
@inject IAuthState Auth
@inject IDashboardService DashboardSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>داشبورد جامع عملیات</PageTitle>

@if (!CanOpenDashboard)
{
    <div class="alert alert-warning mt-3">
        <i class="bi bi-shield-exclamation"></i>
        برای مشاهدهٔ داشبورد جامع، دسترسی مشاهدهٔ خرید/فروش یا تعمیرات لازم است.
    </div>
}
else
{
    <div class="page-head">
        <div>
            <h1>داشبورد جامع عملیات</h1>
            <p class="lead">نمای یکپارچهٔ خرید، فروش، تعمیرات و عملکرد معرف‌ها</p>
        </div>
        <div class="ms-auto d-flex flex-wrap gap-2">
            @if (Auth.CanSee("Orders"))
            {
                <a class="btn btn-outline-primary" href="/operations/reports/orders/sale"><i class="bi bi-cart-check"></i> گزارش فروش</a>
                <a class="btn btn-outline-primary" href="/operations/reports/orders/purchase"><i class="bi bi-bag-check"></i> گزارش خرید</a>
            }
            <button class="btn btn-outline-secondary" disabled="@loading" @onclick="Print"><i class="bi bi-printer"></i> چاپ</button>
        </div>
    </div>

    <div class="card mb-3 d-print-none">
        <div class="card-body py-3">
            <div class="row g-2 align-items-end">
                <div class="col-6 col-lg-3">
                    <label class="form-label">از تاریخ</label>
                    <DatePicker @bind-Value="from" AllowClear="true" />
                </div>
                <div class="col-6 col-lg-3">
                    <label class="form-label">تا تاریخ</label>
                    <DatePicker @bind-Value="to" AllowClear="true" />
                </div>
                <div class="col-12 col-lg-3">
                    <button class="btn btn-primary w-100" disabled="@loading" @onclick="Load">
                        <i class="bi bi-arrow-repeat"></i> بروزرسانی داشبورد
                    </button>
                </div>
                <div class="col-12 col-lg-3 text-muted small">
                    <i class="bi bi-calendar3"></i> بازه: @RangeText
                </div>
            </div>
        </div>
    </div>

    @if (loading && data is null)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
    }
    else if (!loading && data is null)
    {
        <div class="card"><div class="empty-state"><i class="bi bi-exclamation-circle"></i><h5>داده‌های داشبورد بارگذاری نشد</h5><p class="text-muted">لطفاً فیلترهای تاریخ را دوباره بررسی کنید.</p></div></div>
    }
    else if (data is not null)
    {
        @if (Auth.CanSee("Orders"))
        {
            <div class="row g-3 mb-3">
                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon bg-soft-primary"><i class="bi bi-bag-plus text-primary"></i></div>
                        <div>
                            <div class="stat-label">خرید دوره</div>
                            <div class="stat-value num text-primary">@data.PurchaseTotal.Money()</div>
                            <div class="fs-8 text-muted num">@data.PurchaseCount.Num() سند</div>
                        </div>
                    </div>
                </div>
                <div class="col-6 col-xl-3">
                    <div class="stat-card">
                        <div class="stat-icon bg-soft-success"><i class="bi bi-cart-check text-success"></i></div>
                        <div>
                            <div class="stat-label">فروش دوره</div>
                            <div class="stat-value num text-success">@data.SaleTotal.Money()</div>
                            <div class="fs-8 text-muted num">@data.SaleCount.Num() سند</div>
                        </div>
                    </div>
                </div>
                @if (Auth.CanSee("Repairs"))
                {
                    <div class="col-6 col-xl-3">
                        <div class="stat-card">
                            <div class="stat-icon bg-soft-warning"><i class="bi bi-tools text-warning"></i></div>
                            <div>
                                <div class="stat-label">درآمد تعمیرات تحویل‌شده</div>
                                <div class="stat-value num text-warning">@data.RepairRevenue.Money()</div>
                                <div class="fs-8 text-muted num">@data.DeliveredRepairCount.Num() پذیرش تحویل‌شده</div>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 col-xl-3">
                        <div class="stat-card">
                            <div class="stat-icon @(data.RepairProfit >= 0 ? "bg-soft-success" : "bg-soft-danger")">
                                <i class="bi bi-graph-up-arrow @(data.RepairProfit >= 0 ? "text-success" : "text-danger")"></i>
                            </div>
                            <div>
                                <div class="stat-label">سود تعمیرات تحویل‌شده</div>
                                <div class="stat-value num @(data.RepairProfit >= 0 ? "text-success" : "text-danger")">@data.RepairProfit.Money()</div>
                                <div class="fs-8 text-muted num">@data.ActiveRepairCount.Num() تعمیر فعال از پذیرش‌های این بازه</div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else if (Auth.CanSee("Repairs"))
        {
            <div class="row g-3 mb-3">
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon bg-soft-info"><i class="bi bi-tools text-info"></i></div>
                        <div><div class="stat-label">کل پذیرش‌های دوره</div><div class="stat-value num">@data.RepairCount.Num()</div></div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon bg-soft-warning"><i class="bi bi-wrench-adjustable text-warning"></i></div>
                        <div><div class="stat-label">تعمیرهای فعال</div><div class="stat-value num">@data.ActiveRepairCount.Num()</div></div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon bg-soft-success"><i class="bi bi-check2-circle text-success"></i></div>
                        <div><div class="stat-label">تحویل‌شده</div><div class="stat-value num">@data.DeliveredRepairCount.Num()</div></div>
                    </div>
                </div>
                <div class="col-6 col-lg-3">
                    <div class="stat-card">
                        <div class="stat-icon bg-soft-primary"><i class="bi bi-cash-stack text-primary"></i></div>
                        <div><div class="stat-label">درآمد تعمیرات تحویل‌شده</div><div class="stat-value num">@data.RepairRevenue.Money()</div></div>
                    </div>
                </div>
            </div>
        }

        <div class="row g-3">
            <div class="col-lg-8">
                <div class="card h-100">
                    <div class="card-header">
                        <i class="bi bi-graph-up-arrow text-primary"></i>
                        <span class="card-title">روند عملکرد در بازهٔ انتخاب‌شده</span>
                        <span class="badge badge-soft-primary ms-auto">@TrendPeriod</span>
                    </div>
                    <div class="card-body">
                        <div class="d-flex flex-wrap gap-3 mb-3 small">
                            @if (Auth.CanSee("Orders"))
                            {
                                <span><i class="bi bi-circle-fill text-primary"></i> خرید</span>
                                <span><i class="bi bi-circle-fill text-success"></i> فروش</span>
                            }
                            @if (Auth.CanSee("Repairs"))
                            {
                                <span><i class="bi bi-circle-fill text-warning"></i> درآمد تعمیرات تحویل‌شده</span>
                            }
                        </div>
                        @if (data.Trend.Count == 0)
                        {
                            <div class="empty-state py-4"><i class="bi bi-bar-chart"></i><h5>در این بازه داده‌ای برای نمودار وجود ندارد</h5></div>
                        }
                        else
                        {
                            <div class="d-flex flex-column gap-3">
                                @foreach (var point in data.Trend)
                                {
                                    <div class="border-bottom pb-2">
                                        <div class="fw-600 mb-2">@point.Label</div>
                                        @if (Auth.CanSee("Orders"))
                                        {
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="small text-muted" style="width:42px">خرید</span>
                                                <div class="progress flex-grow-1" style="height:7px"><div class="progress-bar bg-primary" style="@BarStyle(point.Purchase)"></div></div>
                                                <span class="small num text-nowrap">@point.Purchase.Money()</span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="small text-muted" style="width:42px">فروش</span>
                                                <div class="progress flex-grow-1" style="height:7px"><div class="progress-bar bg-success" style="@BarStyle(point.Sale)"></div></div>
                                                <span class="small num text-nowrap">@point.Sale.Money()</span>
                                            </div>
                                        }
                                        @if (Auth.CanSee("Repairs"))
                                        {
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="small text-muted text-nowrap" style="width:42px">تعمیر</span>
                                                <div class="progress flex-grow-1" style="height:7px"><div class="progress-bar bg-warning" style="@BarStyle(point.RepairRevenue)"></div></div>
                                                <span class="small num text-nowrap">@point.RepairRevenue.Money()</span>
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            @if (Auth.CanSee("Orders") && Auth.CanSee("Referrers"))
            {
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header">
                            <i class="bi bi-trophy-fill text-warning"></i>
                            <span class="card-title">معرف برتر دوره</span>
                        </div>
                        <div class="card-body p-0">
                            @if (data.BestReferrer is null)
                            {
                                <div class="empty-state"><i class="bi bi-person-badge"></i><h5>فروشِ دارای معرف در این بازه ثبت نشده است</h5></div>
                            }
                            else
                            {
                                <div class="p-3 text-center border-bottom bg-light-subtle">
                                    <div class="rounded-circle bg-warning-subtle text-warning d-inline-flex align-items-center justify-content-center mb-2" style="width:54px;height:54px;font-size:1.35rem">
                                        <i class="bi bi-award-fill"></i>
                                    </div>
                                    <div class="fw-700 fs-5">@data.BestReferrer.ReferrerName</div>
                                    <div class="text-muted small">بر اساس مبلغ اسناد فروش در بازهٔ انتخاب‌شده</div>
                                    <div class="num fs-4 fw-800 text-success mt-2">@data.BestReferrer.SalesAmount.Money() <small class="fs-8">ریال</small></div>
                                    <div class="small text-muted num">@data.BestReferrer.SaleCount.Num() فاکتور فروش</div>
                                </div>
                                @if (data.TopReferrers.Count > 1)
                                {
                                    <div class="table-responsive">
                                        <table class="table table-sm table-hover align-middle mb-0">
                                            <thead><tr><th>#</th><th>معرف</th><th class="text-end">فروش (ریال)</th></tr></thead>
                                            <tbody>
                                                @{ var rank = 1; }
                                                @foreach (var referrer in data.TopReferrers.Skip(1))
                                                {
                                                    <tr>
                                                        <td class="num text-muted">@rank</td>
                                                        <td>@referrer.ReferrerName</td>
                                                        <td class="text-end num">@referrer.SalesAmount.Money()</td>
                                                    </tr>
                                                    rank++;
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>
            }
            else if (Auth.CanSee("Repairs"))
            {
                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header"><i class="bi bi-clipboard2-check text-info"></i><span class="card-title">وضعیت تعمیرات</span></div>
                        <div class="card-body">
                            <div class="d-flex justify-content-between border-bottom py-2"><span>کل پذیرش‌ها</span><b class="num">@data.RepairCount.Num()</b></div>
                            <div class="d-flex justify-content-between border-bottom py-2"><span>در حال انجام</span><b class="num text-warning">@data.ActiveRepairCount.Num()</b></div>
                            <div class="d-flex justify-content-between border-bottom py-2"><span>تحویل‌شده</span><b class="num text-success">@data.DeliveredRepairCount.Num()</b></div>
                            <div class="d-flex justify-content-between py-2"><span>انصرافی</span><b class="num text-muted">@data.CancelledRepairCount.Num()</b></div>
                            <div class="alert alert-info small mt-3 mb-0">پذیرش و تعمیر فعال بر اساس تاریخ ورود؛ تعداد تحویل و درآمد بر اساس تاریخ تحویل محاسبه شده است.</div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @if (Auth.CanSee("Orders") && Auth.CanSee("Repairs"))
        {
            <div class="alert alert-light border small mt-3 mb-0">
                <i class="bi bi-info-circle text-primary"></i>
                تعداد پذیرش‌های تعمیر بر اساس تاریخ ورود و درآمد تعمیر بر اساس تاریخ تحویل محاسبه شده است. درآمد تعمیرات جدا از فروش فاکتوری نمایش داده می‌شود؛ در صورت صدور فاکتور از پذیرش، مبلغ آن نیز در فروش ثبت شده است.
            </div>
        }
    }
}

@code {
    private bool CanOpenDashboard => Auth.CanSee("Orders") || Auth.CanSee("Repairs");
    private OperationsDashboardDto? data;
    private DateTime? from = DateTime.Today.AddDays(-30);
    private DateTime? to = DateTime.Today;
    private bool loading = true;

    private string RangeText => $"{(from.HasValue ? from.Value.ToFa() : "از ابتدا")} تا {(to.HasValue ? to.Value.ToFa() : "امروز")}";
    private string TrendPeriod => data?.Trend.Any(p => p.Label.Contains('/')) == true ? "روزانه" : "ماهانه";
    private decimal ChartMax => data is null || data.Trend.Count == 0
        ? 0m
        : data.Trend.SelectMany(p => new[] { p.Purchase, p.Sale, p.RepairRevenue }).DefaultIfEmpty(0m).Max();

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("داشبورد جامع عملیات");
        if (CanOpenDashboard) await Load();
    }

    private async Task Load()
    {
        loading = true;
        try { data = await DashboardSvc.GetOperationsDashboardAsync(from, to); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private string BarStyle(decimal value)
    {
        var pct = ChartMax <= 0m ? 0d : Math.Clamp((double)(value / ChartMax) * 100d, 0d, 100d);
        return $"width:{pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%";
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");
}
