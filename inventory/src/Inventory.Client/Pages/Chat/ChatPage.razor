    private async Task OnSearchChanged()
    {
        // Debounce و شمارهٔ درخواست مانع جایگزینی نتیجهٔ تازه با پاسخ دیرهنگام می‌شوند.
        var version = ++sidebarSearchVersion;
        ++conversationLoadVersion;
        sidebarUsers = new();
        sidebarUsersError = null;
        loadingSidebarUsers = !string.IsNullOrWhiteSpace(searchQuery);
        loadingConversations = true;
        conversations = new();
        await Task.Delay(250);
        if (disposed || version != sidebarSearchVersion) return;

        await Task.WhenAll(LoadConversations(), LoadSidebarUsersAsync(searchQuery, version));
    }

    private async Task LoadSidebarUsersAsync(string query, int version)
    {
        if (string.IsNullOrWhiteSpace(query)) return;
        try
        {
            var result = await Chat.GetSoftwareUsersAsync(query);
            if (!disposed && version == sidebarSearchVersion) sidebarUsers = result;
        }
        catch (Exception ex)
        {
            if (!disposed && version == sidebarSearchVersion)
                sidebarUsersError = $"دریافت کاربران ناموفق بود: {ex.Message}";
        }
        finally
        {
            if (!disposed && version == sidebarSearchVersion)
            {
                loadingSidebarUsers = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task RetrySidebarUsers()
    {
        var version = ++sidebarSearchVersion;
        sidebarUsersError = null;
        loadingSidebarUsers = true;
        await LoadSidebarUsersAsync(searchQuery, version);
    }

    private async Task ClearSearch()
    {
        ++sidebarSearchVersion;
        searchQuery = "";
        sidebarUsers = new();
        sidebarUsersError = null;
        loadingSidebarUsers = false;
        await LoadConversations();
    }

    private async Task BackToSidebar()
    {
        if (isSending || isUploading) return;
        if (activeConv != null)
        {
            await Chat.SendTypingHubAsync(activeConv.Id, false);
            await Chat.LeaveConversationHubAsync(activeConv.Id);
        }
        ++messageLoadVersion;
        activeConv = null;
    }

