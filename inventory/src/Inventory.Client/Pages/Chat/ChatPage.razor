@page "/chat"
@page "/chat/{ConversationId:int}"
@inject IChatClientService Chat
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<div class="telegram-container">
    @* ========================== ستون سمت راست: لیست گفتگوها (Sidebar) ========================== *@
    <div class="telegram-sidebar @(activeConv != null && isMobileView ? "d-none d-md-flex" : "")">
        <div class="sidebar-header">
            <div class="d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-2">
                    <div class="chat-avatar-self">
                        <i class="bi bi-person-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold fs-7">پیام‌رسان سازمانی</div>
                        <div class="fs-9 text-muted">@Auth.DisplayName</div>
                    </div>
                </div>
                <div class="d-flex gap-1">
                    <button class="btn btn-sm btn-icon" title="گفتگوی دونفره جدید" @onclick="OpenNewDirectModal">
                        <i class="bi bi-pencil-square fs-6 text-primary"></i>
                    </button>
                    <button class="btn btn-sm btn-icon" title="ایجاد گروه کاری" @onclick="OpenNewGroupModal">
                        <i class="bi bi-people-fill fs-6 text-success"></i>
                    </button>
                </div>
            </div>

            <div class="chat-connection-status fs-9 mt-2 @(Chat.IsConnected ? "text-success" : "text-warning")"
                 role="status" data-testid="chat-connection" data-connected="@Chat.IsConnected.ToString().ToLowerInvariant()">
                <i class="bi @(Chat.IsConnected ? "bi-wifi" : "bi-arrow-repeat") me-1"></i>
                @(Chat.IsConnected ? "اتصال زنده برقرار است" : "در حال اتصال مجدد؛ همگام‌سازی خودکار ادامه دارد")
            </div>

            @* جستجوی گفتگوها *@
            <div class="chat-search-wrap mt-2">
                <i class="bi bi-search search-icon"></i>
                <input type="text" class="form-control form-control-sm chat-search-input"
                       placeholder="جستجوی کاربران و گفتگوها..." aria-label="جستجوی کاربران و گفتگوها"
                       @bind="searchQuery" @bind:event="oninput" @bind:after="OnSearchChanged" />
                @if (!string.IsNullOrWhiteSpace(searchQuery))
                {
                    <button class="btn-clear-search" @onclick="ClearSearch"><i class="bi bi-x"></i></button>
                }
            </div>

            @* تب‌های فیلتر *@
            <div class="chat-filter-tabs mt-2">
                <button class="tab-btn @(currentTab == "all" ? "active" : "")" @onclick='() => ChangeTab("all")'>همه</button>
                <button class="tab-btn @(currentTab == "direct" ? "active" : "")" @onclick='() => ChangeTab("direct")'>خصوصی</button>
                <button class="tab-btn @(currentTab == "group" ? "active" : "")" @onclick='() => ChangeTab("group")'>گروه‌ها</button>
                <button class="tab-btn @(currentTab == "unread" ? "active" : "")" @onclick='() => ChangeTab("unread")'>
                    نخوانده
                    @if (totalUnread > 0)
                    {
                        <span class="tab-unread-pill">@totalUnread</span>
                    }
                </button>
            </div>
        </div>

        @* فهرست گفتگوها *@
        <div class="dialogs-list">
            @if (!string.IsNullOrWhiteSpace(searchQuery))
            {
                <section class="border-bottom p-2" aria-label="کاربران سازمان" data-testid="chat-contact-results" aria-live="polite">
                    <div class="fw-bold fs-8 text-primary px-2 mb-2">کاربران سازمان — شروع گفتگو</div>
                    @if (loadingSidebarUsers)
                    {
                        <div class="text-center py-3 text-muted fs-8">
                            <span class="spinner-border spinner-border-sm me-1"></span>در حال جستجوی کاربران...
                        </div>
                    }
                    else if (sidebarUsersError != null)
                    {
                        <div class="alert alert-danger fs-9 mb-1" role="alert">
                            @sidebarUsersError
                            <button type="button" class="btn btn-sm btn-outline-danger d-block mt-2" @onclick="RetrySidebarUsers">تلاش مجدد</button>
                        </div>
                    }
                    else if (sidebarUsers.Count == 0)
                    {
                        <div class="text-muted fs-8 p-2">کاربری با این مشخصات یافت نشد.</div>
                    }
                    else
                    {
                        @foreach (var u in sidebarUsers)
                        {
                            <button type="button" @key="u.Id" class="user-picker-item w-100 border-0 bg-transparent"
                                    style="text-align: start;" @onclick="() => StartDirectWith(u.Id)" disabled="@startingDirectUserId.HasValue">
                                <div class="dialog-avatar direct-avatar sm"><i class="bi bi-person"></i></div>
                                <div class="flex-grow-1 min-w-0 ms-2">
                                    <div class="fw-bold fs-8">@u.DisplayName</div>
                                    <div class="fs-9 text-muted">@u.Username @(!string.IsNullOrWhiteSpace(u.Department) ? $"— {u.Department}" : "")</div>
                                </div>
                                <i class="bi bi-chat-dots text-primary" aria-hidden="true"></i>
                            </button>
                        }
                    }
                </section>
                <div class="fw-bold fs-8 text-muted px-3 pt-3">گفتگوها</div>
            }
            @if (loadingConversations)
            {
                <div class="text-center py-5 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                    <div class="fs-8">در حال بارگذاری گفتگوها...</div>
                </div>
            }
            else if (conversations.Count == 0)
            {
                <div class="text-center py-5 text-muted px-3">
                    <i class="bi bi-chat-square-dots fs-1 d-block mb-2 text-secondary opacity-50"></i>
                    <div class="fw-bold fs-8">گفتگویی یافت نشد</div>
                    <div class="fs-9 mt-1">با همکاران خود در سازمان گفتگوی جدیدی آغاز کنید.</div>
                    <button class="btn btn-sm btn-primary mt-3" @onclick="OpenNewDirectModal">
                        <i class="bi bi-plus-lg me-1"></i>شروع گفتگوی جدید
                    </button>
                </div>
            }
            else
            {
                @foreach (var c in conversations)
                {
                    <div @key="c.Id" class="dialog-item @(activeConv?.Id == c.Id ? "active" : "") @(c.IsPinned ? "pinned" : "")"
                         data-conversation-id="@c.Id" @onclick="() => SelectConversation(c)">
                        <div class="dialog-avatar-wrap">
                            @if (c.Type == ChatTypeDto.Direct)
                            {
                                <div class="dialog-avatar direct-avatar">
                                    <i class="bi bi-person"></i>
                                </div>
                                @if (c.DirectPeerIsOnline)
                                {
                                    <span class="online-indicator" title="آنلاین"></span>
                                }
                            }
                            else
                            {
                                <div class="dialog-avatar group-avatar">
                                    <i class="bi bi-people-fill"></i>
                                </div>
                            }
                        </div>

                        <div class="dialog-info">
                            <div class="dialog-top">
                                <div class="dialog-heading">
                                    <div class="dialog-title text-truncate">
                                        @if (c.IsPinned)
                                        {
                                            <i class="bi bi-pin-angle-fill text-warning me-1 fs-9"></i>
                                        }
                                        @c.Title
                                    </div>
                                    @if (c.UnreadCount > 0)
                                    {
                                        <span class="unread-badge" data-testid="unread-count" aria-label="@($"{c.UnreadCount} پیام خوانده‌نشده")">@c.UnreadCount</span>
                                    }
                                </div>
                                <div class="dialog-time">@FormatTime(c.LastMessageAt)</div>
                            </div>
                            <div class="dialog-bottom">
                                <div class="dialog-snippet text-truncate">
                                    @if (typingUsers.TryGetValue(c.Id, out var typer))
                                    {
                                        <span class="text-success fst-italic">@typer در حال نوشتن...</span>
                                    }
                                    else
                                    {
                                        @if (c.Type == ChatTypeDto.Group && !string.IsNullOrWhiteSpace(c.LastMessageSenderName))
                                        {
                                            <span class="fw-bold text-dark me-1">@c.LastMessageSenderName:</span>
                                        }
                                        @c.LastMessageSnippet
                                    }
                                </div>

                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>

    @* ========================== ستون سمت چپ: پنجره فعال گفتگو (Chat Window) ========================== *@
    <div class="telegram-main @(activeConv == null && isMobileView ? "d-none d-md-flex" : "")">
        @if (activeConv == null)
        {
            <div class="chat-placeholder">
                <div class="placeholder-card">
                    <div class="placeholder-icon">
                        <i class="bi bi-chat-left-quote-fill"></i>
                    </div>
                    <div class="fw-bold fs-5 mb-1">پیام‌رسان سازمانی</div>
                    <div class="text-muted fs-8 mb-4">یک گفتگو را از فهرست انتخاب کنید یا پیام جدیدی ارسال نمایید.</div>
                    <div class="d-flex justify-content-center gap-2">
                        <button class="btn btn-outline-primary btn-sm" @onclick="OpenNewDirectModal">
                            <i class="bi bi-chat-dots me-1"></i>گفتگوی جدید
                        </button>
                        <button class="btn btn-outline-success btn-sm" @onclick="OpenNewGroupModal">
                            <i class="bi bi-people me-1"></i>گروه جدید
                        </button>
                    </div>
                </div>
            </div>
        }
        else
        {
            @* هدر چت فعال *@
            <div class="chat-header">
                <div class="d-flex align-items-center gap-2">
                    @if (isMobileView)
                    {
                        <button class="btn btn-sm btn-icon me-1" @onclick="BackToSidebar">
                            <i class="bi bi-arrow-right fs-6"></i>
                        </button>
                    }
                    <div class="dialog-avatar-wrap">
                        @if (activeConv.Type == ChatTypeDto.Direct)
                        {
                            <div class="dialog-avatar direct-avatar sm">
                                <i class="bi bi-person"></i>
                            </div>
                            @if (activeConv.DirectPeerIsOnline)
                            {
                                <span class="online-indicator sm"></span>
                            }
                        }
                        else
                        {
                            <div class="dialog-avatar group-avatar sm" @onclick="OpenGroupInfoModal" style="cursor:pointer">
                                <i class="bi bi-people-fill"></i>
                            </div>
                        }
                    </div>
                    <div>
                        <div class="fw-bold fs-7 d-flex align-items-center gap-1">
                            @activeConv.Title
                            @if (activeConv.Type == ChatTypeDto.Group)
                            {
                                <span class="badge bg-secondary-subtle text-secondary fs-9">گروه</span>
                            }
                        </div>
                        <div class="fs-9 text-muted">
                            @if (typingUsers.TryGetValue(activeConv.Id, out var typer))
                            {
                                <span class="text-success fw-bold">@typer در حال نوشتن...</span>
                            }
                            else if (activeConv.Type == ChatTypeDto.Direct)
                            {
                                if (activeConv.DirectPeerIsOnline)
                                {
                                    <span class="text-success fw-600">آنلاین</span>
                                }
                                else if (activeConv.DirectPeerLastSeen.HasValue)
                                {
                                    <span>آخرین بازدید @activeConv.DirectPeerLastSeen.Value.ToFaDateTime()</span>
                                }
                                else
                                {
                                    <span>آفلاین</span>
                                }
                            }
                            else
                            {
                                <span>@activeConv.MembersCount عضو</span>
                            }
                        </div>
                    </div>
                </div>

                <div class="d-flex align-items-center gap-1">
                    @if (activeConv.Type == ChatTypeDto.Group)
                    {
                        <button class="btn btn-sm btn-icon" title="اعضای گروه" @onclick="OpenGroupInfoModal">
                            <i class="bi bi-info-circle fs-6"></i>
                        </button>
                    }
                    <button class="btn btn-sm btn-icon" title="@(activeConv.IsPinned ? "برداشتن پین" : "پین گفتگو")" @onclick="TogglePinConversation">
                        <i class="bi @(activeConv.IsPinned ? "bi-pin-angle-fill text-warning" : "bi-pin-angle") fs-6"></i>
                    </button>
                    <button class="btn btn-sm btn-icon" title="@(activeConv.IsMuted ? "فعال‌سازی صدا" : "بی‌صدا کردن")" @onclick="ToggleMuteConversation">
                        <i class="bi @(activeConv.IsMuted ? "bi-bell-slash text-danger" : "bi-bell") fs-6"></i>
                    </button>
                </div>
            </div>

            @* نوار پیام پین‌شده *@
            @if (activeConv.PinnedMessageId.HasValue)
            {
                <div class="pinned-bar">
                    <i class="bi bi-pin-fill text-primary me-2"></i>
                    <div class="flex-grow-1 text-truncate fs-8">
                        <span class="fw-bold">پیام سنجاق‌شده:</span> @(activeConv.PinnedMessageSnippet ?? "مشاهده پیام")
                    </div>
                </div>
            }

            @* جریان پیام‌ها (Message Stream) *@
            <div class="chat-messages-scroll" id="chatMessagesScroll">
                @if (loadingMessages)
                {
                    <div class="text-center py-4 text-muted">
                        <div class="spinner-border spinner-border-sm text-primary mb-1"></div>
                        <div class="fs-8">در حال بارگذاری پیام‌ها...</div>
                    </div>
                }
                else if (messages.Count == 0)
                {
                    <div class="text-center py-5 text-muted">
                        <i class="bi bi-chat-dots fs-2 text-secondary opacity-50 d-block mb-2"></i>
                        <div class="fs-8">هنوز پیامی ارسال نشده است. اولین پیام را شما بنویسید!</div>
                    </div>
                }
                else
                {
                    @foreach (var msg in messages)
                    {
                        @if (msg.MessageType == ChatMessageTypeDto.System)
                        {
                            <div class="system-message-row">
                                <span class="system-bubble">@msg.Text</span>
                            </div>
                        }
                        else
                        {
                            <div @key="msg.Id" class="message-row @(msg.IsOutgoing ? "outgoing" : "incoming")" id="msg-@msg.Id">
                                <div class="message-bubble @(msg.IsOutgoing ? "bubble-out" : "bubble-in")">
                                    @* نام فرستنده در گروه‌ها برای پیام‌های دریافتی *@
                                    @if (!msg.IsOutgoing && activeConv.Type == ChatTypeDto.Group)
                                    {
                                        <div class="bubble-sender">@msg.SenderName</div>
                                    }

                                    @* بخش ریپلای *@
                                    @if (msg.ReplyToMessageId.HasValue)
                                    {
                                        <div class="bubble-reply-preview" @onclick="() => ScrollToMessage(msg.ReplyToMessageId.Value)">
                                            <div class="reply-bar"></div>
                                            <div class="reply-body">
                                                <div class="reply-sender">@msg.ReplyToSenderName</div>
                                                <div class="reply-text text-truncate">@msg.ReplyToSnippet</div>
                                            </div>
                                        </div>
                                    }

                                    @* پیش‌نمایش و دانلود همیشه از endpoint دارای کنترل عضویت در API *@
                                    @if (!string.IsNullOrWhiteSpace(msg.FileUrl))
                                    {
                                        @if (msg.MessageType == ChatMessageTypeDto.Image)
                                        {
                                            @* کلیک روی تصویر: پیش‌نمایش بزرگ در همان صفحه (لایت‌باکس) — بدون باز کردن تب جدید *@
                                            <img src="@Chat.GetFileUrl(msg.Id, true)" class="bubble-img chat-img-zoom" alt="@msg.FileName"
                                                 title="@($"نمایش بزرگ‌تر — {msg.FileName}")" loading="lazy" referrerpolicy="no-referrer"
                                                 @onclick="() => OpenImagePreview(msg)" />
                                        }
                                        else if (msg.MessageType == ChatMessageTypeDto.Audio)
                                        {
                                            <audio controls preload="none" class="w-100 mt-1" src="@Chat.GetFileUrl(msg.Id, true)"></audio>
                                        }
                                        else if (msg.MessageType == ChatMessageTypeDto.Video)
                                        {
                                            <video controls preload="metadata" class="bubble-video" src="@Chat.GetFileUrl(msg.Id, true)"></video>
                                        }
                                        <div class="bubble-file-card">
                                            <div class="file-icon"><i class="bi bi-file-earmark-arrow-down-fill fs-3 text-primary"></i></div>
                                            <div class="file-info text-truncate">
                                                <div class="file-name text-truncate">@msg.FileName</div>
                                                <div class="file-size fs-9 text-muted">@FormatFileSize(msg.FileSizeBytes)</div>
                                            </div>
                                            @* دانلود در همان صفحه/تب؛ بدون target=_blank تا تب جدید باز نشود و PWA آن را نرباید *@
                                            <a href="@Chat.GetFileUrl(msg.Id)" download="@msg.FileName" class="btn btn-sm btn-light file-dl-btn"
                                               referrerpolicy="no-referrer" aria-label="@($"دانلود {msg.FileName}")">
                                                <i class="bi bi-download"></i>
                                            </a>
                                        </div>
                                    }

                                    @* کارت اشتراک سند/موجودیت سازمانی ERP *@
                                    @if (!string.IsNullOrWhiteSpace(msg.ErpModule))
                                    {
                                        <div class="bubble-erp-card">
                                            <div class="d-flex align-items-center gap-2 mb-1">
                                                <span class="badge bg-primary text-white fs-9">@msg.ErpModule</span>
                                                <span class="fw-bold fs-8">@msg.ErpEntityTitle</span>
                                            </div>
                                            @if (!string.IsNullOrWhiteSpace(msg.ErpEntitySummary))
                                            {
                                                <div class="fs-9 text-muted mb-2">@msg.ErpEntitySummary</div>
                                            }
                                            <button class="btn btn-xs btn-outline-primary" @onclick="() => NavigateToErp(msg.ErpModule, msg.ErpEntityId)">
                                                <i class="bi bi-box-arrow-up-right me-1"></i>مشاهده در سیستم
                                            </button>
                                        </div>
                                    }

                                    @* متن پیام *@
                                    @if (!string.IsNullOrWhiteSpace(msg.Text))
                                    {
                                        <div class="bubble-text">@msg.Text</div>
                                    }

                                    @* نوار اطلاعات زیرین پیام (ساعت، تیک، ویرایش) *@
                                    <div class="bubble-footer">
                                        @if (msg.IsEdited)
                                        {
                                            <span class="edited-label">ویرایش‌شده</span>
                                        }
                                        <span class="bubble-time">@msg.CreatedAt.ToString("HH:mm")</span>
                                        @if (msg.IsOutgoing)
                                        {
                                            <span class="bubble-checks">
                                                @if (msg.IsReadByPeer)
                                                {
                                                    <i class="bi bi-check2-all text-primary fw-bold" title="خوانده شد"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-check2 text-muted" title="ارسال شد"></i>
                                                }
                                            </span>
                                        }
                                    </div>

                                    @* واکنش‌های ثبت‌شده *@
                                    @if (msg.Reactions.Count > 0)
                                    {
                                        <div class="bubble-reactions">
                                            @foreach (var r in msg.Reactions)
                                            {
                                                bool hasMine = r.Value.Any(u => u.UserId == Auth.UserId);
                                                <button class="reaction-pill @(hasMine ? "active" : "")"
                                                        title="@string.Join("، ", r.Value.Select(u => u.UserName))"
                                                        @onclick="() => ToggleReaction(msg.Id, r.Key)">
                                                    <span>@r.Key</span>
                                                    <span class="count">@r.Value.Count</span>
                                                </button>
                                            }
                                        </div>
                                    }

                                    @* منوی سریع روی حباب پیام (Hover Actions) *@
                                    <div class="bubble-actions-overlay">
                                        <button class="action-btn" title="پاسخ (Reply)" @onclick="() => StartReply(msg)">
                                            <i class="bi bi-reply-fill"></i>
                                        </button>
                                        <button class="action-btn" title="واکنش 👍" @onclick='() => ToggleReaction(msg.Id, "👍")'>
                                            👍
                                        </button>
                                        <button class="action-btn" title="واکنش ❤️" @onclick='() => ToggleReaction(msg.Id, "❤️")'>
                                            ❤️
                                        </button>
                                        <button class="action-btn" title="سنجاق پیام" @onclick="() => TogglePinMsg(msg.Id)">
                                            <i class="bi bi-pin-angle"></i>
                                        </button>
                                        @if (msg.IsOutgoing && !msg.IsDeleted)
                                        {
                                            <button class="action-btn" title="ویرایش" @onclick="() => StartEdit(msg)">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="action-btn text-danger" title="حذف" @onclick="() => DeleteMsg(msg.Id)">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    }
                }
            </div>

            @* بخش ورودی پیام (Input Toolbar) *@
            <div class="chat-input-area">
                @if (isUploading)
                {
                    <div class="input-banner fs-8" role="status" data-testid="upload-progress">
                        <span class="spinner-border spinner-border-sm me-2"></span>در حال بارگذاری @uploadingFileName ...
                    </div>
                }
                else if (uploadingFile != null)
                {
                    <div class="input-banner fs-8" data-testid="attachment-ready">
                        <i class="bi bi-paperclip me-2"></i>
                        <span class="flex-grow-1 text-truncate">@uploadingFile.FileName — @FormatFileSize(uploadingFile.FileSizeBytes) (آمادهٔ ارسال)</span>
                        <button type="button" class="btn-close" title="حذف پیوست انتخابی" aria-label="حذف پیوست انتخابی" disabled="@isSending" @onclick="RemovePendingAttachment"></button>
                    </div>
                }
                @* بنر ریپلای یا ادیت *@
                @if (replyingTo != null)
                {
                    <div class="input-banner reply-banner">
                        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                            <i class="bi bi-reply-fill text-primary"></i>
                            <div class="text-truncate fs-8">
                                <span class="fw-bold">پاسخ به @replyingTo.SenderName:</span> @(replyingTo.Text ?? replyingTo.FileName)
                            </div>
                        </div>
                        <button class="btn-close btn-close-sm" @onclick="CancelReply"></button>
                    </div>
                }
                else if (editingMsg != null)
                {
                    <div class="input-banner edit-banner">
                        <div class="d-flex align-items-center gap-2 flex-grow-1 min-w-0">
                            <i class="bi bi-pencil-fill text-warning"></i>
                            <div class="text-truncate fs-8">
                                <span class="fw-bold">ویرایش پیام:</span> @editingMsg.Text
                            </div>
                        </div>
                        <button class="btn-close btn-close-sm" @onclick="CancelEdit"></button>
                    </div>
                }

                <div class="input-row">
                    @* دکمه پیوست فایل *@
                    <label class="btn btn-icon btn-attach" title="پیوست فایل یا تصویر">
                        <i class="bi bi-paperclip fs-5"></i>
                        <InputFile @key="fileInputVersion" OnChange="OnFileSelected" class="d-none" disabled="@(isSending || isUploading || editingMsg != null)" />
                    </label>

                    @* منوی سریع ایموجی *@
                    <div class="emoji-quick-bar d-none d-sm-flex">
                        <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("👍")'>👍</button>
                        <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("❤️")'>❤️</button>
                        <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("😂")'>😂</button>
                        <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("🔥")'>🔥</button>
                        <button type="button" class="btn-emoji" @onclick='() => AppendEmoji("👏")'>👏</button>
                    </div>

                    @* کادر متنی پیام *@
                    <textarea class="form-control chat-textarea"
                              placeholder="پیام خود را بنویسید..."
                              rows="1"
                              @ref="composerElement" disabled="@isSending"
                              @bind="messageInput" @bind:event="oninput" @bind:after="OnMessageInputChanged"></textarea>

                    @* دکمه ارسال *@
                    <button class="btn btn-primary btn-send" @onclick="SendCurrentMessage" disabled="@(isSending || isUploading || (string.IsNullOrWhiteSpace(messageInput) && uploadingFile == null))">
                        @if (isSending)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <i class="bi bi-send-fill"></i>
                        }
                    </button>
                </div>
            </div>
        }
    </div>
</div>

