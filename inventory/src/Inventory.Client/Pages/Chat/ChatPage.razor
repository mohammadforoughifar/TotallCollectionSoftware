    // تمام رویدادهای SignalR داخل dispatcher بلزور اعمال می‌شوند.
    private void QueueUi(Func<Task> action)
    {
        if (disposed) return;
        _ = InvokeAsync(async () =>
        {
            if (disposed) return;
            try { await action(); }
            catch (OperationCanceledException) { }
            catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); }
            if (!disposed) StateHasChanged();
        });
    }

    private void HandleMessageReceived(ChatMessageDto message) => QueueUi(async () =>
    {
        typingStates.Remove((message.ConversationId, message.SenderUserId));
        RefreshTypingLabel(message.ConversationId);
        if (activeConv?.Id == message.ConversationId)
        {
            UpsertMessage(message);
            scrollAfterRender = true;
            markReadAfterRender |= !message.IsOutgoing;
        }
        // شمارنده را از سرور بخوان، نه با ++ روی هر رویداد (که ممکن است تکراری باشد).
        await LoadConversations();
    });

    private void HandleMessageUpdated(ChatMessageDto message) => QueueUi(async () =>
    {
        if (activeConv?.Id == message.ConversationId) UpsertMessage(message);
        await LoadConversations();
    });

    private void HandleMessageDeleted(int conversationId, int messageId) => QueueUi(async () =>
    {
        if (activeConv?.Id == conversationId) messages.RemoveAll(m => m.Id == messageId);
        await LoadConversations();
    });

    private void HandleReactionUpdated(int conversationId, int messageId, Dictionary<string, List<ChatReactionUserDto>> reactions) => QueueUi(() =>
    {
        if (activeConv?.Id == conversationId)
        {
            var message = messages.FirstOrDefault(m => m.Id == messageId);
            if (message != null) message.Reactions = reactions;
        }
        return Task.CompletedTask;
    });

    private void HandleMessagesRead(int conversationId, int reader, int lastId) => QueueUi(async () =>
    {
        if (reader == Auth.UserId)
            acknowledgedReads[conversationId] = Math.Max(acknowledgedReads.GetValueOrDefault(conversationId), lastId);
        else if (activeConv?.Id == conversationId)
            foreach (var message in messages.Where(m => m.IsOutgoing && m.Id <= lastId)) message.IsReadByPeer = true;
        await LoadConversations();
    });

    private void HandleUserTyping(int conversationId, int userId, string name) => QueueUi(() =>
    {
        if (userId == Auth.UserId) return Task.CompletedTask;
        if (string.IsNullOrWhiteSpace(name)) typingStates.Remove((conversationId, userId));
        else
        {
            typingStates[(conversationId, userId)] = (name, DateTime.UtcNow.AddSeconds(4));
            _ = ExpireTypingAsync(conversationId, userId);
        }
        RefreshTypingLabel(conversationId);
        return Task.CompletedTask;
    });

    private async Task ExpireTypingAsync(int conversationId, int userId)
    {
        try
        {
            await Task.Delay(4100, pageLifetime.Token);
            QueueUi(() =>
            {
                if (typingStates.TryGetValue((conversationId, userId), out var state) && state.Expires <= DateTime.UtcNow)
                    typingStates.Remove((conversationId, userId));
                RefreshTypingLabel(conversationId);
                return Task.CompletedTask;
            });
        }
        catch (OperationCanceledException) { }
    }

    private void RefreshTypingLabel(int conversationId)
    {
        var names = typingStates.Where(p => p.Key.ConversationId == conversationId).Select(p => p.Value.Name).Distinct().ToList();
        if (names.Count == 0) typingUsers.Remove(conversationId);
        else typingUsers[conversationId] = string.Join("، ", names);
    }

    private void HandleUserStatusChanged(int userId, bool online, DateTime seen) => QueueUi(() =>
    {
        foreach (var c in conversations.Where(c => c.DirectPeerUserId == userId))
        {
            c.DirectPeerIsOnline = online;
            c.DirectPeerLastSeen = seen;
        }
        if (activeConv?.DirectPeerUserId == userId)
        {
            activeConv.DirectPeerIsOnline = online;
            activeConv.DirectPeerLastSeen = seen;
        }
        return Task.CompletedTask;
    });

    private void HandleConnectionChanged() => QueueUi(() => Task.CompletedTask);
    private void HandleConversationChanged(int id) => QueueUi(SynchronizeAsync);
    private void HandleSyncRequested() => QueueUi(SynchronizeAsync);

    private async Task SynchronizeAsync()
    {
        if (synchronizing || disposed) return;
        synchronizing = true;
        try
        {
            await LoadConversations();
            if (activeConv == null || loadingMessages) return;
            var id = activeConv.Id;
            var version = messageLoadVersion;
            var previousLast = messages.Count == 0 ? 0 : messages.Max(m => m.Id);
            var result = await Chat.GetMessagesAsync(id, null, 80);
            if (disposed || activeConv?.Id != id || messageLoadVersion != version) return;
            var arrived = messages.Where(m => m.Id > previousLast && !result.Any(r => r.Id == m.Id)).ToList();
            messages = result.Select(m => m.ForUser(Auth.UserId)).Concat(arrived).OrderBy(m => m.Id).ToList();
            scrollAfterRender = messages.Any(m => m.Id > previousLast);
            markReadAfterRender = true;
        }
        finally { synchronizing = false; }
    }

    private Task ScrollToMessage(int messageId) => chatJs == null ? Task.CompletedTask : chatJs.InvokeVoidAsync("scrollToMessage", messageId).AsTask();

    private string FormatTime(DateTime dt)
    {
        var local = dt.ToLocalTime();
        if (local.Date == DateTime.Now.Date) return local.ToString("HH:mm");
        if (local.Date == DateTime.Now.AddDays(-1).Date) return "دیروز";
        return dt.ToFa();
    }

    private string FormatFileSize(long? bytes)
    {
        if (!bytes.HasValue) return "";
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    public async ValueTask DisposeAsync()
    {
        disposed = true;
        pageLifetime.Cancel();
        ++messageLoadVersion;
        ++sidebarSearchVersion;
        ++pickerSearchVersion;
        ++conversationLoadVersion;

        Chat.OnMessageReceived -= HandleMessageReceived;
        Chat.OnMessageUpdated -= HandleMessageUpdated;
        Chat.OnMessageDeleted -= HandleMessageDeleted;
        Chat.OnReactionUpdated -= HandleReactionUpdated;
        Chat.OnMessagesRead -= HandleMessagesRead;
        Chat.OnUserTyping -= HandleUserTyping;
        Chat.OnUserStatusChanged -= HandleUserStatusChanged;
        Chat.OnConversationChanged -= HandleConversationChanged;
        Chat.OnSyncRequested -= HandleSyncRequested;
        Chat.OnConnectionChanged -= HandleConnectionChanged;

        if (activeConv != null)
        {
            await Chat.SendTypingHubAsync(activeConv.Id, false);
            await Chat.LeaveConversationHubAsync(activeConv.Id);
        }
        if (chatJs != null)
        {
            try { await chatJs.InvokeVoidAsync("dispose", interopId); await chatJs.DisposeAsync(); } catch (JSException) { }
        }
        chatSelf?.Dispose();
        pageLifetime.Dispose();
    }
