@code {
    [Parameter] public int? ConversationId { get; set; }

    private List<ChatConversationDto> conversations = new();
    private ChatConversationDto? activeConv;
    private List<ChatMessageDto> messages = new();
    private List<ChatMemberDto> groupMembers = new();
    private List<ChatUserDto> filteredUsers = new();
    private List<ChatUserDto> sidebarUsers = new();
    private string? usersError;
    private string? sidebarUsersError;
    private bool loadingSidebarUsers;
    private int sidebarSearchVersion;
    private int pickerSearchVersion;
    private int conversationLoadVersion;
    private bool disposed;
    private int? startingDirectUserId;

    private bool loadingConversations = true;
    private bool loadingMessages = false;
    private bool loadingUsers = false;
    private bool isSending = false;
    private bool isUploading;
    private string uploadingFileName = "";
    private int fileInputVersion;
    private bool documentVisible = true;
    private bool markReadAfterRender;
    private bool scrollAfterRender;
    private bool synchronizing;
    private int messageLoadVersion;
    private DateTime lastTypingSent;
    private readonly Dictionary<int, int> acknowledgedReads = new();
    private readonly HashSet<int> readsInFlight = new();
    private readonly Dictionary<(int ConversationId, int UserId), (string Name, DateTime Expires)> typingStates = new();
    private readonly System.Threading.CancellationTokenSource pageLifetime = new();
    private ElementReference composerElement;
    private bool initializingChatJs;
    private IJSObjectReference? chatJs;
    private DotNetObjectReference<ChatPage>? chatSelf;
    private int interopId;
    private bool isMobileView = false;

    private string searchQuery = "";
    private string currentTab = "all";
    private int totalUnread = 0;
    private string messageInput = "";

    // ریپلای و ادیت
    private ChatMessageDto? replyingTo;
    private ChatMessageDto? editingMsg;
    private ChatMessageDto? previewMsg;
    private ChatUploadResultDto? uploadingFile;

    // تایپینگ لایو
    private Dictionary<int, string> typingUsers = new();

    // مدال‌ها
    private bool showDirectModal = false;
    private bool showGroupModal = false;
    private bool showGroupInfoModal = false;
    private string userSearchQuery = "";
    private string newGroupTitle = "";
    private string newGroupDesc = "";
    private HashSet<int> selectedGroupUserIds = new();

    protected override async Task OnInitializedAsync()
    {
        // کنترل دسترسی: فقط کاربرانی که مجوز پیام‌رسان دارند وارد می‌شوند
        if (!Auth.HasModule("Chat"))
        {
            Nav.NavigateTo("");
            return;
        }

        Chat.OnMessageReceived += HandleMessageReceived;
        Chat.OnMessageUpdated += HandleMessageUpdated;
        Chat.OnMessageDeleted += HandleMessageDeleted;
        Chat.OnReactionUpdated += HandleReactionUpdated;
        Chat.OnMessagesRead += HandleMessagesRead;
        Chat.OnUserTyping += HandleUserTyping;
        Chat.OnUserStatusChanged += HandleUserStatusChanged;
        Chat.OnConversationChanged += HandleConversationChanged;
        Chat.OnSyncRequested += HandleSyncRequested;
        Chat.OnConnectionChanged += HandleConnectionChanged;

        _ = EnsureRealtimeSafelyAsync();
        await LoadConversations();

        if (ConversationId.HasValue && ConversationId.Value > 0)
        {
            var target = conversations.FirstOrDefault(c => c.Id == ConversationId.Value);
            if (target != null)
            {
                await SelectConversation(target);
            }
            else
            {
                try
                {
                    var c = await Chat.GetConversationAsync(ConversationId.Value);
                    await SelectConversation(c);
                }
                catch { }
            }
        }
    }

    private async Task LoadConversations()
    {
        var version = ++conversationLoadVersion;
        var query = searchQuery;
        var tab = currentTab;
        loadingConversations = true;
        try
        {
            ChatTypeDto? filter = tab switch
            {
                "direct" => ChatTypeDto.Direct,
                "group" => ChatTypeDto.Group,
                _ => null
            };
            var result = await Chat.GetConversationsAsync(query, filter, tab == "unread");
            if (disposed || version != conversationLoadVersion) return;
            conversations = result;
            var summary = await Chat.GetSummaryAsync();
            if (disposed || version != conversationLoadVersion) return;
            totalUnread = summary.TotalUnreadMessages;
            if (activeConv != null)
            {
                var fresh = conversations.FirstOrDefault(c => c.Id == activeConv.Id);
                if (fresh != null) activeConv = fresh;
            }
        }
        catch (Exception ex)
        {
            if (!disposed && version == conversationLoadVersion) Toast.Error(ex.Message);
        }
        finally
        {
            if (!disposed && version == conversationLoadVersion)
            {
                loadingConversations = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task EnsureRealtimeSafelyAsync()
    {
        try { await Chat.EnsureHubConnectedAsync(); }
        catch (OperationCanceledException) { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (disposed) return;
        if (initializingChatJs) return;
        if (chatJs == null)
        {
            initializingChatJs = true;
            try
            {
                chatJs = await JS.InvokeAsync<IJSObjectReference>("import", "./js/chat-interop.js");
                if (disposed) { await chatJs.DisposeAsync(); return; }
                chatSelf = DotNetObjectReference.Create(this);
                interopId = await chatJs.InvokeAsync<int>("initialize", chatSelf);
                isMobileView = await chatJs.InvokeAsync<bool>("isMobileView");
                await chatJs.InvokeVoidAsync("watchMobile", interopId);
            }
            finally { initializingChatJs = false; }
        }
        if (activeConv != null) await chatJs.InvokeVoidAsync("attachComposer", interopId, composerElement);
        if (scrollAfterRender)
        {
            scrollAfterRender = false;
            await chatJs.InvokeVoidAsync("scrollToBottom");
        }
        if (markReadAfterRender)
        {
            markReadAfterRender = false;
            await MarkVisibleMessagesReadAsync();
        }
    }

    private async Task SelectConversation(ChatConversationDto c)
    {
        if (isUploading || isSending) { Toast.Info("لطفاً تا پایان بارگذاری یا ارسال صبر کنید."); return; }
        if (activeConv?.Id == c.Id) return;
        var previous = activeConv?.Id;
        if (previous.HasValue)
        {
            await Chat.SendTypingHubAsync(previous.Value, false);
            await Chat.LeaveConversationHubAsync(previous.Value);
        }
        var version = ++messageLoadVersion;
        activeConv = c;
        lastTypingSent = DateTime.MinValue;
        messages = new();
        replyingTo = null;
        editingMsg = null;
        messageInput = "";
        RemovePendingAttachment();
        loadingMessages = true;
        _ = JoinConversationSafelyAsync(c.Id);
        try
        {
            var result = await Chat.GetMessagesAsync(c.Id, null, 80);
            if (disposed || version != messageLoadVersion || activeConv?.Id != c.Id) return;
            // پیام‌های زنده‌ای که حین دریافت تاریخچه رسیده‌اند از دست نروند.
            var arrived = messages.Where(m => !result.Any(r => r.Id == m.Id)).ToList();
            messages = result.Select(m => m.ForUser(Auth.UserId)).Concat(arrived).OrderBy(m => m.Id).ToList();
            markReadAfterRender = true;
            scrollAfterRender = true;
        }
        catch (Exception ex) { if (!disposed && version == messageLoadVersion) Toast.Error(ex.Message); }
        finally { if (!disposed && version == messageLoadVersion) loadingMessages = false; }
    }

    private async Task JoinConversationSafelyAsync(int id)
    {
        try { await Chat.JoinConversationHubAsync(id); }
        catch (OperationCanceledException) { }
    }

    private void UpsertMessage(ChatMessageDto value)
    {
        var message = value.ForUser(Auth.UserId);
        var index = messages.FindIndex(m => m.Id == message.Id);
        if (index >= 0)
        {
            message.IsReadByPeer |= messages[index].IsReadByPeer && message.IsOutgoing;
            messages[index] = message;
        }
        else messages.Add(message);
        messages.Sort((a, b) => a.Id.CompareTo(b.Id));
    }

    private async Task SendCurrentMessage()
    {
        if (activeConv == null || isSending || isUploading) return;
        var conversationId = activeConv.Id;
        var text = messageInput.Trim();
        if (string.IsNullOrWhiteSpace(text) && uploadingFile == null) return;
        isSending = true;
        try
        {
            ChatMessageDto saved;
            if (editingMsg != null)
                saved = await Chat.EditMessageAsync(editingMsg.Id, text);
            else
                saved = await Chat.SendMessageAsync(conversationId, new SendChatMessageRequest
                {
                    ConversationId = conversationId, Text = text, ReplyToMessageId = replyingTo?.Id,
                    FileUrl = uploadingFile?.FileUrl, FileName = uploadingFile?.FileName,
                    FileSizeBytes = uploadingFile?.FileSizeBytes, FileContentType = uploadingFile?.FileContentType,
                    MessageType = uploadingFile?.MessageType ?? ChatMessageTypeDto.Text
                });
            if (disposed || activeConv?.Id != conversationId) return;
            // پاسخ موفق HTTP هم بلافاصله نمایش داده می‌شود؛ حتی اگر SignalR قطع باشد.
            UpsertMessage(saved);
            editingMsg = null;
            replyingTo = null;
            RemovePendingAttachment();
            messageInput = "";
            scrollAfterRender = true;
            await Chat.SendTypingHubAsync(conversationId, false);
            lastTypingSent = DateTime.MinValue;
            await LoadConversations();
        }
        catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); } // متن/پیوست برای تلاش مجدد حفظ می‌شود.
        finally
        {
            isSending = false;
            if (!disposed) await InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public async Task SendFromComposer(string value)
    {
        if (disposed || isSending) return;
        messageInput = value;
        await SendCurrentMessage();
    }

    private async Task OnMessageInputChanged()
    {
        if (activeConv == null || isSending) return;
        if (string.IsNullOrWhiteSpace(messageInput))
        {
            await Chat.SendTypingHubAsync(activeConv.Id, false);
            lastTypingSent = DateTime.MinValue;
        }
        else if (DateTime.UtcNow - lastTypingSent >= TimeSpan.FromSeconds(1))
        {
            lastTypingSent = DateTime.UtcNow;
            await Chat.SendTypingHubAsync(activeConv.Id);
        }
    }

    [JSInvokable]
    public Task ChatVisibilityChanged(bool visible) => InvokeAsync(() =>
    {
        documentVisible = visible;
        if (visible) markReadAfterRender = true;
        if (!disposed) StateHasChanged();
    });

    [JSInvokable]
    public Task MobileViewChanged(bool mobile) => InvokeAsync(() =>
    {
        if (isMobileView == mobile) return;
        isMobileView = mobile;
        if (!disposed) StateHasChanged();
    });

    private async Task MarkVisibleMessagesReadAsync()
    {
        if (disposed || !documentVisible || activeConv == null || messages.Count == 0) return;
        var id = activeConv.Id;
        var last = messages.Max(m => m.Id);
        if (acknowledgedReads.GetValueOrDefault(id) >= last || !readsInFlight.Add(id)) return;
        try
        {
            await Chat.MarkReadAsync(id, last);
            acknowledgedReads[id] = Math.Max(acknowledgedReads.GetValueOrDefault(id), last);
            await LoadConversations();
        }
        catch (Exception ex) { if (!disposed) Toast.Error(ex.Message); }
        finally
        {
            readsInFlight.Remove(id);
            if (!disposed && activeConv?.Id == id && messages.Count > 0 && messages.Max(m => m.Id) > last)
            {
                markReadAfterRender = true;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void StartReply(ChatMessageDto msg)
    {
        editingMsg = null;
        replyingTo = msg;
    }

