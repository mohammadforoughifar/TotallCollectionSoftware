    private bool IsCurrentPickerRequest(int version) =>
        !disposed && version == pickerSearchVersion && (showDirectModal || showGroupModal);

    private async Task OnUserSearchChanged()
    {
        var version = ++pickerSearchVersion;
        var query = userSearchQuery;
        loadingUsers = true;
        usersError = null;
        filteredUsers = new();
        await Task.Delay(250);
        if (!IsCurrentPickerRequest(version)) return;
        await FetchPickerUsersAsync(query, version);
    }

    private async Task LoadPickerUsersAsync()
    {
        var version = ++pickerSearchVersion;
        loadingUsers = true;
        usersError = null;
        filteredUsers = new();
        await FetchPickerUsersAsync(userSearchQuery, version);
    }

    private async Task FetchPickerUsersAsync(string query, int version)
    {
        try
        {
            var result = await Chat.GetSoftwareUsersAsync(query);
            if (IsCurrentPickerRequest(version)) filteredUsers = result;
        }
        catch (Exception ex)
        {
            if (IsCurrentPickerRequest(version))
                usersError = $"دریافت کاربران ناموفق بود: {ex.Message}";
        }
        finally
        {
            if (IsCurrentPickerRequest(version))
            {
                loadingUsers = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

