@namespace Inventory.Client.Pages
@page "/hr-core/onboarding"
@inject IHrTalentService Svc
@inject IHrCoreService EmpSvc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>آنبوردینگ</PageTitle>

<div class="page-head mb-4">
    <h1><i class="bi bi-person-plus"></i> آنبوردینگ (استقبال و استقرار)</h1>
    <div class="lead">چک‌لیست استقرار نیروهای تازه‌وارد</div>
</div>

@if (!canRead)
{
    <div class="alert alert-warning">دسترسی به ماژول کارگزینی برای شما فعال نیست.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="obopen" @bind="onlyOpen" @bind:after="Reload" />
            <label class="form-check-label" for="obopen">فقط پرونده‌های باز</label>
        </div>
        <div class="ms-auto">
            @if (canCreate)
            {
                <button class="btn btn-success" @onclick="() => showNew = true"><i class="bi bi-plus-lg"></i> آنبوردینگ جدید</button>
            }
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else
{
    <div class="row g-3">
        @foreach (var c in items)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <strong><a href="hr-core/employees/@c.EmployeeId" class="text-decoration-none">@c.EmployeeName</a></strong>
                        <span class="badge @(c.Status == 1 ? "text-bg-success" : "text-bg-primary")">@(c.Status == 1 ? "تکمیل" : "در جریان")</span>
                    </div>
                    <div class="card-body">
                        <div class="small text-muted mb-2">شروع: <span class="num">@c.StartDate.ToFa()</span></div>
                        <div class="progress mb-3" style="height:8px">
                            <div class="progress-bar bg-success" style="width:@c.Progress%"></div>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var it in c.Items)
                            {
                                <li class="list-group-item d-flex align-items-center gap-2 px-0">
                                    @if (canUpdate && c.Status == 0)
                                    {
                                        <input class="form-check-input mt-0" type="checkbox" checked="@(it.Status == 1)"
                                               @onchange="() => ToggleItem(c, it)" title="انجام شد / باز" />
                                    }
                                    <span class="@(it.Status == 1 ? "text-decoration-line-through text-muted" : "")">@it.Title</span>
                                    <span class="badge text-bg-light ms-auto">@HrCoreUi.TalentOwner(it.Owner)</span>
                                    @if (it.Status == 2)
                                    {
                                        <span class="badge text-bg-secondary">ردشده</span>
                                    }
                                    @if (canUpdate && c.Status == 0 && it.Status == 0)
                                    {
                                        <button class="btn btn-sm btn-light" title="رد کردن" @onclick="() => SkipItem(c, it)"><i class="bi bi-x-lg text-secondary"></i></button>
                                    }
                                    @if (canDelete && c.Status == 0)
                                    {
                                        <button class="btn btn-sm btn-light" title="حذف آیتم" @onclick="() => DeleteItem(c, it.Id)"><i class="bi bi-trash text-danger"></i></button>
                                    }
                                </li>
                            }
                        </ul>
                        @if (canUpdate && c.Status == 0)
                        {
                            <div class="input-group mt-2">
                                <input class="form-control" placeholder="آیتم جدید…" @bind="newItemTitle[c.Id]" />
                                <select class="form-select" style="max-width:150px" @bind="newItemOwner[c.Id]">
                                    <option value="0">کارگزینی</option>
                                    <option value="1">مدیر</option>
                                    <option value="2">فناوری اطلاعات</option>
                                    <option value="3">خود پرسنل</option>
                                </select>
                                <button class="btn btn-outline-primary" @onclick="() => AddItem(c)"><i class="bi bi-plus-lg"></i></button>
                            </div>
                            <button class="btn btn-success btn-sm mt-2" @onclick="() => Complete(c.Id)"><i class="bi bi-check-lg"></i> اتمام آنبوردینگ</button>
                        }
                        @if (!string.IsNullOrWhiteSpace(c.Note))
                        {
                            <div class="small text-muted mt-2">@c.Note</div>
                        }
                    </div>
                </div>
            </div>
        }
        @if (items.Count == 0)
        {
            <div class="col-12"><div class="alert alert-light text-center">پرونده‌ای یافت نشد.</div></div>
        }
    </div>
}

<Modal Visible="showNew" Title="آنبوردینگ جدید" OnClose="() => showNew = false">
<ChildContent>
    <div class="row g-2">
        <div class="col-12">
            <label class="form-label">پرسنل</label>
            <select class="form-select" @bind="nEmp">
                @foreach (var m in employees)
                {
                    <option value="@m.Id">@m.FirstName @m.LastName (@m.Code)</option>
                }
            </select>
        </div>
        <div class="col-12">
            <label class="form-label">یادداشت</label>
            <textarea class="form-control" rows="2" @bind="nNote"></textarea>
        </div>
    </div>
</ChildContent>
<Footer>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="() => showNew = false">انصراف</button>
        <button class="btn btn-success" disabled="@saving" @onclick="Create">ثبت</button>
    </div>
</Footer>
</Modal>

@code {
    private bool canRead => Auth.Has("HrCore.Read") || Auth.IsAdmin;
    private bool canCreate => Auth.Has("HrCore.Create") || Auth.IsAdmin;
    private bool canUpdate => Auth.Has("HrCore.Update") || Auth.IsAdmin;
    private bool canDelete => Auth.Has("HrCore.Delete") || Auth.IsAdmin;

    private bool loading = true, saving, showNew, onlyOpen = true;
    private List<HrOnboardingDto> items = new();
    private List<HrEmployeeDto> employees = new();
    private Dictionary<int, string> newItemTitle = new();
    private Dictionary<int, int> newItemOwner = new();
    private int nEmp;
    private string? nNote;

    protected override async Task OnInitializedAsync()
    {
        if (!canRead) { loading = false; return; }
        await Reload();
        try
        {
            employees = (await EmpSvc.SearchEmployeesAsync(null, null, 0, 0, 500)).Items;
            nEmp = employees.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Reload()
    {
        loading = true;
        try
        {
            items = await Svc.GetOnboardingAsync(onlyOpen ? true : null);
            foreach (var c in items)
            {
                newItemTitle.TryAdd(c.Id, "");
                newItemOwner.TryAdd(c.Id, 0);
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        loading = false;
    }

    private async Task Create()
    {
        saving = true;
        try
        {
            await Svc.CreateOnboardingAsync(new HrTalentCaseSaveDto { EmployeeId = nEmp, Note = nNote });
            showNew = false;
            nNote = null;
            Toast.Success("پرونده آنبوردینگ با چک‌لیست پیش‌فرض ساخته شد.");
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        saving = false;
    }

    private async Task ToggleItem(HrOnboardingDto c, HrTalentItemDto it)
    {
        try
        {
            var u = await Svc.SetOnboardingItemAsync(it.Id, it.Status == 1 ? 0 : 1, Auth.DisplayName);
            var i = items.FindIndex(x => x.Id == u.Id);
            if (i >= 0) items[i] = u;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task SkipItem(HrOnboardingDto c, HrTalentItemDto it)
    {
        try
        {
            var u = await Svc.SetOnboardingItemAsync(it.Id, 2, Auth.DisplayName);
            var i = items.FindIndex(x => x.Id == u.Id);
            if (i >= 0) items[i] = u;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteItem(HrOnboardingDto c, int itemId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "این آیتم حذف شود؟")) return;
        try
        {
            await Svc.DeleteOnboardingItemAsync(itemId);
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task AddItem(HrOnboardingDto c)
    {
        var title = newItemTitle.GetValueOrDefault(c.Id, "");
        if (string.IsNullOrWhiteSpace(title)) return;
        try
        {
            var u = await Svc.AddOnboardingItemAsync(c.Id,
                new HrTalentItemSaveDto { Title = title, Owner = newItemOwner.GetValueOrDefault(c.Id) });
            var i = items.FindIndex(x => x.Id == u.Id);
            if (i >= 0) items[i] = u;
            newItemTitle[c.Id] = "";
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Complete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "پرونده آنبوردینگ بسته شود؟")) return;
        try
        {
            await Svc.CompleteOnboardingAsync(id, Auth.DisplayName);
            Toast.Success("آنبوردینگ تکمیل شد.");
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
