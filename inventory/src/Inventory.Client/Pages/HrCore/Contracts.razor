@namespace Inventory.Client.Pages
@page "/hr-core/contracts"
@inject IHrCoreService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>قراردادها</PageTitle>

<div class="page-head mb-4">
    <h1><i class="bi bi-file-earmark-text"></i> قراردادها</h1>
    <div class="lead">قراردادهای پرسنل + هشدار پایان قرارداد</div>
</div>

@if (!canRead)
{
    <div class="alert alert-warning">دسترسی به ماژول کارگزینی برای شما فعال نیست.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <div>
            <label class="form-label small text-muted">هشدار پایان تا</label>
            <select class="form-select" @bind="expDays" @bind:after="Reload">
                <option value="15">۱۵ روز آینده</option>
                <option value="30">۳۰ روز آینده</option>
                <option value="60">۶۰ روز آینده</option>
                <option value="90">۹۰ روز آینده</option>
            </select>
        </div>
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="actonly" @bind="onlyActive" @bind:after="Reload" />
            <label class="form-check-label" for="actonly">فقط فعال‌ها</label>
        </div>
        <div class="ms-auto">
            @if (canCreate)
            {
                <button class="btn btn-success" @onclick="() => OpenEdit(null)"><i class="bi bi-plus-lg"></i> قرارداد جدید</button>
            }
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else
{
    @if (expiring.Count > 0)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div><b class="num">@expiring.Count.Num()</b> قرارداد تا <b class="num">@expDays.Num()</b> روز آینده به پایان می‌رسد یا منقضی شده است.</div>
        </div>
    }
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light"><tr><th>پرسنل</th><th>شماره</th><th>نوع</th><th>شروع</th><th>پایان</th><th>مانده</th><th>وضعیت</th><th style="width:90px"></th></tr></thead>
                    <tbody>
                        @foreach (var c in items)
                        {
                            <tr class="@(c.DaysToEnd is not null && c.DaysToEnd <= expDays && c.IsActive ? "table-warning" : "")">
                                <td><a href="hr-core/employees/@c.EmployeeId" class="fw-bold text-decoration-none">@c.EmployeeName</a></td>
                                <td class="num">@c.ContractNo</td>
                                <td>@HrCoreUi.EmpType(c.Type)</td>
                                <td class="num">@c.StartDate.ToFa()</td>
                                <td class="num">@(c.EndDate?.ToFa() ?? "دائمی")</td>
                                <td><span class="badge @RemainClass(c)">@RemainText(c.DaysToEnd)</span></td>
                                <td>
                                    @if (c.IsActive)
                                    {
                                        <span class="badge text-bg-success">فعال</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">غیرفعال</span>
                                    }
                                </td>
                                <td>
                                    @if (canUpdate)
                                    {
                                        <button class="btn btn-sm btn-light" @onclick="() => OpenEdit(c)"><i class="bi bi-pencil text-warning"></i></button>
                                    }
                                    @if (canDelete)
                                    {
                                        <button class="btn btn-sm btn-light" @onclick="() => Delete(c.Id)"><i class="bi bi-trash text-danger"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<Modal Visible="showEdit" Title="قرارداد" Size="modal-lg" OnClose="() => showEdit = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label">پرسنل <span class="text-danger">*</span></label>
                <select class="form-select" @bind="form.EmployeeId">
                    @foreach (var m in employees)
                    {
                        <option value="@m.Id">@m.FullName (@m.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label">شماره قرارداد</label><input class="form-control num" @bind="form.ContractNo" /></div>
            <div class="col-md-3">
                <label class="form-label">نوع</label>
                <select class="form-select" @bind="form.Type">
                    <option value="0">رسمی</option><option value="1">قراردادی</option><option value="2">پیمانی</option>
                    <option value="3">ساعتی</option><option value="4">مشاوره‌ای</option>
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">شروع</label><DatePicker @bind-Value="cStart" /></div>
            <div class="col-md-4"><label class="form-label">پایان (خالی=دائمی)</label><DatePicker @bind-Value="cEnd" AllowClear="true" /></div>
            <div class="col-md-4"><label class="form-label">حقوق پایه (ریال)</label><input class="form-control num" type="number" min="0" @bind="form.BaseSalary" /></div>
            <div class="col-md-4"><label class="form-label">عنوان شغلی</label><input class="form-control" @bind="form.JobTitle" /></div>
            <div class="col-md-4">
                <label class="form-label">واحد سازمانی</label>
                <select class="form-select" @bind="form.OrgUnitId">
                    <option value="">—</option>
                    @foreach (var u in units)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="ccact" @bind="form.IsActive" /><label class="form-check-label" for="ccact">فعال</label></div>
            </div>
            <div class="col-12"><label class="form-label">توضیح</label><input class="form-control" @bind="form.Description" /></div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showEdit = false">انصراف</button>
        <button class="btn btn-primary" disabled="@saving" @onclick="Save">ذخیره</button>
    </Footer>
</Modal>

@code {
    private bool canRead => Auth.Has("HrCore.Read") || Auth.IsAdmin;
    private bool canCreate => Auth.Has("HrCore.Create") || Auth.IsAdmin;
    private bool canUpdate => Auth.Has("HrCore.Update") || Auth.IsAdmin;
    private bool canDelete => Auth.Has("HrCore.Delete") || Auth.IsAdmin;

    private bool loading = true, saving, showEdit, onlyActive = true;
    private int expDays = 30;
    private List<HrContractDto> items = new();
    private List<HrContractDto> expiring = new();
    private List<HrEmployeeDto> employees = new();
    private List<HrOrgUnitDto> units = new();
    private int? editId;
    private HrContractSaveDto form = new();
    private DateTime? cStart, cEnd;

    protected override async Task OnInitializedAsync()
    {
        if (!canRead) return;
        try
        {
            employees = (await Svc.SearchEmployeesAsync(null, null, 0, 0, 500)).Items;
            units = await Svc.GetOrgUnitsAsync();
        }
        catch { }
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try
        {
            items = await Svc.GetContractsAsync(onlyActive ? true : null);
            expiring = await Svc.GetExpiringContractsAsync(expDays);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenEdit(HrContractDto? c)
    {
        editId = c?.Id;
        form = c is null
            ? new HrContractSaveDto { StartDate = DateTime.Today, EmployeeId = employees.FirstOrDefault()?.Id ?? 0 }
            : new HrContractSaveDto
            {
                EmployeeId = c.EmployeeId, ContractNo = c.ContractNo, Type = c.Type,
                StartDate = c.StartDate, EndDate = c.EndDate, BaseSalary = c.BaseSalary,
                JobTitle = c.JobTitle, OrgUnitId = c.OrgUnitId, Description = c.Description, IsActive = c.IsActive
            };
        cStart = form.StartDate; cEnd = form.EndDate;
        showEdit = true;
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            form.StartDate = cStart ?? DateTime.Today; form.EndDate = cEnd;
            await Svc.SaveContractAsync(editId, form);
            showEdit = false;
            await Reload();
            Toast.Success("ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "قرارداد حذف شود؟")) return;
        try { await Svc.DeleteContractAsync(id); await Reload(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static string RemainText(int? days) => days switch
    {
        null => "دائمی",
        < 0 => "منقضی",
        0 => "امروز",
        _ => $"{days.Value.Num()} روز"
    };

    private static string RemainClass(HrContractDto c) => c.DaysToEnd switch
    {
        null => "text-bg-light border",
        < 0 => "text-bg-danger",
        <= 7 => "text-bg-warning",
        _ => "text-bg-info"
    };
}
