@namespace Inventory.Client.Pages

<li class="org-node">
    <div class="org-card @(!Unit.IsActive ? "opacity-50" : "")">
        <div class="org-type">@HrCoreUi.OrgType(Unit.Type)</div>
        <div class="org-name">@Unit.Name</div>
        <div class="org-meta num">@Unit.Code • @Unit.EmployeeCount.Num() نفر</div>
        @if (!string.IsNullOrWhiteSpace(Unit.ManagerName))
        {
            <div class="org-mgr"><i class="bi bi-person"></i> @Unit.ManagerName</div>
        }
        @if (CanEdit)
        {
            <div class="org-ops">
                <button class="btn btn-sm btn-light py-0" title="زیرمجموعه جدید" @onclick="() => OnAdd.InvokeAsync(Unit.Id)"><i class="bi bi-plus-lg text-success"></i></button>
                <button class="btn btn-sm btn-light py-0" title="ویرایش" @onclick="() => OnEdit.InvokeAsync(Unit.Id)"><i class="bi bi-pencil text-warning"></i></button>
                <button class="btn btn-sm btn-light py-0" title="حذف" @onclick="() => OnDelete.InvokeAsync(Unit.Id)"><i class="bi bi-trash text-danger"></i></button>
            </div>
        }
    </div>
    @if (Unit.Children.Count > 0)
    {
        <ul class="org-children">
            @foreach (var ch in Unit.Children)
            {
                <OrgNode Unit="ch" CanEdit="CanEdit" OnAdd="OnAdd" OnEdit="OnEdit" OnDelete="OnDelete" />
            }
        </ul>
    }
</li>

<style>
    .org-node { list-style: none; position: relative; padding-top: 18px; }
    .org-children { display: flex; justify-content: center; gap: 12px; padding: 18px 0 0 0; margin: 0; position: relative; }
    .org-children::before { content: ""; position: absolute; top: 0; right: 50%; width: 1px; height: 18px; background: #cbd5e1; }
    .org-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; padding: .5rem .9rem; text-align: center; min-width: 150px; box-shadow: 0 1px 4px rgba(0,0,0,.06); position: relative; }
    .org-card::before { content: ""; position: absolute; top: -18px; right: 50%; width: 1px; height: 18px; background: #cbd5e1; }
    li.org-node:first-child > .org-card::before { display: none; }
    .org-type { font-size: .65rem; color: #7c3aed; font-weight: 700; }
    .org-name { font-weight: 800; color: #1e293b; font-size: .9rem; }
    .org-meta { font-size: .7rem; color: #94a3b8; }
    .org-mgr { font-size: .7rem; color: #64748b; margin-top: 2px; }
    .org-ops { margin-top: 4px; display: flex; gap: 2px; justify-content: center; }
</style>

@code {
    [Parameter] public HrOrgUnitDto Unit { get; set; } = new();
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public EventCallback<int> OnAdd { get; set; }
    [Parameter] public EventCallback<int> OnEdit { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }
}
