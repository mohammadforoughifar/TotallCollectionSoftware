@namespace Inventory.Client.Pages
@page "/hr-core/decrees"
@inject IHrCoreService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>احکام کارگزینی</PageTitle>

<div class="page-head mb-4">
    <h1><i class="bi bi-patch-check"></i> احکام کارگزینی</h1>
    <div class="lead">صدور و اجرای احکام پرسنل</div>
</div>

@if (!canRead)
{
    <div class="alert alert-warning">دسترسی به ماژول کارگزینی برای شما فعال نیست.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="pend" @bind="onlyPending" @bind:after="Reload" />
            <label class="form-check-label" for="pend">فقط اجرا نشده‌ها</label>
        </div>
        <div class="ms-auto">
            @if (canCreate)
            {
                <button class="btn btn-success" @onclick="() => OpenEdit(null)"><i class="bi bi-plus-lg"></i> حکم جدید</button>
            }
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0 align-middle">
                    <thead class="table-light"><tr><th>پرسنل</th><th>نوع حکم</th><th>شماره</th><th>اجرا از</th><th>تغییرات</th><th>وضعیت</th><th style="width:120px"></th></tr></thead>
                    <tbody>
                        @foreach (var d in items)
                        {
                            <tr>
                                <td><a href="hr-core/employees/@d.EmployeeId" class="fw-bold text-decoration-none">@d.EmployeeName</a></td>
                                <td><span class="badge rounded-pill text-bg-primary">@HrCoreUi.DecreeType(d.Type)</span></td>
                                <td class="num">@d.DecreeNo</td>
                                <td class="num">@d.EffectiveDate.ToFa()</td>
                                <td class="small text-muted">@ChangeSummary(d)</td>
                                <td>
                                    @if (d.IsApplied)
                                    {
                                        <span class="badge text-bg-success">اجرا شده</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-secondary">در انتظار</span>
                                    }
                                </td>
                                <td>
                                    @if (!d.IsApplied && canUpdate)
                                    {
                                        <button class="btn btn-sm btn-primary py-0" @onclick="() => Apply(d.Id)">اجرا</button>
                                        <button class="btn btn-sm btn-light py-0" @onclick="() => OpenEdit(d)"><i class="bi bi-pencil"></i></button>
                                    }
                                    @if (!d.IsApplied && canDelete)
                                    {
                                        <button class="btn btn-sm btn-light py-0" @onclick="() => Delete(d.Id)"><i class="bi bi-trash text-danger"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
}

<Modal Visible="showEdit" Title="حکم کارگزینی" Size="modal-lg" OnClose="() => showEdit = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-md-6">
                <label class="form-label">پرسنل <span class="text-danger">*</span></label>
                <select class="form-select" @bind="form.EmployeeId">
                    @foreach (var m in employees)
                    {
                        <option value="@m.Id">@m.FullName (@m.Code)</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><label class="form-label">شماره حکم</label><input class="form-control num" @bind="form.DecreeNo" /></div>
            <div class="col-md-3">
                <label class="form-label">نوع حکم</label>
                <select class="form-select" @bind="form.Type">
                    <option value="0">استخدام</option><option value="1">ارتقا</option><option value="2">انتقال</option>
                    <option value="3">تغییر حقوق</option><option value="4">تشویق</option><option value="5">تنبیه</option>
                    <option value="6">قطع همکاری</option><option value="7">بازنشستگی</option>
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">تاریخ اجرا</label><DatePicker @bind-Value="dEff" /></div>
            <div class="col-md-4"><label class="form-label">پست جدید</label><input class="form-control" @bind="form.NewPostTitle" /></div>
            <div class="col-md-4">
                <label class="form-label">واحد جدید</label>
                <select class="form-select" @bind="form.NewOrgUnitId">
                    <option value="">—</option>
                    @foreach (var u in units)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">حقوق جدید (ریال)</label><input class="form-control num" type="number" min="0" @bind="form.NewBaseSalary" /></div>
            <div class="col-md-4">
                <label class="form-label">وضعیت جدید</label>
                <select class="form-select" @bind="form.NewStatus">
                    <option value="">— بدون تغییر —</option>
                    <option value="0">فعال</option><option value="1">مرخصی بلندمدت</option><option value="2">معلق</option>
                    <option value="3">قطع همکاری</option><option value="4">بازنشسته</option>
                </select>
            </div>
            <div class="col-12"><label class="form-label">شرح حکم</label><input class="form-control" @bind="form.Description" /></div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showEdit = false">انصراف</button>
        <button class="btn btn-primary" disabled="@saving" @onclick="Save">ذخیره</button>
    </Footer>
</Modal>

@code {
    private bool canRead => Auth.Has("HrCore.Read") || Auth.IsAdmin;
    private bool canCreate => Auth.Has("HrCore.Create") || Auth.IsAdmin;
    private bool canUpdate => Auth.Has("HrCore.Update") || Auth.IsAdmin;
    private bool canDelete => Auth.Has("HrCore.Delete") || Auth.IsAdmin;

    private bool loading = true, saving, showEdit, onlyPending;
    private List<HrDecreeDto> items = new();
    private List<HrEmployeeDto> employees = new();
    private List<HrOrgUnitDto> units = new();
    private int? editId;
    private HrDecreeSaveDto form = new();
    private DateTime? dEff;

    protected override async Task OnInitializedAsync()
    {
        if (!canRead) return;
        try
        {
            employees = (await Svc.SearchEmployeesAsync(null, null, 0, 0, 500)).Items;
            units = await Svc.GetOrgUnitsAsync();
        }
        catch { }
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try { items = await Svc.GetDecreesAsync(null, onlyPending ? true : null); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenEdit(HrDecreeDto? d)
    {
        editId = d?.Id;
        form = d is null
            ? new HrDecreeSaveDto { EffectiveDate = DateTime.Today, EmployeeId = employees.FirstOrDefault()?.Id ?? 0 }
            : new HrDecreeSaveDto
            {
                EmployeeId = d.EmployeeId, DecreeNo = d.DecreeNo, Type = d.Type, EffectiveDate = d.EffectiveDate,
                NewPostTitle = d.NewPostTitle, NewOrgUnitId = d.NewOrgUnitId,
                NewBaseSalary = d.NewBaseSalary, NewStatus = d.NewStatus, Description = d.Description
            };
        dEff = form.EffectiveDate;
        showEdit = true;
    }

    private async Task Save()
    {
        saving = true;
        try
        {
            form.EffectiveDate = dEff ?? DateTime.Today;
            await Svc.SaveDecreeAsync(editId, form);
            showEdit = false;
            await Reload();
            Toast.Success("ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Apply(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حکم روی پرونده اعمال شود؟ این عمل برگشت‌ناپذیر است.")) return;
        try { await Svc.ApplyDecreeAsync(id); await Reload(); Toast.Success("حکم اجرا شد."); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Delete(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حکم حذف شود؟")) return;
        try { await Svc.DeleteDecreeAsync(id); await Reload(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static string ChangeSummary(HrDecreeDto d)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(d.NewPostTitle)) parts.Add($"پست: {d.NewPostTitle}");
        if (!string.IsNullOrWhiteSpace(d.NewOrgUnitName)) parts.Add($"واحد: {d.NewOrgUnitName}");
        if (d.NewBaseSalary is > 0) parts.Add("حقوق جدید");
        if (d.NewStatus is >= 0) parts.Add(HrCoreUi.EmpStatus(d.NewStatus.Value));
        return parts.Count == 0 ? "—" : string.Join(" • ", parts);
    }
}
