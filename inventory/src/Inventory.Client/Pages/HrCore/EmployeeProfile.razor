@namespace Inventory.Client.Pages
@page "/hr-core/employees/{Id:int}"
@inject IHrCoreService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>پرونده پرسنل</PageTitle>

@if (!canRead)
{
    <div class="alert alert-warning mt-4">دسترسی به ماژول کارگزینی برای شما فعال نیست.</div>
    return;
}

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else if (emp is null)
{
    <div class="alert alert-danger mt-4">پرسنل یافت نشد. <a href="hr-core/employees">بازگشت به لیست</a></div>
}
else
{
    <div class="d-flex align-items-center gap-2 mb-3 mt-1">
        <a class="btn btn-sm btn-light" href="hr-core/employees"><i class="bi bi-arrow-right"></i> لیست پرسنل</a>
        @if (canUpdate)
        {
            <a class="btn btn-sm btn-outline-warning" href="hr-core/employees"><i class="bi bi-pencil"></i> ویرایش از لیست</a>
        }
    </div>

    <div class="card border-0 shadow-sm mb-3 overflow-hidden">
        <div class="hr-cover"></div>
        <div class="card-body pt-0">
            <div class="d-flex align-items-end gap-3" style="margin-top:-34px">
                <span class="hr-avatar-lg" style="background:@HrCoreUi.AvatarColor(emp.Code)">@HrCoreUi.Initials(emp.FirstName, emp.LastName)</span>
                <div class="pb-1">
                    <h4 class="mb-0">@emp.FullName</h4>
                    <div class="text-muted small num">کد پرسنلی @emp.Code • کد ملی @emp.NationalCode</div>
                </div>
                <div class="ms-auto pb-1 d-flex gap-1">
                    <span class="badge @HrCoreUi.StatusBadge(emp.Status)">@HrCoreUi.EmpStatus(emp.Status)</span>
                    <span class="badge rounded-pill text-bg-light border">@HrCoreUi.EmpType(emp.EmploymentType)</span>
                </div>
            </div>
            <div class="row g-2 mt-3">
                <div class="col-md-3"><div class="hr-kv"><span>واحد سازمانی</span><b>@(emp.OrgUnitName ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>پست سازمانی</span><b>@(emp.PostTitle ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>مدیر مستقیم</span><b>@(emp.ManagerName ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>تاریخ استخدام</span><b class="num">@emp.HireDate.ToFa()</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>موبایل</span><b class="num" dir="ltr">@(emp.Mobile ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>حقوق پایه</span><b class="num">@Fa.Digits(emp.BaseSalary.ToString("N0")) ریال</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>تاریخ تولد</span><b class="num">@(emp.BirthDate?.ToFa() ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>قرارداد فعال</span><b class="num">@(emp.ActiveContractNo ?? "—")</b></div></div>
            </div>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-text text-primary ms-1"></i> قراردادها (@contracts.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenContract(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (contracts.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">قراردادی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>شماره</th><th>نوع</th><th>بازه</th><th>وضعیت</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in contracts)
                                {
                                    <tr>
                                        <td class="num">@c.ContractNo</td>
                                        <td>@HrCoreUi.EmpType(c.Type)</td>
                                        <td class="small num">@c.StartDate.ToFa() ← @(c.EndDate?.ToFa() ?? "دائمی")</td>
                                        <td>
                                            @if (!c.IsActive)
                                            {
                                                <span class="badge text-bg-secondary">غیرفعال</span>
                                            }
                                            else if (c.DaysToEnd is < 0)
                                            {
                                                <span class="badge text-bg-danger">منقضی</span>
                                            }
                                            else if (c.DaysToEnd is <= 30)
                                            {
                                                <span class="badge text-bg-warning">رو به پایان</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">معتبر</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenContract(c)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteContract(c.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-patch-check text-success ms-1"></i> احکام (@decrees.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenDecree(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (decrees.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">حکمی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>نوع حکم</th><th>اجرا از</th><th>وضعیت</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in decrees)
                                {
                                    <tr>
                                        <td><b>@HrCoreUi.DecreeType(d.Type)</b><div class="small text-muted num">شماره @d.DecreeNo</div></td>
                                        <td class="num">@d.EffectiveDate.ToFa()</td>
                                        <td>
                                            @if (d.IsApplied)
                                            {
                                                <span class="badge text-bg-success" title="@d.AppliedAt?.ToFa()">اجرا شده</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">در انتظار</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!d.IsApplied && canUpdate)
                                            {
                                                <button class="btn btn-sm btn-primary py-0" title="اجرا روی پرونده" @onclick="() => ApplyDecree(d.Id)">اجرا</button>
                                            }
                                            @if (!d.IsApplied && canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenDecree(d)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (!d.IsApplied && canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteDecree(d.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <AttachmentBox Module="HrEmployee" RefId="Id" CanUpload="@canUpdate" />
    </div>
}

<Modal Visible="showContract" Title="قرارداد" Size="modal-lg" OnClose="() => showContract = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label">شماره قرارداد</label><input class="form-control num" @bind="cform.ContractNo" /></div>
            <div class="col-md-4">
                <label class="form-label">نوع</label>
                <select class="form-select" @bind="cform.Type">
                    <option value="0">رسمی</option><option value="1">قراردادی</option><option value="2">پیمانی</option>
                    <option value="3">ساعتی</option><option value="4">مشاوره‌ای</option>
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">عنوان شغلی</label><input class="form-control" @bind="cform.JobTitle" /></div>
            <div class="col-md-4"><label class="form-label">شروع</label><DatePicker @bind-Value="cStart" /></div>
            <div class="col-md-4"><label class="form-label">پایان (خالی=دائمی)</label><DatePicker @bind-Value="cEnd" AllowClear="true" /></div>
            <div class="col-md-4"><label class="form-label">حقوق پایه (ریال)</label><input class="form-control num" type="number" min="0" @bind="cform.BaseSalary" /></div>
            <div class="col-md-8">
                <label class="form-label">واحد سازمانی</label>
                <select class="form-select" @bind="cform.OrgUnitId">
                    <option value="">—</option>
                    @foreach (var u in units)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4 d-flex align-items-end">
                <div class="form-check"><input class="form-check-input" type="checkbox" id="cact" @bind="cform.IsActive" /><label class="form-check-label" for="cact">فعال</label></div>
            </div>
            <div class="col-12"><label class="form-label">توضیح</label><input class="form-control" @bind="cform.Description" /></div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showContract = false">انصراف</button>
        <button class="btn btn-primary" disabled="@saving" @onclick="SaveContract">ذخیره</button>
    </Footer>
</Modal>

<Modal Visible="showDecree" Title="حکم کارگزینی" Size="modal-lg" OnClose="() => showDecree = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label">شماره حکم</label><input class="form-control num" @bind="dform.DecreeNo" /></div>
            <div class="col-md-4">
                <label class="form-label">نوع حکم</label>
                <select class="form-select" @bind="dform.Type">
                    <option value="0">استخدام</option><option value="1">ارتقا</option><option value="2">انتقال</option>
                    <option value="3">تغییر حقوق</option><option value="4">تشویق</option><option value="5">تنبیه</option>
                    <option value="6">قطع همکاری</option><option value="7">بازنشستگی</option>
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">تاریخ اجرا</label><DatePicker @bind-Value="dEff" /></div>
            <div class="col-md-4"><label class="form-label">پست جدید</label><input class="form-control" @bind="dform.NewPostTitle" /></div>
            <div class="col-md-4">
                <label class="form-label">واحد جدید</label>
                <select class="form-select" @bind="dform.NewOrgUnitId">
                    <option value="">—</option>
                    @foreach (var u in units)
                    {
                        <option value="@u.Id">@u.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-4"><label class="form-label">حقوق جدید (ریال)</label><input class="form-control num" type="number" min="0" @bind="dform.NewBaseSalary" /></div>
            <div class="col-md-4">
                <label class="form-label">وضعیت جدید</label>
                <select class="form-select" @bind="dform.NewStatus">
                    <option value="">— بدون تغییر —</option>
                    <option value="0">فعال</option><option value="1">مرخصی بلندمدت</option><option value="2">معلق</option>
                    <option value="3">قطع همکاری</option><option value="4">بازنشسته</option>
                </select>
            </div>
            <div class="col-12"><label class="form-label">شرح حکم</label><input class="form-control" @bind="dform.Description" /></div>
            <div class="col-12"><div class="alert alert-info py-2 small mb-0"><i class="bi bi-info-circle"></i> حکم با دکمه «اجرا» روی پرونده اعمال می‌شود و بعد از آن قابل ویرایش/حذف نیست.</div></div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showDecree = false">انصراف</button>
        <button class="btn btn-primary" disabled="@saving" @onclick="SaveDecree">ذخیره</button>
    </Footer>
</Modal>

<style>
    .hr-cover { height: 74px; background: linear-gradient(135deg, #2563eb, #7c3aed); }
    .hr-avatar-lg { width: 76px; height: 76px; border-radius: 50%; color: #fff; font-weight: 800; font-size: 1.4rem; display: inline-flex; align-items: center; justify-content: center; border: 4px solid #fff; box-shadow: 0 2px 8px rgba(0,0,0,.15); flex-shrink: 0; }
    .hr-kv { background: #f8fafc; border-radius: 10px; padding: .45rem .7rem; }
    .hr-kv span { display: block; font-size: .7rem; color: #94a3b8; }
    .hr-kv b { font-size: .85rem; color: #1e293b; }
</style>

@code {
    [Parameter] public int Id { get; set; }

    private bool canRead => Auth.Has("HrCore.Read") || Auth.IsAdmin;
    private bool canCreate => Auth.Has("HrCore.Create") || Auth.IsAdmin;
    private bool canUpdate => Auth.Has("HrCore.Update") || Auth.IsAdmin;
    private bool canDelete => Auth.Has("HrCore.Delete") || Auth.IsAdmin;

    private bool loading = true, saving;
    private HrEmployeeDto? emp;
    private List<HrContractDto> contracts = new();
    private List<HrDecreeDto> decrees = new();
    private List<HrOrgUnitDto> units = new();

    private bool showContract, showDecree;
    private int? cEditId, dEditId;
    private HrContractSaveDto cform = new();
    private HrDecreeSaveDto dform = new();
    private DateTime? cStart, cEnd, dEff;

    protected override async Task OnParametersSetAsync()
    {
        if (!canRead) return;
        loading = true;
        try
        {
            units = await Svc.GetOrgUnitsAsync();
            emp = await Svc.GetEmployeeAsync(Id);
            contracts = await Svc.GetEmployeeContractsAsync(Id);
            decrees = await Svc.GetEmployeeDecreesAsync(Id);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenContract(HrContractDto? c)
    {
        cEditId = c?.Id;
        cform = c is null
            ? new HrContractSaveDto { EmployeeId = Id, StartDate = DateTime.Today }
            : new HrContractSaveDto
            {
                EmployeeId = Id, ContractNo = c.ContractNo, Type = c.Type,
                StartDate = c.StartDate, EndDate = c.EndDate, BaseSalary = c.BaseSalary,
                JobTitle = c.JobTitle, OrgUnitId = c.OrgUnitId, Description = c.Description, IsActive = c.IsActive
            };
        cStart = cform.StartDate; cEnd = cform.EndDate;
        showContract = true;
    }

    private async Task SaveContract()
    {
        saving = true;
        try
        {
            cform.StartDate = cStart ?? DateTime.Today; cform.EndDate = cEnd;
            await Svc.SaveContractAsync(cEditId, cform);
            showContract = false;
            contracts = await Svc.GetEmployeeContractsAsync(Id);
            Toast.Success("قرارداد ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteContract(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "قرارداد حذف شود؟")) return;
        try { await Svc.DeleteContractAsync(id); contracts = await Svc.GetEmployeeContractsAsync(Id); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void OpenDecree(HrDecreeDto? d)
    {
        dEditId = d?.Id;
        dform = d is null
            ? new HrDecreeSaveDto { EmployeeId = Id, EffectiveDate = DateTime.Today }
            : new HrDecreeSaveDto
            {
                EmployeeId = Id, DecreeNo = d.DecreeNo, Type = d.Type, EffectiveDate = d.EffectiveDate,
                NewPostTitle = d.NewPostTitle, NewOrgUnitId = d.NewOrgUnitId,
                NewBaseSalary = d.NewBaseSalary, NewStatus = d.NewStatus, Description = d.Description
            };
        dEff = dform.EffectiveDate;
        showDecree = true;
    }

    private async Task SaveDecree()
    {
        saving = true;
        try
        {
            dform.EffectiveDate = dEff ?? DateTime.Today;
            await Svc.SaveDecreeAsync(dEditId, dform);
            showDecree = false;
            decrees = await Svc.GetEmployeeDecreesAsync(Id);
            Toast.Success("حکم ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task ApplyDecree(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حکم روی پرونده اعمال شود؟ این عمل برگشت‌ناپذیر است.")) return;
        try
        {
            await Svc.ApplyDecreeAsync(id);
            emp = await Svc.GetEmployeeAsync(Id);
            decrees = await Svc.GetEmployeeDecreesAsync(Id);
            Toast.Success("حکم اجرا شد و پرونده به‌روز شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteDecree(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حکم حذف شود؟")) return;
        try { await Svc.DeleteDecreeAsync(id); decrees = await Svc.GetEmployeeDecreesAsync(Id); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
