    private void OpenDocument(HrEmployeeDocumentDto? x)
    {
        docEditId = x?.Id;
        docform = x is null
            ? new HrEmployeeDocumentSaveDto()
            : new HrEmployeeDocumentSaveDto
            {
                Title = x.Title, DocType = x.DocType,
                IssueDate = x.IssueDate, ExpiryDate = x.ExpiryDate, Notes = x.Notes
            };
        docIssue = docform.IssueDate;
        docExpiry = docform.ExpiryDate;
        showDocument = true;
    }

    private async Task SaveDocument()
    {
        saving = true;
        try
        {
            docform.IssueDate = docIssue;
            docform.ExpiryDate = docExpiry;
            await Svc.SaveDocumentAsync(Id, docEditId, docform);
            showDocument = false;
            await RefreshDocs();
            Toast.Success("سند ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteDocument(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "این سند و فایل آن حذف شود؟")) return;
        try { await Svc.DeleteDocumentAsync(id); await RefreshDocs(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task RefreshDocs()
    {
        documents = await Svc.GetDocumentsAsync(Id);
        expiringDocs = documents.Where(d => d.IsExpired || d.IsExpiringSoon).ToList();
    }

    private async Task OnDocFileSelected(int docId, InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > long.MaxValue) { Toast.Error("حداکثر حجم فایل ۲۰ مگابایت است."); return; }
        try
        {
            await using var stream = file.OpenReadStream(long.MaxValue);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            await Svc.UploadDocumentFileAsync(docId, ms, file.Name, file.ContentType);
            documents = await Svc.GetDocumentsAsync(Id);
            Toast.Success("فایل سند ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DownloadDoc(HrEmployeeDocumentDto d)
    {
        try
        {
            var f = await Svc.DownloadDocumentAsync(d.Id);
            await JS.InvokeVoidAsync("saveAsFile", f.FileName, Convert.ToBase64String(f.Data));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
