@namespace Inventory.Client.Pages
@page "/hr-core/employees/{Id:int}"
@page "/hr-main/employees/{Id:int}/profile"
@inject IHrCoreService Svc
@inject IAuthState Auth
@inject IToastService Toast
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>پرونده پرسنل</PageTitle>

@if (!canRead)
{
    <div class="alert alert-warning mt-4">دسترسی به ماژول کارگزینی برای شما فعال نیست.</div>
    return;
}

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else if (loadError)
{
    <div class="hr-error" role="alert"><span>پرونده پرسنل دریافت نشد.</span><button class="btn btn-sm btn-outline-secondary" @onclick="OnParametersSetAsync">تلاش مجدد</button><a href="@EmployeeListUrl">بازگشت به لیست</a></div>
}
else if (emp is null)
{
    <div class="alert alert-danger mt-4">پرسنل یافت نشد. <a href="@EmployeeListUrl">بازگشت به لیست</a></div>
}
else
{
    <div class="d-flex align-items-center justify-content-end flex-wrap gap-2 mb-3 mt-1">
        <a class="btn btn-sm btn-light" href="@EmployeeListUrl"><i class="bi bi-arrow-right"></i> لیست پرسنل</a>
        <button class="btn btn-sm btn-outline-primary" @onclick="PrintDossier"><i class="bi bi-printer"></i> چاپ پرونده</button>
        @if (emp!.IsActive)
        {
            <button class="btn btn-sm btn-outline-success" @onclick="() => showCertModal = true"><i class="bi bi-file-earmark-medical"></i> گواهی اشتغال به کار</button>
        }
        <a class="btn btn-sm btn-outline-secondary" href="@($"hr-core/job-history/{emp!.Id}")"><i class="bi bi-clock-history"></i> سوابق شغلی</a>
        @if (canUpdate)
        {
            <a class="btn btn-sm btn-outline-warning" href="@(FromHrMain ? $"hr-main/employees/{Id}" : EmployeeListUrl)"><i class="bi bi-pencil"></i> @(FromHrMain ? "ویرایش پرسنل" : "ویرایش از لیست")</a>
        }
    </div>

    <div class="card border-0 shadow-sm mb-3 overflow-hidden">
        <div class="hr-cover"></div>
        <div class="card-body pt-0">
            <div class="d-flex align-items-end gap-3" style="margin-top:-34px">
                @if (photoUrl is null)
                {
                    <span class="hr-avatar-lg" style="background:@HrCoreUi.AvatarColor(emp.Code)">@HrCoreUi.Initials(emp.FirstName, emp.LastName)</span>
                }
                else
                {
                    <img src="@photoUrl" class="hr-photo-lg" alt="عکس پرسنل" />
                }
                @if (canUpdate)
                {
                    <div class="d-flex flex-column gap-1 pb-1">
                        <label class="btn btn-sm btn-light border mb-0" title="تغییر عکس">
                            <i class="bi bi-camera"></i>
                            <InputFile OnChange="OnPhotoSelected" accept=".jpg,.jpeg,.png,.webp" style="display:none" />
                        </label>
                        @if (!string.IsNullOrWhiteSpace(emp.PhotoPath))
                        {
                            <button class="btn btn-sm btn-light border" title="حذف عکس" @onclick="DeletePhoto"><i class="bi bi-trash text-danger"></i></button>
                        }
                    </div>
                }
                <div class="pb-1">
                    <h4 class="mb-0">@emp.FullName</h4>
                    <div class="text-muted small num">کد پرسنلی @emp.Code • کد ملی @emp.NationalCode</div>
                </div>
                <div class="ms-auto pb-1 d-flex gap-1">
                    <span class="badge @HrCoreUi.StatusBadge(emp.Status)">@HrCoreUi.EmpStatus(emp.Status)</span>
                    <span class="badge rounded-pill text-bg-light border">@HrCoreUi.EmpType(emp.EmploymentType)</span>
                </div>
            </div>
            <div class="row g-2 mt-3">
                <div class="col-md-3"><div class="hr-kv"><span>واحد سازمانی</span><b>@(emp.OrgUnitName ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>پست سازمانی</span><b>@(emp.PostTitle ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>مدیر مستقیم</span><b>@(emp.ManagerName ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>تاریخ استخدام</span><b class="num">@emp.HireDate.ToFa()</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>موبایل</span><b class="num" dir="ltr">@(emp.Mobile ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>تلفن ثابت</span><b class="num" dir="ltr">@(emp.Landline ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>محل کار</span><b>@(emp.Workplace ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>مدرک تحصیلی</span><b>@DegreeText</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>تماس اضطراری</span><b>@EmergencyText</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>حقوق پایه</span><b class="num">@Fa.Digits(emp.BaseSalary.ToString("N0")) ریال</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>تاریخ تولد</span><b class="num">@(emp.BirthDate?.ToFa() ?? "—")</b></div></div>
                <div class="col-md-3"><div class="hr-kv"><span>قرارداد فعال</span><b class="num">@(emp.ActiveContractNo ?? "—")</b></div></div>
            </div>
        </div>
    </div>

    @if (expiringDocs.Count > 0)
    {
        <div class="alert alert-warning d-flex align-items-center gap-2">
            <i class="bi bi-exclamation-triangle-fill fs-5"></i>
            <div class="flex-grow-1"><b>هشدار انقضای مدارک: </b>@ExpiringText</div>
            @if (canUpdate)
            {
                <button class="btn btn-sm btn-warning" @onclick="RemindDocs"><i class="bi bi-bell"></i> ارسال یادآور</button>
            }
        </div>
    }

    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-file-earmark-text text-primary ms-1"></i> قراردادها (@contracts.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenContract(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (contracts.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">قراردادی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>شماره</th><th>نوع</th><th>بازه</th><th>وضعیت</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var c in contracts)
                                {
                                    <tr>
                                        <td class="num">@c.ContractNo</td>
                                        <td>@HrCoreUi.EmpType(c.Type)</td>
                                        <td class="small num">@c.StartDate.ToFa() ← @(c.EndDate?.ToFa() ?? "دائمی")</td>
                                        <td>
                                            @if (!c.IsActive)
                                            {
                                                <span class="badge text-bg-secondary">غیرفعال</span>
                                            }
                                            else if (c.DaysToEnd is < 0)
                                            {
                                                <span class="badge text-bg-danger">منقضی</span>
                                            }
                                            else if (c.DaysToEnd is <= 30)
                                            {
                                                <span class="badge text-bg-warning">رو به پایان</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">معتبر</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenContract(c)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteContract(c.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-patch-check text-success ms-1"></i> احکام (@decrees.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenDecree(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (decrees.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">حکمی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>نوع حکم</th><th>اجرا از</th><th>وضعیت</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var d in decrees)
                                {
                                    <tr>
                                        <td><b>@HrCoreUi.DecreeType(d.Type)</b><div class="small text-muted num">شماره @d.DecreeNo</div></td>
                                        <td class="num">@d.EffectiveDate.ToFa()</td>
                                        <td>
                                            @if (d.IsApplied)
                                            {
                                                <span class="badge text-bg-success" title="@d.AppliedAt?.ToFa()">اجرا شده</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">در انتظار</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (!d.IsApplied && canUpdate)
                                            {
                                                <button class="btn btn-sm btn-primary py-0" title="اجرا روی پرونده" @onclick="() => ApplyDecree(d.Id)">اجرا</button>
                                            }
                                            @if (!d.IsApplied && canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenDecree(d)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (!d.IsApplied && canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteDecree(d.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="row g-3 mt-3">
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-people text-info ms-1"></i> افراد تحت‌تکفل (@dependents.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenDependent(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (dependents.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">موردی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>نام</th><th>نسبت</th><th>تاریخ تولد</th><th>وضعیت</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in dependents)
                                {
                                    <tr class="@(x.IsActive ? "" : "opacity-50")">
                                        <td><b>@x.FullName</b><div class="small text-muted num">@x.NationalCode</div></td>
                                        <td>@x.Relation</td>
                                        <td class="num">@(x.BirthDate?.ToFa() ?? "—")</td>
                                        <td>
                                            @if (x.IsActive)
                                            {
                                                <span class="badge text-bg-success">فعال</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-secondary">غیرفعال</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenDependent(x)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteDependent(x.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-mortarboard text-primary ms-1"></i> دوره‌های آموزشی (@courses.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenCourse(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (courses.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">موردی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>عنوان</th><th>سال</th><th>ساعت</th><th>گواهی</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in courses)
                                {
                                    <tr>
                                        <td><b>@x.Title</b><div class="small text-muted">@x.Institute</div></td>
                                        <td class="num">@(x.Year == null ? "—" : Fa.Digits(x.Year.Value))</td>
                                        <td class="num">@(x.DurationHours == null ? "—" : Fa.Digits(x.DurationHours.Value))</td>
                                        <td>
                                            @if (x.HasCertificate)
                                            {
                                                <span class="badge text-bg-success">دارد</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-light border">ندارد</span>
                                            }
                                        </td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenCourse(x)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteCourse(x.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-lightning-charge text-warning ms-1"></i> مهارت‌ها (@skills.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenSkill(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (skills.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">موردی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>مهارت</th><th>سطح</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in skills)
                                {
                                    <tr>
                                        <td><b>@x.Title</b></td>
                                        <td><span class="badge text-bg-primary">@HrCoreUi.SkillLevel(x.Level)</span></td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenSkill(x)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteSkill(x.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-translate text-success ms-1"></i> زبان‌های خارجی (@languages.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenLanguage(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (languages.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">موردی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>زبان</th><th>سطح</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in languages)
                                {
                                    <tr>
                                        <td><b>@x.Language</b></td>
                                        <td><span class="badge text-bg-success">@HrCoreUi.SkillLevel(x.Level)</span></td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenLanguage(x)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteLanguage(x.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
        <div class="col-12">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-header bg-white fw-bold d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-folder2-open text-secondary ms-1"></i> اسناد و مدارک (@documents.Count.Num())</span>
                    @if (canCreate)
                    {
                        <button class="btn btn-sm btn-success" @onclick="() => OpenDocument(null)"><i class="bi bi-plus-lg"></i></button>
                    }
                </div>
                <div class="card-body p-0">
                    @if (documents.Count == 0)
                    {
                        <div class="text-muted text-center py-3 small">سندی ثبت نشده است.</div>
                    }
                    else
                    {
                        <table class="table table-sm mb-0 align-middle">
                            <thead class="table-light"><tr><th>عنوان</th><th>صدور</th><th>انقضا</th><th>وضعیت</th><th>فایل</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var x in documents)
                                {
                                    <tr>
                                        <td><b>@x.Title</b><div class="small text-muted">@HrCoreUi.DocType(x.DocType)</div></td>
                                        <td class="num">@(x.IssueDate?.ToFa() ?? "—")</td>
                                        <td class="num">@(x.ExpiryDate?.ToFa() ?? "—")</td>
                                        <td>
                                            @if (x.IsExpired)
                                            {
                                                <span class="badge text-bg-danger">منقضی شده</span>
                                            }
                                            else if (x.IsExpiringSoon)
                                            {
                                                <span class="badge text-bg-warning">رو به پایان</span>
                                            }
                                            else if (x.ExpiryDate is null)
                                            {
                                                <span class="badge text-bg-light border">بدون انقضا</span>
                                            }
                                            else
                                            {
                                                <span class="badge text-bg-success">معتبر</span>
                                            }
                                        </td>
                                        <td>
                                            @if (!string.IsNullOrWhiteSpace(x.FileName))
                                            {
                                                <div class="small text-muted text-truncate" style="max-width:150px" title="@x.FileName">@x.FileName</div>
                                            }
                                            <div class="d-flex gap-1">
                                                @if (!string.IsNullOrWhiteSpace(x.FilePath))
                                                {
                                                    <button class="btn btn-sm btn-light py-0" title="دانلود" @onclick="() => DownloadDoc(x)"><i class="bi bi-download text-success"></i></button>
                                                }
                                                @if (canUpdate)
                                                {
                                                    <label class="btn btn-sm btn-light py-0 mb-0" title="آپلود فایل">
                                                        <i class="bi bi-upload text-primary"></i>
                                                        <InputFile OnChange="e => OnDocFileSelected(x.Id, e)" style="display:none" />
                                                    </label>
                                                }
                                            </div>
                                        </td>
                                        <td class="text-end">
                                            @if (canUpdate)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => OpenDocument(x)"><i class="bi bi-pencil"></i></button>
                                            }
                                            @if (canDelete)
                                            {
                                                <button class="btn btn-sm btn-light py-0" @onclick="() => DeleteDocument(x.Id)"><i class="bi bi-trash text-danger"></i></button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <AttachmentBox Module="HrEmployee" RefId="Id" CanUpload="@canUpdate" />
    </div>

}

<Modal Visible="showContract" Title="قرارداد" Size="modal-lg" OnClose="() => showContract = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-md-4"><label class="form-label">شماره قرارداد</label><input class="form-control num" @bind="cform.ContractNo" /></div>
            <div class="col-md-4">
                <label class="form-label">نوع</label>
                <select class="form-select" @bind="cform.Type">
                    <option value="0">رسمی</option><option value="1">قراردادی</option><option value="2">پیمانی</option>
                    <option value="3">ساعتی</option><option value="4">مشاوره‌ای</option>
                    <option value="5">تمام‌وقت</option><option value="6">پاره‌وقت</option>
                    <option value="7">پروژه‌ای</option><option value="8">آزمایشی</option>
                </select>
            </div>
