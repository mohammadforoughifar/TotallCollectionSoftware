</style>

@code {
    private bool FromHrMain => HrNavigation.Path(Nav.ToBaseRelativePath(Nav.Uri)).StartsWith("hr-main/employees/");
    private string EmployeeListUrl => FromHrMain ? "hr-main/employees" : "hr-core/employees";
    [Parameter] public int Id { get; set; }

    private bool canRead => Auth.Has("HrCore.Read") || Auth.IsAdmin;
    private bool canCreate => Auth.Has("HrCore.Create") || Auth.IsAdmin;
    private bool canUpdate => Auth.Has("HrCore.Update") || Auth.IsAdmin;
    private bool canDelete => Auth.Has("HrCore.Delete") || Auth.IsAdmin;

    private bool loading = true, saving, loadError;
    private HrEmployeeDto? emp;
    private List<HrContractDto> contracts = new();
    private List<HrDecreeDto> decrees = new();
    private List<HrOrgUnitDto> units = new();

    private List<HrEmployeeDependentDto> dependents = new();
    private List<HrEmployeeCourseDto> courses = new();
    private List<HrEmployeeSkillDto> skills = new();
    private List<HrEmployeeLanguageDto> languages = new();
    private List<HrEmployeeDocumentDto> documents = new();
    private List<HrEmployeeDocumentDto> expiringDocs = new();
    private string? photoUrl;

    private bool showContract, showDecree;
    private bool showDependent, showCourse, showSkill, showLanguage, showDocument;
    private int? cEditId, dEditId;
    private int? depEditId, crsEditId, sklEditId, lngEditId, docEditId;
    private HrEmployeeDependentSaveDto depform = new();
    private HrEmployeeCourseSaveDto crsform = new();
    private HrEmployeeSkillSaveDto sklform = new();
    private HrEmployeeLanguageSaveDto lngform = new();
    private HrEmployeeDocumentSaveDto docform = new();
    private DateTime? depBirth, docIssue, docExpiry;
    private HrContractSaveDto cform = new();
    private HrDecreeSaveDto dform = new();
    private DateTime? cStart, cEnd, dEff;

    protected override async Task OnParametersSetAsync()
    {
        if (!canRead) return;
        loading = true; loadError = false; emp = null;
        try
        {
            units = await Svc.GetOrgUnitsAsync();
            var dossier = await Svc.GetDossierAsync(Id);
            emp = dossier.Employee;
            dependents = dossier.Dependents;
            courses = dossier.Courses;
            skills = dossier.Skills;
            languages = dossier.Languages;
            documents = dossier.Documents;
            expiringDocs = dossier.ExpiringDocuments;
            contracts = await Svc.GetEmployeeContractsAsync(Id);
            decrees = await Svc.GetEmployeeDecreesAsync(Id);
            await LoadPhoto();
        }
        catch (Exception ex) { loadError = true; Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenContract(HrContractDto? c)
    {
        cEditId = c?.Id;
        cform = c is null
            ? new HrContractSaveDto { EmployeeId = Id, StartDate = DateTime.Today }
            : new HrContractSaveDto
            {
                EmployeeId = Id, ContractNo = c.ContractNo, Type = c.Type,
                StartDate = c.StartDate, EndDate = c.EndDate, BaseSalary = c.BaseSalary,
                JobTitle = c.JobTitle, OrgUnitId = c.OrgUnitId, Description = c.Description, IsActive = c.IsActive
            };
        cStart = cform.StartDate; cEnd = cform.EndDate;
        showContract = true;
    }

    private async Task SaveContract()
    {
        saving = true;
        try
        {
            cform.StartDate = cStart ?? DateTime.Today; cform.EndDate = cEnd;
            await Svc.SaveContractAsync(cEditId, cform);
            showContract = false;
            contracts = await Svc.GetEmployeeContractsAsync(Id);
            Toast.Success("قرارداد ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteContract(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "قرارداد حذف شود؟")) return;
        try { await Svc.DeleteContractAsync(id); contracts = await Svc.GetEmployeeContractsAsync(Id); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void OpenDecree(HrDecreeDto? d)
    {
        dEditId = d?.Id;
        dform = d is null
            ? new HrDecreeSaveDto { EmployeeId = Id, EffectiveDate = DateTime.Today }
            : new HrDecreeSaveDto
            {
                EmployeeId = Id, DecreeNo = d.DecreeNo, Type = d.Type, EffectiveDate = d.EffectiveDate,
                NewPostTitle = d.NewPostTitle, NewOrgUnitId = d.NewOrgUnitId,
                NewBaseSalary = d.NewBaseSalary, NewStatus = d.NewStatus, Description = d.Description
            };
        dEff = dform.EffectiveDate;
        showDecree = true;
    }

    private async Task SaveDecree()
    {
        saving = true;
        try
        {
            dform.EffectiveDate = dEff ?? DateTime.Today;
            await Svc.SaveDecreeAsync(dEditId, dform);
            showDecree = false;
            decrees = await Svc.GetEmployeeDecreesAsync(Id);
            Toast.Success("حکم ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task ApplyDecree(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حکم روی پرونده اعمال شود؟ این عمل برگشت‌ناپذیر است.")) return;
        try
        {
            await Svc.ApplyDecreeAsync(id);
            emp = await Svc.GetEmployeeAsync(Id);
            decrees = await Svc.GetEmployeeDecreesAsync(Id);
            Toast.Success("حکم اجرا شد و پرونده به‌روز شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteDecree(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "حکم حذف شود؟")) return;
        try { await Svc.DeleteDecreeAsync(id); decrees = await Svc.GetEmployeeDecreesAsync(Id); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ==================== پرونده: هلپرهای نمایشی ====================

    private string DegreeText =>
        string.IsNullOrWhiteSpace(emp?.Degree) ? "—"
        : string.IsNullOrWhiteSpace(emp.FieldOfStudy) ? emp.Degree! : $"{emp.Degree} — {emp.FieldOfStudy}";

    private string EmergencyText =>
        string.IsNullOrWhiteSpace(emp?.EmergencyContactName) ? "—"
        : emp.EmergencyContactName
            + (string.IsNullOrWhiteSpace(emp.EmergencyContactRelation) ? "" : $" ({emp.EmergencyContactRelation})")
            + (string.IsNullOrWhiteSpace(emp.EmergencyContactPhone) ? "" : $" — {emp.EmergencyContactPhone}");

    private async Task PrintDossier()
    {
        try
        {
            var f = await Svc.GetDossierPdfAsync(emp!.Id);
            await JS.InvokeVoidAsync("saveAsFile", f.FileName, System.Convert.ToBase64String(f.Data));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private bool showCertModal, certGenerating;
    private string? certPurpose;

    private async Task GenerateCertificate()
    {
        certGenerating = true;
        try
        {
            var f = await Svc.GetEmploymentCertificateAsync(emp!.Id, certPurpose);
            await JS.InvokeVoidAsync("saveAsFile", f.FileName, System.Convert.ToBase64String(f.Data));
            showCertModal = false;
            Toast.Success("گواهی اشتغال به کار صادر شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { certGenerating = false; }
    }

    private async Task RemindDocs()
    {
        try
        {
            var n = await Svc.RemindExpiringDocumentsAsync(30);
            Toast.Success(n == 0 ? "مدرک نیازمند یادآوری یافت نشد." : $"یادآور برای {n.Num()} نفر ارسال شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private string ExpiringText => string.Join("، ", expiringDocs.Select(d =>
        d.IsExpired ? $"{d.Title} (منقضی شده)" : $"{d.Title} ({Fa.Digits(d.DaysToExpiry ?? 0)} روز مانده)"));

    // ==================== عکس پروفایل ====================

    private async Task LoadPhoto()
    {
        photoUrl = null;
        if (string.IsNullOrWhiteSpace(emp?.PhotoPath)) return;
        try
        {
            var f = await Svc.GetEmployeePhotoAsync(Id);
            photoUrl = $"data:{f.ContentType};base64,{Convert.ToBase64String(f.Data)}";
        }
        catch { photoUrl = null; }
    }

    private async Task OnPhotoSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;
        if (file.Size > long.MaxValue) { Toast.Error("حداکثر حجم عکس ۵ مگابایت است."); return; }
        try
        {
            await using var stream = file.OpenReadStream(long.MaxValue);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;
            emp = await Svc.UploadEmployeePhotoAsync(Id, ms, file.Name, file.ContentType);
            await LoadPhoto();
            Toast.Success("عکس پروفایل به‌روز شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeletePhoto()
    {
        if (!await JS.InvokeAsync<bool>("confirm", "عکس پروفایل حذف شود؟")) return;
        try
        {
            emp = await Svc.DeleteEmployeePhotoAsync(Id);
            photoUrl = null;
            Toast.Success("عکس حذف شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ==================== تحت‌تکفل ====================

    private void OpenDependent(HrEmployeeDependentDto? x)
    {
        depEditId = x?.Id;
        depform = x is null
            ? new HrEmployeeDependentSaveDto()
            : new HrEmployeeDependentSaveDto
            {
                FullName = x.FullName, Relation = x.Relation,
                BirthDate = x.BirthDate, NationalCode = x.NationalCode, IsActive = x.IsActive
            };
        depBirth = depform.BirthDate;
        showDependent = true;
    }

    private async Task SaveDependent()
    {
        saving = true;
        try
        {
            depform.BirthDate = depBirth;
            await Svc.SaveDependentAsync(Id, depEditId, depform);
            showDependent = false;
            dependents = await Svc.GetDependentsAsync(Id);
            Toast.Success("ذخیره شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task DeleteDependent(int id)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "این فرد تحت‌تکفل حذف شود؟")) return;
        try { await Svc.DeleteDependentAsync(id); dependents = await Svc.GetDependentsAsync(Id); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ==================== دوره‌های آموزشی ====================

    private void OpenCourse(HrEmployeeCourseDto? x)
    {
        crsEditId = x?.Id;
        crsform = x is null
            ? new HrEmployeeCourseSaveDto()
            : new HrEmployeeCourseSaveDto
