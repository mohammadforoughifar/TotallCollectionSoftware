@* تایم‌لاین گرافیکی تغییرات — جایگزین لیست خشک (نودها + خط عمودی + کارت‌های diff) *@
@if (Entries == null || Entries.Count == 0)
{
    <div class="alert alert-info py-2 mb-0">
        <i class="bi bi-info-circle"></i> تغییری برای این سیستم ثبت نشده است.
    </div>
}
else
{
    <div class="ctimeline">
        @for (var i = 0; i < Entries.Count; i++)
        {
            var e = Entries[i];
            var latest = i == 0;
            var changedDiffs = e.Diffs.Where(x => x.Changed).ToList();
            <div class="ct-item @(latest ? "ct-latest" : "")">
                <span class="ct-dot">
                    <i class="bi @(latest ? "bi-lightning-charge-fill" : "bi-lightning")"></i>
                </span>
                <div class="ct-card">
                    <div class="ct-head">
                        <span class="ct-date"><i class="bi bi-calendar3"></i> @e.ChangedAt.ToFa() — @e.ChangedAt.ToString("HH:mm")</span>
                        <span class="badge bg-primary-subtle text-primary border ct-count">@e.ChangeCount تغییر</span>
                        @if (latest)
                        {
                            <span class="badge ct-latest-badge"><i class="bi bi-arrow-repeat"></i> آخرین به‌روزرسانی</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(e.AgentId))
                        {
                            <span class="badge bg-light text-dark border" dir="ltr">@e.AgentId</span>
                        }
                    </div>
                    @if (changedDiffs.Count > 0)
                    {
                        <div class="ct-diffs">
                            @foreach (var d in changedDiffs)
                            {
                                <div class="ct-diff">
                                    <span class="ct-field">@d.Field</span>
                                    <span class="ct-old" dir="auto">@(d.Old ?? "—")</span>
                                    <i class="bi bi-arrow-left ct-arrow"></i>
                                    <span class="ct-val-new" dir="auto">@(d.New ?? "—")</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="ct-empty"><i class="bi bi-dash-lg"></i> قطعه‌ای تغییر نکرده بود — تنها زمان دریافت به‌روز شد</div>
                    }
                </div>
            </div>
        }
    </div>
}

<style>
.ctimeline{position:relative;padding-bottom:.25rem;}
.ct-item{position:relative;padding:0 2.7rem 1.15rem 0;}
.ct-item:last-child{padding-bottom:.15rem;}
.ctimeline::before{content:"";position:absolute;right:12px;top:12px;bottom:14px;width:3px;border-radius:3px;background:linear-gradient(180deg,#8e5cff 0%,#a983ff 55%,#ddd2f7 100%);}
.ct-dot{position:absolute;right:0;top:0;width:27px;height:27px;border-radius:50%;background:#fff;border:3px solid #8e5cff;display:flex;align-items:center;justify-content:center;font-size:.72rem;color:#6d4dff;box-shadow:0 0 0 4px rgba(142,92,255,.14);z-index:1;transition:transform .15s ease;}
.ct-item:hover .ct-dot{transform:scale(1.12);}
.ct-latest .ct-dot{border-color:#2ec47e;color:#0e8a55;animation:ctPulse 1.9s infinite;}
@@keyframes ctPulse{0%{box-shadow:0 0 0 0 rgba(46,196,126,.45);}70%{box-shadow:0 0 0 9px rgba(46,196,126,0);}100%{box-shadow:0 0 0 0 rgba(46,196,126,0);}}
.ct-card{background:#fff;border:1px solid #e5e8f4;border-radius:13px;padding:.65rem 1rem .7rem;box-shadow:0 2px 10px rgba(45,55,110,.07);transition:all .15s ease;}
.ct-item:hover .ct-card{border-color:#c9b8ff;box-shadow:0 5px 16px rgba(120,90,255,.16);}
.ct-head{display:flex;flex-wrap:wrap;align-items:center;gap:.5rem;margin-bottom:.35rem;}
.ct-date{font-weight:800;color:#1c2130;font-size:.87rem;}
.ct-date .bi{color:#8e5cff;margin-inline-end:.3rem;font-size:.8rem;}
.ct-count{font-weight:800;}
.ct-latest-badge{background:linear-gradient(135deg,#2ec47e,#0ea5a4);color:#fff;font-weight:800;border:none;animation:ctBadgeGlow 2.2s infinite;}
@@keyframes ctBadgeGlow{0%,100%{box-shadow:0 1px 4px rgba(14,165,164,.35);}50%{box-shadow:0 2px 10px rgba(14,165,164,.6);}}
.ct-diffs{margin-top:.3rem;}
.ct-diff{display:flex;flex-wrap:wrap;align-items:center;gap:.45rem;padding:.32rem 0;font-size:.85rem;border-top:1px dashed #edf0f8;}
.ct-diff:first-child{border-top:none;padding-top:.1rem;}
.ct-field{font-weight:800;color:#3c4358;min-width:118px;font-size:.82rem;}
.ct-old{color:#98a0b3;text-decoration:line-through;word-break:break-word;font-size:.83rem;}
.ct-arrow{color:#8e5cff;font-size:.72rem;}
.ct-val-new{color:#0e8a55;font-weight:800;word-break:break-word;font-size:.83rem;}
.ct-empty{font-size:.8rem;color:#8a90a5;padding-top:.25rem;font-weight:600;}
@@media (max-width: 575.98px){
    .ct-item{padding:0 2.3rem 1rem 0;}
    .ct-field{min-width:100%;}
}
</style>

@code {
    [Parameter] public List<TimelineEntry>? Entries { get; set; }

    /// <summary>یک ورودی تایم‌لاین (جدیدترین اول).</summary>
    public class TimelineEntry
    {
        public int Id { get; set; }
        public DateTime ChangedAt { get; set; }
        public int ChangeCount { get; set; }
        public string? AgentId { get; set; }
        public List<TimelineDiff> Diffs { get; set; } = new();
    }

    public class TimelineDiff
    {
        public string Field { get; set; } = "";
        public string? Old { get; set; }
        public string? New { get; set; }
        public bool Changed { get; set; }
    }
}
