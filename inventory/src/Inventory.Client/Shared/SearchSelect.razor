@inject ApiOptions ApiCfg
@inject IJSRuntime JS

@code {
    private string Dflt => (ApiCfg?.BaseUrl ?? "").TrimEnd('/') + "/uploads/users/default.jpg";
    private readonly string _uniqueId = Guid.NewGuid().ToString("N").Substring(0, 8);
}

<div class="ss">
    <input type="text"
           class="form-control @CssClass"
           value="@query"
           placeholder="@Placeholder"
           @ref="_input"
           @onfocus="OnFocus"
           @oninput="OnInput"
           @onkeydown="OnKeyDown"
           @onfocusout="OnBlur" />

    @if (AllowClear && Value > 0)
    {
        @* دکمه پاک کردن انتخاب — در فیلترهای بالا و فرم‌ها، انتخاب اشتباه سریع قابل حذف است *@
        <button type="button" class="ss-clear" title="پاک کردن انتخاب" tabindex="-1"
                @onclick="ClearSelection" @onclick:stopPropagation="true">
            <i class="bi bi-x-lg"></i>
        </button>
    }

    @if (open)
    {
        @* پوشش نامرئی تمام‌صفحه — کلیک بیرون منو را می‌بندد؛ منوی fixed هیچ‌گاه زیر کارت‌ها نمی‌رود *@
        <div class="pop-overlay" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
        <div class="ss-menu" style="@MenuStyle" @onclick:stopPropagation="true">
            @if (filtered.Count == 0)
            {
                <div class="ss-empty">موردی یافت نشد</div>
            }
            else
            {
                @for (var i = 0; i < filtered.Count; i++)
                {
                    var idx = i;
                    var it = filtered[idx];
                    var isSelected = it.Id == Value;
                    var isHighlighted = idx == highlightIndex;
                    <div id="@($"ss-opt-{_uniqueId}-{idx}")"
                         class="ss-item @(isSelected ? "selected" : "") @(isHighlighted ? "highlighted" : "")"
                         @onmousedown="@(() => Select(it))"
                         @onmousedown:preventDefault="true"
                         @onmouseover="@(() => highlightIndex = idx)">
                        @if (!string.IsNullOrWhiteSpace(it.AvatarUrl))
                        {
                            <img class="user-avatar user-avatar-sm" src="@it.AvatarUrl" alt="" onerror="this.onerror=null;this.src='@Dflt';" />
                        }
                        <span class="ss-item-name">@it.Name</span>
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<LookupItem> Items { get; set; } = new();
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "انتخاب کنید…";
    [Parameter] public string CssClass { get; set; } = "";

    /// <summary>نمایش دکمه «پاک کردن» وقتی مقداری انتخاب شده است (پیش‌فرض: فعال)</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    private string query = "";
    private bool open;
    private int highlightIndex = 0;

    /// <summary>پاک کردن انتخاب فعلی — مقدار صفر (هیچ) به والد برمی‌گردد</summary>
    private async Task ClearSelection()
    {
        query = "";
        open = false;
        highlightIndex = 0;
        if (Value != 0)
        {
            Value = 0;
            await ValueChanged.InvokeAsync(0);
        }
    }

    private ElementReference _input;
    private double _mTop, _mLeft, _mWidth;

    /// <summary>منو با position:fixed هم‌عرض ورودی زیر آن باز می‌شود (الگوی منوی شناور) —
    /// مصون از stacking context کارت‌ها و overflow جدول/مودال</summary>
    private string MenuStyle => Popover.FixedStyle(_mTop, _mLeft, _mWidth);

    private List<LookupItem> filtered
    {
        get
        {
            if (string.IsNullOrWhiteSpace(query)) return Items;
            return Items.Where(i => i.Name.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override void OnParametersSet()
    {
        if (Value > 0 && string.IsNullOrEmpty(query))
        {
            var sel = Items.FirstOrDefault(i => i.Id == Value);
            if (sel is not null) query = sel.Name;
        }
        if (Value == 0 && !string.IsNullOrEmpty(query) && !focused)
        {
            // مقدار پاک شده — فقط در صورت عدم فوکوس
            var exists = Items.Any(i => i.Name == query);
            if (!exists) query = "";
        }
    }

    private bool focused;

    private async Task OnFocus()
    {
        focused = true;
        await OpenMenu();
        highlightIndex = 0;
        if (Value > 0)
        {
            var sel = Items.FirstOrDefault(i => i.Id == Value);
            if (sel is not null)
            {
                query = sel.Name;
                var idx = filtered.FindIndex(i => i.Id == Value);
                if (idx >= 0) highlightIndex = idx;
            }
        }
    }

    private async Task OpenMenu()
    {
        try
        {
            var r = await JS.InvokeAsync<UiRect>("uiRect", _input);
            (_mTop, _mLeft, _mWidth) = Popover.Below(r);
        }
        catch (JSException) { }
        open = true;
    }

    private void CloseMenu() => open = false;

    private async Task OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        highlightIndex = 0;
        if (!open) await OpenMenu();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!open)
        {
            if (e.Key is "ArrowDown" or "ArrowUp")
            {
                await OpenMenu();
                highlightIndex = 0;
                return;
            }
            return;
        }

        if (filtered.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            if (highlightIndex < filtered.Count - 1)
                highlightIndex++;
            else
                highlightIndex = 0;

            await ScrollHighlightedIntoView();
        }
        else if (e.Key == "ArrowUp")
        {
            if (highlightIndex > 0)
                highlightIndex--;
            else
                highlightIndex = filtered.Count - 1;

            await ScrollHighlightedIntoView();
        }
        else if (e.Key == "Enter")
        {
            if (highlightIndex >= 0 && highlightIndex < filtered.Count)
            {
                await Select(filtered[highlightIndex]);
            }
        }
        else if (e.Key == "Escape")
        {
            CloseMenu();
        }
    }

    private async Task ScrollHighlightedIntoView()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollIntoViewById", $"ss-opt-{_uniqueId}-{highlightIndex}");
        }
        catch { }
    }

    private async Task OnBlur()
    {
        focused = false;
        await Task.Delay(160);
        open = false;
        // اگر متن انتخابی مطابق نیست، برگرد به نام گزینه انتخاب‌شده
        var sel = Items.FirstOrDefault(i => i.Id == Value);
        query = sel?.Name ?? "";
    }

    private async Task Select(LookupItem item)
    {
        query = item.Name;
        open = false;
        if (Value != item.Id)
        {
            Value = item.Id;
            await ValueChanged.InvokeAsync(item.Id);
        }
    }
}
