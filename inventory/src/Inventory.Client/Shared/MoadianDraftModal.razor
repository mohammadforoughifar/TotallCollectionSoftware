@inject IMoadianClientService MoadianSvc
@inject IToastService Toast

<Modal Visible="@Visible" Title="@ModalTitle" Size="modal-xl" OnClose="CloseAsync">
    <ChildContent>
        @if (loadingRefs)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status"></div>
                <div class="small text-muted mt-2">در حال بارگذاری دوره‌ها، شناسه‌ها و تنظیمات فروشنده...</div>
            </div>
        }
        else if (Draft is null)
        {
            <div class="alert alert-warning mb-0">پیش‌نویسی برای بازبینی انتخاب نشده است.</div>
        }
        else if (Draft.Status != MoadianInvoiceStatus.Draft)
        {
            <div class="alert alert-warning mb-0">این فاکتور دیگر در وضعیت پیش‌نویس نیست و از این فرم قابل ویرایش نیست.</div>
        }
        else
        {
            <div class="moadian-review-scroll" dir="rtl">
                <div class="moadian-review-hero mb-3">
                    <div class="d-flex flex-wrap align-items-center gap-3">
                        <div class="moadian-review-hero-icon"><i class="bi bi-clipboard2-check"></i></div>
                        <div class="flex-grow-1">
                            <div class="small fw-semibold text-primary mb-1">بازبینی مرحله‌به‌مرحله</div>
                            <h5 class="mb-1">پیش‌نویس شماره @Draft.Number</h5>
                        </div>
                        <div class="moadian-review-counts">
                            <span class="badge bg-success">تأیید محلی: @PassedCheckCount</span>
                            <span class="badge bg-warning text-dark">نیازمند بررسی: @WarningCheckCount</span>
                            <span class="badge bg-danger">مانع ارسال: @BlockedCheckCount</span>
                        </div>
                    </div>
                    <div class="moadian-review-flow mt-3">
                        <span><i class="bi bi-1-circle-fill"></i> تکمیل اطلاعات</span>
                        <i class="bi bi-chevron-left text-muted"></i>
                        <span><i class="bi bi-2-circle-fill"></i> بازبینی</span>
                        <i class="bi bi-chevron-left text-muted"></i>
                        <span class="text-muted"><i class="bi bi-3-circle"></i> ارسال دستی — فعلاً غیرفعال</span>
                    </div>
                </div>

                <div class="alert alert-info d-flex gap-2 align-items-start py-2 small mb-2">
                    <i class="bi bi-info-circle-fill mt-1"></i>
                    <div>
                        <strong>این صفحه برای پیش‌نویس و بازبینی است.</strong>
                        ارسال واقعی یا خودکار در این نسخه فعال نیست. کنترل‌های سبز فقط داده‌های موجود در برنامه را بررسی می‌کنند؛
                        مواردی که به الگو/فیلدهای رسمی یا دسترسی سامانه نیاز دارند، صریحاً به‌عنوان مانع یا نیازمند بررسی نمایش داده می‌شوند.
                    </div>
                </div>
                @if (Draft.HasDuplicateNumberAcrossPeriods == true)
                {
                    <div class="alert alert-danger py-2 small mb-2">
                        <i class="bi bi-exclamation-octagon-fill"></i>
                        <strong>شمارهٔ داخلی تکراری در دوره‌های مختلف:</strong> شمارهٔ این سابقه با فاکتور دیگری مشترک است. شمارهٔ تاریخی تغییر نمی‌کند و تا بازبینی، برای استفاده به‌عنوان سریال حافظه/`inno` تأیید نیست.
                    </div>
                }
                <div class="moadian-field-semantics small mb-3">
                    <i class="bi bi-tags"></i>
                    <span><b>وضعیت فیلد در قواعد رسمی:</b> «اجباری»، «اختیاری»، «مشروط» و «Ignore» با هم فرق دارند؛ Ignore را اختیاری حساب نمی‌کنیم. الزام دقیق باید با نوع، الگو و موضوع همان صورتحساب تطبیق داده شود.</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(referenceLoadError))
                {
                    <div class="alert alert-warning py-2 small">
                        <i class="bi bi-exclamation-triangle"></i>
                        بخشی از اطلاعات مرجع بارگذاری نشد؛ کنترل‌های وابسته به آن قطعی نیستند. @referenceLoadError
                    </div>
                }

                <section class="moadian-review-section mb-3">
                    <div class="moadian-section-heading">
                        <span class="moadian-section-number">۱</span>
                        <div>
                            <h6 class="mb-0">مشخصات صورتحساب</h6>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small">جهت سند داخلی</label>
                            <select class="form-select" @bind="New.Kind">
                                @foreach (var k in KindOptions)
                                {
                                    <option value="@k.Key">@k.Value</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small">نوع صورتحساب (inty) <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="New.InvoiceType">
                                <option value="Unselected">— نوع ۱ یا ۲ را انتخاب کنید —</option>
                                <option value="Type1">نوع ۱ — اطلاعات خریدار طبق الگو</option>
                                <option value="Type2">نوع ۲ — اطلاعات خریدار معمولاً اختیاری</option>
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small">الگوی صورتحساب (inp) <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="New.InvoicePattern">
                                <option value="Unselected">— ابتدا نوع صورتحساب را انتخاب کنید —</option>
                                @if (New.InvoicePattern != MoadianInvoicePattern.Unselected && !MoadianInvoiceRules.IsPatternAllowed(New.InvoiceType, New.InvoicePattern))
                                {
                                    <option value="@New.InvoicePattern">@((int)New.InvoicePattern) — @MoadianInvoiceRules.PatternTitle(New.InvoicePattern) (ناسازگار با نوع انتخاب‌شده)</option>
                                }
                                @foreach (var pattern in MoadianInvoiceRules.AvailablePatterns(New.InvoiceType))
                                {
                                    <option value="@pattern">الگوی @((int)pattern) — @MoadianInvoiceRules.PatternTitle(pattern)</option>
                                }
                            </select>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <label class="form-label small">موضوع صورتحساب (ins) <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="New.InvoiceSubject">
                                <option value="Unselected">— موضوع را انتخاب کنید —</option>
                                @if (New.InvoiceSubject != MoadianInvoiceSubject.Unselected && !MoadianInvoiceRules.IsSubjectAllowed(New.InvoicePattern, New.InvoiceSubject))
                                {
                                    <option value="@New.InvoiceSubject">@((int)New.InvoiceSubject) — @MoadianInvoiceRules.SubjectTitle(New.InvoiceSubject) (ناسازگار با الگو)</option>
                                }
                                @foreach (var subject in MoadianInvoiceRules.AvailableSubjects(New.InvoicePattern))
                                {
                                    <option value="@subject">موضوع @((int)subject) — @MoadianInvoiceRules.SubjectTitle(subject)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">تاریخ صدور <span class="text-danger">*</span></label>
                            <DatePicker Value="@((DateTime?)New.Date)" ValueChanged="OnInvoiceDateChanged" MinYear="1390" MaxYear="1430" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">زمان صدور (indatim) <span class="text-danger">*</span></label>
                            <TimeInput Value="@IssueTime" ValueChanged="OnIssueTimeChanged" Suffix="زمان محلی ثبت‌شده برای صورتحساب" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">دوره مالیاتی <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="New.FiscalPeriodId">
                                <option value="0">— انتخاب کنید —</option>
                                @foreach (var p in periods)
                                {
                                    <option value="@p.Id">@p.Title@(p.IsClosed ? " (بسته)" : "")</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">روش تسویه ثبت‌شده</label>
                            <input class="form-control" @bind="New.Settlement" @bind:event="oninput" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">توضیحات</label>
                            <input class="form-control" @bind="New.Description" @bind:event="oninput" />
                        </div>
                        <div class="col-md-6">
                            @if (MoadianInvoiceRules.RequiresReference(New.InvoiceSubject) || !string.IsNullOrWhiteSpace(New.ReferenceTaxId))
                            {
                                <label class="form-label small">شناسهٔ مالیاتی صورتحساب مرجع <span class="text-danger">@(MoadianInvoiceRules.RequiresReference(New.InvoiceSubject) ? "*" : "")</span></label>
                                <input class="form-control" dir="ltr" maxlength="22" @bind="New.ReferenceTaxId" @bind:event="oninput" placeholder="شناسهٔ ۲۲ نویسه‌ای صورتحساب مرجع" />
                            }
                            else
                            {
                                <div class="moadian-field-hint h-100"><i class="bi bi-link-45deg"></i><span>شناسه مرجع فقط برای موضوع‌های اصلاحی، ابطالی یا برگشت از فروش وارد می‌شود.</span></div>
                            }
                        </div>
                        <div class="col-md-6">
                            <div class="moadian-separation-note small h-100">
                                <i class="bi bi-diagram-3"></i>
                                <span><b>نوع</b> (inty)، <b>الگو</b> (inp) و <b>موضوع</b> (ins) سه فیلد مستقل و جداگانه ذخیره می‌شوند. «جهت سند داخلی» هم با هیچ‌کدام از آن‌ها یکی نیست.</span>
                            </div>
                        </div>
                    </div>
                </section>

                <section class="moadian-review-section mb-3">
                    <div class="moadian-section-heading">
                        <span class="moadian-section-number">۲</span>
                        <div>
                            <h6 class="mb-0">اطلاعات خریدار</h6>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-md-3">
                            <label class="form-label small">شناسه مالیاتی/ملی خریدار</label>
                            <input class="form-control" dir="ltr" inputmode="numeric" @bind="New.BuyerTaxId" @bind:event="oninput" placeholder="فقط ارقام" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small">نام خریدار</label>
                            <input class="form-control" @bind="New.BuyerName" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">کد پستی</label>
                            <input class="form-control" dir="ltr" inputmode="numeric" @bind="New.BuyerPostalCode" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">تلفن</label>
                            <input class="form-control" dir="ltr" inputmode="tel" @bind="New.BuyerPhone" @bind:event="oninput" />
                        </div>
                        <div class="col-md-2">
                            <label class="form-label small">نشانی</label>
                            <input class="form-control" @bind="New.BuyerAddress" @bind:event="oninput" />
                        </div>
                    </div>
                </section>

                <section class="moadian-review-section mb-3">
                    <div class="moadian-section-heading">
                        <span class="moadian-section-number">۳</span>
                        <div>
                            <h6 class="mb-0">اقلام، شناسه و مالیات</h6>
                        </div>
                        <div class="ms-auto d-flex gap-2">
                            <button class="btn btn-sm btn-outline-primary" @onclick="AddLine"><i class="bi bi-plus-lg"></i> افزودن قلم</button>
                            <button class="btn btn-sm btn-outline-secondary" @onclick="RemoveLast" disabled="@(New.Lines.Count <= 1)"><i class="bi bi-dash-lg"></i> حذف آخر</button>
                        </div>
                    </div>
                    <div class="table-responsive mt-3">
                        <table class="table table-sm table-hover align-middle moadian-line-table">
                            <thead>
                                <tr>
                                    <th style="min-width:190px">شناسه کالا/خدمت</th>
                                    <th style="min-width:160px">شرح</th>
                                    <th style="min-width:150px">واحد مالیاتی</th>
                                    <th style="min-width:95px">تعداد</th>
                                    <th style="min-width:120px">فی (ریال)</th>
                                    <th style="min-width:100px">تخفیف</th>
                                    <th style="min-width:85px">مالیات ٪</th>
                                    <th style="min-width:115px">مبلغ مالیات</th>
                                    <th style="min-width:120px">جمع ردیف</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var l in New.Lines)
                                {
                                    <tr>
                                        <td>
                                            <input class="form-control form-control-sm mb-1" dir="ltr" inputmode="numeric" @bind="l.SstId" @bind:event="oninput" placeholder="کد مالیاتی" />
                                            <select class="form-select form-select-sm" value="@l.SstId" @onchange="@(e => ApplyCpc(l, e.Value?.ToString() ?? string.Empty))">
                                                <option value="">انتخاب از فهرست داخلی</option>
                                                @foreach (var c in cpcList.Where(x => x.IsActive))
                                                {
                                                    <option value="@c.Code">@c.Code — @c.Title</option>
                                                }
                                            </select>
                                        </td>
                                        <td><input class="form-control form-control-sm" @bind="l.SstTitle" @bind:event="oninput" /></td>
                                        <td><input class="form-control form-control-sm" dir="ltr" @bind="l.UnitCode" @bind:event="oninput" placeholder="کد واحد" /></td>
                                        <td><input class="form-control form-control-sm text-end num" inputmode="decimal" @bind="l.Quantity" @bind:event="oninput" @bind:after="() => RecalcLine(l)" /></td>
                                        <td><input class="form-control form-control-sm text-end num" inputmode="decimal" @bind="l.UnitPrice" @bind:event="oninput" @bind:after="() => RecalcLine(l)" /></td>
                                        <td><input class="form-control form-control-sm text-end num" inputmode="decimal" @bind="l.Discount" @bind:event="oninput" @bind:after="() => RecalcLine(l)" /></td>
                                        <td><input class="form-control form-control-sm text-end num" inputmode="decimal" @bind="l.VatRate" @bind:event="oninput" @bind:after="() => RecalcLine(l)" /></td>
                                        <td class="text-end num">@l.VatAmount.Money()</td>
                                        <td class="text-end num fw-semibold">@l.Total.Money()</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="row g-2">
                        <div class="col-6 col-lg-3">
                            <div class="moadian-total-tile"><span>تعداد کل</span><strong class="num">@New.Lines.Sum(x => x.Quantity).Num()</strong></div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="moadian-total-tile"><span>مأخذ پس از تخفیف</span><strong class="num">@New.Lines.Sum(x => x.Taxable).Money()</strong></div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="moadian-total-tile"><span>مالیات ردیف‌ها</span><strong class="num">@New.Lines.Sum(x => x.VatAmount).Money()</strong></div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="moadian-total-tile moadian-total-highlight"><span>جمع نهایی محلی</span><strong class="num">@New.Lines.Sum(x => x.Total).Money()</strong></div>
                        </div>
                    </div>
                </section>

                <section class="moadian-preflight mb-2">
                    <div class="d-flex flex-wrap align-items-start gap-3">
                        <div class="moadian-preflight-icon"><i class="bi bi-shield-check"></i></div>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">۴. چک‌لیست پیش از ارسال</h6>
                            <div class="small text-muted">کنترل‌ها دسته‌بندی شده‌اند تا مورد ناقص با مورد اختیاری اشتباه نشود.</div>
                        </div>
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => showDetailedChecks = !showDetailedChecks">
                            <i class="bi @(showDetailedChecks ? "bi-chevron-up" : "bi-list-check")"></i>
                            @(showDetailedChecks ? "پنهان‌کردن جزئیات" : "نمایش همه بررسی‌ها")
                        </button>
                    </div>

                    <div class="moadian-status-legend small mt-3">
                        <span><i class="bi bi-check-circle-fill text-success"></i> دادهٔ موجود بررسی شد</span>
                        <span><i class="bi bi-exclamation-circle-fill text-warning"></i> به تطبیق یا تأیید انسانی نیاز دارد</span>
                        <span><i class="bi bi-x-circle-fill text-danger"></i> داده/قابلیت لازم در فرم فعلی موجود نیست</span>
                        <span><i class="bi bi-dash-circle text-secondary"></i> فعلاً کاربرد ندارد</span>
                    </div>

                    @if (showDetailedChecks)
                    {
                        <div class="row g-3 mt-2">
                            @foreach (var group in ValidationGroups)
                            {
                                <div class="col-xl-6">
                                    <div class="moadian-check-group h-100">
                                        <div class="d-flex align-items-center gap-2 mb-2">
                                            <i class="bi @group.Icon text-primary"></i>
                                            <strong class="flex-grow-1">@group.Title</strong>
                                            <span class="badge @CheckGroupBadgeClass(group)">@CheckGroupStatusLabel(group)</span>
                                        </div>
                                        @foreach (var check in group.Items)
                                        {
                                            <div class="moadian-check-row">
                                                <i class="bi @CheckIcon(check.State) @CheckIconTone(check.State)"></i>
                                                <div>
                                                    <div class="small fw-semibold">@check.Title</div>
                                                    <div class="small text-muted">@check.Detail</div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                        <div class="alert alert-warning small mt-3 mb-0">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <strong>مرز اعتبارسنجی:</strong> نوع (inty)، الگو (inp) و موضوع (ins) جدا ذخیره می‌شوند و شناسه مرجع هم برای موضوع‌های ارجاعی ثبت می‌شود؛ اما این فرم هنوز وجود/وضعیت رسمی صورتحساب مرجع را استعلام نمی‌کند.
                            نوع شخص خریدار، تفکیک مبلغ نقد/نسیه و جزئیات اختصاصی هر الگو هنوز در مدل نیستند. فهرست CPC نیز داخلی است و رسمی/به‌روز بودن آن از اینجا قابل اثبات نیست.
                        </div>
                    }
                </section>
            </div>
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-primary" @onclick="SaveDraft" disabled="@(saving || Draft is null || Draft.Status != MoadianInvoiceStatus.Draft)">
            <i class="bi bi-save"></i> @(saving ? "در حال ذخیره..." : "ذخیره پیش‌نویس")
        </button>
        <button type="button" class="btn btn-success" disabled title="ارسال واقعی تا تکمیل الگوی رسمی، تأیید گواهی/دسترسی و فعال‌سازی مجازِ اتصال غیرفعال است.">
            <i class="bi bi-send"></i> ارسال به سامانه (فعلاً غیرفعال)
        </button>
        <button class="btn btn-light" @onclick="CloseAsync">انصراف</button>
    </Footer>
</Modal>

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public MoadianInvoice? Draft { get; set; }

    private List<MoadianFiscalPeriod> periods = new();
    private List<MoadianCpc> cpcList = new();
    private MoadianSetting? setting;
    private MoadianInvoiceRequest New = new();
    private TimeOnly IssueTime => TimeOnly.FromDateTime(New.Date == default ? DateTime.Now : New.Date);
    private bool saving;
    private bool loadingRefs;
    private bool refsLoaded;
    private bool showDetailedChecks;
    private int? loadedDraftId;
    private string? referenceLoadError;

    private string ModalTitle => Draft is null
        ? "بازبینی پیش‌نویس سامانه مؤدیان"
        : $"بازبینی پیش‌نویس مودیان — شماره {Draft.Number}";

    private readonly Dictionary<MoadianInvoiceKind, string> KindOptions = new()
    {
        [MoadianInvoiceKind.Sale] = "فروش",
        [MoadianInvoiceKind.SaleReturn] = "برگشت از فروش",
        [MoadianInvoiceKind.Purchase] = "خرید",
        [MoadianInvoiceKind.PurchaseReturn] = "برگشت از خرید",
        [MoadianInvoiceKind.Proforma] = "پیش‌فاکتور"
    };

    private enum CheckState { Passed, Warning, Blocked, Info }
    private sealed record CheckItem(string Title, string Detail, CheckState State);
    private sealed record CheckGroup(string Title, string Icon, List<CheckItem> Items);

    private List<CheckGroup> ValidationGroups => BuildValidationGroups();
    private int PassedCheckCount => ValidationGroups.SelectMany(g => g.Items).Count(x => x.State == CheckState.Passed);
    private int WarningCheckCount => ValidationGroups.SelectMany(g => g.Items).Count(x => x.State == CheckState.Warning);
    private int BlockedCheckCount => ValidationGroups.SelectMany(g => g.Items).Count(x => x.State == CheckState.Blocked);

    protected override async Task OnParametersSetAsync()
    {
        if (!Visible || Draft is null || Draft.Id <= 0 || Draft.Id == loadedDraftId)
            return;

        loadedDraftId = Draft.Id;
        showDetailedChecks = false;
        referenceLoadError = null;
        setting = null;

        if (!refsLoaded)
        {
            loadingRefs = true;
            try
            {
                periods = await MoadianSvc.GetPeriodsAsync();
                cpcList = await MoadianSvc.GetCpcAsync();
                setting = await MoadianSvc.GetSettingAsync();
                refsLoaded = true;
            }
            catch (Exception ex)
            {
                referenceLoadError = ex.Message;
                Toast.Error("بارگذاری بخشی از اطلاعات مرجع مودیان ناموفق بود.");
            }
            finally
            {
                loadingRefs = false;
            }
        }

        LoadDraft(Draft);
    }

    private void LoadDraft(MoadianInvoice invoice)
    {
        if (invoice.Status != MoadianInvoiceStatus.Draft)
            return;

        New = new MoadianInvoiceRequest
        {
            Id = invoice.Id,
            Kind = invoice.Kind,
            InvoiceType = invoice.InvoiceType,
            InvoicePattern = invoice.InvoicePattern,
            InvoiceSubject = invoice.InvoiceSubject,
            ReferenceTaxId = invoice.ReferenceTaxId,
            Date = invoice.Date,
            FiscalPeriodId = invoice.FiscalPeriodId,
            BuyerTaxId = invoice.BuyerTaxId,
            BuyerName = invoice.BuyerName,
            BuyerAddress = invoice.BuyerAddress,
            BuyerPostalCode = invoice.BuyerPostalCode,
            BuyerPhone = invoice.BuyerPhone,
            Settlement = invoice.Settlement,
            Description = invoice.Description,
            Lines = invoice.Lines.Select(l => new MoadianInvoiceLine
            {
                RowNo = l.RowNo,
                SstId = l.SstId,
                UnitCode = l.UnitCode,
                SstTitle = l.SstTitle,
                Quantity = l.Quantity,
                UnitPrice = l.UnitPrice,
                Discount = l.Discount,
                VatRate = l.VatRate,
                VatAmount = l.VatAmount,
                Total = l.Total
            }).ToList()
        };

        if (New.Lines.Count == 0)
            New.Lines.Add(NewLine());
    }

    private static MoadianInvoiceLine NewLine() => new()
    {
        RowNo = 1,
        SstId = "",
        UnitCode = "",
        SstTitle = "",
        Quantity = 1,
        VatRate = 0
    };

    private void AddLine()
    {
        var line = NewLine();
        line.RowNo = New.Lines.Count + 1;
        New.Lines.Add(line);
    }

    private void RemoveLast()
    {
        if (New.Lines.Count <= 1)
            return;

        New.Lines.RemoveAt(New.Lines.Count - 1);
        for (var i = 0; i < New.Lines.Count; i++)
            New.Lines[i].RowNo = i + 1;
    }

    private void OnInvoiceDateChanged(DateTime? date)
    {
        if (!date.HasValue) return;
        var currentTime = TimeOnly.FromDateTime(New.Date == default ? DateTime.Now : New.Date);
        New.Date = date.Value.Date.Add(currentTime.ToTimeSpan());
    }

    private void OnIssueTimeChanged(TimeOnly time)
    {
        var issueDate = New.Date == default ? DateTime.Now.Date : New.Date.Date;
        New.Date = issueDate.Add(time.ToTimeSpan());
    }

    private void RecalcLine(MoadianInvoiceLine line)
    {
        line.VatAmount = Math.Round(line.Taxable * line.VatRate / 100m, 2, MidpointRounding.AwayFromZero);
        line.Total = line.Taxable + line.VatAmount;
    }

    private void RecalcAll()
    {
        foreach (var line in New.Lines)
            RecalcLine(line);
    }

    private void ApplyCpc(MoadianInvoiceLine line, string code)
    {
        var cpc = cpcList.FirstOrDefault(x => x.Code == code && x.IsActive);
        if (cpc is null)
            return;

        line.SstId = cpc.Code;
        if (string.IsNullOrWhiteSpace(line.UnitCode))
            line.UnitCode = cpc.Unit;
        if (string.IsNullOrWhiteSpace(line.SstTitle))
            line.SstTitle = cpc.Title;
    }

