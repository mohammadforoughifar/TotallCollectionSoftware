            new("شناسه کالا/خدمت", !codeComplete ? "شناسه یک یا چند قلم خالی است." : codeInLocalList ? "در فهرست داخلی فعال پیدا شد؛ این فهرست هنوز مرجع رسمی تأییدشده نیست." : "شناسه در فهرست داخلیِ بارشده پیدا نشد؛ کد را با مرجع معتبر تطبیق دهید.", !codeComplete ? CheckState.Blocked : CheckState.Warning),
            new("شرح و واحد مالیاتی", !lineTitlesPresent ? "شرح یک یا چند قلم خالی است." : !unitsPresent ? "شرح موجود است؛ کد واحد یک یا چند قلم خالی است و الزام آن وابسته به الگو است." : "شرح و واحد برای همه اقلام وارد شده؛ اعتبار رسمی واحد بررسی نشده است.", !lineTitlesPresent ? CheckState.Blocked : !unitsPresent ? CheckState.Warning : CheckState.Passed),
            new("تعداد، فی، تخفیف و نرخ", lineNumbersValid ? "مقادیر منفی، تخفیف بیش از ناخالص و نرخ خارج از ۰ تا ۱۰۰ پیدا نشد." : "یک یا چند مقدار قلم نامعتبر است؛ تعداد باید مثبت و تخفیف در محدوده ناخالص باشد.", lineNumbersValid ? CheckState.Passed : CheckState.Blocked),
            new("محاسبه مالیات و جمع ردیف", lineMathValid ? "مالیات و جمع ردیف با فرمول محلی دوباره کنترل شدند." : "مقادیر محاسباتی یک یا چند ردیف با فرمول محلی سازگار نیستند.", lineMathValid ? CheckState.Passed : CheckState.Blocked),
            new("تطبیق نرخ مالیات با کالا/الگو", vatRangeValid ? "فقط محدوده عددی نرخ کنترل شد؛ نرخ قانونی متناسب با شناسه/الگو از مرجع رسمی بررسی نشده است." : "نرخ یکی از اقلام خارج از محدوده عددی ۰ تا ۱۰۰ است.", vatRangeValid ? CheckState.Warning : CheckState.Blocked),
            new("سایر عوارض، معافیت‌ها و جزئیات مالیاتی", "مدل فعلی مالیات ارزش افزوده هر قلم را دارد؛ فیلدهای سایر عوارض/معافیت‌ها و قواعد وابسته به الگو جداگانه مدل نشده‌اند.", CheckState.Warning),
            new("جمع‌های کلی", !lineMathValid ? "ابتدا خطاهای محاسباتی اقلام را برطرف کنید." : savedTotalsMatch ? $"جمع ناخالص {calculatedGross.Money()}، تخفیف {calculatedDiscount.Money()}، مالیات {calculatedVat.Money()} و خالص {calculatedNet.Money()} با آخرین نسخه ذخیره‌شده هم‌خوان است." : $"جمع محلی خالص {calculatedNet.Money()} است؛ با آخرین نسخه ذخیره‌شده تفاوت دارد و پس از ذخیره دوباره محاسبه می‌شود.", !lineMathValid ? CheckState.Blocked : savedTotalsMatch ? CheckState.Passed : CheckState.Warning)
        }));

        var settlementPresent = !string.IsNullOrWhiteSpace(New.Settlement);
        var needsReference = New.Kind is MoadianInvoiceKind.SaleReturn or MoadianInvoiceKind.PurchaseReturn;
        var referenceKindSupported = New.Kind is MoadianInvoiceKind.Sale or MoadianInvoiceKind.SaleReturn;
        groups.Add(new CheckGroup("تسویه، موضوع خاص و صورتحساب مرجع", "bi-arrow-left-right", new List<CheckItem>
        {
            new("روش تسویه", settlementPresent ? "یک مقدار متنی ثبت شده؛ تبدیل به کد رسمی و اعتبار روش از اینجا قابل تأیید نیست." : "روش تسویه ثبت نشده است؛ مقدار را تکمیل کنید و آن را با قواعد همان الگو تطبیق دهید.", CheckState.Warning),
            new("مبلغ نقد/نسیه و تفکیک پرداخت", "فیلدهای جدا برای سهم نقدی، نسیه یا مبلغ پرداخت در مدل فعلی وجود ندارند.", CheckState.Blocked),
            new("صورتحساب مرجع برای برگشت", needsReference ? "این سند از نوع برگشت است، اما شناسه مالیاتی صورتحساب مرجع فیلد مستقلی ندارد." : "برای سند عادیِ انتخاب‌شده ارجاع برگشت ثبت نشده است؛ نوع موضوع رسمی همچنان جداگانه تکمیل نشده.", needsReference ? CheckState.Blocked : CheckState.Info),
            new("مرجع صورتحساب اصلاحی/ابطالی", "اگر موضوع صورتحساب اصلاحی یا ابطالی باشد، شناسه صورتحساب اصلی لازم است؛ این فیلد وجود ندارد و چون موضوع جداگانه انتخاب نمی‌شود، شرط آن قابل تعیین نیست.", CheckState.Warning),
            new("پشتیبانی جهت سند", referenceKindSupported ? "جهت فروش/برگشت فروش در این فرم قابل انتخاب است؛ قواعد مرجع برای برگشت هنوز کامل نیست." : "خرید، برگشت خرید یا پیش‌فاکتور در مدل فروش فعلی به‌طور کامل نگاشت نشده است.", referenceKindSupported ? (needsReference ? CheckState.Warning : CheckState.Passed) : CheckState.Blocked),
            new("فیلدهای ویژه الگو", "فیلدهای ارز، صادرات، طلا/جواهر، پیمانکاری و سایر الگوهای تخصصی در این فرم وجود ندارند؛ چون الگو انتخاب نمی‌شود، الزام هرکدام هم مشخص نیست.", CheckState.Warning)
        }));

        groups.Add(new CheckGroup("کنترل نهایی، اقدام دستی و پاسخ سامانه", "bi-send-check", new List<CheckItem>
        {
            new("وضعیت پیش‌نویس", Draft?.Status == MoadianInvoiceStatus.Draft ? "این فاکتور هنوز پیش‌نویس است و در صف ارسال قرار ندارد." : "وضعیت فاکتور دیگر پیش‌نویس نیست.", Draft?.Status == MoadianInvoiceStatus.Draft ? CheckState.Passed : CheckState.Blocked),
            new("قالب payload و امضا", "خروجی موجود در نسخه فعلی snapshot محلی است، نه payload رسمی امضاشده و قابل ارسال.", CheckState.Blocked),
            new("تأیید صریح کاربر برای ارسال", "ارسال فقط باید پس از بازبینی و کلیک صریح کاربر انجام شود؛ هیچ ارسال خودکاری در این فرم اجرا نمی‌شود.", CheckState.Passed),
            new("وضعیت تلاش و جلوگیری از ارسال تکراری", Draft?.Attempts == 0 && string.IsNullOrWhiteSpace(Draft?.ReferenceId) && string.IsNullOrWhiteSpace(Draft?.TrackingId)
                ? "تلاش/شناسه ارسال قبلی روی این پیش‌نویس ثبت نشده است؛ این کنترل محلی است و جایگزین قفل تکرارِ زمان ارسال نیست."
                : "سابقه تلاش یا شناسه ارسال وجود دارد؛ باید پاسخ و وضعیت سامانه بررسی شود.",
                Draft?.Attempts == 0 && string.IsNullOrWhiteSpace(Draft?.ReferenceId) && string.IsNullOrWhiteSpace(Draft?.TrackingId) ? CheckState.Passed : CheckState.Warning),
            new("پاسخ و شناسه پیگیری سامانه", "این موارد فقط پس از اتصال مجاز و پاسخ واقعی سامانه قابل ثبت/کنترل‌اند؛ هنوز پاسخی دریافت نشده است.", CheckState.Info)
        }));

        return groups;
    }

    private static bool IsDigitsOnly(string? value)
    {
        if (string.IsNullOrWhiteSpace(value)) return false;
        var text = value.Trim();
        return text.All(ch => ch is >= '0' and <= '9' or >= '۰' and <= '۹' or >= '٠' and <= '٩');
    }

    private static int CountDigits(string? value)
        => string.IsNullOrWhiteSpace(value) ? 0 : value.Count(ch => ch is >= '0' and <= '9' or >= '۰' and <= '۹' or >= '٠' and <= '٩');

    private static string CheckIcon(CheckState state) => state switch
    {
        CheckState.Passed => "bi-check-circle-fill",
        CheckState.Warning => "bi-exclamation-circle-fill",
        CheckState.Blocked => "bi-x-circle-fill",
        _ => "bi-dash-circle"
    };

    private static string CheckIconTone(CheckState state) => state switch
    {
        CheckState.Passed => "text-success",
        CheckState.Warning => "text-warning",
        CheckState.Blocked => "text-danger",
        _ => "text-secondary"
    };

    private static string CheckGroupBadgeClass(CheckGroup group)
    {
        if (group.Items.Any(x => x.State == CheckState.Blocked)) return "bg-danger";
        if (group.Items.Any(x => x.State == CheckState.Warning)) return "bg-warning text-dark";
        if (group.Items.All(x => x.State is CheckState.Passed or CheckState.Info)) return "bg-success";
        return "bg-secondary";
    }

    private static string CheckGroupStatusLabel(CheckGroup group)
    {
        if (group.Items.Any(x => x.State == CheckState.Blocked)) return "نیازمند تکمیل";
        if (group.Items.Any(x => x.State == CheckState.Warning)) return "نیازمند بازبینی";
        if (group.Items.All(x => x.State is CheckState.Passed or CheckState.Info)) return "بررسی شد";
        return "در انتظار";
    }

    private async Task SaveDraft()
    {
        if (Draft is null || Draft.Status != MoadianInvoiceStatus.Draft)
            return;
        if (New.FiscalPeriodId == 0)
        {
            Toast.Error("دوره مالیاتی را انتخاب کنید.");
            return;
        }
        var issueDateError = MoadianInvoiceRules.ValidateIssueDate(New.Date);
        if (issueDateError is not null) { Toast.Error(issueDateError); showDetailedChecks = true; return; }
        if (New.InvoiceType is not (MoadianTaxInvoiceType.Type1 or MoadianTaxInvoiceType.Type2))
        {
            Toast.Error("نوع صورتحساب را برای همین پیش‌نویس انتخاب کنید.");
            return;
        }
        var selectionError = MoadianInvoiceRules.ValidateSelection(New.InvoiceType, New.InvoicePattern, New.InvoiceSubject, New.ReferenceTaxId);
        if (selectionError is not null)
        {
            Toast.Error(selectionError);
            showDetailedChecks = true;
            return;
        }
        if (New.Lines.Count == 0 || New.Lines.All(x => x.Quantity <= 0))
        {
            Toast.Error("حداقل یک قلم معتبر لازم است.");
            return;
        }

        saving = true;
        try
        {
            RecalcAll();
            var saved = await MoadianSvc.UpdateDraftAsync(New.Id, New);
            Toast.Success($"پیش‌نویس {saved.Number} ذخیره شد.");
            await CloseAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task CloseAsync()
    {
        loadedDraftId = null;
        await VisibleChanged.InvokeAsync(false);
    }
}
