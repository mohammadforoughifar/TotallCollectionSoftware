@* ================== کامپوننت پیوست جامع ==================
   استفاده در هر فرم: <AttachmentBox Module="WorkOrders" RefId="123" CanUpload="true" />
   بک‌اند مشترک: /api/attachments/{module}/{refId} — بدون کد جدید برای فرم‌های بعدی *@
@using System.Net.Http.Headers
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast

<div class="attx-box">
    <div class="attx-title">
        <i class="bi bi-paperclip"></i> پیوست‌ها (@items.Count)
    </div>
    <div class="attx-body">
        @if (items.Count == 0)
        {
            <span class="fs-8 text-muted">پیوستی ثبت نشده است.</span>
        }
        @foreach (var a in items)
        {
            <span class="attx-chip">
                @if (a.CanPreview)
                {
                    <a href="javascript:void(0)" @onclick="() => Preview(a)" title="مشاهده در برنامه">
                        <i class="bi @IconOf(a)"></i> @a.FileName
                    </a>
                }
                else if (a.CanDownload)
                {
                    <a href="@($"{apiBase}/api/attachments/download/{a.Id}?access_token={Auth.Token}")" target="_blank"
                       title="دانلود">
                        <i class="bi bi-file-earmark-arrow-down"></i> @a.FileName
                    </a>
                }
                else
                {
                    <span title="این فایل قابل پیش‌نمایش نیست و شما اجازه دانلود ندارید">
                        <i class="bi bi-file-earmark-lock"></i> @a.FileName
                    </span>
                }

                @if (a.CanPreview && a.CanDownload)
                {
                    <a href="@($"{apiBase}/api/attachments/download/{a.Id}?access_token={Auth.Token}")" target="_blank"
                       class="attx-dl" title="دانلود">
                        <i class="bi bi-download"></i>
                    </a>
                }
                @if (!a.CanDownload)
                {
                    <i class="bi bi-eye text-warning" title="فقط مشاهده — بدون حق دانلود"></i>
                }

                <span class="fs-9 text-muted">(@a.UploaderName — @FormatSize(a.Size))</span>
                @if (CanUpload && a.CanDownload && (a.UploaderUserId == MyUserId || Auth.IsAdmin))
                {
                    <i class="bi bi-x-circle-fill attx-del" title="حذف" @onclick="() => Delete(a.Id)"></i>
                }
            </span>
        }
        @if (CanUpload)
        {
            <div class="attx-drop @(dragOver ? "drag" : "") @(uploading ? "busy" : "") mt-2"
                 @ondragenter="OnDragEnter" @ondragenter:preventDefault
                 @ondragover:preventDefault
                 @ondragleave="OnDragLeave"
                 @ondrop="OnDropReset" @ondrop:preventDefault>
                <div class="attx-drop-inner">
                    @if (uploading)
                    {
                        <span class="spinner-border spinner-border-sm text-primary"></span>
                        <span class="fw-700 fs-8 text-primary ms-1">در حال بارگذاری…</span>
                    }
                    else
                    {
                        <i class="bi bi-cloud-arrow-up attx-drop-icon"></i>
                        <div class="fw-700 fs-8">فایل‌ها را اینجا رها کنید (درگ اند دراپ)</div>
                        <div class="fs-9 text-muted">یا برای انتخاب کلیک کنید — حداکثر ۵ فایل، هر فایل تا ۱۰ مگابایت</div>
                    }
                </div>
                <InputFile class="attx-file-overlay" OnChange="OnFiles" multiple disabled="@uploading" />
            </div>
        }
    </div>
</div>

<FilePreviewModal @ref="previewModal" />

<style>
    .attx-dl { color:#16a34a; margin-inline-start:.15rem; }
    .attx-box { border: 1px solid #e8edf3; border-radius: 14px; overflow: hidden; }
    .attx-title { background: #f8fafc; padding: .5rem .85rem; font-size: .82rem; font-weight: 700; color: #334155; border-bottom: 1px solid #eef2f7; }
    .attx-title i { color: #2563eb; margin-left: .3rem; }
    .attx-body { padding: .75rem .85rem; }
    .attx-chip { display: inline-flex; align-items: center; gap: .35rem; background: #eef4ff; border: 1px solid #dbe7ff; border-radius: 999px; padding: .2rem .7rem; font-size: .78rem; margin: 0 0 .3rem .3rem; }
    .attx-chip a { color: #2563eb; text-decoration: none; }
    .attx-del { color: #dc3545; cursor: pointer; opacity: .6; }
    .attx-del:hover { opacity: 1; }
    .fs-9 { font-size: .68rem; }
    .attx-drop { position: relative; border: 2px dashed #c7d7f5; border-radius: 12px; background: #f8fbff; transition: all .15s ease; overflow: hidden; }
    .attx-drop-inner { padding: 1rem .75rem; text-align: center; color: #475569; pointer-events: none; }
    .attx-drop-icon { font-size: 1.8rem; color: #2563eb; display: block; margin-bottom: .25rem; }
    .attx-file-overlay { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: pointer; }
    .attx-file-overlay::-webkit-file-upload-button { cursor: pointer; }
    .attx-drop.drag { border-color: #2563eb; background: #eff6ff; box-shadow: 0 0 0 4px rgba(37,99,235,.12); }
    .attx-drop.drag .attx-drop-icon { transform: scale(1.2); }
    .attx-drop.busy { opacity: .75; pointer-events: none; }
</style>

@code {
    /// <summary>نام ماژول — مثل WorkOrders، ItRequests، Orders</summary>
    [Parameter] public string Module { get; set; } = "";

    /// <summary>شناسه رکورد در ماژول</summary>
    [Parameter] public int RefId { get; set; }

    /// <summary>اجازه آپلود/حذف</summary>
    [Parameter] public bool CanUpload { get; set; } = true;

    private List<AttItem> items = new();
    private FilePreviewModal? previewModal;
    private string apiBase = "";
    private bool dragOver, uploading;
    private int dragDepth;
    private int MyUserId => Auth.UserId;

    private void OnDragEnter() { dragDepth++; dragOver = true; }
    private void OnDragLeave() { if (--dragDepth <= 0) { dragDepth = 0; dragOver = false; } }
    private void OnDropReset() { dragDepth = 0; dragOver = false; }

    public class AttItem
    {
        public int Id { get; set; }
        public string FileName { get; set; } = "";
        public string UploaderName { get; set; } = "";
        public int UploaderUserId { get; set; }
        public DateTime UploadedAt { get; set; }
        public long Size { get; set; }
        public string? ContentType { get; set; }
        /// <summary>قابل نمایش داخل برنامه (PDF/عکس/متن)</summary>
        public bool CanPreview { get; set; }
        /// <summary>کاربر جاری حق دانلود دارد</summary>
        public bool CanDownload { get; set; } = true;
    }

    private static string IconOf(AttItem a)
    {
        var ct = (a.ContentType ?? "").ToLowerInvariant();
        if (ct.Contains("pdf")) return "bi-file-earmark-pdf";
        if (ct.StartsWith("image/")) return "bi-file-earmark-image";
        return "bi-file-earmark-text";
    }

    private async Task Preview(AttItem a)
    {
        if (previewModal is not null)
            await previewModal.ShowAsync(a.Id, a.FileName, a.ContentType, a.CanDownload);
    }

    protected override async Task OnParametersSetAsync()
    {
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);
        await Reload();
    }

    private async Task Reload()
    {
        if (RefId <= 0 || string.IsNullOrWhiteSpace(Module)) { items = new(); return; }
        try { items = await Http.GetFromJsonAsync<List<AttItem>>($"/api/attachments/{Module}/{RefId}") ?? new(); }
        catch { items = new(); }
    }

    private async Task OnFiles(Microsoft.AspNetCore.Components.Forms.InputFileChangeEventArgs e)
    {
        OnDropReset();
        uploading = true;
        try
        {
            var ok = 0;
            foreach (var f in e.GetMultipleFiles(5))
            {
                try
                {
                    using var content = new MultipartFormDataContent();
                    var sc = new StreamContent(f.OpenReadStream(10 * 1024 * 1024));
                    sc.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
                    content.Add(sc, "file", f.Name);
                    var resp = await Http.PostAsync($"/api/attachments/{Module}/{RefId}", content);
                    if (!resp.IsSuccessStatusCode) Toast.Error($"بارگذاری {f.Name} ناموفق بود.");
                    else ok++;
                }
                catch (Exception ex) { Toast.Error($"بارگذاری {f.Name}: {ex.Message}"); }
            }
            await Reload();
            if (ok > 0) Toast.Success($"{ok.Num()} پیوست بارگذاری شد.");
        }
        finally { uploading = false; }
    }

    private async Task Delete(int id)
    {
        try { await Http.DeleteAsync($"/api/attachments/{id}"); await Reload(); } catch { }
    }

    private static string FormatSize(long b) =>
        b < 1024 ? $"{b}B" : b < 1024 * 1024 ? $"{b / 1024}KB" : $"{b / 1024 / 1024:0.#}MB";
}
