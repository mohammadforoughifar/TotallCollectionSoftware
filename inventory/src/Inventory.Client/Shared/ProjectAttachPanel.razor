@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

@* =========================================================
   پنل پیوست‌های پروژه — فایل‌ها رمزنگاری‌شده روی سرور نگهداری می‌شوند
   ========================================================= *@

<div class="attach-panel">
    @* ---------- آپلود ---------- *@
    @if (Auth.Has("ProjectAttach.Create"))
    {
        <div class="border rounded-3 p-2 mb-2" style="background:#f8fafc;">
            <div class="row g-2 align-items-center">
                <div class="col-auto">
                    <label class="form-label fs-8 mb-0">نوع پیوست:</label>
                    <select class="form-select form-select-sm" @bind="attachType">
                        @foreach (var t in Types)
                        {
                            <option value="@t.Key">@t.Value</option>
                        }
                    </select>
                </div>
                <div class="col">
                    <label class="btn btn-sm btn-outline-primary mb-0 @(uploading ? "disabled" : "")">
                        <i class="bi bi-cloud-upload"></i> انتخاب فایل‌ها…
                        <InputFile OnChange="OnFiles" multiple style="display:none" />
                    </label>
                    @if (uploading)
                    {
                        <span class="spinner-border spinner-border-sm text-primary ms-2"></span>
                        <span class="fs-8 text-muted">در حال رمزنگاری و بارگذاری…</span>
                    }
                </div>
            </div>
        </div>
    }

    @* ---------- لیست ---------- *@
    @if (loading)
    {
        <div class="text-center py-3"><div class="spinner-border spinner-border-sm text-primary"></div></div>
    }
    else if (items.Count == 0)
    {
        <div class="text-muted fs-8 text-center py-3"><i class="bi bi-paperclip"></i> پیوستی ثبت نشده است.</div>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var a in items)
            {
                <div class="list-group-item px-1 d-flex align-items-center gap-2">
                    <i class="bi bi-file-earmark-lock text-primary"></i>
                    <div class="flex-grow-1 min-w-0">
                        <div class="fw-500 text-truncate">@a.FileName</div>
                        <div class="fs-8 text-muted">
                            <span class="badge bg-light text-dark border">@TypeName(a.Type)</span>
                            @FormatSize(a.FileSize) — @a.DateSabt.ToFaDateTime()
                            @if (!string.IsNullOrWhiteSpace(a.UserName)) { <span> — @a.UserName</span> }
                        </div>
                    </div>
                    @if (Auth.Has("ProjectAttach.Read"))
                    {
                        <button class="btn btn-sm btn-light" title="دانلود (رمزگشایی‌شده)" disabled="@(downloadingId == a.Id)"
                                @onclick="() => Download(a)">
                            @if (downloadingId == a.Id)
                            {
                                <span class="spinner-border spinner-border-sm"></span>
                            }
                            else
                            {
                                <i class="bi bi-download text-success"></i>
                            }
                        </button>
                    }
                    @if (Auth.Has("ProjectAttach.Delete"))
                    {
                        <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(a)"><i class="bi bi-trash text-danger"></i></button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    /// <summary>شناسه پروژه</summary>
    [Parameter] public int ProjectId { get; set; }

    /// <summary>اعلام تغییر در پیوست‌ها (افزودن/حذف) به صفحه والد برای بروزرسانی فوری شمارنده</summary>
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<AttachItem> items = new();
    private bool loading = true, uploading;
    private int downloadingId;
    private int attachType = 4;

    private static readonly Dictionary<int, string> Types = new()
    {
        [1] = "قرارداد",
        [2] = "مدارک فنی",
        [3] = "تاییدیه تحویل",
        [4] = "سایر"
    };

    private sealed class AttachItem
    {
        public int Id { get; set; }
        public string FileName { get; set; } = "";
        public long FileSize { get; set; }
        public int Type { get; set; }
        public DateTime DateSabt { get; set; }
        public string? UserName { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try { items = await Http.GetFromJsonAsync<List<AttachItem>>($"/api/projectattach/project/{ProjectId}") ?? new(); }
        catch { items = new(); }
        finally { loading = false; }
    }

    private async Task OnFiles(InputFileChangeEventArgs e)
    {
        if (!Auth.Has("ProjectAttach.Create")) return;
        uploading = true;
        try
        {
            using var content = new MultipartFormDataContent();
            content.Add(new StringContent(ProjectId.ToString()), "projectId");
            content.Add(new StringContent(attachType.ToString()), "type");

            var count = 0;
            foreach (var f in e.GetMultipleFiles(10))
            {
                var sc = new StreamContent(f.OpenReadStream(250L * 1024 * 1024));
                sc.Headers.ContentType = new System.Net.Http.Headers.MediaTypeHeaderValue(
                    string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
                content.Add(sc, "files", f.Name);
                count++;
            }
            if (count == 0) return;

            var resp = await Http.PostAsync("/api/projectattach", content);
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("پیوست با موفقیت رمزنگاری و ذخیره شد.");
                await OnChanged.InvokeAsync();
            }
            else
                Toast.Error($"بارگذاری پیوست ناموفق بود. (HTTP {(int)resp.StatusCode})");
        }
        catch (Exception ex) { Toast.Error($"بارگذاری پیوست: {ex.Message}"); }
        finally { uploading = false; }
        await Reload();
    }

    private async Task Download(AttachItem a)
    {
        downloadingId = a.Id;
        try
        {
            var resp = await Http.GetAsync($"/api/projectattach/{a.Id}/download");
            if (!resp.IsSuccessStatusCode)
            {
                Toast.Error($"دانلود ناموفق بود. (HTTP {(int)resp.StatusCode})");
                return;
            }
            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var contentType = resp.Content.Headers.ContentType?.MediaType ?? "application/octet-stream";
            var name = !string.IsNullOrWhiteSpace(resp.Content.Headers.ContentDisposition?.FileNameStar)
                ? resp.Content.Headers.ContentDisposition.FileNameStar
                : (resp.Content.Headers.ContentDisposition?.FileName?.Trim('"') ?? a.FileName);
            await JS.InvokeVoidAsync("downloadBlob", name, contentType, Convert.ToBase64String(bytes));
        }
        catch (Exception ex) { Toast.Error($"دانلود: {ex.Message}"); }
        finally { downloadingId = 0; }
    }

    private async Task Delete(AttachItem a)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف پیوست «{a.FileName}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await Http.DeleteAsync($"/api/projectattach/{a.Id}");
            Toast.Success("پیوست حذف شد.");
            await OnChanged.InvokeAsync();
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private static string TypeName(int t) => Types.TryGetValue(t, out var n) ? n : $"نوع {t}";

    private static string FormatSize(long b) =>
        b < 1024 ? $"{b}B" : b < 1024 * 1024 ? $"{b / 1024}KB" : $"{b / 1024.0 / 1024:0.#}MB";
}
