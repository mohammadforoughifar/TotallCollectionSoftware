@inject IAuthState Auth
@inject NavigationManager Nav
@implements IDisposable

@if (groups.Length > 0)
{
    <div class="nav-group group-hrmain hr-navigation">
        <button type="button" class="nav-section-title nav-toggle @(open ? "open" : "")" aria-expanded="@open.ToString().ToLowerInvariant()" @onclick="() => open = !open">
            <span><i class="bi bi-person-vcard" aria-hidden="true"></i> منابع انسانی اصلی</span>
            <i class="bi bi-chevron-down nav-chevron" aria-hidden="true"></i>
        </button>
        @if (open)
        {
            <div class="nav-group-items">
                <a class="nav-link @(path == "hr-main" ? "active" : "")" aria-current="@(path == "hr-main" ? "page" : null)" href="hr-main" @onclick="Navigate"><i class="bi bi-house-door" aria-hidden="true"></i><span>خانه منابع انسانی</span></a>
                @foreach (var group in groups)
                {
                    var expanded = expandedId == group.Id;
                    <div class="hr-nav-section @(group.Legacy ? "hr-nav-legacy" : "")">
                        <button type="button" class="hr-nav-toggle @(activeGroup == group.Id ? "current" : "")" aria-expanded="@expanded.ToString().ToLowerInvariant()" aria-controls="@("hr-nav-" + group.Id)" @onclick="() => expandedId = expanded ? null : group.Id">
                            <i class="bi @group.Icon" aria-hidden="true"></i><span>@group.Title</span><i class="bi @(expanded ? "bi-chevron-up" : "bi-chevron-down")" aria-hidden="true"></i>
                        </button>
                        @if (expanded)
                        {
                            <div id="@("hr-nav-" + group.Id)" class="hr-nav-children">
                                @foreach (var item in group.Items)
                                {
                                    var active = selected?.Href == item.Href;
                                    <a href="@item.Href" class="nav-link @(active ? "active" : "")" aria-current="@(active ? "page" : null)" @onclick="Navigate"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Title</span></a>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public EventCallback OnNavigate { get; set; }
    private HrNavigation.Section[] groups = [];
    private HrNavigation.Entry? selected;
    private string path = "";
    private string? expandedId, activeGroup;
    private bool open;
    protected override void OnInitialized()
    {
        Nav.LocationChanged += LocationChanged;
        Auth.Changed += AuthChanged;
        Refresh();
    }
    private void Refresh()
    {
        path = HrNavigation.Path(Nav.ToBaseRelativePath(Nav.Uri));
        groups = HrNavigation.Visible(Auth.Has, Auth.IsAdmin);
        selected = HrNavigation.Find(path);
        activeGroup = HrNavigation.SectionId(path);
        expandedId = activeGroup;
        open = HrNavigation.IsWorkspace(path);
    }
    private void LocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e) => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    private void AuthChanged() => _ = InvokeAsync(() => { Refresh(); StateHasChanged(); });
    private Task Navigate() => OnNavigate.InvokeAsync();
    public void Dispose() { Nav.LocationChanged -= LocationChanged; Auth.Changed -= AuthChanged; }
}
