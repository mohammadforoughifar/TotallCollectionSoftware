@inject IJSRuntime JS

<div class="rte-toolbar">
    <button type="button" tabindex="-1" @onclick='() => Cmd("bold")'><i class="bi bi-type-bold"></i></button>
    <button type="button" tabindex="-1" @onclick='() => Cmd("italic")'><i class="bi bi-type-italic"></i></button>
    <button type="button" tabindex="-1" @onclick='() => Cmd("underline")'><i class="bi bi-type-underline"></i></button>
    <button type="button" tabindex="-1" @onclick='() => Cmd("insertUnorderedList")'><i class="bi bi-list-ul"></i></button>
    <button type="button" tabindex="-1" @onclick='() => Cmd("insertOrderedList")'><i class="bi bi-list-ol"></i></button>
    <button type="button" tabindex="-1" @onclick='() => Cmd("removeFormat")'><i class="bi bi-eraser"></i></button>
</div>
<div @ref="_box" class="rte-editor" contenteditable="true"></div>

@code {
    private ElementReference _box;
    private bool _ready;

    /// <summary>بعد از اولین رندر، Blazor این ادیتور را دوباره نسازد تا متن کاربر پاک نشود.</summary>
    protected override bool ShouldRender() => !_ready;

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender) _ready = true;
    }

    public async Task SetHtmlAsync(string? html)
    {
        try { await JS.InvokeVoidAsync("rteSetEl", _box, html ?? ""); } catch { }
    }

    public async Task<string> GetHtmlAsync()
    {
        try { return await JS.InvokeAsync<string>("rteGetEl", _box) ?? ""; }
        catch { return ""; }
    }

    private async Task Cmd(string cmd)
    {
        try { await JS.InvokeVoidAsync("rteExecEl", _box, cmd); } catch { }
    }
}
