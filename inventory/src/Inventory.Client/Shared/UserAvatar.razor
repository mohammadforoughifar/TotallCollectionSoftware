@* آواتار دایره‌ای کاربر — برای همه‌ی جاهایی که نام کاربر نمایش داده می‌شود.
   SystemUserId یا LoginUserId (فقط یکی) را بدهید. بدون عکس → عکس پیش‌فرض.
   همه‌ی آدرس‌ها با BaseUrl API ساخته می‌شوند (در حالت توسعه که کلاینت و API روی پورت‌های جدا هستند هم درست کار می‌کند). *@
@if (SystemUserId > 0)
{
    <img class="user-avatar @CssClass" src="@SysPhotoUrl"
         alt="عکس کاربر" width="@Size" height="@Size"
         onerror="this.onerror=null;this.src='@DefaultUrl';" />
}
else if (LoginUserId > 0)
{
    <img class="user-avatar @CssClass" src="@LoginPhotoUrl"
         alt="عکس کاربر" width="@Size" height="@Size"
         onerror="this.onerror=null;this.src='@DefaultUrl';" />
}
else
{
    <img class="user-avatar user-avatar-default @CssClass" src="@DefaultUrl"
         alt="عکس پیش‌فرض" width="@Size" height="@Size"
         onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2250%22 fill=%22%23c9b8ff%22/><circle cx=%2250%22 cy=%2238%22 r=%2217%22 fill=%22%23fff%22/><path d=%22M18 92a32 32 0 0 1 64 0z%22 fill=%22%23fff%22/></svg>';" />
}

@code {
    [Inject] private ApiOptions ApiCfg { get; set; } = default!;

    [Parameter] public int SystemUserId { get; set; }
    [Parameter] public int LoginUserId { get; set; }
    [Parameter] public int Size { get; set; } = 36;
    [Parameter] public string CssClass { get; set; } = "";

    // برای تازه‌سازی کش مرورگر بعد از آپلود عکس جدید
    [Parameter] public long CacheBust { get; set; }
    private long _cacheBust;

    private string Base =>
        (ApiCfg?.BaseUrl ?? "").TrimEnd('/');

    private string SysPhotoUrl => $@"{Base}/api/SystemUsers/photo/{SystemUserId}?t={_cacheBust}";
    private string LoginPhotoUrl => $@"{Base}/api/auth/users/photo/{LoginUserId}?t={_cacheBust}";
    private string DefaultUrl => $@"{Base}/uploads/users/default.jpg";

    protected override void OnParametersSet() => _cacheBust = CacheBust;
}
