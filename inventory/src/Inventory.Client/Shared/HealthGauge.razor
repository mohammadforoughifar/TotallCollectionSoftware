@* گیج دایره‌ای امتیاز سلامت (0-100) — سایز دلخواه، برای لیست/داشبورد/صفحه‌ی جزئیات *@
@((MarkupString)BuildSvg())

@code {
    [Parameter] public int? Score { get; set; }
    [Parameter] public int Size { get; set; } = 150;
    [Parameter] public string? Label { get; set; }
    [Parameter] public bool ShowLabel { get; set; }
    [Parameter] public bool ShowScore { get; set; } = true;
    [Parameter] public string? Tooltip { get; set; }

    private string RingColor =>
        Score switch
        {
            >= 90 => "#0ea5a4",
            >= 75 => "#2ec47e",
            >= 60 => "#f4a23c",
            >= 40 => "#ff7043",
            >= 0 => "#e0245e",
            _ => "#d5d9e6"
        };

    // محیط دایره با شعاع ۵۲ ≈ 326.7
    private string Dash => Score.HasValue ? $"{Score.Value * 3.267:F1} 999" : "0 999";

    private static string Esc(string? s) =>
        (s ?? "").Replace("&", "&amp;").Replace("\"", "&quot;").Replace("<", "&lt;").Replace(">", "&gt;");

    private string BuildSvg()
    {
        var sb = new System.Text.StringBuilder();
        sb.Append("<svg viewBox=\"0 0 120 120\" style=\"width:").Append(Size).Append("px;height:").Append(Size)
          .Append("px;display:inline-block;vertical-align:middle;\" class=\"hg-svg\" title=\"").Append(Esc(Tooltip)).Append("\">");
        sb.Append("<circle cx=\"60\" cy=\"60\" r=\"52\" fill=\"none\" stroke=\"#eef0f7\" stroke-width=\"12\"></circle>");
        sb.Append("<circle cx=\"60\" cy=\"60\" r=\"52\" fill=\"none\" stroke=\"").Append(RingColor)
          .Append("\" stroke-width=\"12\" stroke-dasharray=\"").Append(Dash)
          .Append("\" stroke-linecap=\"round\" transform=\"rotate(-90 60 60)\"></circle>");

        if (Score.HasValue && ShowScore)
        {
            var y = Size >= 90 ? 68 : 71;
            var fs = Size >= 90 ? 27 : 36;
            sb.Append("<text x=\"60\" y=\"").Append(y).Append("\" text-anchor=\"middle\" font-size=\"").Append(fs)
              .Append("\" font-weight=\"900\" fill=\"#1c2130\">").Append(Score.Value).Append("</text>");
            if (ShowLabel && !string.IsNullOrWhiteSpace(Label))
            {
                sb.Append("<text x=\"60\" y=\"90\" text-anchor=\"middle\" font-size=\"15\" font-weight=\"700\" fill=\"")
                  .Append(RingColor).Append("\">").Append(Esc(Label)).Append("</text>");
            }
        }
        else if (Score.HasValue && !ShowScore)
        {
            sb.Append("<circle cx=\"60\" cy=\"60\" r=\"26\" fill=\"").Append(RingColor).Append("\" opacity=\"0.16\"></circle>");
            sb.Append("<circle cx=\"60\" cy=\"60\" r=\"12\" fill=\"").Append(RingColor).Append("\"></circle>");
        }
        else
        {
            sb.Append("<text x=\"60\" y=\"71\" text-anchor=\"middle\" font-size=\"36\" font-weight=\"700\" fill=\"#b6bccb\">—</text>");
        }

        sb.Append("</svg>");
        return sb.ToString();
    }
}
