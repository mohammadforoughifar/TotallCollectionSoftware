@* ================== مودال پیش‌نمایش فایل ==================
   PDF و عکس: نمایش واقعی داخل برنامه
   Word/Excel: تبدیل HTML سمت سرور (جداول و پاراگراف‌ها)
   متن: نمایش RTL
   استفاده: preview.ShowAsync(id, fileName, contentType, canDownload, textPreviewUrl?)
*@
@using System.Net.Http.Headers
@inject IAuthState Auth
@inject HttpClient Http
@inject IJSRuntime JS

@if (visible)
{
    <div class="fpv-backdrop" @onclick="Close">
        <div class="fpv-dialog" @onclick:stopPropagation="true">
            <div class="fpv-head">
                <div class="text-truncate d-flex align-items-center gap-2">
                    <i class="bi @FileIcon"></i>
                    <b class="fs-8 text-truncate">@fileName</b>
                    @if (kind == "html")
                    {
                        <span class="badge bg-primary fs-9">پیش‌نمایش</span>
                    }
                    else if (kind == "office")
                    {
                        <span class="badge bg-info fs-9">متن استخراج‌شده</span>
                    }
                </div>
                <div class="d-flex align-items-center gap-1">
                    @if (canDownload)
                    {
                        <a class="btn btn-sm btn-light" href="@DownloadUrl" target="_blank" title="دانلود فایل">
                            <i class="bi bi-download text-primary"></i>
                        </a>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-9" title="سطح دسترسی شما فقط مشاهده است">
                            <i class="bi bi-eye ms-1"></i> فقط مشاهده
                        </span>
                    }
                    <button class="btn btn-sm btn-light" @onclick="Close" title="بستن (Esc)">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>

            <div class="fpv-body">
                @if (loading)
                {
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary"></div>
                        <div class="fs-8 text-muted mt-2">در حال بارگذاری پیش‌نمایش…</div>
                    </div>
                }
                else if (error is not null)
                {
                    <div class="alert alert-danger m-3 fs-8">
                        <i class="bi bi-exclamation-triangle-fill ms-1"></i> @error
                    </div>
                }
                else if (kind == "office")
                {
                    @if (officeText is not null)
                    {
                        <div class="fpv-text-meta">
                            @if (officeText.SourceType is not null)
                            {
                                <span class="badge @(officeText.SourceType == "Word" ? "bg-primary" : "bg-success")">
                                    @officeText.SourceType
                                </span>
                            }
                            @if (officeText.CharacterCount > 0)
                            {
                                <span class="text-muted">@officeText.CharacterCount.ToString("N0") نویسه</span>
                            }
                        </div>
                        <pre class="fpv-text" dir="auto">@officeText.Text</pre>
                    }
                    else
                    {
                        <div class="alert alert-secondary m-3 fs-8">
                            <i class="bi bi-file-earmark-text ms-1"></i>
                            @if (officeHint is not null) { @officeHint }
                            else { <text>متن استخراج‌شده‌ای برای این فایل در دسترس نیست.</text> }
                        </div>
                    }
                }
                else if (kind == "text")
                {
                    <pre class="fpv-text" dir="auto">@plainText</pre>
                }
                else if (objectUrl is not null)
                {
                    <div class="fpv-stage">
                        @if (kind == "image")
                        {
                            <div class="fpv-imgwrap">
                                <img src="@objectUrl" alt="@fileName" class="fpv-img" />
                            </div>
                        }
                        else
                        {
                            @* PDF و HTML ورد/اکسل *@
                            <iframe src="@objectUrl" class="fpv-frame" title="@fileName"></iframe>
                        }
                        @if (!string.IsNullOrWhiteSpace(watermarkText))
                        {
                            <div class="fpv-watermark" aria-hidden="true">
                                @for (var r = 0; r < 14; r++)
                                {
                                    <div class="fpv-watermark-row">
                                        @for (var c = 0; c < 4; c++)
                                        {
                                            <span>@watermarkText</span>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (!canDownload)
            {
                <div class="fpv-foot">
                    <i class="bi bi-shield-lock ms-1"></i>
                    شما اجازه دانلود این فایل را ندارید — نمایش فقط داخل برنامه است.
                </div>
            }
        </div>
    </div>
}

<style>
    .fpv-backdrop { position: fixed; inset: 0; background: rgba(15,23,42,.72); z-index: 1080;
                    display: flex; align-items: center; justify-content: center; padding: 1.2rem; }
    .fpv-dialog { background: #fff; border-radius: 16px; width: min(1100px, 96vw); height: min(88vh, 900px);
                  display: flex; flex-direction: column; overflow: hidden; box-shadow: 0 18px 50px rgba(0,0,0,.35); }
    .fpv-head { display: flex; justify-content: space-between; align-items: center; gap: .5rem;
                padding: .6rem .9rem; border-bottom: 1px solid #eef2f7; background: #f8fafc; }
    .fpv-head i { color: #2563eb; }
    .fpv-body { flex: 1; overflow: auto; background: #f1f5f9; }
    .fpv-stage { position: relative; width: 100%; height: 100%; }
    .fpv-watermark { position: absolute; inset: -10%; z-index: 5; pointer-events: none;
                     display: flex; flex-direction: column; justify-content: space-around; overflow: hidden; }
    .fpv-watermark-row { display: flex; justify-content: space-around; white-space: nowrap;
                         transform: rotate(-24deg); font-size: 1.05rem; font-weight: 700;
                         color: rgba(30,64,175,.14); letter-spacing: .5px; gap: 2rem; }
    .fpv-watermark-row span { padding: 0.6rem 1rem; }
    .fpv-frame { width: 100%; height: 100%; border: 0; background: #fff; }
    .fpv-imgwrap { display: flex; align-items: center; justify-content: center; min-height: 100%; padding: 1rem;
                   background:
                     linear-gradient(45deg, #e2e8f0 25%, transparent 25%) 0 0 / 16px 16px,
                     linear-gradient(45deg, transparent 75%, #e2e8f0 75%) 8px 8px / 16px 16px,
                     #f8fafc; }
    .fpv-img { max-width: 100%; max-height: calc(88vh - 90px); object-fit: contain; background: #fff;
               border-radius: 8px; box-shadow: 0 2px 12px rgba(0,0,0,.12); }
    .fpv-text-meta { padding: .45rem .9rem; background: #fff; border-bottom: 1px solid #eef2f7;
                     display:flex; align-items:center; gap:.6rem; font-size:.75rem; }
    .fpv-text { margin: 0; padding: 1rem 1.2rem; white-space: pre-wrap; word-break: break-word;
                font-size: .82rem; line-height: 2; direction: rtl; text-align: right;
                background: #fff; font-family: inherit; min-height: 100%; }
    .fpv-foot { padding: .45rem .9rem; border-top: 1px solid #eef2f7; background: #fffbeb;
                color: #92400e; font-size: .72rem; }
    .fs-9 { font-size: .68rem; }
</style>

@code {
    private bool visible, loading;
    private int attachmentId;
    private string fileName = "", kind = "other";
    private string? objectUrl, error, officeHint, plainText, watermarkText;
    private bool canDownload;
    private OfficeTextInfo? officeText;

    private string FileIcon => kind switch
    {
        "pdf" => "bi-file-earmark-pdf",
        "image" => "bi-file-earmark-image",
        "html" => "bi-file-earmark-richtext",
        "office" => "bi-file-earmark-text",
        "text" => "bi-file-earmark-text",
        _ => "bi-file-earmark"
    };

    private string ApiRoot => (Http.BaseAddress?.ToString() ?? "/").TrimEnd('/');

    private string DownloadUrl =>
        $"{ApiRoot}/api/attachments/download/{attachmentId}?access_token={Auth.Token}";

    /// <summary>
    /// نمایش پیش‌نمایش یک پیوست.
    /// </summary>
    /// <param name="textPreviewUrl">
    /// برای Word/Excel، آدرس متن استخراج‌شده (مثل /api/doc-archive/attachments/{id})؛
    /// null یعنی چنین امکانی برای این ماژول نیست.
    /// </param>
    /// <param name="watermarkText">
    /// اگر پر شود، روی پیش‌نمایش (PDF/تصویر/HTML) به‌صورت واترمارک مورب تکرار می‌شود
    /// (مثلاً «نام کاربر — زمان مشاهده» برای مدارک واترمارک‌دار).
    /// </param>
    public async Task ShowAsync(int id, string name, string? contentType, bool allowDownload,
                                string? textPreviewUrl = null, string? watermarkText = null)
    {
        attachmentId = id;
        fileName = name;
        canDownload = allowDownload;
        this.watermarkText = watermarkText;
        kind = Classify(contentType, name);
        error = null;
        officeText = null;
        officeHint = null;
        plainText = null;
        visible = true;
        loading = true;
        await ReleaseAsync();
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);
        StateHasChanged();

        try
        {
            var token = Auth.Token ?? "";

            // ورد/اکسل → HTML واقعی؛ اگر نشد متن استخراج‌شده
            if (kind == "office")
            {
                try
                {
                    objectUrl = await BlobUrlAsync($"/api/attachments/preview-html/{id}", token, "text/html");
                    if (!string.IsNullOrWhiteSpace(objectUrl))
                    {
                        kind = "html";
                        return;
                    }
                }
                catch (Exception ex)
                {
                    officeHint = ex.Message;
                }

                if (string.IsNullOrWhiteSpace(textPreviewUrl))
                {
                    officeHint ??= "پیش‌نمایش جدولی این فایل ساخته نشد.";
                    return;
                }
                try
                {
                    officeText = await Http.GetFromJsonAsync<OfficeTextInfo>(textPreviewUrl);
                }
                catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    error = "شما به متن این فایل دسترسی ندارید.";
                    return;
                }
                if (officeText is not null && officeText.Available == false)
                {
                    var failMsg = officeText.Status == "Failed"
                        ? $"استخراج متن با خطا مواجه شده است. ({officeText.ErrorMessage})"
                        : "متن این فایل هنوز استخراج نشده است — لحظاتی دیگر دوباره تلاش کنید.";
                    officeText = null;
                    officeHint = string.IsNullOrWhiteSpace(officeHint) ? failMsg : officeHint + " — " + failMsg;
                }
                return;
            }

            if (kind == "text")
            {
                var previewUrl = $"{ApiRoot}/api/attachments/preview/{id}";
                plainText = await JS.InvokeAsync<string>("filePreview.fetchText", previewUrl, token);
                return;
            }

            // PDF / عکس / سایر
            var url = $"{ApiRoot}/api/attachments/preview/{id}";
            var mime = string.IsNullOrWhiteSpace(contentType) ? "application/octet-stream" : contentType;
            if (kind == "pdf") mime = "application/pdf";
            objectUrl = await JS.InvokeAsync<string>("filePreview.fetchBlobUrl", url, token, mime);
            if (string.IsNullOrWhiteSpace(objectUrl))
                error = "ساخت پیش‌نمایش فایل ممکن نشد.";
        }
        catch (JSException jex)
        {
            error = jex.Message;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            error = "شما به این فایل دسترسی ندارید.";
        }
        catch (Exception ex)
        {
            error = "نمایش فایل ممکن نشد: " + ex.Message;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static string Classify(string? contentType, string name)
    {
        var ct = (contentType ?? "").ToLowerInvariant();
        var ext = Path.GetExtension(name).ToLowerInvariant();

        if (ct.Contains("pdf") || ext == ".pdf") return "pdf";
        if (ct.StartsWith("image/") || ext is ".png" or ".jpg" or ".jpeg" or ".jfif" or ".gif"
            or ".webp" or ".bmp" or ".svg" or ".tif" or ".tiff" or ".ico" or ".avif" or ".heic" or ".heif")
            return "image";
        if (ct.Contains("wordprocessingml") || ct.Contains("spreadsheetml") || ct.Contains("msword")
            || ct.Contains("ms-excel")
            || ext is ".docx" or ".doc" or ".xlsx" or ".xls" or ".csv")
            return "office";
        if (ct.StartsWith("text/") || ct.Contains("json") || ct.Contains("xml")
            || ext is ".txt" or ".json" or ".xml" or ".md" or ".log" or ".html" or ".htm")
            return "text";

        return "other";
    }

    private async Task Close()
    {
        visible = false;
        await ReleaseAsync();
        StateHasChanged();
    }

    private async Task ReleaseAsync()
    {
        if (objectUrl is not null)
        {
            try { await JS.InvokeVoidAsync("fpRevoke", objectUrl); } catch { }
            try { await JS.InvokeVoidAsync("filePreview.revoke", objectUrl); } catch { }
            objectUrl = null;
        }
    }

    /// <summary>
    /// اول توابع سطح بالای JS؛ اگر کش قدیمی بود از HttpClient + toBlobUrl/data-URI.
    /// </summary>
    private async Task<string?> BlobUrlAsync(string relative, string token, string mime)
    {
        var abs = ApiRoot + relative;
        try { return await JS.InvokeAsync<string>("fpFetchBlobUrl", abs, token, mime); } catch { }
        try { return await JS.InvokeAsync<string>("filePreview.fetchBlobUrl", abs, token, mime); } catch { }

        var bytes = await Http.GetByteArrayAsync(relative);
        var b64 = Convert.ToBase64String(bytes);
        try
        {
            var blob = await JS.InvokeAsync<string>("filePreview.toBlobUrl", b64, mime);
            if (!string.IsNullOrWhiteSpace(blob)) return blob;
        }
        catch { }
        return $"data:{mime};base64,{b64}";
    }

    private async Task<string> FetchTextAsync(string relative, string token)
    {
        var abs = ApiRoot + relative;
        try { return await JS.InvokeAsync<string>("fpFetchText", abs, token); } catch { }
        try { return await JS.InvokeAsync<string>("filePreview.fetchText", abs, token); } catch { }
        return await Http.GetStringAsync(relative);
    }

    private class OfficeTextInfo
    {
        public int AttachmentId { get; set; }
        public string? FileName { get; set; }
        public bool Available { get; set; }
        public string? Status { get; set; }
        public string? SourceType { get; set; }
        public int CharacterCount { get; set; }
        public string? Text { get; set; }
        public string? ErrorMessage { get; set; }
    }
}
