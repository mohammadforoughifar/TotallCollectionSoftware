@inject AiAssistantService Ai
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

@* =====================================================================
   ویجت شناور «فروغ آریا» — در همه صفحات (داخل MainLayout) در دسترس است.
   ===================================================================== *@

<button class="ai-fab" @onclick="Toggle" title="دستیار فروغ آریا">
    <i class="bi @(open ? "bi-x-lg" : "bi-robot")"></i>
    @if (!open && hasUnread)
    {
        <span class="ai-fab-dot"></span>
    }
</button>

@if (open)
{
    <div class="ai-panel">
        <div class="ai-head">
            <div class="ai-head-title">
                <i class="bi bi-robot"></i>
                <span>فروغ آریا</span>
                <span class="ai-status @(healthOk ? "on" : "off")" title="@healthTip"></span>
            </div>
            <div class="ai-head-actions">
                <button class="ai-icon-btn" title="گفتگوی جدید" @onclick="NewChat"><i class="bi bi-plus-lg"></i></button>
                <button class="ai-icon-btn" title="صفحه کامل" @onclick='() => Nav.NavigateTo("ai-assistant")'><i class="bi bi-arrows-fullscreen"></i></button>
                <button class="ai-icon-btn" title="بستن" @onclick="Toggle"><i class="bi bi-chevron-down"></i></button>
            </div>
        </div>

        <div class="ai-body" id="aiWidgetBody">
            @if (messages.Count == 0)
            {
                <div class="ai-hello">
                    <div class="ai-hello-emoji">🤖</div>
                    <div>سلام! من <b>فروغ آریا</b> هستم.<br>بپرس، مثلاً:</div>
                    <div class="ai-chips">
                        @foreach (var s in Suggestions)
                        {
                            <button class="ai-chip" @onclick="() => Ask(s)">@s</button>
                        }
                    </div>
                </div>
            }
            @foreach (var m in messages)
            {
                <div class="ai-row @(m.Role == "user" ? "me" : "ai")">
                    <div class="ai-bubble">
                        @if (m.Role == "assistant")
                        {
                            <AiMessageView Text="@m.Content" />
                            <div>
                                <button class="ai-speak" title="خواندن پاسخ با صدا" @onclick="() => ToggleSpeak(m.Content)">
                                    <i class="bi @(speakingText == m.Content ? "bi-stop-circle-fill" : "bi-volume-up-fill")"></i>
                                </button>
                                @if (m.UsedFallback)
                                {
                                    <span class="ai-offline-badge" title="مدل زبانی در دسترس نبود؛ پاسخ آفلاین داده شد">⚡ آفلاین</span>
                                }
                            </div>
                            @if (m.Attachments.Count > 0)
                            {
                                <div style="margin-top:.35rem;display:flex;gap:.35rem;flex-wrap:wrap">
                                    @foreach (var a in m.Attachments)
                                    {
                                        var aa = a;
                                        <button class="ai-chip" title="@aa.Title" disabled="@dlBusy" @onclick="() => DownloadReport(aa)">
                                            @if (dlBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                            <i class="bi bi-file-earmark-excel"></i> دانلود اکسل (@aa.TotalRows سطر)
                                        </button>
                                    }
                                </div>
                            }
                        }
                        else
                        {
                            @m.Content
                        }
                    </div>
                </div>
            }
            @if (busy)
            {
                <div class="ai-row ai"><div class="ai-bubble typing"><span></span><span></span><span></span></div></div>
            }
            @if (!string.IsNullOrEmpty(error))
            {
                <div class="ai-error">@error</div>
            }
        </div>

        <div class="ai-input">
            @if (voiceSupported)
            {
                <button class="ai-voice @(listening ? "live" : "")" title="گفتار به نوشتار فارسی" @onclick="ToggleVoice" disabled="@busy">
                    <i class="bi @(listening ? "bi-stop-circle-fill" : "bi-mic-fill")"></i>
                </button>
            }
            <textarea class="ai-text" rows="1" placeholder="بپرس..." @bind="draft" @bind:event="oninput"
                      @onkeydown="OnKeyDown" disabled="@busy"></textarea>
            <button class="ai-send" @onclick="Send" disabled="@(busy || string.IsNullOrWhiteSpace(draft))" title="ارسال">
                <i class="bi bi-send-fill"></i>
            </button>
        </div>
    </div>
}

<style>
    .ai-fab { position: fixed; bottom: 1.2rem; left: 1.2rem; z-index: 2050; width: 56px; height: 56px; border-radius: 50%;
        border: none; background: linear-gradient(135deg, #4f46e5, #7c3aed); color: #fff; font-size: 1.5rem;
        box-shadow: 0 8px 24px rgba(79,70,229,.45); cursor: pointer; display: flex; align-items: center; justify-content: center; }
    .ai-fab:hover { transform: scale(1.06); }
    .ai-fab-dot { position: absolute; top: 8px; right: 8px; width: 12px; height: 12px; border-radius: 50%; background: #22c55e; border: 2px solid #fff; }
    .ai-panel { position: fixed; bottom: 5.4rem; left: 1.2rem; z-index: 2050; width: min(380px, calc(100vw - 2rem)); height: min(560px, calc(100vh - 8rem));
        background: #fff; border-radius: 1rem; box-shadow: 0 20px 60px rgba(0,0,0,.3); display: flex; flex-direction: column; overflow: hidden; }
    .ai-head { background: linear-gradient(135deg, #4f46e5, #7c3aed); color: #fff; padding: .6rem .8rem; display: flex; align-items: center; justify-content: space-between; }
    .ai-head-title { display: flex; align-items: center; gap: .45rem; font-weight: 700; }
    .ai-status { width: 10px; height: 10px; border-radius: 50%; display: inline-block; }
    .ai-status.on { background: #4ade80; box-shadow: 0 0 6px #4ade80; }
    .ai-status.off { background: #fbbf24; }
    .ai-head-actions { display: flex; gap: .15rem; }
    .ai-icon-btn { background: transparent; border: none; color: #fff; font-size: 1rem; padding: .25rem .4rem; border-radius: .4rem; cursor: pointer; }
    .ai-icon-btn:hover { background: rgba(255,255,255,.2); }
    .ai-body { flex: 1; overflow-y: auto; padding: .7rem; background: #f4f5fb; display: flex; flex-direction: column; gap: .5rem; font-size: .86rem; }
    .ai-hello { text-align: center; color: #475569; padding: 1rem .5rem; line-height: 2; }
    .ai-hello-emoji { font-size: 2.4rem; }
    .ai-chips { display: flex; flex-wrap: wrap; gap: .4rem; justify-content: center; margin-top: .6rem; }
    .ai-chip { border: 1px solid #c7d2fe; background: #eef2ff; color: #4338ca; border-radius: 999px; padding: .25rem .7rem; font-size: .78rem; cursor: pointer; }
    .ai-chip:hover { background: #e0e7ff; }
    .ai-row { display: flex; }
    .ai-row.me { justify-content: flex-start; }
    .ai-row.ai { justify-content: flex-end; }
    .ai-bubble { max-width: 88%; padding: .5rem .7rem; border-radius: .9rem; line-height: 1.9; word-break: break-word; }
    .ai-row.me .ai-bubble { background: #4f46e5; color: #fff; border-bottom-right-radius: .2rem; }
    .ai-row.ai .ai-bubble { background: #fff; color: #1e293b; border: 1px solid #e2e8f0; border-bottom-left-radius: .2rem; box-shadow: 0 1px 3px rgba(0,0,0,.06); }
    .ai-bubble.typing span { display: inline-block; width: 7px; height: 7px; margin: 0 2px; border-radius: 50%; background: #94a3b8; animation: aiBlink 1.2s infinite; }
    .ai-bubble.typing span:nth-child(2) { animation-delay: .2s; } .ai-bubble.typing span:nth-child(3) { animation-delay: .4s; }
    @@keyframes aiBlink { 0%,100% { opacity: .25; } 50% { opacity: 1; } }
    .ai-error { background: #fef2f2; color: #b91c1c; border: 1px solid #fecaca; border-radius: .6rem; padding: .45rem .6rem; font-size: .8rem; }
    .ai-offline-badge { font-size: .68rem; color: #92400e; background: #fef3c7; border-radius: 999px; padding: 0 .5rem; display: inline-block; margin-top: .3rem; }
    .ai-speak { border: none; background: transparent; color: #64748b; cursor: pointer; padding: .1rem .3rem; border-radius: .4rem; font-size: .95rem; }
    .ai-speak:hover { color: #4f46e5; background: #eef2ff; }
    .ai-input { display: flex; gap: .4rem; padding: .55rem; border-top: 1px solid #e2e8f0; background: #fff; align-items: flex-end; }
    .ai-text { flex: 1; border: 1px solid #cbd5e1; border-radius: .7rem; padding: .45rem .6rem; resize: none; font-size: .86rem; max-height: 110px; }
    .ai-text:focus { outline: none; border-color: #4f46e5; box-shadow: 0 0 0 3px rgba(79,70,229,.12); }
    .ai-send { border: none; background: #4f46e5; color: #fff; width: 40px; height: 40px; border-radius: .7rem; cursor: pointer; font-size: 1rem; flex-shrink: 0; }
    .ai-send:disabled { opacity: .45; cursor: default; }
    .ai-voice { border: 1px solid #cbd5e1; background: #f8fafc; color: #475569; width: 40px; height: 40px; border-radius: .7rem; cursor: pointer; font-size: 1.05rem; flex-shrink: 0; }
    .ai-voice.live { background: #ef4444; border-color: #ef4444; color: #fff; animation: aiBlink 1s infinite; }
    .ai-msg .ai-list { margin: .3rem 0; padding-right: 1.1rem; }
    .ai-msg .ai-gap { height: .4rem; }
    .ai-link { color: #4f46e5; font-weight: 600; text-decoration: none; border-bottom: 1px dashed #4f46e5; }
    @@media (max-width: 575.98px) { .ai-fab { bottom: 4.6rem; } .ai-panel { bottom: 8.4rem; } }
</style>

@code {
    private bool open;
    private bool busy;
    private bool hasUnread;
    private bool healthOk = true;
    private string healthTip = "دستیار آماده است";
    private bool voiceSupported;
    private bool listening;
    private string draft = "";
    private string? error;
    private string? speakingText;
    private int? conversationId;
    private readonly List<AiChatMessage> messages = new();
    private DotNetObjectReference<AiChatWidget>? dotNetRef;

    private static readonly string[] Suggestions =
    {
        "مانده مرخصی‌ام چقدره؟",
        "فیش حقوقیم چقدره؟",
        "نامه خوانده‌نشده دارم؟",
        "چطور فاکتور فروش ثبت کنم؟",
        "گزارش فروش این ماه به تفکیک مشتری",
    };

    protected override void OnInitialized() => dotNetRef = DotNetObjectReference.Create(this);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            voiceSupported = await JS.InvokeAsync<bool>("aiVoice.isSupported");
            StateHasChanged();
        }
        catch { /* مرورگرهای قدیمی */ }
        _ = LoadHealthAsync();
    }

    private async Task LoadHealthAsync()
    {
        try
        {
            var h = await Ai.GetHealthAsync();
            healthOk = h.Enabled && h.ModelReachable;
            healthTip = !h.Enabled ? "دستیار توسط مدیر خاموش شده" : h.ModelReachable ? $"متصل به مدل {h.ChatModel}" : "مدل در دسترس نیست — حالت آفلاین";
            StateHasChanged();
        }
        catch
        {
            healthOk = false;
            healthTip = "عدم دسترسی به دستیار";
            StateHasChanged();
        }
    }

    private void Toggle()
    {
        open = !open;
        if (open) hasUnread = false;
    }

    private async Task NewChat()
    {
        conversationId = null;
        messages.Clear();
        error = null;
        await StopSpeakAsync();
    }

    private async Task Ask(string text)
    {
        draft = text;
        await Send();
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = Send(); // بدون انتظار تا خط جدید درج نشود
        }
    }

    private async Task Send()
    {
        var text = (draft ?? "").Trim();
        if (text.Length == 0 || busy) return;
        draft = "";
        error = null;
        busy = true;
        await StopSpeakAsync();
        messages.Add(new AiChatMessage { Role = "user", Content = text });
        StateHasChanged();
        await ScrollAsync();
        try
        {
            var result = await Ai.ChatAsync(conversationId, text);
            conversationId = result.ConversationId;
            messages.Add(new AiChatMessage { Role = "assistant", Content = result.Reply, UsedFallback = result.UsedFallback, Attachments = result.Attachments });
            if (!open) hasUnread = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            busy = false;
            StateHasChanged();
            await ScrollAsync();
        }
    }

    private bool dlBusy;

    private async Task DownloadReport(AiChatAttachment a)
    {
        if (dlBusy) return;
        dlBusy = true; error = null;
        try
        {
            var (data, name, _) = await Ai.DownloadReportExcelAsync(a.ReportId);
            await JS.InvokeVoidAsync("saveAsFile", name, Convert.ToBase64String(data));
        }
        catch (Exception ex) { error = ex.Message; }
        finally { dlBusy = false; }
    }

    private async Task ScrollAsync()
    {
        try { await JS.InvokeVoidAsync("aiChat.scrollBottom", "aiWidgetBody"); } catch { }
    }

    private async Task ToggleSpeak(string text)
    {
        try
        {
            if (speakingText == text)
            {
                await JS.InvokeVoidAsync("aiVoice.stopSpeak");
                speakingText = null;
            }
            else
            {
                await JS.InvokeVoidAsync("aiVoice.speak", text);
                speakingText = text;
            }
        }
        catch { speakingText = null; }
    }

    private async Task StopSpeakAsync()
    {
        speakingText = null;
        try { await JS.InvokeVoidAsync("aiVoice.stopSpeak"); } catch { }
    }

    private async Task ToggleVoice()
    {
        if (dotNetRef == null) return;
        try
        {
            if (listening)
            {
                await JS.InvokeVoidAsync("aiVoice.stop");
                listening = false;
            }
            else
            {
                listening = await JS.InvokeAsync<bool>("aiVoice.start", dotNetRef);
            }
        }
        catch { listening = false; }
    }

    [JSInvokable]
    public async Task OnVoiceResult(string text)
    {
        if (!string.IsNullOrWhiteSpace(text))
        {
            draft = ((draft ?? "") + " " + text).Trim();
            StateHasChanged();
        }
        await Task.CompletedTask;
    }

    [JSInvokable]
    public async Task OnVoiceEnd(string err)
    {
        listening = false;
        if (!string.IsNullOrEmpty(err) && err != "no-speech" && err != "aborted")
            error = "خطای ورودی صوتی. لطفاً تایپ کنید.";
        StateHasChanged();
        await Task.CompletedTask;
    }

    public void Dispose()
    {
        try { dotNetRef?.Dispose(); } catch { }
        try { _ = JS.InvokeVoidAsync("aiVoice.stopSpeak"); } catch { }
    }
}
