@inject IJSRuntime JS

<div class="bcard-wrap">
    <div class="bcard" id="bcardPrint">
        <div class="bcard-deco-1"></div>
        <div class="bcard-deco-2"></div>

        <div class="bcard-body">
            <div class="bcard-info">
                <div class="bcard-name">@Name</div>
                @if (!string.IsNullOrWhiteSpace(Shop))
                {
                    <div class="bcard-shop">@Shop</div>
                }
                @if (!string.IsNullOrWhiteSpace(Phone))
                {
                    <div class="bcard-phone num" dir="ltr"><i class="bi bi-telephone-fill"></i> @Phone</div>
                }
            </div>
            <div class="bcard-qr">
                <div id="bcardQr"></div>
                <div class="bcard-qr-hint">اسکن کنید</div>
            </div>
        </div>

        <div class="bcard-brand">فروغ آریا</div>
    </div>
</div>

<div class="text-center mt-3 no-print">
    <button class="btn btn-primary" @onclick="Print">
        <i class="bi bi-printer"></i> چاپ کارت ویزیت
    </button>
</div>

@code {
    [Parameter] public string Name { get; set; } = "";
    [Parameter] public string? Shop { get; set; }
    [Parameter] public string? Phone { get; set; }

    private string qrText =>
        $"BEGIN:VCARD\nVERSION:3.0\nFN:{Name}\n" +
        (string.IsNullOrWhiteSpace(Shop) ? "" : $"ORG:{Shop}\n") +
        (string.IsNullOrWhiteSpace(Phone) ? "" : $"TEL:{Phone}\n") +
        "END:VCARD";

    private string? lastQr;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // فقط وقتی متن QR تغییر کرده باشد دوباره ساخته می‌شود (تابع JS خودش تا آماده شدن DOM تلاش می‌کند)
        if (lastQr == qrText && !firstRender) return;
        lastQr = qrText;
        try { await JS.InvokeVoidAsync("makeQr", "bcardQr", qrText, 110); }
        catch { }
    }

    private async Task Print()
    {
        try { await JS.InvokeVoidAsync("printBusinessCard"); }
        catch { }
    }
}
