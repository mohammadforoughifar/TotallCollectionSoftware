<div class="col-12 col-sm-6 col-xl-3"><a class="panel-link-card" href="@Href"><i class="bi @Icon"></i><strong>@Title</strong><span>@Description</span></a></div>
@code { [Parameter] public string Icon { get; set; } = "bi-grid"; [Parameter] public string Title { get; set; } = ""; [Parameter] public string Description { get; set; } = ""; [Parameter] public string Href { get; set; } = "#"; }
<style>.panel-link-card{height:100%;min-height:135px;padding:1rem;display:flex;flex-direction:column;gap:.35rem;border:1px solid #e2e8f0;border-radius:14px;background:#fff;text-decoration:none;color:#334155;box-shadow:0 5px 16px rgba(15,23,42,.05)}.panel-link-card i{font-size:1.35rem;color:#2563eb}.panel-link-card strong{font-size:1rem}.panel-link-card span{font-size:.8rem;color:#64748b}.panel-link-card:hover{border-color:#93c5fd;background:#f8fbff}</style>
