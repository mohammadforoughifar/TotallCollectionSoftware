@inject IJSRuntime JS
@inject IToastService Toast
@inject IDocArchiveService Svc

<div class="d-flex align-items-center gap-2" dir="rtl">
    @if (!isOnline)
    {
        <span class="badge bg-warning text-dark"><i class="bi bi-wifi-off"></i> آفلاین</span>
    }
    else
    {
        <span class="badge bg-success"><i class="bi bi-wifi"></i> آنلاین</span>
    }
    @if (queueCount > 0)
    {
        <span class="badge bg-primary" title="اقدامات در صف همگام‌سازی"><i class="bi bi-cloud-upload"></i> @queueCount در صف</span>
        <button class="btn btn-xs btn-outline-primary" disabled="@syncing" @onclick="SyncNow">
            @if (syncing) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-arrow-repeat"></i> } همگام‌سازی
        </button>
    }
    @if (!string.IsNullOrWhiteSpace(lastSyncMsg))
    {
        <span class="fs-9 text-muted">@lastSyncMsg</span>
    }
</div>

@code {
    private bool isOnline = true;
    private int queueCount;
    private bool syncing;
    private string? lastSyncMsg;
    private DotNetObjectReference<DocOfflineStatus>? selfRef;

    protected override async Task OnInitializedAsync()
    {
        await Refresh();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            try { await JS.InvokeVoidAsync("eval", "window.addEventListener('online', ()=> DotNet.invokeMethodAsync('Inventory.Client','DocOfflineStatus_OnlineChanged', true)); window.addEventListener('offline', ()=> DotNet.invokeMethodAsync('Inventory.Client','DocOfflineStatus_OnlineChanged', false)); window.addEventListener('doc-archive-queue-changed', e=> DotNet.invokeMethodAsync('Inventory.Client','DocOfflineStatus_QueueChanged', e.detail.count));"); } catch {}
            // poll online status
            Poll();
        }
    }

    private async void Poll()
    {
        while (true)
        {
            await Task.Delay(4000);
            await Refresh();
        }
    }

    private async Task Refresh()
    {
        try { isOnline = await JS.InvokeAsync<bool>("eval", "navigator.onLine"); } catch {}
        try { queueCount = await JS.InvokeAsync<int>("docArchiveQueueCount"); } catch { queueCount = 0; }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SyncNow()
    {
        if (!isOnline) { Toast.Error("هنوز آفلاینی — وقتی آنلاین شدی دوباره بزن."); return; }
        syncing = true;
        try
        {
            // همگام‌سازی صف تاییدهای آفلاین
            var res = await JS.InvokeAsync<SyncRes>("docArchiveSyncNow");
            // برای هر آیتم صف، از طریق سرویس هم تایید را بفرست (fallback اگر service worker sync نکرده)
            var qCount = res?.remaining ?? 0;
            if (qCount == 0 && res != null)
            {
                Toast.Success($"همگام‌سازی انجام شد: {res.synced} مورد");
                lastSyncMsg = $"{DateTime.Now:HH:mm} — {res.synced} همگام";
            }
            else if (res?.failed > 0)
            {
                Toast.Error($"{res.failed} مورد همگام نشد — بعداً دوباره تلاش می‌شود.");
            }
            await Refresh();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { syncing = false; }
    }

    [JSInvokable("DocOfflineStatus_OnlineChanged")]
    public static Task OnlineChanged(bool online) => Task.CompletedTask;

    [JSInvokable("DocOfflineStatus_QueueChanged")]
    public static Task QueueChanged(int count) => Task.CompletedTask;

    private class SyncRes { public int synced { get; set; } public int failed { get; set; } public int remaining { get; set; } }
}
