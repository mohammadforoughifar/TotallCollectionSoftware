    private bool RouteAllowed(out string deniedTitle)
    {
        deniedTitle = "";
        if (!Auth.IsLoggedIn) return true;

        var p = Nav.ToBaseRelativePath(Nav.Uri).TrimEnd('/').ToLowerInvariant();
        var q = p.IndexOf('?');
        if (q >= 0) p = p[..q];
        if (p == "") return true; // صفحه‌ی اصلی خودش دسترسی داشبورد مالی را کنترل می‌کند

        foreach (var (prefix, perm, title) in RouteGuards)
        {
            if (!p.StartsWith(prefix)) continue;
            var allowed = perm.EndsWith(".")
                ? Auth.HasModule(perm.TrimEnd('.'))
                : Auth.Has(perm);
            if (!allowed) { deniedTitle = title; return false; }
            return true;
        }
        return true; // مسیرهای بدون نگاشت (مثل تغییر رمز) آزادند
    }

