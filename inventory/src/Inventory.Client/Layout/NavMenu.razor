</div>

@code {
    [Parameter] public int ReorderCount { get; set; }
    [Parameter] public int NewSystemsCount { get; set; }
    [Parameter] public int LettersUnreadCount { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool gOpsBase, gOpsReports, gMoadian;
    private bool gDash, gOps, gProjects, gAdmin, gReports, gBase, gSys, gWo, gDevTeam, gBonHr, gFaHr, gLetters, gDocs, gChat, gMisc, gPersonal;

    // ================== منابع انسانی فروغ آریا (برنامهٔ پیشین) ==================
    private HrNavigation.Entry[] FaHrItems = [];
    private HrNavigation.Entry? FaHrSelected;

    private void RefreshFaHr()
    {
        var p = ForoughAryaHrNavigation.Path(NavManager.ToBaseRelativePath(NavManager.Uri));
        FaHrItems = ForoughAryaHrNavigation.Visible(Auth.Has, Auth.IsAdmin);
        FaHrSelected = ForoughAryaHrNavigation.Find(p);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = InvokeAsync(() =>
        {
            RefreshFaHr();
            var path = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/').ToLowerInvariant();
            gPersonal = path.StartsWith("personal-settings");
            gMisc = path.StartsWith("misc");
            if (path.StartsWith("trs/vouchers")) gOps = true;
            if (path.StartsWith("operations/reports")) { gOps = true; gOpsReports = true; }
            if (path.StartsWith("moadian")) gMoadian = true;
            StateHasChanged();
        });

    // ================== مجوز «مشاهده» = مبنای نمایش در منو ==================
    // اگر در «تنظیمات ← نقش‌ها و دسترسی‌ها» تیک مشاهدهٔ یک ماژول برداشته شود،
    // آیتم مربوطه و (در صورت خالی‌شدن) کل گروه منو رندر نمی‌شود.
    private bool CanSeeCartable => Auth.CanSee("MyCartable");
    private bool CanSeeMyArchive => Auth.CanSee("MyArchive");
    private bool CanSeeMyDashboards => Auth.CanSee("MyDashboards");
    private bool CanSeeReportStudio => Auth.CanSee("ReportStudio");
    private bool CanSeeAnyDashboard => Auth.Has("Dashboards.Financial")
                                    || Auth.Has("Dashboards.Management")
                                    || Auth.Has("Dashboards.Hardware");

    private bool ShowDashGroup => CanSeeCartable || CanSeeMyArchive || CanSeeMyDashboards
                                  || CanSeeReportStudio || CanSeeAnyDashboard;
    private bool ShowOpsBaseSub => ModuleAccess.CanSeeAny(Auth, "Products", "Warehouses", "Parties", "Referrers");
    private bool ShowMoadianGroup => Auth.CanSee("Moadian");
    private bool ShowOpsReportsSub => Auth.Has("ReportPages.Kardex") || Auth.CanSee("Orders") || Auth.CanSee("Repairs");
    private bool ShowOpsGroup => ShowOpsReportsSub || ShowOpsBaseSub || ModuleAccess.CanSeeAny(Auth, "Orders", "GoodsIssues", "Stock", "Repairs", "Expenses",
                                                        "Products", "Warehouses", "Parties", "Referrers", "TrsVouchers");
    private bool ShowAdminGroup => ModuleAccess.CanSeeAny(Auth, "ItRequests", "SystemUsers", "CctvCameras", "CctvNvrs");
    private bool ShowReportsGroup => Auth.Has("ReportPages.Kardex") || Auth.Has("ReportPages.Reorder");
    // کالاها/گروه/واحد/انبار/طرف‌حساب/معرف‌ها زیرمنوی «اطلاعات پایه» داخل «عملیات»؛ مودیان گروه مستقل «عملیات مودیان» است.
    private bool ShowBaseGroup => ModuleAccess.CanSeeAny(Auth, "ReferrerWallets",
                                                         "SystemCompanies", "SystemDepartments");
    private bool ShowSysGroup => CanSeeSettings || Auth.CanSee("SystemUsers");

    /// <summary>ورود به بخش تنظیمات — فقط مدیر و با مجوز مشاهدهٔ ماژول تنظیمات.</summary>
    private bool CanSeeSettings => Auth.IsAdmin && Auth.CanSee("Settings");

    protected override void OnInitialized()
    {
        // پیش‌فرض: همه‌ی گروه‌ها بسته — فقط گروهی که صفحه‌ی فعلی داخل آن است باز می‌شود
        var p = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/').ToLowerInvariant();

        NavManager.LocationChanged += OnLocationChanged;
        RefreshFaHr();

        gChat = p.StartsWith("chat");
        gDash = p.StartsWith("dashboard") || p.StartsWith("cartable") || p.StartsWith("my-archive") || p.StartsWith("my-dashboards") || p.StartsWith("report-studio") || p.StartsWith("reports-hub");
        gWo = p.StartsWith("work-orders");
        gDevTeam = p.StartsWith("dev-team");
        gBonHr = p == "bon-hr" || p.StartsWith("bon-hr/");
        gFaHr = ForoughAryaHrNavigation.IsWorkspace(p);
        gLetters = p.StartsWith("letters");
        gMisc = p.StartsWith("misc");
        gPersonal = p.StartsWith("personal-settings");
        gDocs = p.StartsWith("doc-archive");
        gProjects = p.StartsWith("projects") || p.StartsWith("project-cartable") || p.StartsWith("report-works") || p.StartsWith("karfarmas") || p.StartsWith("type-factors");
        gOpsBase = p.StartsWith("products") || p.StartsWith("categories") || p.StartsWith("units") ||
                   p.StartsWith("warehouses") || p.StartsWith("parties") ||
                   (p.StartsWith("referrer") && !p.StartsWith("referrer-wallets"));
        gOpsReports = p.StartsWith("operations/reports");
        gMoadian = p.StartsWith("moadian");
        gOps = p.StartsWith("orders") || p.StartsWith("goods-issues") || p.StartsWith("stock") || p.StartsWith("repairs") || p.StartsWith("expenses") || p.StartsWith("trs/vouchers") || gOpsReports || gOpsBase;
        gAdmin = p.StartsWith("system-") && !p.StartsWith("system-company") && !p.StartsWith("system-department") || p.StartsWith("network-scan") || p.StartsWith("cctv") || p.StartsWith("office-machines") || p.StartsWith("it-requests") || p.StartsWith("settings/it-client-companies");
        gReports = p.StartsWith("reports");
        gBase = p.StartsWith("referrer-wallets") ||
                p.StartsWith("system-company") || p.StartsWith("system-department");
        gSys = p.StartsWith("users") || p.StartsWith("settings") || p.StartsWith("my-");
        
    }

    private async Task NotifyClose() => await OnNavigate.InvokeAsync();

    public void Dispose() => NavManager.LocationChanged -= OnLocationChanged;
}
