                @if (Auth.HasModule("CctvCameras"))
                {
                    <NavLink class="nav-link" href="cctv-cameras" @onclick="NotifyClose">
                        <i class="bi bi-camera-video-fill"></i><span>دوربین‌های مداربسته</span>
                    </NavLink>
                }
                @if (Auth.HasModule("CctvNvrs"))
                {
                    <NavLink class="nav-link" href="cctv-nvrs" @onclick="NotifyClose">
                        <i class="bi bi-hdd-stack-fill"></i><span>دستگاه‌های NVR</span>
                    </NavLink>
                }
                @if (Auth.HasModule("SystemUsers"))
                {
                    <NavLink class="nav-link" href="office-machines" @onclick="NotifyClose">
                        <i class="bi bi-printer-fill"></i><span>ماشین‌های اداری</span>
                    </NavLink>
                    <NavLink class="nav-link" href="system-id" @onclick="NotifyClose">
                        <i class="bi bi-cpu-fill"></i><span>شناسنامه سیستم</span>
                    </NavLink>
                    <NavLink class="nav-link" href="system-users" @onclick="NotifyClose">
                        <i class="bi bi-people-fill"></i><span>کاربران سیستم</span>
                    </NavLink>
                    <NavLink class="nav-link" href="network-scan" @onclick="NotifyClose">
                        <i class="bi bi-broadcast-pin"></i><span>اسکن شبکه</span>
                    </NavLink>
                }
            </div>
