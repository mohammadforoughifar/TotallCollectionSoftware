@inject IAuthState Auth
@inject NavigationManager NavManager
@implements IDisposable

<div class="sidebar-nav">
    @* ============ هوش مصنوعی فروغ آریا ============ *@
    @if (Auth.IsAdmin || Auth.Has("AiAssistant.Use"))
    {
        <NavLink class="nav-link ai-nav-link" href="ai-assistant" @onclick="NotifyClose">
            <i class="bi bi-robot"></i><span>فروغ آریا 🤖</span>
        </NavLink>
    }
    @if (Auth.IsAdmin)
    {
        <NavLink class="nav-link" href="ai-feedback" @onclick="NotifyClose">
            <i class="bi bi-hand-thumbs-up"></i><span>بازبینی بازخوردها</span>
        </NavLink>
    }
    @if (Auth.IsAdmin)
    {
        <NavLink class="nav-link" href="ai-audit" @onclick="NotifyClose">
            <i class="bi bi-clipboard-data"></i><span>حسابرسی دستیار</span>
        </NavLink>
    }

    @* ============ پیام‌رسان سازمانی (ماژول مستقل) ============ *@
    @if (Auth.CanSee("Chat"))
    {
        <div class="nav-group group-chat">
            <button type="button" class="nav-section-title nav-toggle @(gChat ? "open" : "")" @onclick="() => gChat = !gChat">
                <span><i class="bi bi-chat-dots"></i>پیام‌رسان سازمانی</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gChat)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="chat" @onclick="NotifyClose">
                        <i class="bi bi-chat-dots-fill text-primary"></i><span>پیام‌رسان</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ تنظیمات شخصی کاربر ============ *@
    @if (Auth.IsLoggedIn)
    {
        <div class="nav-group group-personal-settings">
            <button type="button" class="nav-section-title nav-toggle @(gPersonal ? "open" : "")" @onclick="() => gPersonal = !gPersonal">
                <span><i class="bi bi-person-gear"></i> تنظیمات شخصی کاربر</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gPersonal)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="personal-settings" @onclick="NotifyClose">
                        <i class="bi bi-person-gear"></i><span>پروفایل و تنظیمات شخصی</span>
                    </NavLink>
                    @if (Auth.Has("PersonalSettings.ManageLetterGroups"))
                    {
                        <NavLink class="nav-link" href="personal-settings/letter-groups" @onclick="NotifyClose">
                            <i class="bi bi-people"></i><span>گروه‌های گیرندگان نامه</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    @* ============ داشبوردها — گروه فقط وقتی رندر می‌شود که حداقل یک آیتمش مجوز مشاهده داشته باشد ============ *@
    @if (ShowDashGroup)
    {
    <div class="nav-group group-dash">
        <button type="button" class="nav-section-title nav-toggle @(gDash ? "open" : "")" @onclick="() => gDash = !gDash">
            <span><i class="bi bi-grid-1x2"></i>داشبوردها</span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gDash)
        {
            <div class="nav-group-items">
                @if (CanSeeCartable)
                {
                <NavLink class="nav-link" href="cartable" @onclick="NotifyClose">
                    <i class="bi bi-inbox-fill"></i><span>کارتابل من</span>
                </NavLink>
                }
                @if (CanSeeMyArchive)
                {
                <NavLink class="nav-link" href="my-archive" @onclick="NotifyClose">
                    <i class="bi bi-archive-fill"></i><span>بایگانی شخصی</span>
                </NavLink>
                }
                @if (CanSeeMyDashboards)
                {
                <NavLink class="nav-link" href="my-dashboards" @onclick="NotifyClose">
                    <i class="bi bi-grid-1x2-fill"></i><span>داشبورد من</span>
                </NavLink>
                }
                @if (CanSeeReportStudio)
                {
                <NavLink class="nav-link" href="reports-hub" @onclick="NotifyClose">
                    <i class="bi bi-journal-text"></i><span>گزارش‌ها</span>
                </NavLink>
                <NavLink class="nav-link" href="report-studio" @onclick="NotifyClose">
                    <i class="bi bi-clipboard-data-fill"></i><span>گزارش‌ساز</span>
                </NavLink>
                }
                @if (Auth.Has("Dashboards.Financial"))
                {
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="NotifyClose">
                        <i class="bi bi-speedometer2"></i><span>داشبورد مالی</span>
                    </NavLink>
                }
                @if (Auth.Has("Dashboards.Management"))
                {
                    <NavLink class="nav-link" href="dashboard-cctv" @onclick="NotifyClose">
                        <i class="bi bi-graph-up-arrow"></i><span>داشبورد مدیریت</span>
                    </NavLink>
                }
                @if (Auth.Has("Dashboards.Hardware"))
                {
                    <NavLink class="nav-link" href="dashboard-hardware" @onclick="NotifyClose">
                        <i class="bi bi-motherboard"></i><span>داشبورد سخت‌افزار</span>
                    </NavLink>
                }
            </div>
        }
    </div>
    }

    @* ============ دستور کار (ماژول مستقل — فقط با مجوز مشاهده) ============ *@
    @if (Auth.CanSee("WorkOrders"))
    {
        <div class="nav-group group-wo">
            <button type="button" class="nav-section-title nav-toggle @(gWo ? "open" : "")" @onclick="() => gWo = !gWo">
                <span><i class="bi bi-card-checklist"></i> دستور کار</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gWo)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="work-orders" @onclick="NotifyClose">
                        <i class="bi bi-card-checklist"></i><span>دستورهای کار</span>
                    </NavLink>
                    <NavLink class="nav-link" href="work-orders?tab=calendar" @onclick="NotifyClose">
                        <i class="bi bi-calendar-week-fill"></i><span>تقویم دستور کار</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ میز کار توسعه (مدیریت تیم نرم‌افزار) ============ *@
    @if (Auth.CanSee("DevTeam"))
    {
        <div class="nav-group group-devteam">
            <button type="button" class="nav-section-title nav-toggle @(gDevTeam ? "open" : "")" @onclick="() => gDevTeam = !gDevTeam">
                <span><i class="bi bi-code-slash"></i> میز کار توسعه</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gDevTeam)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="dev-team" @onclick="NotifyClose">
                        <i class="bi bi-kanban"></i><span>برد و تسک‌ها</span>
                    </NavLink>
                    <NavLink class="nav-link" href="dev-team?tab=problems" @onclick="NotifyClose">
                        <i class="bi bi-bug"></i><span>خطا و هشدار</span>
                    </NavLink>
                    <NavLink class="nav-link" href="dev-team?tab=modules" @onclick="NotifyClose">
                        <i class="bi bi-boxes"></i><span>ماژول‌ها و تغییرات</span>
                    </NavLink>
                    <NavLink class="nav-link" href="dev-team?tab=dashboard" @onclick="NotifyClose">
                        <i class="bi bi-speedometer2"></i><span>داشبورد تیم</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ منابع انسانی بن‌سازه (ماژول مستقل) ============ *@
    @if (Auth.HasModule("RadisHr"))
    {
        <div class="nav-group group-bonhr">
            <button type="button" class="nav-section-title nav-toggle @(gBonHr ? "open" : "")" @onclick="() => gBonHr = !gBonHr">
                <span><i class="bi bi-people"></i>منابع انسانی بن‌سازه</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gBonHr)
            {
                <div class="nav-group-items">
                    @foreach (var item in BonHrNav.Items)
                    {
                        @if (Auth.Has("RadisHr.Access") || Auth.Has("RadisHr." + item.Section))
                        {
                        <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == "bon-hr" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="NotifyClose">
                            <i class="bi @item.Icon"></i><span>@item.Label</span>
                        </NavLink>
                        }
                    }
                </div>
            }
        </div>
    }

    <HrWorkspaceNav OnNavigate="NotifyClose" />

    @* ============ منابع انسانی فروغ آریا (برنامهٔ پیشین) ============ *@
    @if (FaHrItems.Length > 0)
    {
        <div class="nav-group group-fahr">
            <button type="button" class="nav-section-title nav-toggle @(gFaHr ? "open" : "")" @onclick="() => gFaHr = !gFaHr">
                <span><i class="bi bi-person-workspace"></i>منابع انسانی فروغ آریا</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gFaHr)
            {
                <div class="nav-group-items">
                    @foreach (var item in FaHrItems)
                    {
                        var active = FaHrSelected == item;
                        <a class="nav-link @(active ? "active" : "")" href="@item.Href" @onclick="NotifyClose">
                            <i class="bi @item.Icon"></i><span>@item.Title</span>
                        </a>
                    }
                </div>
            }
        </div>
    }

    @* ============ آرشیو اسناد و مدارک ============ *@
    @if (Auth.CanSee("DocArchive"))
    {
        <div class="nav-group group-docarchive">
            <button type="button" class="nav-section-title nav-toggle @(gDocs ? "open" : "")" @onclick="() => gDocs = !gDocs">
                <span><i class="bi bi-archive-fill"></i> آرشیو اسناد و مدارک</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gDocs)
            {
                <div class="nav-group-items">
                    @* فرم اصلی «آرشیو اسناد و مدارک» (پوشه‌ها و مدارک) — بازگشت لینک مستقیم به /doc-archive *@
                    <NavLink class="nav-link" href="doc-archive" @onclick="NotifyClose">
                        <i class="bi bi-folder2-open"></i><span>پوشه‌ها و مدارک</span>
                    </NavLink>
                    <NavLink class="nav-link" href="doc-archive/cartable" @onclick="NotifyClose">
                        <i class="bi bi-inbox"></i><span>کارتابل آرشیو</span>
                    </NavLink>
                    <NavLink class="nav-link" href="export-center" @onclick="NotifyClose">
                        <i class="bi bi-file-earmark-arrow-down"></i><span>مرکز خروجی</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ اتوماسیون اداری ============ *@
    @if (Auth.CanSee("InnerLetters") || Auth.CanSee("OutgoingLetters") || Auth.CanSee("Email"))
    {
        <div class="nav-group group-letters">
            <button type="button" class="nav-section-title nav-toggle @(gLetters ? "open" : "")" @onclick="() => gLetters = !gLetters">
                <span><i class="bi bi-envelope-paper"></i>اتوماسیون اداری</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gLetters)
            {
                <div class="nav-group-items">
                    @if (Auth.CanSee("InnerLetters"))
                    {
                        <NavLink class="nav-link" href="letters" @onclick="NotifyClose">
                            <i class="bi bi-envelope-paper"></i><span>کارتابل نامه داخلی</span>
                            @if (LettersUnreadCount > 0)
                            {
                                <span class="nav-badge">@LettersUnreadCount</span>
                            }
                        </NavLink>
                    }
                    @if (Auth.CanSee("IncomingLetters"))
                    {
                        <NavLink class="nav-link" href="incoming-letters" Match="NavLinkMatch.All" @onclick="NotifyClose">
                            <i class="bi bi-inbox-fill"></i><span>کارتابل نامه وارده</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("OutgoingLetters"))
                    {
                        <NavLink class="nav-link" href="outgoing-letters" Match="NavLinkMatch.All" @onclick="NotifyClose">
                            <i class="bi bi-send"></i><span>کارتابل نامه صادره</span>
                        </NavLink>
                        @if (Auth.Has("OutgoingLetters.Dabirkhane"))
                        {
                            <NavLink class="nav-link" href="outgoing-letters/dabirkhane" @onclick="NotifyClose">
                                <i class="bi bi-mailbox"></i><span>دبیرخانه یکپارچه اتوماسیون اداری</span>
                            </NavLink>
                        }
                    }
                    @if (Auth.CanSee("Email"))
                    {
                        <NavLink class="nav-link" href="office/email" @onclick="NotifyClose">
                            <i class="bi bi-envelope-at"></i><span>ایمیل سازمانی</span>
                        </NavLink>
                        <NavLink class="nav-link" href="office/personal-email" @onclick="NotifyClose">
                            <i class="bi bi-person-badge"></i><span>ایمیل شخصی</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    @* ============ فرم‌های متفرقه ============ *@
    @if (Auth.CanSee("MeetingMinutes"))
    {
        <div class="nav-group group-misc">
            <button type="button" class="nav-section-title nav-toggle @(gMisc ? "open" : "")" @onclick="() => gMisc = !gMisc">
                <span><i class="bi bi-files"></i>فرم‌های متفرقه</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gMisc)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="misc/minutes" Match="NavLinkMatch.All" @onclick="NotifyClose">
                        <i class="bi bi-journal-text"></i><span>صورتجلسه</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ عملیات — گروه فقط با حداقل یک مجوز مشاهده ============ *@
    @if (ShowOpsGroup)
    {
    <div class="nav-group group-ops">
        <button type="button" class="nav-section-title nav-toggle @(gOps ? "open" : "")" @onclick="() => gOps = !gOps">
            <span><i class="bi bi-box-seam"></i>عملیات</span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gOps)
        {
            <div class="nav-group-items">
                @if (Auth.CanSee("Orders"))
                {
                    <NavLink class="nav-link" href="orders/purchase" @onclick="NotifyClose">
                        <i class="bi bi-bag-plus"></i><span>خرید</span>
                    </NavLink>
                    <NavLink class="nav-link" href="orders/sale" @onclick="NotifyClose">
                        <i class="bi bi-cart3"></i><span>فروش</span>
                    </NavLink>
                }
                @if (Auth.CanSee("GoodsIssues"))
                {
                    <NavLink class="nav-link" href="goods-issues" @onclick="NotifyClose">
                        <i class="bi bi-box-seam"></i><span>بیجک</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Stock"))
                {
                    <NavLink class="nav-link" href="stock" @onclick="NotifyClose">
                        <i class="bi bi-boxes"></i><span>موجودی انبار</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Repairs"))
                {
                    <NavLink class="nav-link" href="repairs" @onclick="NotifyClose">
                        <i class="bi bi-tools"></i><span>تعمیرات</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Expenses"))
                {
                    <NavLink class="nav-link" href="expenses" @onclick="NotifyClose">
                        <i class="bi bi-cash-coin"></i><span>هزینه‌ها</span>
                    </NavLink>
                }
                @if (Auth.CanSee("TrsVouchers"))
                {
                    <NavLink class="nav-link" href="trs/vouchers" @onclick="NotifyClose">
                        <i class="bi bi-cash-stack"></i><span>تسویه فاکتورها</span>
                    </NavLink>
                }

                @* ---------- زیرمنوی گزارش‌های عملیات ---------- *@
                @if (ShowOpsReportsSub)
                {
                    <div class="nav-sub">
                        <button type="button" class="nav-toggle nav-sub-toggle @(gOpsReports ? "open" : "")" @onclick="() => gOpsReports = !gOpsReports">
                            <span><i class="bi bi-graph-up-arrow"></i>گزارش</span>
                            <i class="bi bi-chevron-down nav-chevron"></i>
                        </button>
                        @if (gOpsReports)
                        {
                            <div class="nav-sub-items">
                                @if (Auth.Has("ReportPages.Kardex"))
                                {
                                    <NavLink class="nav-link" href="operations/reports/kardex-quantity" @onclick="NotifyClose">
                                        <i class="bi bi-list-ol"></i><span>کاردکس تعداد کالاها</span>
                                    </NavLink>
                                    <NavLink class="nav-link" href="operations/reports/kardex-rial" @onclick="NotifyClose">
                                        <i class="bi bi-currency-exchange"></i><span>کاردکس ریالی کالاها</span>
                                    </NavLink>
                                }
                                @if (Auth.CanSee("Orders"))
                                {
                                    <NavLink class="nav-link" href="operations/reports/orders/purchase" @onclick="NotifyClose">
                                        <i class="bi bi-bag-check"></i><span>گزارش خرید</span>
                                    </NavLink>
                                    <NavLink class="nav-link" href="operations/reports/orders/sale" @onclick="NotifyClose">
                                        <i class="bi bi-cart-check"></i><span>گزارش فروش</span>
                                    </NavLink>
                                }
                                @if (Auth.CanSee("Orders") || Auth.CanSee("Repairs"))
                                {
                                    <NavLink class="nav-link" href="operations/reports/dashboard" @onclick="NotifyClose">
                                        <i class="bi bi-speedometer2"></i><span>داشبورد خرید، فروش، تعمیرات و معرف</span>
                                    </NavLink>
                                }
                            </div>
                        }
                    </div>
                }

                @* ---------- زیرمنوی اطلاعات پایه (داخل عملیات) ---------- *@
                @if (ShowOpsBaseSub)
                {
                    <div class="nav-sub">
                        <button type="button" class="nav-toggle nav-sub-toggle @(gOpsBase ? "open" : "")" @onclick="() => gOpsBase = !gOpsBase">
                            <span><i class="bi bi-database"></i>اطلاعات پایه</span>
                            <i class="bi bi-chevron-down nav-chevron"></i>
                        </button>
                        @if (gOpsBase)
                        {
                            <div class="nav-sub-items">
                                @if (Auth.CanSee("Products"))
                                {
                                    <NavLink class="nav-link" href="products" @onclick="NotifyClose">
                                        <i class="bi bi-box-seam"></i><span>کالاها</span>
                                    </NavLink>
                                    <NavLink class="nav-link" href="categories" @onclick="NotifyClose">
                                        <i class="bi bi-tags"></i><span>گروه‌های کالا</span>
                                    </NavLink>
                                    <NavLink class="nav-link" href="units" @onclick="NotifyClose">
                                        <i class="bi bi-rulers"></i><span>واحدهای شمارش</span>
                                    </NavLink>
                                }
                                @if (Auth.CanSee("Warehouses"))
                                {
                                    <NavLink class="nav-link" href="warehouses" @onclick="NotifyClose">
                                        <i class="bi bi-building"></i><span>انبارها</span>
                                    </NavLink>
                                }
                                @if (Auth.CanSee("Parties"))
                                {
                                    <NavLink class="nav-link" href="parties" @onclick="NotifyClose">
                                        <i class="bi bi-people"></i><span>طرف حساب‌ها</span>
                                    </NavLink>
                                }
                                @if (Auth.CanSee("Referrers"))
                                {
                                    <NavLink class="nav-link" href="referrers" @onclick="NotifyClose">
                                        <i class="bi bi-person-badge"></i><span>معرف‌ها</span>
                                    </NavLink>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
    }

    @* ============ عملیات مودیان — گروه مستقل (مجوز مودیان) ============ *@
    @if (ShowMoadianGroup)
    {
        <div class="nav-group group-moadian">
            <button type="button" class="nav-section-title nav-toggle @(gMoadian ? "open" : "")" @onclick="() => gMoadian = !gMoadian">
                <span><i class="bi bi-receipt-cutoff"></i>عملیات مودیان</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gMoadian)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="moadian/master-data" @onclick="NotifyClose">
                        <i class="bi bi-database"></i><span>اطلاعات پایه مودیان</span>
                    </NavLink>
                    <NavLink class="nav-link" href="moadian/invoices" @onclick="NotifyClose">
                        <i class="bi bi-list-ul"></i><span>فاکتورهای الکترونیکی</span>
                    </NavLink>
                    <NavLink class="nav-link" href="moadian/provider-invoices" @onclick="NotifyClose">
                        <i class="bi bi-receipt"></i><span>صورتحساب‌های خدمات‌دهنده</span>
                    </NavLink>
                    <NavLink class="nav-link" href="moadian/invoice-new" @onclick="NotifyClose">
                        <i class="bi bi-plus-square"></i><span>ثبت صورتحساب جدید</span>
                    </NavLink>
                    <NavLink class="nav-link" href="moadian/fiscal-years" @onclick="NotifyClose">
                        <i class="bi bi-calendar3"></i><span>سال مالی مودیان</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    <ErpWorkspaceNav OnNavigate="NotifyClose" />

    @* ============ مدیریت پروژه‌ها ============ *@
    @if (Auth.CanSee("Projects") || Auth.CanSee("ReportWorks") || Auth.CanSee("Karfarmas") || Auth.CanSee("TypeFactors"))
    {
        <div class="nav-group group-projects">
            <button type="button" class="nav-section-title nav-toggle @(gProjects ? "open" : "")" @onclick="() => gProjects = !gProjects">
                <span><i class="bi bi-kanban"></i>مدیریت پروژه‌ها</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gProjects)
            {
                <div class="nav-group-items">
                    @if (Auth.CanSee("Projects"))
                    {
                        <NavLink class="nav-link" href="projects" @onclick="NotifyClose">
                            <i class="bi bi-arrow-left-right"></i><span>ورود و خروج پروژه‌ها</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("ProjectCartable"))
                    {
                        <NavLink class="nav-link" href="project-cartable" @onclick="NotifyClose">
