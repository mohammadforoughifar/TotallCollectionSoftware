@inject IAuthState Auth
@inject NavigationManager NavManager

<div class="sidebar-nav">
    @* ============ پیام‌رسان سازمانی (ماژول مستقل) ============ *@
    @if (Auth.CanSee("Chat"))
    {
        <div class="nav-group group-chat">
            <button type="button" class="nav-section-title nav-toggle @(gChat ? "open" : "")" @onclick="() => gChat = !gChat">
                <span><i class="bi bi-chat-dots"></i>پیام‌رسان سازمانی</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gChat)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="chat" @onclick="NotifyClose">
                        <i class="bi bi-chat-dots-fill text-primary"></i><span>پیام‌رسان</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ داشبوردها — گروه فقط وقتی رندر می‌شود که حداقل یک آیتمش مجوز مشاهده داشته باشد ============ *@
    @if (ShowDashGroup)
    {
    <div class="nav-group group-dash">
        <button type="button" class="nav-section-title nav-toggle @(gDash ? "open" : "")" @onclick="() => gDash = !gDash">
            <span><i class="bi bi-grid-1x2"></i>داشبوردها</span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gDash)
        {
            <div class="nav-group-items">
                @if (CanSeeCartable)
                {
                <NavLink class="nav-link" href="cartable" @onclick="NotifyClose">
                    <i class="bi bi-inbox-fill"></i><span>کارتابل من</span>
                </NavLink>
                }
                @if (CanSeeMyArchive)
                {
                <NavLink class="nav-link" href="my-archive" @onclick="NotifyClose">
                    <i class="bi bi-archive-fill"></i><span>بایگانی شخصی</span>
                </NavLink>
                }
                @if (CanSeeMyDashboards)
                {
                <NavLink class="nav-link" href="my-dashboards" @onclick="NotifyClose">
                    <i class="bi bi-grid-1x2-fill"></i><span>داشبورد من</span>
                </NavLink>
                }
                @if (CanSeeReportStudio)
                {
                <NavLink class="nav-link" href="reports-hub" @onclick="NotifyClose">
                    <i class="bi bi-journal-text"></i><span>گزارش‌ها</span>
                </NavLink>
                <NavLink class="nav-link" href="report-studio" @onclick="NotifyClose">
                    <i class="bi bi-clipboard-data-fill"></i><span>گزارش‌ساز</span>
                </NavLink>
                }
                @if (Auth.Has("Dashboards.Financial"))
                {
                    <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="NotifyClose">
                        <i class="bi bi-speedometer2"></i><span>داشبورد مالی</span>
                    </NavLink>
                }
                @if (Auth.Has("Dashboards.Management"))
                {
                    <NavLink class="nav-link" href="dashboard-cctv" @onclick="NotifyClose">
                        <i class="bi bi-graph-up-arrow"></i><span>داشبورد مدیریت</span>
                    </NavLink>
                }
                @if (Auth.Has("Dashboards.Hardware"))
                {
                    <NavLink class="nav-link" href="dashboard-hardware" @onclick="NotifyClose">
                        <i class="bi bi-motherboard"></i><span>داشبورد سخت‌افزار</span>
                    </NavLink>
                }
            </div>
        }
    </div>
    }

    @* ============ دستور کار (ماژول مستقل — فقط با مجوز مشاهده) ============ *@
    @if (Auth.CanSee("WorkOrders"))
    {
        <div class="nav-group group-wo">
            <button type="button" class="nav-section-title nav-toggle @(gWo ? "open" : "")" @onclick="() => gWo = !gWo">
                <span><i class="bi bi-card-checklist"></i> دستور کار</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gWo)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="work-orders" @onclick="NotifyClose">
                        <i class="bi bi-card-checklist"></i><span>دستورهای کار</span>
                    </NavLink>
                    <NavLink class="nav-link" href="work-orders?tab=calendar" @onclick="NotifyClose">
                        <i class="bi bi-calendar-week-fill"></i><span>تقویم دستور کار</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ منابع انسانی بن‌سازه (ماژول مستقل) ============ *@
    @if (Auth.HasModule("RadisHr"))
    {
        <div class="nav-group group-bonhr">
            <button type="button" class="nav-section-title nav-toggle @(gBonHr ? "open" : "")" @onclick="() => gBonHr = !gBonHr">
                <span><i class="bi bi-people"></i>منابع انسانی بن‌سازه</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gBonHr)
            {
                <div class="nav-group-items">
                    @foreach (var item in BonHrNav.Items)
                    {
                        @if (Auth.Has("RadisHr.Access") || Auth.Has("RadisHr." + item.Section))
                        {
                        <NavLink class="nav-link" href="@item.Href" Match="@(item.Href == "bon-hr" ? NavLinkMatch.All : NavLinkMatch.Prefix)" @onclick="NotifyClose">
                            <i class="bi @item.Icon"></i><span>@item.Label</span>
                        </NavLink>
                        }
                    }
                </div>
            }
        </div>
    }

    <HrWorkspaceNav OnNavigate="NotifyClose" />

    @* ============ آرشیو اسناد و مدارک ============ *@
    @if (Auth.CanSee("DocArchive"))
    {
        <div class="nav-group group-docarchive">
            <button type="button" class="nav-section-title nav-toggle @(gDocs ? "open" : "")" @onclick="() => gDocs = !gDocs">
                <span><i class="bi bi-archive-fill"></i> آرشیو اسناد و مدارک</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gDocs)
            {
                <div class="nav-group-items">
                    @* فرم اصلی «آرشیو اسناد و مدارک» (پوشه‌ها و مدارک) — بازگشت لینک مستقیم به /doc-archive *@
                    <NavLink class="nav-link" href="doc-archive" @onclick="NotifyClose">
                        <i class="bi bi-folder2-open"></i><span>پوشه‌ها و مدارک</span>
                    </NavLink>
                    <NavLink class="nav-link" href="doc-archive/cartable" @onclick="NotifyClose">
                        <i class="bi bi-inbox"></i><span>کارتابل آرشیو</span>
                    </NavLink>
                    <NavLink class="nav-link" href="export-center" @onclick="NotifyClose">
                        <i class="bi bi-file-earmark-arrow-down"></i><span>مرکز خروجی</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ اتوماسیون اداری ============ *@
    @if (Auth.CanSee("InnerLetters") || Auth.CanSee("OutgoingLetters") || Auth.CanSee("Email"))
    {
        <div class="nav-group group-letters">
            <button type="button" class="nav-section-title nav-toggle @(gLetters ? "open" : "")" @onclick="() => gLetters = !gLetters">
                <span><i class="bi bi-envelope-paper"></i>اتوماسیون اداری</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gLetters)
            {
                <div class="nav-group-items">
                    @if (Auth.CanSee("InnerLetters"))
                    {
                        <NavLink class="nav-link" href="letters" @onclick="NotifyClose">
                            <i class="bi bi-envelope-paper"></i><span>کارتابل نامه داخلی</span>
                            @if (LettersUnreadCount > 0)
                            {
                                <span class="nav-badge">@LettersUnreadCount</span>
                            }
                        </NavLink>
                    }
                    @if (Auth.CanSee("IncomingLetters"))
                    {
                        <NavLink class="nav-link" href="incoming-letters" Match="NavLinkMatch.All" @onclick="NotifyClose">
                            <i class="bi bi-inbox-fill"></i><span>کارتابل نامه وارده</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("OutgoingLetters"))
                    {
                        <NavLink class="nav-link" href="outgoing-letters" Match="NavLinkMatch.All" @onclick="NotifyClose">
                            <i class="bi bi-send"></i><span>کارتابل نامه صادره</span>
                        </NavLink>
                        @if (Auth.Has("OutgoingLetters.Dabirkhane"))
                        {
                            <NavLink class="nav-link" href="outgoing-letters/dabirkhane" @onclick="NotifyClose">
                                <i class="bi bi-mailbox"></i><span>دبیرخانه یکپارچه اتوماسیون اداری</span>
                            </NavLink>
                        }
                    }
                    @if (Auth.CanSee("Email"))
                    {
                        <NavLink class="nav-link" href="office/email" @onclick="NotifyClose">
                            <i class="bi bi-envelope-at"></i><span>ایمیل سازمانی</span>
                        </NavLink>
                        <NavLink class="nav-link" href="office/personal-email" @onclick="NotifyClose">
                            <i class="bi bi-person-badge"></i><span>ایمیل شخصی</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    @* ============ فرم‌های متفرقه ============ *@
    @if (Auth.CanSee("MeetingMinutes"))
    {
        <div class="nav-group group-misc">
            <button type="button" class="nav-section-title nav-toggle @(gMisc ? "open" : "")" @onclick="() => gMisc = !gMisc">
                <span><i class="bi bi-files"></i>فرم‌های متفرقه</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gMisc)
            {
                <div class="nav-group-items">
                    <NavLink class="nav-link" href="misc/minutes" Match="NavLinkMatch.All" @onclick="NotifyClose">
                        <i class="bi bi-journal-text"></i><span>صورتجلسه</span>
                    </NavLink>
                </div>
            }
        </div>
    }

    @* ============ عملیات — گروه فقط با حداقل یک مجوز مشاهده ============ *@
    @if (ShowOpsGroup)
    {
    <div class="nav-group group-ops">
        <button type="button" class="nav-section-title nav-toggle @(gOps ? "open" : "")" @onclick="() => gOps = !gOps">
            <span><i class="bi bi-box-seam"></i>عملیات</span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gOps)
        {
            <div class="nav-group-items">
                @if (Auth.CanSee("Orders"))
                {
                    <NavLink class="nav-link" href="orders/purchase" @onclick="NotifyClose">
                        <i class="bi bi-bag-plus"></i><span>خرید</span>
                    </NavLink>
                    <NavLink class="nav-link" href="orders/sale" @onclick="NotifyClose">
                        <i class="bi bi-cart3"></i><span>فروش</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Stock"))
                {
                    <NavLink class="nav-link" href="stock" @onclick="NotifyClose">
                        <i class="bi bi-boxes"></i><span>موجودی انبار</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Repairs"))
                {
                    <NavLink class="nav-link" href="repairs" @onclick="NotifyClose">
                        <i class="bi bi-tools"></i><span>تعمیرات</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Expenses"))
                {
                    <NavLink class="nav-link" href="expenses" @onclick="NotifyClose">
                        <i class="bi bi-cash-coin"></i><span>هزینه‌ها</span>
                    </NavLink>
                }
            </div>
        }
    </div>
    }

    <ErpWorkspaceNav OnNavigate="NotifyClose" />

    @* ============ مدیریت پروژه‌ها ============ *@
    @if (Auth.CanSee("Projects") || Auth.CanSee("ReportWorks") || Auth.CanSee("Karfarmas") || Auth.CanSee("TypeFactors"))
    {
        <div class="nav-group group-projects">
            <button type="button" class="nav-section-title nav-toggle @(gProjects ? "open" : "")" @onclick="() => gProjects = !gProjects">
                <span><i class="bi bi-kanban"></i>مدیریت پروژه‌ها</span>
                <i class="bi bi-chevron-down nav-chevron"></i>
            </button>
            @if (gProjects)
            {
                <div class="nav-group-items">
                    @if (Auth.CanSee("Projects"))
                    {
                        <NavLink class="nav-link" href="projects" @onclick="NotifyClose">
                            <i class="bi bi-arrow-left-right"></i><span>ورود و خروج پروژه‌ها</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("ProjectCartable"))
                    {
                        <NavLink class="nav-link" href="project-cartable" @onclick="NotifyClose">
                            <i class="bi bi-inboxes"></i><span>کارتابل پروژه (مدیر/کارشناس)</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("ReportWorks"))
                    {
                        <NavLink class="nav-link" href="report-works" @onclick="NotifyClose">
                            <i class="bi bi-clock-history"></i><span>گزارش‌های کار</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("Karfarmas"))
                    {
                        <NavLink class="nav-link" href="karfarmas" @onclick="NotifyClose">
                            <i class="bi bi-briefcase"></i><span>کارفرماها</span>
                        </NavLink>
                    }
                    @if (Auth.CanSee("TypeFactors"))
                    {
                        <NavLink class="nav-link" href="type-factors" @onclick="NotifyClose">
                            <i class="bi bi-card-list"></i><span>انواع فاکتور</span>
                        </NavLink>
                    }
                </div>
            }
        </div>
    }

    @* ============ مدیریت سیستم — گروه فقط با حداقل یک مجوز مشاهده ============ *@
    @if (ShowAdminGroup)
    {
    <div class="nav-group group-admin">
        <button type="button" class="nav-section-title nav-toggle @(gAdmin ? "open" : "")" @onclick="() => gAdmin = !gAdmin">
            <span><i class="bi bi-pc-display"></i>مدیریت سیستم
                @if (NewSystemsCount > 0)
                {
                    <span class="nav-badge" title="سیستم جدید در انتظار تایید و/یا تغییرات سخت‌افزار گزارش‌شده">@NewSystemsCount.Num()</span>
                }
            </span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gAdmin)
        {
            <div class="nav-group-items">
                @if (Auth.CanSee("ItRequests"))
                {
                    <NavLink class="nav-link" href="it-requests" @onclick="NotifyClose">
                        <i class="bi bi-headset"></i><span>درخواست خدمت IT</span>
                    </NavLink>
                }
                @if (Auth.CanSee("SystemUsers"))
                {
                    <NavLink class="nav-link" href="system-info" @onclick="NotifyClose">
                        <i class="bi bi-list-check"></i><span>سیستم‌های ثبت‌شده</span>
                        @if (NewSystemsCount > 0)
                        {
                            <span class="nav-badge" title="سیستم جدید در انتظار تایید و/یا تغییرات سخت‌افزار گزارش‌شده">@NewSystemsCount.Num()</span>
                        }
                    </NavLink>
                }
                @if (Auth.CanSee("CctvCameras"))
                {
                    <NavLink class="nav-link" href="cctv-cameras" @onclick="NotifyClose">
                        <i class="bi bi-camera-video-fill"></i><span>دوربین‌های مداربسته</span>
                    </NavLink>
                }
                @if (Auth.CanSee("CctvNvrs"))
                {
                    <NavLink class="nav-link" href="cctv-nvrs" @onclick="NotifyClose">
                        <i class="bi bi-hdd-stack-fill"></i><span>دستگاه‌های NVR</span>
                    </NavLink>
                }
                @if (Auth.CanSee("SystemUsers"))
                {
                    <NavLink class="nav-link" href="office-machines" @onclick="NotifyClose">
                        <i class="bi bi-printer-fill"></i><span>ماشین‌های اداری</span>
                    </NavLink>
                    <NavLink class="nav-link" href="system-id" @onclick="NotifyClose">
                        <i class="bi bi-cpu-fill"></i><span>شناسنامه سیستم</span>
                    </NavLink>
                    <NavLink class="nav-link" href="system-users" @onclick="NotifyClose">
                        <i class="bi bi-people-fill"></i><span>کاربران سیستم</span>
                    </NavLink>
                    <NavLink class="nav-link" href="network-scan" @onclick="NotifyClose">
                        <i class="bi bi-broadcast-pin"></i><span>اسکن شبکه</span>
                    </NavLink>
                }
            </div>
        }
    </div>
    }

    @* ============ گزارش‌ها — گروه فقط با حداقل یک مجوز مشاهده ============ *@
    @if (ShowReportsGroup)
    {
    <div class="nav-group group-reports">
        <button type="button" class="nav-section-title nav-toggle @(gReports ? "open" : "")" @onclick="() => gReports = !gReports">
            <span><i class="bi bi-file-bar-graph"></i>گزارش‌ها
                @if (ReorderCount > 0)
                {
                    <span class="nav-badge">@ReorderCount.Num()</span>
                }
            </span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gReports)
        {
            <div class="nav-group-items">
                @if (Auth.Has("ReportPages.Kardex"))
                {
                    <NavLink class="nav-link" href="reports/kardex" @onclick="NotifyClose">
                        <i class="bi bi-bar-chart-line"></i><span>کاردکس کالا</span>
                    </NavLink>
                }
                @if (Auth.Has("ReportPages.Reorder"))
                {
                    <NavLink class="nav-link" href="reports/reorder" @onclick="NotifyClose">
                        <i class="bi bi-exclamation-triangle"></i><span>نقطه سفارش</span>
                        @if (ReorderCount > 0)
                        {
                            <span class="nav-badge">@ReorderCount.Num()</span>
                        }
                    </NavLink>
                }
            </div>
        }
    </div>
    }

    @* ============ اطلاعات پایه — گروه فقط با حداقل یک مجوز مشاهده ============ *@
    @if (ShowBaseGroup)
    {
    <div class="nav-group group-base">
        <button type="button" class="nav-section-title nav-toggle @(gBase ? "open" : "")" @onclick="() => gBase = !gBase">
            <span><i class="bi bi-database"></i>اطلاعات پایه</span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gBase)
        {
            <div class="nav-group-items">
                @if (Auth.CanSee("Products"))
                {
                    <NavLink class="nav-link" href="products" @onclick="NotifyClose">
                        <i class="bi bi-box-seam"></i><span>کالاها</span>
                    </NavLink>
                    <NavLink class="nav-link" href="categories" @onclick="NotifyClose">
                        <i class="bi bi-tags"></i><span>گروه‌های کالا</span>
                    </NavLink>
                    <NavLink class="nav-link" href="units" @onclick="NotifyClose">
                        <i class="bi bi-rulers"></i><span>واحدهای شمارش</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Warehouses"))
                {
                    <NavLink class="nav-link" href="warehouses" @onclick="NotifyClose">
                        <i class="bi bi-building"></i><span>انبارها</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Parties"))
                {
                    <NavLink class="nav-link" href="parties" @onclick="NotifyClose">
                        <i class="bi bi-people"></i><span>طرف حساب‌ها</span>
                    </NavLink>
                }
                @if (Auth.CanSee("Referrers"))
                {
                    <NavLink class="nav-link" href="referrers" @onclick="NotifyClose">
                        <i class="bi bi-person-badge"></i><span>معرف‌ها</span>
                    </NavLink>
                }
                @if (Auth.CanSee("ReferrerWallets"))
                {
                    <NavLink class="nav-link" href="referrer-wallets" @onclick="NotifyClose">
                        <i class="bi bi-wallet2"></i><span>کیف پول معرف‌ها</span>
                    </NavLink>
                }
                @if (Auth.CanSee("SystemCompanies"))
                {
                    <NavLink class="nav-link" href="system-company" @onclick="NotifyClose">
                        <i class="bi bi-building-fill"></i><span>شرکت‌ها و شعب</span>
                    </NavLink>
                }
                @if (Auth.CanSee("SystemDepartments"))
                {
                    <NavLink class="nav-link" href="system-department" @onclick="NotifyClose">
                        <i class="bi bi-diagram-3-fill"></i><span>واحدهای سازمانی</span>
                    </NavLink>
                }
            </div>
        }
    </div>
    }

    @* ============ سیستم — گروه فقط با حداقل یک مجوز مشاهده ============ *@
    @if (ShowSysGroup)
    {
    <div class="nav-group group-sys">
        <button type="button" class="nav-section-title nav-toggle @(gSys ? "open" : "")" @onclick="() => gSys = !gSys">
            <span><i class="bi bi-gear-fill"></i>سیستم</span>
            <i class="bi bi-chevron-down nav-chevron"></i>
        </button>
        @if (gSys)
        {
            <div class="nav-group-items">
                @if (CanSeeSettings)
                {
                    <NavLink class="nav-link" href="settings" @onclick="NotifyClose">
                        <i class="bi bi-gear"></i><span>تنظیمات</span>
                    </NavLink>
                    @if (Auth.Has("LetterStructures.Read"))
                    {
                        <NavLink class="nav-link" href="settings/letter-structure" @onclick="NotifyClose">
                            <i class="bi bi-diagram-2"></i><span>ساختار شماره نامه</span>
                        </NavLink>
                    }
                    <NavLink class="nav-link" href="settings/audit-log" @onclick="NotifyClose">
                        <i class="bi bi-clipboard-data"></i><span>لاگ عملیات</span>
                    </NavLink>
                }
                @if (Auth.CanSee("SystemUsers"))
                {
                    <NavLink class="nav-link" href="users" @onclick="NotifyClose">
                        <i class="bi bi-shield-lock"></i><span>کاربران</span>
                    </NavLink>
                }
            </div>
        }
    </div>
    }
</div>

@code {
    [Parameter] public int ReorderCount { get; set; }
    [Parameter] public int NewSystemsCount { get; set; }
    [Parameter] public int LettersUnreadCount { get; set; }
    [Parameter] public EventCallback OnNavigate { get; set; }

    private bool gDash, gOps, gProjects, gAdmin, gReports, gBase, gSys, gWo, gBonHr, gLetters, gDocs, gChat, gMisc;

    // ================== مجوز «مشاهده» = مبنای نمایش در منو ==================
    // اگر در «تنظیمات ← نقش‌ها و دسترسی‌ها» تیک مشاهدهٔ یک ماژول برداشته شود،
    // آیتم مربوطه و (در صورت خالی‌شدن) کل گروه منو رندر نمی‌شود.
    private bool CanSeeCartable => Auth.CanSee("MyCartable");
    private bool CanSeeMyArchive => Auth.CanSee("MyArchive");
    private bool CanSeeMyDashboards => Auth.CanSee("MyDashboards");
    private bool CanSeeReportStudio => Auth.CanSee("ReportStudio");
    private bool CanSeeAnyDashboard => Auth.Has("Dashboards.Financial")
                                    || Auth.Has("Dashboards.Management")
                                    || Auth.Has("Dashboards.Hardware");

    private bool ShowDashGroup => CanSeeCartable || CanSeeMyArchive || CanSeeMyDashboards
                                  || CanSeeReportStudio || CanSeeAnyDashboard;
    private bool ShowOpsGroup => ModuleAccess.CanSeeAny(Auth, "Orders", "Stock", "Repairs", "Expenses");
    private bool ShowAdminGroup => ModuleAccess.CanSeeAny(Auth, "ItRequests", "SystemUsers", "CctvCameras", "CctvNvrs");
    private bool ShowReportsGroup => Auth.Has("ReportPages.Kardex") || Auth.Has("ReportPages.Reorder");
    private bool ShowBaseGroup => ModuleAccess.CanSeeAny(Auth, "Products", "Warehouses", "Parties",
                                                         "Referrers", "ReferrerWallets",
                                                         "SystemCompanies", "SystemDepartments");
    private bool ShowSysGroup => CanSeeSettings || Auth.CanSee("SystemUsers");

    /// <summary>ورود به بخش تنظیمات — فقط مدیر و با مجوز مشاهدهٔ ماژول تنظیمات.</summary>
    private bool CanSeeSettings => Auth.IsAdmin && Auth.CanSee("Settings");

    protected override void OnInitialized()
    {
        // پیش‌فرض: همه‌ی گروه‌ها بسته — فقط گروهی که صفحه‌ی فعلی داخل آن است باز می‌شود
        var p = NavManager.ToBaseRelativePath(NavManager.Uri).TrimEnd('/').ToLowerInvariant();

        gChat = p.StartsWith("chat");
        gDash = p == "" || p.StartsWith("dashboard") || p.StartsWith("cartable") || p.StartsWith("my-archive") || p.StartsWith("my-dashboards") || p.StartsWith("report-studio") || p.StartsWith("reports-hub");
        gWo = p.StartsWith("work-orders");
        gBonHr = p == "bon-hr" || p.StartsWith("bon-hr/");
        gLetters = p.StartsWith("letters");
        gMisc = p.StartsWith("misc");
        gDocs = p.StartsWith("doc-archive");
        gProjects = p.StartsWith("projects") || p.StartsWith("project-cartable") || p.StartsWith("report-works") || p.StartsWith("karfarmas") || p.StartsWith("type-factors");
        gOps = p.StartsWith("orders") || p.StartsWith("stock") || p.StartsWith("repairs") || p.StartsWith("expenses");
        gAdmin = p.StartsWith("system-") && !p.StartsWith("system-company") && !p.StartsWith("system-department") || p.StartsWith("network-scan") || p.StartsWith("cctv") || p.StartsWith("office-machines") || p.StartsWith("it-requests");
        gReports = p.StartsWith("reports");
        gBase = p.StartsWith("products") || p.StartsWith("categories") || p.StartsWith("units") ||
                p.StartsWith("warehouses") || p.StartsWith("parties") || p.StartsWith("referrer") ||
                p.StartsWith("system-company") || p.StartsWith("system-department");
        gSys = p.StartsWith("users") || p.StartsWith("settings") || p.StartsWith("my-");
        
    }

    private async Task NotifyClose() => await OnNavigate.InvokeAsync();
}
