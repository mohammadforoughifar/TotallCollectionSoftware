{
  // آدرس پایه‌ی API سرور (بدون اسلش آخر)
  // نمونه شبکه داخلی: "http://192.168.1.10:5000"
  "server": "http://localhost:5000",

  // فاصله‌ی ارسال دوره‌ای در حالت watch (دقیقه)
  "intervalMinutes": 60,

  // شناسه‌ی ثابت این سیستم — اگر خالی باشد، ایجنت خودکار می‌سازد و ذخیره می‌کند.
  // برای اینکه سیستمی همیشه با یک شناسه شناخته شود، می‌توانید دستی مقدار بدهید، مثل: "PC-101"
  "agentId": "",

  // توکن JWT — فعلاً لازم نیست (endpoint ایجنت باز است). برای آینده نگه داشته شده.
  "token": "",

  // ورود با نام کاربری/رمز برای گرفتن خودکار توکن (اختیاری)
  "username": "",
  "password": "",

  // نادیده گرفتن خطای گواهی HTTPS — فقط در شبکه‌ی داخلی و با آگاهی فعال کنید
  "insecure": false
}
