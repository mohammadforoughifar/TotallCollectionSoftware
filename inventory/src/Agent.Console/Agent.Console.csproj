<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- نام فایل اجرایی نهایی -->
    <AssemblyName>InventoryAgent</AssemblyName>
    <RootNamespace>InventoryAgent</RootNamespace>
    <Version>1.0.0</Version>
    <Description>ایجنت جمع‌آوری مشخصات سخت‌افزار کلاینت‌ها و ارسال به API مدیریت سخت‌افزار (Inventory)</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- دسترسی به WMI ویندوز (فقط روی ویندوز استفاده می‌شود؛ روی لینوکس فراخوانی نمی‌شود) -->
    <PackageReference Include="System.Management" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="agent.sample.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
