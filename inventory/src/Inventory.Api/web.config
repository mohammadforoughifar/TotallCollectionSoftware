<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- SignalR WebSocket URLs carry the JWT in access_token. The automation
         JWT contains module permissions and can exceed IIS's default 2048
         character query-string limit. -->
    <security>
      <requestFiltering>
        <!-- بدون محدودیت حجم آپلود/پیوست فایل (IIS): بیشینهٔ مقدار مجاز maxAllowedContentLength -->
        <requestLimits maxQueryString="32768" maxUrl="65536" maxAllowedContentLength="4294967295" />
      </requestFiltering>
    </security>
    <webSocket enabled="true" />
  </system.webServer>
</configuration>
