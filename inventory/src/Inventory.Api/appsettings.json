{
  // کلید مشترک ایجنت‌های سخت‌افزار — اگر مقداری بگذارید، سه مسیر ایجنت
  // (ثبت گزارش، دریافت دستور، گزارش نتیجهٔ دستور) فقط با هدر X-Agent-Key پذیرفته می‌شوند.
  // خالی = باز (سازگار با ایجنت‌های قدیمی). همان مقدار را در agent.json کلاینت‌ها بگذارید.
  // معادل متغیر محیطی: AGENT_KEY
  "Agent": {
    "Key": ""
  },
  "Database": {
    "Provider": "SqlServer",
    "SeedDemoData": false
  },
  "Files": {
    // کلید رمزنگاری پیوست‌های پروژه — اختیاری؛ اگر خالی باشد کلیدی تصادفی در SecureFiles/.key ساخته می‌شود (بکاپ بگیرید!)
    "EncryptionKey": "",
    // پوشه‌ی ذخیره‌سازی پیوست‌ها — اختیاری؛ پیش‌فرض: wwwroot/SecureFiles
    "SecureRoot": "",
    // ذخیره‌گاه فایل‌های پیام‌رسان (خارج از wwwroot) — اختیاری؛ خالی = App_Data/chat کنار API.
    // ⚠️ بعد از اولین استقرار، مقدار خالی را رها نکنید: App_Data زیر پوشهٔ ریلیز ساخته می‌شود و با
    // استقرار در پوشهٔ تازه، فایل‌های قبلی برای دانلود «روی سرور یافت نمی‌شوند».
    // مقدار پیشنهادی: مسیر پایدار/اشتراکی مثل  D:\ChatFiles  (یا  /var/lib/totall/chat) و همان مقدار
    // روی همهٔ نمونه‌ها/نسخه‌ها؛ معادل متغیر محیط:  Files__ChatRoot=C:\ChatFiles
    "ChatRoot": "",
    // محل فایل‌های قدیمی چت از نسخه‌های قبل (uploads/chat داخل wwwroot) برای سازگاری دانلود پیام‌های قدیمی.
    // خالی = wwwroot/uploads/chat کنار API. معادل متغیر محیط:  Files__ChatLegacyRoot
    "ChatLegacyRoot": ""
  },
  "ConnectionStrings": {
    "Default": "Server=.;Database=InventoryDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
  },
  // HTTPS داخلی — لازم برای «اعلان سیستمی» مرورگر (اندروید/ویندوز) که فقط روی HTTPS کار می‌کند.
  // گواهی داخلی خودکار ساخته می‌شود (CA + گواهی سرور برای همهٔ آی‌پی‌های شبکه) و راهنمای نصب روی گوشی در
  // آدرس  http://<آی‌پی-سرور>:<پورت>/https-setup  و دانلود گواهی در  /ca.crt  در دسترس است.
  "Https": {
    "Enabled": true,          // false = خاموش‌کردن شنوندهٔ HTTPS (اعلان سیستمی غیرفعال می‌شود)
    "Port": 5443,             // پورت HTTPS داخلی (معادل متغیر محیطی: HTTPS_PORT)
    "DataDir": "",            // محل ذخیرهٔ گواهی‌ها؛ خالی = مسیر پایدار پیش‌فرض (ویندوز: ProgramData\Totall\https)
    "Hosts": "",              // نام/آی‌پی اضافه برای داخل گواهی داخلی، با کاما (مثلاً آی‌پی عمومی: 1.2.3.4,erp.local)
    "ExtraPorts": "",         // پورت‌های HTTPS اضافه با کاما؛ مثلاً "443" تا نشانی بیرونی بدون شماره پورت باز شود
    "PublicPort": 0,          // پورتی که کاربران بیرونی می‌بینند (برای هدایت خودکار)؛ 0 = همان Port
    "RedirectHttp": false,    // true = بازکردن صفحه با http:// خودکار به https:// برود (/https-setup و /ca.crt مستثنا)
    // گواهی عمومی معتبر برای دامنهٔ واقعی (مثلاً Let's Encrypt با tools\https\setup-https.ps1 -LetsEncrypt).
    // برای نام‌های داخل این گواهی، همین گواهی ارسال می‌شود (بدون نیاز به نصب ca.crt روی گوشی)؛ بقیه = گواهی داخلی.
    // تمدید خودکار فایل، بدون ری‌استارت اعمال می‌شود.
    "PublicCertificate": {
      "Path": "",             // خالی = <DataDir>\public\public.pfx
      "Password": ""          // خالی = خواندن از فایل public.pfx.pwd کنار همان فایل
    }
  },
  // نوتیفیکیشن گوشی/تبلت (Web Push) — کلیدهای VAPID
  // برای امنیت در محیط عملیاتی می‌توانید از متغیر محیطی VAPID_PUBLIC_KEY / VAPID_PRIVATE_KEY استفاده کنید
  // کلید خصوصی در مخزن نگهداری نشود؛ کلید تازه و پایدار را از تنظیمات امن محیط تزریق کنید.
  "PushNotifications": {
    "VapidSubject": "mailto:admin@example.com",
    "VapidPublicKey": "",
    "VapidPrivateKey": ""
  },
  // پیامک کاوه‌نگار برای دستور کار و تأیید موبایل پروفایل — کلید را در appsettings یا Git ذخیره نکنید.
  // معادل متغیرهای محیطی: KavenegarSms__ApiKey ، KavenegarSms__Sender ، KavenegarSms__TimeoutSeconds
  "KavenegarSms": {
    "ApiKey": "",
    "Sender": "2000660110",
    "TimeoutSeconds": 20
  },
  // تنظیمات OTP پروفایل. ایمیل تا زمانی که SMTP کامل پیکربندی نشده باشد غیرفعال می‌ماند.
  // رمز را داخل Git نگذارید؛ از متغیرهای محیطی ProfileOtp__Email__* یا Secret Store استفاده کنید.
  // محدودیت پیش‌فرض: اعتبار ۵ دقیقه، فاصلهٔ ارسال ۶۰ ثانیه، حداکثر ۵ ارسال در ساعت و ۵ تلاش.
  "ProfileOtp": {
    "CodeTtlMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxSendsPerHour": 5,
    "MaxInvalidAttempts": 5,
    "LockoutMinutes": 10,
    "Email": {
      "Host": "",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "FromAddress": "",
      "FromName": "نرم‌افزار یکپارچه فروغ آریا",
      "TimeoutSeconds": 20
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Letters": {
    // سازمان اولیه‌ای که در اولین اجرا ساخته می‌شود — مبنای جزء «واحد» در شماره اندیکاتور
    // (پس از ساخته‌شدن، سازمان‌ها از جدول Organization مدیریت می‌شوند و NameUniq آن‌ها در شماره می‌نشیند)
    "UnitName": "مدیریت کیفیت",
    "UnitCode": "MQ"
  },
  "Reporting": {
    "Stimulsoft": {
      // موتور اصلی چاپ نامه صادره؛ در صورت نبود قالب یا خطای رندر، QuestPDF استفاده می‌شود.
      "Enabled": true,
      "FallbackToQuestPdf": true,
      // فقط برای تست اولیه؛ بعد از افزوده‌شدن جدول امضاهای کاربران false شود.
      "UseTestSignature": true,
      // الگو: Reports/OutgoingLetters/Companies/{CompanyId}/Outgoing-{A4|A5}.mrt
      "TemplateRoot": "Reports/OutgoingLetters/Companies"
    }
  },
  // ================= هوش مصنوعی فروغ آریا (مدل لوکال) =================
  // دستیار مرکزی + هوش نامه‌ها + منشی کارمندی — راهنمای نصب: inventory/AI-SETUP-FA.md
  // ---- کانال درخواست خدمات IT بین شرکت‌ها (راه‌دور) ----
  // آدرس سرورِ مرکزی که نسخهٔ نصب‌شده در شرکت‌های دیگر درخواست‌ها را به آن می‌فرستد.
  // این مقدار فقط «پیش‌فرضِ پیشنهادی» است؛ مدیر هر شرکت می‌تواند در
  // «تنظیمات ← اتصال به واحد IT مرکزی» آدرس دیگری وارد کند.
  // اگر خالی باشد، فیلد آدرس خالی می‌ماند و کاربر خودش وارد می‌کند.
  // معادل متغیر محیطی: It__CentralServerUrl
  "It": {
    "CentralServerUrl": "http://94.183.59.57:4456"
  },

  // پیش‌فرض: Ollama روی همان سرور. اگر مدل نصب نباشد، دستیار در «حالت آفلاین»
  // همچنان به سؤال‌های پرتکرار (مرخصی، فیش، حضور، نامه‌ها) جواب می‌دهد.
  // معادل متغیرهای محیطی: Ai__BaseUrl ، Ai__ChatModel ، Ai__EmbeddingModel ، Ai__Enabled
  "Ai": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434/v1",
    "ApiKey": "",
    "ChatModel": "qwen3.5:latest",
    "EmbeddingModel": "bge-m3",
    // ---- تبدیل ویس (پیام صوتی پیام‌رسان) به متن ----
    // قرارداد OpenAI: POST {TranscriptionBaseUrl}/audio/transcriptions
    // پیش‌فرض روی «سرویس محلی آمادهٔ خودمان» تنظیم است: پوشهٔ stt-service در ریشهٔ مخزن
    //   ویندوز: stt-service\run_windows.bat      لینوکس: ./stt-service/run.sh
    //   (رایگان، بدون کلید، بدون اینترنت بعد از یک‌بار دانلود مدل — راهنما: stt-service/README.md)
    // گزینه‌های دیگر: OpenAI → whisper-1 | Groq → whisper-large-v3 |
    //                 هر سرور سازگار دیگر (speaches / faster-whisper-server) → نام مدل آن سرویس
    // ⚠️ اگر سرویس محلی را اجرا نمی‌کنید و سرویس دیگری هم ندارید، هر دو مقدار را خالی بگذارید
    //    تا دکمهٔ «تبدیل به متن» پیام راهنمای تنظیمات بدهد.
    // معادل متغیر محیطی: Ai__TranscriptionModel ، Ai__TranscriptionBaseUrl ، Ai__TranscriptionApiKey
    "TranscriptionModel": "small",
    "TranscriptionBaseUrl": "http://127.0.0.1:9000/v1",
    "TranscriptionApiKey": "",
    "TranscriptionLanguage": "fa",
    "TranscriptionMaxMegabytes": 24,
    "TimeoutSeconds": 180,
    "MaxToolIterations": 6,
    "MaxHistoryMessages": 12,
    "MaxMessagesPerUserPerDay": 200,
    "BaleEnabled": true,
    "MessengerEnabled": true,
    "BriefingEnabled": true,
    "BriefingTime": "07:30",
    "BriefingChequeDays": 7,
    "BriefingDeadlineDays": 2,
    "PendingActionExpiryMinutes": 15
  },
  // ================= سرویس OCR پایتون (اختیاری) =================
  // تشخیص متن تصویر و PDF اسکن‌شده (فارسی/انگلیسی) — پوشهٔ ocr-service کنار همین پروژه.
  // خالی = موتور محلی قدیمی روی همین سرور (نیازمند نصب tesseract + poppler-utils روی سرور).
  // اگر سرویس پایتون را روی همین ماشین اجرا می‌کنید:
  //     "BaseUrl": "http://127.0.0.1:8765"
  // اگر BaseUrl خالی باشد ولی AutoDetect=true، برنامه هنگام بالا آمدن سرویس پیش‌فرض
  // 127.0.0.1:8765 را خودش جستجو و وصل می‌شود (فقط سرویس‌هایی که خودش را totall-ocr معرفی کنند).
  // معادل متغیرهای محیطی (برای استقرار): OcrService__BaseUrl ، OcrService__ApiKey ، OcrService__TimeoutSeconds
  "OcrService": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 600,
    "AutoDetect": true
  },

  // ================= میز کار توسعه — وب‌هوک گیت =================
  // Secret را در محیط عملیاتی با متغیر DEVTEAM_GIT_WEBHOOK_SECRET یا DevTeam__GitWebhookSecret بگذارید.
  // GitHub: Settings → Webhooks → Payload URL = https://YOUR/api/dev-team/hooks/github
  //         Secret = همین مقدار؛ Content type = application/json؛ Event = push
  // GitLab: Settings → Webhooks → URL = https://YOUR/api/dev-team/hooks/gitlab
  //         Secret token = همین مقدار؛ Push events
  // در پیام کامیت: DT-1405-0001  یا  task:12  و اختیاری  mod:Office
  // CI: POST /api/dev-team/hooks/ci|github-ci|gitlab-ci + X-DevTeam-Token (failure → Problem)
  "DevTeam": {
    "GitWebhookEnabled": true,
    "GitWebhookSecret": ""
  }
}
