{
  // ======== تنظیمات محیط عملیاتی (ویندوز سرور) ========
  // این فایل روی appsettings.json سوار می‌شود (فقط در ASPNETCORE_ENVIRONMENT=Production).
  // همان مقادیر در start.bat / run-server.bat هم به‌صورت متغیر محیطی ست شده‌اند؛
  // متغیرهای محیطی بر این فایل تقدّم دارند.
  "Database": {
    "Provider": "SqlServer",
    "SeedDemoData": false
  },
  "ConnectionStrings": {
    // SQL Server روی همین سرور 192.168.30.104 — کاربر sa
    "Default": "Server=192.168.30.104;Database=InventoryDb;User Id=sa;Password=Mohammad011700;Persist Security Info=True;TrustServerCertificate=True;Encrypt=False;MultipleActiveResultSets=True"
  },
  // HTTPS داخلی (برای اعلان سیستمی مرورگر) — سامانه هم روی http://192.168.30.104:8181
  // و هم روی https://192.168.30.104:5443 در دسترس است. برای خاموش‌کردن: "Enabled": false
  "Https": {
    "Enabled": true,
    "Port": 5443,
    "RedirectHttp": false
  },
  "AllowedHosts": "*"
}
