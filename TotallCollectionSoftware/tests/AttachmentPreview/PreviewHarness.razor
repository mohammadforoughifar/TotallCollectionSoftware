@page "/"
@inject FixtureAuthState Auth
@inject IToastService Toast

<h1 style="font-size:22px">آزمایش مؤلفه‌های واقعی پیوست</h1>
<p>این میزبان فقط برای آزمون است؛ کنترلر، مجوزها، مودال و JavaScript از سورس اصلی استفاده می‌شوند.</p>
<div style="display:flex;gap:8px;margin:12px 0">
    <button type="button" data-mode="read" @onclick="() => Mode(101,101)">خواندن، بدون دانلود</button>
    <button type="button" data-mode="download" @onclick="() => Mode(102,101)">اجازهٔ دانلود</button>
    <button type="button" data-mode="secret" @onclick="() => Mode(101,102)">محرمانه</button>
    <button type="button" data-mode="watermark" @onclick="() => Mode(101,103)">واترمارک</button>
</div>
<p data-context>user=@Auth.UserId version=@version</p>
<form @onsubmit="Submitted" @onsubmit:preventDefault="true">
    <AttachmentBox @key="generation" Module="DocVersion" RefId="version" CanUpload="false" TextPreviewApi="/api/doc-archive/attachments" />
</form>
<span data-form-submits>@submits</span>
@foreach (var t in Toast.Toasts) { <p data-toast>@t.Message</p> }

@code {
    private int version = 101, generation, submits;
    private void Mode(int user, int reference) { Auth.SetUser(user); version = reference; generation++; }
    private void Submitted() => submits++;
}
