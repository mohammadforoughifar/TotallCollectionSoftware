<Project Sdk="Microsoft.NET.Sdk.Web">
  <!--
    مینی‌پروژهٔ پشتیبانی لایسنس — همسایهٔ پوشهٔ inventory و مستقل از برنامهٔ مشتری.
    کد فرم‌ها/سرویس‌ها از یک منبع تک‌نسخه خوانده می‌شود (inventory/tools/LicenseSigner) تا
    دو نسخه از منطق امضا/چرخهٔ درخواست ساخته نشود؛ فقط پیکربندی و اجرا این‌جاست.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>LicenseSigner</RootNamespace>
    <AssemblyName>SupportPanel</AssemblyName>
    <UserSecretsId>support-panel-licensing</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- کد و صفحات: از منبع مشترک inventory/tools/LicenseSigner -->
    <Compile Include="../inventory/tools/LicenseSigner/**/*.cs"
             Exclude="../inventory/tools/LicenseSigner/bin/**;../inventory/tools/LicenseSigner/obj/**"
             LinkBase="Shared" />
    <Content Include="../inventory/tools/LicenseSigner/Pages/**/*.cshtml" LinkBase="Pages" />

    <!-- wwwroot مشترک: هنگام build در پوشهٔ همین پروژه کپی می‌شود تا هم `dotnet run`
         و هم `dotnet publish` فایل‌های ایستا را درست سرو کنند (پوشه gitignore است). -->
    <SharedWwwroot Include="../inventory/tools/LicenseSigner/wwwroot/**/*" />
  </ItemGroup>

  <Target Name="CopySharedWwwroot" BeforeTargets="Build;Publish">
    <Copy SourceFiles="@(SharedWwwroot)"
          DestinationFolder="$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.8" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../inventory/src/Inventory.Licensing/Inventory.Licensing.csproj" />
  </ItemGroup>
</Project>
