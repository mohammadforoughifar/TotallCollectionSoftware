@page "/"
@inject SupportDbContext Db
@{
    ViewData["Title"] = "داشبورد";
    var customers = await Db.Customers.CountAsync();
    var activeCustomers = await Db.Customers.CountAsync(c => c.IsActive && c.MergedIntoId == null);
    var contacts = await Db.Contacts.CountAsync();
    var users = await Db.Users.CountAsync(u => u.IsActive);
    var recentCustomers = await Db.Customers.AsNoTracking()
        .OrderByDescending(c => c.Id).Take(8).ToListAsync();
    var recentAudit = await Db.AuditLogs.AsNoTracking()
        .OrderByDescending(a => a.Id).Take(8).ToListAsync();
}
<div class="page-head">
    <div><h1>داشبورد</h1><p class="lead">@JalaliDate.FullNow() (تهران)</p></div>
    <div class="ms-auto">
        <a class="btn ghost" href="/Customers/Edit">مشتری تازه</a>
        <a class="btn" href="/Customers">فهرست مشتریان</a>
    </div>
</div>

<div class="grid">
    <div class="card"><div class="card-body">
        <div class="hint">مشتریان</div><div class="stat">@Ui.N(customers)</div></div></div>
    <div class="card"><div class="card-body">
        <div class="hint">مشتریان فعال</div><div class="stat">@Ui.N(activeCustomers)</div></div></div>
    <div class="card"><div class="card-body">
        <div class="hint">شخص‌های تماس</div><div class="stat">@Ui.N(contacts)</div></div></div>
    <div class="card"><div class="card-body">
        <div class="hint">کاربران پنل</div><div class="stat">@Ui.N(users)</div></div></div>
</div>

<div class="card">
    <div class="card-head">مشتریان تازه</div>
    <table>
        <thead><tr><th>کد</th><th>نام</th><th>تلفن</th><th>ثبت</th><th></th></tr></thead>
        <tbody>
        @if (recentCustomers.Count == 0)
        {
            <tr><td colspan="5" class="muted">هنوز مشتری‌ای ثبت نشده است.</td></tr>
        }
        @foreach (var row in recentCustomers)
        {
            <tr>
                <td class="mono">@row.Code</td>
                <td>@row.Name</td>
                <td class="mono">@(row.Phone ?? "—")</td>
                <td>@JalaliDate.Short(row.CreatedAt)</td>
                <td><a href="/Customers/Edit?id=@row.Id">بازکردن</a></td>
            </tr>
        }
        </tbody>
    </table>
</div>

<div class="card">
    <div class="card-head">آخرین رخدادهای ممیزی</div>
    <table>
        <thead><tr><th>زمان</th><th>کاربر</th><th>کار</th><th>موجودیت</th></tr></thead>
        <tbody>
        @if (recentAudit.Count == 0)
        {
            <tr><td colspan="4" class="muted">رخدادی ثبت نشده است.</td></tr>
        }
        @foreach (var row in recentAudit)
        {
            <tr>
                <td>@JalaliDate.Full(row.At)</td>
                <td>@row.UserName</td>
                <td class="mono">@row.Action</td>
                <td class="mono">@row.Entity@(string.IsNullOrEmpty(row.EntityId) ? "" : "#" + row.EntityId)</td>
            </tr>
        }
        </tbody>
    </table>
</div>
