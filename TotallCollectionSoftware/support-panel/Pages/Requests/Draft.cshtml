@page "/Requests/Draft"
@inject SupportDbContext Db
@inject DraftService Drafts
@inject SigningRunner Signing
@{
    ViewData["Title"] = "پیش‌نویس امضا";
}
@functions {
    public int RequestId { get; set; }
    public string Error { get; set; } = "";
    public string OkMessage { get; set; } = "";
    public string PreviewText { get; set; } = "";
    public string TermMode { get; set; } = "months";
    public string Months { get; set; } = "12";
    public string UntilText { get; set; } = "";
    public string UpdatesUntilText { get; set; } = "";
    public string UserMode { get; set; } = "Named";
    public string UserMax { get; set; } = "5";
    public string Exempt { get; set; } = "0";
    public string AppliesTo { get; set; } = "Global";
    public string DeploymentValue { get; set; } = "OnPrem";
    public List<string> PresetsSelected { get; set; } = new();
    public List<string> ModulesSelected { get; set; } = new();

    /// <summary>قابلیت‌های داخلی انتخاب‌شده (مثل letter.incoming زیر اتوماسیون اداری).</summary>
    public List<string> FeaturesSelected { get; set; } = new();
    public string Note { get; set; } = "";

    /// <summary>متن خطی شرکت‌های مجاز: companyId | نام | سقف‌کاربر | ماژول‌ها</summary>
    public string CompaniesText { get; set; } = "";

    /// <summary>منبع پیشنهاد شرکت‌ها: request | خالی</summary>
    public string CompaniesFrom { get; set; } = "";

    /// <summary>شناسهٔ شرکتِ داخل فایل درخواست — هر لایسنس برای همین یک شرکت صادر می‌شود.</summary>
    public string RequestCompanyId { get; set; } = "";

    /// <summary>نام همان شرکت (از فایل درخواست).</summary>
    public string RequestCompanyName { get; set; } = "";

    /// <summary>سقف کاربر اختیاری همین یک شرکت (خالی = تابع سقف پیش‌نویس).</summary>
    public string CompanySeats { get; set; } = "";

    /// <summary>شرکت مرجع را از درخواست می‌خواند (شناسه + نام) — پیش از خواندن فرم.</summary>
    private async Task LoadRequestCompanyAsync()
    {
        var company = await Drafts.RequestCompanyAsync(RequestId);
        if (company is not { } req) return;
        RequestCompanyId = req.CompanyId;
        RequestCompanyName = req.Name ?? "";
    }

    /// <summary>
    /// متن «شرکت‌های مجاز» را می‌سازد. اگر درخواست شرکت داشته باشد، هویت همان شرکت است و
    /// فقط سقف کاربر اختیاری از فرم خوانده می‌شود (یک شرکت — یک لایسنس).
    /// </summary>
    private string ComposeCompaniesText()
    {
        if (string.IsNullOrWhiteSpace(RequestCompanyId))
            return Request.Form["companies"].ToString();

        var line = RequestCompanyId.Trim();
        if (!string.IsNullOrWhiteSpace(RequestCompanyName)) line += " | " + RequestCompanyName.Trim();

        var seatsText = Request.Form["companySeats"].ToString();
        if (int.TryParse(seatsText, out var seats) && seats > 0) line += " | " + seats;
        return line;
    }

    /// <summary>خطاهای تجزیهٔ خط شرکت‌ها (نمایش مستقیم به کاربر)</summary>
    public List<string> CompanyErrors { get; set; } = new();

    /// <summary>منبع پیشنهاد ماژول‌ها: request | last-license | خالی</summary>
    public string SuggestedFrom { get; set; } = "";

    private async Task LoadAsync()
    {
        await LoadRequestCompanyAsync();
        var existing = await Drafts.CurrentAsync(RequestId);
        if (existing is null)
        {
            // پیش‌نویس تازه: ماژول‌ها از درخواست مشتری یا آخرین لایسنس همان مشتری پیشنهاد می‌شود
            var (suggested, suggestedPresets, source) = await Drafts.SuggestModulesAsync(RequestId);
            ModulesSelected = suggested;
            if (suggestedPresets.Count > 0) PresetsSelected = suggestedPresets;
            SuggestedFrom = source;

            // شرکت: همیشه همان شرکتِ داخل فایل درخواست (یک شرکت — یک لایسنس).
            var (suggestedCompanies, companiesSource) = await Drafts.SuggestCompaniesAsync(RequestId);
            if (suggestedCompanies.Count > 0)
            {
                CompaniesText = DraftService.ToCompanyText(suggestedCompanies);
                CompaniesFrom = companiesSource;
            }
            return;
        }
        TermMode = existing.TermMode;
        Months = (existing.Months ?? 12).ToString();
        UntilText = existing.Until is { } until ? JalaliDate.Short(until) : "";
        UpdatesUntilText = existing.UpdatesUntil is { } updates ? JalaliDate.Short(updates) : "";
        UserMode = existing.UserMode;
        UserMax = existing.UserMax.ToString();
        Exempt = existing.Exempt.ToString();
        AppliesTo = existing.AppliesTo;
        DeploymentValue = existing.Deployment;
        PresetsSelected = DraftService.SplitCsv(existing.PresetsCsv).ToList();
        ModulesSelected = DraftService.SplitCsv(existing.ModulesCsv).ToList();
        FeaturesSelected = DraftService.SplitCsv(existing.FeaturesCsv).ToList();
        Note = existing.Note ?? "";
        CompaniesText = DraftService.ToCompanyText(DraftService.FromCompaniesJson(existing.CompaniesJson));

        // اگر درخواست شرکتِ مشخص دارد، نمایش «شرکت این لایسنس» از فایل درخواست می‌آید.
        if (!string.IsNullOrWhiteSpace(RequestCompanyId))
        {
            var line = RequestCompanyId.Trim()
                       + (string.IsNullOrWhiteSpace(RequestCompanyName) ? "" : " | " + RequestCompanyName.Trim());
            CompaniesText = line;
            CompaniesFrom = "request";
            var existingCompany = DraftService.FromCompaniesJson(existing.CompaniesJson).FirstOrDefault();
            if (existingCompany?.MaxUsers is > 0) CompanySeats = existingCompany.MaxUsers!.Value.ToString();
        }
    }

    private void ReadForm()
    {
        TermMode = Request.Form["termMode"].ToString() is { Length: > 0 } mode ? mode : "months";
        Months = Request.Form["months"].ToString();
        UntilText = Request.Form["until"].ToString();
        UpdatesUntilText = Request.Form["updatesUntil"].ToString();
        UserMode = Request.Form["userMode"].ToString() is { Length: > 0 } user ? user : "Named";
        UserMax = Request.Form["userMax"].ToString();
        Exempt = Request.Form["exempt"].ToString();
        AppliesTo = Request.Form["appliesTo"].ToString() is { Length: > 0 } scope ? scope : "Global";
        DeploymentValue = Request.Form["deployment"].ToString() is { Length: > 0 } deploy ? deploy : "OnPrem";
        Note = Request.Form["note"].ToString();
        CompanySeats = Request.Form["companySeats"].ToString();
        CompaniesText = ComposeCompaniesText();
        PresetsSelected = Request.Form["presets"].Where(v => !string.IsNullOrWhiteSpace(v)).ToList()!;
        ModulesSelected = Request.Form["modules"].Where(v => !string.IsNullOrWhiteSpace(v)).ToList()!;
        FeaturesSelected = Request.Form["features"].Where(v => !string.IsNullOrWhiteSpace(v)).ToList()!;
    }

    private LicenseDraft BuildFromForm()
    {
        var draft = new LicenseDraft
        {
            RequestId = RequestId,
            Deployment = DeploymentValue,
            TermMode = TermMode,
            Months = int.TryParse(Months, out var months) ? months : null,
            UserMode = UserMode,
            UserMax = int.TryParse(UserMax, out var userMax) ? userMax : 0,
            Exempt = int.TryParse(Exempt, out var exempt) ? exempt : 0,
            AppliesTo = AppliesTo,
            PresetsCsv = string.Join(",", PresetsSelected),
            ModulesCsv = string.Join(",", ModulesSelected),
            FeaturesCsv = string.Join(",", FeaturesSelected),
            CompaniesJson = CompaniesText,
            Note = Note
        };

        if (JalaliDate.TryParse(UntilText, out var until)) draft.Until = until;
        if (JalaliDate.TryParse(UpdatesUntilText, out var updates)) draft.UpdatesUntil = updates;
        return draft;
    }

    private int ResolveId()
    {
        if (int.TryParse(Request.Query["id"], out var fromQuery) && fromQuery > 0) return fromQuery;
        if (Request.HasFormContentType && int.TryParse(Request.Form["id"], out var fromForm)) return fromForm;
        return 0;
    }

    public async Task<IActionResult> OnPostSaveAsync()
    {
        RequestId = ResolveId();
        await LoadRequestCompanyAsync();
        ReadForm();
        var actor = await Db.Users.FirstAsync(u => u.Id == User.UserId());
        var (ok, error) = await Drafts.SaveAsync(RequestId, BuildFromForm(), actor, HttpContext.RequestServices.GetRequiredService<RequestService>());
        if (!ok)
        {
            Error = error ?? "ذخیرهٔ پیش‌نویس انجام نشد.";
            await LoadAsync();
            return Page();
        }

        TempData["ok"] = "پیش‌نویس ذخیره شد.";
        return Redirect($"/Requests/Draft?id={RequestId}");
    }

    public Task<IActionResult> OnPostAsync() => OnPostSaveAsync();

    /// <summary>پرکردن ماژول‌ها از آخرین لایسنس صادرشدهٔ همین مشتری (بدون ذخیره).</summary>
    public async Task<IActionResult> OnPostCopyLastAsync()
    {
        RequestId = ResolveId();
        await LoadRequestCompanyAsync();
        ReadForm();
        var (modules, presets, _) = await Drafts.SuggestModulesAsync(RequestId);
        ModulesSelected = modules;
        if (presets.Count > 0) PresetsSelected = presets;
        FeaturesSelected = new List<string>();   // قابلیت‌ها را دستی تیک بزنید
        SuggestedFrom = (modules.Count > 0 || presets.Count > 0) ? "last-license" : "";
        Error = SuggestedFrom.Length > 0 ? "" : "پیش‌نویس امضاشده‌ای برای این مشتری پیدا نشد.";
        if (SuggestedFrom.Length > 0) OkMessage = "ماژول‌ها از آخرین لایسنس همین مشتری پر شد؛ ذخیره را بزنید.";
        return Page();
    }

    /// <summary>یک گروه نمایشی از ماژول‌ها برای فهرست چک‌باکسی.</summary>
    public sealed record ModuleGroupView(string Title, List<Inventory.Licensing.Modules.ModuleDefinition> Modules);

    /// <summary>
    /// گروه‌بندی نمایشی ماژول‌ها (هم‌راستا با دسته‌بندی فرم نقش‌ها): پایه، فروش و انبار، مالی و اداری،
    /// اتوماسیون و آرشیو، منابع انسانی، هوش و گزارش، سایر.
    /// </summary>
    private static List<ModuleGroupView> BuildModuleGroups(List<Inventory.Licensing.Modules.ModuleDefinition> modules)
    {
        var map = new Dictionary<string, string[]>(StringComparer.OrdinalIgnoreCase)
        {
            ["base"] = new[] { "core", "dashboard", "cartable", "backup", "licensing" },
            ["trade"] = new[] { "catalog", "sales", "salesvisit", "warehousing", "stocktaking", "invoicing", "moadian" },
            ["finance"] = new[] { "accounting", "treasury", "expenses", "repairs", "projects", "workorders" },
            ["office"] = new[] { "letters", "docarchive", "office_assets", "it_assets", "chat" },
            ["hr"] = new[] { "hr_fa", "hr_core", "faham_att", "faham_pay", "faham_lms", "faham_com", "bon_hr" },
            ["insight"] = new[] { "ai", "reports", "devteam" }
        };
        var titles = new (string Key, string Title)[]
        {
            ("base", "پایه (همیشه‌فعال)"),
            ("trade", "فروش، خرید و انبار"),
            ("finance", "مالی و اداری"),
            ("office", "اتوماسیون، آرشیو و ارتباطات"),
            ("hr", "منابع انسانی"),
            ("insight", "هوش، گزارش و توسعه")
        };

        var groups = new List<ModuleGroupView>();
        var placed = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var (key, title) in titles)
        {
            var list = new List<Inventory.Licensing.Modules.ModuleDefinition>();
            if (map.TryGetValue(key, out var codes))
                foreach (var code in codes)
                {
                    var module = modules.FirstOrDefault(m => string.Equals(m.Code, code, StringComparison.OrdinalIgnoreCase));
                    if (module is not null && placed.Add(module.Code)) list.Add(module);
                }
            if (list.Count > 0) groups.Add(new ModuleGroupView(title, list));
        }

        var rest = modules.Where(m => !placed.Contains(m.Code)).ToList();
        if (rest.Count > 0) groups.Add(new ModuleGroupView("سایر ماژول‌ها", rest));
        return groups;
    }

    public async Task<IActionResult> OnPostPreviewAsync()
    {
        RequestId = ResolveId();
        await LoadRequestCompanyAsync();
        ReadForm();
        var actor = await Db.Users.FirstAsync(u => u.Id == User.UserId());
        var requests = HttpContext.RequestServices.GetRequiredService<RequestService>();
        var (ok, error) = await Drafts.SaveAsync(RequestId, BuildFromForm(), actor, requests);
        if (!ok)
        {
            Error = error ?? "پیش‌نویس ذخیره نشد.";
            return Page();
        }

        var outcome = await Signing.PreviewAsync(RequestId);
        PreviewText = outcome.Preview;
        if (!string.IsNullOrEmpty(outcome.Error)) Error = outcome.Error;
        else OkMessage = "پیش‌نمایش ابزار آماده است (هیچ فایلی امضا نشده).";
        return Page();
    }
}
@{
    RequestId = ResolveId();
    if (Request.Method == "GET") { await LoadAsync(); }

    var request = await Db.Requests.AsNoTracking().Include(r => r.Customer)
        .FirstOrDefaultAsync(r => r.Id == RequestId);
    ViewData["Request"] = request;
    var presets = await Db.Presets.AsNoTracking().Where(p => p.IsActive).OrderBy(p => p.Code).ToListAsync();
    var modules = Inventory.Licensing.Modules.ModuleCodes.All.ToList();
    var ModuleGroups = BuildModuleGroups(modules);
    var req = request;
}
@if (TempData["ok"] is string okMessage && !string.IsNullOrEmpty(okMessage)) { <div class="alert ok">@okMessage</div> }
@if (!string.IsNullOrEmpty(Error)) { <div class="alert error">@Error</div> }
@if (!string.IsNullOrEmpty(OkMessage)) { <div class="alert ok">@OkMessage</div> }

@if (req is null)
{
    <div class="alert error">درخواست پیدا نشد.</div>
}
else
{
    <div class="page-head">
        <div><h1>پیش‌نویس امضا — <span class="mono">@req.RequestNo</span></h1>
            <p class="lead">@(req.Customer?.Name ?? "مشتری تعیین نشده") · شناسهٔ نصب <span class="mono">@req.InstallationId</span></p></div>
        <div class="ms-auto">
            <a class="btn ghost" href="/Requests/Details?id=@req.Id">بازگشت</a>
            @if (req.Status == RequestStatus.Approved)
            {
                <a class="btn" href="/Requests/Sign?id=@req.Id">رفتن به امضا</a>
            }
        </div>
    </div>

    <form method="post">
        <input type="hidden" name="id" value="@req.Id" />
        <div class="card"><div class="card-head">۱) آیتم‌ها و مدت</div><div class="card-body">
            <div class="grid">
                <div class="field" style="grid-column:1 / -1">
                    <label>ماژول‌ها و قابلیت‌ها (چندانتخابی — تیک بزنید)</label>
                    <p class="hint" style="margin:.2rem 0 .6rem;line-height:1.9">
                        فهرست، همان ماژول‌های نرم‌افزار است (هم‌راستا با فرم نقش‌ها در تنظیمات). هر ماژول تیک بخورد،
                        در سند امضاشده می‌نشیند. قابلیت‌های داخلی هر ماژول با تورفتگی زیر آن آمده‌اند — مثلاً
                        <b>نامهٔ وارده</b> زیر <b>اتوماسیون اداری</b>. اگر هیچ قابلیتی تیک نخورد، همهٔ قابلیت‌های
                        ماژول‌های انتخاب‌شده مجاز است.
                    </p>
                    <div class="module-list">
                        @foreach (var group in ModuleGroups)
                        {
                            <div class="module-group">
                                <div class="module-group-head">@group.Title</div>
                                @foreach (var module in group.Modules)
                                {
                                    var isOn = module.AlwaysOn;
                                    var isChecked = isOn || ModulesSelected.Contains(module.Code, StringComparer.OrdinalIgnoreCase);
                                    var features = Inventory.Licensing.Modules.FeatureCodes.ForModule(module.Code);
                                    <div class="module-row">
                                        <label class="module-check">
                                            <input type="checkbox" name="modules" value="@module.Code"
                                                   class="module-toggle" data-module="@module.Code"
                                                   checked="@isChecked" disabled="@isOn" />
                                            <span class="module-title">@module.Title</span>
                                            <span class="mono module-code">@module.Code</span>
                                            @if (isOn)
                                            {
                                                <span class="tag">همیشه‌فعال</span>
                                            }
                                        </label>
                                        @foreach (var feature in features)
                                        {
                                            var featureChecked = FeaturesSelected.Contains(feature.Code, StringComparer.OrdinalIgnoreCase);
                                            <label class="module-check feature-check">
                                                <input type="checkbox" name="features" value="@feature.Code"
                                                       class="feature-toggle" data-parent="@module.Code"
                                                       checked="@featureChecked" disabled="@(!isChecked)" />
                                                <span>@feature.Title</span>
                                                <span class="mono module-code">@feature.Code</span>
                                            </label>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    </div>
                    <p class="hint" style="margin:.5rem 0 0;line-height:1.9">
                        @if (SuggestedFrom == "request")
                        {
                            <text>ماژول‌ها به‌صورت خودکار از <b>فایل درخواست همین مشتری</b> تیک خوردند؛ هر تغییری لازم است همین‌جا بدهید.</text>
                        }
                        else if (SuggestedFrom == "last-license")
                        {
                            <text>ماژول‌ها از <b>آخرین لایسنس صادرشدهٔ همین مشتری</b> پیشنهاد شده‌اند (فقط پیشنهاد، نه امضا).</text>
                        }
                        else
                        {
                            <text>درخواست مشتری ماژولی همراه نداشت؛ می‌توانید از دکمهٔ «کپی از آخرین لایسنس مشتری» استفاده کنید.</text>
                        }
                    </p>
                    <p style="margin:.4rem 0 0">
                        <button type="submit" formnovalidate asp-page-handler="CopyLast" class="btn small ghost">کپی از آخرین لایسنس مشتری</button>
                    </p>
                </div>
                <div>
                    <div class="field"><label for="termMode">حالت مدت</label>
                        <select id="termMode" name="termMode">
                            <option value="months" selected="@(TermMode == "months")">ماه‌شمار</option>
                            <option value="until" selected="@(TermMode == "until")">تاریخ پایان</option>
                            <option value="perpetual" selected="@(TermMode == "perpetual")">دائمی</option>
                        </select></div>
                    <div class="field"><label for="months">مدت (ماه)</label><input id="months" name="months" class="mono" value="@Months" /></div>
                    <div class="field"><label for="until">تاریخ پایان (شمسی)</label><input id="until" name="until" class="mono jdate" value="@UntilText" /></div>
                    <div class="field"><label for="updatesUntil">به‌روزرسانی تا (شمسی)</label><input id="updatesUntil" name="updatesUntil" class="mono jdate" value="@UpdatesUntilText" /></div>
                    <div class="field"><label for="deployment">حالت استقرار</label>
                        <select id="deployment" name="deployment">
                            <option value="OnPrem" selected="@(DeploymentValue == "OnPrem")">OnPrem</option>
                            <option value="Saas" selected="@(DeploymentValue == "Saas")">SaaS</option>
                        </select>
                        <p class="hint" style="margin:.35rem 0 0;line-height:1.9">
                            <b>OnPrem</b>: نصب روی سرور خودِ مشتری؛ لایسنس به «شناسهٔ نصب» همان سرور گره می‌خورد و
                            روی نصب دیگر کار نمی‌کند (خطای <span class="mono">INSTALLATION_MISMATCH</span>) — برای مشتریانی
                            که داده را بیرون نمی‌برند.<br />
                            <b>SaaS</b>: سرویس میزبانی‌شدهٔ ما؛ لایسنس به شناسهٔ نصب گره نمی‌خورد و دامنه با
                            «PerTenant» (هر مستأجر = یک نصب) کنترل می‌شود — برای مشتریانی که نسخهٔ ابری می‌خواهند.
                        </p></div>
                </div>
            </div>
        </div></div>

        <div class="card"><div class="card-head">۲) کاربران و دامنه</div><div class="card-body">
            <div class="grid">
                <div class="field"><label for="userMode">حالت کاربر</label>
                    <select id="userMode" name="userMode">
                        @foreach (var mode in new[] { "Named", "Concurrent", "None" })
                        {
                            <option value="@mode" selected="@(UserMode == mode)">@mode</option>
                        }
                    </select>
                    <p class="hint" style="margin:.35rem 0 0;line-height:1.9">
                        <b>Named</b>: کاربر نام‌دار — به تعداد حساب‌های فعال شمرده می‌شود (سقف = «سقف کاربر»).<br />
                        <b>Concurrent</b>: کاربر هم‌زمان — به تعداد نشست‌های باز شمرده می‌شود، نه تعداد حساب‌ها.<br />
                        <b>None</b>: این آیتم سهمیهٔ کاربر ندارد (مثلاً فقط سهمیهٔ فاکتور می‌فروشد)؛ سقف و معاف نادیده گرفته می‌شود.
                    </p></div>
                <div class="field"><label for="userMax">سقف کاربر</label><input id="userMax" name="userMax" class="mono" value="@UserMax" /></div>
                <div class="field"><label for="exempt">کاربران مستثنا</label><input id="exempt" name="exempt" class="mono" value="@Exempt" />
                    <p class="hint" style="margin:.35rem 0 0;line-height:1.9">
                        حساب‌های معاف (مدیر سیستم/ناظر/سرویس) که از سقف صندلی کم نمی‌شوند. عدد باید از
                        «سقف کاربر» بیشتر نباشد و در حالت None بی‌اثر است.
                    </p></div>
                <div class="field"><label for="appliesTo">دامنه</label>
                    <select id="appliesTo" name="appliesTo">
                        @foreach (var scope in new[] { "Global", "Modules", "PerTenant" })
                        {
                            <option value="@scope" selected="@(AppliesTo == scope)">@scope</option>
                        }
                    </select>
                    <p class="hint" style="margin:.35rem 0 0;line-height:1.9">
                        <b>Global</b>: سهمیه روی همهٔ کاربران همان نصب شمرده می‌شود.<br />
                        <b>Modules</b>: فقط کاربرانی که به ماژول‌های همین آیتم دسترسی دارند شمرده می‌شوند
                        (سقف به‌ازای ماژول).<br />
                        <b>PerTenant</b>: مخصوص SaaS؛ در فایل .lic به Global نگاشت می‌شود چون هر مستأجر
                        نصب/لایسنس مستقل دارد.
                    </p></div>
            </div>
            <div class="field">
                <label>شرکت مجاز این لایسنس (از فایل درخواست)</label>
                @if (!string.IsNullOrWhiteSpace(RequestCompanyId))
                {
                    <div class="company-single">
                        <span class="tag">یک شرکت — یک لایسنس</span>
                        <div style="margin:.35rem 0 .5rem">
                            <b>@(string.IsNullOrWhiteSpace(RequestCompanyName) ? "(بدون نام)" : RequestCompanyName)</b>
                            <span class="mono" style="margin-inline-start:.5rem">@RequestCompanyId</span>
                        </div>
                        <div class="field" style="margin:0">
                            <label for="companySeats">سقف کاربر این شرکت (اختیاری)</label>
                            <input id="companySeats" name="companySeats" type="number" min="0" max="100000"
                                   value="@CompanySeats" placeholder="خالی = تابع سقف کاربر پیش‌نویس" />
                        </div>
                    </div>
                    <p class="hint" style="margin:.5rem 0 0;line-height:1.9">
                        شناسه و نام شرکت از <b>فایل درخواست همین مشتری</b> خوانده می‌شود و در بخش «شرکت‌های مجاز»
                        سند امضاشده می‌نشیند؛ قابل ویرایش دستی نیست تا لایسنس به شرکت اشتباه داده نشود.<br />
                        برای شرکت دیگر، <b>درخواست و لایسنس جداگانه</b> صادر کنید (هر فعال‌سازی = یک شرکت).
                        ماژول‌های این شرکت همان ماژول‌های تیک‌خوردهٔ همین پیش‌نویس است و جمع سقف کاربران از
                        «سقف کاربر» بالا بیشتر نمی‌شود.
                    </p>
                }
                else
                {
                    <textarea id="companies" name="companies" class="mono" rows="2" spellcheck="false"
                              placeholder="C-1001 | شرکت الف | 5">@CompaniesText</textarea>
                    <p class="hint" style="margin:.35rem 0 0;line-height:1.9">
                        در فایل درخواست این مشتری شناسهٔ شرکت نیامده است (فایل قدیمی است یا از نسخه‌ای
                        گرفته شده که شرکت را همراه فایل نمی‌فرستاد). راه درست: از نرم‌افزار مشتری
                        «فایل درخواست» را دوباره بگیرید — نسخهٔ فعلی شناسه و نام شرکت را همراه فایل می‌فرستد.
                        اگر گرفتن فایل تازه ممکن نیست، یک خط بنویسید:
                        <span class="mono">شناسه | نام | سقف‌کاربر | ماژول‌ها</span> — فقط شناسه اجباری است.<br />
                        <b>هر لایسنس فقط برای یک شرکت</b> است؛ بیش از یک خط، هنگام ذخیره رد می‌شود.
                        خالی گذاشتن = بدون محدودیت شرکت (رفتار قدیمی).
                    </p>
                }
                @if (CompanyErrors.Count > 0)
                {
                    <ul class="hint" style="margin:.35rem 0 0;color:#b42318">
                        @foreach (var companyError in CompanyErrors) { <li>@companyError</li> }
                    </ul>
                }
            </div>
            <div class="field"><label for="note">یادداشت پیش‌نویس</label><input id="note" name="note" value="@Note" /></div>
            <p>
                <button type="submit" class="btn">ذخیرهٔ پیش‌نویس</button>
                <button type="submit" formaction="?handler=Preview" class="btn ghost">پیش‌نمایش ابزار (بدون امضا)</button>
            </p>
            <p class="hint">پروفایل ذخیره‌شده مبنای امضاست، نه ورودی فرم.</p>
        </div></div>
    </form>

    <script>
        // تیک ماژول ⇒ قابلیت‌های همان ماژول فعال می‌شوند؛ برداشتن تیک ⇒ قابلیت‌ها هم پاک می‌شوند.
        document.querySelectorAll('input.module-toggle').forEach(function (box) {
            box.addEventListener('change', function () {
                document.querySelectorAll('input.feature-toggle[data-parent="' + box.dataset.module + '"]')
                    .forEach(function (child) {
                        child.disabled = !box.checked;
                        if (!box.checked) child.checked = false;
                    });
            });
        });
        // تیک قابلیت ⇒ ماژول والدش هم تیک می‌خورد.
        document.querySelectorAll('input.feature-toggle').forEach(function (box) {
            box.addEventListener('change', function () {
                if (!box.checked) return;
                var parent = document.querySelector('input.module-toggle[data-module="' + box.dataset.parent + '"]');
                if (parent && !parent.checked) { parent.checked = true; }
            });
        });
    </script>

    @if (!string.IsNullOrWhiteSpace(PreviewText))
    {
        <div class="card"><div class="card-head">خروجی ابزار (کد ۳ = پیش‌نمایش، هیچ فایلی نوشته نشد)</div>
            <div class="card-body"><pre>@PreviewText</pre></div></div>
    }
}
