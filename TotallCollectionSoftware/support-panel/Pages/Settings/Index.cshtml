@page "/Settings"
@attribute [Authorize(Roles = "Admin")]
@inject SupportDbContext Db
@inject SupportSettingsService Settings
@inject AuditChainService Audit
@inject SigningRunner Signing
@inject SignerKeyService Keys
@inject SignerOptions Options
@{
    ViewData["Title"] = "تنظیمات";
}
@functions {
    public string Error { get; set; } = "";
    public string OkMessage { get; set; } = "";
    public KeyGenResult? KeyResult { get; set; }
    public KeyPasswordCheck? PasswordCheck { get; set; }
    public List<string> KeyWarnings { get; set; } = new();

    public async Task<IActionResult> OnPostKeygenAsync()
    {
        var keyId = Request.Form["keyId"].ToString();
        var folder = Request.Form["keyFolder"].ToString();
        var password = Request.Form["keyPass"].ToString();
        var confirm = Request.Form["keyPass2"].ToString();
        var overwrite = Request.Form["overwrite"].ToString() == "on";

        if (password != confirm)
        {
            Error = "رمز و تکرار رمز یکسان نیستند.";
            return Page();
        }

        var actor = await Db.Users.FirstAsync(u => u.Id == User.UserId());
        KeyResult = await Keys.CreateAsync(keyId, folder, password, overwrite, actor);
        if (!KeyResult.Ok) Error = KeyResult.Message;
        else
        {
            OkMessage = KeyResult.Message;
            KeyWarnings = KeyResult.Warnings;
        }
        return Page();
    }

    public IActionResult OnPostCheckKeyPass()
    {
        PasswordCheck = Keys.CheckPassword(Request.Form["checkPass"].ToString());
        return Page();
    }

    public async Task<IActionResult> OnPostKeyDisconnectAsync()
    {
        var actor = await Db.Users.FirstAsync(u => u.Id == User.UserId());
        await Keys.DisconnectAsync(actor);
        OkMessage = "اتصال از کلید ثبت‌شده قطع شد (فایل کلیدها پاک نشد).";
        return Page();
    }

    public async Task<IActionResult> OnPostSmtpAsync()
    {
        var current = await Settings.GetSmtpAsync();
        var host = Request.Form["host"].ToString().Trim();
        var user = Request.Form["user"].ToString().Trim();
        var from = Request.Form["from"].ToString().Trim();
        var fromName = Request.Form["fromName"].ToString().Trim();
        var port = int.TryParse(Request.Form["port"], out var parsedPort) && parsedPort is > 0 and < 65535 ? parsedPort : 587;
        var startTls = Request.Form["starttls"].ToString() == "on";
        var timeout = int.TryParse(Request.Form["timeout"], out var parsedTimeout) ? Math.Clamp(parsedTimeout, 5, 120) : current.TimeoutSeconds;

        var actor = await Db.Users.FirstAsync(u => u.Id == User.UserId());
        await Settings.SaveSmtpAsync(new SmtpSettings(host, port, user, from, fromName.Length == 0 ? "پشتیبانی لایسنس" : fromName, startTls, timeout), actor, Audit);
        OkMessage = "تنظیمات SMTP ذخیره شد (رمز در DB ذخیره نمی‌شود).";
        return Page();
    }

    public async Task<IActionResult> OnPostTemplateAsync()
    {
        var actor = await Db.Users.FirstAsync(u => u.Id == User.UserId());
        await Settings.SaveTemplateAsync(Request.Form["subject"].ToString(), Request.Form["body"].ToString(), actor, Audit);
        OkMessage = "قالب ایمیل ذخیره شد.";
        return Page();
    }
}
@{
    var signStatus = Signing.GetStatus();
    var savedKey = await Keys.LoadAsync();
    var smtp = await Settings.GetSmtpAsync();
    var template = await Settings.GetTemplateAsync();
    var passwordAvailable = Settings.SmtpPasswordAvailable;
}
<div class="page-head"><div><h1>تنظیمات</h1>
    <p class="lead">SMTP (اختیاری)، قالب ایمیل تحویل و کاربران پنل</p></div>
    <div class="ms-auto"><a class="btn ghost" href="/Settings/Users">کاربران</a></div>
</div>
@if (!string.IsNullOrEmpty(OkMessage)) { <div class="alert ok">@OkMessage</div> }
@if (!string.IsNullOrEmpty(Error)) { <div class="alert error">@Error</div> }

<div class="card"><div class="card-head">کلیدهای امضا — ساخت خودکار جفت‌کلید</div><div class="card-body">
    <table class="table">
        <tr><th style="width:34%">مورد</th><th style="width:16%">وضعیت</th><th>مقدار فعلی</th></tr>
        <tr><td>ابزار LicenseTool</td>
            <td>@(signStatus.ToolPath is null ? Html.Raw("<span class=\"badge err\">پیدا نشد</span>") : Html.Raw("<span class=\"badge ok\">آماده</span>"))</td>
            <td class="mono">@(signStatus.ToolPath ?? "—")</td></tr>
        <tr><td>کلید خصوصی</td>
            <td>@(signStatus.PrivateKeyFound ? Html.Raw("<span class=\"badge ok\">یافت شد</span>") : Html.Raw("<span class=\"badge err\">پیدا نشد</span>"))</td>
            <td class="mono">@(signStatus.PrivateKeyPath is { Length: > 0 } p ? p : "—")</td></tr>
        <tr><td>کلید عمومی</td>
            <td>@(signStatus.PublicKeyFound ? Html.Raw("<span class=\"badge ok\">یافت شد</span>") : Html.Raw("<span class=\"badge err\">پیدا نشد</span>"))</td>
            <td class="mono">@(signStatus.PublicKeyPath is { Length: > 0 } pu ? pu : "—")</td></tr>
        <tr><td>Key ID</td>
            <td>@(string.IsNullOrWhiteSpace(signStatus.KeyId) ? "—" : Html.Raw("<span class=\"badge ok\">تعیین‌شده</span>"))</td>
            <td class="mono">@(signStatus.KeyId is { Length: > 0 } k ? k : "—")</td></tr>
        <tr><td>منبع کلید فعال</td><td colspan="2">
            @if (savedKey is not null && System.IO.File.Exists(savedKey.PrivateKeyPath))
            {
                <span>ساخته‌شده از همین صفحه — شناسهٔ <span class="mono">@savedKey.KeyId</span>،
                    اثر انگشت <span class="mono small">@(savedKey.Fingerprint is { Length: > 16 } fp ? fp[..16] + "…" : savedKey.Fingerprint)</span></span>
            }
            else
            {
                <span>پیکربندی محیطی (<span class="mono">Signer__PrivateKeyPath</span>) — هیچ کلیدی از این صفحه ساخته نشده است.</span>
            }
            @if (signStatus.Ready)
            {
                <div class="hint" style="margin:.35rem 0 0">وضعیت کلی: <b>آمادهٔ امضا</b> — گذرواژهٔ کلید هنگام امضا در فرم وارد می‌شود.</div>
            }
            else
            {
                <div class="hint" style="margin:.35rem 0 0">وضعیت کلی: <b>آماده نیست</b> — @signStatus.Reason</div>
            }
        </td></tr>
    </table>

    <form method="post" asp-page-handler="Keygen" style="margin-top:1rem">
        <div class="grid">
            <div class="field"><label for="keyId">شناسهٔ کلید (Key ID)</label>
                <input id="keyId" name="keyId" class="mono" value="sup-@DateTime.Now.ToString("yyyyMM")" /></div>
            <div class="field"><label for="keyFolder">پوشهٔ کلیدها (بیرون از مخزن)</label>
                <input id="keyFolder" name="keyFolder" class="mono" value="@(savedKey?.Folder ?? Keys.SuggestedFolder())" /></div>
            <div class="field"><label for="keyPass">رمز کلید خصوصی</label>
                <input id="keyPass" name="keyPass" type="password" autocomplete="new-password" /></div>
            <div class="field"><label for="keyPass2">تکرار رمز</label>
                <input id="keyPass2" name="keyPass2" type="password" autocomplete="new-password" /></div>
        </div>
        <div class="field"><label><input type="checkbox" name="overwrite" /> اگر کلیدی با این شناسه بود، بازنویسی شود</label></div>
        <p class="hint">جفت‌کلید RSA 3072 ساخته می‌شود؛ کلید خصوصی <b>رمزنگاری‌شده</b> (AES‑256، ۱۰۰٬۰۰۰ تکرار) روی
            همین ماشین نوشته و پنل بلافاصله به آن وصل می‌شود — بدون ری‌استارت و بدون ست‌کردن دستی متغیر محیطی.
            رمز <b>هیچ‌جا ذخیره نمی‌شود</b> (نه DB، نه لاگ، نه فایل)؛ آن را نگه دارید چون هنگام هر امضا یا با
            <span class="mono">@Options.KeyPasswordEnvironmentVariable</span> لازم است.</p>
        <button type="submit" class="btn">ساخت جفت‌کلید و اتصال به پنل</button>
        @if (savedKey is not null)
        {
            <button type="submit" formnovalidate asp-page-handler="KeyDisconnect" class="btn ghost"
                    onclick="return confirm('اتصال از کلید ثبت‌شده قطع شود؟ فایل‌ها پاک نمی‌شوند.')">قطع اتصال از کلید ثبت‌شده</button>
        }
    </form>

    <form method="post" asp-page-handler="CheckKeyPass" style="margin-top:1rem;border-top:1px solid #e6e9ef;padding-top:.9rem">
        <div class="grid">
            <div class="field"><label for="checkPass">بررسی رمز کلید فعال (بدون امضا)</label>
                <input id="checkPass" name="checkPass" type="password" autocomplete="off" /></div>
        </div>
        <button type="submit" class="btn ghost">بررسی رمز کلید فعال</button>
        @if (PasswordCheck is not null)
        {
            <div class="alert @(PasswordCheck.Matches ? "ok" : "error")" style="margin:.7rem 0 0">
                @PasswordCheck.Message
                @if (!PasswordCheck.Matches && PasswordCheck.KeyExists)
                {
                    <span> — رمز درست همان رمزی است که هنگام ساخت این کلید دادید؛ اگر گم شده، فقط با ساخت کلید جدید
                        (با «بازنویسی») قابل جبران است.</span>
                }
            </div>
        }
        <p class="hint">اگر کلید رمزنگاری‌شده نباشد یا رمز خالی باشد، همین پیام کوتاه علت را می‌گوید؛
            رمز در پاسخ صفحه یا لاگ نوشته نمی‌شود.</p>
    </form>

    @if (KeyResult is { Ok: true, Key: not null })
    {
        <div class="card" style="margin-top:.8rem;box-shadow:none;border:1px solid #cfe8d5">
            <div class="card-body">
                <p><b>کلید ساخته شد:</b> <span class="mono">@KeyResult.Key.KeyId</span></p>
                <table class="table">
                    <tr><th style="width:32%">کلید عمومی</th><td class="mono">@KeyResult.Key.PublicKeyPath</td></tr>
                    <tr><th>کلید خصوصی</th><td class="mono">@KeyResult.Key.PrivateKeyPath</td></tr>
                    <tr><th>اثر انگشت (sha256)</th><td class="mono small">@KeyResult.Key.Fingerprint</td></tr>
                </table>
                <ul class="hint" style="line-height:1.9">
                    @foreach (var w in KeyWarnings) { <li>@w</li> }
                </ul>
            </div>
        </div>
    }
</div></div>

<div class="card"><div class="card-head">SMTP (اختیاری)</div><div class="card-body">
    <form method="post" asp-page-handler="Smtp">
        <div class="grid">
            <div class="field"><label for="host">میزبان</label><input id="host" name="host" class="mono" value="@smtp.Host" placeholder="smtp.example.com" /></div>
            <div class="field"><label for="port">درگاه</label><input id="port" name="port" class="mono" value="@smtp.Port" /></div>
            <div class="field"><label for="user">کاربر</label><input id="user" name="user" class="mono" value="@smtp.User" /></div>
            <div class="field"><label for="from">فرستنده (ایمیل)</label><input id="from" name="from" class="mono" value="@smtp.From" /></div>
            <div class="field"><label for="fromName">نام فرستنده</label><input id="fromName" name="fromName" value="@smtp.FromName" /></div>
            <div class="field"><label for="timeout">مهلت (ثانیه)</label><input id="timeout" name="timeout" class="mono" value="@smtp.TimeoutSeconds" /></div>
        </div>
        <div class="field"><label><input type="checkbox" name="starttls" checked="@smtp.UseStartTls" /> STARTTLS</label></div>
        <p class="hint">رمز SMTP از متغیر محیطی <span class="mono">LICENSESIGNER_SMTP_PASSWORD</span> خوانده می‌شود —
            وضعیت: @(passwordAvailable ? "در دسترس" : "موجود نیست").</p>
        <button type="submit" class="btn">ذخیرهٔ تنظیمات SMTP</button>
    </form>
</div></div>

<div class="card"><div class="card-head">قالب ایمیل تحویل</div><div class="card-body">
    <form method="post" asp-page-handler="Template">
        <div class="field"><label for="subject">موضوع</label><input id="subject" name="subject" value="@template.Subject" /></div>
        <div class="field"><label for="body">متن</label><textarea id="body" name="body">@template.Body</textarea></div>
        <p class="hint">جای‌نگهدارها: <span class="mono">{{Serial}}</span>، <span class="mono">{{InstallationId}}</span>،
            <span class="mono">{{CustomerName}}</span>، <span class="mono">{{RequestNo}}</span>.</p>
        <button type="submit" class="btn ghost">ذخیرهٔ قالب</button>
    </form>
</div></div>
