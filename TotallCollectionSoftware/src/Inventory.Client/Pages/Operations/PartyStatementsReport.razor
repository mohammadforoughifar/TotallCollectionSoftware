@page "/operations/reports/party-statements"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IPartyService PartySvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>گزارش گردش حساب و مانده اشخاص (طلب و بدهی)</PageTitle>

<div class="page-head d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">
            <i class="bi bi-journal-check text-primary me-2"></i>گزارش طلب و بدهی (گردش حساب اشخاص)
        </h1>
        <div class="text-muted fs-8">
            بررسی مطالبات و بدهی‌ها، مانده افتتاح حساب اول دوره و ریز صورت‌حساب مشتریان و تأمین‌کنندگان
        </div>
    </div>
    <div class="d-flex gap-2">
        @if (selectedPartyDetail != null)
        {
            <button class="btn btn-outline-secondary btn-sm" @onclick="() => selectedPartyDetail = null">
                <i class="bi bi-arrow-right me-1"></i> بازگشت به لیست کلی
            </button>
            <button class="btn btn-primary btn-sm" @onclick="PrintStatement">
                <i class="bi bi-printer me-1"></i> چاپ صورت‌حساب
            </button>
        }
        else
        {
            <button class="btn btn-outline-primary btn-sm" @onclick="LoadReportAsync">
                <i class="bi bi-arrow-clockwise me-1"></i> به‌روزرسانی
            </button>
        }
    </div>
</div>

@if (selectedPartyDetail == null)
{
    @* ==================== حالت نمایش کلی (خلاصه اشخاص) ==================== *@
    @if (reportData != null)
    {
        <!-- کارت‌های شاخص‌های مالی -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-danger border-4 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-8 fw-600">کل مطالبات (طلب ما)</span>
                                <h4 class="fw-800 text-danger num mt-2 mb-0">@reportData.TotalReceivable.Money() <span class="fs-8 fw-normal">ریال</span></h4>
                            </div>
                            <div class="badge bg-soft-danger text-danger p-3 rounded-circle">
                                <i class="bi bi-arrow-down-left-circle fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-danger fs-9 fw-bold">@reportData.DebtorCount.Num() طرف‌حساب بدهکار</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-success border-4 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-8 fw-600">کل بدهی‌ها (بستانکاری دیگران)</span>
                                <h4 class="fw-800 text-success num mt-2 mb-0">@reportData.TotalPayable.Money() <span class="fs-8 fw-normal">ریال</span></h4>
                            </div>
                            <div class="badge bg-soft-success text-success p-3 rounded-circle">
                                <i class="bi bi-arrow-up-right-circle fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-success fs-9 fw-bold">@reportData.CreditorCount.Num() طرف‌حساب بستانکار</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-primary border-4 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-8 fw-600">تراز خالص مطالبات / بدهی</span>
                                <h4 class="fw-800 @(reportData.NetBalance >= 0 ? "text-primary" : "text-warning") num mt-2 mb-0">
                                    @Math.Abs(reportData.NetBalance).Money() <span class="fs-8 fw-normal">ریال</span>
                                </h4>
                            </div>
                            <div class="badge bg-soft-primary text-primary p-3 rounded-circle">
                                <i class="bi bi-scale fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted fs-9">@(reportData.NetBalance >= 0 ? "تراز مثبت (مازاد طلب)" : "تراز منفی (مازاد بدهی)")</div>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="card shadow-sm border-0 border-start border-secondary border-4 h-100">
                    <div class="card-body p-3">
                        <div class="d-flex align-items-center justify-content-between">
                            <div>
                                <span class="text-muted fs-8 fw-600">کل اشخاص ثبت‌شده</span>
                                <h4 class="fw-800 text-dark num mt-2 mb-0">@reportData.Items.Count.Num() <span class="fs-8 fw-normal">طرف حساب</span></h4>
                            </div>
                            <div class="badge bg-soft-secondary text-secondary p-3 rounded-circle">
                                <i class="bi bi-people fs-4"></i>
                            </div>
                        </div>
                        <div class="mt-2 text-muted fs-9">شامل مشتریان و تأمین‌کنندگان</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- فیلترهای گزارش -->
    <div class="card shadow-sm border-0 mb-3">
        <div class="card-body p-3">
            <div class="row g-2 align-items-end">
                <div class="col-12 col-md-3">
                    <label class="form-label fs-8">جستجوی نام یا موبایل</label>
                    <input class="form-control form-control-sm" placeholder="تایپ کنید…" @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKey" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8">نوع شخص</label>
                    <select class="form-select form-select-sm" @bind="selectedTypeStr" @bind:after="LoadReportAsync">
                        <option value="">همه اشخاص</option>
                        <option value="0">فقط مشتریان</option>
                        <option value="1">فقط تأمین‌کنندگان</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8">فیلتر مانده</label>
                    <select class="form-select form-select-sm" @bind="balanceFilter" @bind:after="ApplyBalanceFilter">
                        <option value="all">همه</option>
                        <option value="debtors">فقط بدهکاران (طلب ما)</option>
                        <option value="creditors">فقط بستانکاران (بدهی ما)</option>
                        <option value="nonzero">فقط مانده‌داران (غیرصفر)</option>
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8">از تاریخ</label>
                    <DatePicker @bind-Value="fromDate" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8">تا تاریخ</label>
                    <DatePicker @bind-Value="toDate" />
                </div>
                <div class="col-12 col-md-1">
                    <button class="btn btn-primary btn-sm w-100" @onclick="LoadReportAsync">
                        اعمال
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- جدول مانده اشخاص -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fs-8">
                        <thead class="table-light">
                            <tr>
                                <th>نام طرف حساب</th>
                                <th>نوع</th>
                                <th>موبایل</th>
                                <th class="text-start">مانده افتتاحیه</th>
                                <th class="text-start">گردش بدهکار</th>
                                <th class="text-start">گردش بستانکار</th>
                                <th class="text-start">مانده نهایی</th>
                                <th>وضعیت</th>
                                <th class="text-center">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (filteredItems.Count == 0)
                            {
                                <tr><td colspan="9" class="text-center py-5 text-muted">رکوردی مطابق فیلتر یافت نشد</td></tr>
                            }
                            else
                            {
                                @foreach (var item in filteredItems)
                                {
                                    <tr>
                                        <td class="fw-bold">@item.PartyName</td>
                                        <td>
                                            <span class="badge @(item.PartyType == PartyType.Customer ? "bg-info-subtle text-info" : "bg-warning-subtle text-warning")">
                                                @(item.PartyType == PartyType.Customer ? "مشتری" : "تأمین‌کننده")
                                            </span>
                                        </td>
                                        <td class="num text-muted">@(item.Mobile ?? "—")</td>
                                        <td class="text-start num @(item.OpeningDebit > item.OpeningCredit ? "text-danger" : (item.OpeningCredit > item.OpeningDebit ? "text-success" : ""))">
                                            @(item.OpeningDebit >= item.OpeningCredit
                                                ? $"{((item.OpeningDebit - item.OpeningCredit)).Money()} بدهکار"
                                                : $"{((item.OpeningCredit - item.OpeningDebit)).Money()} بستانکار")
                                        </td>
                                        <td class="text-start num text-danger">@item.PeriodDebit.Money()</td>
                                        <td class="text-start num text-success">@item.PeriodCredit.Money()</td>
                                        <td class="text-start fw-bold num @(item.IsDebtor ? "text-danger" : (item.IsCreditor ? "text-success" : "text-muted"))">
                                            @Math.Abs(item.RemainingBalance).Money()
                                        </td>
                                        <td>
                                            @if (item.IsDebtor)
                                            {
                                                <span class="badge bg-danger-subtle text-danger fw-bold">بدهکار (طلب ما)</span>
                                            }
                                            else if (item.IsCreditor)
                                            {
                                                <span class="badge bg-success-subtle text-success fw-bold">بستانکار (بدهی ما)</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary-subtle text-secondary">تسویه / بی‌حساب</span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <button class="btn btn-sm btn-outline-primary py-0 px-2 fs-9" @onclick="() => ViewPartyDetail(item.PartyId)">
                                                <i class="bi bi-file-text me-1"></i> صورت‌حساب
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
}
else
{
    @* ==================== حالت نمایش ریز صورت‌حساب (دفتر معین شخص) ==================== *@
    <div id="statementPrintArea">
        <div class="card shadow-sm border-0 mb-3">
            <div class="card-header bg-white py-3 border-bottom d-flex justify-content-between align-items-center">
                <div>
                    <h5 class="fw-bold mb-1">
                        صورت‌حساب و گردش حساب: <span class="text-primary">@selectedPartyDetail.PartyName</span>
                    </h5>
                    <div class="text-muted fs-8">
                        نوع: @(selectedPartyDetail.PartyType == PartyType.Customer ? "مشتری" : "تأمین‌کننده")
                        @if (!string.IsNullOrWhiteSpace(selectedPartyDetail.Mobile))
                        {
                            <span class="ms-3"><i class="bi bi-phone"></i> @selectedPartyDetail.Mobile</span>
                        }
                    </div>
                </div>
                <div class="text-start">
                    <span class="fs-8 text-muted d-block">مانده نهایی حساب:</span>
                    <span class="fs-4 fw-800 num @(selectedPartyDetail.ClosingBalance > 0 ? "text-danger" : (selectedPartyDetail.ClosingBalance < 0 ? "text-success" : "text-muted"))">
                        @Math.Abs(selectedPartyDetail.ClosingBalance).Money() ریال
                    </span>
                    <span class="badge @(selectedPartyDetail.ClosingBalance > 0 ? "bg-danger" : (selectedPartyDetail.ClosingBalance < 0 ? "bg-success" : "bg-secondary")) ms-2">
                        @(selectedPartyDetail.ClosingBalance > 0 ? "بدهکار به ما" : (selectedPartyDetail.ClosingBalance < 0 ? "طلبکار از ما" : "بی‌حساب"))
                    </span>
                </div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-bordered table-striped align-middle mb-0 fs-8">
                        <thead class="table-dark text-center">
                            <tr>
                                <th style="width: 50px">ردیف</th>
                                <th style="width: 100px">تاریخ</th>
                                <th style="width: 130px">شماره سند</th>
                                <th style="width: 160px">عنوان عملیات</th>
                                <th>شرح / بابت</th>
                                <th class="text-start" style="width: 130px">بدهکار (ریال)</th>
                                <th class="text-start" style="width: 130px">بستانکار (ریال)</th>
                                <th class="text-start" style="width: 140px">مانده پس از سطر (ریال)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (selectedPartyDetail.Rows.Count == 0)
                            {
                                <tr><td colspan="8" class="text-center py-5 text-muted">گردشی برای این طرف حساب در بازه انتخابی وجود ندارد</td></tr>
                            }
                            else
                            {
                                int rowNum = 1;
                                @foreach (var r in selectedPartyDetail.Rows)
                                {
                                    <tr class="@(r.IsOpening ? "table-warning fw-bold" : "")">
                                        <td class="text-center num">@Fa.Digits(rowNum++)</td>
                                        <td class="text-center num">@r.Date.ToFa()</td>
                                        <td class="text-center num">@(string.IsNullOrWhiteSpace(r.DocumentNumber) ? "—" : r.DocumentNumber)</td>
                                        <td class="fw-bold">
                                            @if (r.IsOpening)
                                            {
                                                <i class="bi bi-star-fill text-warning me-1"></i>
                                            }
                                            @r.Title
                                        </td>
                                        <td>@r.Description</td>
                                        <td class="text-start num @(r.Debit > 0 ? "text-danger fw-bold" : "")">@(r.Debit > 0 ? r.Debit.Money() : "۰")</td>
                                        <td class="text-start num @(r.Credit > 0 ? "text-success fw-bold" : "")">@(r.Credit > 0 ? r.Credit.Money() : "۰")</td>
                                        <td class="text-start num fw-bold @(r.Balance > 0 ? "text-danger" : (r.Balance < 0 ? "text-success" : "text-muted"))">
                                            @Math.Abs(r.Balance).Money()
                                            <small class="fs-9">@(r.Balance > 0 ? "بد" : (r.Balance < 0 ? "بس" : "—"))</small>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                        <tfoot class="table-light fw-bold fs-7">
                            <tr>
                                <td colspan="5" class="text-end">جمع کل گردش دوره:</td>
                                <td class="text-start num text-danger">@selectedPartyDetail.TotalDebit.Money()</td>
                                <td class="text-start num text-success">@selectedPartyDetail.TotalCredit.Money()</td>
                                <td class="text-start num @(selectedPartyDetail.ClosingBalance > 0 ? "text-danger" : "text-success")">
                                    @Math.Abs(selectedPartyDetail.ClosingBalance).Money()
                                </td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private bool loading = true;
    private PartyStatementReportDto? reportData;
    private List<PartyBalanceSummaryDto> filteredItems = new();
    private PartyStatementDetailDto? selectedPartyDetail;

    private string searchTerm = "";
    private string selectedTypeStr = "";
    private string balanceFilter = "all";
    private DateTime? fromDate;
    private DateTime? toDate;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("گزارش طلب و بدهی (گردش حساب اشخاص)");
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        loading = true;
        try
        {
            PartyType? t = string.IsNullOrEmpty(selectedTypeStr) ? null : (PartyType)int.Parse(selectedTypeStr);
            reportData = await PartySvc.GetPartyStatementsSummaryAsync(t, fromDate, toDate, searchTerm);
            ApplyBalanceFilter();
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در بارگذاری گزارش: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyBalanceFilter()
    {
        if (reportData == null) return;
        var q = reportData.Items.AsEnumerable();

        if (balanceFilter == "debtors")
            q = q.Where(x => x.IsDebtor);
        else if (balanceFilter == "creditors")
            q = q.Where(x => x.IsCreditor);
        else if (balanceFilter == "nonzero")
            q = q.Where(x => !x.IsSettled);

        filteredItems = q.ToList();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadReportAsync();
    }

    private async Task ViewPartyDetail(int partyId)
    {
        loading = true;
        try
        {
            selectedPartyDetail = await PartySvc.GetPartyStatementDetailAsync(partyId, fromDate, toDate);
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در بارگذاری صورت‌حساب: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PrintStatement()
    {
        await JS.InvokeVoidAsync("print");
    }
}
