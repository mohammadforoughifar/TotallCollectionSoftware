@code {
    private bool loading = true;
    private VisActorInfo? me;
    private VisQueueStats? stats;
    private List<VisOrderDto> items = new();
    private string? statusFilter;
    private string? search;
    private System.Threading.CancellationTokenSource? _debounce;

    [Microsoft.AspNetCore.Components.SupplyParameterFromQuery(Name = "status")]
    public string? StatusParam { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("سفارش‌های ویزیتوری");
        if (!string.IsNullOrWhiteSpace(StatusParam)) statusFilter = ((int)Enum.Parse<VisOrderStatus>(StatusParam)).ToString();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            me = await Api.MeAsync();
            stats = await Api.StatsAsync();
            VisOrderStatus? st = int.TryParse(statusFilter, out var v) ? (VisOrderStatus)v : null;
            items = await Api.ListAsync(st, search);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private Task ReloadAsync() => LoadAsync();

    private async Task SearchChanged()
    {
        _debounce?.Cancel();
        _debounce = new System.Threading.CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

    private void Open(int id) => Nav.NavigateTo($"/sales/visits/{id}");

    private void Edit(int id) => Nav.NavigateTo($"/sales/visits/{id}/edit");

    /// <summary>ویرایش تا زمانی که مدیر تأیید نکرده: پیش‌نویس، ارسال‌شده و برگشتی.</summary>
    private bool CanEdit(VisOrderDto o) =>
        (o.Status is VisOrderStatus.Draft or VisOrderStatus.Submitted or VisOrderStatus.Returned)
        && (me?.CanCreate == true || me?.CanApprove == true);

    private bool CanCancel(VisOrderDto o) =>
        o.Status is VisOrderStatus.Draft or VisOrderStatus.Returned or VisOrderStatus.Submitted;

    private async Task SubmitAsync(VisOrderDto o)
    {
        try
        {
            await Api.SubmitAsync(o.Id);
            Toast.Success($"سفارش {o.Number} برای تأیید مدیر فروش ارسال شد.");
            await LoadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task CancelAsync(VisOrderDto o)
    {
        try
        {
            await Api.CancelAsync(o.Id, "ابطال از فهرست سفارش‌ها");
            Toast.Info($"سفارش {o.Number} ابطال شد.");
            await LoadAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
