@namespace Inventory.Client.Pages
@page "/sales/visits"
@inject ISalesVisitApi Api
@inject IToastService Toast
@inject LayoutState Layout
@inject NavigationManager Nav
@inject IAuthState Auth

<PageTitle>سفارش‌های ویزیتوری و فروش میدانی</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-briefcase-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">سفارش‌های ویزیتوری و فروش میدانی</h1>
                        <span class="badge rounded-pill fin-badge-indigo">سامانه ویزیتوری</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        ثبت سفارش‌های میدانی، پایش گردش تأیید مدیر فروش و ارجاع به صدور فاکتور مالی
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                @if (me?.CanCreate == true)
                {
                    <button class="btn btn-primary fin-btn-pill" data-new-order @onclick="@(() => Nav.NavigateTo("/sales/visits/new"))">
                        <i class="bi bi-plus-lg me-1"></i> ثبت سفارش جدید
                    </button>
                }
                <button class="btn btn-outline-secondary fin-btn-pill" @onclick="ReloadAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> به‌روزرسانی
                </button>
            </div>
        </div>
    </div>

    <!-- ================== آمار سریع با استایل KPI ================== -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-slate">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-slate">پیش‌نویس‌های شخصی</span>
                        <div class="fin-kpi-value text-dark num mt-1">@Fa.Digits(stats?.Draft ?? 0)</div>
                        <div class="fin-kpi-unit">سفارش ذخیره‌شده</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-slate-subtle text-slate">
                        <i class="bi bi-pencil-square"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="text-secondary fs-9">در انتظار تکمیل و ارسال</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-amber">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-amber">در انتظار تأیید سرپرست</span>
                        <div class="fin-kpi-value text-amber num mt-1">@Fa.Digits(stats?.Submitted ?? 0)</div>
                        <div class="fin-kpi-unit">سفارش ارسالی</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5">بررسی سقف تخفیف و اعتبار</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-indigo">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-indigo">تأییدشده / در کارتابل مالی</span>
                        <div class="fin-kpi-value text-indigo num mt-1">@Fa.Digits(stats?.Approved ?? 0)</div>
                        <div class="fin-kpi-unit">سفارش آماده صدور فاکتور</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                        <i class="bi bi-check-circle"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5">در انتظار تسویه مالی</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-emerald">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-emerald">مبلغ تأییدشده دوره</span>
                        <div class="fin-kpi-value text-emerald num mt-1">@Fa.Money(stats?.ApprovedAmount ?? 0)</div>
                        <div class="fin-kpi-unit">ریال ناخالص</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                        <i class="bi bi-cash-coin"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">فروش‌های موثر ویزیتوری</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================== نوار فیلتر ================== -->
    <div class="fin-filter-card mb-4">
        <div class="row g-2.5 align-items-end">
            <div class="col-12 col-md-4 col-xl-3">
                <label class="fin-label">وضعیت سفارش</label>
                <select class="form-select form-select-sm fin-input" @bind="statusFilter" @bind:after="ReloadAsync">
                    <option value="">همهٔ وضعیت‌ها</option>
                    <option value="0">پیش‌نویس</option>
                    <option value="1">در انتظار تأیید</option>
                    <option value="2">تأییدشده</option>
                    <option value="3">برگشتی برای اصلاح</option>
                    <option value="5">فاکتورشده</option>
                    <option value="7">ابطال‌شده</option>
                </select>
            </div>

            <div class="col-12 col-md-5 col-xl-5">
                <label class="fin-label">جستجوی هوشمند</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input class="form-control border-start-0 fin-input" placeholder="شماره سفارش، نام مشتری یا ویزیتور…"
                           @bind="search" @bind:event="oninput" @bind:after="SearchChanged" />
                </div>
            </div>

            <div class="col-12 col-md-3 col-xl-4 text-md-end pb-1">
                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 num fs-8">
                    @Fa.Digits(items.Count) سفارش ثبت‌شده
                </span>
            </div>
        </div>
    </div>

    <!-- ================== جدول سفارش‌ها ================== -->
    <div class="fin-table-card">
        <div class="fin-table-header">
            <div class="d-flex align-items-center gap-2">
                <div class="fin-table-header-icon bg-indigo-subtle text-indigo">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <h3 class="fin-table-title">فهرست سفارش‌های ثبت‌شده ویزیتوری</h3>
                    <p class="fin-table-sub">کلیک روی هر سطر برای ورود به پرونده سفارش</p>
                </div>
            </div>
        </div>

        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                <div class="text-secondary fs-8">در حال فراخوانی سفارش‌های ویزیتور...</div>
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="fin-empty-state text-center py-5">
                <i class="bi bi-journal-x fs-1 text-muted opacity-50"></i>
                <div class="fw-bold text-secondary mt-2">سفارشی یافت نشد</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table align-middle">
                    <thead>
                        <tr>
                            <th>شماره سفارش</th>
                            <th>تاریخ ثبت</th>
                            <th>تاریخ تحویل</th>
                            <th>نام مشتری</th>
                            @if (me?.CanApprove == true || me?.CanFinance == true)
                            {
                                <th>ویزیتور مسئول</th>
                            }
                            <th class="text-start">مبلغ خالص (ریال)</th>
                            <th class="text-center">وضعیت سفارش</th>
                            <th>شماره فاکتور</th>
                            <th class="text-center" style="width: 100px;">اقدام</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in items)
                        {
                            <tr class="fin-table-row" @onclick="@(() => Open(o.Id))" style="cursor:pointer">
                                <td>
                                    <span class="num fw-800 text-indigo">@o.Number</span>
                                </td>
                                <td class="num text-secondary fs-8">@o.Date.ToFa()</td>
                                <td class="num fs-8">
                                    @if (o.FinalDeliveryDate is not null)
                                    {
                                        <span class="@(o.FinalDateChanged ? "text-amber fw-800" : "text-dark fw-600")"
                                              title="@(o.FinalDateChanged ? $"تاریخ ویزیتور: {o.DeliveryDate?.ToFa()}" : "همان تاریخ ویزیتور")">
                                            @o.FinalDeliveryDate.Value.ToFa()
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@(o.DeliveryDate?.ToFa() ?? "—")</span>
                                    }
                                </td>
                                <td>
                                    <div class="fw-800 text-dark">@o.PartyName</div>
                                    <div class="fs-9 text-muted num">@o.LineCount.Num() قلم کالا — @VisUi.PaymentText(o.PaymentMethod)</div>
                                </td>
                                @if (me?.CanApprove == true || me?.CanFinance == true)
                                {
                                    <td class="text-dark fs-8 fw-500">@o.ReferrerName</td>
                                }
                                <td class="text-start num fw-900 fs-7.5 text-dark">
                                    @Fa.Money(o.TotalNet)
                                </td>
                                <td class="text-center">
                                    <span class="badge @VisUi.BadgeCss(o.Status) rounded-pill px-2.5">
                                        @VisUi.StatusText(o.Status)
                                    </span>
                                </td>
                                <td>
                                    @if (!string.IsNullOrWhiteSpace(o.SaleNumber))
                                    {
                                        <span class="badge bg-emerald-subtle text-emerald border border-emerald-subtle rounded-pill num px-2.5">
                                            فاکتور @o.SaleNumber
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted fs-8">—</span>
                                    }
                                </td>
                                <td class="text-center" @onclick:stopPropagation="true">
                                    <button class="btn btn-sm btn-outline-primary fin-btn-pill fs-8 py-1 px-3" @onclick="@(() => Open(o.Id))">
                                        مشاهده
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>


