@namespace Inventory.Client.Pages
@page "/sales/requests"
@inject ISalesVisitApi Api
@inject IToastService Toast
@inject LayoutState Layout
@inject NavigationManager Nav
@inject IAuthState Auth

<PageTitle>همهٔ درخواست‌های سفارش — داشبورد فروش</PageTitle>

<div class="stripe-dashboard fade-in">
    <!-- ================== Top Navigation / Page Bar ================== -->
    <header class="stripe-topbar">
        <div class="stripe-topbar-start">
            <div class="stripe-breadcrumb">
                <span class="stripe-breadcrumb-muted">فروش میدانی و ویزیتوری</span>
                <span class="stripe-breadcrumb-sep">/</span>
                <span class="stripe-breadcrumb-current">درخواست‌های سفارش</span>
            </div>
            <div class="stripe-title-row">
                <h1 class="stripe-heading">سفارش‌ها و درخواست‌ها</h1>
                <span class="stripe-pill-count">@Fa.Digits(all.Count) سفارش ثبت‌شده</span>
            </div>
        </div>

        <div class="stripe-topbar-actions">
            <button class="stripe-btn stripe-btn-secondary" @onclick="LoadAsync" disabled="@loading">
                <i class="bi bi-arrow-clockwise @(loading ? "spin" : "")"></i>
                <span>به‌روزرسانی داده‌ها</span>
            </button>
            <button class="stripe-btn stripe-btn-secondary" @onclick="@(() => Nav.NavigateTo("/sales/approvals"))">
                <i class="bi bi-shield-check"></i>
                <span>کارتابل تأیید</span>
            </button>
            <button class="stripe-btn stripe-btn-primary" @onclick="@(() => Nav.NavigateTo("/sales/visits/new"))">
                <i class="bi bi-plus-lg"></i>
                <span>ثبت سفارش جدید</span>
            </button>
        </div>
    </header>

    <!-- ================== Stripe Metric Cards (4 High-Impact KPIs) ================== -->
    <section class="stripe-kpi-grid">
        <div class="stripe-kpi-card">
            <div class="stripe-kpi-header">
                <span class="stripe-kpi-label">مجموع فروش نهایی‌شده</span>
                <span class="stripe-trend stripe-trend-up"><i class="bi bi-arrow-up-short"></i> فاکتور قطعی</span>
            </div>
            <div class="stripe-kpi-value num">
                @Fa.Money(all.Where(o => o.Status == VisOrderStatus.Invoiced).Sum(o => o.TotalNet))
                <span class="stripe-kpi-currency">ریال</span>
            </div>
            <div class="stripe-kpi-subtext">
                <b>@Fa.Digits(Count(VisOrderStatus.Invoiced))</b> سفارش به فاکتور فروش تبدیل شد
            </div>
        </div>

        <div class="stripe-kpi-card">
            <div class="stripe-kpi-header">
                <span class="stripe-kpi-label">در انتظار بررسی و تأیید</span>
                @if (Count(VisOrderStatus.Submitted) > 0)
                {
                    <span class="stripe-trend stripe-trend-warn"><i class="bi bi-clock-history"></i> نیازمند اقدام</span>
                }
                else
                {
                    <span class="stripe-trend stripe-trend-neutral">صف خالی</span>
                }
            </div>
            <div class="stripe-kpi-value num text-amber">
                @Fa.Digits(Count(VisOrderStatus.Submitted))
                <span class="stripe-kpi-currency">سفارش</span>
            </div>
            <div class="stripe-kpi-subtext">
                ارزش کل در انتظار: <b>@Fa.Money(all.Where(o => o.Status == VisOrderStatus.Submitted).Sum(o => o.TotalNet))</b> ریال
            </div>
        </div>

        <div class="stripe-kpi-card">
            <div class="stripe-kpi-header">
                <span class="stripe-kpi-label">تأییدشده — آماده صف مالی</span>
                <span class="stripe-trend stripe-trend-info"><i class="bi bi-check2"></i> تسویه</span>
            </div>
            <div class="stripe-kpi-value num text-indigo">
                @Fa.Digits(Count(VisOrderStatus.Approved))
                <span class="stripe-kpi-currency">سفارش</span>
            </div>
            <div class="stripe-kpi-subtext">
                آماده صدور سند حسابداری و تحویل کالا
            </div>
        </div>

        <div class="stripe-kpi-card">
            <div class="stripe-kpi-header">
                <span class="stripe-kpi-label">مرجوعی، رد یا لغوشده</span>
                <span class="stripe-trend stripe-trend-muted">بازبینی</span>
            </div>
            <div class="stripe-kpi-value num text-slate">
                @Fa.Digits(Count(VisOrderStatus.Returned) + Count(VisOrderStatus.Rejected) + Count(VisOrderStatus.Canceled))
                <span class="stripe-kpi-currency">مورد</span>
            </div>
            <div class="stripe-kpi-subtext">
                @Fa.Digits(Count(VisOrderStatus.Returned)) برگشتی • @Fa.Digits(Count(VisOrderStatus.Rejected)) رد • @Fa.Digits(Count(VisOrderStatus.Canceled)) لغو
            </div>
        </div>
    </section>

    <!-- ================== Segmented Status Tabs (Stripe Style) ================== -->
    <div class="stripe-tabs-container">
        <div class="stripe-tabs-scroller">
            @foreach (var c in ChipList)
            {
                var isAct = statusFilter == c.Status;
                <button type="button"
                        class="stripe-tab-pill @(isAct ? "is-active" : "")"
                        data-status-chip="@c.Key"
                        @onclick="() => PickStatus(c.Status)">
                    <span class="stripe-tab-text">@c.Text</span>
                    <span class="stripe-tab-badge num">@Fa.Digits(c.Count)</span>
                </button>
            }
        </div>
    </div>

    <!-- ================== Search & Filter Toolbar ================== -->
    <section class="stripe-filter-bar">
        <div class="stripe-search-wrap">
            <i class="bi bi-search stripe-search-icon"></i>
            <input type="text"
                   class="stripe-search-input"
                   placeholder="فیلتر بر اساس شماره سفارش، مشتری، نام ویزیتور یا یادداشت…"
                   @bind="search" @bind:event="oninput" @bind:after="SearchChanged" />
            @if (!string.IsNullOrWhiteSpace(search))
            {
                <button class="stripe-search-clear" @onclick="@(() => { search = null; SearchChanged(); })">
                    <i class="bi bi-x"></i>
                </button>
            }
        </div>

        <div class="stripe-filter-controls">
            <div class="stripe-control-group">
                <span class="stripe-control-label">از تاریخ:</span>
                <DatePicker Value="from" ValueChanged="d => SetFrom(d)" AllowClear="true" />
            </div>
            <div class="stripe-control-group">
                <span class="stripe-control-label">تا تاریخ:</span>
                <DatePicker Value="to" ValueChanged="d => SetTo(d)" AllowClear="true" />
            </div>
            @if (from.HasValue || to.HasValue || !string.IsNullOrWhiteSpace(search) || statusFilter.HasValue)
            {
                <button class="stripe-btn-text" @onclick="@(() => { from = null; to = null; search = null; statusFilter = null; LoadAsync(); })">
                    <i class="bi bi-x-circle me-1"></i> پاک‌سازی فیلترها
                </button>
            }
        </div>
    </section>

    <!-- ================== Stripe Data Table Container ================== -->
    <section class="stripe-table-card">
        @if (loading)
        {
            <div class="stripe-loading-state">
                <div class="stripe-spinner"></div>
                <div class="stripe-loading-text">در حال همگام‌سازی سفارش‌ها با سرور…</div>
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="stripe-empty-state">
                <div class="stripe-empty-icon"><i class="bi bi-inbox"></i></div>
                <div class="stripe-empty-title">هیچ درخواستی یافت نشد</div>
                <div class="stripe-empty-desc">هیچ سفارشی مطابق با این فیلتر یا عبارت جستجو وجود ندارد.</div>
                @if (from.HasValue || to.HasValue || !string.IsNullOrWhiteSpace(search) || statusFilter.HasValue)
                {
                    <button class="stripe-btn stripe-btn-secondary mt-3" @onclick="@(() => { from = null; to = null; search = null; statusFilter = null; LoadAsync(); })">
                        بازنشانی تمامی فیلترها
                    </button>
                }
            </div>
        }
        else
        {
            <div class="stripe-table-responsive">
                <table class="stripe-table" data-all-requests>
                    <thead>
                        <tr>
                            <th class="stripe-th-expand"></th>
                            <th class="stripe-th">شماره سفارش</th>
                            <th class="stripe-th">مشتری</th>
                            <th class="stripe-th">ویزیتور مسئول</th>
                            <th class="stripe-th">تاریخ ثبت</th>
                            <th class="stripe-th">تحویل محصول</th>
                            <th class="stripe-th stripe-th-num">مبلغ خالص</th>
                            <th class="stripe-th">وضعیت</th>
                            <th class="stripe-th">تصمیم سرپرست</th>
                            <th class="stripe-th stripe-th-action">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in items)
                        {
                            var open = expanded.Contains(o.Id);
                            <tr class="stripe-tr @(open ? "stripe-tr-open" : "")" @onclick="() => Toggle(o.Id)">
                                <td class="stripe-td-expand">
                                    <div class="stripe-expand-icon @(open ? "is-expanded" : "")">
                                        <i class="bi bi-chevron-left"></i>
                                    </div>
                                </td>
                                <td class="stripe-td">
                                    <span class="stripe-order-num num">@o.Number</span>
                                </td>
                                <td class="stripe-td">
                                    <div class="stripe-cell-main">@o.PartyName</div>
                                    <div class="stripe-cell-sub">@Fa.Digits(o.LineCount) سطر • @VisUi.PaymentText(o.PaymentMethod)</div>
                                </td>
                                <td class="stripe-td">
                                    <span class="stripe-cell-user">@o.ReferrerName</span>
                                </td>
                                <td class="stripe-td">
                                    <span class="stripe-cell-date num">@o.Date.ToFa()</span>
                                </td>
                                <td class="stripe-td">
                                    @if (o.FinalDeliveryDate is not null)
                                    {
                                        <span class="stripe-delivery-date @(o.FinalDateChanged ? "is-changed" : "") num"
                                              title="@(o.FinalDateChanged ? $"درخواست اولیه ویزیتور: {o.DeliveryDate?.ToFa()}" : "تأیید بدون تغییر")">
                                            @o.FinalDeliveryDate.Value.ToFa()
                                            @if (o.FinalDateChanged)
                                            {
                                                <i class="bi bi-info-circle ms-1"></i>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="stripe-text-muted num">@(o.DeliveryDate?.ToFa() ?? "—")</span>
                                    }
                                </td>
                                <td class="stripe-td stripe-td-num">
                                    <span class="stripe-money-primary num">@Fa.Money(o.TotalNet)</span>
                                    <span class="stripe-currency-unit">ریال</span>
                                </td>
                                <td class="stripe-td">
                                    <div class="stripe-badge-group">
                                        <span class="stripe-status-tag stripe-status-@o.Status.ToString().ToLowerInvariant()">
                                            <span class="stripe-status-dot"></span>
                                            @VisUi.StatusText(o.Status)
                                        </span>
                                        @if (o.ReturnCount > 0)
                                        {
                                            <span class="stripe-subtag stripe-subtag-warn" title="تعداد دفعات مرجوعی">↩ @Fa.Digits(o.ReturnCount)</span>
                                        }
                                        @if (o.DiscountOverLimit)
                                        {
                                            <span class="stripe-subtag stripe-subtag-danger" title="تخفیف بالاتر از سقف مجاز">تخفیف ویژه</span>
                                        }
                                    </div>
                                </td>
                                <td class="stripe-td stripe-td-note">
                                    @if (!string.IsNullOrWhiteSpace(o.DecisionNote))
                                    {
                                        <div class="stripe-decision-note" data-decision-note>@o.DecisionNote</div>
                                        <div class="stripe-decision-meta">توسط: @o.DecidedBy • @(o.DecidedAt is null ? "" : o.DecidedAt.Value.ToFa())</div>
                                    }
                                    else
                                    {
                                        <span class="stripe-text-muted">—</span>
                                    }
                                </td>
                                <td class="stripe-td stripe-td-action" @onclick:stopPropagation="true">
                                    <button class="stripe-icon-btn" title="باز کردن فرم کامل جزئیات سفارش" @onclick="@(() => Nav.NavigateTo($"/sales/visits/{o.Id}"))">
                                        <i class="bi bi-arrow-up-left-square"></i>
                                    </button>
                                </td>
                            </tr>

                            @* ---------- Stripe Drawer: Inline Order Details ---------- *@
                            @if (open)
                            {
                                <tr class="stripe-detail-drawer">
                                    <td colspan="10">
                                        <div class="stripe-drawer-wrapper">
                                            <div class="stripe-drawer-grid">
                                                <!-- سمت راست: سطرهای کالا -->
                                                <div class="stripe-drawer-main">
                                                    <div class="stripe-drawer-section-title">
                                                        <span>اقلام فاکتور سفارش</span>
                                                        <span class="stripe-pill-count num">@Fa.Digits(o.Lines.Count) قلم</span>
                                                    </div>
                                                    <div class="stripe-subtable-container">
                                                        <table class="stripe-subtable">
                                                            <thead>
                                                                <tr>
                                                                    <th>کالا</th>
                                                                    <th class="text-start">تعداد / مقدار</th>
                                                                    <th class="text-start">فی واحد</th>
                                                                    <th class="text-start">تخفیف</th>
                                                                    <th class="text-start">جمع کل سطر</th>
                                                                </tr>
                                                            </thead>
                                                            <tbody>
                                                                @foreach (var l in o.Lines)
                                                                {
                                                                    <tr>
                                                                        <td class="stripe-item-name">@l.ProductName</td>
                                                                        <td class="text-start num fw-600">@Fa.Number(l.Quantity)</td>
                                                                        <td class="text-start num text-secondary">@Fa.Money(l.UnitPrice) <small>ریال</small></td>
                                                                        <td class="text-start num stripe-discount-text">@l.DiscountText</td>
                                                                        <td class="text-start num stripe-item-total">@Fa.Money(l.LineTotal) <small>ریال</small></td>
                                                                    </tr>
                                                                }
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>

                                                <!-- سمت چپ: خلاصه مالی و لاگ تغییرات -->
                                                <div class="stripe-drawer-side">
                                                    <!-- خلاصه مالی Stripe Receipts Card -->
                                                    <div class="stripe-summary-card">
                                                        <div class="stripe-drawer-section-title">خلاصه مالی</div>
                                                        <div class="stripe-sum-row">
                                                            <span>جمع ناخالص</span>
                                                            <span class="num">@Fa.Money(o.TotalGross) ریال</span>
                                                        </div>
                                                        <div class="stripe-sum-row stripe-sum-discount">
                                                            <span>تخفیف</span>
                                                            <span class="num">- @Fa.Money(o.TotalDiscount) ریال</span>
                                                        </div>
                                                        <div class="stripe-sum-divider"></div>
                                                        <div class="stripe-sum-row stripe-sum-net">
                                                            <span>مبلغ نهایی قابل پرداخت</span>
                                                            <span class="num">@Fa.Money(o.TotalNet) ریال</span>
                                                        </div>

                                                        <div class="stripe-drawer-meta-list">
                                                            <div>انبار مبدأ: <b>@o.WarehouseName</b></div>
                                                            <div>ثبت‌کننده: <b>@o.CreatedByName</b></div>
                                                            <div>تاریخ درخواستی ویزیتور: <b>@(o.DeliveryDate?.ToFa() ?? "—")</b></div>
                                                            @if (!string.IsNullOrWhiteSpace(o.Note))
                                                            {
                                                                <div class="stripe-meta-note">یادداشت: @o.Note</div>
                                                            }
                                                            @if (o.Status == VisOrderStatus.Invoiced && !string.IsNullOrWhiteSpace(o.SaleNumber))
                                                            {
                                                                <div class="stripe-meta-sale">
                                                                    <i class="bi bi-check-circle-fill me-1"></i> فاکتور فروش صادره: <b>@o.SaleNumber</b>
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>

                                                    <!-- تاریخچه رویدادها Timeline -->
                                                    <div class="stripe-timeline-card">
                                                        <div class="stripe-drawer-section-title">تاریخچه رویدادهای سفارش</div>
                                                        @if (histories.TryGetValue(o.Id, out var hist) && hist.Count > 0)
                                                        {
                                                            <div class="stripe-timeline">
                                                                @foreach (var h in hist)
                                                                {
                                                                    <div class="stripe-timeline-item">
                                                                        <div class="stripe-timeline-dot"></div>
                                                                        <div class="stripe-timeline-content">
                                                                            <div class="stripe-timeline-head">
                                                                                <span class="stripe-timeline-user">@h.UserName</span>
                                                                                <span class="stripe-timeline-time num">@h.At.ToFa()</span>
                                                                            </div>
                                                                            <div class="stripe-timeline-desc">
                                                                                @(h.FromStatus is null ? "پیش‌نویس" : VisUi.StatusText(h.FromStatus.Value))
                                                                                <i class="bi bi-arrow-left stripe-timeline-arrow"></i>
                                                                                <b>@VisUi.StatusText(h.ToStatus)</b>
                                                                            </div>
                                                                            @if (!string.IsNullOrWhiteSpace(h.Comment))
                                                                            {
                                                                                <div class="stripe-timeline-comment">@h.Comment</div>
                                                                            }
                                                                        </div>
                                                                    </div>
                                                                }
                                                            </div>
                                                        }
                                                        else
                                                        {
                                                            <div class="stripe-timeline-loading">در حال فراخوانی رویدادها…</div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- Table Footer -->
            <div class="stripe-table-footer">
                <span class="stripe-footer-info">نمایش @Fa.Digits(items.Count) از @Fa.Digits(all.Count) سفارش</span>
            </div>
        }
    </section>
</div>

<style>
/* ==========================================================================
   Stripe Dashboard Theme: Ultra-Clean, High-Density FinTech Look
   Color Palette: Slate (#0f172a), Cool Gray (#f8fafc), Stripe Indigo (#635bff)
   ========================================================================== */

.stripe-dashboard {
    max-width: 1480px;
    margin: 0 auto;
    padding: 0 0.5rem 2.5rem 0.5rem;
    font-family: inherit;
    color: #1a1f36;
}

/* ---------- Top Navigation Bar ---------- */
.stripe-topbar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.25rem 0;
    margin-bottom: 1.25rem;
    border-bottom: 1px solid #e3e8ee;
}
.stripe-breadcrumb {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    font-weight: 500;
}
.stripe-breadcrumb-muted { color: #697386; }
.stripe-breadcrumb-sep { color: #a1aab6; }
.stripe-breadcrumb-current { color: #3c4257; font-weight: 600; }
.stripe-title-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.25rem;
}
.stripe-heading {
    font-size: 1.45rem;
    font-weight: 800;
    color: #1a1f36;
    margin: 0;
    letter-spacing: -0.02em;
}
.stripe-pill-count {
    background: #edf2f7;
    color: #4f566b;
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.65rem;
    border-radius: 999px;
}

/* Actions & Buttons */
.stripe-topbar-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
}
.stripe-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.82rem;
    font-weight: 600;
    padding: 0.48rem 0.95rem;
    border-radius: 6px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: all 0.15s ease;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
}
.stripe-btn-secondary {
    background: #ffffff;
    border-color: #d8dee4;
    color: #3c4257;
}
.stripe-btn-secondary:hover {
    background: #f8fafc;
    border-color: #b3bcc7;
    color: #1a1f36;
}
.stripe-btn-primary {
    background: #635bff;
    color: #ffffff;
    box-shadow: 0 2px 4px rgba(99, 91, 255, 0.2);
}
.stripe-btn-primary:hover {
    background: #5046e5;
    color: #ffffff;
}

/* ---------- 4 KPI Metric Cards ---------- */
.stripe-kpi-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.stripe-kpi-card {
    background: #ffffff;
    border: 1px solid #e3e8ee;
    border-radius: 8px;
    padding: 1.15rem 1.25rem;
    box-shadow: 0 1px 3px rgba(50, 50, 93, 0.04), 0 1px 2px rgba(0, 0, 0, 0.03);
    transition: box-shadow 0.15s ease, border-color 0.15s ease;
}
.stripe-kpi-card:hover {
    border-color: #c7d2fe;
    box-shadow: 0 4px 12px rgba(50, 50, 93, 0.08);
}
.stripe-kpi-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.6rem;
}
.stripe-kpi-label {
    font-size: 0.78rem;
    font-weight: 600;
    color: #697386;
}
.stripe-trend {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
}
.stripe-trend-up { background: #e3fcf7; color: #00875a; }
.stripe-trend-warn { background: #fff8e6; color: #b78103; }
.stripe-trend-info { background: #e8f0fe; color: #1a73e8; }
.stripe-trend-neutral { background: #f4f5f7; color: #6b778c; }
.stripe-trend-muted { background: #f1f3f5; color: #495057; }

.stripe-kpi-value {
    font-size: 1.6rem;
    font-weight: 800;
    color: #1a1f36;
    letter-spacing: -0.02em;
    line-height: 1.2;
}
.stripe-kpi-currency {
    font-size: 0.8rem;
    font-weight: 600;
    color: #8792a2;
    margin-right: 0.25rem;
}
.stripe-kpi-subtext {
