@code {
    private bool loading = true;
    private List<VisOrderDto> items = new();
    private List<VisOrderDto> all = new();
    private VisOrderStatus? statusFilter;
    private DateTime? from;
    private DateTime? to;
    private string? search;
    private System.Threading.CancellationTokenSource? _debounce;
    private readonly HashSet<int> expanded = new();
    private readonly Dictionary<int, List<VisOrderHistoryDto>> histories = new();

    private static readonly VisOrderStatus[] AllStatuses = Enum.GetValues<VisOrderStatus>();

    private sealed record Chip(string Key, string Text, VisOrderStatus? Status, int Count);

    /// <summary>شمارندهٔ هر وضعیت — همهٔ وضعیت‌ها در یک نگاه (شامل رد‌شده و برگشتی).</summary>
    private IEnumerable<Chip> ChipList => new[]
    {
        new Chip("all", "همه", null, all.Count),
        new Chip("0", "پیش‌نویس", VisOrderStatus.Draft, Count(VisOrderStatus.Draft)),
        new Chip("1", "در انتظار تأیید", VisOrderStatus.Submitted, Count(VisOrderStatus.Submitted)),
        new Chip("2", "تأییدشده", VisOrderStatus.Approved, Count(VisOrderStatus.Approved)),
        new Chip("3", "برگشتی", VisOrderStatus.Returned, Count(VisOrderStatus.Returned)),
        new Chip("4", "رد‌شده", VisOrderStatus.Rejected, Count(VisOrderStatus.Rejected)),
        new Chip("5", "فروش‌شده", VisOrderStatus.Invoiced, Count(VisOrderStatus.Invoiced)),
        new Chip("7", "لغوشده", VisOrderStatus.Canceled, Count(VisOrderStatus.Canceled)),
    };

    private int Count(VisOrderStatus s) => all.Count(o => o.Status == s);

    private void PickStatus(VisOrderStatus? s) => statusFilter = s;

    private void SetFrom(DateTime? d) { from = d; }

    private void SetTo(DateTime? d) { to = d; }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("همهٔ درخواست‌های سفارش");
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        loading = true;
        try
        {
            // نمای کامل مدیر: بدون فیلتر وضعیت، همهٔ درخواست‌های شرکت خوانده می‌شود
            all = await Api.ListAsync(null, search, from, to);
            items = statusFilter is null ? all : all.Where(o => o.Status == statusFilter).ToList();
            expanded.Clear();
            histories.Clear();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task SearchChanged()
    {
        _debounce?.Cancel();
        _debounce = new System.Threading.CancellationTokenSource();
        var token = _debounce.Token;
        try
        {
            await Task.Delay(350, token);
            if (!token.IsCancellationRequested) await LoadAsync();
        }
        catch (TaskCanceledException) { }
    }

    /// <summary>باز/بسته کردن جزئیات یک درخواست + خواندن گردش آن.</summary>
    private async Task Toggle(int id)
    {
        if (!expanded.Remove(id)) expanded.Add(id);

        if (expanded.Contains(id) && !histories.ContainsKey(id))
        {
            try
            {
                var full = await Api.GetAsync(id);
                histories[id] = full?.History ?? new List<VisOrderHistoryDto>();
            }
            catch (Exception ex) { Toast.Error(ex.Message); histories[id] = new(); }
        }
    }
}
