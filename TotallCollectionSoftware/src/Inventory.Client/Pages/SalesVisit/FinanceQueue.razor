    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-btn-pill {
    border-radius: 20px;
    padding: 0.45rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
