.fin-table {
    margin-bottom: 0;
    font-size: 0.82rem;
}
.fin-table thead th {
    background: #f8fafc;
    color: #475569;
    font-weight: 700;
    font-size: 0.74rem;
    padding: 0.85rem 0.9rem;
    border-bottom: 1.5px solid #e2e8f0;
