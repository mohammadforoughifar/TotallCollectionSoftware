@namespace Inventory.Client.Pages
@page "/sales/finance-queue"
@inject ISalesVisitApi Api
@inject IToastService Toast
@inject LayoutState Layout
@inject NavigationManager Nav

<PageTitle>کارتابل مالی سفارش‌های ویزیتور</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-emerald-gradient">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">کارتابل مالی و صدور فاکتور سفارش‌های ویزیتور</h1>
                        <span class="badge rounded-pill fin-badge-emerald">صف مالی</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        تأیید شیوه تسویه، تعیین شرایط نقد، چک یا اقساط و تبدیل قطعی سفارش میدانی به سند فروشگاه
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-secondary fin-btn-pill" @onclick="LoadAsync" disabled="@loading">
                    <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i> بازخوانی صف
                </button>
            </div>
        </div>
    </div>

    <!-- ================== کارت‌های KPI ================== -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-amber">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-amber">در انتظار تأیید مالی</span>
                        <div class="fin-kpi-value text-amber num mt-1">@Fa.Digits(PendingCount)</div>
                        <div class="fin-kpi-unit">سفارش آماده تسویه</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5">تأییدشده توسط مدیر فروش</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-emerald">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-emerald">منتقل‌شده به فاکتور فروش</span>
                        <div class="fin-kpi-value text-emerald num mt-1">@Fa.Digits(SoldCount)</div>
                        <div class="fin-kpi-unit">فاکتور صادرشده</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">تکمیل چرخه فروش</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-indigo">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-indigo">مبلغ کل در صف مالی</span>
                        <div class="fin-kpi-value text-indigo num mt-1">@Fa.Money(PendingAmount)</div>
                        <div class="fin-kpi-unit">ریال ناخالص</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                        <i class="bi bi-cash-stack"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5">ارزش سفارش‌های در انتظار</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-3">
            <div class="fin-kpi-card border-slate">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-slate">کل گردش کارتابل</span>
                        <div class="fin-kpi-value text-dark num mt-1">@Fa.Digits(items.Count)</div>
                        <div class="fin-kpi-unit">ردیف سفارش</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-slate-subtle text-slate">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="text-secondary fs-9">مجموع ردیف‌های فعال و انجام‌شده</span>
                </div>
            </div>
        </div>
    </div>

<div class="card">
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-inbox"></i><h5>موردی در کارتابل مالی نیست</h5></div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>سفارش</th>
                            <th>تاریخ سفارش</th>
                            <th>تاریخ نهایی تحویل</th>
                            <th>مشتری</th>
                            <th>ویزیتور</th>
                            <th>روش پرداخت</th>
                            <th class="text-start">مبلغ</th>
                            <th>وضعیت</th>
                            <th>موجودی</th>
                            <th>شماره فروش</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in items)
                        {
                            <tr data-order="@o.Number">
                                <td class="fw-600">@o.Number</td>
                                <td class="fs-8">@o.Date.ToFa()</td>
                                <td class="fs-8">
                                    @if (o.FinalDeliveryDate is not null)
                                    {
                                        <span class="@(o.FinalDateChanged ? "text-warning fw-600" : "")"
                                              title="@(o.FinalDateChanged ? $"تاریخ ویزیتور: {o.DeliveryDate?.ToFa()}" : "همان تاریخ ویزیتور")">
                                            @o.FinalDeliveryDate.Value.ToFa()
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">@(o.DeliveryDate?.ToFa() ?? "—")</span>
                                    }
                                </td>
                                <td>@o.PartyName</td>
                                <td class="fs-8">@o.ReferrerName</td>
                                <td class="fs-8"><span class="vis-badge vis-secondary">@VisUi.PaymentText(o.PaymentMethod)</span></td>
                                <td class="text-start">@Fa.Money(o.TotalNet)</td>
                                <td><span class="@VisUi.BadgeCss(o.Status)">@VisUi.StatusText(o.Status)</span></td>
                                <td class="fs-8">
                                    @if (o.Status == VisOrderStatus.Approved && o.StockWarnings.Count > 0)
                                    {
                                        <span class="vis-badge vis-danger" data-stock-short
                                              title="@string.Join("، ", o.StockWarnings.Select(w => $"{w.ProductName}: موجودی {w.Available} نیاز {w.Required}"))">
                                            کسری @Fa.Digits(o.StockWarnings.Count) قلم
                                        </span>
                                    }
                                    else if (o.Status == VisOrderStatus.Approved)
                                    {
                                        <span class="vis-badge vis-success">موجودی تأمین است</span>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="fs-8">
                                    @if (o.Status == VisOrderStatus.Invoiced && !string.IsNullOrWhiteSpace(o.SaleNumber))
                                    {
                                        <a href="/orders/sale" class="fw-600" title="دیدن در فهرست فروش">@o.SaleNumber</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (o.Status == VisOrderStatus.Approved)
                                    {
                                        <button class="btn btn-sm btn-success" disabled="@loading"
                                                data-fin-open @onclick="() => OpenFinance(o)">
                                            <i class="bi bi-check2-circle"></i> تأیید مالی و ثبت فروش
                                        </button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-outline-secondary" @onclick="GoToSales">
                                            <i class="bi bi-cart3"></i> دیدن در فروش
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-light" @onclick="@(() => Nav.NavigateTo($"/sales/visits/{o.Id}"))">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

<div class="alert alert-info mt-3 py-2 fs-8">
    <b>ترتیب کار:</b> ویزیتور سفارش را می‌فرستد ← مدیر فروش تأیید می‌کند (سفارش خودکار به این کارتابل می‌آید)
    ← مالی روش پرداخت را ثبت می‌کند: <b>نقدی</b> (سند صندوق/بانک)، <b>چک</b> (ردیف چک‌ها)، <b>اقساطی</b> (دفترچهٔ اقساط)
    ← سند فروش در «سامانه فروشگاهی ← فروش» ثبت و سفارش «فروش‌شده» می‌شود.
</div>

<VisFinanceModal Visible="showFinance" Order="selected" OnClose="CloseFinance" OnDone="OnFinanceDone" />


</div>

<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
.fin-header {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
}
.fin-header-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
