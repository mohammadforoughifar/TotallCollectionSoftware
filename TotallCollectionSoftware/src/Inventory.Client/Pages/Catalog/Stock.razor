@namespace Inventory.Client.Pages
@page "/stock"
@inject IStockService StockSvc
@inject IWarehouseService WarehouseSvc
@inject IProductService ProductSvc
@inject IToastService Toast
@inject LayoutState Layout

<PageTitle>موجودی لحظه‌ای انبارها</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-boxes"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">وضعیت موجودی لحظه‌ای انبارها</h1>
                        <span class="badge rounded-pill fin-badge-indigo">کاردکس و انبارداری</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        پایش موجودی فیزیکی، ارزش ریالی، هشدار کسری نقطه سفارش و ثبت تعدیل انبارگردانی
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-primary fin-btn-pill" @onclick="OpenAdjust">
                    <i class="bi bi-sliders me-1"></i> اصلاح و تعدیل موجودی
                </button>
            </div>
        </div>
    </div>

    <!-- ================== نوار فیلتر ================== -->
    <div class="fin-filter-card mb-4">
        <div class="row g-2.5 align-items-end">
            <div class="col-12 col-md-4 col-xl-3">
                <label class="fin-label">انتخاب انبار</label>
                <SearchSelect Items="whLookup" Value="filterWarehouseId" ValueChanged="v => filterWarehouseId = v" Placeholder="همه انبارها" />
            </div>

            <div class="col-12 col-md-5 col-xl-4">
                <label class="fin-label">جستجوی کالا</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input class="form-control border-start-0 fin-input" placeholder="نام یا کد کالا…"
                           @bind="search" @onkeydown="OnSearchKey" />
                </div>
            </div>

            <div class="col-6 col-md-3 col-xl-3 pb-1">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="belowChk" checked="@belowOnly" @onchange="OnBelowChanged" />
                    <label class="form-check-label fs-8 fw-bold text-danger" for="belowChk">
                        <i class="bi bi-exclamation-triangle me-1"></i> فقط زیر نقطه سفارش
                    </label>
                </div>
            </div>

            <div class="col-6 col-md-auto col-xl-2 ms-auto text-end">
                <button class="btn btn-primary fin-btn-submit w-100" @onclick="OnSearch">
                    <i class="bi bi-funnel-fill me-1"></i> فیلتر موجودی
                </button>
            </div>
        </div>
    </div>

    <!-- ================== جدول موجودی ================== -->
    <div class="fin-table-card">
        <div class="fin-table-header">
            <div class="d-flex align-items-center gap-2">
                <div class="fin-table-header-icon bg-indigo-subtle text-indigo">
                    <i class="bi bi-box-seam"></i>
                </div>
                <div>
                    <h3 class="fin-table-title">موجودی اقلام انبار</h3>
                    <p class="fin-table-sub">فهرست تعداد، بهای تمام‌شده و ارزش ریالی ذخیره انبار</p>
                </div>
            </div>
            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 num fs-8">
                @total.Num() ردیف کالا
            </span>
        </div>

        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                <div class="text-secondary fs-8">در حال شمارش موجودی انبارها...</div>
            </div>
        }
        else if (items.Count == 0)
        {
            <div class="fin-empty-state text-center py-5">
                <i class="bi bi-boxes fs-1 text-muted opacity-50"></i>
                <div class="fw-bold text-secondary mt-2">موجودی برای این انبار ثبت نشده است</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table align-middle">
                    <thead>
                        <tr>
                            <th>کد و نام کالا</th>
                            <th>گروه کالا</th>
                            <th>انبار</th>
                            <th>واحد سنجش</th>
                            <th class="text-start">موجودی فعلی</th>
                            <th class="text-start">میانگین خرید (ریال)</th>
                            <th class="text-start">ارزش کل موجودی</th>
                            <th class="text-start">نقطه سفارش</th>
                            <th class="text-center">وضعیت</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in items)
                        {
                            <tr class="fin-table-row @(s.BelowReorder ? "table-danger-subtle" : "")">
                                <td>
                                    <div class="fw-800 text-dark">@s.ProductName</div>
                                    <div class="fs-9 text-muted num">کد: @s.ProductCode</div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border rounded-pill px-2 fs-9">
                                        @(s.Category ?? "عمومی")
                                    </span>
                                </td>
                                <td class="text-secondary fw-500 fs-8">@s.WarehouseName</td>
                                <td class="text-dark fs-8">@s.Unit</td>
                                <td class="text-start num fw-900 fs-7.5 @(s.BelowReorder ? "text-danger" : "text-emerald")">
                                    @s.Quantity.Num()
                                </td>
                                <td class="text-start num fs-8 text-secondary">@s.AvgCost.Money()</td>
                                <td class="text-start num fw-800 fs-8 text-dark">
                                    @((s.Quantity * s.AvgCost).Money()) <small class="fs-9 text-muted">ریال</small>
                                </td>
                                <td class="text-start num fs-8 text-muted">@s.ReorderPoint.Num()</td>
                                <td class="text-center">
                                    @if (s.BelowReorder)
                                    {
                                        <span class="badge bg-danger text-white rounded-pill px-2.5">
                                            <i class="bi bi-exclamation-triangle me-1"></i> زیر نقطه سفارش
                                        </span>
                                    }
                                    else if (s.Quantity == 0)
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5">
                                            ناموجود
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-emerald-subtle text-emerald border border-emerald-subtle rounded-pill px-2.5">
                                            مطلوب
                                        </span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-top bg-light">
                <Pager Page="page" PageCount="pageCount" OnPageChanged="GoToPage" />
            </div>
        }
    </div>
</div>

<!-- ================== مودال شیک اصلاح موجودی ================== -->
<Modal Visible="showAdjust" Title="اصلاح موجودی کالا (تعدیل انبارگردانی)" OnClose="() => showAdjust = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-12">
                <label class="fin-label">انبار مقصد <span class="text-danger">*</span></label>
                <SearchSelect Items="whLookup" Value="adjWarehouseId" ValueChanged="v => adjWarehouseId = v" Placeholder="انتخاب انبار…" />
            </div>
            <div class="col-12">
                <label class="fin-label">کالای مورد نظر <span class="text-danger">*</span></label>
                <SearchSelect Items="productLookup" Value="adjProductId" ValueChanged="v => adjProductId = v" Placeholder="جستجوی کالا…" />
            </div>
            <div class="col-md-6">
                <label class="fin-label">موجودی شمارش‌شده جدید <span class="text-danger">*</span></label>
                <input class="form-control form-control-sm fin-input num text-center fw-bold" inputmode="decimal" @bind="adjQty" />
            </div>
            <div class="col-md-6">
                <label class="fin-label">تاریخ مؤثر سند</label>
                <DatePicker @bind-Value="adjDate" />
            </div>
            <div class="col-12">
                <label class="fin-label">شرح / دلیل اصلاح</label>
                <input class="form-control form-control-sm fin-input" @bind="adjDesc" placeholder="مثلاً: انبارگردانی پایان سال، شکستگی یا مغایرت شمارش" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light fin-btn-pill px-3" @onclick="() => showAdjust = false">انصراف</button>
        <button class="btn btn-primary fin-btn-pill px-4" data-hotkey="f1" title="کلید میانبر: F1" @onclick="SaveAdjust" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-check2-circle me-1"></i> ثبت و اعمال اصلاح
        </button>
    </Footer>
</Modal>


