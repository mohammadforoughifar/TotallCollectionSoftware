@code {
    private List<StockItem> items = new();
    private int total, page = 1, pageCount = 1;
    private const int PageSize = 15;
    private bool loading = true;
    private string search = "";
    private bool belowOnly;
    private int filterWarehouseId;
    private List<LookupItem> whLookup = new();
    private List<LookupItem> productLookup = new();

    private bool showAdjust, saving;
    private int adjWarehouseId, adjProductId;
    private string adjQty = "";
    private DateTime? adjDate;
    private string adjDesc = "";

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("موجودی انبار");
        await LoadLookups();
        await Load();
    }

    private async Task LoadLookups()
    {
        try
        {
            whLookup = await WarehouseSvc.GetLookupsAsync();
            productLookup = await ProductSvc.GetLookupsAsync();
        }
        catch { }
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            var res = await StockSvc.GetStockAsync(filterWarehouseId, search, belowOnly, page, PageSize);
            items = res.Items;
            total = res.TotalCount;
            pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task OnSearch() { page = 1; await Load(); }

    private async Task OnBelowChanged(ChangeEventArgs e)
    {
        belowOnly = e.Value is bool b && b;
        page = 1;
        await Load();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") { page = 1; await Load(); }
    }

    private void OpenAdjust()
    {
        adjWarehouseId = filterWarehouseId;
        adjProductId = 0;
        adjQty = "";
        adjDate = DateTime.Now;
        adjDesc = "";
        showAdjust = true;
    }

    private async Task SaveAdjust()
    {
        if (adjWarehouseId == 0) { Toast.Error("انبار را انتخاب کنید."); return; }
        if (adjProductId == 0) { Toast.Error("کالا را انتخاب کنید."); return; }
        var qty = Fa.ParseDecimal(adjQty);
        if (qty <= 0) { Toast.Error("موجودی جدید باید بزرگ‌تر از صفر باشد."); return; }

        saving = true;
        try
        {
            await StockSvc.AdjustAsync(new AdjustmentCommand
            {
                WarehouseId = adjWarehouseId,
                ProductId = adjProductId,
                Quantity = qty,
                Date = adjDate ?? DateTime.Now,
                Description = adjDesc
            });
            Toast.Success("موجودی اصلاح شد.");
            showAdjust = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task GoToPage(int p)
    {
        page = p;
        await Load();
    }
}
