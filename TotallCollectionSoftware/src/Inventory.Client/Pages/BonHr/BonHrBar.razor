<div class="d-flex flex-column gap-2">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="fw-600 mb-2">@Title</div>
    }
    @foreach (var item in Effective)
    {
        var pct = Max <= 0 ? 0 : (double)item.Value / (double)Max * 100;
        <div>
            <div class="d-flex justify-content-between small mb-1">
                <span>@item.Label</span>
                <b class="num">@BonFa.N(item.Value)</b>
            </div>
            <div class="progress" style="height:8px">
                <div class="progress-bar" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    }
    @if (Effective.Count == 0)
    {
        <div class="text-muted small">داده‌ای نیست.</div>
    }
</div>

@code {
    public record Item(string Label, decimal Value);

    [Parameter] public string? Title { get; set; }
    [Parameter] public List<Item> Items { get; set; } = new();
    [Parameter] public List<ChartPoint>? Points { get; set; }
    [Parameter] public int Decimals { get; set; }

    private List<Item> Effective =>
        Items.Count > 0
            ? Items
            : (Points ?? new()).Select(p => new Item(
                string.IsNullOrWhiteSpace(p.ShortLabel) ? p.Label : p.ShortLabel,
                p.Value)).ToList();

    private decimal Max => Effective.Count == 0 ? 0 : Effective.Max(i => i.Value);
}
