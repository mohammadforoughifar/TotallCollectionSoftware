@namespace Inventory.Client.Pages.BonHr
@inject IAuthState Auth
@inject NavigationManager Nav

@* ================== نگهبان دسترسی بخش‌های منابع انسانی بن‌سازه ==================
    هر بخش ماژول بن‌سازه در «تنظیمات ← نقش‌ها و دسترسی‌ها» یک مجوز مستقل دارد
    (RadisHr.Dashboard / RadisHr.Employees / RadisHr.Attendance / ...).
    این کامپوننت محتوای هر صفحه را فقط به این افراد نشان می‌دهد:
      ۱. مدیر سیستم،
      ۲. دارندهٔ مجوز کل ماژول (RadisHr.Access)،
      ۳. دارندهٔ مجوز همان بخش (RadisHr.{Section}).
    در غیر این صورت به‌جای محتوای صفحه، پیام «دسترسی ندارید» رندر می‌شود
    (سرویس API هم خطاهای ۴۰۳ را بی‌صدا نادیده می‌گیرد). *@

@if (Allowed)
{
    @ChildContent
}
else
{
    <div class="bhg-denied">
        <div class="bhg-card">
            <i class="bi bi-shield-lock"></i>
            <h5>دسترسی به این بخش ندارید</h5>
            <p>
                برای مشاهدهٔ «@Title» باید مجوز این بخش به نقش شما داده شود.
            </p>
            <p class="bhg-hint">
                مدیر سیستم می‌تواند از مسیر «تنظیمات ← نقش‌ها و دسترسی‌ها ← منابع انسانی بن‌سازه»
                دسترسی «@Title» را فعال کند.
            </p>
            <button class="btn btn-primary" @onclick="GoHome">
                <i class="bi bi-house-door ms-1"></i> بازگشت به داشبورد
            </button>
        </div>
    </div>
}

<style>
    .bhg-denied {
        display: flex; justify-content: center; align-items: center;
        min-height: 46vh; padding: 1.5rem;
    }
    .bhg-card {
        max-width: 460px; width: 100%; text-align: center;
        background: #fff; border: 1px solid #e5e7eb; border-radius: 18px;
        box-shadow: 0 10px 34px rgba(15,23,42,.09); padding: 2rem 1.6rem;
    }
    .bhg-card i.bi-shield-lock {
        font-size: 2.6rem; color: #f59e0b;
        background: #fef3c7; border-radius: 16px; padding: .8rem 1.1rem;
    }
    .bhg-card h5 { font-weight: 800; margin-top: 1rem; color: #0f172a; }
    .bhg-card p { color: #475569; margin-bottom: .4rem; }
    .bhg-card .bhg-hint { font-size: .8rem; color: #94a3b8; }
    .bhg-card .btn { margin-top: .8rem; border-radius: 10px; }
</style>

@code {
    /// <summary>کلید بخش — یکی از مقادیر BonHrNav.Items.Section مثل Employees یا Attendance</summary>
    [Parameter] public string Section { get; set; } = "";

    /// <summary>عنوان فارسی بخش برای نمایش در پیام عدم دسترسی (پیش‌فرض: از فهرست منو)</summary>
    [Parameter] public string? SectionTitle { get; set; }

    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Title
    {
        get
        {
            if (!string.IsNullOrWhiteSpace(SectionTitle)) return SectionTitle!;
            var hit = BonHrNav.Items.FirstOrDefault(i => i.Section == Section);
            return string.IsNullOrWhiteSpace(hit.Label) ? "این بخش" : hit.Label!;
        }
    }

    private bool Allowed =>
        Auth.IsAdmin
        || Auth.Has("RadisHr.Access")
        || (!string.IsNullOrWhiteSpace(Section) && Auth.Has("RadisHr." + Section));

    private void GoHome() => Nav.NavigateTo("");
}
