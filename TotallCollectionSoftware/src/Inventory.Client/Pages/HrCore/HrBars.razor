@namespace Inventory.Client.Pages

@* نمودار میله‌ای ماهانه (۱۲ ماه شمسی) — خالص CSS بدون کتابخانه *@
<div class="hrbars">
    @foreach (var p in Points)
    {
        var pct = Max <= 0 ? 0 : p.Value / Max * 100;
        <div class="hrbar-col" title="@HrCoreUi.MonthName(p.Month): @Fmt(p.Value)">
            <div class="hrbar-track">
                <div class="hrbar-fill" style="height:@pct.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
            <div class="hrbar-label">@ShortMonth(p.Month)</div>
        </div>
    }
</div>

<style>
    .hrbars { display: flex; gap: 4px; align-items: stretch; height: 170px; }
    .hrbar-col { flex: 1; display: flex; flex-direction: column; min-width: 0; }
    .hrbar-track { flex: 1; display: flex; align-items: flex-end; background: #f1f3f5; border-radius: 6px; padding: 2px; min-height: 0; }
    .hrbar-fill { width: 100%; background: linear-gradient(180deg, #0d6efd, #6ea8fe); border-radius: 4px; min-height: 2px; }
    .hrbar-label { font-size: 0.65rem; text-align: center; color: #6c757d; margin-top: 2px; white-space: nowrap; overflow: hidden; }
</style>

@code {
    [Parameter] public List<HrMonthPointDto> Points { get; set; } = new();
    /// <summary>مقیاس نمایش (مثلاً ۱٬۰۰۰٬۰۰۰ برای میلیون)</summary>
    [Parameter] public double Scale { get; set; } = 1;

    private double Max => Points.Count == 0 ? 0 : Points.Max(p => p.Value);

    private string Fmt(double v)
    {
        var s = v / Scale;
        return Inventory.Shared.Fa.Digits(s.ToString("#,0.##"));
    }

    private static string ShortMonth(int m) => m switch
    {
        1 => "فرو", 2 => "ارد", 3 => "خرد", 4 => "تیر", 5 => "مرد", 6 => "شهر",
        7 => "مهر", 8 => "آبا", 9 => "آذر", 10 => "دی", 11 => "بهم", 12 => "اسف", _ => ""
    };
}
