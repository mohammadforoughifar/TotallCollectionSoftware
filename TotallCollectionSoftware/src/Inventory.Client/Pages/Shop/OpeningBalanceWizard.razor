@code {
    // داده‌های ورود از اکسل
    private bool showExcelModal;
    private int excelWarehouseId;
    private IBrowserFile? excelFile;
    private ExcelImportResult? excelResult;
    private bool importingExcel;
    private bool downloadingTemplate;

    private void OpenExcelImport()
    {
        excelWarehouseId = stockWarehouseId > 0 ? stockWarehouseId : (warehouseLookup.FirstOrDefault()?.Id ?? 0);
        excelFile = null;
        excelResult = null;
        showExcelModal = true;
    }

    private void OnExcelFileSelected(InputFileChangeEventArgs e)
    {
        excelFile = e.File;
        excelResult = null;
    }

    private async Task DownloadTemplate()
    {
        downloadingTemplate = true;
        try
        {
            var tpl = await ProductSvc.DownloadTemplateAsync();
            using var streamRef = new DotNetStreamReference(new MemoryStream(tpl.Data));
            await JS.InvokeVoidAsync("downloadFileFromStream", tpl.FileName, streamRef);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { downloadingTemplate = false; }
    }

    private async Task DoExcelImport()
    {
        if (excelWarehouseId <= 0)
        {
            Toast.Error("لطفاً ابتدا انبار موردنظر را انتخاب کنید.");
            return;
        }
        if (excelFile is null)
        {
            Toast.Error("ابتدا فایل اکسل را انتخاب کنید.");
            return;
        }

        importingExcel = true;
        try
        {
            await using var stream = excelFile.OpenReadStream(long.MaxValue);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            ms.Position = 0;

            excelResult = await ProductSvc.ImportExcelAsync(ms, excelFile.Name, excelWarehouseId);

            if (excelResult.Imported > 0)
            {
                Toast.Success($"{excelResult.Imported} کالا با موفقیت وارد و در انبار ثبت شد.");
                var prods = await ProductSvc.GetProductsAsync(pageSize: 1000);
                productLookup = prods.Items.Where(p => p.IsActive && !p.IsService)
                    .Select(p => new LookupItem { Id = p.Id, Name = $"{p.Code} — {p.Name}" })
                    .ToList();
            }
            if (excelResult.Failed > 0)
            {
                Toast.Error($"{excelResult.Failed} سطر رد شد؛ جزئیات در پنجره ورود.");
            }
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در ورود اکسل: " + ex.Message);
        }
        finally
        {
            importingExcel = false;
        }
    }

    private string activeTab = "parties";
    private bool loading = true;
    private bool saving;

    private List<LookupItem> allPartiesLookup = new();
    private List<LookupItem> customersLookup = new();
    private List<LookupItem> suppliersLookup = new();
    private List<TrsAccount> myBankAccounts = new();
    private Product? openingServiceProduct;
    private Product? openingGoodsProduct;
    private List<LookupItem> warehouseLookup = new();
    private List<LookupItem> productLookup = new();
    private List<TrsCheque> chequesList = new();

    // داده‌های تب طرف حساب
    private PartyBalanceItem partyBalance = new() { Date = DateTime.Today };
    private List<PartyBalanceItem> recentPartyBalances = new();

    // داده‌های تب چک
    private TrsCheque newCheque = new() { Kind = ChequeKind.Received, DueDate = DateTime.Today.AddMonths(1) };
    private DateTime? chequeDueDate = DateTime.Today.AddMonths(1);

    // داده‌های تب اقساط
    private int instPartyId;
    private decimal instTotalAmount;
    private int instCount = 4;
    private DateTime? instFirstDueDate = DateTime.Today.AddMonths(1);
    private int instIntervalMonths = 1;
    private string instNote = "مانده اقساط بدهی باز اول دوره";
    private List<Order> recentInstallmentOrders = new();

    // داده‌های تب موجودی کالا
    private int stockWarehouseId;
    private int stockProductId;
    private decimal stockQuantity = 1;
    private decimal stockUnitPrice = 0;
    private string stockDescription = "موجودی اولیه اول دوره انبار";
    private List<OpeningStockLine> recentStockLines = new();

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("افتتاح حساب و مانده‌های اولیه");
        await LoadDataAsync();
    }

    private static string GetChequeStatusName(ChequeStatus status) => status switch
    {
        ChequeStatus.InHand => "نزد صندوق",
        ChequeStatus.InCollection => "در جریان وصول",
        ChequeStatus.Cleared => "وصول شده",
        ChequeStatus.Bounced => "برگشتی",
        ChequeStatus.Endorsed => "خرج شده",
        _ => "ابطال شده"
    };

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            var custs = await PartySvc.GetLookupsAsync(PartyType.Customer, activeOnly: true);
            var supps = await PartySvc.GetLookupsAsync(PartyType.Supplier, activeOnly: true);

            customersLookup = custs;
            suppliersLookup = supps;
            allPartiesLookup = custs.Select(c => new LookupItem { Id = c.Id, Name = $"مشتری: {c.Name}" })
                .Concat(supps.Select(s => new LookupItem { Id = s.Id, Name = $"تأمین‌کننده: {s.Name}" }))
                .ToList();

            // دریافت یا ساخت خدمت افتتاح حساب (چون خدمات موجودی انبار نمی‌خواهد و خطا نمی‌دهد)
            await EnsureOpeningProductsAsync();

            warehouseLookup = await WarehouseSvc.GetLookupsAsync(activeOnly: true);
            if (warehouseLookup.Count > 0) stockWarehouseId = warehouseLookup[0].Id;

            var prods = await ProductSvc.GetProductsAsync(pageSize: 1000);
            productLookup = prods.Items.Where(p => p.IsActive && !p.IsService)
                .Select(p => new LookupItem { Id = p.Id, Name = $"{p.Code} — {p.Name}" })
                .ToList();
            if (productLookup.Count > 0) stockProductId = productLookup[0].Id;

            try
            {
                var allAccs = await AccountSvc.GetAllAsync(activeOnly: true, withBalances: false);
                myBankAccounts = allAccs.Where(a => a.Kind == TreasuryAccountKind.Bank).ToList();
            }
            catch { myBankAccounts = new(); }

            var chqRes = await ChequeSvc.GetAllAsync(pageSize: 20);
            chequesList = chqRes.Items;
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private void OnChequeKindChanged(ChequeKind k)
    {
        newCheque.Kind = k;
        newCheque.PartyId = 0;
    }

    private void OnPartySelected(int id)
    {
        partyBalance.PartyId = id;
        var p = allPartiesLookup.FirstOrDefault(x => x.Id == id);
        if (p != null) partyBalance.PartyName = p.Name;
    }

    private async Task EnsureOpeningProductsAsync()
    {
        try
        {
            // ۱) خدمت افتتاحیه برای فروش (طلب ما از مشتری)
            var res = await ProductSvc.GetProductsAsync(search: "مانده افتتاح حساب", pageSize: 10);
            openingServiceProduct = res.Items.FirstOrDefault(p => p.IsService && p.Name.Contains("افتتاح"));
            if (openingServiceProduct == null)
            {
                var newProd = new Product
                {
                    Code = "OPN-SVC",
                    Name = "مانده افتتاح حساب (خدمات)",
                    IsService = true,
                    IsActive = true,
                    PurchasePrice = 0,
                    SalePrice = 0,
                    Description = "خدمت سیستمی برای ثبت مانده‌های افتتاحیه طلب از مشتریان"
                };
                openingServiceProduct = await ProductSvc.SaveAsync(newProd);
            }

            // ۲) کالای عمومی افتتاحیه برای خرید (بدهی ما به تأمین‌کننده)
            var resGoods = await ProductSvc.GetProductsAsync(search: "مانده بستانکاری افتتاحیه", pageSize: 10);
            openingGoodsProduct = resGoods.Items.FirstOrDefault(p => !p.IsService && p.Name.Contains("افتتاح"));
            if (openingGoodsProduct == null)
            {
                var newGoods = new Product
                {
                    Code = "OPN-GDS",
                    Name = "مانده بستانکاری افتتاحیه (کالا)",
                    IsService = false,
                    IsActive = true,
                    WarehouseId = null, // بدون انبار اختصاصی (قابل استفاده در همه انبارها)
                    PurchasePrice = 0,
                    SalePrice = 0,
                    Description = "آیتم سیستمی برای ثبت مانده‌های افتتاحیه بدهی به تأمین‌کنندگان"
                };
                openingGoodsProduct = await ProductSvc.SaveAsync(newGoods);
            }
            else if (openingGoodsProduct.WarehouseId.HasValue)
            {
                // اگر قبلاً با انبار اختصاصی ذخیره شده بود، انبار اختصاصی آن را برمی‌داریم تا عمومی شود
                openingGoodsProduct.WarehouseId = null;
                await ProductSvc.SaveAsync(openingGoodsProduct);
            }
        }
        catch
        {
            // نادیده‌گیری خطا
        }
    }

    private async Task SavePartyBalanceAsync()
    {
        if (partyBalance.PartyId <= 0) { Toast.Error("لطفاً طرف حساب را انتخاب کنید."); return; }
        if (partyBalance.Amount <= 0) { Toast.Error("مبلغ افتتاح حساب باید بزرگ‌تر از صفر باشد."); return; }

        saving = true;
        try
        {
            var isSale = partyBalance.IsDebtor;
            if (openingServiceProduct == null || openingGoodsProduct == null) await EnsureOpeningProductsAsync();

            var selectedProd = isSale ? openingServiceProduct : openingGoodsProduct;
            var targetProdId = selectedProd?.Id ?? (productLookup.FirstOrDefault(p => isSale || !p.Name.Contains("خدمات"))?.Id ?? 1);

            // انبار سند: اگر کالا انبار اختصاصی داشت همان انبار، در غیر این صورت اولین انبار معتبر سیستم
            int effectiveWarehouseId = (selectedProd?.WarehouseId is > 0)
                ? selectedProd.WarehouseId.Value
                : (warehouseLookup.FirstOrDefault()?.Id ?? 1);

            var docDate = partyBalance.Date ?? DateTime.Today;
            var dueDate = partyBalance.DueDate ?? docDate.AddMonths(1);

            var cmd = new OrderCommand
            {
                Type = isSale ? TransactionType.Sale : TransactionType.Purchase,
                PartyId = partyBalance.PartyId,
                WarehouseId = effectiveWarehouseId,
                Date = docDate,
                PaymentMethod = PaymentMethod.Credit,
                DueDate = dueDate,
                Description = string.IsNullOrWhiteSpace(partyBalance.Description) ? "مانده حساب افتتاحیه اول دوره" : partyBalance.Description,
                Lines = new List<OrderLineInput>
                {
                    new()
                    {
                        ProductId = targetProdId,
                        Quantity = 1,
                        Price = partyBalance.Amount
                    }
                }
            };

            await OrderSvc.CreateAsync(cmd);
            Toast.Success($"افتتاح حساب طرف حساب «{partyBalance.PartyName}» با موفقیت ثبت شد.");

            recentPartyBalances.Insert(0, new PartyBalanceItem
            {
                PartyId = partyBalance.PartyId,
                PartyName = partyBalance.PartyName,
                PartyType = partyBalance.PartyName.StartsWith("مشتری") ? PartyType.Customer : PartyType.Supplier,
                Amount = partyBalance.Amount,
                IsDebtor = partyBalance.IsDebtor,
                Date = partyBalance.Date ?? DateTime.Today
            });

            partyBalance = new PartyBalanceItem { Date = DateTime.Today, DueDate = DateTime.Today.AddMonths(1) };
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در ثبت افتتاح حساب: " + ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveChequeAsync()
    {
        if ((newCheque.PartyId ?? 0) <= 0) { Toast.Error("لطفاً طرف حساب را انتخاب کنید."); return; }
        if (newCheque.Amount <= 0) { Toast.Error("مبلغ چک باید بزرگ‌تر از صفر باشد."); return; }
        if (newCheque.Kind == ChequeKind.Issued && (newCheque.TrsAccountId ?? 0) <= 0)
        {
            Toast.Error("لطفاً حساب بانکی صادرکننده را انتخاب کنید.");
            return;
        }

        saving = true;
        try
        {
            newCheque.DueDate = chequeDueDate ?? DateTime.Today.AddMonths(1);
            newCheque.IssueDate = DateTime.Today;
            newCheque.Status = ChequeStatus.InHand;

            var saved = await ChequeSvc.SaveAsync(newCheque);
            Toast.Success($"چک شماره {saved.Number} به مبلغ {saved.Amount:N0} ریال با موفقیت در دفتر چک ثبت شد.");
            
            try
            {
                var allAccs = await AccountSvc.GetAllAsync(activeOnly: true, withBalances: false);
                myBankAccounts = allAccs.Where(a => a.Kind == TreasuryAccountKind.Bank).ToList();
            }
            catch { myBankAccounts = new(); }

            var chqRes = await ChequeSvc.GetAllAsync(pageSize: 20);
            chequesList = chqRes.Items;

            newCheque = new TrsCheque { Kind = newCheque.Kind, DueDate = DateTime.Today.AddMonths(1) };
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در ثبت چک: " + ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task GenerateInstallmentsAsync()
    {
        if (instPartyId <= 0) { Toast.Error("لطفاً مشتری را انتخاب کنید."); return; }
        if (instTotalAmount <= 0) { Toast.Error("مبلغ بدهی اقساطی باید بزرگ‌تر از صفر باشد."); return; }
        if (instCount <= 0) { Toast.Error("تعداد اقساط باید حداقل ۱ قسط باشد."); return; }

        saving = true;
        try
        {
            if (openingServiceProduct == null) await EnsureOpeningProductsAsync();
            var svcProdId = openingServiceProduct?.Id ?? (productLookup.FirstOrDefault()?.Id ?? 1);
            var dummyWh = warehouseLookup.FirstOrDefault();
            var eachAmount = Math.Round(instTotalAmount / instCount, 0);

            var insts = new List<InstallmentDto>();
            var startDate = instFirstDueDate ?? DateTime.Today.AddMonths(1);

            for (int i = 0; i < instCount; i++)
            {
                var dueDate = startDate.AddMonths(i * instIntervalMonths);
                var amt = (i == instCount - 1) ? (instTotalAmount - (eachAmount * (instCount - 1))) : eachAmount;
                insts.Add(new InstallmentDto
                {
                    No = i + 1,
                    DueDate = dueDate,
                    Amount = amt
                });
            }

            var lastDueDate = startDate.AddMonths(instCount * instIntervalMonths);

            var cmd = new OrderCommand
            {
                Type = TransactionType.Sale,
                PartyId = instPartyId,
                WarehouseId = dummyWh?.Id ?? 1,
                Date = DateTime.Today,
                PaymentMethod = PaymentMethod.Installment,
                DueDate = lastDueDate,
                Description = instNote,
                Lines = new List<OrderLineInput>
                {
                    new()
                    {
                        ProductId = svcProdId,
                        Quantity = 1,
                        Price = instTotalAmount
                    }
                },
                Installments = insts
            };

            var created = await OrderSvc.CreateAsync(cmd);
            Toast.Success($"دفترچه اقساط بدهی افتتاحیه با {instCount} قسط با موفقیت صادر شد.");
            recentInstallmentOrders.Insert(0, created);

            instTotalAmount = 0;
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در ثبت اقساط: " + ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

    private async Task SaveOpeningStockAsync()
    {
        if (stockWarehouseId <= 0) { Toast.Error("لطفاً انبار را انتخاب کنید."); return; }
        if (stockProductId <= 0) { Toast.Error("لطفاً کالا را انتخاب کنید."); return; }
        if (stockQuantity <= 0) { Toast.Error("تعداد کالا باید بزرگ‌تر از صفر باشد."); return; }

        saving = true;
        try
        {
            var cmd = new OrderCommand
            {
                Type = TransactionType.Purchase,
                PartyId = allPartiesLookup.FirstOrDefault()?.Id ?? 1,
                WarehouseId = stockWarehouseId,
                Date = DateTime.Today,
                PaymentMethod = PaymentMethod.Cash,
                Description = stockDescription,
                Lines = new List<OrderLineInput>
                {
                    new()
                    {
                        ProductId = stockProductId,
                        Quantity = stockQuantity,
                        Price = stockUnitPrice
                    }
                }
            };

            await OrderSvc.CreateAsync(cmd);
            var prodName = productLookup.FirstOrDefault(p => p.Id == stockProductId)?.Name ?? "";
            var whName = warehouseLookup.FirstOrDefault(w => w.Id == stockWarehouseId)?.Name ?? "";

            Toast.Success($"موجودی اولیه کالای «{prodName}» به تعداد {stockQuantity} در انبار «{whName}» ثبت شد.");

            recentStockLines.Insert(0, new OpeningStockLine
            {
                WarehouseName = whName,
                ProductName = prodName,
                Quantity = stockQuantity,
                UnitPrice = stockUnitPrice,
                Date = DateTime.Today
            });

            stockQuantity = 1;
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در ثبت موجودی: " + ex.Message);
        }
        finally
        {
            saving = false;
        }
    }

