@namespace Inventory.Client.Pages
@page "/office-machines"
@inject HttpClient Http
@inject IJSRuntime JS
@inject IToastService Toast

<PageTitle>ماشین‌های اداری</PageTitle>

<div class="omx">
    @* ============================== سربرگ ============================== *@
    <div class="page-head omx-head">
        <h1>ماشین‌های اداری</h1>
        <div class="d-flex gap-2 flex-wrap ms-auto">
            <button type="button" class="btn btn-outline-secondary" @onclick="OpenDiscover">کشف دستگاه
                @if (dash.UnlinkedAgentPrinters > 0) { <span class="badge rounded-pill text-bg-warning ms-1">@dash.UnlinkedAgentPrinters</span> }
            </button>
            <button type="button" class="btn btn-outline-secondary" disabled="@polling" @onclick="PollAll">پایش همه</button>
            <button type="button" class="btn btn-primary" @onclick="OpenForm"><i class="bi bi-plus-lg"></i> دستگاه جدید</button>
        </div>
    </div>

    <ul class="nav omx-tabs">
        <li class="nav-item"><a class="nav-link @(pageTab == "devices" ? "active" : "")" @onclick='() => pageTab = "devices"'><i class="bi bi-grid-3x2-gap"></i> دستگاه‌ها</a></li>
        <li class="nav-item">
            <a class="nav-link @(pageTab == "alerts" ? "active" : "")" @onclick='() => pageTab = "alerts"'>
                <i class="bi bi-bell"></i> هشدارها
                @if (openEvents.Count > 0) { <span class="badge rounded-pill @(openEvents.Any(e => e.Severity == "Critical") ? "bg-danger" : "bg-warning text-dark") ms-1">@openEvents.Count</span> }
            </a>
        </li>
    </ul>

    @if (isLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (pageTab == "devices")
    {
        @* ============================== KPI ============================== *@
        <div class="omx-kpis">
            <div class="omx-kpi @(filter == "all" ? "sel" : "")" @onclick='() => filter = "all"'>
                <i style="background:#eef1ff;color:#4f6bff" class="bi bi-printer"></i><span>کل دستگاه‌ها</span><b>@dash.Total</b>
            </div>
            <div class="omx-kpi @(filter == "online" ? "sel" : "")" @onclick='() => filter = "online"'>
                <i style="background:#dcfce7;color:#16a34a" class="bi bi-check-circle"></i><span>آماده</span><b class="text-success">@dash.Online</b>
            </div>
            <div class="omx-kpi @(filter == "problem" ? "sel" : "")" @onclick='() => filter = "problem"'>
                <i style="background:#fee2e2;color:#ef4444" class="bi bi-exclamation-triangle"></i><span>خطا / هشدار</span><b class="text-danger">@(dash.Error + dash.Warning)</b>
            </div>
            <div class="omx-kpi @(filter == "offline" ? "sel" : "")" @onclick='() => filter = "offline"'>
                <i style="background:#f1f5f9;color:#64748b" class="bi bi-wifi-off"></i><span>آفلاین</span><b class="text-secondary">@dash.Offline</b>
            </div>
            <div class="omx-kpi @(filter == "lowsupply" ? "sel" : "")" @onclick='() => filter = "lowsupply"'>
                <i style="background:#fef3c7;color:#b45309" class="bi bi-droplet-half"></i><span>تونر رو به اتمام</span><b style="color:#b45309">@dash.LowSupply</b>
            </div>
            <div class="omx-kpi">
                <i style="background:#ede9fe;color:#7c3aed" class="bi bi-file-earmark-text"></i><span>تیراژ ۳۰ روز اخیر</span><b>@dash.Pages30d.ToString("N0")</b>
            </div>
        </div>

        @if (dash.WarrantyExpiring > 0 || dash.ContractExpiring > 0)
        {
            <div class="alert alert-warning py-2 small mt-3 mb-0">
                <i class="bi bi-calendar-x"></i>
                @if (dash.WarrantyExpiring > 0) { <span>گارانتی @dash.WarrantyExpiring دستگاه تا ۳۰ روز آینده تمام می‌شود. </span> }
                @if (dash.ContractExpiring > 0) { <span>قرارداد سرویس @dash.ContractExpiring دستگاه تا ۳۰ روز آینده تمام می‌شود.</span> }
            </div>
        }

        @* ============================== فیلتر و جستجو ============================== *@
        <div class="omx-bar">
            <div class="omx-search">
                <i class="bi bi-search"></i>
                <input class="form-control" placeholder="جستجو" @bind="searchText" @bind:event="oninput" />
            </div>
            <div class="d-flex gap-1 flex-wrap">
                @foreach (var (key, title) in new[] { ("all", "همه"), ("problem", "مشکل‌دار"), ("offline", "آفلاین"), ("lowsupply", "تونر کم"), ("repair", "در تعمیر"), ("unmonitored", "بدون پایش"), ("retired", "خارج از رده") })
                {
                    var k = key;
                    <span class="omx-chip @(filter == k ? "on" : "")" @onclick="() => filter = k">@title <em>@CountFilter(k)</em></span>
                }
            </div>
            <div class="btn-group btn-group-sm ms-auto">
                <button class="btn @(view == "cards" ? "btn-primary" : "btn-outline-secondary")" title="نمای کارت" @onclick='() => view = "cards"'><i class="bi bi-grid-3x2-gap-fill"></i></button>
                <button class="btn @(view == "table" ? "btn-primary" : "btn-outline-secondary")" title="نمای جدول" @onclick='() => view = "table"'><i class="bi bi-list-ul"></i></button>
            </div>
        </div>

        @if (!Filtered.Any())
        {
            <div class="omx-empty">
                <i class="bi bi-printer"></i>
                @if (items.Count == 0)
                {
                    <p>هنوز دستگاهی ثبت نشده است.</p>
                    <div class="d-flex gap-2 justify-content-center">
                        <button class="btn btn-primary btn-sm" @onclick="OpenForm">دستگاه جدید</button>
                        <button class="btn btn-outline-primary btn-sm" @onclick="OpenDiscover">کشف دستگاه</button>
                    </div>
                }
                else { <p>دستگاهی با این فیلتر پیدا نشد.</p> }
            </div>
        }
        else if (view == "cards")
        {
            @* ============================== نمای کارت ============================== *@
            <div class="omx-grid">
                @foreach (var m in Filtered)
                {
                    var mm = m;
                    <div class="omx-dev @(m.Status == "Retired" ? "retired" : "")" @onclick="() => OpenDetail(mm.Id)">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="min-w-0">
                                <h3 title="@m.Model"><i class="bi @DeviceIcon(m.DeviceType) text-primary"></i> @m.Model</h3>
                                <div class="sub">@(m.Brand ?? DeviceTypeTitle(m.DeviceType))@(m.IsColor ? " · رنگی" : "") · @(m.Location ?? "بدون محل")</div>
                            </div>
                            <span class="omx-st @StateCss(m.OnlineState)">@StateTitle(m.OnlineState)</span>
                        </div>
                        <div class="omx-meta">
                            @if (m.ConnectionType == "Network")
                            { <span><i class="bi bi-hdd-network"></i> <b dir="ltr">@(m.IpAddress ?? "—")</b></span> }
                            else
                            { <span title="@m.AgentPrinterName"><i class="bi bi-usb-plug"></i> @(m.LinkedSystemLabel ?? "کابلی")</span> }
                            @if (m.AssignedUserName != null) { <span title="@m.CompanyName"><i class="bi bi-person"></i> @m.AssignedUserName</span> }
                            else if (m.CompanyName != null) { <span><i class="bi bi-building"></i> @m.CompanyName</span> }
                            @if (m.LastPageCount != null) { <span><i class="bi bi-files"></i> <b>@N0(m.LastPageCount)</b></span> }
                            @if (m.Status != "InService") { <span class="badge @StatusCss(m.Status)">@StatusTitle(m.Status)</span> }
                        </div>
                        @if (m.Monitored && m.OnlineState != "NotMonitored")
                        {
                            @if (m.ByAgent && m.OnlineState == "Unknown")
                            {
                                <div class="omx-lcd">بدون گزارش · @Ago(m.AgentLastReportAt)</div>
                            }
                            else if (m.OnlineState == "Offline")
                            {
                                <div class="omx-lcd e">@(m.ByAgent ? "آفلاین" : "بدون پاسخ") · @Ago(m.LastSeenOnlineAt)</div>
                            }
                            else if (!string.IsNullOrWhiteSpace(m.LastStatusText))
                            {
                                <div class="omx-lcd @(m.OnlineState == "Error" ? "e" : "")" dir="ltr">@m.LastStatusText</div>
                            }
                            @if (m.MainSupplies.Any())
                            {
                                <div class="omx-toners">
                                    @foreach (var s in m.MainSupplies)
                                    {
                                        <div class="omx-tn @(s.Percent != null && s.Percent <= m.SupplyLowThreshold ? "low" : "")" title="@s.Description">
                                            <span class="dot" style="background:@SupplyColorCss(s.Color, s.Kind)"></span>
                                            <div class="track"><div class="fill" style="width:@(s.Percent ?? 0)%;background:@SupplyColorCss(s.Color, s.Kind)"></div></div>
                                            <span class="pc">@(s.Percent?.ToString() + "%" ?? "OK")</span>
                                        </div>
                                    }
                                </div>
                            }
                            @if (m.ByAgent)
                            {
                                <div class="omx-queue">
                                    <span title="کارهای در صف چاپ"><i class="bi bi-stack"></i> صف: <b>@m.JobsCount</b></span>
                                    @if (m.JobsInError > 0) { <span class="text-danger"><i class="bi bi-x-octagon"></i> خطا: <b>@m.JobsInError</b></span> }
                                    @if (m.OldestJobMinutes is > 0) { <span title="قدیمی‌ترین کار در صف"><i class="bi bi-hourglass-split"></i> @m.OldestJobMinutes دقیقه</span> }
                                    <span class="ms-auto text-muted" title="آخرین گزارش ایجنت"><i class="bi bi-cpu"></i> @Ago(m.AgentLastReportAt)</span>
                                </div>
                            }
                            @if (m.Flags.Any())
                            {
                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach (var f in m.Flags.Take(4)) { <span class="omx-flag">@FlagTitle(f)</span> }
                                </div>
                            }
                        }
                        else if (m.ConnectionType == "Network")
                        {
                            <div class="omx-hint">بدون پایش</div>
                        }
                        else
                        {
                            <div class="omx-hint">USB · بدون پایش</div>
                        }
                        <div class="omx-foot">
                            <span>
                                <i class="bi bi-tools"></i> @m.RepairCount
                                @if (m.TotalCost > 0) { <span class="ms-2"><i class="bi bi-cash-coin"></i> @m.TotalCost.ToString("N0")</span> }
                                @if (m.OpenEvents > 0) { <span class="ms-2 text-danger"><i class="bi bi-bell-fill"></i> @m.OpenEvents</span> }
                            </span>
                            <span>@(m.SnmpEnabled ? "پایش: " + Ago(m.LastPollAt) : "")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            @* ============================== نمای جدول ============================== *@
            <div class="card border-0 shadow-sm mt-1">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 small" style="white-space:nowrap;">
                        <thead class="table-light">
                            <tr><th>وضعیت</th><th>دستگاه</th><th>کاربر / شرکت</th><th>IP / اتصال</th><th>محل / واحد</th><th>سریال</th><th>کمترین تونر</th><th>شمارنده</th><th>تیراژ ۳۰ روز</th><th>تعمیر</th><th>آخرین پایش</th><th></th></tr>
                        </thead>
                        <tbody>
                            @foreach (var m in Filtered)
                            {
                                var mm = m;
                                <tr class="@(m.Status == "Retired" ? "opacity-50" : "")" style="cursor:pointer" @onclick="() => OpenDetail(mm.Id)">
                                    <td><span class="omx-st @StateCss(m.OnlineState)">@StateTitle(m.OnlineState)</span></td>
                                    <td>
                                        <div class="fw-800">@m.Model</div>
                                        <div class="text-muted">@(m.Brand ?? DeviceTypeTitle(m.DeviceType)) @if (m.Status != "InService") { <span class="badge @StatusCss(m.Status)">@StatusTitle(m.Status)</span> }</div>
                                    </td>
                                    <td>@(m.AssignedUserName ?? "—")<div class="text-muted">@m.CompanyName</div></td>
                                    <td dir="ltr" class="text-end">@(m.ConnectionType == "Network" ? m.IpAddress : "USB")</td>
                                    <td>@(m.Location ?? "—")<div class="text-muted">@m.Department</div></td>
                                    <td><code>@(m.SerialNumber ?? "—")</code></td>
                                    <td>
                                        @if (m.LowestSupplyPercent != null)
                                        { <span class="fw-800 @(m.LowestSupplyPercent <= m.SupplyLowThreshold ? "text-danger" : "")">@m.LowestSupplyPercent%</span> }
                                        else { <span>—</span> }
                                    </td>
                                    <td>@N0(m.LastPageCount)</td>
                                    <td>@(m.Pages30d > 0 ? m.Pages30d.ToString("N0") : "—")</td>
                                    <td>@m.RepairCount</td>
                                    <td>@(m.SnmpEnabled ? Ago(m.LastPollAt) : m.ByAgent ? Ago(m.AgentLastReportAt) : "—")</td>
                                    <td @onclick:stopPropagation="true">
                                        <div class="d-flex gap-1">
                                            @if (m.Monitored) { <button class="btn btn-sm btn-outline-success omx-ops" title="پایش فوری" disabled="@polling" @onclick="() => PollNow(mm.Id)"><i class="bi bi-arrow-repeat"></i></button> }
                                            <button class="btn btn-sm btn-outline-primary omx-ops" title="ویرایش" @onclick="() => Edit(mm)"><i class="bi bi-pencil-fill"></i></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    }
    else
    {
        @* ============================== تب هشدارها ============================== *@
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                @if (openEvents.Count == 0)
                {
                    <div class="omx-empty"><p>هشدار بازی وجود ندارد.</p></div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle small mb-0">
                            <thead class="table-light"><tr><th>شدت</th><th>دستگاه</th><th>شرح</th><th>از</th><th>آخرین مشاهده</th><th></th></tr></thead>
                            <tbody>
                                @foreach (var e in openEvents)
                                {
                                    var ee = e;
                                    <tr>
                                        <td><span class="omx-sev @e.Severity.ToLowerInvariant()">@(e.Severity == "Critical" ? "بحرانی" : e.Severity == "Warning" ? "هشدار" : "اطلاع")</span></td>
                                        <td><a href="javascript:void(0)" class="fw-800" @onclick="() => OpenDetail(ee.MachineId, EventTab(ee))">@e.Model</a><div class="text-muted">@e.Location <span dir="ltr">@e.IpAddress</span></div></td>
                                        <td>@e.Message</td>
                                        <td>@e.OpenedAt.ToFaDateTime()</td>
                                        <td>@Ago(e.LastSeenAt)</td>
                                        <td><button class="btn btn-sm btn-outline-success" @onclick="() => ResolveEvent(ee.Id)">رسیدگی شد</button></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@* ======================================================================
   مودال جزئیات دستگاه
   ====================================================================== *@
@if (detail != null)
{
    var m = detail.Machine;
    var openEv = detail.Events.Count(e => !e.IsResolved);
    var devMsg = m.SnmpEnabled
        ? (m.OnlineState == "Offline" ? (m.LastPollError ?? "No response") : m.LastStatusText)
        : m.ByAgent ? (m.OnlineState is "Offline" or "Unknown" ? m.LastPollError : m.LastStatusText) : null;
    var hasSupplyTab = m.Monitored || m.Supplies.Any() || detail.Trays.Any();
    <div class="modal fade show d-block omf-backdrop" role="dialog" aria-modal="true" aria-labelledby="omd-title">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down omd-dialog" @onclick:stopPropagation="true">
            <div class="modal-content omf-modal" dir="rtl">
                <div class="modal-header omf-header omd-header">
                    <div class="omd-heading">
                        <h5 id="omd-title" class="modal-title">@m.Model</h5>
                        <div class="omd-sub">
                            @(m.Brand ?? DeviceTypeTitle(m.DeviceType))
                            @if (!string.IsNullOrWhiteSpace(m.SerialNumber)) { <span> · </span><span dir="ltr">@m.SerialNumber</span> }
                        </div>
                    </div>
                    <div class="omd-actions">
                        @if (m.Monitored)
                        {
                            <button type="button" class="btn btn-sm btn-outline-secondary" disabled="@polling" @onclick="() => PollNow(m.Id)">
                                @if (polling) { <span class="spinner-border spinner-border-sm"></span> } پایش
                            </button>
                        }
                        @if (m.ConnectionType == "Network" && !string.IsNullOrWhiteSpace(m.IpAddress))
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="@($"http://{m.IpAddress}")" target="_blank" rel="noopener">پنل وب</a>
                        }
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="() => Edit(m)">ویرایش</button>
                        <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseDetail"></button>
                    </div>
                </div>

                <div class="omd-meta">
                    <span class="omx-st @StateCss(m.OnlineState)">@StateTitle(m.OnlineState)</span>
                    @if (m.Status != "InService") { <span class="badge @StatusCss(m.Status)">@StatusTitle(m.Status)</span> }
                    @foreach (var f in m.Flags) { <span class="omd-flag">@FlagTitle(f)</span> }
                    @if (!string.IsNullOrWhiteSpace(devMsg)) { <span class="omd-msg" dir="auto">@devMsg</span> }
                </div>

                <div class="omd-tabs">
                    <button type="button" class="@(detailTab == "overview" ? "active" : "")" @onclick='() => SwitchDetailTab("overview")'>اطلاعات</button>
                    @if (hasSupplyTab)
                    {
                        <button type="button" class="@(detailTab == "supplies" ? "active" : "")" @onclick='() => SwitchDetailTab("supplies")'>مواد مصرفی</button>
                    }
                    <button type="button" class="@(detailTab == "events" ? "active" : "")" @onclick='() => SwitchDetailTab("events")'>رویدادها @if (openEv > 0) { <span>@openEv</span> }</button>
                    <button type="button" class="@(detailTab == "repairs" ? "active" : "")" @onclick='() => SwitchDetailTab("repairs")'>تعمیرات @if (m.RepairCount > 0) { <span>@m.RepairCount</span> }</button>
                    <button type="button" class="@(detailTab == "costs" ? "active" : "")" @onclick='() => SwitchDetailTab("costs")'>هزینه‌ها</button>
                </div>

                <div class="modal-body omd-body">
                    @switch (detailTab)
                    {
                        case "overview":
                            <div class="omf-grid">
                                <div class="omd-col">
                                    <div class="omd-info">
                                        <div><span>کاربر</span><b>@(m.AssignedUserName ?? "—")</b></div>
                                        <div><span>شرکت</span><b>@(m.CompanyName ?? "—")</b></div>
                                        <div><span>محل استقرار</span><b>@(m.Location ?? "—")</b></div>
                                        <div><span>واحد</span><b>@(m.Department ?? "—")</b></div>
                                        @if (m.ConnectionType == "Network")
                                        {
                                            <div><span>آدرس IP</span><b dir="ltr" class="omd-ltr">@(m.IpAddress ?? "—")</b></div>
                                        }
                                        else
                                        {
                                            <div><span>سیستم (USB)</span><b dir="ltr" class="omd-ltr">@(m.LinkedSystemLabel ?? "—")</b></div>
                                        }
                                        <div><span>شماره اموال</span><b>@(m.AssetTag ?? "—")</b></div>
                                        <div><span>شمارنده</span><b>@N0(m.LastPageCount)</b></div>
                                        <div><span>تیراژ ۳۰ روز</span><b>@(m.Pages30d > 0 ? m.Pages30d.ToString("N0") : "—")</b></div>
                                    </div>

                                    @if (m.Supplies.Any(x => x.Kind is "Toner" or "Ink" or "Drum"))
                                    {
                                        <section class="omd-block">
                                            <div class="omd-block-title">تونر</div>
                                            <div class="omd-block-body omx-supplies">
                                                @foreach (var s in m.Supplies.Where(x => x.Kind is "Toner" or "Ink" or "Drum"))
                                                {
                                                    <div class="omx-tn wide @(s.Percent != null && s.Percent <= m.SupplyLowThreshold ? "low" : "")" title="@s.Description">
                                                        <span class="dot" style="background:@SupplyColorCss(s.Color, s.Kind)"></span>
                                                        <span class="lbl">@SupplyLabel(s)</span>
                                                        <div class="track"><div class="fill" style="width:@(s.Percent ?? 0)%;background:@SupplyColorCss(s.Color, s.Kind)"></div></div>
                                                        <span class="pc">@(s.Percent != null ? s.Percent + "%" : "OK")</span>
                                                    </div>
                                                }
                                            </div>
                                        </section>
                                    }

                                    @if (detail.Monthly.Count > 0)
                                    {
                                        var maxP = Math.Max(1, detail.Monthly.Max(x => x.Pages));
                                        <section class="omd-block">
                                            <div class="omd-block-title">تیراژ ماهانه</div>
                                            <div class="omd-block-body">
                                                <div class="omx-chart">
                                                    @foreach (var mo in detail.Monthly)
                                                    {
                                                        <div class="col" title="@mo.Pages.ToString("N0") صفحه">
                                                            <small>@(mo.Pages > 0 ? mo.Pages.ToString("N0") : "")</small>
                                                            <div class="bar" style="height:@(Math.Max(2, mo.Pages * 100 / maxP))%"></div>
                                                            <span>@FaMonths[mo.Month]</span>
                                                        </div>
                                                    }
                                                </div>
                                            </div>
                                        </section>
                                    }

                                    @if (!string.IsNullOrWhiteSpace(m.Notes))
                                    {
                                        <section class="omd-block">
                                            <div class="omd-block-title">توضیحات</div>
                                            <div class="omd-block-body" style="white-space:pre-wrap">@m.Notes</div>
                                        </section>
                                    }
                                </div>

                                <div class="omd-col">
                                    @if (m.ByAgent)
                                    {
                                        <section class="omd-block">
                                            <div class="omd-block-title">صف چاپ</div>
                                            <div class="omd-block-body">
                                                @if (!m.AgentPrinterPresent) { <div class="omd-warn">در آخرین گزارش ایجنت نبود.</div> }
                                                <dl class="omd-kv">
                                                    <dt>نام</dt><dd dir="ltr">@(m.AgentPrinterName ?? "—")</dd>
                                                    <dt>سیستم</dt><dd dir="ltr">@(m.AgentHost ?? "—")</dd>
                                                    <dt>درایور</dt><dd dir="ltr">@(m.AgentDriver ?? "—")</dd>
                                                    <dt>پورت</dt><dd dir="ltr">@(m.AgentPort ?? "—")</dd>
                                                    <dt>در صف</dt><dd class="@(m.JobsInError > 0 ? "text-danger" : "")">@m.JobsCount@(m.JobsInError > 0 ? $" ({m.JobsInError} خطا)" : "")</dd>
                                                    @if (m.OldestJobMinutes is > 0) { <dt>قدیمی‌ترین</dt><dd>@m.OldestJobMinutes دقیقه</dd> }
                                                    <dt>آخرین گزارش</dt><dd>@Ago(m.AgentLastReportAt)</dd>
                                                    <dt>شمارش صفحات</dt><dd>@(m.AgentPageLog ? "فعال" : "غیرفعال")</dd>
                                                </dl>
                                            </div>
                                        </section>
                                    }

                                    <section class="omd-block">
                                        <div class="omd-block-title">خرید و گارانتی</div>
                                        <div class="omd-block-body">
                                            <dl class="omd-kv">
                                                <dt>تاریخ خرید</dt><dd>@D(m.PurchaseDate)</dd>
                                                <dt>مبلغ</dt><dd>@(m.PurchasePrice?.ToString("N0") ?? "—")</dd>
                                                <dt>تاریخ نصب</dt><dd>@D(m.InstallDate)</dd>
                                                <dt>گارانتی تا</dt><dd class="@ExpiryCss(m.WarrantyUntil)">@Expiry(m.WarrantyUntil)</dd>
                                                <dt>سرویس‌دهنده</dt><dd>@(m.ServiceVendor ?? "—")</dd>
                                                <dt>قرارداد تا</dt><dd class="@ExpiryCss(m.ServiceContractUntil)">@Expiry(m.ServiceContractUntil)</dd>
                                                <dt>هزینه‌ها</dt><dd>@(m.TotalCost > 0 ? m.TotalCost.ToString("N0") : "—")</dd>
                                            </dl>
                                        </div>
                                    </section>

                                    <details class="omf-fold">
                                        <summary>مشخصات فنی</summary>
                                        <div class="omf-fold-body">
                                            <dl class="omd-kv">
                                                <dt>نوع</dt><dd>@DeviceTypeTitle(m.DeviceType)@(m.IsColor ? "، رنگی" : "")</dd>
                                                @if (m.ConnectionType == "Network")
                                                {
                                                    <dt>MAC</dt><dd dir="ltr">@(m.MacAddress ?? "—")</dd>
                                                    <dt>نام میزبان</dt><dd dir="ltr">@(m.Hostname ?? "—")</dd>
                                                    <dt>SNMP</dt><dd dir="ltr">@(m.SnmpEnabled ? $"{m.SnmpVersion} : {m.SnmpPort}" : "—")</dd>
                                                }
                                                <dt>فریم‌ور</dt><dd dir="ltr">@(m.FirmwareVersion ?? "—")</dd>
                                                <dt>روشن از</dt><dd>@Uptime(m.UptimeSeconds)</dd>
                                                <dt>آخرین پایش</dt><dd>@(m.LastPollAt?.ToFaDateTime() ?? "—")</dd>
                                                <dt>پایش هر</dt><dd>@m.PollIntervalMinutes دقیقه</dd>
                                                <dt>هشدار تونر</dt><dd>زیر @m.SupplyLowThreshold٪</dd>
                                                <dt>گیرندهٔ هشدار</dt><dd>@(m.AlertsEnabled ? (m.ResponsibleName ?? "مدیران سیستم") : "خاموش")</dd>
                                                <dt>ثبت</dt><dd>@m.CreatedAt.ToFa()</dd>
                                            </dl>
                                            @if (!string.IsNullOrWhiteSpace(m.SysDescr)) { <div class="omd-sysdescr" dir="ltr">@m.SysDescr</div> }
                                        </div>
                                    </details>
                                </div>
                            </div>
                            break;

                        case "supplies":
                            @if (!m.Supplies.Any() && !detail.Trays.Any())
                            {
                                <div class="omd-empty">اطلاعاتی گزارش نشده است.</div>
                            }
                            @if (m.Supplies.Any())
                            {
                                <section class="omd-block">
                                    <div class="omd-block-title">مواد مصرفی</div>
                                    <div class="table-responsive">
                                        <table class="table align-middle mb-0 omd-table">
                                            <thead><tr><th style="width:150px">نوع</th><th>شرح</th><th style="width:40%">سطح</th></tr></thead>
                                            <tbody>
                                                @foreach (var s in m.Supplies)
                                                {
                                                    <tr>
                                                        <td><span class="dot-inline" style="background:@SupplyColorCss(s.Color, s.Kind)"></span> @SupplyLabel(s)</td>
                                                        <td dir="ltr" class="text-start">@s.Description</td>
                                                        <td>
                                                            <div class="omx-tn @(s.Percent != null && s.Percent <= m.SupplyLowThreshold && s.Kind != "Waste" ? "low" : "")" style="grid-template-columns:1fr 46px">
                                                                <div class="track"><div class="fill" style="width:@(s.Percent ?? 0)%;background:@SupplyColorCss(s.Color, s.Kind)"></div></div>
                                                                <span class="pc">@(s.Percent != null ? s.Percent + "%" : s.Level == -3 ? "OK" : "—")</span>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            }
                            @if (detail.Trays.Any())
                            {
                                <section class="omd-block">
                                    <div class="omd-block-title">سینی کاغذ</div>
                                    <div class="omd-block-body omx-trays">
                                        @foreach (var t in detail.Trays)
                                        {
                                            <div class="omx-tray">
                                                <div class="fw-semibold text-truncate" title="@t.Name">@t.Name</div>
                                                <div class="lv"><div style="height:@(t.Percent ?? 0)%"></div></div>
                                                <div class="small">
                                                    @if (t.CurrentLevel == 0 && t.MaxCapacity > 0) { <span class="text-danger">خالی</span> }
                                                    else if (t.CurrentLevel >= 0 && t.MaxCapacity > 0) { <span>@t.CurrentLevel / @t.MaxCapacity</span> }
                                                    else if (t.CurrentLevel == -3) { <span>کاغذ دارد</span> }
                                                    else { <span class="text-muted">—</span> }
                                                </div>
                                                @if (!string.IsNullOrWhiteSpace(t.MediaName)) { <div class="text-muted" style="font-size:11px" dir="ltr">@t.MediaName</div> }
                                            </div>
                                        }
                                    </div>
                                </section>
                            }
                            break;

                        case "events":
                            @if (!detail.Events.Any())
                            {
                                <div class="omd-empty">رویدادی ثبت نشده است.</div>
                            }
                            else
                            {
                                <section class="omd-block">
                                    @foreach (var e in detail.Events)
                                    {
                                        var ee = e;
                                        <div class="omx-ev @(e.IsResolved ? "resolved" : "")">
                                            <span class="omx-sev @(e.IsResolved ? "ok" : e.Severity.ToLowerInvariant())">@(e.IsResolved ? "بسته" : e.Severity == "Critical" ? "بحرانی" : e.Severity == "Warning" ? "هشدار" : "اطلاع")</span>
                                            <div class="flex-grow-1">
                                                <div>@e.Message</div>
                                                <div class="text-muted" style="font-size:11.5px">
                                                    @e.OpenedAt.ToFaDateTime()
                                                    @if (e.IsResolved) { <span> · بسته شد @e.ResolvedAt?.ToFaDateTime() @(e.ResolvedByName != null ? "(" + e.ResolvedByName + ")" : "")</span> }
                                                    else { <span> · آخرین بار @Ago(e.LastSeenAt)</span> }
                                                </div>
                                            </div>
                                            @if (!e.IsResolved) { <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="() => ResolveEvent(ee.Id)">بستن</button> }
                                        </div>
                                    }
                                </section>
                            }
                            break;

                        case "repairs":
                            @if (!string.IsNullOrWhiteSpace(repairError)) { <div class="alert alert-danger py-2">@repairError</div> }
                            <section class="omd-block">
                                <div class="omd-block-title">@(editingRepairId > 0 ? "ویرایش تعمیر" : "تعمیر جدید")</div>
                                <div class="omd-block-body">
                                    <div class="row g-3">
                                        <div class="col-md-4"><label class="form-label">تاریخ ارسال</label><DatePicker @bind-Value="rf.GoneDate" AllowClear="true" /></div>
                                        <div class="col-md-4"><label class="form-label">تاریخ برگشت</label><DatePicker @bind-Value="rf.ReturnDate" AllowClear="true" /></div>
                                        <div class="col-md-4"><label class="form-label">هزینه (تومان)</label><MoneyInput @bind-Value="rf.Cost" /></div>
                                        <div class="col-md-6"><label class="form-label" for="omd-problem">ایراد <span class="text-danger">*</span></label><textarea id="omd-problem" class="form-control" rows="2" @bind="rf.Problem"></textarea></div>
                                        <div class="col-md-6"><label class="form-label" for="omd-work">کار انجام‌شده</label><textarea id="omd-work" class="form-control" rows="2" @bind="rf.PerformedWork"></textarea></div>
                                    </div>
                                    <div class="omd-form-foot">
                                        <div class="form-check m-0"><input class="form-check-input" type="checkbox" id="rfFixed" @bind="rf.Fixed" /><label class="form-check-label" for="rfFixed">برطرف شد</label></div>
                                        <div class="d-flex gap-2">
                                            @if (editingRepairId > 0) { <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetRepairForm">انصراف</button> }
                                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveRepair">@(editingRepairId > 0 ? "ذخیره تغییرات" : "ثبت")</button>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <section class="omd-block">
                                <div class="omd-block-title">سابقه</div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 omd-table">
                                        <thead><tr><th>ارسال</th><th>برگشت</th><th>ایراد</th><th>کار انجام‌شده</th><th>هزینه</th><th>وضعیت</th><th></th></tr></thead>
                                        <tbody>
                                            @if (repairList.Count == 0) { <tr><td colspan="7" class="text-center text-muted py-3">تعمیری ثبت نشده است.</td></tr> }
                                            @foreach (var r in repairList)
                                            {
                                                var rr = r;
                                                <tr>
                                                    <td>@D(r.GoneDate)</td>
                                                    <td>@if (r.ReturnDate != null) { @r.ReturnDate.Value.ToFa() } else if (r.GoneDate != null) { <span class="text-danger">نزد تعمیرکار</span> } else { <span>—</span> }</td>
                                                    <td style="min-width:160px;white-space:normal">@r.Problem</td>
                                                    <td class="text-muted" style="min-width:160px;white-space:normal">@(r.PerformedWork ?? "—")</td>
                                                    <td>@(r.Cost > 0 ? r.Cost.ToString("N0") : "—")</td>
                                                    <td>@(r.Fixed ? "برطرف شد" : "باز")</td>
                                                    <td class="text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-link p-0 me-2" title="ویرایش" @onclick="() => EditRepair(rr)"><i class="bi bi-pencil"></i></button>
                                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger" title="حذف" @onclick="() => DelRepair(rr.Id)"><i class="bi bi-trash"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        @if (repairList.Any(r => r.Cost > 0))
                                        {
                                            <tfoot><tr><td colspan="4">جمع</td><td colspan="3">@repairList.Sum(r => r.Cost).ToString("N0")</td></tr></tfoot>
                                        }
                                    </table>
                                </div>
                            </section>
                            break;

                        case "costs":
                            @if (!string.IsNullOrWhiteSpace(costError)) { <div class="alert alert-danger py-2">@costError</div> }
                            <section class="omd-block">
                                <div class="omd-block-title">@(cf.Id > 0 ? "ویرایش هزینه" : "هزینهٔ جدید")</div>
                                <div class="omd-block-body">
                                    <div class="row g-3">
                                        <div class="col-md-4"><label class="form-label" for="omd-ctitle">عنوان <span class="text-danger">*</span></label><input id="omd-ctitle" class="form-control" maxlength="300" @bind="cf.Title" /></div>
                                        <div class="col-md-2">
                                            <label class="form-label" for="omd-ccat">دسته</label>
                                            <select id="omd-ccat" class="form-select" @bind="cf.Category">
                                                @foreach (var c in new[] { "Toner", "Paper", "Service", "Part", "Contract", "Other" }) { <option value="@c">@CostCategoryTitle(c)</option> }
                                            </select>
                                        </div>
                                        <div class="col-md-3"><label class="form-label">تاریخ</label><DatePicker Value="cf.CostDate" ValueChanged="@((DateTime? v) => cf.CostDate = v ?? DateTime.Now)" /></div>
                                        <div class="col-md-3"><label class="form-label">مبلغ (تومان) <span class="text-danger">*</span></label><MoneyInput @bind-Value="cf.Amount" /></div>
                                    </div>
                                    <div class="omd-form-foot justify-content-end">
                                        <div class="d-flex gap-2">
                                            @if (cf.Id > 0) { <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ResetCostForm">انصراف</button> }
                                            <button type="button" class="btn btn-sm btn-primary" @onclick="SaveCost">@(cf.Id > 0 ? "ذخیره تغییرات" : "ثبت")</button>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            <section class="omd-block">
                                <div class="omd-block-title">فهرست</div>
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 omd-table">
                                        <thead><tr><th>تاریخ</th><th>عنوان</th><th>دسته</th><th>مبلغ</th><th></th></tr></thead>
                                        <tbody>
                                            @if (costList.Count == 0) { <tr><td colspan="5" class="text-center text-muted py-3">هزینه‌ای ثبت نشده است.</td></tr> }
                                            @foreach (var c in costList)
                                            {
                                                var cc = c;
                                                <tr>
                                                    <td>@c.CostDate.ToFa()</td><td>@c.Title</td><td>@CostCategoryTitle(c.Category)</td><td>@c.Amount.ToString("N0")</td>
                                                    <td class="text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-link p-0 me-2" title="ویرایش" @onclick="() => EditCost(cc)"><i class="bi bi-pencil"></i></button>
                                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger" title="حذف" @onclick="() => DelCost(cc.Id)"><i class="bi bi-trash"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                        @if (costList.Count > 0)
                                        {
                                            <tfoot><tr><td colspan="3">جمع</td><td colspan="2">@costList.Sum(x => x.Amount).ToString("N0")</td></tr></tfoot>
                                        }
                                    </table>
                                </div>
                            </section>
                            break;
                    }
                </div>

                <div class="modal-footer omf-footer omd-footer">
                    <div class="d-flex gap-2">
                        @if (m.Status == "Retired")
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="() => Restore(m)">بازگشت به چرخه</button>
                            <button type="button" class="btn btn-outline-danger" @onclick="() => HardDelete(m)">حذف کامل</button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-danger" @onclick="() => Retire(m)">خارج از رده</button>
                        }
                    </div>
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseDetail">بستن</button>
                </div>
            </div>
        </div>
    </div>
}

@* ======================================================================
   مودال فرم ثبت/ویرایش
   ====================================================================== *@
@if (ShowForm)
{
    <div class="modal fade show d-block omf-backdrop" role="dialog" aria-modal="true" aria-labelledby="omf-title">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down omf-dialog" @onclick:stopPropagation="true">
            <div class="modal-content omf-modal" dir="rtl">
                <div class="modal-header omf-header">
                    <h5 id="omf-title" class="modal-title">@(editing ? "ویرایش دستگاه" : "دستگاه جدید")</h5>
                    <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseForm"></button>
                </div>

                <div class="modal-body omf-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@formError</div>
                    }

                    <div class="omf-grid">
                        <section class="omf-card">
                            <div class="row g-3">
                                <div class="col-md-4">
                                    <label class="form-label" for="omf-type">نوع</label>
                                    <select id="omf-type" class="form-select" @bind="form.DeviceType">
                                        @foreach (var t in new[] { "Printer", "MFP", "Copier", "Scanner", "Fax", "Plotter", "LabelPrinter", "Other" }) { <option value="@t">@DeviceTypeTitle(t)</option> }
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="omf-brand">برند</label>
                                    <input id="omf-brand" class="form-control" maxlength="80" list="omx-brands" @bind="form.Brand" />
                                    <datalist id="omx-brands">
                                        @foreach (var b in new[] { "HP", "Canon", "Kyocera", "Ricoh", "Sharp", "Brother", "Xerox", "Konica Minolta", "Epson", "Lexmark", "Samsung", "Toshiba", "Pantum", "Panasonic" }) { <option value="@b" /> }
                                    </datalist>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label" for="omf-model">مدل <span class="text-danger">*</span></label>
                                    <input id="omf-model" class="form-control" maxlength="150" @bind="form.Model" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="omf-serial">شماره سریال</label>
                                    <input id="omf-serial" class="form-control" dir="ltr" maxlength="150" @bind="form.SerialNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="omf-asset">شماره اموال</label>
                                    <input id="omf-asset" class="form-control" maxlength="80" @bind="form.AssetTag" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label">شرکت</label>
                                    <SearchSelect Items="CompanyItems" Value="form.CompanyId ?? 0" ValueChanged="(int v) => OnCompanySelected(v)" Placeholder="انتخاب شرکت" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">کاربر</label>
                                    <SearchSelect Items="PersonItems" Value="form.AssignedUserId ?? 0" ValueChanged="(int v) => OnPersonSelected(v)" Placeholder="نام یا شماره پرسنلی" />
                                </div>

                                <div class="col-md-6">
                                    <label class="form-label" for="omf-loc">محل استقرار</label>
                                    <input id="omf-loc" class="form-control" maxlength="250" @bind="form.Location" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="omf-dep">واحد</label>
                                    <input id="omf-dep" class="form-control" maxlength="150" @bind="form.Department" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="omf-notes">توضیحات</label>
                                    <textarea id="omf-notes" class="form-control" rows="2" maxlength="500" @bind="form.Notes"></textarea>
                                </div>
                            </div>
                        </section>

                        <section class="omf-card omf-side">
                            <div class="omf-label">اتصال</div>
                            <div class="btn-group w-100 omf-seg" role="group">
                                <button type="button" class="btn @(form.ConnectionType == "Network" ? "active" : "")" @onclick='() => SetConnection("Network")'>شبکه</button>
                                <button type="button" class="btn @(form.ConnectionType == "Cable" ? "active" : "")" @onclick='() => SetConnection("Cable")'>USB</button>
                            </div>

                            @if (form.ConnectionType == "Network")
                            {
                                <div>
                                    <label class="form-label" for="omf-ip">آدرس IP <span class="text-danger">*</span></label>
                                    <input id="omf-ip" class="form-control num" dir="ltr" maxlength="50" @bind="form.IpAddress" />
                                </div>
                                <div class="form-check">
                                    <input id="omf-snmp" class="form-check-input" type="checkbox" @bind="form.SnmpEnabled" />
                                    <label class="form-check-label" for="omf-snmp">پایش با SNMP</label>
                                </div>
                                @if (form.SnmpEnabled)
                                {
                                    <div class="omf-pair">
                                        <div>
                                            <label class="form-label" for="omf-ver">نسخه</label>
                                            <select id="omf-ver" class="form-select" @bind="form.SnmpVersion">
                                                <option value="v1">v1</option><option value="v2c">v2c</option><option value="v3">v3</option>
                                            </select>
                                        </div>
                                        @if (form.SnmpVersion != "v3")
                                        {
                                            <div>
                                                <label class="form-label" for="omf-comm">Community</label>
                                                <input id="omf-comm" type="password" class="form-control" dir="ltr" autocomplete="new-password" @bind="form.SnmpCommunity"
                                                       placeholder="@(form.HasCommunity ? "بدون تغییر" : "public")" />
                                            </div>
                                        }
                                        else
                                        {
                                            <div>
                                                <label class="form-label" for="omf-v3u">کاربر</label>
                                                <input id="omf-v3u" class="form-control" dir="ltr" autocomplete="off" @bind="form.SnmpV3User" />
                                            </div>
                                        }
                                    </div>
                                    @if (form.SnmpVersion == "v3")
                                    {
                                        <div class="omf-pair">
                                            <div>
                                                <label class="form-label" for="omf-v3a">رمز Auth</label>
                                                <input id="omf-v3a" type="password" class="form-control" dir="ltr" autocomplete="new-password" @bind="form.SnmpV3AuthPassword" placeholder="@(form.HasV3Auth ? "بدون تغییر" : "")" />
                                            </div>
                                            <div>
                                                <label class="form-label" for="omf-v3p">رمز Privacy</label>
                                                <input id="omf-v3p" type="password" class="form-control" dir="ltr" autocomplete="new-password" @bind="form.SnmpV3PrivPassword" placeholder="@(form.HasV3Priv ? "بدون تغییر" : "")" />
                                            </div>
                                        </div>
                                    }
                                    <div>
                                        <button type="button" class="btn btn-outline-secondary btn-sm" disabled="@testing" @onclick="TestSnmp">
                                            @if (testing) { <span class="spinner-border spinner-border-sm"></span> } تست اتصال
                                        </button>
                                        @if (testResult != null)
                                        {
                                            @if (testResult.Ok)
                                            {
                                                <div class="omf-test ok">
                                                    @testResult.Brand @testResult.Model
                                                    <button type="button" class="btn btn-link btn-sm p-0" @onclick="() => ApplyTestResult(false)">تکمیل فرم</button>
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="omf-test err">@testResult.Message</div>
                                            }
                                        }
                                    </div>
                                }
                            }
                            else
                            {
                                <div>
                                    <label class="form-label">سیستم <span class="text-danger">*</span></label>
                                    <SearchSelect Items="SysItems" Value="form.LinkedSystemInfoId ?? 0" ValueChanged="(int v) => OnSysSelected(v)" Placeholder="نام سیستم یا کاربر" />
                                </div>
                                @if (form.LinkedSystemInfoId is > 0)
                                {
                                    <div>
                                        <label class="form-label" for="omf-queue">چاپگر روی سیستم</label>
                                        @if (loadingAgentPrinters)
                                        {
                                            <div class="omf-muted"><span class="spinner-border spinner-border-sm"></span></div>
                                        }
                                        else if (formAgentPrinters.Count == 0)
                                        {
                                            <div class="omf-muted">ایجنت این سیستم چاپگری گزارش نکرده است.</div>
                                        }
                                        else
                                        {
                                            <select id="omf-queue" class="form-select" value="@(form.AgentPrinterId?.ToString() ?? "")" @onchange="OnAgentPrinterChanged">
                                                <option value="">بدون پایش</option>
                                                @foreach (var ap in formAgentPrinters)
                                                {
                                                    var taken = ap.LinkedMachineId != null && ap.LinkedMachineId != editId;
                                                    <option value="@ap.Id" disabled="@(taken || !ap.IsPresent)">@ap.PrinterName@(taken ? " (اختصاص داده شده)" : !ap.IsPresent ? " (حذف شده)" : "")</option>
                                                }
                                            </select>
                                        }
                                    </div>
                                }
                            }

                            <div>
                                <label class="form-label" for="omf-status">وضعیت</label>
                                <select id="omf-status" class="form-select" @bind="form.Status">
                                    @foreach (var s in new[] { "InService", "InRepair", "Standby", "Retired" }) { <option value="@s">@StatusTitle(s)</option> }
                                </select>
                            </div>
                            <div class="form-check">
                                <input id="omf-color" class="form-check-input" type="checkbox" @bind="form.IsColor" />
                                <label class="form-check-label" for="omf-color">رنگی</label>
                            </div>
                        </section>
                    </div>

                    <div class="omf-extras">
                        <details class="omf-fold">
                            <summary>خرید و گارانتی</summary>
                            <div class="omf-fold-body">
                                <div class="row g-3">
                                    <div class="col-md-4"><label class="form-label">تاریخ خرید</label><DatePicker @bind-Value="form.PurchaseDate" AllowClear="true" /></div>
                                    <div class="col-md-4"><label class="form-label">مبلغ (تومان)</label><MoneyInput @bind-Value="form.PurchasePrice" /></div>
                                    <div class="col-md-4"><label class="form-label">تاریخ نصب</label><DatePicker @bind-Value="form.InstallDate" AllowClear="true" /></div>
                                    <div class="col-md-4"><label class="form-label">گارانتی تا</label><DatePicker @bind-Value="form.WarrantyUntil" AllowClear="true" /></div>
                                    <div class="col-md-4"><label class="form-label" for="omf-vendor">شرکت سرویس‌دهنده</label><input id="omf-vendor" class="form-control" maxlength="150" @bind="form.ServiceVendor" /></div>
                                    <div class="col-md-4"><label class="form-label">قرارداد سرویس تا</label><DatePicker @bind-Value="form.ServiceContractUntil" AllowClear="true" /></div>
                                </div>
                            </div>
                        </details>
                        <details class="omf-fold">
                            <summary>هشدارها</summary>
                            <div class="omf-fold-body">
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label" for="omf-resp">گیرندهٔ هشدار</label>
                                        <select id="omf-resp" class="form-select" @bind="form.ResponsibleUserId">
                                            <option value="">مدیران سیستم</option>
                                            @foreach (var u in userLookup) { <option value="@u.Id">@u.Name</option> }
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label" for="omf-th">تونر کمتر از ٪</label>
                                        <input id="omf-th" type="number" min="1" max="90" class="form-control num" @bind="form.SupplyLowThreshold" />
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label" for="omf-iv">پایش هر (دقیقه)</label>
                                        <input id="omf-iv" type="number" min="2" max="1440" class="form-control num" @bind="form.PollIntervalMinutes" />
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check">
                                            <input id="omf-alerts" class="form-check-input" type="checkbox" @bind="form.AlertsEnabled" />
                                            <label class="form-check-label" for="omf-alerts">ارسال اعلان</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </details>
                        @if (form.ConnectionType == "Network")
                        {
                            <details class="omf-fold">
                                <summary>شبکه</summary>
                                <div class="omf-fold-body">
                                    <div class="row g-3">
                                        <div class="col-md-6"><label class="form-label" for="omf-mac">MAC</label><input id="omf-mac" class="form-control" dir="ltr" maxlength="30" @bind="form.MacAddress" /></div>
                                        <div class="col-md-6"><label class="form-label" for="omf-port">پورت SNMP</label><input id="omf-port" type="number" class="form-control num" dir="ltr" @bind="form.SnmpPort" /></div>
                                        @if (form.SnmpVersion == "v3")
                                        {
                                            <div class="col-md-6">
                                                <label class="form-label" for="omf-aproto">Auth</label>
                                                <select id="omf-aproto" class="form-select" @bind="form.SnmpV3AuthProtocol"><option value="SHA1">SHA1</option><option value="SHA256">SHA256</option><option value="MD5">MD5</option><option value="None">بدون</option></select>
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label" for="omf-pproto">Privacy</label>
                                                <select id="omf-pproto" class="form-select" @bind="form.SnmpV3PrivProtocol"><option value="AES">AES</option><option value="DES">DES</option><option value="None">بدون</option></select>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </details>
                        }
                    </div>
                </div>

                <div class="modal-footer omf-footer">
                    <button type="button" class="btn btn-outline-secondary" @onclick="CloseForm">انصراف</button>
                    <button type="button" class="btn btn-primary" disabled="@busy" @onclick="Save">
                        @if (busy) { <span class="spinner-border spinner-border-sm"></span> }
                        @(editing ? "ذخیره تغییرات" : "ثبت")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@* ======================================================================
   مودال کشف دستگاه
   ====================================================================== *@
@if (ShowDiscover)
{
    <div class="modal fade show d-block omf-backdrop" role="dialog" aria-modal="true" aria-labelledby="omdisc-title">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down omd-dialog" @onclick:stopPropagation="true">
            <div class="modal-content omf-modal" dir="rtl">
                <div class="modal-header omf-header">
                    <h5 id="omdisc-title" class="modal-title">کشف دستگاه</h5>
                    <button type="button" class="btn-close" aria-label="بستن" @onclick="() => ShowDiscover = false" disabled="@scanning"></button>
                </div>
                <div class="omd-tabs">
                    <button type="button" class="@(discTab == "snmp" ? "active" : "")" @onclick='() => SwitchDiscTab("snmp")'>شبکه</button>
                    <button type="button" class="@(discTab == "agent" ? "active" : "")" @onclick='() => SwitchDiscTab("agent")'>USB @if (dash.UnlinkedAgentPrinters > 0) { <span>@dash.UnlinkedAgentPrinters</span> }</button>
                </div>
                <div class="modal-body omd-body">
                    @if (!string.IsNullOrWhiteSpace(discoverError)) { <div class="alert alert-danger py-2">@discoverError</div> }
                    @if (discTab == "agent")
                    {
                        <div class="omd-toolbar">
                            <input class="form-control" style="max-width:260px" placeholder="جستجو" @bind="agentSearch" @bind:event="oninput" />
                            <div class="form-check m-0"><input class="form-check-input" type="checkbox" id="agVirt" checked="@agentShowVirtual" @onchange="async e => { agentShowVirtual = (bool)e.Value!; await LoadAgentList(); }" /><label class="form-check-label" for="agVirt">مجازی و اشتراکی</label></div>
                            <div class="form-check m-0"><input class="form-check-input" type="checkbox" id="agIgn" checked="@agentShowIgnored" @onchange="async e => { agentShowIgnored = (bool)e.Value!; await LoadAgentList(); }" /><label class="form-check-label" for="agIgn">نادیده‌گرفته‌ها</label></div>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" disabled="@scanning" @onclick="LoadAgentList">بارگذاری مجدد</button>
                        </div>
                        @if (scanning && agentList == null)
                        {
                            <div class="text-center py-4"><div class="spinner-border spinner-border-sm text-secondary"></div></div>
                        }
                        else if (agentList is { Count: 0 })
                        {
                            <div class="omd-empty">هنوز چاپگری از ایجنت‌ها گزارش نشده است.</div>
                        }
                        else if (agentList != null)
                        {
                            <section class="omd-block">
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0 omd-table">
                                        <thead><tr><th></th><th>چاپگر</th><th>سیستم</th><th>نوع</th><th>وضعیت</th><th>صف</th><th>آخرین گزارش</th><th></th><th></th></tr></thead>
                                        <tbody>
                                            @foreach (var a in FilteredAgentList)
                                            {
                                                var aa = a;
                                                <tr class="@(!a.CanImport || a.IsIgnored ? "text-muted" : "")">
                                                    <td><input type="checkbox" class="form-check-input" disabled="@(!a.CanImport)" checked="@agentSelected.Contains(a.Id)" @onchange="() => ToggleAgent(aa.Id)" /></td>
                                                    <td dir="ltr" class="text-start">
                                                        <div class="fw-semibold">@a.PrinterName</div>
                                                        <div class="text-muted small">@a.DriverName · @a.PortName@(a.PortIp != null ? $" ({a.PortIp})" : "")</div>
                                                    </td>
                                                    <td><span dir="ltr">@(a.SystemLabel ?? a.HostName ?? a.AgentId)</span><div class="text-muted small">@a.SystemOwner</div></td>
                                                    <td>@AgentKindTitle(a.Kind)</td>
                                                    <td>@(a.IsPresent ? a.StatusTitle : "حذف شده")</td>
                                                    <td>@a.JobsCount@if (a.JobsInError > 0) { <span class="text-danger"> (@a.JobsInError خطا)</span> }</td>
                                                    <td class="@(a.Stale ? "text-warning-emphasis" : "")">@Ago(a.LastReportAt)</td>
                                                    <td class="small">
                                                        @if (a.LinkedMachineId != null) { <span>ثبت شده: @a.LinkedMachineModel</span> }
                                                        else if (a.NetworkMachineId != null) { <span>ثبت شده: @a.NetworkMachineModel</span> }
                                                        else if (a.IsPhysical && a.SystemInfoId == null) { <span>سیستم ثبت نشده</span> }
                                                        else if (a.CanImport) { <span class="text-primary">جدید</span> }
                                                    </td>
                                                    <td class="text-nowrap">
                                                        <button type="button" class="btn btn-sm btn-link p-0 me-2" title="@(a.IsIgnored ? "بازگرداندن" : "نادیده گرفتن")" @onclick="() => IgnoreAgentPrinter(aa)"><i class="bi @(a.IsIgnored ? "bi-eye" : "bi-eye-slash")"></i></button>
                                                        <button type="button" class="btn btn-sm btn-link p-0 text-danger" title="حذف" @onclick="() => DeleteAgentPrinter(aa)"><i class="bi bi-trash"></i></button>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </section>
                        }
                    }
                    else
                    {
                        <section class="omd-block">
                            <div class="omd-block-body">
                                <div class="row g-3 align-items-end">
                                    <div class="col-md-4"><label class="form-label" for="omd-range">بازهٔ IP</label><input id="omd-range" class="form-control" dir="ltr" @bind="disc.Range" placeholder="192.168.1.0/24" /></div>
                                    <div class="col-md-2">
                                        <label class="form-label" for="omd-dver">نسخه</label>
                                        <select id="omd-dver" class="form-select" @bind="disc.Version"><option value="v1">v1</option><option value="v2c">v2c</option><option value="v3">v3</option></select>
                                    </div>
                                    @if (disc.Version != "v3")
                                    {
                                        <div class="col-md-3"><label class="form-label" for="omd-dcomm">Community</label><input id="omd-dcomm" class="form-control" dir="ltr" @bind="disc.Community" /></div>
                                    }
                                    else
                                    {
                                        <div class="col-md-2"><label class="form-label">کاربر</label><input class="form-control" dir="ltr" @bind="disc.V3User" /></div>
                                        <div class="col-md-2"><label class="form-label">رمز Auth</label><input type="password" class="form-control" dir="ltr" @bind="disc.V3AuthPassword" /></div>
                                        <div class="col-md-2"><label class="form-label">رمز Privacy</label><input type="password" class="form-control" dir="ltr" @bind="disc.V3PrivPassword" /></div>
                                    }
                                    <div class="col-md-3 col-lg">
                                        <button type="button" class="btn btn-primary w-100" disabled="@scanning" @onclick="RunDiscover">
                                            @if (scanning) { <span class="spinner-border spinner-border-sm"></span> <span>در حال اسکن</span> } else { <span>اسکن</span> }
                                        </button>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-check m-0"><input class="form-check-input" type="checkbox" id="dPrinters" @bind="disc.PrintersOnly" /><label class="form-check-label" for="dPrinters">فقط چاپگرها</label></div>
                                    </div>
                                </div>
                            </div>
                        </section>

                        @if (discResult != null)
                        {
                            @if (discResult.Items.Count == 0)
                            {
                                <div class="omd-empty">از @discResult.Scanned آدرس، دستگاهی پاسخ نداد.</div>
                            }
                            else
                            {
                                <section class="omd-block">
                                    <div class="omd-block-title d-flex justify-content-between align-items-center flex-wrap gap-2">
                                        <span>@discResult.Items.Count دستگاه از @discResult.Scanned آدرس</span>
                                        <span class="d-flex align-items-center gap-2 fw-normal">
                                            <label class="m-0" for="omd-div">پایش هر</label>
                                            <input id="omd-div" type="number" class="form-control form-control-sm" style="width:72px" min="2" @bind="disc.PollIntervalMinutes" />
                                            <span>دقیقه</span>
                                        </span>
                                    </div>
                                    <div class="table-responsive">
                                        <table class="table table-hover align-middle mb-0 omd-table">
                                            <thead><tr><th></th><th>IP</th><th>دستگاه</th><th>سریال</th><th>نام / محل</th><th></th></tr></thead>
                                            <tbody>
                                                @foreach (var c in discResult.Items)
                                                {
                                                    var cc = c;
                                                    <tr class="@(c.ExistingMachineId != null ? "text-muted" : "")">
                                                        <td><input type="checkbox" class="form-check-input" disabled="@(c.ExistingMachineId != null)" checked="@discSelected.Contains(c.Ip)" @onchange="() => ToggleDisc(cc.Ip)" /></td>
                                                        <td dir="ltr" class="text-end">@c.Ip</td>
                                                        <td>@c.Brand <span class="fw-semibold">@c.Model</span>@if (!c.IsPrinter) { <span class="text-muted small"> (غیرچاپگر)</span> }</td>
                                                        <td dir="ltr">@(c.SerialNumber ?? "—")</td>
                                                        <td>@c.SysName <div class="text-muted small">@c.SysLocation</div></td>
                                                        <td class="small">@(c.ExistingMachineId != null ? "ثبت شده" : "")</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </div>
                                </section>
                            }
                        }
                    }
                </div>
                <div class="modal-footer omf-footer">
                    <button type="button" class="btn btn-outline-secondary" disabled="@scanning" @onclick="() => ShowDiscover = false">بستن</button>
                    @if (discTab == "agent")
                    {
                        <button type="button" class="btn btn-primary" disabled="@(scanning || agentSelected.Count == 0)" @onclick="ImportAgentPrinters">
                            @if (scanning) { <span class="spinner-border spinner-border-sm"></span> } ثبت @(agentSelected.Count > 0 ? agentSelected.Count + " مورد" : "")
                        </button>
                    }
                    else if (discResult?.Items.Any(i => i.ExistingMachineId == null) == true)
                    {
                        <button type="button" class="btn btn-primary" disabled="@(scanning || discSelected.Count == 0)" @onclick="ImportDiscovered">
                            ثبت @(discSelected.Count > 0 ? discSelected.Count + " مورد" : "")
                        </button>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
.omx{--pri:#4f6bff;--pri2:#8e5cff;--line:#e2e8f0;--mut:#64748b}
.omx-hero{background:linear-gradient(135deg,var(--pri),var(--pri2));color:#fff;border-radius:16px;padding:16px 20px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:12px;box-shadow:0 10px 30px rgba(79,107,255,.22)}
.omx-hero h1{margin:0;font-size:1.2rem;font-weight:800;display:flex;gap:8px;align-items:center}
.omx-hero small{opacity:.85;font-size:.78rem;display:block;margin-top:4px}
.omx-btn-glass{background:rgba(255,255,255,.18);color:#fff;border:1px solid rgba(255,255,255,.25);font-weight:700}
.omx-btn-glass:hover{background:rgba(255,255,255,.3);color:#fff}
.omx-btn-main{color:#4f5b8a}
.omx-tabs{gap:4px;margin:14px 0 12px;border-bottom:1px solid var(--line)}
.omx-tabs .nav-link{cursor:pointer;color:var(--mut);font-weight:700;border-radius:10px 10px 0 0;padding:.5rem 1rem}
.omx-tabs .nav-link.active{background:#fff;color:var(--pri);border:1px solid var(--line);border-bottom-color:#fff;margin-bottom:-1px}
.omx-queue{display:flex;gap:12px;align-items:center;font-size:.75rem;margin-top:8px;padding:6px 8px;background:#f8fafc;border-radius:8px;border:1px dashed var(--line)}
.omx-aplist{display:flex;flex-direction:column;gap:6px;max-height:260px;overflow:auto}
.omx-ap{display:flex;align-items:center;gap:10px;padding:8px 10px;border:1px solid var(--line);border-radius:10px;cursor:pointer;transition:.12s}
.omx-ap:hover{background:#f8fafc}
.omx-ap.sel{border-color:#86efac;background:#f0fdf4}
.omx-ap.dis{opacity:.55;cursor:not-allowed}
.omx-disc-tabs .nav-link{cursor:pointer;font-weight:700;font-size:.85rem}
.omx-kpis{display:grid;grid-template-columns:repeat(6,1fr);gap:10px}
.omx-kpi{background:#fff;border:1px solid var(--line);border-radius:14px;padding:12px 14px;position:relative;cursor:pointer;transition:.15s}
.omx-kpi:hover{box-shadow:0 6px 18px rgba(30,41,59,.07)}
.omx-kpi.sel{border-color:#a5b4fc;box-shadow:0 0 0 3px #eef1ff}
.omx-kpi span{color:var(--mut);font-size:.75rem}
.omx-kpi b{display:block;font-size:1.45rem;font-weight:800;margin-top:2px}
.omx-kpi>i{position:absolute;left:12px;top:12px;width:32px;height:32px;border-radius:10px;display:grid;place-items:center;font-size:1rem}
.omx-bar{display:flex;gap:8px;align-items:center;margin:14px 0;flex-wrap:wrap}
.omx-search{flex:1;min-width:220px;position:relative}
.omx-search i{position:absolute;right:11px;top:50%;transform:translateY(-50%);color:#94a3b8}
.omx-search input{padding-right:34px;border-radius:10px;font-size:.85rem}
.omx-chip{padding:5px 11px;border-radius:999px;border:1px solid var(--line);background:#fff;cursor:pointer;font-size:.75rem;font-weight:700;color:var(--mut);user-select:none}
.omx-chip.on{background:#eef1ff;border-color:#c7d0ff;color:var(--pri)}
.omx-chip em{font-style:normal;background:#f1f5f9;border-radius:999px;padding:0 6px;margin-right:3px}
.omx-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}
.omx-dev{background:#fff;border:1px solid var(--line);border-radius:16px;padding:14px;cursor:pointer;transition:.15s;display:flex;flex-direction:column}
.omx-dev:hover{transform:translateY(-2px);box-shadow:0 10px 24px rgba(30,41,59,.08)}
.omx-dev.retired{opacity:.55}
.omx-dev h3{margin:0;font-size:.95rem;font-weight:800;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.omx-dev .sub{color:var(--mut);font-size:.75rem;margin-top:2px}
.min-w-0{min-width:0}
.omx-st{font-size:.7rem;font-weight:800;padding:3px 9px;border-radius:999px;white-space:nowrap;display:inline-flex;align-items:center;gap:5px}
.omx-st:before{content:"";width:7px;height:7px;border-radius:50%;background:currentColor}
.omx-st.big{font-size:.8rem;padding:4px 12px}
.omx-st.ok{background:#dcfce7;color:#16a34a}.omx-st.warn{background:#fef3c7;color:#b45309}.omx-st.err{background:#fee2e2;color:#dc2626}.omx-st.off{background:#e2e8f0;color:#475569}.omx-st.na{background:#f1f5f9;color:#94a3b8}
.omx-meta{display:flex;gap:12px;margin:9px 0 4px;font-size:.75rem;color:var(--mut);flex-wrap:wrap;align-items:center}
.omx-meta b{color:#1e293b;font-family:Consolas,monospace}
.omx-lcd{background:#0f172a;color:#a7f3d0;font-family:Consolas,monospace;font-size:.72rem;border-radius:8px;padding:5px 10px;margin:6px 0;text-align:left;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.omx-lcd.e{color:#fca5a5}
