        new("ثبت مشخصات", "برای صادره روش ارسال؛ برای وارده اطلاعات مبدأ را تکمیل کنید."),
        new("پیگیری و نگهداری", "وضعیت ثبت، گردش، نسخه چاپی و بایگانی را بررسی کنید.")
    ];
    private static readonly GuideLink[] GuideSections =
