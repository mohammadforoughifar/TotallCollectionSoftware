@namespace Inventory.Client.Pages
@page "/fa-com"
@inject IFaComService Svc
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>تابلوی اعلان‌ها</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1><i class="bi bi-megaphone"></i> تابلوی اعلان‌ها</h1>
        <div class="lead">اطلاعیه‌های منابع انسانی برای شما</div>
    </div>
</div>

@if (!faRead)
{
    <div class="alert alert-warning">به این بخش دسترسی ندارید.</div>
    return;
}

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    return;
}

@if (feed.Count == 0)
{
    <div class="alert alert-info">اطلاعیه فعالی وجود ندارد.</div>
    return;
}

<div class="row g-3">
    @foreach (var a in feed)
    {
        <div class="col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h5 class="card-title mb-0">@a.Title</h5>
                        <span class="badge text-bg-info">@FaComUi.Audience(a.Audience)</span>
                    </div>
                    <p class="card-text" style="white-space:pre-wrap">@a.Body</p>
                </div>
                <div class="card-footer bg-white small text-muted">
                    @a.CreatedByName — @FaComUi.Dt(a.CreatedAt)
                    @if (!string.IsNullOrEmpty(a.OrgUnitName))
                    {
                        <span> — @a.OrgUnitName</span>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    private bool faRead => Auth.Has("FaCom.Read") || Auth.Has("FaCom.Manage") || Auth.IsAdmin;
    private bool loading = true;
    private List<FaComAnnouncementDto> feed = new();

    protected override async Task OnInitializedAsync()
    {
        if (!faRead) { loading = false; return; }
        try { feed = await Svc.GetFeedAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        loading = false;
    }
}
