        public int AutoScanMinutes { get; set; }
        public DateTime? LastScanAt { get; set; }
        public int LastScanAliveCount { get; set; }
        public int LastScanDurationMs { get; set; }
        public string Broadcast { get; set; } = "";
        public string Mask { get; set; } = "";
