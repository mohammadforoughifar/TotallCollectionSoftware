    public sealed class StatsInfo
    {
        public int Total { get; set; }
        public int Registered { get; set; }
        public int RegisteredOnline { get; set; }
        public int RegisteredOffline { get; set; }
        public int Unregistered { get; set; }
        public int Free { get; set; }
    }

    public sealed class OwnerInfo
    {
        public string Source { get; set; } = "";
        public string SourceTitle { get; set; } = "";
        public int RefId { get; set; }
        public string Title { get; set; } = "";
        public string? Detail { get; set; }
        public string? Link { get; set; }
        public string? Mac { get; set; }
    }

    public sealed class ReservedInfo
    {
        public string? Title { get; set; }
        public string? Type { get; set; }
        public string? Owner { get; set; }
        public string? Note { get; set; }
        public DateTime? UpdatedAt { get; set; }
        public string? UpdatedByName { get; set; }
    }

    public sealed class HostInfo
    {
        public string Ip { get; set; } = "";
        public long Num { get; set; }
        public string State { get; set; } = "free";
        public bool Alive { get; set; }
        public DateTime? LastSeenAt { get; set; }
        public DateTime? FirstSeenAt { get; set; }
        public DateTime? LastCheckedAt { get; set; }
        public string? Mac { get; set; }
        public string? Hostname { get; set; }
        public string? Method { get; set; }
        public List<OwnerInfo> Owners { get; set; } = new();
        public bool Conflict { get; set; }
        public ReservedInfo? Reserved { get; set; }
        public string? MacHint { get; set; }
        public string? MacMismatch { get; set; }
    }

    public sealed class ScanInfo
    {
        public bool Running { get; set; }
        public int Progress { get; set; }
        public int Total { get; set; }
        public int Scanned { get; set; }
        public int Found { get; set; }
        public string? Phase { get; set; }
        public string? StartedBy { get; set; }
        public string? Error { get; set; }
    }

    public sealed class MapResult
    {
        public SubnetInfo Subnet { get; set; } = new();
        public StatsInfo Stats { get; set; } = new();
        public List<HostInfo> Hosts { get; set; } = new();
        public ScanInfo? Scan { get; set; }
    }

    public sealed class StartScanResult { public bool Started { get; set; } public ScanInfo? Scan { get; set; } }
    public sealed class ProbeResult { public bool Alive { get; set; } public string? Method { get; set; } public string? Mac { get; set; } public string? Hostname { get; set; } }
    public sealed class IdResult { public int Id { get; set; } }

    public sealed class SubnetForm
    {
        public string Name { get; set; } = "";
        public string Cidr { get; set; } = "";
        public string? Gateway { get; set; }
        public int? Vlan { get; set; }
        public string? DnsServers { get; set; }
        public string? DhcpRange { get; set; }
        public string? Location { get; set; }
        public string? Description { get; set; }
        public int AutoScanMinutes { get; set; }
    }

    public sealed class ReserveForm
    {
        public string? Title { get; set; }
        public string? Type { get; set; }
        public string? Owner { get; set; }
        public string? Note { get; set; }
    }

    private sealed class Cell
    {
        public long Num { get; init; }
        public string Ip { get; init; } = "";
        public int LastOctet { get; init; }
        public string Kind { get; init; } = "host";   // host | network | broadcast
        public bool IsGateway { get; init; }
        public bool InDhcp { get; init; }
        public HostInfo? Host { get; set; }
        public bool IsEdge => Kind != "host";
    }

    private sealed class Block { public string Title { get; init; } = ""; public List<Cell> Cells { get; } = new(); }

    private sealed record TypeMeta(string Key, string Title);
    private static readonly TypeMeta[] ReservedTypes =
    {
        new("Server", "سرور"), new("Switch", "سوییچ"), new("Router", "روتر/میکروتیک"), new("Firewall", "فایروال"),
        new("AccessPoint", "اکسس‌پوینت"), new("Printer", "پرینتر"), new("Camera", "دوربین"), new("Pc", "کامپیوتر"),
        new("Phone", "تلفن VoIP"), new("Other", "سایر"),
    };
    private static string TypeFa(string? t) => ReservedTypes.FirstOrDefault(x => x.Key == t)?.Title ?? "";

    private sealed record AutoScanOption(int Minutes, string Title);
    private static readonly AutoScanOption[] AutoScanOptions =
    {
        new(0, "خاموش (فقط دستی)"), new(15, "هر ۱۵ دقیقه"), new(30, "هر ۳۰ دقیقه"), new(60, "هر ساعت"),
        new(180, "هر ۳ ساعت"), new(720, "هر ۱۲ ساعت"), new(1440, "روزی یک بار"),
    };

    // ------------------------------------------------------------ وضعیت
    private bool canView, canCreate, canUpdate, canDelete, canScan;
    private List<CompanyItem> companies = new();
    private int companyId;
    private bool loadingCompanies = true, loadingSubnets, loadingMap, busy, probing;

    private List<SubnetRow> subnets = new();
    private int selectedId;
    private MapResult? map;
    private List<Cell> cells = new();
    private List<Block> blocks = new();
    private ScanInfo? scan;
    private int problemCount;
    private long dhcpFrom, dhcpTo;

    private string filter = "all";
    private string view = "grid";
    private string search = "";

    private Cell? selCell;
    private bool editingReserve;
    private ReserveForm rf = new();

    private bool showSubnetModal;
    private int editSubnetId;
    private SubnetForm sf = new();

    private CancellationTokenSource? pollCts;
    private bool disposed;

    private bool ScanRunning => scan is { Running: true };
    private string CompanyName => companies.FirstOrDefault(c => c.Id == companyId)?.Name ?? "";

    // ------------------------------------------------------------ چرخهٔ عمر
    protected override async Task OnInitializedAsync()
    {
        canView = Auth.Has("Ipam.View");
        canCreate = Auth.Has("Ipam.Create");
        canUpdate = Auth.Has("Ipam.Update");
        canDelete = Auth.Has("Ipam.Delete");
        canScan = Auth.Has("Ipam.Scan");
        if (!canView) { loadingCompanies = false; return; }

        try
        {
            companies = await Api.GetAsync<List<CompanyItem>>("api/ipam/companies") ?? new();
            companyId = companies.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loadingCompanies = false; }

        if (companyId > 0) await LoadSubnets(selectFirst: true);
    }

    private async Task OnCompanyChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var id)) return;
        companyId = id;
        selectedId = 0;
        map = null;
        StopPolling();
        await LoadSubnets(selectFirst: true);
    }

    private async Task LoadSubnets(bool selectFirst = false)
    {
        loadingSubnets = true;
        try
        {
            subnets = await Api.GetAsync<List<SubnetRow>>($"api/ipam/subnets?companyId={companyId}") ?? new();
            if (selectFirst || subnets.All(s => s.Id != selectedId))
            {
                var first = subnets.FirstOrDefault();
                if (first != null) await SelectSubnet(first.Id);
                else { selectedId = 0; map = null; }
            }
        }
        catch (Exception ex) { subnets = new(); Toast.Error(ex.Message); }
        finally { loadingSubnets = false; }
    }

    private async Task SelectSubnet(int id)
    {
        if (selectedId != id) { filter = "all"; search = ""; selCell = null; }
        selectedId = id;
        StopPolling();
        await LoadMap();
        if (ScanRunning) StartPolling();
    }

    private async Task ReloadMap()
    {
        await LoadMap();
        await RefreshSubnetRow();
    }

    private async Task LoadMap()
    {
        if (selectedId == 0) return;
        loadingMap = map is null || map.Subnet.Id != selectedId;
        try
        {
            map = await Api.GetAsync<MapResult>($"api/ipam/subnets/{selectedId}/map");
            scan = map?.Scan;
            BuildCells();
            if (selCell != null) selCell = cells.FirstOrDefault(c => c.Num == selCell.Num);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loadingMap = false; }
    }

    private async Task RefreshSubnetRow()
    {
        try { subnets = await Api.GetAsync<List<SubnetRow>>($"api/ipam/subnets?companyId={companyId}") ?? subnets; }
        catch { /* بی‌اهمیت */ }
    }

    // ------------------------------------------------------------ ساخت خانه‌ها
    private void BuildCells()
    {
        cells = new();
        blocks = new();
        if (map is null) return;
        var s = map.Subnet;
        var size = 1L << (32 - s.Prefix);
        var network = s.NetworkNum;
        var broadcast = network + size - 1;
        var gw = TryParseIp(s.Gateway, out var g) ? g : -1;
        (dhcpFrom, dhcpTo) = ParseRange(s.DhcpRange);
        var hosts = map.Hosts.ToDictionary(h => h.Num);

        Block? block = null;
        for (var n = network; n <= broadcast; n++)
        {
            var blockKey = n >> 8;
            if (block is null || (block.Cells.Count > 0 && block.Cells[0].Num >> 8 != blockKey))
            {
                block = new Block { Title = $"{ToIp(blockKey << 8)[..^2]}.x" };
                blocks.Add(block);
            }
            var cell = new Cell
            {
                Num = n, Ip = ToIp(n), LastOctet = (int)(n & 255),
                Kind = n == network ? "network" : n == broadcast ? "broadcast" : "host",
                IsGateway = n == gw,
                InDhcp = dhcpFrom > 0 && n >= dhcpFrom && n <= dhcpTo,
                Host = hosts.TryGetValue(n, out var h) ? h : null
            };
            cells.Add(cell);
            block.Cells.Add(cell);
        }
        problemCount = map.Hosts.Count(h => h.Conflict || !string.IsNullOrEmpty(h.MacMismatch));
    }

    private static (long, long) ParseRange(string? r)
    {
        if (string.IsNullOrWhiteSpace(r)) return (0, 0);
        var parts = r.Split('-', StringSplitOptions.TrimEntries);
        if (parts.Length != 2 || !TryParseIp(parts[0], out var a)) return (0, 0);
        if (!TryParseIp(parts[1], out var b))
        {
            // «192.168.30.100-200»
            if (int.TryParse(parts[1], out var last) && last is >= 0 and <= 255) b = (a & ~255L) | (uint)last;
            else return (0, 0);
        }
        return a <= b ? (a, b) : (b, a);
    }

    private static bool TryParseIp(string? text, out long num)
    {
        num = 0;
        if (string.IsNullOrWhiteSpace(text)) return false;
        var p = text.Trim().Split('.');
        if (p.Length != 4) return false;
        foreach (var part in p)
        {
            if (!int.TryParse(part, out var v) || v < 0 || v > 255) return false;
            num = (num << 8) | (uint)v;
        }
        return true;
    }

    private static string ToIp(long n) => $"{(n >> 24) & 255}.{(n >> 16) & 255}.{(n >> 8) & 255}.{n & 255}";

    // ------------------------------------------------------------ نمایش خانه‌ها
    private bool Matches(Cell c)
    {
        var state = c.Host?.State ?? "free";
        var okFilter = filter switch
        {
            "free" => c.Kind == "host" && state == "free",
            "registered" => state == "registered",
            "unregistered" => state == "unregistered",
            "problem" => c.Host is { } h && (h.Conflict || !string.IsNullOrEmpty(h.MacMismatch)),
            _ => true
        };
        if (!okFilter) return false;
        if (string.IsNullOrWhiteSpace(search)) return true;
        var q = search.Trim();
        bool Has(string? s) => !string.IsNullOrEmpty(s) && s.Contains(q, StringComparison.OrdinalIgnoreCase);
        var host = c.Host;
        return Has(c.Ip) || Has(host?.Hostname) || Has(host?.Mac)
               || (host?.Owners.Any(o => Has(o.Title) || Has(o.Detail)) ?? false)
               || Has(host?.Reserved?.Title) || Has(host?.Reserved?.Owner) || Has(host?.Reserved?.Note);
    }

    private string CellClass(Cell c)
    {
        var cls = "ipcell";
        if (c.Kind != "host") cls += " edge";
        else if (c.Host?.State == "registered") cls += c.Host.Alive || map?.Subnet.LastScanAt is null ? " reg" : " reg off";
        else if (c.Host?.State == "unregistered") cls += " unreg";
        if (c.IsGateway) cls += " gw";
        if (c.InDhcp) cls += " dhcp";
        if ((filter != "all" || !string.IsNullOrWhiteSpace(search)) && !Matches(c)) cls += " dim";
        if (selCell?.Num == c.Num) cls += " sel";
        return cls;
    }

    private string CellTip(Cell c)
    {
        if (c.Kind == "network") return $"{c.Ip} — آدرس شبکه (قابل استفاده نیست)";
        if (c.Kind == "broadcast") return $"{c.Ip} — آدرس برادکست (قابل استفاده نیست)";
        var lines = new List<string> { c.Ip + (c.IsGateway ? " (گیت‌وی)" : "") };
        var h = c.Host;
        lines.Add(h?.State switch
        {
            "registered" => h.Alive ? "✅ ثبت در شناسنامه — روشن" : "✅ ثبت در شناسنامه" + (map?.Subnet.LastScanAt is null ? "" : " — در آخرین اسکن خاموش"),
            "unregistered" => "⚠️ اشغال در شبکه — بدون شناسنامه",
            _ => "⬜ خالی"
        });
        if (h != null)
        {
            foreach (var o in h.Owners) lines.Add($"• {o.SourceTitle}: {o.Title}");
            if (!string.IsNullOrEmpty(h.Hostname)) lines.Add("نام: " + h.Hostname);
            if (!string.IsNullOrEmpty(h.Mac)) lines.Add("MAC: " + h.Mac);
            if (h.State == "free" && h.LastSeenAt is { } ls) lines.Add("آخرین بار دیده‌شده: " + Ago(ls));
            if (h.Conflict) lines.Add("⛔ تداخل: در چند شناسنامه ثبت شده");
            if (!string.IsNullOrEmpty(h.MacMismatch)) lines.Add("⛔ " + h.MacMismatch);
        }
        if (c.InDhcp) lines.Add("داخل محدودهٔ DHCP");
        return string.Join("\n", lines);
    }

    private string HeadClass(Cell c) => c.Host?.State switch
    {
        "registered" => c.Host.Alive || map?.Subnet.LastScanAt is null ? "reg" : "reg off",
        "unregistered" => "unreg",
        _ => ""
    };

