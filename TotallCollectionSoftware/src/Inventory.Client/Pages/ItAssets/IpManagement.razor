        }
        else if (h?.State == "unregistered")
        {
            <span><i class="bi bi-exclamation-triangle-fill"></i> اشغال — بدون شناسنامه</span>
        }
        else
        {
            <span><i class="bi bi-square"></i> خالی</span>
        }
    };

    private RenderFragment StateBadge(HostInfo h) => __builder =>
    {
        if (h.State == "registered")
        {
            if (h.Alive) { <span class="badge bg-success">ثبت‌شده · روشن</span> }
            else { <span class="badge bg-success-subtle text-success-emphasis">ثبت‌شده · خاموش</span> }
        }
        else if (h.State == "unregistered")
        {
            <span class="badge bg-warning text-dark">اشغال بدون شناسنامه</span>
        }
        else
        {
            <span class="badge bg-light text-dark border">خالی</span>
        }
    };

    private string? FirstFree => cells.FirstOrDefault(c => c.Kind == "host" && !c.IsGateway && (c.Host is null || c.Host.State == "free") && !c.InDhcp)?.Ip
                                 ?? cells.FirstOrDefault(c => c.Kind == "host" && !c.IsGateway && (c.Host is null || c.Host.State == "free"))?.Ip;

    /// <summary>عرض CSS — همیشه با نقطهٔ انگلیسی (فرهنگ فارسی «٫» تولید می‌کند و CSS را خراب می‌کند).</summary>
    private static string W(double v) => v.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture);

    private static double Pct(int part, int total) => total <= 0 ? 0 : Math.Round(part * 100.0 / total, 1);

    private static string Ago(DateTime t)
    {
        var d = DateTime.Now - t;
        if (d.TotalSeconds < 0) d = TimeSpan.Zero;
        if (d.TotalMinutes < 1) return "همین الان";
        if (d.TotalMinutes < 60) return $"{((int)d.TotalMinutes).Num()} دقیقه پیش";
        if (d.TotalHours < 24) return $"{((int)d.TotalHours).Num()} ساعت پیش";
        if (d.TotalDays < 30) return $"{((int)d.TotalDays).Num()} روز پیش";
        return t.ToFaDateTime();
    }

    private static List<OwnerInfo> RegistryOwners(HostInfo? h) =>
        h?.Owners.Where(o => o.Source != "Reserved").ToList() ?? new List<OwnerInfo>();

    private static string MethodFa(string? m) => m switch
    {
        "ping" => "پینگ", "tcp" => "پورت باز", "arp" => "ARP — پینگ بسته است", _ => "—"
    };

    private static string SourceIcon(string s) => s switch
    {
        "System" => "bi-pc-display", "OfficeMachine" => "bi-printer-fill", "Camera" => "bi-camera-video-fill",
        "Nvr" => "bi-hdd-stack-fill", "Vault" => "bi-hdd-network-fill", _ => "bi-bookmark-fill"
    };

    private string CidrHint
    {
        get
        {
            var t = (sf.Cidr ?? "").Trim();
            var slash = t.IndexOf('/');
            if (slash < 0 || !TryParseIp(t[..slash], out var ip) || !int.TryParse(t[(slash + 1)..], out var p)) return "مثال: 192.168.30.0/24 (۲۵۴ آدرس)";
            if (p < 22 || p > 30) return "طول پیشوند باید بین /22 تا /30 باشد.";
            var mask = (0xFFFFFFFFL << (32 - p)) & 0xFFFFFFFFL;
            var net = ip & mask;
            var size = 1L << (32 - p);
            return $"{ToIp(net + 1)} تا {ToIp(net + size - 2)} — {(size - 2).ToString("N0")} آدرس قابل استفاده";
        }
    }

    // ------------------------------------------------------------ کشوی جزئیات
    private void OpenCell(Cell c)
    {
        if (c.Kind != "host") return;
        selCell = c;
        editingReserve = false;
    }

    private void OpenCellByIp(string ip)
    {
        var c = cells.FirstOrDefault(x => x.Ip == ip);
        if (c is null) return;
        OpenCell(c);
        StartEditReserve();
    }

    private void CloseCell() { selCell = null; editingReserve = false; }

    private void StartEditReserve()
    {
        var r = selCell?.Host?.Reserved;
        rf = new ReserveForm
        {
            Title = r?.Title ?? selCell?.Host?.Hostname,
            Type = r?.Type ?? "",
            Owner = r?.Owner,
            Note = r?.Note
        };
        editingReserve = true;
    }

    private async Task SaveReserve()
    {
        if (selCell is null || map is null) return;
        if (string.IsNullOrWhiteSpace(rf.Title)) { Toast.Error("عنوان دستگاه/کاربرد را وارد کنید."); return; }
        busy = true;
        try
        {
            await Api.PutAsync<object>($"api/ipam/subnets/{map.Subnet.Id}/reserve", new
            {
                ip = selCell.Ip, title = rf.Title, type = string.IsNullOrEmpty(rf.Type) ? null : rf.Type, owner = rf.Owner, note = rf.Note
            });
            Toast.Success($"آی‌پی {selCell.Ip} ثبت شد.");
            editingReserve = false;
            await ReloadMap();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task Unreserve()
    {
        if (selCell is null || map is null) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"رزرو آی‌پی {selCell.Ip} آزاد شود؟")) return;
        try
        {
            await Api.DeleteAsync($"api/ipam/subnets/{map.Subnet.Id}/reserve?ip={Uri.EscapeDataString(selCell.Ip)}");
            Toast.Success("رزرو آزاد شد.");
            await ReloadMap();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ProbeSelected()
    {
        if (selCell is null || map is null) return;
        probing = true;
        try
        {
            var r = await Api.PostAsync<ProbeResult>($"api/ipam/subnets/{map.Subnet.Id}/probe", new { ip = selCell.Ip });
            if (r?.Alive == true) Toast.Success($"{selCell.Ip} روشن است ({MethodFa(r.Method)}).");
            else Toast.Info($"{selCell.Ip} جواب نداد.");
            await ReloadMap();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { probing = false; }
    }

    private void Go(string link)
    {
        CloseCell();
        Nav.NavigateTo(link);
    }

    private async Task Copy(string text)
    {
        try
        {
            if (await JS.InvokeAsync<bool>("invCopyText", text)) Toast.Success($"{text} کپی شد.");
        }
        catch { Toast.Error("کپی ممکن نشد."); }
    }

    // ------------------------------------------------------------ اسکن
    private async Task StartScan()
    {
        if (map is null) return;
        try
        {
            var r = await Api.PostAsync<StartScanResult>($"api/ipam/subnets/{map.Subnet.Id}/scan", null);
            scan = r?.Scan ?? new ScanInfo { Running = true, Phase = "شروع" };
            if (r is { Started: false }) Toast.Info("این رنج همین الان در حال اسکن است.");
            StartPolling();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void StartPolling()
    {
        StopPolling();
        var cts = pollCts = new CancellationTokenSource();
        var subnetId = selectedId;
        _ = Task.Run(async () =>
        {
            try
            {
                while (!cts.IsCancellationRequested)
                {
                    await Task.Delay(1200, cts.Token);
                    var s = await Api.GetAsync<ScanInfo>($"api/ipam/subnets/{subnetId}/scan");
                    if (cts.IsCancellationRequested || disposed || subnetId != selectedId) return;
                    scan = s;
                    if (s is null || !s.Running)
                    {
                        await InvokeAsync(async () =>
                        {
                            await ReloadMap();
                            if (string.IsNullOrEmpty(s?.Error)) Toast.Success("اسکن رنج تمام شد.");
                            StateHasChanged();
                        });
                        return;
                    }
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            catch (Exception ex) { if (!disposed) await InvokeAsync(() => Toast.Error(ex.Message)); }
        });
    }

    private void StopPolling()
    {
        pollCts?.Cancel();
        pollCts = null;
    }

    // ------------------------------------------------------------ رنج‌ها
    private void OpenCreateSubnet()
    {
        editSubnetId = 0;
        sf = new SubnetForm { AutoScanMinutes = 0 };
        showSubnetModal = true;
    }

    private void OpenEditSubnet()
    {
        if (map is null) return;
        var s = map.Subnet;
        editSubnetId = s.Id;
        sf = new SubnetForm
        {
            Name = s.Name, Cidr = s.Cidr, Gateway = s.Gateway, Vlan = s.Vlan, DnsServers = s.DnsServers,
            DhcpRange = s.DhcpRange, Location = s.Location, Description = s.Description, AutoScanMinutes = s.AutoScanMinutes
        };
        showSubnetModal = true;
    }

    private async Task SaveSubnet()
    {
        if (string.IsNullOrWhiteSpace(sf.Name)) { Toast.Error("نام رنج را وارد کنید."); return; }
        if (string.IsNullOrWhiteSpace(sf.Cidr)) { Toast.Error("رنج را وارد کنید (مثلاً 192.168.30.0/24)."); return; }
        busy = true;
        try
        {
            var body = new
            {
                companyId, name = sf.Name, cidr = sf.Cidr, gateway = sf.Gateway, vlan = sf.Vlan, dnsServers = sf.DnsServers,
                dhcpRange = sf.DhcpRange, location = sf.Location, description = sf.Description, autoScanMinutes = sf.AutoScanMinutes
            };
            if (editSubnetId > 0)
            {
                await Api.PutAsync<object>($"api/ipam/subnets/{editSubnetId}", body);
                Toast.Success("رنج ویرایش شد.");
                showSubnetModal = false;
                await LoadSubnets();
                await LoadMap();
            }
            else
            {
                var r = await Api.PostAsync<IdResult>("api/ipam/subnets", body);
                Toast.Success("رنج اضافه شد." + (canScan ? " برای مشخص شدن آی‌پی‌های اشغال، «اسکن رنج» را بزنید." : ""));
                showSubnetModal = false;
                await LoadSubnets();
                if (r?.Id > 0) await SelectSubnet(r.Id);
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    private async Task DeleteSubnet()
    {
        if (map is null) return;
        var s = map.Subnet;
        if (!await JS.InvokeAsync<bool>("confirm", $"رنج «{s.Name}» ({s.Cidr}) و همهٔ رزروها و سوابق اسکن آن حذف شود؟")) return;
        try
        {
            await Api.DeleteAsync($"api/ipam/subnets/{s.Id}");
            Toast.Success("رنج حذف شد.");
            StopPolling();
            map = null;
            selCell = null;
            await LoadSubnets(selectFirst: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    public void Dispose()
    {
        disposed = true;
        StopPolling();
    }
}
