@page "/ip-management"
@inject IApiClient Api
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS
@inject NavigationManager Nav
@implements IDisposable

<PageTitle>مدیریت آی‌پی</PageTitle>

@* =====================================================================
   مدیریت آی‌پی (IPAM) — نمای شبکه‌ای هر رنج به تفکیک شرکت
     سفید  = خالی
     سبز   = ثبت‌شده در شناسنامه‌ها (سیستم، ماشین اداری، دوربین، NVR، گاوصندوق، رزرو دستی)
     زرد   = در شبکه اشغال است (جواب پینگ/پورت/ARP) ولی در هیچ شناسنامه‌ای ثبت نشده
   ===================================================================== *@

<div class="card shadow-sm mb-4 ipam-card">
    <div class="card-header fw-700 d-flex justify-content-between align-items-center flex-wrap gap-2 ipam-head">
        <span><i class="bi bi-diagram-2-fill me-2"></i>مدیریت آی‌پی
            <span class="badge bg-light text-dark ms-1">@subnets.Count.Num() رنج</span>
        </span>
        <div class="d-flex align-items-center gap-2 flex-wrap">
            @if (companies.Count > 1)
            {
                <select class="form-select form-select-sm ipam-company" value="@companyId" @onchange="OnCompanyChanged">
                    @foreach (var c in companies)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            }
            @if (canCreate && companyId > 0)
            {
                <button class="btn btn-light btn-sm fw-700 shadow-sm" style="color:#0f3d56" @onclick="OpenCreateSubnet"><i class="bi bi-plus-lg"></i> رنج جدید</button>
            }
        </div>
    </div>

    <div class="card-body">
        @if (!canView)
        {
            <div class="alert alert-warning mb-0">شما مجوز مشاهدهٔ مدیریت آی‌پی را ندارید.</div>
        }
        else if (companies.Count == 0 && !loadingCompanies)
        {
            <div class="alert alert-info mb-0">
                هیچ شرکتی برای شما تعریف نشده است. ابتدا شرکت تعریف کنید و در «کاربران» دسترسی شرکت را به کاربر بدهید.
            </div>
        }
        else if (loadingSubnets && subnets.Count == 0)
        {
            <div class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری…</div>
        }
        else if (subnets.Count == 0)
        {
            <div class="ipam-empty">
                <i class="bi bi-diagram-2"></i>
                <div class="fw-700 mt-2">هنوز رنجی برای @CompanyName تعریف نشده است.</div>
                <div class="text-muted small mt-1">مثلاً رنج <code dir="ltr">192.168.30.0/24</code> را اضافه کنید تا نقشهٔ آی‌پی‌ها ساخته شود.</div>
                @if (canCreate)
                {
                    <button class="btn btn-primary btn-sm mt-3" @onclick="OpenCreateSubnet"><i class="bi bi-plus-lg"></i> افزودن اولین رنج</button>
                }
            </div>
        }
        else
        {
            @* ---------------- کارت رنج‌ها ---------------- *@
            <div class="ipam-subnets">
                @foreach (var s in subnets)
                {
                    var sid = s.Id;
                    var pReg = Pct(s.Registered, s.Total);
                    var pUnreg = Pct(s.Unregistered, s.Total);
                    <button class="ipam-subnet @(selectedId == sid ? "active" : "")" @onclick="() => SelectSubnet(sid)">
                        <div class="d-flex justify-content-between align-items-start gap-2">
                            <div class="text-start">
                                <div class="fw-700 text-truncate" style="max-width:190px">@s.Name</div>
                                <div class="small" dir="ltr"><code>@s.Cidr</code></div>
                            </div>
                            <div class="d-flex flex-column align-items-end gap-1">
                                @if (s.Vlan.HasValue) { <span class="badge bg-secondary-subtle text-secondary-emphasis">VLAN @s.Vlan</span> }
                                @if (s.Scanning) { <span class="badge bg-info-subtle text-info-emphasis"><span class="spinner-grow spinner-grow-sm" style="width:.5rem;height:.5rem"></span> اسکن</span> }
                            </div>
                        </div>
                        <div class="ipam-minibar mt-2" title="ثبت‌شده: @s.Registered — اشغال بدون شناسنامه: @s.Unregistered — خالی: @s.Free">
                            <span class="seg reg" style="width:@W(pReg)%"></span>
                            <span class="seg unreg" style="width:@W(pUnreg)%"></span>
                        </div>
                        <div class="d-flex justify-content-between small mt-1 text-muted">
                            <span><span class="dot reg"></span>@s.Registered.Num() <span class="dot unreg ms-2"></span>@s.Unregistered.Num()</span>
                            <span>خالی @s.Free.Num() از @s.Total.Num()</span>
                        </div>
                    </button>
                }
            </div>

            @if (map is not null)
            {
                var sn = map.Subnet;
                <div class="ipam-panel mt-3">
                    @* ---------------- سربرگ رنج ---------------- *@
                    <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                        <div>
                            <div class="fs-5 fw-700">@sn.Name <code class="ms-1 fs-6" dir="ltr">@sn.Cidr</code></div>
                            <div class="small text-muted d-flex flex-wrap gap-3 mt-1">
                                <span>ماسک: <span dir="ltr">@sn.Mask</span></span>
                                @if (!string.IsNullOrWhiteSpace(sn.Gateway)) { <span>گیت‌وی: <span dir="ltr">@sn.Gateway</span></span> }
                                @if (sn.Vlan.HasValue) { <span>VLAN: @sn.Vlan</span> }
                                @if (!string.IsNullOrWhiteSpace(sn.DnsServers)) { <span>DNS: <span dir="ltr">@sn.DnsServers</span></span> }
                                @if (!string.IsNullOrWhiteSpace(sn.DhcpRange)) { <span>DHCP: <span dir="ltr">@sn.DhcpRange</span></span> }
                                @if (!string.IsNullOrWhiteSpace(sn.Location)) { <span><i class="bi bi-geo-alt"></i> @sn.Location</span> }
                            </div>
                            <div class="small mt-1 @(sn.LastScanAt is null ? "text-danger" : "text-muted")">
                                <i class="bi bi-clock-history"></i>
                                @if (sn.LastScanAt is null)
                                {
                                    <span>هنوز اسکن نشده — رنگ زرد (اشغال بدون شناسنامه) فقط بعد از اسکن مشخص می‌شود.</span>
                                }
                                else
                                {
                                    <span>آخرین اسکن: @Ago(sn.LastScanAt.Value) (@sn.LastScanAliveCount.Num() دستگاه روشن، @((sn.LastScanDurationMs / 1000.0).ToString("0.#")) ثانیه)</span>
                                }
                                @if (sn.AutoScanMinutes > 0) { <span class="ms-2 badge bg-success-subtle text-success-emphasis">اسکن خودکار هر @sn.AutoScanMinutes.Num() دقیقه</span> }
                            </div>
                        </div>
                        <div class="d-flex gap-2 flex-wrap">
                            @if (canScan)
                            {
                                <button class="btn btn-primary btn-sm fw-700" disabled="@ScanRunning" @onclick="StartScan">
                                    @if (ScanRunning) { <span class="spinner-border spinner-border-sm"></span> <span>در حال اسکن…</span> }
                                    else { <i class="bi bi-radar"></i> <span>اسکن رنج</span> }
                                </button>
                            }
                            <button class="btn btn-outline-secondary btn-sm" @onclick="ReloadMap" title="بازخوانی"><i class="bi bi-arrow-clockwise"></i></button>
                            @if (canUpdate) { <button class="btn btn-outline-secondary btn-sm" @onclick="OpenEditSubnet" title="ویرایش رنج"><i class="bi bi-pencil"></i></button> }
                            @if (canDelete) { <button class="btn btn-outline-danger btn-sm" @onclick="DeleteSubnet" title="حذف رنج"><i class="bi bi-trash"></i></button> }
                        </div>
                    </div>

                    @if (scan is { Running: true })
                    {
                        <div class="ipam-scanbar mt-3">
                            <div class="d-flex justify-content-between small mb-1">
                                <span><i class="bi bi-broadcast"></i> @scan.Phase — @scan.Scanned.Num() از @scan.Total.Num()</span>
                                <span>@scan.Found.Num() دستگاه پیدا شد</span>
                            </div>
                            <div class="progress" style="height:8px"><div class="progress-bar progress-bar-striped progress-bar-animated" style="width:@(scan.Progress)%"></div></div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(scan?.Error))
                    {
                        <div class="alert alert-danger py-2 small mt-3 mb-0">اسکن ناموفق بود: @scan!.Error</div>
                    }

                    @* ---------------- راهنما/آمار (قابل کلیک برای فیلتر) ---------------- *@
                    <div class="ipam-legend mt-3">
                        <button class="lg @(filter == "all" ? "on" : "")" @onclick='() => filter = "all"'>
                            <span class="sw all"></span> همه <b>@map.Stats.Total.Num()</b>
                        </button>
                        <button class="lg @(filter == "free" ? "on" : "")" @onclick='() => filter = "free"'>
                            <span class="sw free"></span> خالی <b>@map.Stats.Free.Num()</b>
                        </button>
                        <button class="lg @(filter == "registered" ? "on" : "")" @onclick='() => filter = "registered"'>
                            <span class="sw reg"></span> ثبت در شناسنامه <b>@map.Stats.Registered.Num()</b>
                            <small class="text-muted">(@map.Stats.RegisteredOnline.Num() روشن)</small>
                        </button>
                        <button class="lg @(filter == "unregistered" ? "on" : "")" @onclick='() => filter = "unregistered"'>
                            <span class="sw unreg"></span> اشغال بدون شناسنامه <b>@map.Stats.Unregistered.Num()</b>
                        </button>
                        @if (problemCount > 0)
                        {
                            <button class="lg @(filter == "problem" ? "on" : "")" @onclick='() => filter = "problem"'>
                                <span class="sw problem"></span> تداخل/هشدار <b>@problemCount.Num()</b>
                            </button>
                        }
                    </div>
                    <div class="ipam-bigbar mt-2">
                        <span class="seg reg" style="width:@W(Pct(map.Stats.Registered, map.Stats.Total))%"></span>
                        <span class="seg unreg" style="width:@W(Pct(map.Stats.Unregistered, map.Stats.Total))%"></span>
                    </div>
                    <div class="small text-muted mt-1">
                        استفاده‌شده: @Pct(map.Stats.Registered + map.Stats.Unregistered, map.Stats.Total).ToString("0.#")٪
                        <span class="ms-3"><span class="mini-sw reg-off"></span> سبز کم‌رنگ = ثبت‌شده ولی در آخرین اسکن خاموش</span>
                        <span class="ms-3"><span class="mini-sw gw"></span> گیت‌وی</span>
                        @if (dhcpFrom > 0) { <span class="ms-3"><span class="mini-sw dhcp"></span> محدودهٔ DHCP</span> }
                    </div>

                    @* ---------------- ابزارها ---------------- *@
                    <div class="d-flex flex-wrap gap-2 align-items-center mt-3">
                        <div class="input-group input-group-sm" style="max-width:340px">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input class="form-control" placeholder="جست‌وجو: آی‌پی، نام دستگاه، MAC، صاحب…" @bind="search" @bind:event="oninput" />
                        </div>
                        <div class="btn-group btn-group-sm">
                            <button class="btn @(view == "grid" ? "btn-dark" : "btn-outline-dark")" @onclick='() => view = "grid"'><i class="bi bi-grid-3x3-gap-fill"></i> نمای شبکه‌ای</button>
                            <button class="btn @(view == "list" ? "btn-dark" : "btn-outline-dark")" @onclick='() => view = "list"'><i class="bi bi-list-ul"></i> فهرست</button>
                        </div>
                        @if (FirstFree is { } ff)
                        {
                            <div class="ms-auto ipam-firstfree">
                                اولین آی‌پی خالی: <code dir="ltr">@ff</code>
                                <button class="btn btn-link btn-sm p-0 ms-1" title="کپی" @onclick="() => Copy(ff)"><i class="bi bi-copy"></i></button>
                                @if (canUpdate)
                                {
                                    <button class="btn btn-link btn-sm p-0 ms-2" title="رزرو این آی‌پی" @onclick="() => OpenCellByIp(ff)"><i class="bi bi-bookmark-plus"></i> رزرو</button>
                                }
                            </div>
                        }
                        else
                        {
                            <span class="ms-auto badge bg-danger-subtle text-danger-emphasis">آی‌پی خالی در این رنج نمانده</span>
                        }
                    </div>

                    @* ---------------- نمای شبکه‌ای ---------------- *@
                    @if (view == "grid")
                    {
                        @foreach (var block in blocks)
                        {
                            <div class="ipam-block mt-3">
                                @if (blocks.Count > 1) { <div class="ipam-block-title" dir="ltr">@block.Title</div> }
                                <div class="ipam-grid">
                                    @foreach (var c in block.Cells)
                                    {
                                        var cell = c;
                                        <button class="@CellClass(cell)" title="@CellTip(cell)" disabled="@cell.IsEdge" @onclick="() => OpenCell(cell)">
                                            <span class="oct">@cell.LastOctet</span>
                                            @if (cell.IsGateway) { <span class="tag">GW</span> }
                                            @if (cell.Host is { Conflict: true } || !string.IsNullOrEmpty(cell.Host?.MacMismatch)) { <span class="warn"></span> }
                                            @if (cell.Host is { State: "free", LastSeenAt: not null }) { <span class="seen"></span> }
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        @* ---------------- نمای فهرست ---------------- *@
                        var listRows = cells.Where(c => c.Kind == "host" && c.Host is { } h && h.State != "free" && Matches(c)).ToList();
                        <div class="table-responsive mt-3">
                            <table class="table table-sm table-hover align-middle ipam-table">
                                <thead class="table-light">
                                    <tr><th>آی‌پی</th><th>وضعیت</th><th>ثبت در شناسنامه</th><th>نام شبکه / MAC</th><th>آخرین مشاهده</th><th></th></tr>
                                </thead>
                                <tbody>
                                    @if (listRows.Count == 0)
                                    {
                                        <tr><td colspan="6" class="text-center text-muted py-4">موردی پیدا نشد.</td></tr>
                                    }
                                    @foreach (var c in listRows)
                                    {
                                        var cell = c;
                                        var h = cell.Host!;
                                        <tr style="cursor:pointer" @onclick="() => OpenCell(cell)">
                                            <td dir="ltr" class="text-start"><code>@cell.Ip</code> @if (cell.IsGateway) { <span class="badge bg-primary-subtle text-primary-emphasis">GW</span> }</td>
                                            <td>@StateBadge(h)</td>
                                            <td>
                                                @if (h.Owners.Count == 0) { <span class="text-muted">—</span> }
                                                @foreach (var o in h.Owners)
                                                {
                                                    <div class="small"><span class="text-muted">@o.SourceTitle:</span> @o.Title</div>
                                                }
                                                @if (h.Conflict) { <span class="badge bg-danger">تداخل</span> }
                                            </td>
                                            <td class="small" dir="ltr">@h.Hostname<div class="text-muted">@h.Mac</div></td>
                                            <td class="small">@(h.LastSeenAt is { } ls ? Ago(ls) : "—")</td>
                                            <td><i class="bi bi-chevron-left text-muted"></i></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            }
            else if (loadingMap)
            {
                <div class="text-center text-muted py-5"><span class="spinner-border spinner-border-sm"></span> در حال ساخت نقشه…</div>
            }
        }
    </div>
</div>

@* ======================= کشوی جزئیات آی‌پی ======================= *@
@if (selCell is not null && map is not null)
{
    var h = selCell.Host;
    <div class="ipam-backdrop" @onclick="CloseCell"></div>
    <aside class="ipam-drawer">
        <div class="ipam-drawer-head @HeadClass(selCell)">
            <div>
                <div class="small opacity-75">@map.Subnet.Name</div>
                <div class="fs-4 fw-700" dir="ltr">@selCell.Ip</div>
                <div class="mt-1">@StateText(selCell)</div>
            </div>
            <div class="d-flex flex-column gap-1 align-items-end">
                <button class="btn btn-sm btn-light" @onclick="CloseCell"><i class="bi bi-x-lg"></i></button>
                <button class="btn btn-sm btn-light" title="کپی آی‌پی" @onclick="() => Copy(selCell.Ip)"><i class="bi bi-copy"></i></button>
            </div>
        </div>
        <div class="ipam-drawer-body">
            @if (h?.Conflict == true)
            {
                <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-octagon-fill"></i> این آی‌پی در چند شناسنامهٔ مختلف ثبت شده است — تداخل آی‌پی.</div>
            }
            @if (!string.IsNullOrEmpty(h?.MacMismatch))
            {
                <div class="alert alert-danger py-2 small"><i class="bi bi-exclamation-triangle-fill"></i> @h!.MacMismatch</div>
            }
            @if (!string.IsNullOrEmpty(h?.MacHint))
            {
                <div class="alert alert-info py-2 small"><i class="bi bi-lightbulb-fill"></i> @h!.MacHint</div>
            }

            @* ---- شبکه ---- *@
            <div class="ipam-sec-title">وضعیت در شبکه</div>
            <div class="ipam-kv">
                <span>وضعیت</span>
                <span>
                    @if (h?.Alive == true) { <span class="text-success fw-700"><i class="bi bi-circle-fill" style="font-size:.6rem"></i> روشن (@MethodFa(h.Method))</span> }
                    else if (map.Subnet.LastScanAt is null && h?.LastCheckedAt is null) { <span class="text-muted">هنوز بررسی نشده</span> }
                    else { <span class="text-muted"><i class="bi bi-circle" style="font-size:.6rem"></i> جواب نداد</span> }
                </span>
                <span>نام شبکه</span><span dir="ltr" class="text-start">@(h?.Hostname ?? "—")</span>
                <span>MAC</span><span dir="ltr" class="text-start">@(h?.Mac ?? "—")</span>
                <span>آخرین مشاهده</span><span>@(h?.LastSeenAt is { } ls ? $"{Ago(ls)} ({ls.ToFaDateTime()})" : "—")</span>
                <span>اولین مشاهده</span><span>@(h?.FirstSeenAt is { } fs ? fs.ToFaDateTime() : "—")</span>
            </div>
            @if (canScan)
            {
                <button class="btn btn-outline-primary btn-sm mt-2" disabled="@probing" @onclick="ProbeSelected">
                    @if (probing) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-activity"></i> }
                    بررسی همین الان
                </button>
            }

            @* ---- شناسنامه‌ها ---- *@
            <div class="ipam-sec-title mt-4">ثبت در شناسنامه‌ها</div>
            @{ var owners = RegistryOwners(h); }
            @if (owners.Count == 0)
            {
                <div class="text-muted small">در هیچ شناسنامه‌ای (سیستم، ماشین اداری، دوربین، NVR، گاوصندوق) ثبت نشده است.</div>
            }
            @foreach (var o in owners)
            {
                var link = o.Link;
                <div class="ipam-owner">
                    <i class="bi @SourceIcon(o.Source)"></i>
                    <div class="flex-grow-1">
                        <div class="fw-700">@o.Title</div>
                        <div class="small text-muted">@o.SourceTitle@(string.IsNullOrWhiteSpace(o.Detail) ? "" : " — " + o.Detail)</div>
                        @if (!string.IsNullOrEmpty(o.Mac)) { <div class="small text-muted" dir="ltr">@o.Mac</div> }
                    </div>
                    @if (!string.IsNullOrEmpty(link))
                    {
                        <button class="btn btn-sm btn-outline-secondary" title="باز کردن شناسنامه" @onclick="() => Go(link)"><i class="bi bi-box-arrow-up-left"></i></button>
                    }
                </div>
            }

            @* ---- رزرو دستی ---- *@
            <div class="ipam-sec-title mt-4">رزرو / ثبت در مدیریت آی‌پی</div>
            @if (h?.Reserved is { } rv && !editingReserve)
            {
                <div class="ipam-owner reserved">
                    <i class="bi bi-bookmark-check-fill"></i>
                    <div class="flex-grow-1">
                        <div class="fw-700">@rv.Title</div>
                        <div class="small text-muted">@TypeFa(rv.Type)@(string.IsNullOrWhiteSpace(rv.Owner) ? "" : " — " + rv.Owner)</div>
                        @if (!string.IsNullOrWhiteSpace(rv.Note)) { <div class="small mt-1">@rv.Note</div> }
                        <div class="small text-muted mt-1">@rv.UpdatedByName @(rv.UpdatedAt is { } ua ? "— " + ua.ToFaDateTime() : "")</div>
                    </div>
                </div>
                @if (canUpdate)
                {
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-outline-primary" @onclick="StartEditReserve"><i class="bi bi-pencil"></i> ویرایش</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="Unreserve"><i class="bi bi-bookmark-x"></i> آزاد کردن</button>
                    </div>
                }
            }
            else if (canUpdate)
            {
                @if (h?.Reserved is null && !editingReserve)
                {
                    <div class="small text-muted mb-2">
                        @if (h?.State == "unregistered") { <span>این آی‌پی در شبکه اشغال است ولی صاحب آن مشخص نیست. با ثبت آن، رنگش سبز می‌شود.</span> }
                        else { <span>برای رزرو این آی‌پی (مثلاً برای سرور یا سوییچ جدید) آن را ثبت کنید.</span> }
                    </div>
                    <button class="btn btn-sm btn-success" @onclick="StartEditReserve"><i class="bi bi-bookmark-plus"></i> ثبت / رزرو این آی‌پی</button>
                }
                else
                {
                    <div class="row g-2">
                        <div class="col-12">
                            <label class="form-label small mb-1">عنوان دستگاه / کاربرد <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" maxlength="200" @bind="rf.Title" placeholder="مثلاً: سوییچ طبقه ۲ / پرینتر حسابداری" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">نوع دستگاه</label>
                            <select class="form-select form-select-sm" @bind="rf.Type">
                                <option value="">—</option>
                                @foreach (var t in ReservedTypes)
                                {
                                    <option value="@t.Key">@t.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small mb-1">مسئول / کاربر</label>
                            <input class="form-control form-control-sm" maxlength="200" @bind="rf.Owner" />
                        </div>
                        <div class="col-12">
                            <label class="form-label small mb-1">توضیحات</label>
                            <textarea class="form-control form-control-sm" rows="2" maxlength="500" @bind="rf.Note"></textarea>
                        </div>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <button class="btn btn-sm btn-success" disabled="@busy" @onclick="SaveReserve">
                            @if (busy) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-check-lg"></i> } ذخیره
                        </button>
                        <button class="btn btn-sm btn-light" @onclick="() => editingReserve = false">انصراف</button>
                    </div>
                }
            }
            else
            {
                <div class="text-muted small">رزرو دستی ندارد.</div>
            }
        </div>
    </aside>
}

@* ======================= مودال رنج ======================= *@
@if (showSubnetModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content">
                <div class="modal-header">
                    <h6 class="modal-title fw-700"><i class="bi bi-diagram-2-fill me-1"></i> @(editSubnetId > 0 ? "ویرایش رنج" : "رنج جدید") — @CompanyName</h6>
                    <button type="button" class="btn-close" @onclick="() => showSubnetModal = false"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label small mb-1">نام رنج <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" maxlength="150" @bind="sf.Name" placeholder="مثلاً: شبکهٔ اداری / سرورها / دوربین‌ها" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">رنج (CIDR) <span class="text-danger">*</span></label>
                            <input class="form-control form-control-sm" dir="ltr" maxlength="40" @bind="sf.Cidr" @bind:event="oninput" placeholder="192.168.30.0/24" />
                            <div class="form-text">@CidrHint</div>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1">گیت‌وی</label>
                            <input class="form-control form-control-sm" dir="ltr" maxlength="40" @bind="sf.Gateway" placeholder="192.168.30.1" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1">VLAN</label>
                            <input class="form-control form-control-sm" type="number" min="1" max="4094" @bind="sf.Vlan" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small mb-1">اسکن خودکار</label>
                            <select class="form-select form-select-sm" @bind="sf.AutoScanMinutes">
                                @foreach (var a in AutoScanOptions)
                                {
                                    <option value="@a.Minutes">@a.Title</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">DNS</label>
                            <input class="form-control form-control-sm" dir="ltr" maxlength="200" @bind="sf.DnsServers" placeholder="192.168.30.10, 8.8.8.8" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">محدودهٔ DHCP</label>
                            <input class="form-control form-control-sm" dir="ltr" maxlength="80" @bind="sf.DhcpRange" placeholder="192.168.30.100-192.168.30.200" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">محل</label>
                            <input class="form-control form-control-sm" maxlength="250" @bind="sf.Location" placeholder="مثلاً: ساختمان مرکزی" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small mb-1">توضیحات</label>
                            <input class="form-control form-control-sm" maxlength="1000" @bind="sf.Description" />
                        </div>
                    </div>
                    <div class="alert alert-light border small mt-3 mb-0">
                        <i class="bi bi-info-circle"></i>
                        اسکن از روی <b>سرور برنامه</b> انجام می‌شود (پینگ، پورت‌های رایج و جدول ARP). سرور باید به این رنج دسترسی شبکه داشته باشد.
                        حداکثر اندازهٔ هر رنج /۲۲ (۱۰۲۴ آدرس) است.
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-light btn-sm" @onclick="() => showSubnetModal = false">انصراف</button>
                    <button class="btn btn-primary btn-sm fw-700" disabled="@busy" @onclick="SaveSubnet">
                        @if (busy) { <span class="spinner-border spinner-border-sm"></span> } else { <i class="bi bi-check-lg"></i> } ذخیره
                    </button>
                </div>
            </div>
        </div>
    </div>
}

