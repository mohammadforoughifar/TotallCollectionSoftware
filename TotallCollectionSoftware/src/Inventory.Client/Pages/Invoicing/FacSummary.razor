@page "/fac/reports/summary"
@inject IFacReportService ReportSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>گزارش تجمیعی فروش و خرید فاکتورها</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ ================== -->
    <div class="fin-header mb-4 d-print-none">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-emerald-gradient">
                    <i class="bi bi-file-earmark-bar-graph-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">گزارش تجمیعی و تحلیلی فاکتورها</h1>
                        <span class="badge rounded-pill fin-badge-emerald">تجمیع دوره‌ای</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        تجمیع فاکتورهای رسمی و قطعی بر اساس بازه ماهانه، روزانه، طرف‌حساب و تفکیک کالاها
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-secondary fin-btn-pill" disabled="@(result is null)" @onclick="Print">
                    <i class="bi bi-printer-fill me-1"></i> چاپ رسمی گزارش
                </button>
            </div>
        </div>
    </div>

    <!-- ================== نوار فیلتر ================== -->
    <div class="fin-card mb-4 d-print-none">
        <div class="fin-card-body p-3">
            <div class="row g-2.5 align-items-end">
                <div class="col-6 col-md-3">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">نوع فاکتور</label>
                    <select class="form-select fin-input" value="@((int)kind)" @onchange="OnKind">
                        <option value="1">فاکتور فروش</option>
                        <option value="0">فاکتور خرید</option>
                        <option value="3">برگشت از فروش</option>
                        <option value="2">برگشت از خرید</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">تجمیع بر اساس</label>
                    <select class="form-select fin-input" value="@groupBy" @onchange="OnGroup">
                        <option value="month">ماه به ماه</option>
                        <option value="day">روزانه</option>
                        <option value="party">طرف‌حساب (مشتری/تأمین‌کننده)</option>
                        <option value="product">کالاهای پرفروش/پرتکرار</option>
                    </select>
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">از تاریخ</label>
                    <DatePicker Value="from" ValueChanged="OnFrom" AllowClear="true" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">تا تاریخ</label>
                    <DatePicker Value="to" ValueChanged="OnTo" AllowClear="true" />
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="text-secondary fs-8 mt-2">در حال استخراج و تجمیع داده‌های مالی فاکتورها...</div>
        </div>
    }
    else if (result is null || result.Rows.Count == 0)
    {
        <div class="fin-card">
            <div class="fin-card-body text-center py-5">
                <div class="fin-avatar bg-slate-subtle text-slate mx-auto mb-2" style="width:52px;height:52px">
                    <i class="bi bi-inbox fs-3"></i>
                </div>
                <h5 class="fw-800 text-dark">فاکتور قطعی‌شده‌ای در این بازه یافت نشد</h5>
                <p class="text-secondary fs-8 mb-0">تنها اسناد و فاکتورهایی که تأیید قطعی شده‌اند در محاسبات آماری منظور می‌شوند.</p>
            </div>
        </div>
    }
    else
    {
        <!-- ================== کارت‌های KPI ================== -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-indigo">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-indigo">تعداد کل فاکتورها</span>
                            <div class="fin-kpi-value text-indigo num mt-1">@result.TotalCount.Num()</div>
                            <div class="fin-kpi-unit">فقره سند رسمی</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                            <i class="bi bi-receipt"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5">قطعی‌شده در بازه</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-amber">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-amber">مقدار کل کالاها</span>
                            <div class="fin-kpi-value text-amber num mt-1">@result.TotalQuantity.Num()</div>
                            <div class="fin-kpi-unit">مجموع حجم فیزیکی</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                            <i class="bi bi-box-seam"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5">گردش وزنی/تعدادی</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-rose">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-rose">مالیات بر ارزش افزوده</span>
                            <div class="fin-kpi-value text-rose num mt-1">@result.TotalVat.Money()</div>
                            <div class="fin-kpi-unit">ریال مالیات قانونی</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-rose-subtle text-rose">
                            <i class="bi bi-percent"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-rose-subtle text-rose rounded-pill px-2.5">سهم مالیات فاکتورها</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-emerald">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-emerald">جمع کل خالص درآمد/هزینه</span>
                            <div class="fin-kpi-value text-emerald num mt-1">@result.TotalNet.Money()</div>
                            <div class="fin-kpi-unit">ریال مبلغ نهایی</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                            <i class="bi bi-cash-stack"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">تسویه‌شده و تعهدی</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================== جدول تجمیعی ================== -->
        <div class="fin-card">
            <div class="fin-card-header d-flex justify-content-between align-items-center p-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-table text-primary fs-5"></i>
                    <span class="fw-800 text-dark">@KindTitle(result.Kind) — تفکیک بر اساس @GroupTitle(result.GroupBy)</span>
                </div>
                <span class="badge bg-indigo-subtle text-indigo rounded-pill px-3 py-1.5 num fs-8">
                    @result.Rows.Count.Num() ردیف تحلیلی
                </span>
            </div>
            <div class="fin-card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fin-table">
                        <thead class="bg-light">
                            <tr>
                                <th style="width:48px" class="text-secondary fs-8 fw-700 py-3">#</th>
                                <th class="text-secondary fs-8 fw-700 py-3">عنوان گروه / دوره (@GroupTitle(result.GroupBy))</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-center">تعداد فاکتور</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-center">حجم/مقدار</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-center">مأخذ مالیاتی (ریال)</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-center">مالیات (ریال)</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-center">جمع کل (ریال)</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-center" style="width:18%">سهم از کل</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var row = 1; var max = result.Rows.Max(r => r.Net); }
                            @foreach (var r in result.Rows)
                            {
                                <tr>
                                    <td class="num text-secondary">@((row++).FaDigits())</td>
                                    <td class="fw-700 text-dark num">@r.Title.FaDigits()</td>
                                    <td class="text-center num">@r.Count.Num()</td>
                                    <td class="text-center num">@r.Quantity.Num()</td>
                                    <td class="text-center num text-secondary">@r.Taxable.Money()</td>
                                    <td class="text-center num text-rose">@r.Vat.Money()</td>
                                    <td class="text-center num fw-800 text-emerald">@r.Net.Money()</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="progress flex-grow-1" style="height:7px; border-radius:10px; background:#f1f5f9;">
                                                <div class="progress-bar bg-primary rounded-pill" style="@BarStyle(r.Net, max)"></div>
                                            </div>
                                            <span class="fs-9 text-secondary num" style="min-width:32px">
                                                @((max > 0 ? (r.Net * 100 / max).ToString("0") : "0").FaDigits())٪
                                            </span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                        <tfoot class="bg-light fw-800">
                            <tr>
                                <th colspan="2" class="text-end text-dark py-3">مجموع ارقام تجمیعی:</th>
                                <th class="text-center num text-dark">@result.TotalCount.Num()</th>
                                <th class="text-center num text-dark">@result.TotalQuantity.Num()</th>
                                <th class="text-center num text-secondary">@result.Rows.Sum(r => r.Taxable).Money()</th>
                                <th class="text-center num text-rose">@result.TotalVat.Money()</th>
                                <th class="text-center num text-emerald fs-7">@result.TotalNet.Money()</th>
                                <th></th>
                            </tr>
                        </tfoot>
                    </table>
                </div>
            </div>
        </div>
    }
</div>


<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
