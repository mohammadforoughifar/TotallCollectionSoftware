@* جدول نمایش تفاوت دو ورژن — با رنگ‌بندی افزوده/حذف‌شده/تغییریافته *@

<div class="card mb-2">
    <div class="card-header fw-700 fs-8 d-flex justify-content-between align-items-center">
        <span><i class="bi @Icon ms-1"></i> @Title</span>
        @if (Rows.Any(r => r.Kind != "same"))
        {
            <span class="badge bg-primary-subtle text-primary">
                @Rows.Count(r => r.Kind != "same").Num() تغییر
            </span>
        }
    </div>
    <div class="card-body p-0">
        @if (!Rows.Any())
        {
            <div class="text-center text-muted py-2 fs-8">تفاوتی نیست.</div>
        }
        else
        {
            <table class="table table-sm mb-0 fs-8 align-middle diff-tbl">
                <thead>
                    <tr class="table-light">
                        <th style="width:26%">فیلد</th>
                        <th style="width:34%">@LeftHead</th>
                        <th style="width:34%">@RightHead</th>
                        <th style="width:6%"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Rows)
                    {
                        <tr class="@RowClass(r.Kind)">
                            <td class="fw-500">@r.Field</td>
                            <td class="@CellClass(r.Kind, true)">@Show(r.Left)</td>
                            <td class="@CellClass(r.Kind, false)">@Show(r.Right)</td>
                            <td class="text-center">
                                <i class="bi @KindIcon(r.Kind)" title="@KindTitle(r.Kind)"></i>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>

<style>
    .diff-tbl td { word-break: break-word; }
    .diff-added { background: #f0fdf4 !important; }
    .diff-removed { background: #fef2f2 !important; }
    .diff-changed { background: #fffbeb !important; }
    .diff-old { color: #b91c1c; text-decoration: line-through; opacity: .75; }
    .diff-new { color: #15803d; font-weight: 600; }
</style>

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Icon { get; set; } = "bi-list";
    [Parameter] public List<DocVersionDiffRow> Rows { get; set; } = new();
    [Parameter] public string LeftHead { get; set; } = "قدیمی";
    [Parameter] public string RightHead { get; set; } = "جدید";

    private static string Show(string? v) => string.IsNullOrWhiteSpace(v) ? "—" : v;

    private static string RowClass(string kind) => kind switch
    {
        "added" => "diff-added",
        "removed" => "diff-removed",
        "changed" => "diff-changed",
        _ => ""
    };

    // در ستون قدیمی مقدارِ حذف‌شده خط‌خورده و در ستون جدید مقدارِ تازه پررنگ می‌شود
    private static string CellClass(string kind, bool isLeft) => kind switch
    {
        "changed" => isLeft ? "diff-old" : "diff-new",
        "removed" => isLeft ? "diff-old" : "",
        "added" => isLeft ? "" : "diff-new",
        _ => "text-muted"
    };

    private static string KindIcon(string kind) => kind switch
    {
        "added" => "bi-plus-circle-fill text-success",
        "removed" => "bi-dash-circle-fill text-danger",
        "changed" => "bi-pencil-fill text-warning",
        _ => "bi-dash text-muted"
    };

    private static string KindTitle(string kind) => kind switch
    {
        "added" => "اضافه شده",
        "removed" => "حذف شده",
        "changed" => "تغییر کرده",
        _ => "بدون تغییر"
    };
}
