<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ServiceWorkerAssetsManifest>service-worker-assets.js</ServiceWorkerAssetsManifest>
    <!-- حذف وابستگی به فایل‌های ICU (رفع مشکل بوت و حجم کمتر) -->
    <InvariantGlobalization>true</InvariantGlobalization>
    <BlazorWebAssemblyPreserveCollationData>false</BlazorWebAssemblyPreserveCollationData>
    <!-- کاهش حجم پابلیش: بدون فایل دیباگ (pdb) در خروجی Release -->
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <NoWarn>CS0414</NoWarn>

    <!--
      رفع خطای بیلد:
        Failed to convert '…Microsoft.Extensions.DependencyInjection.Abstractions.dll' to webcil:
        Could not find a part of the path '…\obj\Debug\net8.0\tmp-webcil\<hash>\…wasm'
      دو علت دارد و هر دو این‌جا پوشش داده شده‌اند:
      ۱) «مسیر طولانی» ویندوز: پوشهٔ پروژه در مسیری عمیق/با پرانتز است
         (مثل …\Downloads\TotallCollectionSoftware-main (22)\…). مرحلهٔ تبدیل به webcil
         فایلِ موقت با نامِ ۳۲ کاراکتری می‌سازد و از سقف ۲۶۰ کاراکتر عبور می‌کند.
         راه‌حل قطعی: پروژه را در مسیر کوتاه باز کنید (مثل C:\dev\tc) یا Long Paths را
         در ویندوز فعال کنید. راه‌حلِ کنارِ آن، همان چیزی است که این‌جا آمده:
      ۲) با false کردنِ webcil، مرحلهٔ تبدیل (و پوشهٔ tmp-webcil) به‌کل حذف می‌شود؛
         اسمبلی‌ها به شکل معمولِ .dll در خروجی می‌مانند و رفتار برنامه تغییری نمی‌کند.
         این تنظیم روی .NET 8 و همچنین بیلدِ net8.0 با SDK جدیدتر معتبر است.
    -->
    <WasmEnableWebcil>false</WasmEnableWebcil>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="8.0.30" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <ServiceWorker Include="wwwroot\service-worker.js" PublishedContent="wwwroot\service-worker.published.js" />
  </ItemGroup>

  <!-- مُهر یکتا روی service-worker منتشرشده در هر پابلیش: مرورگر بایت‌های اسکریپت SW را
       مقایسه می‌کند؛ بدون مُهر، فایل یکسان یعنی «نسخهٔ جدید نیست» و کاربر برای همیشه روی
       کش قدیمی می‌ماند و تغییرات را «نمی‌بیند». -->
  <Target Name="StampServiceWorker" AfterTargets="Publish">
    <WriteLinesToFile File="$(PublishDir)wwwroot/service-worker.js"
                      Lines="// build-stamp: $([System.DateTime]::UtcNow.ToString(yyyyMMddHHmmssfff))"
                      Overwrite="false" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="../Inventory.Shared/Inventory.Shared.csproj">
      <Name>Inventory.Shared</Name>
      <ReferenceOutputAssembly>true</ReferenceOutputAssembly>
      <SkipGetTargetFrameworkProperties>false</SkipGetTargetFrameworkProperties>
    </ProjectReference>
  </ItemGroup>

</Project>
