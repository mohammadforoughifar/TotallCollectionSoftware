<div class="hr-link-grid">
    @foreach (var item in Items)
    {
        <a href="@item.Href" class="hr-link-card"><span class="hr-link-icon"><i class="bi @item.Icon" aria-hidden="true"></i></span><span>@item.Title</span><i class="bi bi-arrow-left" aria-hidden="true"></i></a>
    }
</div>
@code { [Parameter] public IEnumerable<HrNavigation.Entry> Items { get; set; } = []; }
