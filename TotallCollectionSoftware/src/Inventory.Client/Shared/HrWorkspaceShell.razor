@inject NavigationManager Nav
@inject IAuthState Auth
<div class="hr-workspace" dir="rtl">
    <div class="hr-context">
        <nav aria-label="مسیر منابع انسانی" class="hr-breadcrumb">
            <a href="hr-main"><i class="bi bi-house-door" aria-hidden="true"></i><span>منابع انسانی</span></a>
            @if (group is not null)
            {
                <i class="bi bi-chevron-left" aria-hidden="true"></i>
                <a href="@("hr-main/section/" + group.Id)">@group.Title</a>
            }
            @if (path != "hr-main" && !path.StartsWith("hr-main/section/"))
            {
                <i class="bi bi-chevron-left" aria-hidden="true"></i><span aria-current="page">@HrNavigation.Title(path)</span>
            }
        </nav>
    </div>
    @ChildContent
</div>
@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private string path = "";
    private HrNavigation.Section? group;
    protected override void OnParametersSet()
    {
        path = HrNavigation.Path(Nav.ToBaseRelativePath(Nav.Uri));
        group = HrNavigation.Visible(Auth.Has, Auth.IsAdmin).FirstOrDefault(s => s.Id == HrNavigation.SectionId(path));
    }
}
