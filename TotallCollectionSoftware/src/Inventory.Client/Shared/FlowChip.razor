@* تراشهٔ وضعیت گردش‌کار پروژه (کارتابل) — ۰=در انتظار مدیر، ۱=در انتظار کارشناسی، ۲=رد، ۳=نهایی *@
<span class="flow-chip @Css" title="@TitleText"><i class="bi @Icon"></i> @Text</span>

<style>
    .flow-chip {
        display: inline-flex; align-items: center; gap: .25rem; border-radius: 999px;
        font-size: .68rem; font-weight: 800; padding: .18rem .55rem; white-space: nowrap;
    }
    .flow-chip.s0 { background: #fff7ed; color: #c2410c; }   /* در انتظار مدیر */
    .flow-chip.s1 { background: #eff6ff; color: #1d4ed8; }   /* در انتظار کارشناسی */
    .flow-chip.s2 { background: #fef2f2; color: #dc2626; }   /* رد شده */
    .flow-chip.s3 { background: #ecfdf5; color: #059669; }   /* نهایی */
</style>

@code {
    [Parameter] public int Status { get; set; }

    private string Css => $"s{Status}";
    private string Text => Status switch
    {
        0 => "در انتظار مدیر",
        1 => "در انتظار کارشناسی",
        2 => "رد شده",
        3 => "نهایی",
        _ => "-"
    };
    private string Icon => Status switch
    {
        0 => "bi-person-badge",
        1 => "bi-clipboard2-pulse",
        2 => "bi-x-circle",
        3 => "bi-check2-circle",
        _ => "bi-dash"
    };
    private string TitleText => Status switch
    {
        0 => "در کارتابل مدیر — منتظر تایید/رد",
        1 => "مدیر تایید کرد — در کارتابل کارشناسی",
        2 => "توسط مدیر رد شده",
        3 => "کارشناسی انجام و پروژه نهایی شد",
        _ => ""
    };
}
