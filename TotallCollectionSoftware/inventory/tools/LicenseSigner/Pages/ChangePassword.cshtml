@page "/ChangePassword"
@inject SupportAuthService Auth
@inject AuditChainService Audit
@{
    ViewData["Title"] = "تعویض گذرواژه";
    ViewData["First"] = Request.Query.ContainsKey("first");
}
@functions {
    public string Error { get; set; } = "";
    public string OkMessage { get; set; } = "";

    public async Task<IActionResult> OnPostAsync()
    {
        var current = Request.Form["current"].ToString();
        var next = Request.Form["next"].ToString();
        var confirm = Request.Form["confirm"].ToString();

        var (ok, error) = await Auth.ChangePasswordAsync(User.UserId(), current, next, confirm);
        if (!ok)
        {
            Error = error ?? "تعویض گذرواژه انجام نشد.";
            return Page();
        }

        await Audit.AppendAsync(User.UserName(), "PASSWORD_CHANGE", "SupportUser", User.UserId().ToString(), null, User.UserId());
        OkMessage = "گذرواژه تغییر کرد.";
        return Page();
    }
}
<div class="page-head"><h1>تعویض گذرواژه</h1></div>
@if (ViewData["First"] is true)
{
    <div class="alert warn">این اولین ورود شماست؛ پیش از ادامه باید گذرواژه را تعویض کنید.</div>
}
@if (!string.IsNullOrEmpty(Error)) { <div class="alert error">@Error</div> }
@if (!string.IsNullOrEmpty(OkMessage))
{
    <div class="alert ok">@OkMessage — <a href="/">رفتن به داشبورد</a></div>
}
<div class="card" style="max-width:480px"><div class="card-body">
    <form method="post">
        <div class="field"><label for="current">گذرواژهٔ فعلی</label><input id="current" name="current" type="password" required /></div>
        <div class="field"><label for="next">گذرواژهٔ تازه (حداقل ۱۰ نویسه)</label>
            <input id="next" name="next" type="password" required minlength="10" /></div>
        <div class="field"><label for="confirm">تکرار گذرواژهٔ تازه</label>
            <input id="confirm" name="confirm" type="password" required minlength="10" /></div>
        <button type="submit" class="btn">ذخیره</button>
    </form>
</div></div>
