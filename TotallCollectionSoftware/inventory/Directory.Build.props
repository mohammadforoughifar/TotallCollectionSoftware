<Project>
  <!-- Keep the Blazor intermediate asset tree below legacy Windows path limits.
       Set before Microsoft.Common.props chooses MSBuildProjectExtensionsPath so restore,
       VS design-time builds and normal builds agree. The key isolates each checkout. -->
  <PropertyGroup Condition="'$(OS)' == 'Windows_NT' and '$(MSBuildProjectName)' == 'Inventory.Client' and '$(LOCALAPPDATA)' != '' and '$(BaseIntermediateOutputPath)' == '' and '$(MSBuildProjectExtensionsPath)' == '' and '$(UseArtifactsOutput)' != 'true' and '$(ArtifactsPath)' == ''">
    <_InventoryClientObjKey>$([MSBuild]::StableStringHash('$(MSBuildProjectFullPath)'))</_InventoryClientObjKey>
    <BaseIntermediateOutputPath>$(LOCALAPPDATA)\TCS\obj\$(_InventoryClientObjKey)\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'Inventory.Client'">
    <!-- An old in-project obj folder must not become a Razor/C# input after moving obj. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj/**;bin/**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup>
    <!-- .NET 8 uses C# 12. Do not use latest: C# 14 can bind array
         extension calls to Span overloads that .NET 8 expression interpreters cannot execute. -->
    <LangVersion>12.0</LangVersion>
    <!--
      CS0006 Metadata file '...\\obj\\Debug\\net8.0\\ref\\*.dll' could not be found
      اسمبلی مرجع (ref) اگر مسیر پروژه پرانتز/فاصله داشته باشد (مثل Downloads\\... (2)\\)
      یا بیلد موازی قبل از اتمام Shared اجرا شود، ساخته نمی‌شود.
      وابسته‌ها باید همان DLL اصلی را مرجع کنند.
    -->
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <AppendTargetFrameworkToOutputPath>true</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <!-- کاهش حجم خروجی: در Release فایل PDB تولید نشود (بیلد Debug دست‌نخورده) -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
