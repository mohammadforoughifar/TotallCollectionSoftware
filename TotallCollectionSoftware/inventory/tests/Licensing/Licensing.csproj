<Project Sdk="Microsoft.NET.Sdk">
  <!--
    تست‌های موتور لایسنس — به سبک پروژه‌های تست موجود همین مخزن: برنامهٔ کنسولی با
    متد Check()، نه xUnit. دلیل: کل ۲۵ پروژهٔ tests/ همین سبک‌اند و بدون نیاز به
    test runner و فقط با اجرای سادهٔ پروژه (dotnet run) کار می‌کنند.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Inventory.Licensing/Inventory.Licensing.csproj" />
    <!--
      ارجاع به API برای تست پوشش مسیرها: باید همان میدل‌ور و رجیستری واقعی سنجیده شود،
      نه یک کپی از فهرست پیشوندها. اگر این ارجاع نباشد، تست مسیرها بی‌معنا می‌شود.
    -->
    <ProjectReference Include="../../src/Inventory.Api/Inventory.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!--
      گام ۵: منطق «نگاشت منو به ماژول»، «خلاصهٔ وضعیت» و «متن خطاها» عمداً کلاس‌های
      سادهٔ C# در پروژهٔ کلاینت‌اند (بدون وابستگی به Blazor) تا همین‌جا و بدون مرورگر
      تست شوند. فایل‌ها Link می‌شوند تا کپی دوم ساخته نشود.
    -->
    <Compile Include="../../src/Inventory.Client/Services/LicenseMenuMap.cs" Link="Client/LicenseMenuMap.cs" />
    <Compile Include="../../src/Inventory.Client/Services/LicenseStatusSummary.cs" Link="Client/LicenseStatusSummary.cs" />
    <Compile Include="../../src/Inventory.Client/Services/LicenseErrorText.cs" Link="Client/LicenseErrorText.cs" />
  </ItemGroup>
</Project>
