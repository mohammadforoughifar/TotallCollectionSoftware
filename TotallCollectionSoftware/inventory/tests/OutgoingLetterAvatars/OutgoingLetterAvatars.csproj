<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Inventory.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the existing real shared/letter components and client services.
         Compile the remaining outgoing pages here; never copy production markup. -->
    <ProjectReference Include="../InnerLetterAvatars/UiProbe/UiProbe.csproj" />
    <Compile Include="Program.cs;Fixtures.cs;Tests.cs" />
    <RazorComponent Include="App.razor" />
    <RazorComponent Include="../../src/Inventory.Client/_Imports.razor" Link="_Imports.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/_Imports.razor" Link="Pages/Office/_Imports.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Guides/OutgoingLetterGuide.razor" Link="Pages/Office/Guides/OutgoingLetterGuide.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Guides/DabirkhaneGuide.razor" Link="Pages/Office/Guides/DabirkhaneGuide.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Letters/Outgoing/*.razor"
                    Exclude="../../src/Inventory.Client/Pages/Office/Letters/Outgoing/ComposeOutgoingModal.razor;../../src/Inventory.Client/Pages/Office/Letters/Outgoing/OutgoingErjaSheet.razor"
                    Link="Pages/Office/Letters/Outgoing/%(Filename)%(Extension)" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Letters/Incoming/IntegratedIncomingPanel.razor" Link="Pages/Office/Letters/Incoming/IntegratedIncomingPanel.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Letters/Incoming/IncomingLetterViewModal.razor" Link="Pages/Office/Letters/Incoming/IncomingLetterViewModal.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Letters/Incoming/IncomingGardeshModal.razor" Link="Pages/Office/Letters/Incoming/IncomingGardeshModal.razor" />
  </ItemGroup>
</Project>
