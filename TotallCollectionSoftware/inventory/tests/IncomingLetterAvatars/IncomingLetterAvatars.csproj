<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Inventory.Client</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Reuse the real shared components/services; compile the actual incoming pages. -->
    <ProjectReference Include="../InnerLetterAvatars/UiProbe/UiProbe.csproj" />
    <Compile Include="Program.cs;Fixtures.cs;Tests.cs" />
    <RazorComponent Include="App.razor" />
    <RazorComponent Include="../../src/Inventory.Client/_Imports.razor" Link="_Imports.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/_Imports.razor" Link="Pages/Office/_Imports.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Guides/IncomingLetterGuide.razor" Link="Pages/Office/Guides/IncomingLetterGuide.razor" />
    <RazorComponent Include="../../src/Inventory.Client/Pages/Office/Letters/Incoming/*.razor"
                    Exclude="../../src/Inventory.Client/Pages/Office/Letters/Incoming/ComposeIncomingModal.razor;../../src/Inventory.Client/Pages/Office/Letters/Incoming/IncomingErjaSheet.razor"
                    Link="Pages/Office/Letters/Incoming/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
