@page "/"
@page "/outgoing-letters/view/{LetterId:int}"
@namespace UnifiedSecretariatAvatarTests
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using Inventory.Client.Pages.Office.Letters.Outgoing
@inject NavigationManager Navigation

<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href="/" />
    <title>آزمون تصاویر دبیرخانه یکپارچه</title>
    <link rel="stylesheet" href="css/bootstrap.min.css" />
    <link rel="stylesheet" href="icons/bootstrap-icons.css" />
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/letters.css" />
    <style>body{margin:0;padding:8px;background:#f5f7fb}.fixture-notice{padding:6px 12px;font-size:12px;color:#1e40af;background:#dbeafe;border-radius:8px;margin-bottom:8px}</style>
</head>
<body>
    <div class="fixture-notice">محیط آزمون — تمام نامه‌ها، کاربران و تصاویر ساختگی‌اند؛ سرور اصلی استفاده نمی‌شود.</div>
    @if (new Uri(Navigation.Uri).AbsolutePath.StartsWith("/outgoing-letters/view/"))
    {
        <OutgoingLetterView LetterId="int.Parse(new Uri(Navigation.Uri).Segments.Last())" @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    }
    else
    {
        <OutgoingDabirkhane @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    }
    <script src="js/ui.js"></script>
    <script src="js/order-entry.js"></script>
    <script src="fixture-hotkeys.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
@code { [Parameter] public int LetterId { get; set; } }
