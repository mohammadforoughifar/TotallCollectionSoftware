<Project Sdk="Microsoft.NET.Sdk">
  <!--
    تست یکپارچهٔ مرحله ۲ — «سهمیه روی دیتابیس واقعی».

    چرا این پروژه جدا از tests/Licensing است؟ چون آن یکی فقط موتور را می‌سنجد و هیچ
    وابستگی‌ای به EF ندارد. اتمی‌بودن، تراکنش، HMAC و بازگشت مصرف فقط با یک دیتابیس واقعی
    قابل اثبات‌اند؛ پس این‌جا به Inventory.Api ارجاع می‌دهیم و روی SQLite موقت اجرا می‌کنیم.

    اجرا: پروژه را با dotnet run از همین پوشه اجرا کنید.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Inventory.Api/Inventory.Api.csproj" />
  </ItemGroup>
</Project>
