<Project Sdk="Microsoft.NET.Sdk.Razor">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Inventory.Client</RootNamespace>
    <AssemblyName>InnerLetterAvatarUiProbe</AssemblyName>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <NoWarn>CS0414</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Using Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="8.0.30" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="8.0.30" />
    <ProjectReference Include="../../../src/Inventory.Shared/Inventory.Shared.csproj" />
    <Compile Include="../../../src/Inventory.Client/**/*.cs"
             Exclude="../../../src/Inventory.Client/bin/**;../../../src/Inventory.Client/obj/**;../../../src/Inventory.Client/Program.cs;../../../src/Inventory.Client/**/*.razor.cs"
             Link="%(RecursiveDir)%(Filename)%(Extension)" />
    <!-- Compile actual components, not duplicate test markup. Avoid unrelated pages
         so this regression suite can run on memory-constrained build agents. -->
    <RazorComponent Include="../../../src/Inventory.Client/_Imports.razor" Link="_Imports.razor" />
    <RazorComponent Include="../../../src/Inventory.Client/Shared/**/*.razor" Link="Shared/%(RecursiveDir)%(Filename)%(Extension)" />
    <RazorComponent Include="../../../src/Inventory.Client/Layout/**/*.razor" Link="Layout/%(RecursiveDir)%(Filename)%(Extension)" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/_Imports.razor" Link="Pages/Office/_Imports.razor" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/Guides/OfficeGuide*.razor" Link="Pages/Office/Guides/%(Filename)%(Extension)" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/Letters/*.razor" Link="Pages/Office/Letters/%(Filename)%(Extension)" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/Letters/Outgoing/ComposeOutgoingModal.razor" Link="Pages/Office/Letters/Outgoing/ComposeOutgoingModal.razor" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/Letters/Outgoing/OutgoingErjaSheet.razor" Link="Pages/Office/Letters/Outgoing/OutgoingErjaSheet.razor" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/Letters/Incoming/IncomingErjaSheet.razor" Link="Pages/Office/Letters/Incoming/IncomingErjaSheet.razor" />
    <RazorComponent Include="../../../src/Inventory.Client/Pages/Office/Letters/Incoming/ComposeIncomingModal.razor" Link="Pages/Office/Letters/Incoming/ComposeIncomingModal.razor" />
  </ItemGroup>
</Project>
