<Project Sdk="Microsoft.NET.Sdk">
  <!-- آزمون سریع «قابلیت‌های تفکیک‌شده» (مثل نامهٔ وارده زیر اتوماسیون اداری).
       اجرا:  dotnet run -c Release (داخل همین پوشه)
       خروجی: PASS/FAIL برای هر بند + کد خروج ۰ فقط وقتی همه سبز باشند. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FeatureGuard</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../src/Inventory.Licensing/Inventory.Licensing.csproj" />
  </ItemGroup>
</Project>
