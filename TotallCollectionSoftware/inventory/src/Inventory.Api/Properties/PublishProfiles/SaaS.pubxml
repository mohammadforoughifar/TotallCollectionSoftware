<?xml version="1.0" encoding="utf-8"?>
<!--
  بستهٔ SaaS — نسخهٔ میزبانی‌شده (چند مشتری روی یک سرور).
  تفاوتش با OnPrem فقط پوشهٔ خروجی است؛ موتور لایسنس حذف شده و ثابت SAAS
  دیگر معنایی ندارد.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net8.0\win-x64\publish\saas\</PublishDir>
    <DeploymentMode>SaaS</DeploymentMode>
  </PropertyGroup>
</Project>
