<?xml version="1.0" encoding="utf-8"?>
<!--
  بستهٔ SaaS — نسخهٔ میزبانی‌شده (چند مشتری روی یک سرور).

  تفاوت اصلی با OnPrem فقط یک ثابت کامپایل است: SAAS.
  با این ثابت، DatabaseLicenseProvider کامپایل می‌شود و لایسنس از جدول‌های
  دیتابیس خوانده می‌شود؛ در بستهٔ OnPrem همین کلاس اصلاً وجود ندارد و لایسنس
  فقط از فایل امضاشدهٔ روی دیسک خوانده می‌شود.

  چرا Publish Profile و نه پارامتر خط فرمان؟ چون اگر ثابت را هر بار دستی پاس
  بدهیم، یک بار فراموش می‌شود و بستهٔ اشتباه منتشر می‌شود؛ بررسی آن هم بی‌صدا
  است. ابزار LicenseCheck --deployment این را از متادیتای خروجی می‌سنجد.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net8.0\win-x64\publish\saas\</PublishDir>
    <DefineConstants>$(DefineConstants);SAAS</DefineConstants>
    <DeploymentMode>SaaS</DeploymentMode>
  </PropertyGroup>
</Project>
