<?xml version="1.0" encoding="utf-8"?>
<!--
  بستهٔ OnPrem — نسخهٔ نصب روی سرور مشتری (تک‌مستأجر).
  موتور لایسنس از سامانه حذف شده است؛ این پروفایل فقط خروجی win-x64 می‌سازد
  و هیچ کلید/فایل لایسنس یا ثابت کامپایل ویژه‌ای لازم ندارد.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net8.0\win-x64\publish\onprem\</PublishDir>
    <DeploymentMode>OnPrem</DeploymentMode>
  </PropertyGroup>
</Project>
