<?xml version="1.0" encoding="utf-8"?>
<!--
  بستهٔ OnPrem — نسخهٔ نصب روی سرور مشتری (تک‌مستأجر).

  عمداً هیچ ثابتی اضافه نمی‌شود: بدون SAAS، کلاس DatabaseLicenseProvider
  کامپایل نمی‌شود و لایسنس فقط از فایل امضاشده خوانده می‌شود. اگر این بسته
  به‌اشتباه با SAAS ساخته شود، سامانه سراغ جدول‌های لایسنس دیتابیس می‌رود که
  روی نصب مشتری وجود ندارند؛ LicenseCheck --deployment --expect onprem این
  اشتباه را پیش از تحویل می‌گیرد.
-->
<Project>
  <PropertyGroup>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net8.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <PublishDir>bin\Release\net8.0\win-x64\publish\onprem\</PublishDir>
    <DeploymentMode>OnPrem</DeploymentMode>
  </PropertyGroup>
</Project>
