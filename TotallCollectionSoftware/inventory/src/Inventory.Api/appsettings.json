  // پیش‌فرض: Ollama روی همان سرور. اگر مدل نصب نباشد، دستیار در «حالت آفلاین»
  // همچنان به سؤال‌های پرتکرار (مرخصی، فیش، حضور، نامه‌ها) جواب می‌دهد.
  // معادل متغیرهای محیطی: Ai__BaseUrl ، Ai__ChatModel ، Ai__EmbeddingModel ، Ai__Enabled
  "Ai": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434/v1",
    "ApiKey": "",
    "ChatModel": "qwen3.5:latest",
    "EmbeddingModel": "bge-m3",
    // ---- تبدیل ویس (پیام صوتی پیام‌رسان) به متن ----
    // قرارداد OpenAI: POST {TranscriptionBaseUrl}/audio/transcriptions
    // پیش‌فرض روی «سرویس محلی آمادهٔ خودمان» تنظیم است: پوشهٔ stt-service در ریشهٔ مخزن
    //   ویندوز: stt-service\run_windows.bat      لینوکس: ./stt-service/run.sh
    //   (رایگان، بدون کلید، بدون اینترنت بعد از یک‌بار دانلود مدل — راهنما: stt-service/README.md)
    // گزینه‌های دیگر: OpenAI → whisper-1 | Groq → whisper-large-v3 |
    //                 هر سرور سازگار دیگر (speaches / faster-whisper-server) → نام مدل آن سرویس
    // ⚠️ اگر سرویس محلی را اجرا نمی‌کنید و سرویس دیگری هم ندارید، هر دو مقدار را خالی بگذارید
    //    تا دکمهٔ «تبدیل به متن» پیام راهنمای تنظیمات بدهد.
    // معادل متغیر محیطی: Ai__TranscriptionModel ، Ai__TranscriptionBaseUrl ، Ai__TranscriptionApiKey
    "TranscriptionModel": "small",
    "TranscriptionBaseUrl": "http://127.0.0.1:9000/v1",
    "TranscriptionApiKey": "",
    "TranscriptionLanguage": "fa",
    "TranscriptionMaxMegabytes": 24,
    "TimeoutSeconds": 180,
    "MaxToolIterations": 6,
    "MaxHistoryMessages": 12,
    "MaxMessagesPerUserPerDay": 200,
    "BaleEnabled": true,
    "MessengerEnabled": true,
    "BriefingEnabled": true,
    "BriefingTime": "07:30",
    "BriefingChequeDays": 7,
    "BriefingDeadlineDays": 2,
    "PendingActionExpiryMinutes": 15
  },
  // ================= سرویس OCR پایتون (اختیاری) =================
  // تشخیص متن تصویر و PDF اسکن‌شده (فارسی/انگلیسی) — پوشهٔ ocr-service کنار همین پروژه.
  // خالی = موتور محلی قدیمی روی همین سرور (نیازمند نصب tesseract + poppler-utils روی سرور).
  // اگر سرویس پایتون را روی همین ماشین اجرا می‌کنید:
  //     "BaseUrl": "http://127.0.0.1:8765"
  // اگر BaseUrl خالی باشد ولی AutoDetect=true، برنامه هنگام بالا آمدن سرویس پیش‌فرض
  // 127.0.0.1:8765 را خودش جستجو و وصل می‌شود (فقط سرویس‌هایی که خودش را totall-ocr معرفی کنند).
  // معادل متغیرهای محیطی (برای استقرار): OcrService__BaseUrl ، OcrService__ApiKey ، OcrService__TimeoutSeconds
  "OcrService": {
    "BaseUrl": "",
    "ApiKey": "",
    "TimeoutSeconds": 600,
    "AutoDetect": true
  },

  // متن‌گیری شبانهٔ فایل‌های ورود انبوه (OCR) — خارج از ساعت کاری اجرا می‌شود
  // زمان‌ها به وقت محلی سرور. اگر OcrService:BaseUrl تنظیم نشده باشد،
  // متن‌گیری محلی (pdftotext/tesseract) انجام می‌شود و سرعتش پایین‌تر است.
  "DocImportOcr": {
    "Enabled": true,
    "StartTime": "22:00",
    "EndTime": "06:00",
    "BatchSize": 20,
    "PauseBetweenBatchesMs": 5000
  },

  // ================= آرشیو اسناد — محل ذخیرهٔ فایل مدارک روی سرور =================
  // همهٔ فایل‌های مدارک (آپلود دستی، نسخهٔ جدید و ورود انبوه) اینجا روی دیسک سرور ذخیره می‌شوند.
  // خالی = مثل قبل داخل پوشهٔ برنامه: wwwroot\uploads\DocVersion
  // روی IIS حتماً یک مسیر ثابت بیرون از پوشهٔ برنامه بگذارید تا با انتشار نسخهٔ جدید پاک نشود، مثلاً:
  //   "StorageRoot": "D:\\InventoryData\\DocArchive"
  // (مسیر شبکه‌ای مثل \\\\fileserver\\archive هم مجاز است، به شرط دسترسی هویت Application Pool)
  // و به هویت Application Pool دسترسی Modify بدهید:
  //   icacls "D:\InventoryData\DocArchive" /grant "IIS AppPool\<نام AppPool>:(OI)(CI)M"
  // فایل‌های قبلی در wwwroot\uploads\DocVersion همچنان پیدا می‌شوند؛ برای یکپارچگی می‌توانید محتوای آن پوشه
  // را (با همان زیرپوشه‌ها) به مسیر جدید کپی کنید. مقدار معادل متغیر محیطی: DocArchive__StorageRoot
  "DocArchive": {
    "StorageRoot": ""
  },

  // ================= آرشیو اسناد — ورود انبوه =================
  // کاربر پوشه‌ای را در مرورگر انتخاب می‌کند و فایل‌ها یکی‌یکی آپلود و وارد می‌شوند.
  // ورود انبوه همیشه روشن است؛ مقدار Enabled در این فایل (چه true چه false) نادیده گرفته می‌شود
  // تا فایل پیکربندی قدیمی روی سرور نتواند بی‌صدا خاموشش کند.
  // تنها راه خاموش کردن: متغیر محیطی DocArchiveImport__Enabled=false
  "DocArchiveImport": {
    "MaxFileBytes": 10485760,
    "CreateMissingFolders": true,
    "MaxFullPathLength": 259
  },

  // ================= میز کار توسعه — وب‌هوک گیت =================
  // Secret را در محیط عملیاتی با متغیر DEVTEAM_GIT_WEBHOOK_SECRET یا DevTeam__GitWebhookSecret بگذارید.
  // GitHub: Settings → Webhooks → Payload URL = https://YOUR/api/dev-team/hooks/github
  //         Secret = همین مقدار؛ Content type = application/json؛ Event = push
  // GitLab: Settings → Webhooks → URL = https://YOUR/api/dev-team/hooks/gitlab
  //         Secret token = همین مقدار؛ Push events
  // در پیام کامیت: DT-1405-0001  یا  task:12  و اختیاری  mod:Office
  // CI: POST /api/dev-team/hooks/ci|github-ci|gitlab-ci + X-DevTeam-Token (failure → Problem)
  "DevTeam": {
    "GitWebhookEnabled": true,
    "GitWebhookSecret": ""
  }
}
