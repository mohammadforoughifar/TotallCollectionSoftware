{
  // ================== لایسنس در محیط توسعه ==================
  // در Development بررسی لایسنس عمداً غیرفعال است تا توسعه‌دهنده با «فقط‌خواندنی»،
  // بنر قرمز و خطاهای لایسنس درگیر نشود: همهٔ ۳۳ ماژول باز، بدون سقف سهمیه، بدون
  // سقف صندلی و بدون قفل ساعت.
  //
  // ⚠️ این حالت فقط وقتی ASPNETCORE_ENVIRONMENT=Development باشد اثر دارد و در
  //    Production وجود ندارد (حتی اگر همین کلید آن‌جا true گذاشته شود).
  //
  // برای دیدن رفتار واقعی لایسنس در حین توسعه (آپلود سند، انقضا، فقط‌خواندنی)
  // کافیست مقدار زیر را false کنید.
  "Licensing": {
    "DevelopmentBypass": true
  },

  "Database": {
    "Provider": "SqlServer"
  },
  "ConnectionStrings": {
    "Default": "Server=.;Database=InventoryDb;Trusted_Connection=True;TrustServerCertificate=True;Encrypt=False"
    // جایگزین SQL Auth روی ۱۹۲.۱۶۸.۳۰.۱۰۴ — برای فعال‌شدن کافیست این خط را از کامنت خارج و خط «Default» بالا را کامنت/حذف کن:
    // نمونهٔ رشتهٔ اتصال — عمداً بدون رمز. رمز را در appsettings.Local.json (که در مخزن نیست)
    // یا متغیر محیطی ConnectionStrings__Default بگذارید.
    //"Default": "Server=.;Database=InventoryDb;Integrated Security=True;TrustServerCertificate=True;Encrypt=False"
  },
  "Ai": {
    "Enabled": true,
    "BaseUrl": "http://localhost:11434/v1",
    "ApiKey": "",
    "ChatModel": "qwen3.5:latest",
    "EmbeddingModel": "bge-m3",
    "TimeoutSeconds": 180,
    "MaxToolIterations": 6,
    "MaxHistoryMessages": 12,
    "MaxMessagesPerUserPerDay": 200,
    "BaleEnabled": true,
    "MessengerEnabled": true,
    "BriefingEnabled": true,
    "BriefingTime": "07:30",
    "BriefingChequeDays": 7,
    "BriefingDeadlineDays": 2,
    "PendingActionExpiryMinutes": 15
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  }
}
