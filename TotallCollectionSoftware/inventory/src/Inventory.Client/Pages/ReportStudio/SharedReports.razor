@namespace Inventory.Client.Pages
@page "/reports-hub"
@page "/reports-hub/{ReportId:int}"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IAuthState Auth
@inject IReportStudioClient Api
@inject IToastService Toast
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>هاب گزارش‌های سازمان</PageTitle>

@if (!Auth.CanSee("ReportStudio"))
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mt-3 rounded-4 p-3 border border-warning-subtle">
        <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
        <div>شما به بخش هاب گزارش‌ها دسترسی ندارید. برای دریافت دسترسی با مدیر سیستم تماس بگیرید.</div>
    </div>
}
else
{
<div class="fin-page-container fade-in">
    <!-- ================== سربرگ لوکس ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-journal-text"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">هاب مرکزی گزارش‌های سازمانی</h1>
                        <span class="badge rounded-pill fin-badge-indigo">کاتالوگ تحلیلی</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        دسترسی یکپارچه به گزارش‌های اختصاصی، هوشمند و به اشتراک‌گذاشته‌شده در سراسر سازمان
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <a class="btn btn-outline-primary fin-btn-pill" href="report-studio">
                    <i class="bi bi-plus-lg me-1"></i> ایجاد گزارش جدید در استودیو
                </a>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="text-secondary fs-8 mt-2">در حال بارگذاری کاتالوگ گزارش‌ها...</div>
        </div>
    }
    else if (reports.Count == 0)
    {
        <div class="fin-card">
            <div class="fin-card-body text-center py-5">
                <div class="fin-avatar bg-slate-subtle text-slate mx-auto mb-2" style="width:52px;height:52px">
                    <i class="bi bi-inbox fs-3"></i>
                </div>
                <h5 class="fw-800 text-dark">هنوز گزارشی در دسترس شما قرار نگرفته است</h5>
                <p class="text-secondary fs-8 mb-3">گزارش‌هایی که با گزارش‌ساز ایجاد کنید یا سایر همکاران با شما به اشتراک بگذارند در این بخش قرار می‌گیرند.</p>
                <a class="btn btn-primary fin-btn-pill px-4" href="report-studio">
                    <i class="bi bi-tools me-1"></i> ورود به گزارش‌ساز و طراحی گزارش
                </a>
            </div>
        </div>
    }
    else
    {
        <!-- ================== کارت‌های KPI ================== -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-4">
                <div class="fin-kpi-card border-indigo">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-indigo">کل گزارش‌های در دسترس</span>
                            <div class="fin-kpi-value text-indigo num mt-1">@Fa.Digits(reports.Count.ToString())</div>
                            <div class="fin-kpi-unit">قالب گزارش آماده</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                            <i class="bi bi-collection-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5">کاتالوگ فعال</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="fin-kpi-card border-emerald">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-emerald">گزارش‌های طراحی‌شدهٔ من</span>
                            <div class="fin-kpi-value text-emerald num mt-1">@Fa.Digits(reports.Count(r => r.IsMine).ToString())</div>
                            <div class="fin-kpi-unit">گزارش اختصاصی من</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                            <i class="bi bi-person-check-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">مالکیت مستقیم</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-4">
                <div class="fin-kpi-card border-amber">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-amber">گزارش‌های به اشتراک‌گذاشته‌شده</span>
                            <div class="fin-kpi-value text-amber num mt-1">@Fa.Digits(reports.Count(r => !r.IsMine).ToString())</div>
                            <div class="fin-kpi-unit">اشتراکی از سایر همکاران</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                            <i class="bi bi-share-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5">دسترسی سازمانی</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================== نوار فیلتر و تب‌ها ================== -->
        <div class="fin-card mb-4">
            <div class="fin-card-body p-3">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-2 flex-wrap">
                        <button class="btn btn-sm fin-btn-pill @(tab == "all" ? "btn-primary" : "btn-light text-secondary border")" @onclick='() => SetTab("all")'>
                            همه گزارش‌ها <span class="badge bg-white text-dark rounded-pill ms-1">@Fa.Digits(reports.Count.ToString())</span>
                        </button>
                        <button class="btn btn-sm fin-btn-pill @(tab == "mine" ? "btn-primary" : "btn-light text-secondary border")" @onclick='() => SetTab("mine")'>
                            ساختهٔ من <span class="badge bg-white text-dark rounded-pill ms-1">@Fa.Digits(reports.Count(r => r.IsMine).ToString())</span>
                        </button>
                        <button class="btn btn-sm fin-btn-pill @(tab == "shared" ? "btn-primary" : "btn-light text-secondary border")" @onclick='() => SetTab("shared")'>
                            اشتراکی با من <span class="badge bg-white text-dark rounded-pill ms-1">@Fa.Digits(reports.Count(r => !r.IsMine).ToString())</span>
                        </button>
                    </div>

                    <div class="input-group input-group-sm" style="max-width:280px">
                        <span class="input-group-text bg-white border-end-0"><i class="bi bi-search text-muted"></i></span>
                        <input class="form-control border-start-0" placeholder="جست‌وجوی عنوان یا توضیح گزارش…"
                               value="@search" @oninput="e => search = e.Value?.ToString()" />
                    </div>
                </div>
            </div>
        </div>

        <!-- ================== کارت‌های گرید گزارش‌ها ================== -->
        @foreach (var grp in GroupedReports)
        {
            <div class="mb-4">
                <div class="d-flex align-items-center gap-2 mb-2.5">
                    <i class="bi @(string.IsNullOrWhiteSpace(grp.Key) ? "bi-folder" : "bi-folder2-open") text-primary fs-5"></i>
                    <span class="fw-800 text-dark fs-7.5">@(string.IsNullOrWhiteSpace(grp.Key) ? "گزارش‌های عمومی (بدون دسته‌بندی)" : grp.Key)</span>
                    <span class="badge bg-primary-subtle text-primary rounded-pill px-2.5 fs-9 num">@Fa.Digits(grp.Count().ToString()) گزارش</span>
                </div>
                <div class="row g-3">
                    @foreach (var rep in grp)
                    {
                        <div class="col-12 col-md-6 col-xl-4">
                            <div class="fin-card h-100 p-3.5 cursor-pointer transition-all @(rep.Id == openId ? "border-primary shadow-sm bg-indigo-subtle-50" : "hover-elevate")"
                                 style="border-radius:16px; border:1.5px solid @(rep.Id == openId ? "#6366f1" : "#e2e8f0");"
                                 @onclick="() => OpenAsync(rep.Id)">
                                <div class="d-flex gap-3 align-items-start">
                                    <div class="fin-avatar bg-indigo-subtle text-indigo" style="width:44px;height:44px;flex-shrink:0;">
                                        <i class="bi @rep.Icon fs-5"></i>
                                    </div>
                                    <div class="min-w-0 flex-grow-1">
                                        <div class="fw-800 text-dark fs-7.5 text-truncate">@rep.Name</div>
                                        @if (!string.IsNullOrWhiteSpace(rep.Description))
                                        {
                                            <div class="fs-8 text-secondary text-truncate mt-0.5">@rep.Description</div>
                                        }
                                        else
                                        {
                                            <div class="fs-8 text-muted mt-0.5">بدون توضیحات تکمیلی</div>
                                        }
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center gap-2 mt-3 pt-2.5 border-top">
                                    @if (rep.IsMine)
                                    {
                                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5 fs-9">
                                            <i class="bi bi-person-check me-1"></i> ساختهٔ من
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5 fs-9">
                                            <i class="bi bi-share me-1"></i> از @rep.OwnerName
                                        </span>
                                    }
                                    <span class="badge bg-light text-secondary border rounded-pill px-2.5 fs-9">
                                        @AccessFa(rep.MyAccess)
                                    </span>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- ================== پنل اجرای گزارش ================== -->
        @if (openId > 0)
        {
            <div class="fin-card mt-4 shadow-sm" style="border:1.5px solid #cbd5e1; border-radius:18px;">
                <div class="fin-card-header d-flex flex-wrap justify-content-between align-items-center p-3 border-bottom bg-light rounded-top-4">
                    <div class="d-flex align-items-center gap-2">
                        <i class="bi bi-table text-primary fs-5"></i>
                        <span class="fw-800 text-dark fs-6.5">@openName</span>
                        @if (result is { Ok: true })
                        {
                            <span class="badge bg-slate-subtle text-slate rounded-pill px-2.5 num fs-8">
                                @Fa.Digits(result.TotalRows.ToString()) سطر — @Fa.Digits(result.ElapsedMs.ToString()) میلی‌ثانیه
                            </span>
                        }
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap mt-2 mt-md-0">
                        @if (canExport)
                        {
                            <a class="btn btn-outline-success fin-btn-pill btn-sm" href="@Api.ExportUrl(openId)" target="_blank">
                                <i class="bi bi-file-earmark-excel me-1"></i> خروجی اکسل
                            </a>
                        }
                        @if (canEdit)
                        {
                            <a class="btn btn-outline-secondary fin-btn-pill btn-sm" href="report-studio/@openId">
                                <i class="bi bi-pencil me-1"></i> ویرایش در استودیو
                            </a>
                        }
                        <button class="btn btn-primary fin-btn-pill btn-sm px-3" disabled="@running" @onclick="() => RunAsync(openId)">
                            @if (running) { <span class="spinner-border spinner-border-sm me-1"></span> }
                            <i class="bi bi-arrow-clockwise me-1"></i> اجرای مجدد
                        </button>
                    </div>
                </div>
                <div class="fin-card-body p-3">
                    @if (running)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="text-secondary fs-8 mt-2">در حال استخراج رکوردها و محاسبه خروجی...</div>
                        </div>
                    }
                    else if (result is null)
                    {
                        <div class="text-center py-4 text-muted fs-8">
                            جهت مشاهده و دریافت آخرین اطلاعات، دکمه «اجرای مجدد» را انتخاب کنید.
                        </div>
                    }
                    else if (!result.Ok)
                    {
                        <div class="alert alert-danger d-flex align-items-center gap-2 rounded-4 p-3 mb-0">
                            <i class="bi bi-exclamation-octagon fs-4 text-danger"></i>
                            <div>@result.Error</div>
                        </div>
                    }
                    else
                    {
                        @foreach (var w in result.Warnings)
                        {
                            <div class="alert alert-warning d-flex align-items-center gap-2 rounded-4 p-2.5 mb-2.5 fs-8">
                                <i class="bi bi-info-circle text-warning"></i> @w
                            </div>
                        }

                        @if (result.Output == RsOutput.Kpi)
                        {
                            <div class="text-center py-4">
                                <div class="display-4 fw-800 text-primary num">@Fa.Digits((result.KpiValue ?? 0).ToString("N0"))</div>
                                <div class="fs-7 text-secondary mt-1">@result.KpiUnit</div>
                            </div>
                        }
                        else if (result.Output == RsOutput.Chart && result.Series.Count > 0)
                        {
                            <div style="height:360px; position:relative;"><canvas id="@ChartId"></canvas></div>
                        }
                        else if (result.Rows.Count == 0)
                        {
                            <div class="text-center py-4 text-muted fs-8">سطری برای نمایش در خروجی یافت نشد.</div>
                        }
                        else
                        {
                            <div class="table-responsive" style="max-height:500px; overflow:auto;">
                                <table class="table table-hover align-middle mb-0 fin-table">
                                    <thead class="bg-light sticky-top">
                                        <tr>
                                            <th class="text-secondary fs-8 fw-700 py-3 text-center" style="width:48px">#</th>
                                            @foreach (var c in result.Columns)
                                            {
                                                <th class="text-secondary fs-8 fw-700 py-3" style="text-align:@c.Align">@c.Title</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var i = 0; i < result.Rows.Count; i++)
                                        {
                                            var row = result.Rows[i];
                                            <tr>
                                                <td class="text-center num text-secondary fs-8">@Fa.Digits((i + 1).ToString())</td>
                                                @for (var j = 0; j < row.Count; j++)
                                                {
                                                    var al = j < result.Columns.Count ? result.Columns[j].Align : "right";
                                                    <td class="fs-8 text-dark" style="text-align:@al">@row[j]</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>
}


<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
.fin-header {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
}
.fin-header-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 6px 16px -2px rgba(79, 70, 229, 0.35);
    flex-shrink: 0;
}
.fin-badge-status {
    background: #eef2ff;
    color: #4338ca;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-btn-pill {
    border-radius: 20px;
    padding: 0.45rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.2s;
}

/* کارت‌های شاخص KPI لوکس */
.fin-kpi-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
}
.fin-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.08);
}
.fin-kpi-card.border-rose { border-top: 4px solid #ef4444; }
.fin-kpi-card.border-emerald { border-top: 4px solid #10b981; }
.fin-kpi-card.border-indigo { border-top: 4px solid #4f46e5; }
.fin-kpi-card.border-slate { border-top: 4px solid #64748b; }

.fin-kpi-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.fin-kpi-value {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.2;
}
.fin-kpi-unit {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 0.1rem;
}
.fin-kpi-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}
.fin-kpi-footer {
    border-top: 1px dashed #f1f5f9;
}

/* کارت فیلتر */
.fin-filter-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.1rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
}
.fin-label {
    font-size: 0.74rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.35rem;
    display: block;
}
.fin-input {
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    font-size: 0.82rem;
}
.fin-btn-submit {
    border-radius: 10px;
    height: 33px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
}

/* جدول داده‌ها */
.fin-table-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.fin-table-header {
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fbfcfe;
}
.fin-table-header-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
}
.fin-table-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.1rem;
}
.fin-table-sub {
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 0;
}

.fin-table {
    margin-bottom: 0;
    font-size: 0.82rem;
}
.fin-table thead th {
    background: #f8fafc;
    color: #475569;
    font-weight: 700;
    font-size: 0.74rem;
    padding: 0.85rem 0.9rem;
    border-bottom: 1.5px solid #e2e8f0;
    white-space: nowrap;
}
.fin-table tbody td {
    padding: 0.85rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
}
.fin-table-row:hover {
    background: #f8fafc;
}
.fin-table-total-row {
    background: #f8fafc;
    border-top: 2px solid #cbd5e1;
}
.fin-table-total-row td {
    padding: 1rem 0.9rem;
}

.fin-avatar {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #eef2ff;
    color: #4f46e5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
    flex-shrink: 0;
}
.fin-avatar-lg {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.4rem;
    flex-shrink: 0;
}

/* صفحه صورت‌حساب شخص */
.fin-statement-header-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.04);
}
.fin-statement-kpi-badge {
    padding: 0.85rem 1.4rem;
    border-radius: 14px;
    text-align: left;
    min-width: 220px;
}
.fin-statement-kpi-badge.badge-debtor {
    background: #fef2f2;
    border: 1.5px solid #fecaca;
    color: #b91c1c;
}
.fin-statement-kpi-badge.badge-creditor {
    background: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    color: #15803d;
}
.fin-statement-kpi-badge.badge-settled {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #475569;
}
.fin-statement-kpi-sub {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.85;
}
