@code {
    [Parameter] public int? ReportId { get; set; }

    private List<RsReportDto> reports = new();
    private RsResultDto? result;
    private bool loading = true, running;
    private int openId;
    private string openName = "";
    private bool canExport, canEdit;
    private string tab = "all";
    private string? search;

    private readonly string ChartId = "rhChart_" + Guid.NewGuid().ToString("N")[..8];
    private bool chartPending;

    private IEnumerable<RsReportDto> Filtered
    {
        get
        {
            var q = tab switch
            {
                "mine" => reports.Where(r => r.IsMine),
                "shared" => reports.Where(r => !r.IsMine),
                _ => reports.AsEnumerable()
            };
            if (!string.IsNullOrWhiteSpace(search))
            {
                var t = search.Trim();
                q = q.Where(r => r.Name.Contains(t, StringComparison.OrdinalIgnoreCase)
                              || (r.Description ?? "").Contains(t, StringComparison.OrdinalIgnoreCase));
            }
            return q;
        }
    }

    /// <summary>
    /// گزارش‌ها گروه‌بندی‌شده بر اساس پوشه.
    /// پوشه‌ها را خودِ کاربر هنگام ساخت گزارش تعیین می‌کند، بنابراین
    /// تفکیکِ گزارش‌ها دقیقاً مطابقِ نظمِ ذهنیِ اوست.
    /// </summary>
    private List<IGrouping<string, RsReportDto>> GroupedReports =>
        Filtered.GroupBy(r => r.Folder ?? "")
                .OrderBy(g => string.IsNullOrWhiteSpace(g.Key) ? 1 : 0)
                .ThenBy(g => g.Key, StringComparer.Ordinal)
                .ToList();

    protected override async Task OnInitializedAsync()
    {
        if (!Auth.CanSee("ReportStudio")) { loading = false; return; }
        try { reports = await Api.ListAsync() ?? new(); }
        catch (Exception ex) { Toast.Error("بارگذاری گزارش‌ها ناموفق بود: " + ex.Message); }
        loading = false;

        if (ReportId is > 0) await OpenAsync(ReportId.Value);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartPending) return;
        chartPending = false;
        if (result is null || !result.Ok || result.Output != RsOutput.Chart || result.Series.Count == 0) return;

        try
        {
            var type = result.Chart switch
            {
                RsChart.Line => "line",
                RsChart.Pie => "pie",
                RsChart.Doughnut => "doughnut",
                RsChart.Area => "line",
                _ => "bar"
            };
            var datasets = result.Series.Select(x => new { name = x.Name, values = x.Values })
                                        .Cast<object>().ToArray();
            await JS.InvokeVoidAsync("appDash.renderChart", ChartId, type, result.Series[0].Labels, datasets);
        }
        catch { }
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("appDash.destroyChart", ChartId); } catch { }
    }

    private void SetTab(string t) => tab = t;

    private async Task OpenAsync(int id)
    {
        var rep = reports.FirstOrDefault(r => r.Id == id);
        openId = id;
        openName = rep?.Name ?? "گزارش";
        canExport = rep is not null && (rep.IsMine || rep.MyAccess >= RsAccess.Export);
        canEdit = rep?.CanEdit ?? false;
        await RunAsync(id);
    }

    private async Task RunAsync(int id)
    {
        running = true;
        result = null;
        try { result = await Api.RunAsync(id); }
        catch (Exception ex) { result = new RsResultDto { Ok = false, Error = "اجرا ناموفق بود: " + ex.Message }; }
        running = false;
        chartPending = result is { Ok: true, Output: RsOutput.Chart };
    }

    private static string AccessFa(RsAccess a) => a switch
    {
        RsAccess.Edit => "ویرایش",
        RsAccess.Export => "مشاهده + خروجی",
        _ => "فقط مشاهده"
    };
}
