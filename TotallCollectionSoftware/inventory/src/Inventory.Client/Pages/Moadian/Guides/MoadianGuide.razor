@page "/moadian/guide"
@using Inventory.Client.Pages.Office.Guides
@inject NavigationManager Nav

<PageTitle>سامانه مودیان — راهنمای کاربری</PageTitle>

<OfficeGuide
    Title="راهنمای سامانهٔ مودیان"
    Description="از تعریف واحد سنجش، کالا و مشتری تا صدور، ارسال و پیگیری صورتحساب الکترونیکی؛ همراه با توضیح کامل دکمه‌های بخش عملیات."
    Eyebrow="سامانه مودیان / راهنمای کاربری"
    Icon="bi-receipt"
    BackLabel="بازگشت به سامانهٔ مودیان"
    Steps="QuickSteps"
    Sections="GuideSections"
    OnBack="Back">

    <OfficeGuideSection Id="moadian-overview" Index="1" Title="سامانهٔ مودیان در یک نگاه" Kicker="نمای کلی">
        <p>
            کار روزانه در این ماژول سه بخش دارد: تکمیل اطلاعات پایه، صدور صورتحساب و پیگیری نتیجهٔ ارسال در سامانهٔ مالیاتی.
            هر سه بخش به شرکتی که در نوار «شرکت مودیان» بالای صفحه انتخاب شده است وابسته‌اند.
        </p>
        <div class="anatomy-grid">
            <article class="anatomy-card violet">
                <span class="card-icon"><i class="bi bi-archive"></i></span>
                <h3>اطلاعات پایه</h3>
                <p>واحد سنجش، کالا/خدمت و مشتری؛ سه پیش‌نیاز صدور صورتحساب که برای هر خدمات‌دهنده جدا نگه‌داری می‌شوند.</p>
            </article>
            <article class="anatomy-card blue">
                <span class="card-icon"><i class="bi bi-journal-plus"></i></span>
                <h3>صدور صورتحساب</h3>
                <p>سربرگ صورتحساب و ردیف‌های کالا/خدمت را ثبت کنید؛ محاسبات ردیف‌ها و جمع کل خودکار انجام می‌شود.</p>
            </article>
            <article class="anatomy-card green">
                <span class="card-icon"><i class="bi bi-send-check"></i></span>
                <h3>ارسال و پیگیری</h3>
                <p>ارسال به سامانه، استعلام وضعیت، مشاهدهٔ خطاها و صدور اصلاحی، برگشت از فروش یا ابطال.</p>
            </article>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>شرکت فعال را کنترل کنید</strong>
                <span>
                    واحدها، کالاها، مشتریان و صورتحساب‌ها به شرکت انتخاب‌شده در نوار بالای صفحه وابسته‌اند. اگر فهرستی خالی
                    به نظر می‌رسد، پیش از هر کاری شرکت فعال را بررسی کنید؛ برای دیدن داده‌های شرکت دیگر، همان‌جا آن را انتخاب کنید.
                </span>
            </div>
        </div>
        <div class="feature-columns">
            <div>
                <h3><i class="bi bi-signpost-split"></i> مسیرهای اصلی ماژول</h3>
                <p>
                    «نمای کلی» شمارش صورتحساب‌ها در هر وضعیت و میان‌برهای شروع کار را نشان می‌دهد؛ «صورتحساب‌ها» فهرست کامل و
                    محل انجام عملیات است و «اطلاعات پایه» شامل شرکت، واحدهای سنجش، کالاها و مشتریان می‌شود.
                </p>
            </div>
            <div>
                <h3><i class="bi bi-shield-check"></i> نمایش دکمه‌ها</h3>
                <p>
                    بعضی دکمه‌ها به سطح دسترسی کاربر و بعضی دیگر به وضعیت خود صورتحساب وابسته‌اند؛ نبودن یک دکمه همیشه به معنی
                    خطا نیست.
                </p>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-units" Index="2" Title="واحدهای سنجش" Kicker="اطلاعات پایه">
        <p>
            واحد سنجش، مبنای شمارش کالا و خدمت در صورتحساب است. این فهرست مخصوص خدمات‌دهندهٔ انتخاب‌شده است و با تغییر شرکت،
            واحدهای همان شرکت نمایش داده می‌شوند.
        </p>
        <ol class="instruction-list">
            <li>
                <span>۱</span>
                <div>از منوی ماژول، «اطلاعات پایه» و سپس تب «واحدهای سنجش» را باز کنید.</div>
            </li>
            <li>
                <span>۲</span>
                <div>دکمهٔ «واحد جدید» را بزنید و نام واحد را وارد کنید؛ مثلاً عدد، کیلوگرم یا متر.</div>
            </li>
            <li>
                <span>۳</span>
                <div>
                    کد واحد را وارد کنید. این کد باید همان کد رسمی واحد در فهرست واحدهای سنجش سامانهٔ مودیان باشد؛ کد ساختگی
                    باعث رد شدن صورتحساب در سامانه می‌شود.
                </div>
            </li>
            <li>
                <span>۴</span>
                <div>«ثبت واحد» را بزنید. برای تغییر نام یا کد، از آیکن ویرایش همان ردیف استفاده کنید.</div>
            </li>
            <li>
                <span>۵</span>
                <div>برای حذف، آیکن سطل زباله را بزنید و پیام تأیید را قبول کنید.</div>
            </li>
        </ol>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>فیلد</th>
                        <th>راهنمای تکمیل</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>نام واحد</b> <span class="required-badge">الزامی</span></td>
                        <td>عنوانی که در فهرست کالاها و ردیف صورتحساب دیده می‌شود؛ کوتاه و گویا بنویسید.</td>
                    </tr>
                    <tr>
                        <td><b>کد واحد</b> <span class="required-badge">الزامی</span></td>
                        <td>شناسهٔ رسمی واحد در سامانهٔ مالیاتی؛ آن را از فهرست مرجع واحدهای سنجش بردارید.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>جستجو و مرتب‌سازی</strong>
                <span>
                    کادر جستجو، فهرست را بر اساس نام یا کد واحد محدود می‌کند و نتایج در صفحه‌های ده‌تایی نمایش داده می‌شوند.
                    برای دیدن همهٔ واحدها، عبارت جستجو را پاک کنید.
                </span>
            </div>
        </div>
        <div class="guide-note warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>ترتیب کار را رعایت کنید</strong>
                <span>
                    ابتدا واحدها را کامل کنید، سپس کالاها را تعریف کنید. واحدهای یک شرکت در فهرست شرکت دیگر دیده نمی‌شوند؛
                    اگر واحدی که لازم دارید در فهرست نیست، ابتدا شرکت فعال را بررسی و سپس واحد را ثبت کنید.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-goods" Index="3" Title="کالاها و خدمات" Kicker="اطلاعات پایه">
        <p>
            هر کالا یا خدمت با نام، شناسهٔ CPC و یک واحد سنجش تعریف می‌شود و بعد از ثبت، در ردیف‌های صورتحساب قابل انتخاب است.
        </p>
        <ol class="instruction-list">
            <li>
                <span>۱</span>
                <div>تب «کالاها و خدمات» را در اطلاعات پایه باز کنید.</div>
            </li>
            <li>
                <span>۲</span>
                <div>«کالا/خدمت جدید» را بزنید و نام کالا یا خدمت را وارد کنید.</div>
            </li>
            <li>
                <span>۳</span>
                <div>شناسهٔ CPC را در فیلد «شناسهٔ CPC» بنویسید؛ این شناسه مبنای شناسایی کالا/خدمت در سامانه است.</div>
            </li>
            <li>
                <span>۴</span>
                <div>واحد سنجش را از فهرست انتخاب کنید تا در ردیف صورتحساب خودکار پر شود.</div>
            </li>
            <li>
                <span>۵</span>
                <div>
                    نرخ ارزش افزوده و قیمت واحد را وارد کنید؛ این دو مقدار به‌عنوان مقدار پیش‌فرض در صورتحساب استفاده می‌شوند.
                </div>
            </li>
            <li>
                <span>۶</span>
                <div>«ثبت کالا» را بزنید. برای اصلاح هر ردیف، آیکن ویرایش همان ردیف را انتخاب کنید.</div>
            </li>
        </ol>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>فیلد</th>
                        <th>راهنمای تکمیل</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>نام کالا/خدمت</b> <span class="required-badge">الزامی</span></td>
                        <td>همان عنوانی که روی صورتحساب چاپ می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>شناسهٔ CPC</b> <span class="required-badge">الزامی</span></td>
                        <td>شناسهٔ کالا/خدمت مطابق فهرست مرجع؛ آن را دقیق و بدون فاصله اضافه وارد کنید.</td>
                    </tr>
                    <tr>
                        <td><b>واحد سنجش</b> <span class="optional-badge">اختیاری</span></td>
                        <td>از بین واحدهای ثبت‌شدهٔ همان شرکت انتخاب می‌شود و هنگام افزودن ردیف خودکار پر می‌گردد.</td>
                    </tr>
                    <tr>
                        <td><b>نرخ ارزش افزوده</b> <span class="optional-badge">اختیاری</span></td>
                        <td>درصدی بین ۰ تا ۱۰۰؛ مقدار پیش‌فرض ردیف صورتحساب است و در خود صورتحساب قابل تغییر است.</td>
                    </tr>
                    <tr>
                        <td><b>قیمت واحد</b> <span class="optional-badge">اختیاری</span></td>
                        <td>فی پیش‌فرض کالا/خدمت؛ در صورتحساب قابل ویرایش است.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>جستجو در نام یا شناسه</strong>
                <span>
                    با تایپ در کادر جستجو، فهرست بر اساس نام یا شناسهٔ CPC محدود می‌شود. تعداد کل کالاها در سربرگ کارت و
                    نتیجهٔ صفحه‌بندی در پایین فهرست دیده می‌شود.
                </span>
            </div>
        </div>
        <div class="guide-note warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>قیمت و نرخ، فقط پیش‌فرض‌اند</strong>
                <span>
                    تغییر قیمت یا نرخ ارزش افزوده در یک صورتحساب، مقدار ثبت‌شدهٔ کالا را تغییر نمی‌دهد؛ برای تغییر دائمی،
                    خود کالا/خدمت را ویرایش کنید.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-customers" Index="4" Title="مشتریان" Kicker="اطلاعات پایه">
        <p>
            مشتریان، طرف‌حساب صورتحساب‌های «نوع اول» هستند. نوع مشتری تعیین می‌کند کدام شناسه از شما خواسته شود؛ برای شخص
            حقیقی «کد ملی» و برای شخص حقوقی «شماره ثبت شرکت».
        </p>
        <div class="split-steps">
            <article>
                <span class="mini-label">حقیقی</span>
                <h3><i class="bi bi-person"></i> مشتری شخص حقیقی</h3>
                <ol>
                    <li>نام و نام خانوادگی را وارد کنید.</li>
                    <li>نوع را روی «حقیقی» بگذارید.</li>
                    <li>کد ملی، شماره اقتصادی، پست‌کد و تلفن را تکمیل کنید.</li>
                    <li>نشانی کامل را برای درج روی صورتحساب بنویسید.</li>
                </ol>
            </article>
            <article>
                <span class="mini-label">حقوقی</span>
                <h3><i class="bi bi-building"></i> مشتری شخص حقوقی</h3>
                <ol>
                    <li>نام شرکت را وارد کنید.</li>
                    <li>نوع را روی «حقوقی» بگذارید.</li>
                    <li>شماره ثبت شرکت، شماره اقتصادی، پست‌کد و تلفن را تکمیل کنید.</li>
                    <li>نشانی رسمی شرکت را برای درج روی صورتحساب بنویسید.</li>
                </ol>
            </article>
        </div>
        <ol class="instruction-list">
            <li>
                <span>۱</span>
                <div>تب «اطلاعات مشتریان» را باز کنید و «مشتری جدید» را بزنید.</div>
            </li>
            <li>
                <span>۲</span>
                <div>نام مشتری را وارد و نوع او را انتخاب کنید؛ برچسب فیلد شناسه با تغییر نوع عوض می‌شود.</div>
            </li>
            <li>
                <span>۳</span>
                <div>شناسه، شماره اقتصادی، پست‌کد، تلفن و نشانی را تکمیل کنید.</div>
            </li>
            <li>
                <span>۴</span>
                <div>«ثبت مشتری» را بزنید. برای ویرایش، آیکن مداد همان ردیف را انتخاب کنید.</div>
            </li>
        </ol>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>فیلد</th>
                        <th>راهنمای تکمیل</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>نام مشتری</b> <span class="required-badge">الزامی</span></td>
                        <td>نام فرد یا شرکت؛ در فهرست و روی صورتحساب نمایش داده می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>نوع</b></td>
                        <td>«حقیقی» یا «حقوقی»؛ فقط برچسب و نوع شناسهٔ درخواستی را تغییر می‌دهد.</td>
                    </tr>
                    <tr>
                        <td><b>کد ملی / شماره ثبت شرکت</b></td>
                        <td>برای شخص حقیقی کد ملی و برای شخص حقوقی شماره ثبت شرکت را وارد کنید.</td>
                    </tr>
                    <tr>
                        <td><b>شماره اقتصادی</b></td>
                        <td>شناسهٔ اقتصادی مشتری؛ در صورتحساب و نسخهٔ چاپی استفاده می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>پست‌کد و تلفن</b></td>
                        <td>برای تکمیل اطلاعات خریدار و ارتباط سریع‌تر؛ تلفن با ارقام لاتین وارد می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>نشانی</b></td>
                        <td>نشانی کامل خریدار برای درج روی صورتحساب الکترونیکی.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>جستجوی مشتری</strong>
                <span>
                    جستجوی این فهرست روی نام، کد ملی/شماره ثبت، شماره اقتصادی و تلفن انجام می‌شود و کل فهرست مشتریان شرکت فعال
                    را پوشش می‌دهد؛ به همین دلیل فهرست در یک صفحه نمایش داده می‌شود و صفحه‌بندی ندارد.
                </span>
            </div>
        </div>
        <div class="guide-note warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>مشتری باید از قبل ثبت شده باشد</strong>
                <span>
                    در صورتحساب «نوع اول»، انتخاب مشتری الزامی است. اگر در فرم صورتحساب فهرست مشتریان خالی بود، از همان‌جا
                    («ثبت مشتری») یا از این تب مشتری را اضافه کنید و سپس صورتحساب را کامل کنید.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-invoice-new" Index="5" Title="صدور صورتحساب" Kicker="ثبت صورتحساب">
        <p>
            برای صدور، از منوی ماژول «صورتحساب جدید» را انتخاب کنید یا دکمهٔ «صورتحساب جدید» را در نمای کلی و فهرست
            صورتحساب‌ها بزنید. فرم صدور از دو کارت تشکیل شده است: سربرگ صورتحساب و ردیف‌های کالا/خدمت.
        </p>
        <ol class="instruction-list">
            <li>
                <span>۱</span>
                <div>تاریخ فاکتور را انتخاب کنید؛ شمارهٔ فاکتور به‌صورت خودکار پیش‌نمایش داده می‌شود.</div>
            </li>
            <li>
                <span>۲</span>
                <div>مشتری را از فهرست انتخاب کنید. این فیلد فقط برای صورتحساب «نوع اول» نمایش داده می‌شود.</div>
            </li>
            <li>
                <span>۳</span>
                <div>سال مالی، نوع پرداخت و نوع صورتحساب را مشخص کنید و در صورت نیاز توضیحات را بنویسید.</div>
            </li>
            <li>
                <span>۴</span>
                <div>
                    با «افزودن ردیف» یک سطر اضافه کنید، کالا/خدمت را انتخاب کنید؛ واحد، فی و نرخ ارزش افزوده خودکار پر می‌شوند.
                </div>
            </li>
            <li>
                <span>۵</span>
                <div>تعداد، فی، تخفیف و در صورت نیاز نرخ ارزش افزودهٔ ردیف را اصلاح کنید؛ جمع‌ها خودکار محاسبه می‌شوند.</div>
            </li>
            <li>
                <span>۶</span>
                <div>
                    در پایان «ثبت صورتحساب» را بزنید؛ پس از ثبت، صفحهٔ جزئیات همان صورتحساب باز می‌شود و رکورد با وضعیت
                    «ارسال نشده» ذخیره می‌گردد.
                </div>
            </li>
        </ol>
        <div class="subsection">
            <h3><i class="bi bi-card-heading"></i> فیلدهای سربرگ صورتحساب</h3>
        </div>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>فیلد</th>
                        <th>راهنمای تکمیل</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>شمارهٔ فاکتور</b></td>
                        <td>خودکار و غیرقابل ویرایش؛ شمارهٔ بعدی همان شرکت را پیش‌نمایش می‌دهد.</td>
                    </tr>
                    <tr>
                        <td><b>موضوع</b></td>
                        <td>برای صورتحساب جدید «اصلی» و در مسیر اصلاحی «اصلاحی» است.</td>
                    </tr>
                    <tr>
                        <td><b>تاریخ فاکتور</b> <span class="required-badge">الزامی</span></td>
                        <td>تاریخ صدور صورتحساب؛ در فهرست و نسخهٔ چاپی همان تاریخ نمایش داده می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>مشتری</b> <span class="required-badge">الزامی</span></td>
                        <td>برای «نوع اول» الزامی است؛ برای «نوع دوم» و «نوع سوم» این فیلد حذف می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>سال مالی</b> <span class="required-badge">الزامی</span></td>
                        <td>سال مالی مرتبط با صورتحساب را از فهرست انتخاب کنید.</td>
                    </tr>
                    <tr>
                        <td><b>نوع پرداخت</b></td>
                        <td>«نقدی» یا «نسیه»؛ برای نوع دوم و سوم فقط نقدی مجاز است.</td>
                    </tr>
                    <tr>
                        <td><b>نوع صورتحساب</b></td>
                        <td>نوع اول (با اطلاعات خریدار)، نوع دوم و نوع سوم (بدون اطلاعات خریدار).</td>
                    </tr>
                    <tr>
                        <td><b>توضیحات</b></td>
                        <td>اختیاری؛ روی صورتحساب و نسخهٔ چاپی دیده می‌شود.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="subsection">
            <h3><i class="bi bi-list-ol"></i> ردیف‌های کالا/خدمت</h3>
            <p>
                هر ردیف یک کالا یا خدمت را با تعداد، فی، تخفیف و ارزش افزودهٔ مستقل نگه می‌دارد. واحد سنجش از تعریف کالا
                می‌آید و در ستون «واحد» نمایش داده می‌شود.
            </p>
        </div>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>ستون</th>
                        <th>توضیح</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>نام کالا/خدمت</b></td>
                        <td>از فهرست کالاهای همان شرکت انتخاب می‌شود؛ اگر فهرست خالی باشد، نام کالا دستی وارد می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>واحد</b></td>
                        <td>از تعریف کالا خوانده می‌شود و قابل ویرایش نیست.</td>
                    </tr>
                    <tr>
                        <td><b>تعداد و فی کالا</b></td>
                        <td>حاصل‌ضرب این دو، «مبلغ قبل تخفیف» ردیف است.</td>
                    </tr>
                    <tr>
                        <td><b>تخفیف</b></td>
                        <td>از مبلغ قبل تخفیف کم می‌شود؛ اگر نتیجه منفی شود، صفر در نظر گرفته می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>ارزش افزوده</b></td>
                        <td>درصد ردیف روی «مبلغ بعد تخفیف» اعمال و مبلغ ارزش افزوده محاسبه می‌شود.</td>
                    </tr>
                    <tr>
                        <td><b>مبلغ کل ردیف</b></td>
                        <td>مبلغ بعد تخفیف به‌همراه ارزش افزودهٔ همان ردیف.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>جمع‌های پایین فرم</strong>
                <span>
                    مبلغ قبل تخفیف، تخفیف، مبلغ بعد تخفیف، ارزش افزوده، مبلغ کل صورتحساب و تعداد ردیف‌ها به‌صورت زنده
                    به‌روزرسانی می‌شوند؛ قبل از ثبت، یک بار آن‌ها را با اقلام واقعی مقایسه کنید.
                </span>
            </div>
        </div>
        <div class="guide-note warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>ثبت، به معنی ارسال نیست</strong>
                <span>
                    صورتحساب پس از ثبت با وضعیت «ارسال نشده» در فهرست می‌ماند و تا زمانی که از فهرست یا صفحهٔ جزئیات ارسال
                    نشود، در سامانهٔ مالیاتی ثبت نمی‌گردد. ثبت بدون ردیف کالا هم انجام نمی‌شود؛ در هر ردیف باید کالا/خدمت
                    انتخاب شده باشد.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-invoices" Index="6" Title="فهرست صورتحساب‌ها و وضعیت‌ها" Kicker="پیگیری">
        <p>
            فهرست صورتحساب‌ها با تب‌های وضعیت، جستجو و بازهٔ تاریخ فیلتر می‌شود. هر تب تعداد صورتحساب‌های همان وضعیت را در
            کنار عنوان نشان می‌دهد.
        </p>
        <div class="chip-row">
            <span><i class="bi bi-collection"></i> همه</span>
            <span><i class="bi bi-inbox"></i> ارسال نشده</span>
            <span><i class="bi bi-arrow-repeat"></i> در انتظار استعلام</span>
            <span><i class="bi bi-search"></i> در انتظار بررسی</span>
            <span><i class="bi bi-send-check"></i> ارسال شده</span>
            <span><i class="bi bi-hourglass-split"></i> در انتظار واکنش</span>
            <span><i class="bi bi-exclamation-triangle"></i> دارای خطا</span>
            <span><i class="bi bi-archive"></i> بدون نیاز به واکنش</span>
        </div>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>وضعیت</th>
                        <th>معنی</th>
                        <th>اقدام پیشنهادی</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><span class="mi-status mi-s0"><span class="mi-dot"></span>ارسال نشده</span></td>
                        <td>ثبت شده اما هنوز به سامانه ارسال نشده است.</td>
                        <td>ارسال به سامانه</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s1"><span class="mi-dot"></span>ارسال شده در انتظار استعلام</span></td>
                        <td>ارسال شده و منتظر نخستین استعلام وضعیت است (تب «در انتظار استعلام»).</td>
                        <td>استعلام وضعیت</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s2"><span class="mi-dot"></span>در انتظار بررسی کارپوشه</span></td>
                        <td>صورتحساب در کارپوشه در حال بررسی است (تب «در انتظار بررسی»).</td>
                        <td>استعلام در فاصله‌های بعدی</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s3"><span class="mi-dot"></span>ارسال شده</span></td>
                        <td>ارسال و ثبت شده است.</td>
                        <td>چاپ، مشاهده در کارپوشه یا اقدام بعدی</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s4"><span class="mi-dot"></span>ارسال شده در انتظار واکنش</span></td>
                        <td>ثبت شده و منتظر واکنش خریدار است (تب «در انتظار واکنش»).</td>
                        <td>استعلام وضعیت</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s5"><span class="mi-dot"></span>دارای خطا</span></td>
                        <td>سامانهٔ مالیاتی صورتحساب را نپذیرفته است.</td>
                        <td>مشاهدهٔ خطاها، اصلاح و ارسال مجدد</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s6"><span class="mi-dot"></span>بدون نیاز به واکنش</span></td>
                        <td>رسیدگی به این صورتحساب تمام شده است.</td>
                        <td>مشاهدهٔ جزئیات یا چاپ</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s7"><span class="mi-dot"></span>تأیید شده</span></td>
                        <td>خریدار صورتحساب را تأیید کرده است.</td>
                        <td>مشاهده در کارپوشه یا چاپ</td>
                    </tr>
                    <tr>
                        <td><span class="mi-status mi-s8"><span class="mi-dot"></span>رد شده</span></td>
                        <td>خریدار صورتحساب را رد کرده است.</td>
                        <td>بررسی علت و صدور اصلاحی یا ابطال</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>تب «تأیید شده» و «رد شده» وجود ندارد</strong>
                <span>
                    این دو وضعیت در نوار تب‌ها فیلتر جداگانه ندارند؛ صورتحساب‌های آن‌ها در تب «همه» دیده می‌شوند و با جستجو
                    هم پیدا می‌شوند. وضعیت هر ردیف در ستون «وضعیت» به‌صورت رنگی نمایش داده می‌شود.
                </span>
            </div>
        </div>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>ابزار فهرست</th>
                        <th>کاربرد</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>جستجو</b></td>
                        <td>موضوع، شمارهٔ صورتحساب، شمارهٔ مالیاتی، نام مشتری و وضعیت را جستجو می‌کند.</td>
                    </tr>
                    <tr>
                        <td><b>از تاریخ / تا تاریخ</b></td>
                        <td>فهرست را به بازهٔ تاریخ صدور محدود می‌کند؛ برای جلوگیری از خطا، هر دو تاریخ را کامل کنید یا هر دو را خالی بگذارید.</td>
                    </tr>
                    <tr>
                        <td><b>حذف فیلترها</b></td>
                        <td>جستجو و بازهٔ تاریخ را پاک می‌کند و فهرست را به حالت اولیه برمی‌گرداند.</td>
                    </tr>
                    <tr>
                        <td><b>صفحه‌بندی</b></td>
                        <td>تعداد موارد نمایش‌داده‌شده و صفحهٔ جاری را نشان می‌دهد و بین صفحه‌ها جابه‌جا می‌شود.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>وضعیت، خودبه‌خود به‌روز نمی‌شود</strong>
                <span>
                    تغییر وضعیت در سامانهٔ مالیاتی به‌صورت لحظه‌ای به این فهرست نمی‌رسد؛ برای دیدن وضعیت تازه، از دکمهٔ
                    «استعلام» همان صورتحساب استفاده کنید.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-operations" Index="7" Title="عملیات هر صورتحساب" Kicker="ستون عملیات">
        <p>
            در انتهای هر ردیف فهرست، مجموعه‌ای از دکمه‌های آیکونی قرار دارد. هر دکمه فقط وقتی معنی دارد که وضعیت صورتحساب و
            سطح دسترسی کاربر اجازه دهد؛ با نگه‌داشتن نشانگر روی هر آیکن، عنوان آن نمایش داده می‌شود.
        </p>
        <div class="action-grid">
            <article>
                <i class="bi bi-eye"></i>
                <h3>جزئیات</h3>
                <p>صفحهٔ کامل صورتحساب را با ردیف‌ها، اطلاعات مشتری و اطلاعات مالیاتی باز می‌کند.</p>
            </article>
            <article>
                <i class="bi bi-pencil"></i>
                <h3>ویرایش</h3>
                <p>فقط برای «ارسال نشده» و «دارای خطا»؛ پس از ارسال موفق، ویرایش بسته می‌شود.</p>
            </article>
            <article>
                <i class="bi bi-copy"></i>
                <h3>کپی</h3>
                <p>یک صورتحساب جدید با همان ردیف‌ها می‌سازد؛ شماره، وضعیت و شمارهٔ مالیاتی قبلی منتقل نمی‌شود.</p>
            </article>
            <article>
                <i class="bi bi-printer"></i>
                <h3>چاپ</h3>
                <p>نسخهٔ رسمی صورتحساب را در قالب A4 افقی باز و پنجرهٔ چاپ را نمایش می‌دهد.</p>
            </article>
            <article>
                <i class="bi bi-send"></i>
                <h3>ارسال / ارسال مجدد</h3>
                <p>صورتحساب را به سامانه می‌فرستد؛ پس از رفع خطا نیز از همین دکمه برای ارسال مجدد استفاده کنید.</p>
            </article>
            <article>
                <i class="bi bi-arrow-repeat"></i>
                <h3>استعلام</h3>
                <p>آخرین وضعیت صورتحساب را از سامانه می‌خواند و برچسب وضعیت را به‌روز می‌کند.</p>
            </article>
            <article>
                <i class="bi bi-bug"></i>
                <h3>مشاهدهٔ خطاها</h3>
                <p>برای صورتحساب «دارای خطا» فهرست خطاهای برگشتی سامانه را نشان می‌دهد.</p>
            </article>
            <article>
                <i class="bi bi-folder2-open"></i>
                <h3>مشاهده در کارپوشه</h3>
                <p>صورتحساب ثبت‌شده را در کارپوشهٔ سامانهٔ مالیاتی، در پنجرهٔ جدید باز می‌کند.</p>
            </article>
            <article>
                <i class="bi bi-trash"></i>
                <h3>حذف</h3>
                <p>فقط برای صورتحساب ارسال‌نشده؛ بعد از ارسال، حذف قانوناً ممکن نیست.</p>
            </article>
        </div>
        <div class="subsection">
            <h3><i class="bi bi-diagram-3"></i> سه عملیات مبتنی بر صورتحساب مرجع</h3>
            <p>
                این عملیات روی صورتحساب‌هایی فعال می‌شوند که در کارپوشه ثبت شده و شمارهٔ مرجع دارند. هر سه از دکمه‌های
                اختصاصی ردیف یا صفحهٔ جزئیات انجام می‌شوند.
            </p>
        </div>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr>
                        <th>عملیات</th>
                        <th>چه اتفاقی می‌افتد</th>
                        <th>شرط انجام</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td><b>اصلاحی</b></td>
                        <td>
                            فرم صورتحساب جدید با موضوع «اصلاحی» و بر پایهٔ صورتحساب مرجع باز می‌شود؛ بعد از ثبت، باید مانند
                            هر صورتحساب دیگری ارسال شود.
                        </td>
                        <td>صورتحساب مرجع در کارپوشه ثبت شده باشد.</td>
                    </tr>
                    <tr>
                        <td><b>برگشت از فروش</b></td>
                        <td>
                            صورتحساب «برگشت از فروش» بر پایهٔ صورتحساب اصلی ساخته و بلافاصله به سامانه ارسال می‌شود؛ پیش از
                            ادامه، پیام تأیید نمایش داده می‌شود.
                        </td>
                        <td>وجود شمارهٔ مرجع و دسترسی ارسال.</td>
                    </tr>
                    <tr>
                        <td><b>ابطال</b></td>
                        <td>ابطال صورتحساب در سامانهٔ مالیاتی ثبت می‌شود و صورتحساب از چرخهٔ عادی خارج می‌گردد.</td>
                        <td>صورتحساب در سامانه ثبت شده و قبلاً باطل نشده باشد.</td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note warning">
            <i class="bi bi-exclamation-triangle-fill"></i>
            <div>
                <strong>از ارسال دوباره پیش از استعلام خودداری کنید</strong>
                <span>
                    اگر مطمئن نیستید صورتحساب ارسال شده است یا نه، ابتدا «استعلام» را بزنید. ارسال دوبارهٔ صورتحسابی که در
                    سامانه ثبت شده می‌تواند به ثبت تکراری یا خطای سامانه منجر شود.
                </span>
            </div>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>نتیجهٔ هر عملیات کجا دیده می‌شود؟</strong>
                <span>
                    پیام موفقیت یا خطا به‌صورت اعلان کوتاه نمایش داده می‌شود و نتیجهٔ تفصیلی ارسال یا استعلام در صفحهٔ
                    جزئیات همان صورتحساب باقی می‌ماند.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-detail" Index="8" Title="صفحهٔ جزئیات صورتحساب" Kicker="بررسی کامل">
        <p>
            با انتخاب «جزئیات»، تصویر کامل صورتحساب باز می‌شود. این صفحه هم برای بررسی و هم برای انجام عملیات روی همان
            صورتحساب طراحی شده است.
        </p>
        <div class="folder-list">
            <div class="folder-row">
                <span class="folder-icon inbox"><i class="bi bi-table"></i></span>
                <div>
                    <h3>ردیف‌های کالا و خدمات</h3>
                    <p>ستون‌های تعداد، فی، تخفیف، ارزش افزوده و مبلغ کل هر ردیف، همراه با جمع‌های پایانی صورتحساب.</p>
                </div>
            </div>
            <div class="folder-row">
                <span class="folder-icon sent"><i class="bi bi-person-vcard"></i></span>
                <div>
                    <h3>اطلاعات مشتری</h3>
                    <p>نام، نوع، کد ملی یا شماره ثبت، شماره اقتصادی، تلفن، پست‌کد و نشانی خریدار به‌صورت کامل نمایش داده می‌شود.</p>
                </div>
            </div>
            <div class="folder-row">
                <span class="folder-icon archive"><i class="bi bi-info-circle"></i></span>
                <div>
                    <h3>اطلاعات صورتحساب</h3>
                    <p>نوع صورتحساب، نوع پرداخت، شرح و در صورت وجود، شمارهٔ مرجع ثبت‌شده در سامانه.</p>
                </div>
            </div>
            <div class="folder-row">
                <span class="folder-icon starred"><i class="bi bi-clipboard-check"></i></span>
                <div>
                    <h3>نتیجهٔ عملیات</h3>
                    <p>پس از ارسال، استعلام یا مشاهدهٔ خطا، نتیجهٔ همان درخواست در بالای صفحه باقی می‌ماند.</p>
                </div>
            </div>
        </div>
        <div class="subsection">
            <h3><i class="bi bi-toggles"></i> نوار عملیات صفحهٔ جزئیات</h3>
            <p>
                دکمه‌های ارسال، استعلام، مشاهدهٔ خطاها، کارپوشه، اصلاحی، ابطال و حذف در همین صفحه هم تکرار شده‌اند و هر کدام
                همان قواعد فهرست را دارند. دکمهٔ «فهرست» به فهرست صورتحساب‌ها برمی‌گردد.
            </p>
        </div>
        <div class="guide-note info">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>پیش‌نمایش JSON</strong>
                <span>
                    برای صورتحساب ارسال‌نشده و فقط برای کاربران دارای دسترسی مربوط، دکمهٔ «پیش‌نمایش JSON» وجود دارد. این
                    پیش‌نمایش برای کنترل فنی ساختار داده است و در کار روزانه لازم نیست.
                </span>
            </div>
        </div>
        <div class="guide-note success">
            <i class="bi bi-check2-circle"></i>
            <div>
                <strong>چاپ رسمی</strong>
                <span>
                    دکمهٔ «چاپ» قالب رسمی صورتحساب را در اندازهٔ A4 افقی نمایش می‌دهد؛ دکمه‌های عملیات در نسخهٔ چاپی دیده
                    نمی‌شوند. برای چاپ مستقیم از روی فهرست، آیکن چاپ همان ردیف را بزنید.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="moadian-faq" Index="9" Title="پرسش‌های متداول" Kicker="رفع ابهام">
        <div class="faq-list">
            <details open>
                <summary>
                    چرا دکمهٔ «ارسال» را نمی‌بینم؟
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <p>
                    ارسال فقط برای صورتحساب «ارسال نشده» و «دارای خطا» فعال است. اگر صورتحساب قبلاً ارسال شده باشد، ابتدا
                    «استعلام» بزنید. نبودن دکمه می‌تواند به سطح دسترسی شما هم مربوط باشد؛ در این صورت با مدیر سیستم تماس بگیرید.
                </p>
            </details>
            <details>
                <summary>
                    چرا نمی‌توانم صورتحساب را ویرایش کنم؟
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <p>
                    ویرایش تنها برای صورتحساب ارسال‌نشده و دارای خطا مجاز است. بعد از ارسال موفق، برای تغییر اطلاعات باید
                    صورتحساب «اصلاحی» صادر کنید یا در صورت نیاز آن را «ابطال» کنید.
                </p>
            </details>
            <details>
                <summary>
                    چرا کالا یا مشتری در فرم صورتحساب نیست؟
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <p>
                    فهرست‌ها به شرکت انتخاب‌شده در نوار بالای صفحه وابسته‌اند. ابتدا شرکت فعال را کنترل کنید؛ اگر موردی ثبت نشده
                    است، از «اطلاعات پایه» کالا یا مشتری را اضافه کنید و سپس فرم صورتحساب را دوباره باز کنید.
                </p>
            </details>
            <details>
                <summary>
                    ثبت صورتحساب به معنی ارسال آن است؟
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <p>
                    خیر. ثبت، صورتحساب را با وضعیت «ارسال نشده» ذخیره می‌کند. ارسال به سامانه یک مرحلهٔ جداگانه است که از فهرست
                    یا صفحهٔ جزئیات انجام می‌شود.
                </p>
            </details>
            <details>
                <summary>
                    تفاوت اصلاحی، برگشت از فروش و ابطال چیست؟
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <p>
                    «اصلاحی» یک صورتحساب جدید با موضوع اصلاحی می‌سازد و باید ارسال شود؛ «برگشت از فروش» صورتحساب برگشتی را
                    می‌سازد و بلافاصله ارسال می‌کند و «ابطال» صورتحساب مرجع را در سامانه باطل می‌کند. انتخاب هر کدام به نوع
                    تغییری بستگی دارد که می‌خواهید ثبت کنید.
                </p>
            </details>
            <details>
                <summary>
                    تنظیم اتصال به سامانه در کدام بخش است؟
                    <i class="bi bi-chevron-down"></i>
                </summary>
                <p>
                    تنظیمات اتصال در «اطلاعات پایه ← اطلاعات اتصال» قرار دارد. این راهنما فقط چرخهٔ کاری صدور، ارسال و پیگیری
                    صورتحساب را توضیح می‌دهد و وارد جزئیات اتصال نشده است.
                </p>
            </details>
        </div>
    </OfficeGuideSection>
</OfficeGuide>

