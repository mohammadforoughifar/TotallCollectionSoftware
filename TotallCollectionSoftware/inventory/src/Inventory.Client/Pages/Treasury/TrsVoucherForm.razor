@code {
    [Parameter] public string? KindParam { get; set; }
    [Parameter] public int Id { get; set; }
    [Parameter] public int InvoiceId { get; set; }

    private TrsVoucher doc = new();
    private List<TrsAccount> accounts = new();
    private List<LookupItem> parties = new();
    private List<TrsSettlementInvoice> openInvoices = new();

    private int selectedInvoiceId;
    private string allocationAmountText = "";
    private string amountText = "", feeText = "";
    private bool loading = true, saving;

    // تعریف سریع بانک/حساب
    private bool showQuickBank;
    private TreasuryAccountKind quickBankDefaultKind = TreasuryAccountKind.Bank;
    private TrsVoucherLine? activeQuickBankLine;
    private bool? activeQuickBankForFromAccount;

    private void OpenQuickBankGeneral(TreasuryAccountKind kind = TreasuryAccountKind.Bank)
    {
        activeQuickBankLine = null;
        activeQuickBankForFromAccount = null;
        quickBankDefaultKind = kind;
        showQuickBank = true;
    }

    private void OpenQuickBankForLine(TrsVoucherLine line, TreasuryAccountKind? kind = null)
    {
        activeQuickBankLine = line;
        activeQuickBankForFromAccount = null;
        quickBankDefaultKind = kind ?? (line.Method switch
        {
            PayMethod.Cash => TreasuryAccountKind.Cash,
            PayMethod.Card => TreasuryAccountKind.Pos,
            _ => TreasuryAccountKind.Bank
        });
        showQuickBank = true;
    }

    private void OpenQuickBankForChequeReceipt(TrsVoucherLine line)
    {
        activeQuickBankLine = line;
        activeQuickBankForFromAccount = null;
        quickBankDefaultKind = TreasuryAccountKind.Bank;
        showQuickBank = true;
    }

    private void OpenQuickBankForTransfer(bool isFrom)
    {
        activeQuickBankLine = null;
        activeQuickBankForFromAccount = isFrom;
        quickBankDefaultKind = TreasuryAccountKind.Bank;
        showQuickBank = true;
    }

    private async Task OnQuickBankCreated(TrsAccount newAcc)
    {
        accounts = await AccountSvc.GetAllAsync(true, true);

        if (activeQuickBankForFromAccount == true)
        {
            doc.FromAccountId = newAcc.Id;
            doc.FromAccountName = newAcc.Name;
        }
        else if (activeQuickBankForFromAccount == false)
        {
            doc.ToAccountId = newAcc.Id;
            doc.ToAccountName = newAcc.Name;
        }
        else if (activeQuickBankLine != null)
        {
            activeQuickBankLine.TrsAccountId = newAcc.Id;
            activeQuickBankLine.TrsAccountName = newAcc.DisplayName;
            if (activeQuickBankLine.Method == PayMethod.Cheque)
            {
                activeQuickBankLine.ChequeBankName = newAcc.BankName ?? newAcc.Name;
            }
        }
        StateHasChanged();
    }

    private bool IsLocked => doc.Status != TreasuryStatus.Draft;

    private decimal Total => doc.Lines.Sum(l => l.Amount);
    private decimal InvoiceAllocatedTotal => doc.InvoiceAllocations.Sum(a => a.Amount);
    private decimal UnallocatedAmount => Math.Max(0, Total - InvoiceAllocatedTotal);
    private List<TrsSettlementInvoice> AvailableInvoices => openInvoices
        .Where(i => !doc.InvoiceAllocations.Any(a => a.InvoiceId == i.InvoiceId)).ToList();
    private bool CanAddInvoiceAllocation => !IsLocked && selectedInvoiceId > 0
        && Fa.ParseDecimal(allocationAmountText) > 0;

    private string StatusBadge => doc.Status switch
    {
        TreasuryStatus.Draft => "badge-soft-muted",
        TreasuryStatus.Confirmed => "badge-soft-success",
        _ => "badge-soft-danger"
    };

    private string Hint => doc.Kind switch
    {
        TreasuryKind.Receipt => "دریافت نقد، کارتخوان، حواله یا چک از مشتری",
        TreasuryKind.Payment => "پرداخت نقد، حواله یا صدور چک برای تأمین‌کننده",
        _ => "جابه‌جایی وجه بین صندوق‌ها و حساب‌های بانکی"
    };

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            accounts = await AccountSvc.GetAllAsync(true, true);

            var customers = await PartySvc.GetLookupsAsync(PartyType.Customer, true);
            var suppliers = await PartySvc.GetLookupsAsync(PartyType.Supplier, true);
            parties = customers.Concat(suppliers)
                .GroupBy(p => p.Id).Select(g => g.First())
                .OrderBy(p => p.Name).ToList();

            if (Id > 0)
            {
                doc = await VoucherSvc.GetAsync(Id);
            }
            else if (InvoiceId > 0)
            {
                doc = await VoucherSvc.NewSettlementAsync(InvoiceId);
            }
            else
            {
                var kind = Enum.TryParse<TreasuryKind>(KindParam, true, out var k) ? k : TreasuryKind.Receipt;
                doc = await VoucherSvc.NewAsync(kind);
            }

            doc.InvoiceAllocations ??= new();
            amountText = doc.TotalAmount == 0 ? "" : doc.TotalAmount.ToString("0.##");
            feeText = doc.FeeAmount == 0 ? "" : doc.FeeAmount.ToString("0.##");
            await LoadOpenInvoicesAsync();

            Layout.SetTitle(doc.KindTitle);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    // ---------- سربرگ ----------

    private void OnDate(DateTime? d) => doc.Date = d ?? DateTime.Now;

    private async Task OnParty(int id)
    {
        var nextPartyId = id > 0 ? id : (int?)null;
        if (doc.PartyId != nextPartyId && doc.InvoiceAllocations.Count > 0)
        {
            if (!await JS.InvokeAsync<bool>("confirm",
                "با تغییر طرف حساب، تخصیص‌های فاکتور فعلی پاک می‌شوند. ادامه می‌دهید؟")) return;
            doc.InvoiceAllocations.Clear();
            doc.InvoiceId = null;
            doc.InvoiceNumber = null;
        }

        doc.PartyId = nextPartyId;
        doc.PartyName = parties.FirstOrDefault(p => p.Id == id)?.Name;
        selectedInvoiceId = 0;
        allocationAmountText = "";
        await LoadOpenInvoicesAsync();
    }

    private async Task LoadOpenInvoicesAsync()
    {
        openInvoices = new();
        if (doc.PartyId is not > 0 || doc.Kind == TreasuryKind.Transfer || IsLocked) return;
        try
        {
            openInvoices = await VoucherSvc.GetOpenInvoicesAsync(doc.PartyId.Value, doc.Kind);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private void OnCandidateInvoice(ChangeEventArgs e)
    {
        selectedInvoiceId = int.TryParse(e.Value?.ToString(), out var id) ? id : 0;
        var invoice = openInvoices.FirstOrDefault(i => i.InvoiceId == selectedInvoiceId);
        if (invoice is null)
        {
            allocationAmountText = "";
            return;
        }

        var capacity = Math.Max(0, Total - InvoiceAllocatedTotal);
        var suggested = capacity > 0 ? Math.Min(invoice.RemainingAmount, capacity) : invoice.RemainingAmount;
        allocationAmountText = suggested.ToString("0.##");
    }

    private void OnAllocationAmountText(ChangeEventArgs e)
        => allocationAmountText = e.Value?.ToString() ?? "";

    private void AddInvoiceAllocation()
    {
        var invoice = openInvoices.FirstOrDefault(i => i.InvoiceId == selectedInvoiceId);
        if (invoice is null) return;
        if (doc.InvoiceAllocations.Any(a => a.InvoiceId == invoice.InvoiceId))
        {
            Toast.Info("این فاکتور قبلاً به سند اضافه شده است.");
            return;
        }

        var amount = Math.Max(0, Fa.ParseDecimal(allocationAmountText));
        if (amount <= 0)
        {
            Toast.Info("مبلغ تخصیص باید بیشتر از صفر باشد.");
            return;
        }
        if (amount > invoice.RemainingAmount)
        {
            Toast.Error($"مبلغ تخصیص از ماندهٔ فاکتور بیشتر است ({invoice.RemainingAmount:N0}).");
            return;
        }
        doc.InvoiceAllocations.Add(new TrsInvoiceAllocationDto
        {
            InvoiceId = invoice.InvoiceId,
            InvoiceNumber = invoice.InvoiceNumber,
            InvoiceKind = invoice.InvoiceKind,
            InvoiceDate = invoice.InvoiceDate,
            InvoiceTotal = invoice.InvoiceTotal,
            RemainingBeforeSettlement = invoice.RemainingAmount,
            Amount = amount,
            EffectiveAmount = amount
        });
        SyncLegacyInvoiceLink();
        selectedInvoiceId = 0;
        allocationAmountText = "";
    }

    private void OnInvoiceAllocationAmount(TrsInvoiceAllocationDto allocation, ChangeEventArgs e)
    {
        allocation.Amount = Math.Max(0, Fa.ParseDecimal(e.Value?.ToString()));
        allocation.EffectiveAmount = allocation.Amount;
    }

    private void RemoveInvoiceAllocation(TrsInvoiceAllocationDto allocation)
    {
        doc.InvoiceAllocations.Remove(allocation);
        SyncLegacyInvoiceLink();
    }

    private void SyncLegacyInvoiceLink()
    {
        if (doc.InvoiceAllocations.Count == 1)
        {
            doc.InvoiceId = doc.InvoiceAllocations[0].InvoiceId;
            doc.InvoiceNumber = doc.InvoiceAllocations[0].InvoiceNumber;
        }
        else
        {
            doc.InvoiceId = null;
            doc.InvoiceNumber = null;
        }
    }

    private static string AllocationAmountText(TrsInvoiceAllocationDto allocation)
        => allocation.Amount.ToString("0.##");

    private decimal RemainingAfter(TrsInvoiceAllocationDto allocation)
        => doc.Status == TreasuryStatus.Cancelled
            ? allocation.RemainingBeforeSettlement
            : Math.Max(0, allocation.RemainingBeforeSettlement - allocation.EffectiveAmount);

    private static string InvoiceKindTitle(InvoiceKind kind) => kind switch
    {
        InvoiceKind.Sale => "فروش",
        InvoiceKind.Purchase => "خرید",
        InvoiceKind.PurchaseReturn => "برگشت از خرید",
        _ => "برگشت از فروش"
    };

    private void OnFromAccount(ChangeEventArgs e)
    {
        var id = int.Parse(e.Value?.ToString() ?? "0");
        doc.FromAccountId = id > 0 ? id : null;
        doc.FromAccountName = accounts.FirstOrDefault(a => a.Id == id)?.Name;
    }

    private void OnToAccount(ChangeEventArgs e)
    {
        var id = int.Parse(e.Value?.ToString() ?? "0");
        doc.ToAccountId = id > 0 ? id : null;
        doc.ToAccountName = accounts.FirstOrDefault(a => a.Id == id)?.Name;
    }

    private void OnTransferAmount(ChangeEventArgs e)
    {
        amountText = e.Value?.ToString() ?? "";
        doc.TotalAmount = Math.Max(0, Fa.ParseDecimal(amountText));
    }

    private void OnFee(ChangeEventArgs e)
    {
        feeText = e.Value?.ToString() ?? "";
        doc.FeeAmount = Math.Max(0, Fa.ParseDecimal(feeText));
    }

    // ---------- سطرها ----------

    private List<TrsAccount> AccountsFor(PayMethod m) => m switch
    {
        PayMethod.Cash => accounts.Where(a => a.Kind is TreasuryAccountKind.Cash or TreasuryAccountKind.PettyCash).ToList(),
        PayMethod.Card => accounts.Where(a => a.Kind is TreasuryAccountKind.Pos or TreasuryAccountKind.Bank).ToList(),
        _ => accounts.Where(a => a.Kind == TreasuryAccountKind.Bank).ToList()
    };

    private void AddLine(PayMethod method)
    {
        var pool = AccountsFor(method);
        var def = pool.FirstOrDefault(a => a.IsDefault) ?? pool.FirstOrDefault();

        doc.Lines.Add(new TrsVoucherLine
        {
            RowNo = doc.Lines.Count + 1,
            Method = method,
            TrsAccountId = method is PayMethod.Cash or PayMethod.Card or PayMethod.Transfer ? def?.Id : null,
            TrsAccountName = method is PayMethod.Cash or PayMethod.Card or PayMethod.Transfer ? def?.Name : null,
            IssueDate = method == PayMethod.Cheque ? doc.Date : null,
            DueDate = method == PayMethod.Cheque ? doc.Date : null
        });
        Renumber();
    }

    private void RemoveLine(TrsVoucherLine line)
    {
        doc.Lines.Remove(line);
        Renumber();
        AdjustSingleInvoiceAllocationToTotal();
    }

    private void Renumber()
    {
        var i = 1;
        foreach (var l in doc.Lines) l.RowNo = i++;
    }

    /// <summary>متن قابل ویرایش مبلغ سطر (صفر خالی نشان داده می‌شود).</summary>
    private static string LineText(TrsVoucherLine l) => l.Amount == 0 ? "" : l.Amount.ToString("0.##");

    private void OnLineAmount(TrsVoucherLine line, ChangeEventArgs e)
    {
        line.Amount = Math.Max(0, Fa.ParseDecimal(e.Value?.ToString()));
        AdjustSingleInvoiceAllocationToTotal();
    }

    // در تسویهٔ تک‌فاکتوری، کم‌کردن مبلغ پرداخت به‌صورت خودکار همان مبلغ تخصیص را هم قسطی می‌کند.
    private void AdjustSingleInvoiceAllocationToTotal()
    {
        if (doc.InvoiceAllocations.Count != 1) return;
        var allocation = doc.InvoiceAllocations[0];
        allocation.Amount = Math.Min(Total, allocation.RemainingBeforeSettlement);
        allocation.EffectiveAmount = allocation.Amount;
    }

    private void OnLineAccount(TrsVoucherLine line, ChangeEventArgs e)
    {
        var id = int.Parse(e.Value?.ToString() ?? "0");
        line.TrsAccountId = id > 0 ? id : null;
        line.TrsAccountName = accounts.FirstOrDefault(a => a.Id == id)?.Name;
    }

    /// <summary>چکی که از صندوق خارج شده دیگر از روی سند قابل ویرایش نیست.</summary>
    private bool IsChequeLocked(TrsVoucherLine line)
        => IsLocked || (line.ChequeStatus is not null
                        && line.ChequeStatus != Inventory.Shared.ChequeStatus.InHand);

    // ---------- ذخیره ----------

    private async Task Save(bool confirm)
    {
        saving = true;
        try
        {
            doc.TotalAmount = doc.Kind == TreasuryKind.Transfer ? doc.TotalAmount : Total;

            var saved = await VoucherSvc.SaveAsync(doc);
            // Keep the new draft/id if confirmation validation fails, so a retry updates rather than duplicates it.
            doc = saved;

            if (confirm)
            {
                doc = await VoucherSvc.ConfirmAsync(saved.Id);
                Toast.Success("سند ثبت و قطعی شد.");
            }
            else
            {
                Toast.Success("پیش‌نویس ذخیره شد.");
            }

            amountText = doc.TotalAmount == 0 ? "" : doc.TotalAmount.ToString("0.##");
            feeText = doc.FeeAmount == 0 ? "" : doc.FeeAmount.ToString("0.##");

            if (Id == 0) Nav.NavigateTo($"/trs/vouchers/edit/{doc.Id}", replace: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Unconfirm()
    {
        if (!await JS.InvokeAsync<bool>("confirm",
            "سند به پیش‌نویس برگردد؟ سند حسابداری آن حذف می‌شود.")) return;
        saving = true;
        try
        {
            doc = await VoucherSvc.UnconfirmAsync(doc.Id);
            Toast.Success("سند به پیش‌نویس برگشت.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");

