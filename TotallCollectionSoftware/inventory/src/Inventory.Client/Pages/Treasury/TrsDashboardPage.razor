@code {
    private TrsDashboard? data;
    private DateTime? from, to;
    private bool loading = true;

    private decimal NetFlow => data is null ? 0 : data.PeriodIn - data.PeriodOut;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("داشبورد خزانه");
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try { data = await ReportSvc.GetDashboardAsync(from, to); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task OnFrom(DateTime? d) { from = d; await Load(); }
    private async Task OnTo(DateTime? d) { to = d; await Load(); }
}
