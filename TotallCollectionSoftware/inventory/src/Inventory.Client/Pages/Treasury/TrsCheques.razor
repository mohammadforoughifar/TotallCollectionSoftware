@implements IDisposable
@page "/trs/cheques"
@inject ITrsChequeService ChequeSvc
@inject ITrsAccountService AccountSvc
@inject IPartyService PartySvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>دفتر جامع اسناد دریافتنی و پرداختنی (دفتر چک)</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ لوکس ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-credit-card-2-front-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">دفتر جامع اسناد دریافتی و پرداختی</h1>
                        <span class="badge rounded-pill fin-badge-indigo">دفتر اسناد خزانه</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        پایش پرونده چک‌های مشتریان، تعهدات دسته چک شرکت، گردش کار واگذاری، وصول و برگشت
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-primary fin-btn-pill" @onclick="() => OpenForm(null)">
                    <i class="bi bi-plus-lg me-1"></i> ثبت چک جدید
                </button>
            </div>
        </div>
    </div>

    <!-- ================== تب‌های سگمنتی انتخاب نوع چک ================== -->
    <div class="op-tabs-nav-wrapper mb-4">
        <div class="op-tabs-nav" style="grid-template-columns: repeat(3, 1fr);">
            <button type="button" class="op-tab-btn @(kind is null ? "is-active tab-cheques" : "")"
                    @onclick="() => SetKind(null)">
                <div class="op-tab-icon-box">
                    <i class="bi bi-collection-fill"></i>
                </div>
                <div class="op-tab-text">
                    <span class="op-tab-title">همه چک‌ها</span>
                    <span class="op-tab-sub">دریافتی‌ها و پرداختی‌ها</span>
                </div>
            </button>

            <button type="button" class="op-tab-btn @(kind == ChequeKind.Received ? "is-active tab-installments" : "")"
                    @onclick="() => SetKind(ChequeKind.Received)">
                <div class="op-tab-icon-box">
                    <i class="bi bi-box-arrow-in-down-left"></i>
                </div>
                <div class="op-tab-text">
                    <span class="op-tab-title">چک‌های دریافتی</span>
                    <span class="op-tab-sub">دریافت‌شده از مشتریان</span>
                </div>
            </button>

            <button type="button" class="op-tab-btn @(kind == ChequeKind.Issued ? "is-active tab-stock" : "")"
                    @onclick="() => SetKind(ChequeKind.Issued)">
                <div class="op-tab-icon-box">
                    <i class="bi bi-box-arrow-up-right"></i>
                </div>
                <div class="op-tab-text">
                    <span class="op-tab-title">چک‌های پرداختی</span>
                    <span class="op-tab-sub">دسته چک و تعهدات ما</span>
                </div>
            </button>
        </div>
    </div>

    <!-- ================== نوار فیلتر ================== -->
    <div class="fin-filter-card mb-4">
        <div class="row g-2.5 align-items-end">
            <div class="col-12 col-md-3">
                <label class="fin-label">جستجوی سریع</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input class="form-control border-start-0 fin-input"
                           placeholder="شماره چک، صیاد، بانک یا طرف حساب…"
                           value="@search" @oninput="OnSearchInput" />
                </div>
            </div>
            <div class="col-6 col-md-2">
                <label class="fin-label">وضعیت چک</label>
                <select class="form-select form-select-sm fin-input" value="@(status?.ToString() ?? "")" @onchange="OnStatus">
                    <option value="">همه وضعیت‌ها</option>
                    <option value="InHand">نزد صندوق</option>
                    <option value="InCollection">در جریان وصول</option>
                    <option value="Cleared">وصول شده</option>
                    <option value="Bounced">برگشتی</option>
                    <option value="Endorsed">خرج شده</option>
                    <option value="Cancelled">ابطال شده</option>
                </select>
            </div>
            <div class="col-6 col-md-2">
                <label class="fin-label">سررسید از</label>
                <DatePicker Value="from" ValueChanged="OnFrom" AllowClear="true" />
            </div>
            <div class="col-6 col-md-2">
                <label class="fin-label">سررسید تا</label>
                <DatePicker Value="to" ValueChanged="OnTo" AllowClear="true" />
            </div>
            <div class="col-6 col-md-2 d-flex align-items-center pb-1">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="onlyOpen"
                           checked="@onlyOpen" @onchange="OnOnlyOpen" />
                    <label class="form-check-label fs-8 fw-bold text-secondary" for="onlyOpen">فقط چک‌های باز</label>
                </div>
            </div>
            <div class="col-6 col-md-1">
                <button class="btn btn-outline-secondary w-100 fin-btn-submit" @onclick="Reset" title="پاک کردن فیلترها">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </button>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
            <div class="text-secondary fs-8">در حال فراخوانی اسناد دفتر چک...</div>
        </div>
    }
    else if (items.Count == 0)
    {
        <div class="fin-table-card p-5 text-center">
            <i class="bi bi-card-checklist fs-1 text-muted opacity-50"></i>
            <div class="fw-bold text-secondary mt-2">چکی با این شرایط یافت نشد</div>
            <div class="text-muted fs-8 mt-1 mb-3">می‌توانید چک جدیدی ثبت کنید یا از طریق اسناد خزانه اقدام نمایید.</div>
            <button class="btn btn-primary fin-btn-pill px-4" @onclick="() => OpenForm(null)">
                <i class="bi bi-plus-lg me-1"></i> ثبت چک جدید
            </button>
        </div>
    }
    else
    {
        <!-- ---------- جدول شیک چک‌ها ---------- -->
        <div class="fin-table-card">
            <div class="fin-table-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="fin-table-header-icon bg-indigo-subtle text-indigo">
                        <i class="bi bi-journal-check"></i>
                    </div>
                    <div>
                        <h3 class="fin-table-title">فهرست چک‌ها و اسناد مالی</h3>
                        <p class="fin-table-sub">مشاهده جزئیات، سررسیدها و مدیریت گردش عملیاتی</p>
                    </div>
                </div>
                <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 num fs-8">
                    @total.Num() برگ چک
                </span>
            </div>

            <div class="table-responsive">
                <table class="table fin-table align-middle">
                    <thead>
                        <tr>
                            <th>نوع</th>
                            <th>شماره سریال چک</th>
                            <th>مشخصات بانک و شعبه</th>
                            <th>طرف حساب</th>
                            <th class="text-start">مبلغ چک (ریال)</th>
                            <th class="text-center">تاریخ سررسید</th>
                            <th class="text-center">وضعیت</th>
                            <th>محل نگهداری / حساب</th>
                            <th class="text-center" style="width: 150px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in items)
                        {
                            var ch = c;
                            <tr class="fin-table-row @(ch.IsOverdue ? "fin-opening-row" : "")">
                                <td>
                                    <span class="badge @(ch.Kind == ChequeKind.Received ? "bg-emerald-subtle text-emerald border border-emerald-subtle" : "bg-danger-subtle text-danger border border-danger-subtle") rounded-pill px-2.5">
                                        <i class="bi @(ch.Kind == ChequeKind.Received ? "bi-arrow-down-left" : "bi-arrow-up-right") me-1"></i>
                                        @(ch.Kind == ChequeKind.Received ? "دریافتی" : "پرداختی")
                                    </span>
                                </td>
                                <td>
                                    <div class="num fw-800 text-dark">@ch.Number.FaDigits()</div>
                                    @if (!string.IsNullOrWhiteSpace(ch.SayadId))
                                    {
                                        <div class="fs-9 text-muted num" dir="ltr" style="text-align:right">صیاد: @ch.SayadId</div>
                                    }
                                </td>
                                <td class="fs-8">
                                    <div class="fw-700 text-dark">@(ch.BankName ?? "—")</div>
                                    @if (!string.IsNullOrWhiteSpace(ch.BranchName))
                                    {
                                        <div class="text-secondary fs-9">شعبه @ch.BranchName</div>
                                    }
                                </td>
                                <td class="fw-700 text-dark">@(ch.PartyName ?? ch.OwnerName ?? "—")</td>
                                <td class="text-start num fw-800 fs-7.5 @(ch.Kind == ChequeKind.Received ? "text-emerald" : "text-rose")">
                                    @ch.Amount.Money()
                                </td>
                                <td class="text-center">
                                    <div class="num fw-700 text-dark fs-8">@ch.DueDate.ToFaDate()</div>
                                    @if (ch.IsOverdue)
                                    {
                                        <span class="badge bg-danger-subtle text-danger rounded-pill fs-9 mt-0.5 num">@Math.Abs(ch.DaysToDue).Num() روز گذشته</span>
                                    }
                                    else if (ch.IsDueSoon)
                                    {
                                        <span class="badge bg-amber-subtle text-amber rounded-pill fs-9 mt-0.5 num">@ch.DaysToDue.Num() روز مانده</span>
                                    }
                                </td>
                                <td class="text-center">
                                    <span class="badge @StatusBadge(ch.Status) rounded-pill px-2.5">@ch.StatusTitle</span>
                                </td>
                                <td class="fs-8 text-secondary">@(ch.TrsAccountName ?? "—")</td>
                                <td class="text-center">
                                    <div class="d-flex gap-1 justify-content-center">
                                        <button class="btn btn-sm btn-outline-secondary fin-btn-pill fs-9 py-1 px-2" @onclick="() => OpenDetail(ch)" title="پرونده چک">
                                            <i class="bi bi-clock-history"></i> پرونده
                                        </button>
                                        @if (ch.IsOpen || ch.Status == ChequeStatus.Bounced)
                                        {
                                            <button class="btn btn-sm btn-outline-success fin-btn-pill fs-9 py-1 px-2.5" @onclick="() => OpenAction(ch)" title="عملیات چک">
                                                <i class="bi bi-lightning-charge me-1"></i> عملیات
                                            </button>
                                        }
                                        @if (ch.Status == ChequeStatus.InHand && ch.TrsVoucherId is null)
                                        {
                                            <button class="btn btn-sm btn-light text-danger fin-btn-pill fs-9 py-1 px-2" @onclick="() => Delete(ch)" title="حذف">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <div class="p-3 border-top bg-light">
                <Pager Page="page" PageCount="PageCount" OnPageChanged="OnPage" />
            </div>
        </div>
    }
</div>


<!-- ===================== فرم ثبت چک ===================== -->
<Modal Visible="showForm" Title="ثبت چک" Size="lg" OnClose="() => showForm = false">
    <ChildContent>
    <div class="row g-3">
        <div class="col-md-4">
            <label class="form-label">نوع چک <span class="text-danger">*</span></label>
            <select class="form-select" value="@((int)form.Kind)" @onchange="OnFormKind">
                <option value="0">دریافتی</option>
                <option value="1">پرداختی (صادره)</option>
            </select>
        </div>
        <div class="col-md-4">
            <label class="form-label">شماره چک <span class="text-danger">*</span></label>
            <input class="form-control num" @bind="form.Number" />
        </div>
        <div class="col-md-4">
            <label class="form-label">شناسه صیاد</label>
            <input class="form-control num" @bind="form.SayadId" maxlength="16" dir="ltr" />
        </div>

        <div class="col-md-4">
            <label class="form-label">مبلغ <span class="text-danger">*</span></label>
            <input class="form-control num" value="@amountText" @onchange="OnAmount" />
            <div class="form-text num">@Fa.MoneyWithWords(form.Amount)</div>
        </div>
        <div class="col-md-4">
            <label class="form-label">تاریخ صدور</label>
            <DatePicker Value="form.IssueDate" ValueChanged="d => form.IssueDate = d ?? DateTime.Now" />
        </div>
        <div class="col-md-4">
            <label class="form-label">سررسید <span class="text-danger">*</span></label>
            <DatePicker Value="form.DueDate" ValueChanged="d => form.DueDate = d ?? DateTime.Now" />
        </div>

        <div class="col-md-4">
            <label class="form-label">بانک</label>
            <input class="form-control" @bind="form.BankName" />
        </div>
        <div class="col-md-4">
            <label class="form-label">شعبه</label>
            <input class="form-control" @bind="form.BranchName" />
        </div>
        <div class="col-md-4">
            <label class="form-label">شماره حساب</label>
            <input class="form-control num" @bind="form.AccountNumber" dir="ltr" />
        </div>

        <div class="col-md-4">
            <label class="form-label">طرف حساب</label>
            <SearchSelect Items="parties" Value="@(form.PartyId ?? 0)"
                          ValueChanged="v => form.PartyId = v > 0 ? v : null" Placeholder="انتخاب…" />
        </div>
        <div class="col-md-4">
            <label class="form-label">صاحب چک (اگر متفاوت است)</label>
            <input class="form-control" @bind="form.OwnerName" />
        </div>
        <div class="col-md-4">
            <label class="form-label">
                @(form.Kind == ChequeKind.Issued ? "از حساب بانکی ما" : "نزد")
                @if (form.Kind == ChequeKind.Issued)
                {
                    <span class="text-danger">*</span>
                }
            </label>
            <select class="form-select" value="@(form.TrsAccountId ?? 0)"
                    @onchange="OnFormAccount">
                <option value="0">— انتخاب —</option>
                @foreach (var a in accounts)
                {
                    <option value="@a.Id">@a.DisplayName</option>
                }
            </select>
        </div>

        <div class="col-12">
            <label class="form-label">توضیحات</label>
            <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
        </div>
    </div>
    </ChildContent>
    <Footer>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-outline-secondary" @onclick="() => showForm = false">انصراف</button>
        <button class="btn btn-primary" @onclick="SaveCheque" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-save"></i> ذخیره
        </button>
    </div>
    </Footer>
</Modal>

<!-- ===================== عملیات چک ===================== -->
<Modal Visible="showAction" Title="@ActionTitle" Size="md" OnClose="() => showAction = false">
    <ChildContent>
    @if (current is not null)
    {
        <div class="alert alert-light border">
            <div class="d-flex justify-content-between">
                <span class="text-muted fs-8">چک شماره</span>
                <b class="num">@current.Number.FaDigits()</b>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted fs-8">مبلغ</span>
                <b class="num">@current.Amount.Money()</b>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted fs-8">سررسید</span>
                <b class="num">@current.DueDate.ToFaDate()</b>
            </div>
            <div class="d-flex justify-content-between">
                <span class="text-muted fs-8">وضعیت فعلی</span>
                <span class="badge @StatusBadge(current.Status)">@current.StatusTitle</span>
            </div>
        </div>

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">عملیات <span class="text-danger">*</span></label>
                <div class="d-flex flex-wrap gap-2">
                    @foreach (var t in AllowedActions(current))
                    {
                        var target = t;
                        <button type="button"
                                class="btn btn-sm @(cmd.Status == target ? "btn-primary" : "btn-outline-primary")"
                                @onclick="() => cmd.Status = target">
                            <i class="bi @ActionIcon(target)"></i> @ActionLabel(current.Kind, target)
                        </button>
                    }
                </div>
            </div>

            <div class="col-md-6">
                <label class="form-label">تاریخ عملیات <span class="text-danger">*</span></label>
                <DatePicker Value="cmd.Date" ValueChanged="d => cmd.Date = d ?? DateTime.Now" />
            </div>

            @if (NeedsBank)
            {
                <div class="col-md-6">
                    <label class="form-label">حساب بانکی <span class="text-danger">*</span></label>
                    <select class="form-select" value="@(cmd.TrsAccountId ?? 0)"
                            @onchange="OnCmdAccount">
                        <option value="0">— انتخاب —</option>
                        @foreach (var a in accounts.Where(x => x.Kind == TreasuryAccountKind.Bank))
                        {
                            <option value="@a.Id">@a.DisplayName</option>
                        }
                    </select>
                </div>
            }

            <div class="col-12">
                <label class="form-label">توضیحات</label>
                <input class="form-control" @bind="cmd.Description" />
            </div>

            <div class="col-12">
                <div class="alert alert-info mb-0 fs-8">
                    <i class="bi bi-info-circle"></i> @EffectHint(current.Kind, cmd.Status)
                </div>
            </div>
        </div>
    }
    </ChildContent>
    <Footer>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-outline-secondary" @onclick="() => showAction = false">انصراف</button>
        <button class="btn btn-success" @onclick="RunAction" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm me-1"></span> }
            <i class="bi bi-check2"></i> ثبت عملیات
        </button>
    </div>
    </Footer>
</Modal>

<!-- ===================== پرونده چک ===================== -->
<Modal Visible="showDetail" Title="پرونده چک" Size="lg" OnClose="() => showDetail = false">
    <ChildContent>
    @if (detail is not null)
    {
        <div class="row g-3 mb-3">
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">شماره چک</div>
                <div class="num fw-600">@detail.Number.FaDigits()</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">مبلغ</div>
                <div class="num fw-600">@detail.Amount.Money()</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">سررسید</div>
                <div class="num">@detail.DueDate.ToFaDate()</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">وضعیت</div>
                <span class="badge @StatusBadge(detail.Status)">@detail.StatusTitle</span>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">بانک</div>
                <div>@(detail.BankName ?? "—")</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">طرف حساب</div>
                <div>@(detail.PartyName ?? "—")</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">شناسه صیاد</div>
                <div class="num" dir="ltr" style="text-align:right">@(detail.SayadId ?? "—")</div>
            </div>
            <div class="col-6 col-md-3">
                <div class="text-muted fs-8">سند خزانه</div>
                @if (detail.TrsVoucherId is > 0)
                {
                    <a class="num" href="@($"/trs/vouchers/edit/{detail.TrsVoucherId}")">
                        شماره @detail.TrsVoucherNumber.GetValueOrDefault().Num()
                    </a>
                }
                else
                {
                    <span>—</span>
                }
            </div>
        </div>

        <h6 class="fw-600 mb-2"><i class="bi bi-clock-history text-primary"></i> تاریخچه عملیات</h6>

        @if (detail.Actions.Count == 0)
        {
            <div class="empty-state py-3"><i class="bi bi-inbox"></i><h5>عملیاتی ثبت نشده است</h5></div>
        }
        else
        {
            <table class="table table-sm align-middle mb-0">
                <thead>
                    <tr>
                        <th style="width:44px">#</th>
                        <th>عملیات</th>
                        <th>تاریخ</th>
                        <th>بانک</th>
                        <th>شرح</th>
                        <th class="text-center">سند حسابداری</th>
                    </tr>
                </thead>
                <tbody>
                    @{ var i = 1; }
                    @foreach (var a in detail.Actions)
                    {
                        <tr>
                            <td class="num text-muted">@((i++).FaDigits())</td>
                            <td><span class="badge @StatusBadge(a.Status)">@a.StatusTitle</span></td>
                            <td class="num">@a.Date.ToFaDate()</td>
                            <td class="fs-8">@(a.TrsAccountName ?? "—")</td>
                            <td class="fs-8 text-muted">@a.Description</td>
                            <td class="text-center">
                                @if (a.VoucherId is > 0)
                                {
                                    <a class="badge badge-soft-primary num" href="@($"/acc/vouchers/edit/{a.VoucherId}")">
                                        @a.VoucherNumber.GetValueOrDefault().Num()
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    }
    </ChildContent>
</Modal>



<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
.fin-header {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
}
.fin-header-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 6px 16px -2px rgba(79, 70, 229, 0.35);
    flex-shrink: 0;
}
.fin-badge-status {
    background: #eef2ff;
    color: #4338ca;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-btn-pill {
    border-radius: 20px;
    padding: 0.45rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.2s;
}

/* کارت‌های شاخص KPI لوکس */
.fin-kpi-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
}
.fin-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.08);
}
.fin-kpi-card.border-rose { border-top: 4px solid #ef4444; }
.fin-kpi-card.border-emerald { border-top: 4px solid #10b981; }
.fin-kpi-card.border-indigo { border-top: 4px solid #4f46e5; }
.fin-kpi-card.border-slate { border-top: 4px solid #64748b; }

.fin-kpi-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.fin-kpi-value {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.2;
}
.fin-kpi-unit {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 0.1rem;
}
.fin-kpi-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}
.fin-kpi-footer {
    border-top: 1px dashed #f1f5f9;
}

/* کارت فیلتر */
.fin-filter-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.1rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
}
.fin-label {
    font-size: 0.74rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.35rem;
    display: block;
}
.fin-input {
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    font-size: 0.82rem;
}
.fin-btn-submit {
    border-radius: 10px;
    height: 33px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
}

/* جدول داده‌ها */
.fin-table-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.fin-table-header {
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fbfcfe;
}
.fin-table-header-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
}
.fin-table-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.1rem;
}
.fin-table-sub {
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 0;
}

.fin-table {
    margin-bottom: 0;
    font-size: 0.82rem;
}
.fin-table thead th {
    background: #f8fafc;
    color: #475569;
    font-weight: 700;
    font-size: 0.74rem;
    padding: 0.85rem 0.9rem;
    border-bottom: 1.5px solid #e2e8f0;
    white-space: nowrap;
}
.fin-table tbody td {
    padding: 0.85rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
}
.fin-table-row:hover {
    background: #f8fafc;
}
.fin-table-total-row {
    background: #f8fafc;
    border-top: 2px solid #cbd5e1;
}
.fin-table-total-row td {
    padding: 1rem 0.9rem;
}

.fin-avatar {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #eef2ff;
    color: #4f46e5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
    flex-shrink: 0;
}
.fin-avatar-lg {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.4rem;
    flex-shrink: 0;
}

/* صفحه صورت‌حساب شخص */
.fin-statement-header-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.04);
}
.fin-statement-kpi-badge {
    padding: 0.85rem 1.4rem;
    border-radius: 14px;
    text-align: left;
    min-width: 220px;
}
.fin-statement-kpi-badge.badge-debtor {
    background: #fef2f2;
    border: 1.5px solid #fecaca;
    color: #b91c1c;
}
.fin-statement-kpi-badge.badge-creditor {
    background: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    color: #15803d;
}
.fin-statement-kpi-badge.badge-settled {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #475569;
}
.fin-statement-kpi-sub {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.85;
}
.fin-statement-kpi-val {
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1.2;
    margin: 0.15rem 0;
}
.fin-statement-kpi-status {
    font-size: 0.74rem;
    font-weight: 700;
}

.fin-opening-row {
    background: #fffbeb !important;
}
.fin-opening-row:hover {
    background: #fef3c7 !important;
}

.text-rose { color: #e11d48 !important; }
.bg-rose-subtle { background-color: #ffe4e6 !important; }
.text-emerald { color: #059669 !important; }
.bg-emerald-subtle { background-color: #d1fae5 !important; }
.text-indigo { color: #4f46e5 !important; }
.bg-indigo-subtle { background-color: #eef2ff !important; }
.text-amber { color: #d97706 !important; }
.bg-amber-subtle { background-color: #fef3c7 !important; }
.text-slate { color: #475569 !important; }
.bg-slate-subtle { background-color: #f1f5f9 !important; }
.text-purple { color: #7c3aed !important; }
.bg-purple-subtle { background-color: #ede9fe !important; }

.spin {
    animation: finSpin 0.7s linear infinite;
}
@@keyframes finSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.fade-in {
    animation: finFadeIn 0.25s ease-in-out;
}
@@keyframes finFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}
</style>

