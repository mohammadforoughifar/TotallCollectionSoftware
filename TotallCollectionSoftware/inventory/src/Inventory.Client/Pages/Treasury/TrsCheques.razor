@code {
    private List<TrsCheque> items = new();
    private List<TrsAccount> accounts = new();
    private List<LookupItem> parties = new();

    private ChequeKind? kind;
    private ChequeStatus? status;
    private string search = "";
    private DateTime? from, to;
    private bool onlyOpen;

    private int page = 1, pageSize = 15, total;
    private bool loading = true, saving;

    private bool showForm, showAction, showDetail;
    private TrsCheque form = new();
    private TrsCheque? current, detail;
    private TrsChequeCommand cmd = new();
    private string amountText = "";

    private int PageCount => total == 0 ? 1 : (int)Math.Ceiling(total / (double)pageSize);

    private string ActionTitle => current is null ? "عملیات چک" : $"عملیات چک {current.Number}";

    private bool NeedsBank => cmd.Status == ChequeStatus.InCollection
                              || (cmd.Status == ChequeStatus.Cleared
                                  && current?.Kind == ChequeKind.Received);

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("دفتر چک");
        try
        {
            accounts = await AccountSvc.GetAllAsync(true);
            var customers = await PartySvc.GetLookupsAsync(PartyType.Customer, true);
            var suppliers = await PartySvc.GetLookupsAsync(PartyType.Supplier, true);
            parties = customers.Concat(suppliers)
                .GroupBy(p => p.Id).Select(g => g.First())
                .OrderBy(p => p.Name).ToList();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        await Load();
    }

    private async Task Load()
    {
        var version = ++loadVersion;
        loading = true;
        try
        {
            var res = await ChequeSvc.GetAllAsync(kind, status, null, null, search, from, to, onlyOpen, page, pageSize);
            if (version != loadVersion) return;
            items = res.Items;
            total = res.TotalCount;
        }
        catch (Exception ex) { if (version == loadVersion) Toast.Error(ex.Message); }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task SetKind(ChequeKind? k) { kind = k; page = 1; await Load(); }

    private System.Threading.CancellationTokenSource? searchCts;
    private int loadVersion;

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        searchCts = cts;
        var version = ++loadVersion; // invalidate an older in-flight response immediately
        page = 1;
        try
        {
            if (!string.IsNullOrWhiteSpace(search)) await Task.Delay(300, cts.Token);
            if (cts.IsCancellationRequested || version != loadVersion) return;
            await Load();
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(searchCts, cts)) searchCts = null;
            cts.Dispose();
        }
    }

    public void Dispose()
    {
        ++loadVersion;
        searchCts?.Cancel();
    }

    private async Task OnStatus(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        status = string.IsNullOrEmpty(raw) ? null : Enum.Parse<ChequeStatus>(raw);
        page = 1;
        await Load();
    }

    private async Task OnFrom(DateTime? d) { from = d; page = 1; await Load(); }
    private async Task OnTo(DateTime? d) { to = d; page = 1; await Load(); }

    private async Task OnOnlyOpen(ChangeEventArgs e)
    {
        onlyOpen = e.Value is bool b && b;
        page = 1;
        await Load();
    }

    private async Task OnPage(int p) { page = p; await Load(); }

    private async Task Reset()
    {
        search = ""; status = null; from = null; to = null; onlyOpen = false; page = 1;
        await Load();
    }

    // ---------- کمکی فرم (رشته‌ی داخل رشته در Razor مجاز نیست) ----------

    private void OnFormKind(ChangeEventArgs e)
        => form.Kind = (ChequeKind)int.Parse(e.Value?.ToString() ?? "0");

    private void OnFormAccount(ChangeEventArgs e)
    {
        var id = int.Parse(e.Value?.ToString() ?? "0");
        form.TrsAccountId = id > 0 ? id : null;
    }

    private void OnCmdAccount(ChangeEventArgs e)
    {
        var id = int.Parse(e.Value?.ToString() ?? "0");
        cmd.TrsAccountId = id > 0 ? id : null;
    }

    // ---------- فرم ----------

    private void OpenForm(TrsCheque? c)
    {
        form = c is null
            ? new TrsCheque { Kind = ChequeKind.Received, IssueDate = DateTime.Now.Date, DueDate = DateTime.Now.Date }
            : c;
        amountText = form.Amount == 0 ? "" : form.Amount.ToString("0.##");
        showForm = true;
    }

    private void OnAmount(ChangeEventArgs e)
    {
        amountText = e.Value?.ToString() ?? "";
        form.Amount = Math.Max(0, Fa.ParseDecimal(amountText));
    }

    private async Task SaveCheque()
    {
        if (saving) return;
        var identifierError = ShopIdentifierRules.ValidateCheque(form);
        if (identifierError is not null) { Toast.Error(identifierError); return; }
        saving = true;
        try
        {
            await ChequeSvc.SaveShopAsync(form);
            Toast.Success("چک ذخیره شد.");
            showForm = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    // ---------- عملیات ----------

    private void OpenAction(TrsCheque c)
    {
        current = c;
        var allowed = AllowedActions(c);
        cmd = new TrsChequeCommand
        {
            ChequeId = c.Id,
            Status = allowed.FirstOrDefault(),
            Date = DateTime.Now.Date,
            TrsAccountId = c.TrsAccountId
        };
        showAction = true;
    }

    private async Task RunAction()
    {
        if (current is null) return;
        saving = true;
        try
        {
            await ChequeSvc.RunActionAsync(cmd);
            Toast.Success("عملیات چک ثبت شد.");
            showAction = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task OpenDetail(TrsCheque c)
    {
        try
        {
            detail = await ChequeSvc.GetAsync(c.Id);
            showDetail = true;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Delete(TrsCheque c)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"چک شماره {c.Number} حذف شود؟")) return;
        try
        {
            await ChequeSvc.DeleteAsync(c.Id);
            Toast.Success("چک حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---------- گذارهای مجاز (آینه‌ی منطق سرور) ----------

    private static List<ChequeStatus> AllowedActions(TrsCheque c) => c.Kind == ChequeKind.Received
        ? c.Status switch
        {
            ChequeStatus.InHand => new List<ChequeStatus>
            {
                ChequeStatus.InCollection, ChequeStatus.Cleared, ChequeStatus.Endorsed, ChequeStatus.Cancelled
            },
            ChequeStatus.InCollection => new List<ChequeStatus>
            {
                ChequeStatus.Cleared, ChequeStatus.Bounced, ChequeStatus.InHand
            },
            ChequeStatus.Bounced => new List<ChequeStatus>
            {
                ChequeStatus.InCollection, ChequeStatus.Cleared, ChequeStatus.Cancelled
            },
            _ => new List<ChequeStatus>()
        }
        : c.Status switch
        {
            ChequeStatus.InHand => new List<ChequeStatus>
            {
                ChequeStatus.Cleared, ChequeStatus.Bounced, ChequeStatus.Cancelled
            },
            ChequeStatus.Bounced => new List<ChequeStatus> { ChequeStatus.Cleared, ChequeStatus.Cancelled },
            _ => new List<ChequeStatus>()
        };

    private static string ActionLabel(ChequeKind kind, ChequeStatus s) => s switch
    {
        ChequeStatus.InCollection => "واگذاری به بانک",
        ChequeStatus.Cleared => kind == ChequeKind.Received ? "وصول شد" : "پاس شد",
        ChequeStatus.Bounced => "برگشت خورد",
        ChequeStatus.Endorsed => "خرج چک",
        ChequeStatus.Cancelled => "ابطال",
        _ => "برگشت به صندوق"
    };

    private static string ActionIcon(ChequeStatus s) => s switch
    {
        ChequeStatus.InCollection => "bi-bank",
        ChequeStatus.Cleared => "bi-check2-circle",
        ChequeStatus.Bounced => "bi-x-octagon",
        ChequeStatus.Endorsed => "bi-arrow-left-right",
        ChequeStatus.Cancelled => "bi-slash-circle",
        _ => "bi-arrow-counterclockwise"
    };

    private static string EffectHint(ChequeKind kind, ChequeStatus s)
    {
        if (kind == ChequeKind.Received)
            return s switch
            {
                ChequeStatus.InCollection => "اسناد در جریان وصول بدهکار | اسناد دریافتنی بستانکار",
                ChequeStatus.Cleared => "بانک بدهکار | اسناد در جریان وصول (یا اسناد دریافتنی) بستانکار — پول وارد حساب می‌شود.",
                ChequeStatus.Bounced => "حساب‌های دریافتنی بدهکار | اسناد در جریان وصول بستانکار — طلب دوباره روی طرف حساب می‌نشیند.",
                ChequeStatus.Endorsed => "حساب‌های پرداختنی بدهکار | اسناد دریافتنی بستانکار",
                ChequeStatus.Cancelled => "حساب‌های دریافتنی بدهکار | اسناد دریافتنی بستانکار",
                _ => "اسناد دریافتنی بدهکار | اسناد در جریان وصول بستانکار"
            };

        return s switch
        {
            ChequeStatus.Cleared => "اسناد پرداختنی بدهکار | بانک بستانکار — پول از حساب خارج می‌شود.",
            ChequeStatus.Bounced => "اسناد پرداختنی بدهکار | حساب‌های پرداختنی بستانکار — بدهی دوباره برقرار می‌شود.",
            ChequeStatus.Cancelled => "اسناد پرداختنی بدهکار | حساب‌های پرداختنی بستانکار",
            _ => "—"
        };
    }

    private static string StatusBadge(ChequeStatus s) => s switch
    {
        ChequeStatus.InHand => "badge-soft-primary",
        ChequeStatus.InCollection => "badge-soft-info",
        ChequeStatus.Cleared => "badge-soft-success",
        ChequeStatus.Bounced => "badge-soft-danger",
        ChequeStatus.Endorsed => "badge-soft-warning",
        _ => "badge-soft-muted"
    };

    private static string Stripe(ChequeStatus s) => s switch
    {
        ChequeStatus.InHand => "st-received",
        ChequeStatus.InCollection => "st-progress",
        ChequeStatus.Cleared => "st-ready",
        ChequeStatus.Bounced => "st-cancelled",
        _ => "st-delivered"
    };
}
