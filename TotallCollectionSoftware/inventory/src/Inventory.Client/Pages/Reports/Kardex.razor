@page "/reports/kardex"
@page "/operations/reports/kardex-quantity"
@inject IAuthState Auth
@inject IReportService ReportSvc
@inject IProductService ProductSvc
@inject IWarehouseService WarehouseSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

@if (!Auth.Has("ReportPages.Kardex"))
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mt-3 rounded-4 p-3">
        <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
        <div>شما به «گزارش کاردکس کالا» دسترسی ندارید. برای دریافت دسترسی با مدیر سیستم تماس بگیرید.</div>
    </div>
}
else
{
    <PageTitle>گزارش کاردکس تعدادی کالا</PageTitle>

    <div class="fin-page-container fade-in">
        <!-- ================== سربرگ لوکس ================== -->
        <div class="fin-header mb-4 no-print">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="fin-header-icon bg-indigo-gradient">
                        <i class="bi bi-bar-chart-line-fill"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h1 class="h4 fw-800 text-dark mb-0">کاردکس تعدادی کالا</h1>
                            <span class="badge rounded-pill fin-badge-indigo">گردش انبار</span>
                        </div>
                        <div class="text-secondary fs-8 mt-1">
                            رهگیری خط‌به‌خط ورودی‌ها، خروجی‌ها، حواله‌ها و مانده فیزیکی کالا در انبار
                        </div>
                    </div>
                </div>

                @if (rows.Count > 0)
                {
                    <button class="btn btn-primary fin-btn-pill" @onclick="Print">
                        <i class="bi bi-printer-fill me-1"></i> چاپ رسمی کاردکس
                    </button>
                }
            </div>
        </div>

        <!-- ================== نوار فیلتر ================== -->
        <div class="fin-filter-card mb-4 no-print">
            <div class="row g-2.5 align-items-end">
                <div class="col-12 col-md-4 col-xl-3">
                    <label class="fin-label">انتخاب کالا <span class="text-danger">*</span></label>
                    <SearchSelect Items="productLookup" Value="productId" ValueChanged="v => productId = v" Placeholder="انتخاب یا جستجوی کالا…" />
                </div>
                <div class="col-6 col-md-3 col-xl-3">
                    <label class="fin-label">انبار مبدأ/مقصد</label>
                    <SearchSelect Items="whLookup" Value="warehouseId" ValueChanged="v => warehouseId = v" Placeholder="همه انبارها" />
                </div>
                <div class="col-6 col-md-2 col-xl-2">
                    <label class="fin-label">از تاریخ</label>
                    <DatePicker @bind-Value="from" AllowClear="true" />
                </div>
                <div class="col-6 col-md-2 col-xl-2">
                    <label class="fin-label">تا تاریخ</label>
                    <DatePicker @bind-Value="to" AllowClear="true" />
                </div>
                <div class="col-6 col-md-1 col-xl-2">
                    <button class="btn btn-primary fin-btn-submit w-100" @onclick="Load" disabled="@(productId == 0 || loading)">
                        <i class="bi bi-search me-1"></i> نمایش کاردکس
                    </button>
                </div>
            </div>
        </div>

        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                <div class="text-secondary fs-8">در حال محاسبه گردش کاردکس کالا...</div>
            </div>
        }
        else if (productId == 0)
        {
            <div class="fin-table-card p-5 text-center">
                <i class="bi bi-journal-text fs-1 text-muted opacity-50"></i>
                <div class="fw-bold text-secondary mt-2">برای مشاهدهٔ کاردکس، ابتدا یک کالا از کادر بالا انتخاب کنید</div>
            </div>
        }
        else if (rows.Count == 0)
        {
            <div class="fin-table-card p-5 text-center">
                <i class="bi bi-inbox fs-1 text-muted opacity-50"></i>
                <div class="fw-bold text-secondary mt-2">هیچ گردشی برای این کالا در بازهٔ انتخابی ثبت نشده است</div>
            </div>
        }
        else
        {
            <!-- ================== جدول کاردکس ================== -->
            <div class="fin-table-card">
                <div class="fin-table-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="fin-table-header-icon bg-indigo-subtle text-indigo">
                            <i class="bi bi-box-seam-fill"></i>
                        </div>
                        <div>
                            <h3 class="fin-table-title">کاردکس: @productName</h3>
                            <p class="fin-table-sub">ریز گردش زمانی به تفکیک اسناد خرید، فروش و تعدیلات</p>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(warehouseName))
                    {
                        <span class="badge bg-indigo-subtle text-indigo rounded-pill px-3 fs-8">
                            انبار: @warehouseName
                        </span>
                    }
                </div>

                <div class="table-responsive">
                    <table class="table fin-table align-middle">
                        <thead>
                            <tr>
                                <th class="text-center">تاریخ سند</th>
                                <th>نوع عملیات</th>
                                <th>شماره فاکتور/سند</th>
                                <th>طرف حساب</th>
                                <th>شرح رویداد</th>
                                <th class="text-start">وارده (ورودی)</th>
                                <th class="text-start">صادره (خروجی)</th>
                                <th class="text-start">مانده انبار</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in PagedRows)
                            {
                                <tr class="fin-table-row">
                                    <td class="text-center num text-secondary fs-8">@r.Date.ToFaDateTime()</td>
                                    <td>@TypeBadge(r.Type)</td>
                                    <td class="num fw-700 text-indigo">@r.DocumentNo</td>
                                    <td class="fw-600 text-dark">@(string.IsNullOrEmpty(r.PartyName) ? "—" : r.PartyName)</td>
                                    <td class="text-secondary fs-8">@r.Description</td>
                                    <td class="text-start num fw-700 @(r.InQty > 0 ? "text-emerald" : "text-muted")">
                                        @(r.InQty > 0 ? r.InQty.Num() : "—")
                                    </td>
                                    <td class="text-start num fw-700 @(r.OutQty > 0 ? "text-rose" : "text-muted")">
                                        @(r.OutQty > 0 ? r.OutQty.Num() : "—")
                                    </td>
                                    <td class="text-start num fw-900 fs-7.5 text-dark">
                                        @r.Balance.Num()
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top bg-light no-print">
                    <Pager Page="page" PageCount="PageCount" OnPageChanged="p => page = p" />
                </div>
            </div>
        }
    </div>
}


<style>
