    to { transform: rotate(360deg); }
}

.fade-in {
    animation: finFadeIn 0.25s ease-in-out;
}
@@keyframes finFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
