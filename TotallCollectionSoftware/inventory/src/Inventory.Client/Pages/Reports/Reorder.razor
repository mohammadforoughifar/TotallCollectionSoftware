@page "/reports/reorder"
@inject IAuthState Auth
@inject IReportService ReportSvc
@inject IWarehouseService WarehouseSvc
@inject IToastService Toast
@inject LayoutState Layout

@if (!Auth.Has("ReportPages.Reorder"))
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mt-3 rounded-4 p-3 border border-warning-subtle">
        <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
        <div>شما به «گزارش نقطه سفارش» دسترسی ندارید. برای دریافت دسترسی با مدیر سیستم تماس بگیرید.</div>
    </div>
}
else
{
<PageTitle>گزارش هوشمند نقطه سفارش و کسری کالا</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-amber-gradient">
                    <i class="bi bi-exclamation-triangle-fill"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">گزارش نقطه سفارش و هشدار کسری انبار</h1>
                        <span class="badge rounded-pill fin-badge-amber">هشدار زنجیره تأمین</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        شناسایی اقلامی که به آستانه کمبود رسیده‌اند و محاسبه خودکار مقدار پیشنهادی خرید مجدد
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-secondary fin-btn-pill" disabled="@loading" @onclick="Load">
                    <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i> بازخوانی داده‌ها
                </button>
            </div>
        </div>
    </div>

    <!-- ================== کارت‌های KPI ================== -->
    <div class="row g-3 mb-4">
        <div class="col-12 col-sm-6 col-xl-4">
            <div class="fin-kpi-card border-amber">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-amber">اقلام زیر نقطه سفارش</span>
                        <div class="fin-kpi-value text-amber num mt-1">@totalCount.Num()</div>
                        <div class="fin-kpi-unit">کالای نیازمند اقدام</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                        <i class="bi bi-shield-exclamation"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5">وضعیت بحرانی موجودی</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="fin-kpi-card border-indigo">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-indigo">محدوده انبار جاری</span>
                        <div class="fin-kpi-value text-indigo fs-5 mt-1">
                            @(warehouseId > 0 ? (whLookup.FirstOrDefault(w => w.Id == warehouseId)?.Name ?? "انبار انتخاب‌شده") : "همه انبارهای فعال")
                        </div>
                        <div class="fin-kpi-unit">مکان رهگیری فیزیکی</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                        <i class="bi bi-building"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="text-secondary fs-9">فیلتر شده بر اساس انبار</span>
                </div>
            </div>
        </div>

        <div class="col-12 col-sm-6 col-xl-4">
            <div class="fin-kpi-card border-emerald">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <span class="fin-kpi-title text-emerald">پیشنهاد تأمین کالا</span>
                        <div class="fin-kpi-value text-emerald num mt-1">@items.Sum(i => i.Suggested).Num()</div>
                        <div class="fin-kpi-unit">مجموع واحدهای خرید پیشنهادی</div>
                    </div>
                    <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                        <i class="bi bi-cart-plus-fill"></i>
                    </div>
                </div>
                <div class="fin-kpi-footer mt-3 pt-2">
                    <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">تکمیل تا سقف مجاز انبار</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ================== نوار فیلتر ================== -->
    <div class="fin-card mb-4">
        <div class="fin-card-body p-3">
            <div class="row g-2.5 align-items-end">
                <div class="col-12 col-md-5 col-lg-4">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">انتخاب انبار مورد بررسی</label>
                    <SearchSelect Items="whLookup" Value="warehouseId" ValueChanged="v => warehouseId = v" Placeholder="همه انبارها" />
                </div>
                <div class="col-12 col-md-auto">
                    <button class="btn btn-primary fin-btn-pill px-4" @onclick="Load" disabled="@loading">
                        <i class="bi bi-funnel me-1"></i> اعمال فیلتر
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- ================== جدول اقلام ================== -->
    <div class="fin-card">
        <div class="fin-card-header d-flex justify-content-between align-items-center p-3 border-bottom">
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-table text-primary fs-5"></i>
                <span class="fw-800 text-dark">فهرست اقلام زیر نقطه سفارش</span>
            </div>
            <span class="badge bg-amber-subtle text-amber rounded-pill px-3 py-1.5 num fs-8">
                @totalCount.Num() قلم کالا
            </span>
        </div>
        <div class="fin-card-body p-0">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <div class="text-secondary fs-8 mt-2">در حال ارزیابی موجودی و سطوح سفارش...</div>
                </div>
            }
            else if (items.Count == 0)
            {
                <div class="text-center py-5">
                    <div class="fin-avatar bg-emerald-subtle text-emerald mx-auto mb-2" style="width:52px;height:52px">
                        <i class="bi bi-check2-circle fs-3"></i>
                    </div>
                    <h5 class="fw-800 text-dark">تمامی کالاها در وضعیت مطلوب موجودی هستند</h5>
                    <p class="text-secondary fs-8 mb-0">هیچ کالایی به آستانه کمبود یا نقطه سفارش نرسیده است.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 fin-table">
                        <thead class="bg-light">
                            <tr>
                                <th class="text-secondary fs-8 fw-700 py-3">کد کالا</th>
                                <th class="text-secondary fs-8 fw-700 py-3">نام و مشخصات کالا</th>
                                <th class="text-secondary fs-8 fw-700 py-3">گروه کالا</th>
                                <th class="text-secondary fs-8 fw-700 py-3">واحد</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-start">موجودی فعلی</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-start">نقطه سفارش</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-start">حداکثر انبار</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-start">مقدار کسری</th>
                                <th class="text-secondary fs-8 fw-700 py-3 text-start">پیشنهاد خرید</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in items)
                            {
                                <tr>
                                    <td class="num text-secondary fw-600">@r.ProductCode</td>
                                    <td class="fw-700 text-dark">@r.ProductName</td>
                                    <td>
                                        <span class="badge bg-light text-secondary border rounded-pill px-2.5">
                                            @(r.Category ?? "عمومی")
                                        </span>
                                    </td>
                                    <td class="text-secondary fs-8">@r.Unit</td>
                                    <td class="text-start num fw-800 text-danger">@r.TotalStock.Qty()</td>
                                    <td class="text-start num text-secondary">@r.ReorderPoint.Qty()</td>
                                    <td class="text-start num text-secondary">@r.MaxStock.Qty()</td>
                                    <td class="text-start num fw-800 text-danger">
                                        <span class="badge bg-rose-subtle text-rose rounded-pill px-2.5">
                                            @r.Shortage.Qty() -
                                        </span>
                                    </td>
                                    <td class="text-start">
                                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-3 py-1.5 fw-800 num fs-8">
                                            <i class="bi bi-cart-plus me-1"></i> @r.Suggested.Qty() @r.Unit
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="p-3 border-top d-flex justify-content-center">
                    <Pager Page="page" PageCount="PageCount" OnPageChanged="ChangePage" />
                </div>
            }
        </div>
    </div>
</div>
}


