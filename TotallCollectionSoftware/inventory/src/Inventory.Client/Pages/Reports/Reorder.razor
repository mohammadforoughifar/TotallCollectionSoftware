@code {
    private List<ReorderItem> items = new();

    // ---------- صفحه‌بندی ----------
    private int page = 1;
    private const int PageSize = 12;
    private int totalCount;
    private int loadVersion;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(totalCount / (double)PageSize));
    private List<LookupItem> whLookup = new();
    private int warehouseId;
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("گزارش نقطه سفارش");
        try
        {
            whLookup = await WarehouseSvc.GetLookupsAsync();
        }
        catch { }
        await Load();
    }

    private async Task Load()
    {
        page = 1;
        await LoadPage();
    }

    private async Task ChangePage(int value)
    {
        page = Math.Clamp(value, 1, PageCount);
        await LoadPage();
    }

    private async Task LoadPage()
    {
        var version = ++loadVersion;
        loading = true;
        try
        {
            var result = await ReportSvc.GetReorderPageAsync((page - 1) * PageSize, PageSize, warehouseId);
            if (version != loadVersion) return;
            items = result.Items;
            totalCount = result.TotalCount;
            if (page > PageCount)
            {
                page = PageCount;
                await LoadPage();
            }
        }
        catch (Exception ex) { if (version == loadVersion) Toast.Error(ex.Message); }
        finally { if (version == loadVersion) loading = false; }
    }
}
