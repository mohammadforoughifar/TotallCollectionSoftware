@code {
    [Parameter] public int Id { get; set; }

    private bool loading = true;
    private bool saving;
    private bool showCustomerForm;

    private VisActorInfo? me;
    private VisOrderCommand model = new() { Date = DateTime.Now };

    /// <summary>وضعیت سفارش هنگام باز کردن فرم ویرایش — برای تصمیم دربارهٔ دکمهٔ ارسال.</summary>
    private VisOrderStatus? originalStatus;

    /// <summary>
    /// فقط پیشنویس و سفارش برگشتی قابل ارسال است. سفارش «در انتظار تأیید» قبلاً
    /// ارسال شده و ارسال مجدد هم در سرور رد میشود؛ پس دکمهٔ ارسال نمایش داده نمیشود.
    /// </summary>
    private bool CanSubmit => Id == 0
        || originalStatus is null or VisOrderStatus.Draft or VisOrderStatus.Returned;

    /// <summary>آخرین سفارشِ ثبت‌شده در همین صفحه — بعد از ثبت، فرم پاک می‌شود تا سفارش بعدی زده شود.</summary>
    private VisOrderDto? lastSaved;

    /// <summary>آیا سفارش آخر ارسال شد یا فقط پیشنویس ذخیره شد (متن بنر موفقیت).</summary>
    private bool lastSubmitted;

    /// <summary>کلید بازسازی کنترل‌ها — با پاک‌سازی فرم زیاد می‌شود تا متن انتخابگرها هم خالی شود.</summary>
    private int formKey;

    /// <summary>تاریخ سفارش (شمسی در UI) — پیش‌فرض امروز</summary>
    private DateTime? orderDate = DateTime.Today;

    /// <summary>تاریخ درخواستی دریافت محصول — پیش‌فرض امروز</summary>
    private DateTime? deliveryDate = DateTime.Today;
    private List<VisWarehouseLite> warehouses = new();
    private List<VisCustomerLite> customers = new();

    /// <summary>گزینه‌های کمبوی مشتری (نام — موبایل) برای انتخابگر جستجودار.</summary>
    private List<LookupItem> customerLookup = new();

    private System.Threading.CancellationTokenSource? _custDebounce;

    /// <summary>فهرست کالاهای انبار برای انتخابگر داخل سطر (در تغییر انبار تازه می‌شود).</summary>
    private List<LookupItem> productLookup = new();

    /// <summary>فهرست کامل کالاهای انبار بر اساس شناسه — برای پر کردن قیمت/واحد سطر پس از انتخاب.</summary>
    private Dictionary<int, VisProductLite> productIndex = new();

    /// <summary>کالاهای غیرخدماتی با موجودی صفر در انبار جاری (برای نشان «ناموجود» در کمبو).</summary>
    private HashSet<int> zeroStockIds = new();

    /// <summary>سطری که کمبوی درونسطریاش باز است (فقط یکی، چون منوها صفحه را رشد میدهند).</summary>
    private VisOrderLineDto? comboLine;
    private string comboQuery = "";

    private bool IsComboOpen(VisOrderLineDto l) => ReferenceEquals(l, comboLine);
    private string ComboText(VisOrderLineDto l)
        => IsComboOpen(l) ? comboQuery : (l.ProductName ?? "");

    /// <summary>حداکثر ۵ گزینه؛ بدون max-height/overflow یعنی بدون اسکرول داخلی.</summary>
    private List<LookupItem> ComboMatches()
    {
        var q = (comboQuery ?? "").Trim();
        return productLookup
            .Where(x => q.Length == 0 || x.Name.Contains(q) || (x.InfoText ?? "").Contains(q))
            .Take(5).ToList();
    }

    private void OpenCombo(VisOrderLineDto l) { comboLine = l; comboQuery = ""; }
    private void CloseCombo() { comboLine = null; comboQuery = ""; }
    private void OnComboInput(VisOrderLineDto l, string? value)
    {
        comboLine = l;
        comboQuery = value ?? "";
    }
    private void OnComboKey(VisOrderLineDto l, KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { CloseCombo(); return; }
        if (e.Key != "Enter") return;
        var matches = ComboMatches();
        if (matches.Count > 0) PickCombo(l, matches[0].Id);
    }
    private void PickCombo(VisOrderLineDto l, int productId)
    {
        OnLineProductPicked(l, productId);
        CloseCombo();
    }

    // Zero sale prices are allowed by the catalog. Warn rather than treating the
    // input as editable: visitors must ask a pricing manager to update the catalog.
    private bool MissingSalePrice(VisOrderLineDto line) =>
        me?.CanEditVisitPrice != true && line.ProductId > 0 && line.UnitPrice <= 0;
    private bool HasNoSalePrice(int productId) =>
        me?.CanEditVisitPrice != true && productIndex.TryGetValue(productId, out var product) && product.SalePrice <= 0;

    // ==================================================================
    //  پرداخت ترکیبی — همان سه جزء فاکتور خرید و فروش + نسیه (باقی‌مانده)
    //  ویزیتور می‌تواند چند جزء را هم‌زمان فعال کند؛ باقی‌ماندهٔ هر جزء از
    //  مبلغ سفارش و اجزای قبلی محاسبه می‌شود (قاعدهٔ PaymentMix).
    // ==================================================================
    private bool useCash = true, useCheque, useInstallment, useCredit;
    private CashType cashKind = CashType.Cash;
    private int? trsAccountId;
    private string cashAmountText = "";
    private DateTime? creditDue;
    private List<TrsAccount> bankAccounts = new();
    private bool showQuickBank;
    private TreasuryAccountKind quickBankDefaultKind = TreasuryAccountKind.Bank;

    private List<ChequeDto> cheques = new();
    private List<string> chequeAmounts = new();
    private List<DateTime?> chequeDates = new();

    private List<InstallmentDto> installments = new();
    private List<string> instAmounts = new();
    private List<DateTime?> instDates = new();
    private int instCount = 3;
    private int instIntervalDays = 30;
    private DateTime? instFirstDue;

    private bool showChequeBank;
    private bool savingChequeBank;
    private int? chequeBankIndex;
    private string newChequeBankName = "";
    private List<string> customChequeBanks = new();

    /// <summary>عکس‌های چکِ همین فرم (پیش از ذخیره، پیش‌نویس).</summary>
    private List<VisOrderAttachmentDto> chequePhotos = new();

    private static readonly string[] PopularChequeBanks =
    {
        "بانک ملت", "بانک ملی", "بانک صادرات", "بانک تجارت", "بانک سپه", "بانک سامان",
        "بانک پاسارگاد", "بانک پارسیان", "بانک رسالت", "بانک مهر ایران", "بانک کشاورزی",
        "بانک مسکن", "بانک رفاه", "بانک آینده", "بانک شهر"
    };

    private List<string> ChequeBankNames => PopularChequeBanks
        .Concat(customChequeBanks)
        .Concat(bankAccounts.Where(a => !string.IsNullOrWhiteSpace(a.BankName)).Select(a => a.BankName!))
        .Distinct(StringComparer.OrdinalIgnoreCase).ToList();

    private List<LookupItem> CashTypeLookup => new()
    {
        new() { Id = 1, Name = "وجه نقد" },
        new() { Id = 2, Name = "کارت‌خوان (POS)" },
        new() { Id = 3, Name = "کارت به کارت" }
    };

    private List<LookupItem> CashAccountLookup =>
        AccountsForCashType(cashKind).Select(a => new LookupItem { Id = a.Id, Name = a.DisplayName }).ToList();

    private List<TrsAccount> AccountsForCashType(CashType ct) => ct switch
    {
        CashType.Cash => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Cash or TreasuryAccountKind.PettyCash).ToList(),
        CashType.CardReader => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Pos or TreasuryAccountKind.Bank).ToList(),
        CashType.CardTransfer => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Bank or TreasuryAccountKind.Pos).ToList(),
        _ => bankAccounts
    };

    private void OnCashTypePicked(int id)
    {
        cashKind = id switch { 2 => CashType.CardReader, 3 => CashType.CardTransfer, _ => CashType.Cash };
        var valid = AccountsForCashType(cashKind);
        if (trsAccountId.HasValue && !valid.Any(a => a.Id == trsAccountId.Value))
            trsAccountId = valid.FirstOrDefault(a => a.IsDefault)?.Id ?? valid.FirstOrDefault()?.Id;
    }

    private void OnCashAccountPicked(int id) => trsAccountId = id > 0 ? id : null;

    private void OpenChequeBank(int index) { chequeBankIndex = index; newChequeBankName = ""; showChequeBank = true; }
    private void CloseChequeBank() => showChequeBank = false;

    private async Task SaveChequeBank()
    {
        var name = newChequeBankName.Trim();
        if (savingChequeBank || string.IsNullOrWhiteSpace(name) || chequeBankIndex is not int index || index >= cheques.Count)
            return;
        savingChequeBank = true;
        try
        {
            // بانک چک ویزیتور در فهرست محلی نگه داشته می‌شود (حساب بانکی شرکت لازم نیست).
            var updated = customChequeBanks.Append(name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
            try
            {
                await JS.InvokeVoidAsync("localStorage.setItem", "invoiceCheque.customBanks",
                    System.Text.Json.JsonSerializer.Serialize(updated));
            }
            catch { /* localStorage اختیاری است */ }
            customChequeBanks = updated;
            cheques[index].BankName = name;
            showChequeBank = false;
        }
        finally { savingChequeBank = false; }
    }

    private void OpenQuickBank(TreasuryAccountKind defaultKind = TreasuryAccountKind.Bank)
    {
        quickBankDefaultKind = defaultKind;
        showQuickBank = true;
    }

    private void OnQuickBankCreated(TrsAccount account)
    {
        if (!bankAccounts.Any(a => a.Id == account.Id)) bankAccounts.Add(account);
        if (AccountsForCashType(cashKind).Any(a => a.Id == account.Id)) trsAccountId = account.Id;
        StateHasChanged();
    }

    private bool HasNonCash => useCheque || useInstallment || useCredit;

    /// <summary>جزء نقدی — اگر تنها جزء باشد تمام مبلغ سفارش است.</summary>
    private decimal CashPart => !HasNonCash ? Net
        : useCash ? Fa.ParseDecimal(cashAmountText) : 0;   // تب نقدی خاموش ⇒ صفر

    /// <summary>جمع چک‌ها — جزء خاموش یعنی صفر (سطرها برای فعال‌سازی مجدد نگه داشته می‌شوند).</summary>
    private decimal ChequeSum => useCheque
        ? cheques.Select((c, i) => Fa.ParseDecimal(chequeAmounts.ElementAtOrDefault(i))).Sum() : 0;

    private decimal InstSum => useInstallment
        ? installments.Select((c, i) => Fa.ParseDecimal(instAmounts.ElementAtOrDefault(i))).Sum() : 0;

    /// <summary>باقی‌ماندهٔ نهایی = مبلغ سفارش − (نقد + چک + اقساط) — همان مبلغ نسیه.</summary>
    private decimal PaymentRemaining => Net - CashPart - ChequeSum - InstSum;
    private decimal RemainingAfterCash => Net - CashPart;

    private decimal RemainingAfterCheque(int i)
    {
        if (cheques.Count == 0) return RemainingAfterCash;
        var upto = Math.Min(i, chequeAmounts.Count - 1);
        decimal sum = CashPart;
        for (var k = 0; k <= upto; k++) sum += Fa.ParseDecimal(chequeAmounts[k]);
        return Net - sum;
    }

    private decimal RemainingAfterInstallment(int i)
    {
        if (installments.Count == 0) return RemainingAfterCash - ChequeSum;
        var upto = Math.Min(i, instAmounts.Count - 1);
        decimal sum = CashPart + ChequeSum;
        for (var k = 0; k <= upto; k++) sum += Fa.ParseDecimal(instAmounts[k]);
        return Net - sum;
    }

    /// <summary>روش پرداخت اعلامی — سرور ترکیبی/تک‌جزء را از مبالغ واقعی می‌سازد.</summary>
    private PaymentMethod DeclaredMethod =>
        SalesVisitPaymentPlan.MethodOf(useCash && CashPart > 0, ChequeSum > 0, InstSum > 0,
            PaymentRemaining > PaymentMix.Tolerance / 2);

    private string PaymentMethodText => PaymentMix.Fa(DeclaredMethod);

    private bool CanEditPhotos => Id == 0 || originalStatus is VisOrderStatus.Draft or VisOrderStatus.Returned;

    /// <summary>شناسهٔ مالک عکس‌های چک — سفارش موجود یا پیش‌نویس (-1).</summary>
    private int PhotoRefId => Id > 0 ? Id : VisAttachmentCategories.DraftRefId;

    private void OnChequePhotosLoaded(List<VisOrderAttachmentDto> list) => chequePhotos = list ?? new();

    private void ToggleCash()
    {
        useCash = !useCash;
        if (!useCash && !HasNonCash) useCash = true;   // حداقل یک جزء باید بماند
    }

    private void ToggleCheque()
    {
        useCheque = !useCheque;
        if (useCheque && cheques.Count == 0) AddCheque();
    }

    private void ToggleInstallment()
    {
        useInstallment = !useInstallment;
        if (useInstallment && installments.Count == 0) BuildInstallments(silent: true);
    }

    private void ToggleCredit()
    {
        useCredit = !useCredit;
        if (useCredit && creditDue is null) creditDue = DateTime.Today.AddMonths(1);
    }

    private void OnCashAmountInput(ChangeEventArgs e) => cashAmountText = Fa.FormatTyping(e.Value?.ToString());

    private void AddCheque()
    {
        if (!useCheque) useCheque = true;
        var rest = PaymentRemaining;
        cheques.Add(new ChequeDto { Number = "", DueDate = DateTime.Today.AddMonths(2) });
        chequeAmounts.Add(rest > 0 ? Fa.FormatTyping(rest.ToString("0")) : "");
        chequeDates.Add(DateTime.Today.AddMonths(2));
    }

    private void RemoveCheque(int i)
    {
        if (i < 0 || i >= cheques.Count) return;
        cheques.RemoveAt(i); chequeAmounts.RemoveAt(i); chequeDates.RemoveAt(i);
    }

    private void RemoveInstallment(int i)
    {
        if (i < 0 || i >= installments.Count) return;
        installments.RemoveAt(i); instAmounts.RemoveAt(i); instDates.RemoveAt(i);
    }

    private void BuildInstallments(bool silent = false)
    {
        if (instCount < 1) { if (!silent) Toast.Error("تعداد قسط را وارد کنید."); return; }
        if (instFirstDue is null) instFirstDue = DateTime.Today.AddMonths(1);
        var payable = Math.Max(0, Net - CashPart - ChequeSum);
        if (payable <= 0) { if (!silent) Toast.Error("مبلغ قابل قسط‌بندی باقی نمانده است."); return; }

        installments.Clear(); instAmounts.Clear(); instDates.Clear();
        var per = Math.Round(payable / instCount);
        for (var i = 0; i < instCount; i++)
        {
            var amount = i == instCount - 1 ? payable - per * (instCount - 1) : per;
            var due = instFirstDue!.Value.Date.AddDays(instIntervalDays * i);
            installments.Add(new InstallmentDto { No = i + 1, Amount = amount, DueDate = due });
            instAmounts.Add(Fa.FormatTyping(amount.ToString("0")));
            instDates.Add(due);
        }
        if (!silent) Toast.Info($"{Fa.Digits(instCount)} قسط ساخته شد.");
    }

    /// <summary>
    /// پرداخت ترکیبی را روی فرمان سوار می‌کند و ایرادهای فرم را برمی‌گرداند (null = سالم).
    /// همین قواعد در سرور هم مستقلاً اعمال می‌شوند؛ اینجا فقط تجربهٔ کاربر بهتر می‌شود.
    /// </summary>
    private string? ApplyPaymentPlanToModel()
    {
        var total = Net;
        // اگر جزء دیگری فعال نیست، نقدی = کل مبلغ سفارش (همان قاعدهٔ سرور).
        var cash = HasNonCash ? CashPart : total;
        if (HasNonCash && cash > 0 && total > 0 && cash >= total)
            return "دریافت نقدی نمی‌تواند برابر یا بیشتر از مبلغ سفارش باشد؛ اگر تمام مبلغ نقدی است، جزء نقدی را تنها بگذارید.";
        var chequeSum = ChequeSum;
        var instSum = InstSum;
        var remaining = total - cash - chequeSum - instSum;

        var problem = SalesVisitPaymentPlan.ValidateCheques(useCheque, BuildChequeList());
        if (problem is not null) return problem;
        problem = SalesVisitPaymentPlan.ValidateInstallments(useInstallment, BuildInstallmentList());
        if (problem is not null) return problem;
        problem = SalesVisitPaymentPlan.ValidateRemainder(total, cash, chequeSum, instSum, useCredit, creditDue);
        if (problem is not null) return problem;

        // عکس چک برای نوع پرداخت چکی الزامی است (قاعدهٔ کارفرما).
        if ((useCheque || chequeSum > 0) && chequePhotos.Count == 0)
            return "نوع پرداخت چکی است؛ عکس چک را در بخش «عکس چک‌ها» بارگذاری کنید.";

        if (cash > 0 && trsAccountId is not > 0)
            return "برای دریافت نقدی، صندوق یا بانک را انتخاب کنید.";

        model.PaymentMethod = DeclaredMethod;
        model.CashAmount = cash;
        model.CashType = cash > 0 ? cashKind : null;
        model.TrsAccountId = cash > 0 ? trsAccountId : null;
        model.Cheques = useCheque ? BuildChequeList() : new List<ChequeDto>();
        model.Installments = useInstallment ? BuildInstallmentList() : new List<InstallmentDto>();
        model.DueDate = remaining > PaymentMix.Tolerance / 2 && useCredit ? creditDue?.Date : null;
        if (model.DueDate is null && remaining > PaymentMix.Tolerance / 2)
            return "تاریخ سررسید نسیه را وارد کنید.";
        model.ChequeAttachmentIds = chequePhotos.Select(p => p.Id).ToList();
        return null;
    }

    private List<ChequeDto> BuildChequeList()
    {
        var list = new List<ChequeDto>();
        for (var i = 0; i < cheques.Count; i++)
        {
            var amount = Fa.ParseDecimal(chequeAmounts.ElementAtOrDefault(i));
            var due = chequeDates.ElementAtOrDefault(i);
            if (string.IsNullOrWhiteSpace(cheques[i].Number) && amount <= 0) continue;   // سطر خالی نادیده گرفته می‌شود
            list.Add(new ChequeDto
            {
                Number = (cheques[i].Number ?? "").Trim(),
                BankName = cheques[i].BankName,
                OwnerName = cheques[i].OwnerName,
                AccountInfo = cheques[i].AccountInfo,
                TrsAccountId = cheques[i].TrsAccountId,
                Amount = amount,
                DueDate = due?.Date ?? default
            });
        }
        return list;
    }

    private List<InstallmentDto> BuildInstallmentList()
    {
        var list = new List<InstallmentDto>();
        for (var i = 0; i < installments.Count; i++)
        {
            var amount = Fa.ParseDecimal(instAmounts.ElementAtOrDefault(i));
            var due = instDates.ElementAtOrDefault(i);
            if (amount <= 0) continue;
            list.Add(new InstallmentDto { No = i + 1, Amount = amount, DueDate = due?.Date ?? default });
        }
        return list;
    }

    /// <summary>بارگذاری حساب‌های خزانه برای جزء نقدی (یک‌بار).</summary>
    private async Task EnsureAccountsAsync()
    {
        if (bankAccounts.Count > 0) return;
        try
        {
            bankAccounts = await AccountSvc.GetAllAsync(activeOnly: true) ?? new();
            var def = bankAccounts.FirstOrDefault(a => a.IsDefault) ?? bankAccounts.FirstOrDefault();
            trsAccountId ??= def?.Id;
        }
        catch { /* انتخاب حساب در فرم هم اختیاری است؛ سرور در ثبت نهایی کنترل می‌کند */ }
    }

    /// <summary>پیش‌فرض اجزای پرداخت از سفارش بارگذاری‌شده (ویرایش).</summary>
    private void LoadPaymentPlanFrom(VisOrderDto o)
    {
        useCheque = o.Cheques.Count > 0 || o.PaymentMethod is PaymentMethod.Cheque or PaymentMethod.Mixed;
        useInstallment = o.Installments.Count > 0 || o.PaymentMethod is PaymentMethod.Installment or PaymentMethod.Mixed;
        useCash = o.CashAmount > 0 || !HasNonCash;
        useCredit = o.PaymentMethod is PaymentMethod.Credit || o.CreditRemainder > PaymentMix.Tolerance / 2;
        cashKind = o.CashType ?? CashType.Cash;
        trsAccountId = o.TrsAccountId;
        cashAmountText = o.CashAmount > 0 ? Fa.FormatTyping(o.CashAmount.ToString("0")) : "";
        creditDue = o.DueDate?.Date ?? (useCredit ? DateTime.Today.AddMonths(1) : null);
        chequePhotos = o.ChequeAttachments.ToList();

        cheques.Clear(); chequeAmounts.Clear(); chequeDates.Clear();
        foreach (var c in o.Cheques)
        {
            cheques.Add(new ChequeDto
            {
                Id = c.Id, Number = c.Number, BankName = c.BankName, OwnerName = c.OwnerName,
                AccountInfo = c.AccountInfo, TrsAccountId = c.TrsAccountId, Amount = c.Amount, DueDate = c.DueDate
            });
            chequeAmounts.Add(c.Amount > 0 ? Fa.FormatTyping(c.Amount.ToString("0")) : "");
            chequeDates.Add(c.DueDate == default ? null : c.DueDate);
        }

        installments.Clear(); instAmounts.Clear(); instDates.Clear();
        foreach (var i in o.Installments.OrderBy(x => x.DueDate))
        {
            installments.Add(new InstallmentDto { Id = i.Id, No = installments.Count + 1, Amount = i.Amount, DueDate = i.DueDate });
            instAmounts.Add(i.Amount > 0 ? Fa.FormatTyping(i.Amount.ToString("0")) : "");
            instDates.Add(i.DueDate == default ? null : i.DueDate);
        }
        if (useInstallment && installments.Count > 0)
        {
            instCount = installments.Count;
            instFirstDue = instDates.FirstOrDefault() ?? DateTime.Today.AddMonths(1);
        }
    }

    private void ResetPaymentPlan()
    {
        useCash = true; useCheque = false; useInstallment = false; useCredit = false;
        cashKind = CashType.Cash;
        cashAmountText = "";
        creditDue = null;
        cheques.Clear(); chequeAmounts.Clear(); chequeDates.Clear();
        installments.Clear(); instAmounts.Clear(); instDates.Clear();
        chequePhotos = new();
        var def = bankAccounts.FirstOrDefault(a => a.IsDefault) ?? bankAccounts.FirstOrDefault();
        trsAccountId = def?.Id;
    }

    private static bool ExceedsCap(VisOrderLineDto line, decimal cap) => line.DiscountIsAmount
        ? LineDiscount(line) * 100m > line.Quantity * line.UnitPrice * cap
        : line.DiscountPercent > cap;
    private decimal Gross => model.Lines.Sum(l => l.Quantity * l.UnitPrice);
    private decimal Discount => model.Lines.Sum(LineDiscount);
    private decimal Net => Gross - Discount;
    private bool OverLimit => me?.IsSalesManager != true
                              && me != null
                              && model.Lines.Any(l => ExceedsCap(l, me.MaxDiscountPercent));

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle(Id > 0 ? "ویرایش سفارش" : "سفارش جدید");
        try
        {
            me = await Api.MeAsync();
            // پاسخ خالی/نامعتبر سرور نباید به NullReferenceException روی me.CanCreate
            // (و بعداً me.DefaultWarehouseId / me.ProductCount) تبدیل شود.
            if (me is null)
            {
                blocked = "اطلاعات دسترسی شما از سرور دریافت نشد؛ لطفاً یکبار این تب را بازسازی کنید.";
                loading = false;
                return;
            }

            // نقش تأییدکننده/مالی، نقش ثبت‌کننده نیست: مدیر فروش هیچ مسیر «ثبت سفارش جدید» ندارد.
            // (مدیر سیستم که هم Create دارد هم Approve، برای پشتیبانی از همین آدرس می‌تواند فرم را ببیند،
            //  ولی در منو و فهرست هیچ دکمهٔ «سفارش جدید» نمی‌بیند.)
            if (Id == 0 && !me.CanCreate)
            {
                blocked = me.CanApprove
                    ? "شما نقش تأییدکننده دارید و ثبت سفارش از طریق ویزیتور انجام می‌شود؛ برای بررسی و تأیید از «همهٔ درخواست‌ها» استفاده کنید."
                    : "مجوز «ثبت سفارش ویزیتوری» برای شما فعال نیست.";
                loading = false;
                return;
            }

            warehouses = await Api.WarehousesAsync() ?? new List<VisWarehouseLite>();
            await EnsureAccountsAsync();
            if (model.WarehouseId == 0) model.WarehouseId = me.DefaultWarehouseId;
            await ReloadProductLookupAsync();
            customers = await Api.CustomersAsync(null) ?? new List<VisCustomerLite>();
            RebuildCustomerLookup();

            if (Id > 0)
            {
                var o = await Api.GetAsync(Id);
                if (o is null)
                {
                    Toast.Error("سفارش یافت نشد.");
                    Nav.NavigateTo("/sales/visits");
                    return;
                }
                // ویزیتور فقط پیش‌نویس، برگشتی یا ارسال‌شده را می‌تواند ویرایش کند؛ مدیر در هر وضعیتی قبل از فاکتورشدن حق ویرایش دارد
                var canEditThis = me.CanApprove || me.IsAdmin
                    ? o.Status is VisOrderStatus.Draft or VisOrderStatus.Submitted or VisOrderStatus.Returned or VisOrderStatus.Approved
                    : o.Status is VisOrderStatus.Draft or VisOrderStatus.Returned or VisOrderStatus.Submitted;

                if (!canEditThis)
                {
                    Toast.Error("این سفارش در وضعیتی نیست که قابل ویرایش باشد.");
                    Nav.NavigateTo($"/sales/visits/{o.Id}");
                    return;
                }
                originalStatus = o.Status;
                model = new VisOrderCommand
                {
                    Id = o.Id,
                    Date = o.Date,
                    DeliveryDate = o.DeliveryDate,
                    PartyId = o.PartyId,
                    WarehouseId = o.WarehouseId,
                    PaymentMethod = o.PaymentMethod,
                    Note = o.Note,
                    Lines = (o.Lines ?? new List<VisOrderLineDto>()).ToList()
                };
                if (!customers.Any(c => c.Id == o.PartyId))
                    customers.Insert(0, new VisCustomerLite { Id = o.PartyId, Name = o.PartyName });

                LoadPaymentPlanFrom(o);
                orderDate = o.Date.Date;
                deliveryDate = (o.DeliveryDate ?? o.Date).Date;
                // سرچ سراسری حذف شده، پس فهرست کمبوی سطرها باید دقیقاً از انبار
                // واقعی سفارش باشد (پیش از لود سفارش، انبار پیشفرض بارگیری شده بود).
                await ReloadProductLookupAsync();
                if (!me.CanEditVisitPrice)
                {
                    var ids = model.Lines.Select(l => l.ProductId).Where(id => id > 0).Distinct().ToList();
                    try
                    {
                        var prices = (await Api.ProductPricesAsync(ids)).ToDictionary(p => p.Id, p => p.SalePrice);
                        if (ids.Any(id => !prices.ContainsKey(id)))
                            throw new InvalidOperationException("قیمت برخی کالاهای سفارش یافت نشد.");
                        foreach (var line in model.Lines.Where(l => l.ProductId > 0))
                        {
                            line.UnitPrice = prices[line.ProductId];
                            RecalcLine(line);
                        }
                    }
                    catch (Exception ex)
                    {
                        blocked = $"دریافت قیمت فروش ممکن نشد: {ex.Message}";
                        return;
                    }
                }
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    /// <summary>ساخت فهرست کالاهای انبار برای انتخابگر سطرها (مثل فرم فروش).</summary>
    private async Task ReloadProductLookupAsync()
    {
        if (model.WarehouseId <= 0) { productLookup = new(); zeroStockIds = new(); return; }
        try
        {
            var list = await Api.ProductsAsync(model.WarehouseId, null) ?? new List<VisProductLite>();
            productIndex = list.ToDictionary(p => p.Id);
            zeroStockIds = list.Where(p => !p.IsService && p.Stock <= 0).Select(p => p.Id).ToHashSet();
            productLookup = list.Select(p => new LookupItem
            {
                Id = p.Id,
                Name = string.IsNullOrWhiteSpace(p.Code) ? p.Name : $"{p.Code} — {p.Name}",
                InfoText = $"موجودی: {Fa.Number(p.Stock)} {p.Unit}"
            }).ToList();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>ساخت گزینه‌های کمبو؛ نام و موبایل با هم تا جستجو روی هر دو ممکن باشد.</summary>
    private void RebuildCustomerLookup()
    {
        customerLookup = customers.Select(c => new LookupItem
        {
            Id = c.Id,
            Name = string.IsNullOrWhiteSpace(c.Mobile) ? c.Name : $"{c.Name} — {c.Mobile}",
            InfoText = CustomerInfo(c)
        }).ToList();
    }

    /// <summary>زیرنویس مشتری در کمبو: تلفن و معرف ثبت‌شدهٔ مشتری، مستقل از ثبت‌کنندهٔ سفارش.</summary>
    private static string? CustomerInfo(VisCustomerLite c)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(c.Phone)) parts.Add($"تلفن: {c.Phone}");
        if (!string.IsNullOrWhiteSpace(c.ReferrerName))
            parts.Add($"معرف: {c.ReferrerName}");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>
    /// جستجوی مشتری داخل خود کمبو (سمت سرور): نام، موبایل یا تلفن.
    /// انتخابگر در حالت RemoteSearch کار می‌کند، پس هر متنی که کاربر تایپ کند به سرور می‌رود.
    /// </summary>
    private async Task SearchCustomersAsync(string? search)
    {
        _custDebounce?.Cancel();
        _custDebounce = new System.Threading.CancellationTokenSource();
        var token = _custDebounce.Token;
        try { await Task.Delay(250, token); if (token.IsCancellationRequested) return; }
        catch (TaskCanceledException) { return; }

        var selected = customers.FirstOrDefault(c => c.Id == model.PartyId);
        try
        {
            customers = await Api.CustomersAsync(search) ?? new List<VisCustomerLite>();
            // مشتری انتخاب‌شده حتی اگر در نتیجهٔ جستجو نباشد، باید در فهرست بماند تا نامش نمایش داده شود
            if (selected is not null && customers.All(c => c.Id != selected.Id))
                customers.Insert(0, selected);
            RebuildCustomerLookup();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>انتخاب مشتری از کمبوی جستجودار.</summary>
    private void OnCustomerPicked(int partyId) => model.PartyId = partyId;

    /// <summary>
    /// تنها راه افزودن سطر: دکمه/کلید میانبر F2. سطر خالی ساخته میشود و
    /// کمبوی درونسطری همان سطر بیدرنگ باز میشود (بدون نیاز به فوکوس/کلیک).
    /// سرچ سراسری کالا حذف شده است؛ فیلتر کردن فقط داخل کمبوی همان سطر انجام میشود.
    /// </summary>
    private void AddEmptyLine()
    {
        if (model.WarehouseId <= 0) { Toast.Error("ابتدا انبار را انتخاب کنید."); return; }

        var line = new VisOrderLineDto
        {
            ProductId = 0,
            ProductName = "",
            ProductCode = "",
            Unit = "",
            Quantity = 1,
            UnitPrice = 0,
            DiscountPercent = 0,
            DiscountAmount = 0,
            LineTotal = 0
        };
        model.Lines.Add(line);
        // منوی درونسطری همان سطر همان لحظه باز میشود: بدون فوکوس، بدون کیبورد موبایل،
        // بدون مختصات fixed → نه میپرد و نه بسته میشود.
        comboLine = line;
        comboQuery = "";
    }

    /// <summary>انتخاب کالا برای یک سطر (از انتخابگر داخل سطر).</summary>
    private void OnLineProductPicked(VisOrderLineDto line, int productId)
    {
        var p = productLookup.FirstOrDefault(x => x.Id == productId);
        // سرچ سراسری حذف شده: تنها منبع اطلاعات کالا، فهرست انبار است که
        // هنگام انتخاب انبار یکبار بارگیری میشود.
        var full = productIndex.TryGetValue(productId, out var cached) ? cached : null;

        if (productId <= 0)
        {
            line.ProductId = 0;
            line.ProductName = "";
            line.ProductCode = "";
            line.Unit = "";
            line.UnitPrice = 0;
            RecalcLine(line);
            return;
        }

        var name = full?.Name ?? p?.Name ?? "";
        // نام کالا در LookupItem به شکل «کد — نام» است؛ برای نمایش سطر، کد را جدا می‌کنیم
        line.ProductId = productId;
        line.ProductName = name;
        if (full is not null)
        {
            line.ProductCode = full.Code;
            line.Unit = full.Unit;
            line.UnitPrice = full.SalePrice;
        }
        if (full is not null && !productIndex.ContainsKey(productId)) productIndex[productId] = full;
        if (string.IsNullOrWhiteSpace(line.Unit)) line.Unit = "";
        if (line.Quantity <= 0) line.Quantity = 1;
        RecalcLine(line);

        // سطرهای دیگر نباید همان کالا را داشته باشند
        var dup = model.Lines.Where(l => !ReferenceEquals(l, line) && l.ProductId == productId).ToList();
        foreach (var d in dup) model.Lines.Remove(d);
    }

    /// <summary>تاریخ دریافت محصول پیش از تاریخ سفارش انتخاب شده است؟</summary>
    private bool DeliveryBeforeOrder
        => deliveryDate.HasValue && deliveryDate.Value.Date < (orderDate?.Date ?? DateTime.Today);

    /// <summary>نوع مقدار واحد کالا در این سطر (null = نامشخص یا کالا انتخاب نشده).</summary>
    private bool? UnitAllowsFraction(VisOrderLineDto line)
        => line.ProductId > 0 && productIndex.TryGetValue(line.ProductId, out var p) ? p.AllowsFractionalQuantity : null;

    private void SetQty(VisOrderLineDto line, string? value)
    {
        var parsed = Math.Max(0, Fa.ParseDecimal(value));
        // واحدِ «صحیح» اعشار نمی‌پذیرد: مقدار در همان لحظهٔ ورود به عدد صحیح گرد می‌شود
        // و ثبت نهایی هم در SaveAsync بررسی می‌شود.
        if (UnitAllowsFraction(line) == false && !ShopQuantityRules.IsWhole(parsed))
            Toast.Warning($"واحد «{line.Unit}» فقط مقدار صحیح می‌پذیرد؛ مقدار اعشاری ثبت نمی‌شود.");
        line.Quantity = UnitAllowsFraction(line) == false ? decimal.Truncate(parsed) : parsed;
        RecalcLine(line);
    }

    private void SetPrice(VisOrderLineDto line, string? value)
    {
        if (me?.CanEditVisitPrice != true) return;
        line.UnitPrice = Math.Max(0, Fa.ParseDecimal(value));
        RecalcLine(line);
    }

    /// <summary>قیمت واحد از کامپوننت MoneyInput (مقدار عددی آماده)</summary>
    private void SetPrice(VisOrderLineDto line, decimal value)
    {
        if (me?.CanEditVisitPrice != true) return;
        line.UnitPrice = Math.Max(0, value);
        RecalcLine(line);
    }

    private void SetDiscount(VisOrderLineDto line, string? value) => OnDiscountInput(line, value);

    /// <summary>
    /// تخفیف ریالی یک سطر — منبع واحد محاسبه در فرم.
    /// <para>قاعدهٔ ورود: عدد تا ۹۹ درصد است و از ۱۰۰ به بالا مبلغ ریالی؛ در حالت ریالی
    /// مبلغ بیش از جمع سطر پذیرفته نمی‌شود.</para>
    /// </summary>
    private static decimal LineDiscount(VisOrderLineDto line)
    {
        var gross = Round2(line.Quantity * line.UnitPrice);
        if (line.DiscountIsAmount)
            return Math.Clamp(Math.Round(line.DiscountAmount, 0), 0, Math.Max(0, gross));
        return Math.Round(gross * Math.Clamp(line.DiscountPercent, 0, 99) / 100m, 0);
    }

    private static void RecalcLine(VisOrderLineDto line)
    {
        var gross = Round2(line.Quantity * line.UnitPrice);
        var discount = LineDiscount(line);
        // درصد معادل برای نمایش و سنجش سقف مدیر
        line.DiscountPercent = line.DiscountIsAmount
            ? (gross > 0 ? Math.Round(discount * 100m / gross, 2) : 0)
            : Math.Clamp(line.DiscountPercent, 0, 99);
        line.DiscountAmount = discount;
        line.LineTotal = gross - discount;
    }

    /// <summary>متن نمایشی فیلد تخفیف: درصدی بدون جداکننده، ریالی با جداکنندهٔ سه‌رقمی.</summary>
    private static string DiscountText(VisOrderLineDto line)
        => line.DiscountIsAmount
            ? Fa.FormatTyping(line.DiscountAmount.ToString("0", System.Globalization.CultureInfo.InvariantCulture))
            : line.DiscountPercent.ToString("0.##");

    /// <summary>
    /// ورودی تخفیف — هستهٔ قاعدهٔ دو حالته.
    /// مقدار پاک‌شده اگر ≤ ۹۹ باشد درصد و از ۱۰۰ به بالا مبلغ ریالی در نظر گرفته می‌شود.
    /// چون مقدارها در DOM نگه‌داری می‌شوند (و نه با @bind)، تایپ کاربر وسط کار پرش نمی‌کند.
    /// </summary>
    private void OnDiscountInput(VisOrderLineDto line, string? raw)
    {
        var value = Math.Max(0, Fa.ParseDecimal(raw));
        if (value <= 99)
        {
            line.DiscountIsAmount = false;
            line.DiscountPercent = value;
            line.DiscountAmount = 0;
        }
        else
        {
            line.DiscountIsAmount = true;
            line.DiscountAmount = value;   // سقف با جمع سطر در RecalcLine اعمال می‌شود
        }
        RecalcLine(line);
    }

    /// <summary>پس از خروج از فیلد، متن با قالب درست (جداکننده/بدون جداکننده) بازنویسی می‌شود.</summary>
    private void OnDiscountBlur(VisOrderLineDto line)
    {
        RecalcLine(line);
        StateHasChanged();
    }

    private static decimal Round2(decimal v) => Math.Round(v, 2);

    // ================== آلارم کسری موجودی ==================
    /// <summary>پیام مسدود بودن فرم (نقش تأییدکننده یا نداشتن مجوز ثبت).</summary>
    private string? blocked;

    private bool showStockConfirm;
    private bool pendingSubmit;

    /// <summary>موجودی همین انبار برای کالای سطر (از فهرست کالاهای انبار).</summary>
    private decimal AvailableOf(VisOrderLineDto l)
        => l.ProductId > 0 && productIndex.TryGetValue(l.ProductId, out var p) ? p.Stock : 0m;

    /// <summary>مقدار کسری همان سطر (صفر = موجودی کافی است).</summary>
    private decimal ShortageOf(VisOrderLineDto l)
        => l.ProductId > 0 ? Math.Max(0, l.Quantity - AvailableOf(l)) : 0m;

    /// <summary>کالای انتخابشده (غیرخدماتی) در انبار جاری موجودی صفر دارد؛ مستقل از مقدار سطر،
    /// یعنی همان لحظهٔ انتخاب کالا آلارم میآید نه بعد از وارد کردن تعداد.</summary>
    private bool IsOutOfStock(VisOrderLineDto l)
        => l.ProductId > 0 && productIndex.TryGetValue(l.ProductId, out var p)
           && !p.IsService && p.Stock <= 0;
    private int ZeroStockCount => model.Lines.Count(IsOutOfStock);

    private sealed record ShortLine(VisOrderLineDto Line, decimal Available, decimal Shortage);

    /// <summary>سطرهای دارای کسری موجودی — برای آلارم ردیف و پنجرهٔ تأیید.</summary>
    private List<ShortLine> ShortLines => model.Lines
        .Where(l => l.ProductId > 0 && ShortageOf(l) > 0)
        .Select(l => new ShortLine(l, AvailableOf(l), ShortageOf(l)))
        .ToList();

    private string WarehouseName => warehouses.FirstOrDefault(w => w.Id == model.WarehouseId)?.Name ?? "—";

    /// <summary>انصراف در پنجرهٔ کسری: هیچ چیزی ذخیره نمی‌شود (کار متوقف می‌شود).</summary>
    private void CancelStockSave()
    {
        showStockConfirm = false;
        Toast.Info("ثبت سفارش متوقف شد؛ مقدار سفارش را با موجودی انبار متناسب کنید یا موجودی را تأمین کنید.");
    }

    /// <summary>تأیید کاربر روی آلارم کسری: ثبت سفارش ادامه پیدا می‌کند.</summary>
    private async Task ProceedWithShortage()
    {
        showStockConfirm = false;
        await DoSaveAsync(pendingSubmit);
    }

    private async Task SaveAsync(bool submit)
    {
        if (saving) return;
        // محافظ: اگر وضعیت سفارش عوض شده یا دکمهای قدیمی فراخوانی شده،
        // هیچگاه SubmitAfterSave=true برای سفارش در انتظار تأیید ارسال نشود.
        if (!CanSubmit) submit = false;
        if (model.PartyId <= 0) { Toast.Error("مشتری را انتخاب کنید."); return; }
        if (model.WarehouseId <= 0) { Toast.Error("انبار را انتخاب کنید."); return; }
        if (model.Lines.Count == 0) { Toast.Error("حداقل یک کالا اضافه کنید."); return; }
        if (model.Lines.Any(l => l.ProductId <= 0)) { Toast.Error("در هر سطر یک کالا انتخاب کنید (یا سطر خالی را حذف کنید)."); return; }
        if (model.Lines.Any(l => l.Quantity <= 0)) { Toast.Error("مقدار هر سطر باید بزرگ‌تر از صفر باشد."); return; }
        if (deliveryDate is null) { Toast.Error("تاریخ دریافت محصول را انتخاب کنید."); return; }
        if (DeliveryBeforeOrder)
        {
            Toast.Error($"تاریخ دریافت محصول ({deliveryDate.Value.ToFa()}) نمی‌تواند پیش از تاریخ سفارش ({orderDate?.Date.ToFa()}) باشد.");
            return;
        }

        // نوع مقدار کالا: واحدِ «صحیح» اعشار نمی‌پذیرد و واحدِ نامشخص باید تعیین شود.
        foreach (var line in model.Lines.Where(l => l.ProductId > 0))
        {
            // فقط قاعدهٔ صریح «فقط صحیح» مانع ثبت است؛ واحد نامشخص جلوی ثبت را نمی‌گیرد.
            if (UnitAllowsFraction(line) == false && !ShopQuantityRules.IsWhole(line.Quantity))
            {
                Toast.Error($"مقدار «{line.ProductName}» با واحد «{line.Unit}» باید عدد صحیح باشد؛ مقدار اعشاری مجاز نیست.");
                return;
            }
        }

        // فقط نقش فعال مدیر فروش از سقف تخفیف مستثناست.
        if (me?.IsSalesManager != true && me != null)
        {
            var invalidLine = model.Lines.FirstOrDefault(l => ExceedsCap(l, me.MaxDiscountPercent));
            if (invalidLine is not null)
            {
                Toast.Error($"درصد تخفیف سطر «{invalidLine.ProductName}» ({Fa.Digits(invalidLine.DiscountPercent)}٪) بیش از سقف مجاز شما ({Fa.Digits(me.MaxDiscountPercent)}٪) است.");
                return;
            }
        }

        // پرداخت ترکیبی: اعتبارسنجی اجزا پیش از هر ثبت (همان قواعد سرور).
        var paymentProblem = ApplyPaymentPlanToModel();
        if (paymentProblem is not null) { Toast.Error(paymentProblem); return; }

        // آلارم کسری موجودی: کاربر باید صریحاً تأیید کند، وگرنه ثبت متوقف می‌شود
        if (ShortLines.Count > 0)
        {
            pendingSubmit = submit;
            showStockConfirm = true;
            return;
        }

        await DoSaveAsync(submit);
    }

    private async Task DoSaveAsync(bool submit)
    {
        if (saving) return;
        saving = true;
        try
        {
            model.Date = orderDate?.Date ?? DateTime.Today;
            model.DeliveryDate = deliveryDate?.Date ?? DateTime.Today;
            model.SubmitAfterSave = submit && CanSubmit;
            var saved = await Api.SaveAsync(model);
            // سرور ممکن است بدنهٔ خالی/null بفرستد (ApiClient در آن حالت default!
            // برمیگرداند). بدون این نالچک، saved.Number دقیقاً همان
            // NullReferenceException گزارششده هنگام «ثبت سفارش» است.
            if (saved is null)
            {
                Toast.Error("نتیجهٔ ثبت سفارش از سرور دریافت نشد؛ پیش از تکرار، فهرست سفارشها را بازخوانی کنید (ممکن است سفارش ثبت شده باشد).");
                return;
            }
            lastSubmitted = submit && CanSubmit;
            Toast.Success(lastSubmitted
                ? $"سفارش {saved.Number} برای تأیید مدیر فروش ارسال شد."
                : $"پیش‌نویس سفارش {saved.Number} ذخیره شد.");

            if (Id > 0)
            {
                // ویرایش سفارش موجود: بازگشت به همان سفارش
                Nav.NavigateTo($"/sales/visits/{saved.Id}");
                return;
            }

            // سفارش جدید: فرم پاک می‌شود تا بلافاصله سفارش بعدی ثبت شود (بدون رفتن به صفحهٔ دیگر)
            lastSaved = saved;
            await ResetForNextOrderAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    /// <summary>پس از ثبت سفارش: پاک‌سازی کامل فرم برای سفارش بعدی (انبار انتخاب‌شده می‌ماند تا ثبت سریع‌تر شود).</summary>
    private async Task ResetForNextOrderAsync()
    {
        model = new VisOrderCommand
        {
            Date = DateTime.Today,
            DeliveryDate = DateTime.Today,
            WarehouseId = model.WarehouseId
        };
        ResetPaymentPlan();
        orderDate = DateTime.Today;
        deliveryDate = DateTime.Today;
        originalStatus = null;
        CloseCombo();
        formKey++;   // انتخابگر مشتری از نو ساخته می‌شود (متن قبلی پاک می‌شود)
        try { customers = await Api.CustomersAsync(null) ?? customers; }
        catch { /* فهرست قبلی کافی است */ }
        RebuildCustomerLookup();
        await ReloadProductLookupAsync();
    }

    private void OpenLastSaved()
    {
        if (lastSaved is not null) Nav.NavigateTo($"/sales/visits/{lastSaved.Id}");
    }

    /// <summary>باز کردن «فرم تعریف مشتری» — همان فرم واقعی طرف حساب.</summary>
    private void OpenCustomer() => showCustomerForm = true;

    private void CloseCustomer() => showCustomerForm = false;

    /// <summary>پس از ثبت مشتری در فرم واقعی طرف حساب: انتخاب خودکار و تازه‌سازی فهرست.</summary>
    private async Task OnCustomerSaved(Party created)
    {
        showCustomerForm = false;
        if (created is null) { Toast.Error("مشتری جدید ثبت شد ولی اطلاعات آن دریافت نشد؛ از فهرست انتخاب کنید."); return; }
        try { customers = await Api.CustomersAsync(null) ?? customers; }
        catch (Exception ex) { Toast.Error(ex.Message); }
        model.PartyId = created.Id;
        if (!customers.Any(c => c.Id == created.Id))
            customers.Insert(0, new VisCustomerLite { Id = created.Id, Name = created.Name, Mobile = created.Mobile, Phone = created.Phone, Address = created.Address });
        RebuildCustomerLookup();
        Toast.Success($"مشتری «{created.Name}» در تعریف مشتریان ثبت شد و انتخاب شد.");
    }
}
