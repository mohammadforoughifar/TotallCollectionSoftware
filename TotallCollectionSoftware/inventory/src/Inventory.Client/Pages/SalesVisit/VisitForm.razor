}
.vis-form .vis-action-btns .btn:hover:not(:disabled) { transform: translateY(-1px); }
.vis-form .vis-action-note { margin: 0; font-size: .72rem; color: var(--vis-muted); }
.vis-form .vis-status-note { font-size: .74rem; line-height: 1.7; margin-top: var(--vis-gap); }
/* ---------- تراکم پیوسته: هرچی نما کوچیکتر، باکسها و ردیفها کوچیکتر ----------
   برخلاف نسخهٔ قبل (دو مقدار ثابت .5rem/.4rem)، همهٔ توکنها با clamp()+vw ساخته
   شدند: از ۱۰۸۰px تا ۳۲۰px نرم کوچک میشوند تا کاربر مجبور نباشد زیاد اسکرول کند.
   منوی کمبوی کالاها همچنان درونسطری و بدون اسکرول داخلی باقی میماند. */
@@media (max-width: 1080px) {
    .vis-form {
        --vis-gap: clamp(.26rem, calc(.55vw + .16rem), .5rem);
        --vis-gap-sm: clamp(.14rem, calc(.3vw + .09rem), .28rem);
        --vis-pad: clamp(.34rem, calc(.72vw + .22rem), .6rem);
        --vis-radius: clamp(8px, calc(.9vw + 5px), 11px);
        /* کوچک میشود ولی هیچگاه کمتر از ۶٫۷px نمیشود */
        --vis-icon-gap: clamp(.42rem, calc(.2vw + .36rem), .6rem);
        --vis-ctl-f: clamp(.66rem, calc(.5vw + .5rem), .76rem);
        --vis-ctl-h: clamp(26px, calc(2.5vw + 17px), 34px);
        line-height: 1.32;
    }
    .vis-form > .fin-header .text-secondary,
    .vis-form .vis-card-hint,
    .vis-form .vis-date-note,
    .vis-form .vis-minor,
    .vis-form .vis-action-note { display: none; }
    .vis-form .fin-header { padding: var(--vis-pad); }
    .vis-form .fin-header h1 { font-size: clamp(.82rem, calc(.6vw + .64rem), .94rem); }
    .vis-form .fin-header-icon {
        width: clamp(30px, calc(3vw + 20px), 42px); height: clamp(30px, calc(3vw + 20px), 42px);
        border-radius: var(--vis-radius); font-size: clamp(1rem, calc(1vw + .8rem), 1.3rem);
    }
    .vis-form .card-header.vis-card-header { padding: var(--vis-pad) var(--vis-pad); }
    .vis-form .card-header.vis-card-header .card-title { font-size: clamp(.7rem, calc(.5vw + .54rem), .78rem); }
    .vis-form .card-body { padding: var(--vis-pad); }
    .vis-form .vis-stack { gap: var(--vis-gap) !important; }

    /* همهٔ باکسها همقدم با عرض نما کوچک میشوند */
    .vis-form .form-label {
        font-size: clamp(.56rem, calc(.4vw + .46rem), .66rem);
        margin-bottom: var(--vis-gap-sm);
    }
    .vis-form .form-control, .vis-form .form-select, .vis-form .vis-combo-ctl {
        font-size: var(--vis-ctl-f);
        min-height: var(--vis-ctl-h);
        padding: var(--vis-gap-sm) var(--vis-pad);
        border-radius: var(--vis-radius);
    }
    .vis-form .vis-combo-input {
        padding: var(--vis-gap-sm) .1rem !important;
        font-size: var(--vis-ctl-f) !important; min-height: var(--vis-ctl-h);
    }
    .vis-form .vis-field-note { font-size: clamp(.56rem, calc(.4vw + .46rem), .64rem); margin-top: var(--vis-gap-sm); }

    /* ردیف کالا: ۲ ستونهٔ خوانا + برچسب کنار ورودی (دیگر هر سلول دو خط عمودی نیست) */
    .vis-form .vis-lines-head { display: none; }
    .vis-form .vis-line {
        position: relative;
        grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
        grid-template-areas: "name name" "qty price" "disc total" !important;
        row-gap: var(--vis-gap-sm);
        padding: var(--vis-gap-sm);
        padding-inline-end: calc(var(--vis-ctl-h) + var(--vis-gap-sm));
        border-radius: var(--vis-radius);
    }
    .vis-form .vis-line:hover { transform: none; }
    .vis-form .c-name { grid-area: name; }
    .vis-form .c-qty { grid-area: qty; }
    .vis-form .c-price { grid-area: price; }
    .vis-form .c-disc { grid-area: disc; }
    .vis-form .c-total { grid-area: total; }
    .vis-form .c-del {
        grid-area: auto; position: absolute; inset-inline-end: var(--vis-gap-sm); top: var(--vis-gap-sm);
        width: var(--vis-ctl-h); height: var(--vis-ctl-h);
    }
    .vis-form .vis-del-btn { width: 100%; height: 100%; padding: 0; display: grid; place-items: center; font-size: var(--vis-ctl-f); }
    .vis-form .vis-line .vis-cell:not(.c-name):not(.c-del) {
        display: flex; align-items: center; flex-wrap: wrap; gap: var(--vis-icon-gap);
    }
    .vis-form .vis-line .vis-cell > .vis-cell-label {
        display: block; flex: 0 0 auto; max-width: 44%;
        font-size: clamp(.48rem, calc(.32vw + .4rem), .56rem); line-height: 1.1;
        margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
    }
    .vis-form .vis-line .vis-cell > .form-control,
    .vis-form .vis-line .vis-cell > .input-group,
    .vis-form .vis-line .vis-cell > .vis-line-total {
        flex: 1 1 45%; min-width: 0; margin: 0;
        font-size: var(--vis-ctl-f); min-height: var(--vis-ctl-h);
        padding: var(--vis-gap-sm) var(--vis-gap-sm);
    }
    .vis-form .vis-line .vis-cell > .vis-cell-note { flex: 1 1 100%; }
    .vis-form .vis-line .input-group-text { font-size: clamp(.54rem, calc(.4vw + .44rem), .66rem); padding: 0 var(--vis-gap-sm); }
    .vis-form .vis-combo-selected { font-size: clamp(.56rem, calc(.4vw + .46rem), .66rem); margin-top: var(--vis-gap-sm); }
    .vis-form .card-header.vis-card-header,
    .vis-form .vis-combo-ctl,
    .vis-form .vis-card-actions,
    .vis-form .btn { gap: var(--vis-icon-gap); }
    .vis-form .vis-combo-menu { margin-top: var(--vis-gap-sm); padding: var(--vis-gap-sm); }
    .vis-form .vis-combo-opt {
        padding: var(--vis-gap-sm) var(--vis-gap-sm);
        font-size: var(--vis-ctl-f);
    }
    .vis-form .vis-combo-opt small { display: none; }
    .vis-form .vis-cell-note { font-size: clamp(.52rem, calc(.36vw + .44rem), .6rem); margin-top: 0; }
    .vis-form .vis-line-total small,
    .vis-form .vis-kpi small { display: none; }

    .vis-form .vis-review { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; gap: var(--vis-gap-sm); }
    .vis-form .vis-kpi { padding: var(--vis-gap-sm) var(--vis-pad); }
    .vis-form .vis-kpi > span { font-size: clamp(.5rem, calc(.35vw + .42rem), .58rem); }
    .vis-form .vis-kpi > b { font-size: clamp(.62rem, calc(.5vw + .48rem), .76rem); }
    .vis-form .vis-kpi-total > b { font-size: clamp(.72rem, calc(.6vw + .56rem), .88rem); }

    .vis-form .vis-empty { padding: var(--vis-gap) var(--vis-pad); }
    .vis-form .vis-empty-ico { width: clamp(32px, calc(4vw + 24px), 44px); height: clamp(32px, calc(4vw + 24px), 44px); font-size: 1rem; }
    .vis-form .vis-empty h6 { font-size: clamp(.76rem, calc(.5vw + .58rem), .85rem); }
    .vis-form .vis-empty p { font-size: clamp(.6rem, calc(.4vw + .5rem), .68rem); }

    /* نوار اقدام چسبان بازگشت: کاربر برای رسیدن به دکمهها نباید تا ته اسکرول کند.
       فقط وقتی نوار پایین اپ هست، بالاتر از آن (۶۲px) میایستد تا تداخل پیش نیاید. */
    .vis-form .vis-actionbar {
        position: sticky; bottom: 0; z-index: 20; background: #fff;
        flex-direction: column; align-items: stretch; gap: var(--vis-gap-sm);
        padding: var(--vis-gap-sm); border-radius: var(--vis-radius);
        box-shadow: 0 -6px 20px -8px rgba(15, 23, 42, .18);
    }
    .app-mobile .vis-form .vis-actionbar { bottom: calc(62px + env(safe-area-inset-bottom, 0px)); }
    .vis-form .vis-action-btns { flex-direction: row; gap: var(--vis-gap-sm); }
    .vis-form .vis-action-btns .btn { flex: 1 1 0; padding: var(--vis-gap-sm); font-size: var(--vis-ctl-f); }
    .vis-form .vis-status-note { padding: var(--vis-gap-sm) var(--vis-pad); font-size: clamp(.56rem, calc(.4vw + .46rem), .64rem); }
}
@@media (max-width: 720px) {
    .vis-form { line-height: 1.28; }
    /* سه فیلد کوتاه (روش پرداخت / تاریخ سفارش / تاریخ تحویل) دوتایی میشوند */
    .vis-form .vis-grid > .vis-field.vis-field--sm {
        width: 50% !important; flex: 0 0 50% !important; max-width: 50% !important;
    }
    .vis-form .vis-grid > .vis-field.vis-field--sm:last-of-type { width: 50% !important; }
    .vis-form .fin-header .badge,
    .vis-form .vis-counter { font-size: .6rem; }
    .vis-form .vis-kpi { padding: var(--vis-gap-sm); }
}
</style>

@code {
    [Parameter] public int Id { get; set; }

    private bool loading = true;
    private bool saving;
    private bool showCustomerForm;

    private VisActorInfo? me;
    private VisOrderCommand model = new() { Date = DateTime.Now };

    /// <summary>وضعیت سفارش هنگام باز کردن فرم ویرایش — برای تصمیم دربارهٔ دکمهٔ ارسال.</summary>
    private VisOrderStatus? originalStatus;

    /// <summary>
    /// فقط پیشنویس و سفارش برگشتی قابل ارسال است. سفارش «در انتظار تأیید» قبلاً
    /// ارسال شده و ارسال مجدد هم در سرور رد میشود؛ پس دکمهٔ ارسال نمایش داده نمیشود.
    /// </summary>
    private bool CanSubmit => Id == 0
        || originalStatus is null or VisOrderStatus.Draft or VisOrderStatus.Returned;

    /// <summary>آخرین سفارشِ ثبت‌شده در همین صفحه — بعد از ثبت، فرم پاک می‌شود تا سفارش بعدی زده شود.</summary>
    private VisOrderDto? lastSaved;

    /// <summary>آیا سفارش آخر ارسال شد یا فقط پیشنویس ذخیره شد (متن بنر موفقیت).</summary>
    private bool lastSubmitted;

    /// <summary>کلید بازسازی کنترل‌ها — با پاک‌سازی فرم زیاد می‌شود تا متن انتخابگرها هم خالی شود.</summary>
    private int formKey;

    /// <summary>تاریخ سفارش (شمسی در UI) — پیش‌فرض امروز</summary>
    private DateTime? orderDate = DateTime.Today;

    /// <summary>تاریخ درخواستی دریافت محصول — پیش‌فرض امروز</summary>
    private DateTime? deliveryDate = DateTime.Today;
    private List<VisWarehouseLite> warehouses = new();
    private List<VisCustomerLite> customers = new();

    /// <summary>گزینه‌های کمبوی مشتری (نام — موبایل) برای انتخابگر جستجودار.</summary>
    private List<LookupItem> customerLookup = new();

    private System.Threading.CancellationTokenSource? _custDebounce;

    /// <summary>فهرست کالاهای انبار برای انتخابگر داخل سطر (در تغییر انبار تازه می‌شود).</summary>
    private List<LookupItem> productLookup = new();

    /// <summary>فهرست کامل کالاهای انبار بر اساس شناسه — برای پر کردن قیمت/واحد سطر پس از انتخاب.</summary>
    private Dictionary<int, VisProductLite> productIndex = new();

    /// <summary>سطری که کمبوی درونسطریاش باز است (فقط یکی، چون منوها صفحه را رشد میدهند).</summary>
    private VisOrderLineDto? comboLine;
    private string comboQuery = "";

    private bool IsComboOpen(VisOrderLineDto l) => ReferenceEquals(l, comboLine);
    private string ComboText(VisOrderLineDto l)
        => IsComboOpen(l) ? comboQuery : (l.ProductName ?? "");

    /// <summary>حداکثر ۵ گزینه؛ بدون max-height/overflow یعنی بدون اسکرول داخلی.</summary>
    private List<LookupItem> ComboMatches()
    {
        var q = (comboQuery ?? "").Trim();
        return productLookup
            .Where(x => q.Length == 0 || x.Name.Contains(q) || (x.InfoText ?? "").Contains(q))
            .Take(5).ToList();
    }

    private void OpenCombo(VisOrderLineDto l) { comboLine = l; comboQuery = ""; }
    private void CloseCombo() { comboLine = null; comboQuery = ""; }
    private void OnComboInput(VisOrderLineDto l, string? value)
    {
        comboLine = l;
        comboQuery = value ?? "";
    }
    private void OnComboKey(VisOrderLineDto l, KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { CloseCombo(); return; }
        if (e.Key != "Enter") return;
        var matches = ComboMatches();
        if (matches.Count > 0) PickCombo(l, matches[0].Id);
    }
    private void PickCombo(VisOrderLineDto l, int productId)
    {
        OnLineProductPicked(l, productId);
        CloseCombo();
    }

    private decimal Gross => model.Lines.Sum(l => l.Quantity * l.UnitPrice);
    private decimal Discount => model.Lines.Sum(LineDiscount);
    private decimal Net => Gross - Discount;
    private bool OverLimit => me?.CanApprove != true && me?.IsAdmin != true
                              && me?.MaxDiscountPercent > 0
                              && model.Lines.Any(l => l.DiscountPercent > me.MaxDiscountPercent);

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle(Id > 0 ? "ویرایش سفارش" : "سفارش جدید");
        try
        {
            me = await Api.MeAsync();
            // پاسخ خالی/نامعتبر سرور نباید به NullReferenceException روی me.CanCreate
            // (و بعداً me.DefaultWarehouseId / me.ProductCount) تبدیل شود.
            if (me is null)
            {
                blocked = "اطلاعات دسترسی شما از سرور دریافت نشد؛ لطفاً یکبار این تب را بازسازی کنید.";
                loading = false;
                return;
            }

            // نقش تأییدکننده/مالی، نقش ثبت‌کننده نیست: مدیر فروش هیچ مسیر «ثبت سفارش جدید» ندارد.
            // (مدیر سیستم که هم Create دارد هم Approve، برای پشتیبانی از همین آدرس می‌تواند فرم را ببیند،
            //  ولی در منو و فهرست هیچ دکمهٔ «سفارش جدید» نمی‌بیند.)
            if (Id == 0 && !me.CanCreate)
            {
                blocked = me.CanApprove
                    ? "شما نقش تأییدکننده دارید و ثبت سفارش از طریق ویزیتور انجام می‌شود؛ برای بررسی و تأیید از «همهٔ درخواست‌ها» استفاده کنید."
                    : "مجوز «ثبت سفارش ویزیتوری» برای شما فعال نیست.";
                loading = false;
                return;
            }

            warehouses = await Api.WarehousesAsync() ?? new List<VisWarehouseLite>();
            if (model.WarehouseId == 0) model.WarehouseId = me.DefaultWarehouseId;
            await ReloadProductLookupAsync();
            customers = await Api.CustomersAsync(null) ?? new List<VisCustomerLite>();
            RebuildCustomerLookup();

            if (Id > 0)
            {
                var o = await Api.GetAsync(Id);
                if (o is null)
                {
                    Toast.Error("سفارش یافت نشد.");
                    Nav.NavigateTo("/sales/visits");
                    return;
                }
                // ویزیتور فقط پیش‌نویس، برگشتی یا ارسال‌شده را می‌تواند ویرایش کند؛ مدیر در هر وضعیتی قبل از فاکتورشدن حق ویرایش دارد
                var canEditThis = me.CanApprove || me.IsAdmin
                    ? o.Status is VisOrderStatus.Draft or VisOrderStatus.Submitted or VisOrderStatus.Returned or VisOrderStatus.Approved
                    : o.Status is VisOrderStatus.Draft or VisOrderStatus.Returned or VisOrderStatus.Submitted;

                if (!canEditThis)
                {
                    Toast.Error("این سفارش در وضعیتی نیست که قابل ویرایش باشد.");
                    Nav.NavigateTo($"/sales/visits/{o.Id}");
                    return;
                }
                originalStatus = o.Status;
                model = new VisOrderCommand
                {
                    Id = o.Id,
                    Date = o.Date,
                    DeliveryDate = o.DeliveryDate,
                    PartyId = o.PartyId,
                    WarehouseId = o.WarehouseId,
                    PaymentMethod = o.PaymentMethod,
                    Note = o.Note,
                    Lines = (o.Lines ?? new List<VisOrderLineDto>()).ToList()
                };
                if (!customers.Any(c => c.Id == o.PartyId))
                    customers.Insert(0, new VisCustomerLite { Id = o.PartyId, Name = o.PartyName });

                orderDate = o.Date.Date;
                deliveryDate = (o.DeliveryDate ?? o.Date).Date;
                // سرچ سراسری حذف شده، پس فهرست کمبوی سطرها باید دقیقاً از انبار
                // واقعی سفارش باشد (پیش از لود سفارش، انبار پیشفرض بارگیری شده بود).
                await ReloadProductLookupAsync();
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    /// <summary>ساخت فهرست کالاهای انبار برای انتخابگر سطرها (مثل فرم فروش).</summary>
    private async Task ReloadProductLookupAsync()
    {
        if (model.WarehouseId <= 0) { productLookup = new(); return; }
        try
        {
            var list = await Api.ProductsAsync(model.WarehouseId, null) ?? new List<VisProductLite>();
            productIndex = list.ToDictionary(p => p.Id);
            productLookup = list.Select(p => new LookupItem
            {
                Id = p.Id,
                Name = string.IsNullOrWhiteSpace(p.Code) ? p.Name : $"{p.Code} — {p.Name}",
                InfoText = $"موجودی: {Fa.Number(p.Stock)} {p.Unit}"
            }).ToList();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>ساخت گزینه‌های کمبو؛ نام و موبایل با هم تا جستجو روی هر دو ممکن باشد.</summary>
    private void RebuildCustomerLookup()
    {
        customerLookup = customers.Select(c => new LookupItem
        {
            Id = c.Id,
            Name = string.IsNullOrWhiteSpace(c.Mobile) ? c.Name : $"{c.Name} — {c.Mobile}",
            InfoText = CustomerInfo(c)
        }).ToList();
    }

    /// <summary>زیرنویس مشتری در کمبو: تلفن + ویزیتورِ مسئول (اگر مشتریِ ویزیتور دیگری در همین شرکت باشد).</summary>
    private static string? CustomerInfo(VisCustomerLite c)
    {
        var parts = new List<string>();
        if (!string.IsNullOrWhiteSpace(c.Phone)) parts.Add($"تلفن: {c.Phone}");
        if (!string.IsNullOrWhiteSpace(c.ReferrerName))
            parts.Add(c.OwnedByMe ? "پروندهٔ شما" : $"ویزیتور: {c.ReferrerName}");
        return parts.Count == 0 ? null : string.Join(" · ", parts);
    }

    /// <summary>
    /// جستجوی مشتری داخل خود کمبو (سمت سرور): نام، موبایل یا تلفن.
    /// انتخابگر در حالت RemoteSearch کار می‌کند، پس هر متنی که کاربر تایپ کند به سرور می‌رود.
    /// </summary>
    private async Task SearchCustomersAsync(string? search)
    {
        _custDebounce?.Cancel();
        _custDebounce = new System.Threading.CancellationTokenSource();
        var token = _custDebounce.Token;
        try { await Task.Delay(250, token); if (token.IsCancellationRequested) return; }
        catch (TaskCanceledException) { return; }

        var selected = customers.FirstOrDefault(c => c.Id == model.PartyId);
        try
        {
            customers = await Api.CustomersAsync(search) ?? new List<VisCustomerLite>();
            // مشتری انتخاب‌شده حتی اگر در نتیجهٔ جستجو نباشد، باید در فهرست بماند تا نامش نمایش داده شود
            if (selected is not null && customers.All(c => c.Id != selected.Id))
                customers.Insert(0, selected);
            RebuildCustomerLookup();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>انتخاب مشتری از کمبوی جستجودار.</summary>
    private void OnCustomerPicked(int partyId) => model.PartyId = partyId;

    /// <summary>
    /// تنها راه افزودن سطر: دکمه/کلید میانبر F2. سطر خالی ساخته میشود و
    /// کمبوی درونسطری همان سطر بیدرنگ باز میشود (بدون نیاز به فوکوس/کلیک).
    /// سرچ سراسری کالا حذف شده است؛ فیلتر کردن فقط داخل کمبوی همان سطر انجام میشود.
    /// </summary>
    private void AddEmptyLine()
    {
        if (model.WarehouseId <= 0) { Toast.Error("ابتدا انبار را انتخاب کنید."); return; }

        var line = new VisOrderLineDto
        {
            ProductId = 0,
            ProductName = "",
            ProductCode = "",
            Unit = "",
            Quantity = 1,
            UnitPrice = 0,
            DiscountPercent = 0,
            DiscountAmount = 0,
            LineTotal = 0
        };
        model.Lines.Add(line);
        // منوی درونسطری همان سطر همان لحظه باز میشود: بدون فوکوس، بدون کیبورد موبایل،
        // بدون مختصات fixed → نه میپرد و نه بسته میشود.
        comboLine = line;
        comboQuery = "";
    }

    /// <summary>انتخاب کالا برای یک سطر (از انتخابگر داخل سطر).</summary>
    private void OnLineProductPicked(VisOrderLineDto line, int productId)
    {
        var p = productLookup.FirstOrDefault(x => x.Id == productId);
        // سرچ سراسری حذف شده: تنها منبع اطلاعات کالا، فهرست انبار است که
        // هنگام انتخاب انبار یکبار بارگیری میشود.
        var full = productIndex.TryGetValue(productId, out var cached) ? cached : null;

        if (productId <= 0)
        {
            line.ProductId = 0;
            line.ProductName = "";
            line.ProductCode = "";
            line.Unit = "";
            line.UnitPrice = 0;
            RecalcLine(line);
            return;
        }

        var name = full?.Name ?? p?.Name ?? "";
        // نام کالا در LookupItem به شکل «کد — نام» است؛ برای نمایش سطر، کد را جدا می‌کنیم
        line.ProductId = productId;
        line.ProductName = name;
        if (full is not null)
        {
            line.ProductCode = full.Code;
            line.Unit = full.Unit;
            line.UnitPrice = full.SalePrice;
        }
        if (full is not null && !productIndex.ContainsKey(productId)) productIndex[productId] = full;
        if (string.IsNullOrWhiteSpace(line.Unit)) line.Unit = "";
        if (line.Quantity <= 0) line.Quantity = 1;
        RecalcLine(line);

        // سطرهای دیگر نباید همان کالا را داشته باشند
        var dup = model.Lines.Where(l => !ReferenceEquals(l, line) && l.ProductId == productId).ToList();
        foreach (var d in dup) model.Lines.Remove(d);
    }

    private void SetQty(VisOrderLineDto line, string? value)
    {
        line.Quantity = Math.Max(0, Fa.ParseDecimal(value));
        RecalcLine(line);
    }

    private void SetPrice(VisOrderLineDto line, string? value)
    {
        line.UnitPrice = Math.Max(0, Fa.ParseDecimal(value));
        RecalcLine(line);
    }

    /// <summary>قیمت واحد از کامپوننت MoneyInput (مقدار عددی آماده)</summary>
    private void SetPrice(VisOrderLineDto line, decimal value)
    {
        line.UnitPrice = Math.Max(0, value);
        RecalcLine(line);
    }

    private void SetDiscount(VisOrderLineDto line, string? value) => OnDiscountInput(line, value);

    /// <summary>
    /// تخفیف ریالی یک سطر — منبع واحد محاسبه در فرم.
    /// <para>قاعدهٔ ورود: عدد تا ۹۹ درصد است و از ۱۰۰ به بالا مبلغ ریالی؛ در حالت ریالی
    /// مبلغ بیش از جمع سطر پذیرفته نمی‌شود.</para>
    /// </summary>
    private static decimal LineDiscount(VisOrderLineDto line)
    {
        var gross = Round2(line.Quantity * line.UnitPrice);
        if (line.DiscountIsAmount)
            return Math.Clamp(Math.Round(line.DiscountAmount, 0), 0, Math.Max(0, gross));
        return Math.Round(gross * Math.Clamp(line.DiscountPercent, 0, 99) / 100m, 0);
    }

    private static void RecalcLine(VisOrderLineDto line)
    {
        var gross = Round2(line.Quantity * line.UnitPrice);
        var discount = LineDiscount(line);
        // درصد معادل برای نمایش و سنجش سقف مدیر
        line.DiscountPercent = line.DiscountIsAmount
            ? (gross > 0 ? Math.Round(discount * 100m / gross, 2) : 0)
            : Math.Clamp(line.DiscountPercent, 0, 99);
        line.DiscountAmount = discount;
        line.LineTotal = gross - discount;
    }

    /// <summary>متن نمایشی فیلد تخفیف: درصدی بدون جداکننده، ریالی با جداکنندهٔ سه‌رقمی.</summary>
    private static string DiscountText(VisOrderLineDto line)
        => line.DiscountIsAmount
            ? Fa.FormatTyping(line.DiscountAmount.ToString("0", System.Globalization.CultureInfo.InvariantCulture))
            : line.DiscountPercent.ToString("0.##");

    /// <summary>
    /// ورودی تخفیف — هستهٔ قاعدهٔ دو حالته.
    /// مقدار پاک‌شده اگر ≤ ۹۹ باشد درصد و از ۱۰۰ به بالا مبلغ ریالی در نظر گرفته می‌شود.
    /// چون مقدارها در DOM نگه‌داری می‌شوند (و نه با @bind)، تایپ کاربر وسط کار پرش نمی‌کند.
    /// </summary>
    private void OnDiscountInput(VisOrderLineDto line, string? raw)
    {
        var value = Math.Max(0, Fa.ParseDecimal(raw));
        if (value <= 99)
        {
            line.DiscountIsAmount = false;
            line.DiscountPercent = value;
            line.DiscountAmount = 0;
        }
        else
        {
            line.DiscountIsAmount = true;
            line.DiscountAmount = value;   // سقف با جمع سطر در RecalcLine اعمال می‌شود
        }
        RecalcLine(line);
    }

    /// <summary>پس از خروج از فیلد، متن با قالب درست (جداکننده/بدون جداکننده) بازنویسی می‌شود.</summary>
    private void OnDiscountBlur(VisOrderLineDto line)
    {
        RecalcLine(line);
        StateHasChanged();
    }

    private static decimal Round2(decimal v) => Math.Round(v, 2);

    // ================== آلارم کسری موجودی ==================
    /// <summary>پیام مسدود بودن فرم (نقش تأییدکننده یا نداشتن مجوز ثبت).</summary>
    private string? blocked;

    private bool showStockConfirm;
    private bool pendingSubmit;

    /// <summary>موجودی همین انبار برای کالای سطر (از فهرست کالاهای انبار).</summary>
    private decimal AvailableOf(VisOrderLineDto l)
        => l.ProductId > 0 && productIndex.TryGetValue(l.ProductId, out var p) ? p.Stock : 0m;

    /// <summary>مقدار کسری همان سطر (صفر = موجودی کافی است).</summary>
    private decimal ShortageOf(VisOrderLineDto l)
        => l.ProductId > 0 ? Math.Max(0, l.Quantity - AvailableOf(l)) : 0m;

    private sealed record ShortLine(VisOrderLineDto Line, decimal Available, decimal Shortage);

    /// <summary>سطرهای دارای کسری موجودی — برای آلارم ردیف و پنجرهٔ تأیید.</summary>
    private List<ShortLine> ShortLines => model.Lines
        .Where(l => l.ProductId > 0 && ShortageOf(l) > 0)
        .Select(l => new ShortLine(l, AvailableOf(l), ShortageOf(l)))
        .ToList();

    private string WarehouseName => warehouses.FirstOrDefault(w => w.Id == model.WarehouseId)?.Name ?? "—";

    /// <summary>انصراف در پنجرهٔ کسری: هیچ چیزی ذخیره نمی‌شود (کار متوقف می‌شود).</summary>
    private void CancelStockSave()
    {
        showStockConfirm = false;
        Toast.Info("ثبت سفارش متوقف شد؛ مقدار سفارش را با موجودی انبار متناسب کنید یا موجودی را تأمین کنید.");
    }

    /// <summary>تأیید کاربر روی آلارم کسری: ثبت سفارش ادامه پیدا می‌کند.</summary>
    private async Task ProceedWithShortage()
    {
        showStockConfirm = false;
        await DoSaveAsync(pendingSubmit);
    }

    private async Task SaveAsync(bool submit)
    {
        // محافظ: اگر وضعیت سفارش عوض شده یا دکمهای قدیمی فراخوانی شده،
        // هیچگاه SubmitAfterSave=true برای سفارش در انتظار تأیید ارسال نشود.
        if (!CanSubmit) submit = false;
        if (model.PartyId <= 0) { Toast.Error("مشتری را انتخاب کنید."); return; }
        if (model.WarehouseId <= 0) { Toast.Error("انبار را انتخاب کنید."); return; }
        if (model.Lines.Count == 0) { Toast.Error("حداقل یک کالا اضافه کنید."); return; }
        if (model.Lines.Any(l => l.ProductId <= 0)) { Toast.Error("در هر سطر یک کالا انتخاب کنید (یا سطر خالی را حذف کنید)."); return; }
        if (model.Lines.Any(l => l.Quantity <= 0)) { Toast.Error("مقدار هر سطر باید بزرگ‌تر از صفر باشد."); return; }
        if (deliveryDate is null) { Toast.Error("تاریخ دریافت محصول را انتخاب کنید."); return; }

        // محدودیت سقف تخفیف برای ویزیتور (مدیر محدودیت ندارد)
        if (me?.CanApprove != true && me?.IsAdmin != true && me?.MaxDiscountPercent > 0)
        {
            var invalidLine = model.Lines.FirstOrDefault(l => l.DiscountPercent > me.MaxDiscountPercent);
            if (invalidLine is not null)
            {
                Toast.Error($"درصد تخفیف سطر «{invalidLine.ProductName}» ({Fa.Digits(invalidLine.DiscountPercent)}٪) بیش از سقف مجاز شما ({Fa.Digits(me.MaxDiscountPercent)}٪) است.");
                return;
            }
        }

        // آلارم کسری موجودی: کاربر باید صریحاً تأیید کند، وگرنه ثبت متوقف می‌شود
        if (ShortLines.Count > 0)
        {
            pendingSubmit = submit;
            showStockConfirm = true;
            return;
        }

        await DoSaveAsync(submit);
    }

    private async Task DoSaveAsync(bool submit)
    {
        saving = true;
        try
        {
            model.Date = orderDate?.Date ?? DateTime.Today;
            model.DeliveryDate = deliveryDate?.Date ?? DateTime.Today;
            model.SubmitAfterSave = submit && CanSubmit;
            var saved = await Api.SaveAsync(model);
            // سرور ممکن است بدنهٔ خالی/null بفرستد (ApiClient در آن حالت default!
            // برمیگرداند). بدون این نالچک، saved.Number دقیقاً همان
            // NullReferenceException گزارششده هنگام «ثبت سفارش» است.
            if (saved is null)
            {
                Toast.Error("نتیجهٔ ثبت سفارش از سرور دریافت نشد؛ پیش از تکرار، فهرست سفارشها را بازخوانی کنید (ممکن است سفارش ثبت شده باشد).");
                return;
            }
            lastSubmitted = submit && CanSubmit;
            Toast.Success(lastSubmitted
                ? $"سفارش {saved.Number} برای تأیید مدیر فروش ارسال شد."
                : $"پیش‌نویس سفارش {saved.Number} ذخیره شد.");

            if (Id > 0)
            {
                // ویرایش سفارش موجود: بازگشت به همان سفارش
                Nav.NavigateTo($"/sales/visits/{saved.Id}");
                return;
            }

            // سفارش جدید: فرم پاک می‌شود تا بلافاصله سفارش بعدی ثبت شود (بدون رفتن به صفحهٔ دیگر)
            lastSaved = saved;
            await ResetForNextOrderAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    /// <summary>پس از ثبت سفارش: پاک‌سازی کامل فرم برای سفارش بعدی (انبار انتخاب‌شده می‌ماند تا ثبت سریع‌تر شود).</summary>
    private async Task ResetForNextOrderAsync()
    {
        model = new VisOrderCommand
        {
            Date = DateTime.Today,
            DeliveryDate = DateTime.Today,
            WarehouseId = model.WarehouseId,
            PaymentMethod = model.PaymentMethod
        };
        orderDate = DateTime.Today;
        deliveryDate = DateTime.Today;
        originalStatus = null;
        CloseCombo();
        formKey++;   // انتخابگر مشتری از نو ساخته می‌شود (متن قبلی پاک می‌شود)
        try { customers = await Api.CustomersAsync(null) ?? customers; }
        catch { /* فهرست قبلی کافی است */ }
        RebuildCustomerLookup();
        await ReloadProductLookupAsync();
    }

    private void OpenLastSaved()
    {
        if (lastSaved is not null) Nav.NavigateTo($"/sales/visits/{lastSaved.Id}");
    }

    /// <summary>باز کردن «فرم تعریف مشتری» — همان فرم واقعی طرف حساب.</summary>
    private void OpenCustomer() => showCustomerForm = true;

    private void CloseCustomer() => showCustomerForm = false;

    /// <summary>پس از ثبت مشتری در فرم واقعی طرف حساب: انتخاب خودکار و تازه‌سازی فهرست.</summary>
    private async Task OnCustomerSaved(Party created)
    {
        showCustomerForm = false;
        if (created is null) { Toast.Error("مشتری جدید ثبت شد ولی اطلاعات آن دریافت نشد؛ از فهرست انتخاب کنید."); return; }
        try { customers = await Api.CustomersAsync(null) ?? customers; }
        catch (Exception ex) { Toast.Error(ex.Message); }
        model.PartyId = created.Id;
        if (!customers.Any(c => c.Id == created.Id))
            customers.Insert(0, new VisCustomerLite { Id = created.Id, Name = created.Name, Mobile = created.Mobile, Phone = created.Phone, Address = created.Address });
        RebuildCustomerLookup();
        Toast.Success($"مشتری «{created.Name}» در تعریف مشتریان ثبت شد و انتخاب شد.");
    }
}
