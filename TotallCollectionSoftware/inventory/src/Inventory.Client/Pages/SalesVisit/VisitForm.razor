}
.vis-form .vis-empty h6 { font-size: .88rem; font-weight: 800; }
.vis-form .vis-empty p { margin: .3rem 0 .7rem; font-size: .74rem; line-height: 1.7; color: var(--vis-muted); }
@@keyframes vis-shimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }
.vis-form .vis-loading { display: grid; gap: var(--vis-gap-sm); }
.vis-form .vis-skeleton {
