@namespace Inventory.Client.Pages
@page "/sales/visits/new"
@page "/sales/visits/{Id:int}/edit"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject ISalesVisitApi Api
@inject ITrsAccountService AccountSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>@(Id > 0 ? "ویرایش سفارش ویزیتوری" : "ثبت سفارش ویزیتوری جدید")</PageTitle>

<div class="fin-page-container fade-in vis-form">
    @if (lastSaved is not null)
    {
        <div class="alert alert-success d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded-4 mb-4 border border-success-subtle shadow-sm" data-last-saved>
            <div class="d-flex align-items-center gap-2.5">
                <div class="fin-avatar bg-emerald-subtle text-emerald"><i class="bi bi-check-lg fs-5"></i></div>
                <div>
                    <div class="fw-800 text-dark fs-7.5">سفارش شماره @lastSaved.Number با موفقیت ثبت شد</div>
                    <div class="fs-8 text-secondary">
                        @(lastSubmitted
                            ? "سفارش جهت تأیید مدیر فروش ارسال شد و فرم برای ثبت سفارش جدید آماده است."
                            : "پیشنویس ذخیره شد و فرم برای ثبت سفارش جدید آماده است.")
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-success fin-btn-pill px-3" @onclick="OpenLastSaved">
                    <i class="bi bi-receipt me-1"></i> مشاهدهٔ سفارش
                </button>
                <button class="btn btn-sm btn-light fin-btn-pill px-2.5" @onclick="@(() => lastSaved = null)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    }

    <!-- ================== سربرگ ================== -->
    <div class="fin-header vis-form-header">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">@(Id > 0 ? "ویرایش سفارش ویزیتوری" : "ثبت سفارش ویزیتوری جدید")</h1>
                        <span class="badge rounded-pill fin-badge-indigo">ثبت فروش میدانی</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        انتخاب مشتری، تخصیص انبار، ثبت اقلام با استعلام برخط موجودی و سقف تخفیف مجاز
                    </div>
                    @if (!string.IsNullOrWhiteSpace(me?.CompanyName))
                    {
                        <div class="badge bg-light text-secondary border rounded-pill mt-1.5 fs-9" data-company-scope>
                            <i class="bi bi-buildings me-1 text-primary"></i> شرکت مجاز: <b>@me!.CompanyName</b>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-secondary fin-btn-pill" data-hotkey="esc" @onclick="@(() => Nav.NavigateTo("/sales/visits"))">
                    <i class="bi bi-arrow-right me-1"></i> بازگشت به سفارش‌ها
                </button>
            </div>
        </div>
    </div>

@if (loading)
{
    <div class="vis-loading" data-loading-skeleton>
        <div class="vis-skeleton vis-skel-head"></div>
        <div class="vis-skeleton vis-skel-row"></div>
        <div class="vis-skeleton vis-skel-row"></div>
        <div class="vis-skeleton vis-skel-row"></div>
    </div>
}
else if (blocked is not null)
{
    <div class="empty-state" data-form-blocked>
        <i class="bi bi-shield-lock"></i>
        <h5>ثبت سفارش برای شما مجاز نیست</h5>
        <div class="text-muted fs-8">@blocked</div>
    </div>
}
else
{
    <div class="row vis-grid vis-form-layout">
        @* ---------------- ستون فرم ---------------- *@
        <div class="col-12">
            <div class="card">
                <div class="card-header vis-card-header">
                    <i class="bi bi-person-vcard"></i><span class="card-title">مشخصات سفارش</span>
                    <span class="vis-card-hint">اطلاعات پایهٔ سفارش</span>
                </div>
                <div class="card-body">
                    @* یک شبکهٔ واحد با فاصلهٔ یکسان افقی/عمودی؛ دیگر ردیفهای تودرتو
                       با g-2 و mt-1 وجود ندارد تا فاصلهٔ ستونها ناهماهنگ شود. *@
                    <div class="row vis-grid">
                        <div class="col-12 col-md-6 vis-field">
                            <label class="form-label">مشتری <span class="text-danger">*</span></label>
                            @* جستجو داخل خود کمبو است: نام، موبایل یا تلفن را تایپ کنید (فیلتر سمت سرور) *@
                            <div class="vis-inline-field">
                                <div class="vis-field-grow">
                                    <SearchSelect @key="formKey"
                                                  Items="customerLookup"
                                                  Value="model.PartyId"
                                                  ValueChanged="OnCustomerPicked"
                                                  RemoteSearch="true"
                                                  SearchChanged="SearchCustomersAsync"
                                                  Placeholder="جستجوی مشتری — نام، موبایل یا تلفن…" />
                                </div>
                                <button class="btn btn-outline-primary vis-icon-btn" @onclick="OpenCustomer"
                                        title="مشتری جدید — فرم تعریف مشتری (طرف حساب)">
                                    <i class="bi bi-person-plus"></i>
                                </button>
                            </div>
                            @if (customers.Count == 0)
                            {
                                <div class="vis-field-note text-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    برای شرکت شما مشتری فعالی ثبت نشده است؛ با دکمهٔ «مشتری جدید» همینجا اضافه کنید.
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-6 vis-field">
                            <label class="form-label">انبار <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="model.WarehouseId" @bind:after="ReloadProductLookupAsync">
                                <option value="0">— انتخاب انبار —</option>
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                            @if (warehouses.Count == 0)
                            {
                                <div class="vis-field-note text-danger" data-no-warehouse>
                                    <i class="bi bi-exclamation-triangle"></i>
                                    هیچ انبار فعالی برای شرکت شما تعریف نشده است؛ از مدیر سیستم بخواهید
                                    در «انبارها» انبار این شرکت را ثبت کند.
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-4 vis-field vis-field--sm">
                            <label class="form-label">روش پرداخت</label>
                            <div class="vis-pay-method" data-vis-pay-method>
                                <b class="fs-8">@PaymentMethodText</b>
                                <span class="fs-9 text-muted">جزئیات را در «پرداخت ترکیبی» زیر تنظیم کنید</span>
                            </div>
                        </div>
                        <div class="col-12 col-md-4 vis-field vis-field--sm">
                            <label class="form-label">تاریخ سفارش</label>
                            <DatePicker @bind-Value="orderDate" />
                        </div>
                        <div class="col-12 col-md-4 vis-field vis-field--sm">
                            <label class="form-label">
                                تاریخ دریافت محصول <span class="text-danger">*</span>
                                <i class="bi bi-info-circle text-muted" title="تاریخ تحویل مورد نظر شما؛ مدیر میتواند تاریخ نهایی را تغییر دهد و هر دو تاریخ در سابقه میماند."></i>
                            </label>
                            <DatePicker @bind-Value="deliveryDate" />
                            @if (deliveryDate.HasValue && DeliveryBeforeOrder)
                            {
                                <div class="vis-field-note text-danger" data-delivery-date-error>
                                    <i class="bi bi-exclamation-triangle"></i>
                                    تاریخ دریافت نمی‌تواند پیش از تاریخ سفارش (@(orderDate?.Date.ToFa())) باشد.
                                </div>
                            }
                            else if (deliveryDate.HasValue)
                            {
                                <div class="vis-field-note vis-date-note">
                                    <i class="bi bi-truck"></i>
                                    تحویل: <b>@deliveryDate.Value.ToFa()</b>
                                    <span class="text-muted">(@PersianDate.DayName(deliveryDate.Value))</span>
                                </div>
                            }
                        </div>
                        <div class="col-12 vis-field">
                            <label class="form-label">توضیحات</label>
                            <input class="form-control" @bind="model.Note" placeholder="توضیح کوتاه (اختیاری)" />
                        </div>
                    </div>
                </div>
            </div>

            @* ---------------- سطرهای کالا ---------------- *@
            <div class="card vis-stack">
                <div class="card-header vis-card-header">
                    <i class="bi bi-box-seam"></i><span class="card-title">کالاها</span>
                    <div class="vis-card-actions">
                        <span class="vis-counter">@Fa.Digits(model.Lines.Count) سطر</span>
                        @if (ZeroStockCount > 0)
                        {
                            <span class="zs-badge" data-zero-count><i class="bi bi-x-octagon"></i> @Fa.Digits(ZeroStockCount) قلم ناموجود</span>
                        }
                        @* همان رفتار و همان کلید میانبر فرم فروش: دکمه سطر خالی میسازد (F2) *@
                        <button class="btn btn-sm btn-outline-primary" data-hotkey="f2" title="کلید میانبر: F2"
                                @onclick="AddEmptyLine" disabled="@(model.WarehouseId <= 0)">
                            <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (me is not null && me.ProductCount == 0)
                    {
                        <div class="alert alert-warning py-2 px-2 fs-8" data-no-product>
                            <i class="bi bi-exclamation-triangle"></i>
                            برای شرکت <b>@(string.IsNullOrWhiteSpace(me.CompanyName) ? "شما" : me.CompanyName)</b>
                            هیچ کالای فعالی تعریف نشده است؛ از مدیر سیستم بخواهید کالاهای این شرکت را ثبت کند.
                        </div>
                    }

                    @if (model.WarehouseId <= 0)
                    {
                        <div class="form-text text-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            ابتدا انبار را انتخاب کنید تا بتوانید سطر کالا اضافه کنید.
                        </div>
                    }

                    @* اقلام: گرید واکنشگرا، بدون جدول پهن و بدون هیچ اسکرول داخلی *@
                    @if (model.Lines.Count == 0)
                    {
                        <div class="vis-empty" data-no-lines>
                            <div class="vis-empty-ico"><i class="bi bi-basket"></i></div>
                            <h6>هنوز کالایی اضافه نشده است</h6>
                            <p>با کلید F2 یا دکمهٔ زیر یک سطر بسازید، سپس کالا را داخل همان سطر انتخاب کنید.</p>
                            <button class="btn btn-sm btn-outline-primary" @onclick="AddEmptyLine" disabled="@(model.WarehouseId <= 0)">
                                <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="vis-lines" data-no-scroll>
                            <div class="vis-lines-head">
                                <span class="vis-h-name">کالا</span>
                                <span class="vis-h-qty">مقدار</span>
                                <span class="vis-h-price">قیمت واحد (ریال)</span>
                                <span class="vis-h-disc" title="تا ۹۹ = درصد | از ۱۰۰ به بالا = مبلغ ریالی">تخفیف</span>
                                <span class="vis-h-total">جمع</span>
                                <span class="vis-h-del"></span>
                            </div>
                            @foreach (var l in model.Lines)
                            {
                                var available = AvailableOf(l);
                                var shortage = ShortageOf(l);
                                <div @key="l" class="vis-line @(IsOutOfStock(l) ? "zs-row zs-row--card" : "") @(shortage > 0 && !IsOutOfStock(l) ? "is-short" : "")" data-shortage="@(shortage > 0 ? "1" : "0")" data-zero-stock="@(IsOutOfStock(l) ? "1" : "0")">
                                    <div class="vis-cell c-name">
                                        <span class="vis-cell-label">کالا</span>
                                        @* کمبوی درونسطری: هیچ منوی fixed و هیچ JS مختصاتگیری نیست،
                                           پس با کیبورد موبایل/اسکرول نمیپرد. F2 همان سطر را باز میکند. *@
                                        <div class="vis-combo">
                                            <div class="vis-combo-ctl">
                                                <i class="bi bi-box-seam"></i>
                                                <input class="form-control form-control-sm vis-combo-input"
                                                       value="@ComboText(l)" placeholder="جستجوی کالا…" autocomplete="off"
                                                       @onfocus="@(() => OpenCombo(l))"
                                                       @oninput="e => OnComboInput(l, e.Value?.ToString())"
                                                       @onkeydown="e => OnComboKey(l, e)" />
                                                @if (IsComboOpen(l))
                                                {
                                                    <i class="bi bi-x-lg vis-combo-close" @onclick="CloseCombo"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-chevron-down vis-combo-chev" @onclick="@(() => OpenCombo(l))"></i>
                                                }
                                            </div>
                                            @if (l.ProductId > 0)
                                            {
                                                <div class="vis-combo-selected">@l.ProductName <span>@l.ProductCode — @l.Unit</span></div>
                                            }
                                            @if (IsComboOpen(l))
                                            {
                                                var matches = ComboMatches();
                                                <div class="vis-combo-menu" data-combo-menu>
                                                    @foreach (var opt in matches)
                                                    {
                                                        <div class="vis-combo-opt" @onmousedown:preventDefault="true"
                                                             @onclick="@(() => PickCombo(l, opt.Id))">
                                                            <span>@opt.Name</span><small>@opt.InfoText</small>
                                                            @if (zeroStockIds.Contains(opt.Id))
                                                            {
                                                                <em class="zs-opt">ناموجود</em>
                                                            }
                                                            @if (HasNoSalePrice(opt.Id))
                                                            {
                                                                <em class="zs-opt" data-missing-sale-price-option>بدون قیمت فروش</em>
                                                            }
                                                        </div>
                                                    }
                                                    @if (matches.Count == 0)
                                                    {
                                                        <div class="vis-combo-empty">موردی یافت نشد؛ عبارت را دقیقتر کنید.</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                        @if (IsOutOfStock(l))
                                        {
                                            <div class="zs-alert" data-zero-stock-alert>
                                                <i class="bi bi-x-octagon"></i><b>موجودی صفر</b>
                                                <span>در «@WarehouseName» موجود نیست — پیش از ارسال سفارش اصلاح کنید</span>
                                            </div>
                                        }
                                        else if (shortage > 0)
                                        {
                                            <div class="zs-alert zs-alert--warn" data-shortage-alert>
                                                <i class="bi bi-exclamation-triangle"></i><b>کسری موجودی</b>
                                                <span>موجودی @Fa.Number(available) — سفارش @Fa.Number(l.Quantity)</span>
                                            </div>
                                        }
                                    </div>
                                    <div class="vis-cell c-qty">
                                        <span class="vis-cell-label">مقدار</span>
                                        <input class="form-control form-control-sm num @(IsOutOfStock(l) ? "zs-qty-input" : "")"
                                               value="@l.Quantity.ToString("0.##")"
                                               inputmode="@(UnitAllowsFraction(l) == false ? "numeric" : "decimal")"
                                               @onchange="e => SetQty(l, e.Value?.ToString())" />
                                        @if (UnitAllowsFraction(l) == false)
                                        {
                                            <div class="vis-cell-note text-danger" data-fraction-error>
                                                <i class="bi bi-exclamation-triangle"></i> واحد «@l.Unit» فقط مقدار صحیح می‌پذیرد
                                            </div>
                                        }
                                        @if (IsOutOfStock(l))
                                        {
                                            <div class="vis-cell-note text-danger" data-stock-alarm>
                                                <i class="bi bi-x-octagon"></i> موجودی ۰
                                            </div>
                                        }
                                        else if (shortage > 0)
                                        {
                                            <div class="vis-cell-note text-danger" data-stock-alarm>
                                                <i class="bi bi-exclamation-triangle"></i>
                                                موجودی @Fa.Number(available) — کسری @Fa.Number(shortage)
                                            </div>
                                        }
                                        else if (l.ProductId > 0)
                                        {
                                            <div class="vis-cell-note vis-minor">موجودی: @Fa.Number(available) @l.Unit</div>
                                        }
                                    </div>
                                    <div class="vis-cell c-price">
                                        <span class="vis-cell-label">قیمت واحد (ریال)</span>
                                        @* قیمت واحد برای ویزیتور خاکستری و غیرقابل ویرایش است (فقط خواندنی) *@
                                        <MoneyInput Value="l.UnitPrice"
                                                    ValueChanged="v => SetPrice(l, v)"
                                                    Disabled="@(me?.CanEditVisitPrice != true)"
                                                    ReadOnly="@(me?.CanEditVisitPrice != true)"
                                                    CssClass="@($"form-control form-control-sm text-center num {(me?.CanEditVisitPrice != true ? "bg-light text-muted" : "")}")" />
                                        @if (MissingSalePrice(l))
                                        {
                                            <div class="vis-cell-note text-danger" role="alert" data-missing-sale-price>
                                                <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                قیمت فروش این کالا ثبت نشده یا صفر است؛ از مسئول قیمت‌گذاری بخواهید قیمت فروش را ثبت کند.
                                            </div>
                                        }
                                    </div>
                                    <div class="vis-cell c-disc">
                                        <span class="vis-cell-label">تخفیف</span>
                                        @* دو حالته: تا ۹۹ = درصد، از ۱۰۰ به بالا = مبلغ ریالی *@
                                        <div class="input-group input-group-sm">
                                            <input class="form-control form-control-sm text-center num"
                                                   value="@DiscountText(l)"
                                                   @oninput="e => OnDiscountInput(l, e.Value?.ToString())"
                                                   @onblur="e => OnDiscountBlur(l)"
                                                   inputmode="numeric" dir="ltr" />
                                            <span class="input-group-text @(l.DiscountIsAmount ? "text-primary" : "")"
                                                  title="@(l.DiscountIsAmount ? "مبلغ ریالی" : "درصد")">
                                                @(l.DiscountIsAmount ? "ریال" : "٪")
                                            </span>
                                        </div>
                                        @* مبلغ تخفیف همان ردیف — همیشه به ریال نمایش داده میشود *@
                                        @if (LineDiscount(l) > 0)
                                        {
                                            <div class="vis-cell-note discount-line" data-line-discount="@LineDiscount(l)">
                                                <span class="text-danger num">@Fa.Money(LineDiscount(l)) ریال</span>
                                                @if (l.DiscountIsAmount)
                                                {
                                                    <span class="text-muted">(@Fa.Digits(l.DiscountPercent) درصد)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="vis-cell c-total">
                                        <span class="vis-cell-label">جمع سطر</span>
                                        <div class="vis-line-total num">@Fa.Money(l.LineTotal) <small>ریال</small></div>
                                    </div>
                                    <div class="vis-cell c-del">
                                        <button class="btn btn-sm btn-outline-danger vis-del-btn" title="حذف سطر"
                                                @onclick="@(() => model.Lines.Remove(l))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (me?.IsSalesManager == true)
                    {
                        <div class="badge bg-info-subtle text-info border border-info-subtle p-2 mt-2 d-inline-flex align-items-center gap-1">
                            <i class="bi bi-shield-check"></i> نقش مدیر فروش: سقف تخفیف ویزیتوری برای شما اعمال نمی‌شود.
                        </div>
                    }
                    else if (me != null)
                    {
                        <div class="form-text mt-2 text-warning-emphasis">
                            <i class="bi bi-info-circle ms-1"></i> سقف تخفیف مجاز شما: <b>@Fa.Digits(me.MaxDiscountPercent) درصد</b> (تخفیف بالاتر مجاز نیست).
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ---------------- بازبینی مالی و اقدامها (تمامعرض، زیر کالاها) ---------------- *@
        <div class="col-12 vis-stack">
            <div class="vis-review" data-review-bar>
                <div class="vis-kpi"><span>جمع کل</span><b class="num">@Fa.Money(Gross) <small>ریال</small></b></div>
                <div class="vis-kpi"><span>تخفیف</span><b class="num text-danger">@Fa.Money(Discount) <small>ریال</small></b></div>
                <div class="vis-kpi vis-kpi-total"><span>قابل پرداخت</span><b class="num">@Fa.Money(Net) <small>ریال</small></b></div>
            </div>

            @* ---------------- پرداخت ترکیبی + عکس چک ----------------
               همان تجربهٔ فاکتور خرید/فروش: چهار جزء هم‌زمان، باقی‌ماندهٔ هر جزء،
               و عکس چک که مالی در کارتابل مالی تأیید/رد می‌کند. *@
            <div class="vis-pay-card" data-vis-payment-plan>
                <div class="vis-pay-card-head">
                    <span class="fw-700"><i class="bi bi-credit-card-2-front text-primary ms-1"></i> پرداخت ترکیبی</span>
                    <span class="fs-9 text-muted">
                        چند جزء را هم‌زمان فعال کنید؛ باقی‌ماندهٔ هر جزء از مبلغ سفارش و اجزای قبلی محاسبه می‌شود.
                    </span>
                </div>
                <div class="pay-tabs" role="group" aria-label="اجزای پرداخت">
                    <button type="button" class="pay-tab @(useCash ? "active" : "")" data-vis-pay-comp="cash"
                            aria-pressed="@(useCash ? "true" : "false")" @onclick="ToggleCash">
                        <i class="bi bi-cash-coin"></i> نقدی
                    </button>
                    <button type="button" class="pay-tab @(useCheque ? "active" : "")" data-vis-pay-comp="cheque"
                            aria-pressed="@(useCheque ? "true" : "false")" @onclick="ToggleCheque">
                        <i class="bi bi-bank"></i> چک
                    </button>
                    <button type="button" class="pay-tab @(useInstallment ? "active" : "")" data-vis-pay-comp="installment"
                            aria-pressed="@(useInstallment ? "true" : "false")" @onclick="ToggleInstallment">
                        <i class="bi bi-journal-check"></i> اقساطی
                    </button>
                    <button type="button" class="pay-tab @(useCredit ? "active" : "")" data-vis-pay-comp="credit"
                            aria-pressed="@(useCredit ? "true" : "false")" @onclick="ToggleCredit">
                        <i class="bi bi-hourglass-split"></i> نسیه
                    </button>
                </div>

                <div class="vis-pay-summary" data-vis-pay-summary>
                    <span>مبلغ سفارش: <b class="num">@Fa.Money(Net)</b></span>
                    <span>نقد: <b class="num text-success" data-vis-cash-sum>@Fa.Money(CashPart)</b></span>
                    <span>چک: <b class="num" data-vis-cheque-sum>@Fa.Money(ChequeSum)</b></span>
                    <span>اقساط: <b class="num" data-vis-inst-sum>@Fa.Money(InstSum)</b></span>
                    <span class="@(PaymentRemaining < -1 ? "text-warning fw-700" : PaymentRemaining > 1 ? "text-danger fw-700" : "text-success fw-700")">
                        @(PaymentRemaining < -1 ? "مازاد پرداخت: " : "باقی‌مانده: ")
                        <b class="num" data-vis-remain>@Fa.Money(Math.Abs(PaymentRemaining))</b>
                    </span>
                </div>

                @* ---------- جزء نقدی ---------- *@
                @if (useCash)
                {
                    <div class="vis-pay-part" data-vis-cash-box>
                        <div class="row g-2 align-items-end">
                            @if (HasNonCash)
                            {
                                <div class="col-6 col-md-3">
                                    <label class="form-label fs-8">دریافت نقدی (بخشی از مبلغ)</label>
                                    <input class="form-control form-control-sm num" value="@cashAmountText"
                                           @oninput="OnCashAmountInput" inputmode="numeric" dir="ltr"
                                           placeholder="0" data-vis-cash-input />
                                </div>
                            }
                            <div class="col-6 col-md-3">
                                <label class="form-label fs-8">نوع دریافت نقدی</label>
                                <SearchSelect Items="CashTypeLookup" Value="@((int)CashKind + 1)"
                                              ValueChanged="OnCashTypePicked" AllowClear="false" />
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label fs-8">صندوق/بانک</label>
                                <div class="input-group input-group-sm">
                                    <SearchSelect Items="@CashAccountLookup" Value="@(trsAccountId ?? 0)"
                                                  ValueChanged="OnCashAccountPicked" Placeholder="انتخاب صندوق/بانک…" />
                                    <button type="button" class="btn btn-outline-primary"
                                            title="تعریف صندوق/بانک جدید"
                                            @onclick="() => OpenQuickBank(CashKind == CashType.Cash ? TreasuryAccountKind.Cash : TreasuryAccountKind.Bank)">
                                        <i class="bi bi-plus-lg"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="col-12 col-md-2 fs-9 pb-1">
                                @if (HasNonCash)
                                {
                                    <span>باقی‌مانده پس از نقد:
                                        <b class="num text-primary" data-vis-remain-cash>@Fa.Money(RemainingAfterCash)</b>
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">تمام مبلغ نقدی است.</span>
                                }
                            </div>
                        </div>
                    </div>
                }

                @* ---------- جزء چک + عکس چک ---------- *@
                @if (useCheque)
                {
                    <div class="vis-pay-part" data-vis-cheque-box>
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <span class="fs-8 fw-700">چک‌های دریافتی از مشتری</span>
                            <button type="button" class="btn btn-sm btn-outline-primary ms-auto"
                                    data-vis-add-cheque data-hotkey="f2" title="کلید میانبر: F2" @onclick="AddCheque">
                                <i class="bi bi-plus-lg"></i> افزودن چک (F2)
                            </button>
                        </div>
                        @for (var ci = 0; ci < cheques.Count; ci++)
                        {
                            var i = ci;
                            <div class="row g-2 align-items-end mb-2" data-vis-cheque-row="@i">
                                <div class="col-6 col-md-2">
                                    <label class="form-label fs-8">شماره چک/صیاد *</label>
                                    <input class="form-control form-control-sm" @bind="cheques[i].Number" dir="ltr" />
                                </div>
                                <div class="col-6 col-md-3">
                                    <label class="form-label fs-8">بانک</label>
                                    <div class="input-group input-group-sm">
                                        <SearchSelectStr Items="@ChequeBankNames" Value="@(cheques[i].BankName ?? "")"
                                                         ValueChanged="@(name => cheques[i].BankName = name)"
                                                         Placeholder="نام بانک…" AllowCustomValue="true" />
                                        <button type="button" class="btn btn-outline-primary" title="افزودن بانک"
                                                aria-label="افزودن بانک" @onclick="() => OpenChequeBank(i)">
                                            <i class="bi bi-plus-lg"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label fs-8">صاحب چک</label>
                                    <input class="form-control form-control-sm" @bind="cheques[i].OwnerName" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label fs-8">مبلغ (ریال) *</label>
                                    <input class="form-control form-control-sm num" value="@chequeAmounts[i]"
                                           @oninput="e => chequeAmounts[i] = Fa.FormatTyping(e.Value?.ToString())"
                                           inputmode="numeric" dir="ltr" data-vis-cheque-amount="@i" />
                                </div>
                                <div class="col-6 col-md-2">
                                    <label class="form-label fs-8">سررسید چک *</label>
                                    <DatePicker @bind-Value="chequeDates[i]" />
                                </div>
                                <div class="col-6 col-md-1 text-center">
                                    <button type="button" class="btn btn-sm btn-light" title="حذف چک"
                                            aria-label="حذف چک" data-vis-remove-cheque="@i"
                                            @onclick="() => RemoveCheque(i)">
                                        <i class="bi bi-x-lg text-danger"></i>
                                    </button>
                                </div>
                                <div class="col-12 fs-9">
                                    <span class="text-muted">@(RemainingAfterCheque(i) < 0 ? "مازاد این چک:" : "باقی‌مانده پس از این چک:")</span>
                                    <b class="num text-primary" data-vis-rem-cheque="@i">@Fa.Money(Math.Abs(RemainingAfterCheque(i)))</b> ریال
                                </div>
                            </div>
                        }
                        @if (cheques.Count == 0)
                        {
                            <div class="fs-8 text-muted">هنوز چکی اضافه نشده است.</div>
                        }

                        @* عکس چک — همان چیزی که مالی در کارتابل مالی تأیید/رد می‌کند.
                           پیش از ذخیره، فایل با RefId = -1 آپلود و هنگام ذخیره به سفارش منتقل می‌شود. *@
                        <div class="mt-2">
                            <VisChequePhotos @key="formKey" OrderId="@PhotoRefId" CanUpload="@CanEditPhotos"
                                             OnLoaded="OnChequePhotosLoaded" />
                        </div>
                    </div>
                }

                @* ---------- جزء اقساط ---------- *@
                @if (useInstallment)
                {
                    <div class="vis-pay-part" data-vis-inst-box>
                        <div class="row g-2 align-items-end mb-2">
                            <div class="col-6 col-md-2">
                                <label class="form-label fs-8">تعداد قسط</label>
                                <input class="form-control form-control-sm num" type="number" min="1" max="60"
                                       @bind="instCount" dir="ltr" />
                            </div>
                            <div class="col-6 col-md-3">
                                <label class="form-label fs-8">تاریخ اولین قسط</label>
                                <DatePicker @bind-Value="instFirstDue" />
                            </div>
                            <div class="col-6 col-md-2">
                                <label class="form-label fs-8">فاصله (روز)</label>
                                <input class="form-control form-control-sm num" type="number" min="1"
                                       @bind="instIntervalDays" dir="ltr" />
                            </div>
                            <div class="col-6 col-md-3">
                                <button type="button" class="btn btn-sm btn-primary w-100"
                                        data-vis-build-inst @onclick="() => BuildInstallments()">
                                    <i class="bi bi-journal-plus"></i> ساخت دفترچه
                                </button>
                            </div>
                        </div>
                        @if (installments.Count > 0)
                        {
                            <div class="vis-inst-table">
                                <table class="table table-sm align-middle mb-1">
                                    <thead>
                                        <tr>
                                            <th>قسط</th><th>سررسید</th><th class="text-start">مبلغ (ریال)</th>
                                            <th class="text-start">باقی‌مانده پس از این قسط</th><th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @for (var ii = 0; ii < installments.Count; ii++)
                                        {
                                            var i = ii;
                                            <tr data-vis-inst-row="@i">
                                                <td class="num">قسط @Fa.Digits(i + 1)</td>
                                                <td style="max-width:170px"><DatePicker @bind-Value="instDates[i]" /></td>
                                                <td class="text-start">
                                                    <input class="form-control form-control-sm num" value="@instAmounts[i]"
                                                           @oninput="e => instAmounts[i] = Fa.FormatTyping(e.Value?.ToString())"
                                                           inputmode="numeric" dir="ltr" />
                                                </td>
                                                <td class="text-start">
                                                    <b class="num text-primary" data-vis-rem-inst="@i">@Fa.Money(Math.Abs(RemainingAfterInstallment(i)))</b>
                                                </td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-light"
                                                            data-vis-remove-inst="@i" @onclick="() => RemoveInstallment(i)">
                                                        <i class="bi bi-x-lg text-danger"></i>
                                                    </button>
                                                </td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            <div class="fs-8">
                                جمع اقساط: <b class="num">@Fa.Money(InstSum)</b> —
                                باقی‌ماندهٔ تجمعی: <b class="num text-primary" data-vis-remain-inst>@Fa.Money(PaymentRemaining)</b>
                            </div>
                        }
                    </div>
                }

                @* ---------- جزء نسیه ---------- *@
                @if (useCredit)
                {
                    <div class="row g-2 align-items-end vis-pay-part" data-vis-credit-box>
                        <div class="col-6 col-md-4">
                            <label class="form-label fs-8">تاریخ سررسید نسیه <span class="text-danger">*</span></label>
                            <DatePicker @bind-Value="creditDue" />
                        </div>
                        <div class="col-12 col-md-8 fs-8 pb-1">
                            مبلغ نسیه (باقی‌ماندهٔ نهایی):
                            <b class="num text-danger" data-vis-credit-amount>@Fa.Money(Math.Max(0, PaymentRemaining))</b> ریال
                        </div>
                    </div>
                }
            </div>

            @if (OverLimit)
            {
                <div class="alert alert-warning py-2 px-2 mt-2 fs-8 mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    تخفیف یک یا چند سطر از سقف مجاز شما بیشتر است؛ امکان ثبت سفارش وجود ندارد.
                </div>
            }

            @if (ShortLines.Count > 0)
            {
                <div class="alert alert-warning py-2 px-2 mt-2 mb-0 fs-8" data-stock-summary>
                    <b><i class="bi bi-exclamation-triangle"></i> @(ShortLines.Any(s => s.Available <= 0) ? "کالای ناموجود / کسری موجودی" : "کسری موجودی") در @Fa.Digits(ShortLines.Count) قلم:</b>
                    @foreach (var sh in ShortLines)
                    {
                        <div class="fs-9">
                            @sh.Line.ProductName — موجودی @Fa.Number(sh.Available)، نیاز @Fa.Number(sh.Line.Quantity)
                        </div>
                    }
                    <div class="fs-9 mt-1">ثبت سفارش انجام میشود؛ ولی پیش از ثبت فروش باید موجودی تأمین شود.</div>
                </div>
            }

            @* سفارش «در انتظار تأیید» دیگر دکمهٔ ارسال ندارد *@
            @if (!CanSubmit)
            {
                <div class="alert alert-info vis-status-note" data-pending-note>
                    <i class="bi bi-hourglass-split"></i>
                    این سفارش در انتظار تأیید مدیر است؛ با ذخیرهٔ تغییرات، همچنان در صف تأیید میماند.
                </div>
            }

            <div class="vis-actionbar">
                <div class="vis-action-btns">
                    @if (CanSubmit)
                    {
                        <button class="btn btn-primary" disabled="@saving" @onclick="@(() => SaveAsync(true))">
                            <i class="bi bi-send-check"></i> ذخیره و ارسال برای تأیید
                        </button>
                    }
                    <button class="btn btn-outline-secondary" data-hotkey="f1" disabled="@saving" @onclick="@(() => SaveAsync(false))">
                        <i class="bi bi-save"></i> @(Id > 0 ? "ذخیرهٔ تغییرات (F1)" : "ذخیرهٔ پیش‌نویس (F1)")
                    </button>
                </div>
                <div class="vis-field-note vis-action-note">
                    @(CanSubmit
                        ? "تا زمانی که ارسال نکنید، سفارش روی موجودی و حساب مشتری هیچ اثری ندارد."
                        : "تغییرات ذخیرهشده به اطلاع مدیر فروش میرسد.")
                </div>
            </div>
        </div>
    </div>
}

@* ================== آلارم کسری موجودی — پیش از ثبت ==================
   قاعدهٔ کارفرما: اگر موجودی کافی نیست آلارم داده شود؛ با «تأیید» کاربر ثبت انجام
   می‌شود و با «انصراف» کار متوقف می‌ماند (هیچ سفارشی ذخیره نمی‌شود).
   ==================================================================== *@
@if (showStockConfirm)
{
    <div class="vis-modal-back" data-shop-dialog>
        <div class="vis-modal" data-stock-confirm>
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                <b>@(ShortLines.Any(s => s.Available <= 0) ? "کالای ناموجود و کسری موجودی انبار" : "کسری موجودی انبار")</b>
            </div>
            <div class="fs-8 mb-2">
                برای @Fa.Digits(ShortLines.Count) قلم، موجودی انبار «@WarehouseName» کمتر از مقدار سفارش است:
            </div>
            <table class="table table-sm mb-2">
                <thead><tr><th>کالا</th><th class="text-start">نیاز</th><th class="text-start">موجودی</th><th class="text-start">کسری</th></tr></thead>
                <tbody>
                    @foreach (var sh in ShortLines)
                    {
                        <tr>
                            <td class="fs-8">@sh.Line.ProductName</td>
                            <td class="text-start fs-8 num">@Fa.Number(sh.Line.Quantity)</td>
                            <td class="text-start fs-8 num">@Fa.Number(sh.Available)</td>
                            <td class="text-start fs-8 num text-danger">@Fa.Number(sh.Shortage)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="fs-8 text-muted mb-3">
                @(pendingSubmit
                    ? "با تأیید شما، سفارش با همین مقادیر ثبت و ارسال میشود؛ تأمین موجودی پیش از ثبت فروش لازم است."
                    : "با تأیید شما، پیشنویس سفارش با همین مقادیر ثبت میشود؛ تأمین موجودی پیش از ثبت فروش لازم است.")
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-light" data-stock-cancel data-hotkey="esc" @onclick="CancelStockSave">انصراف</button>
                <button class="btn btn-warning" data-stock-proceed data-hotkey="f1" @onclick="ProceedWithShortage">
                    <i class="bi bi-check2-circle"></i> تأیید و ادامهٔ ثبت سفارش
                </button>
            </div>
        </div>
    </div>
}

@* ================== مشتری جدید ==================
   فرم واقعی «طرف حساب جدید» ماژول تعریف مشتری — همان کامپوننت /parties
   ================================================== *@
<PartyFormModal Visible="showCustomerForm"
                Type="PartyType.Customer"
                AllowReferrerPicker="false"
                OnSaved="OnCustomerSaved"
                OnCancel="CloseCustomer" />

@* ================== افزودن بانک چک ==================
   نام بانک فقط در فهرست محلی (localStorage) نگه داشته می‌شود؛ حساب خزانه لازم نیست.
   ===================================================== *@
@if (showChequeBank)
{
    <div class="vis-modal-back" data-shop-dialog data-vis-cheque-bank>
        <div class="vis-modal">
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-bank text-primary fs-4"></i>
                <b>افزودن بانک چک</b>
            </div>
            <div class="fs-8 text-muted mb-2">
                نام بانک در فهرست بانک‌های چک این دستگاه ذخیره می‌شود و دفعهٔ بعد هم پیشنهاد می‌شود.
            </div>
            <input class="form-control form-control-sm" @bind="newChequeBankName" @bind:event="oninput"
                   dir="ltr" placeholder="نام بانک…" data-vis-new-bank />
            <div class="d-flex gap-2 justify-content-end mt-3">
                <button class="btn btn-light" data-hotkey="esc" @onclick="CloseChequeBank">انصراف</button>
                <button class="btn btn-primary" data-hotkey="f1" disabled="@savingChequeBank"
                        @onclick="SaveChequeBank">
                    @if (savingChequeBank) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                    <i class="bi bi-check2 ms-1"></i> افزودن
                </button>
            </div>
        </div>
    </div>
}

@* ================== تعریف سریع صندوق/بانک ==================
   همان مودال فاکتور خرید و فروش؛ حساب ساخته‌شده بلافاصله در حساب‌های نقدی می‌نشیند.
   ============================================================ *@
<QuickBankModal @bind-Visible="showQuickBank" DefaultKind="@quickBankDefaultKind"
                InvoiceFormKey="@($"vis-{formKey}")" OnAccountCreated="OnQuickBankCreated" />


</div>

<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
.fin-header {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
}
.fin-header-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 6px 16px -2px rgba(79, 70, 229, 0.35);
    flex-shrink: 0;
}
.fin-badge-status {
    background: #eef2ff;
    color: #4338ca;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-btn-pill {
    border-radius: 20px;
    padding: 0.45rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.2s;
}

/* کارت‌های شاخص KPI لوکس */
.fin-kpi-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
}
.fin-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.08);
}
.fin-kpi-card.border-rose { border-top: 4px solid #ef4444; }
.fin-kpi-card.border-emerald { border-top: 4px solid #10b981; }
.fin-kpi-card.border-indigo { border-top: 4px solid #4f46e5; }
.fin-kpi-card.border-slate { border-top: 4px solid #64748b; }

.fin-kpi-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.fin-kpi-value {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.2;
}
.fin-kpi-unit {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 0.1rem;
}
.fin-kpi-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
