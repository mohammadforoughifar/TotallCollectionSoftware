/* حالت خالی و اسکلتون */
.vis-form .vis-empty {
    margin-top: var(--vis-gap);
    padding: 1.5rem 1rem;
    text-align: center;
    border: 1px dashed var(--vis-line);
    border-radius: 12px;
}
.vis-form .vis-empty-ico {
    display: grid; place-items: center;
    width: 56px; height: 56px; margin: 0 auto .6rem;
