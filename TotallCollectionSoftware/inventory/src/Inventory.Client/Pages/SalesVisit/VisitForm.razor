<style>
/* ==========================================================================
   طراحی یکدست فرم «ثبت / ویرایش سفارش ویزیتوری»
   همهٔ فاصلهها از چند متغیر میآیند تا فاصلهای ستونها در هیچ بخشی کم/زیاد نشود:
   --vis-gap = فاصلهٔ ستونها و ردیفها | --vis-pad = padd حاشیهٔ کارت
   --vis-gap-sm = فاصلهٔ عناصر داخل یک فیلد | --vis-radius = شعاع یکسان کارتها
   selectorها با .vis-form محدود شدهاند تا ترتیب تگهای استایل تبهای دیگر اثر نکند.
   ========================================================================== */
.vis-form {
    /* هیچ عنصری نباید صفحه را افقی پهن کند؛ clip برخلاف hidden اسکرولکانتنر
       نمیسازد و به position:sticky آسیب نمیزند. */
    max-width: 100%; overflow-x: clip;
    /* فاصلهٔ آیکون و متن کف دارد: با تراکم بقیه له نمیشود */
    --vis-icon-gap: .55rem;
    --vis-ctl-f: .74rem;   /* اندازهٔ قلم کنترلها؛ در نماهای کوچک با vw کوچک میشود */
    --vis-ctl-h: 30px;    /* حداقل ارتفاع باکسها */
    --vis-gap: 1rem;
    --vis-gap-sm: .5rem;
    --vis-pad: 1.15rem;
    --vis-radius: 14px;
    --vis-line: #e6ecf4;
    --vis-ink: #0f172a;
    --vis-muted: #64748b;
    --vis-accent: #4f46e5;
}
.vis-form, .vis-form * { box-sizing: border-box; }
.vis-form > .fin-header { margin-bottom: var(--vis-gap); }

/* تنها منبع فاصلهٔ بین ستونها — هم افقی و هم عمودی */
.vis-form .vis-grid {
    --bs-gutter-x: var(--vis-gap);
    --bs-gutter-y: var(--vis-gap);
}
.vis-form .vis-stack { margin-top: var(--vis-gap); }

/* فیلدها */
.vis-form .vis-field { min-width: 0; }
.vis-form .form-label {
    margin-bottom: .35rem;
    font-size: .78rem;
    font-weight: 700;
    color: #475569;
}
.vis-form .form-control,
.vis-form .form-select { border-radius: 10px; }
.vis-form .vis-inline-field {
    display: flex;
    align-items: stretch;
    gap: var(--vis-gap-sm);
}
.vis-form .vis-field-grow { flex: 1 1 auto; min-width: 0; }
.vis-form .vis-icon-btn {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding-inline: .8rem;
    border-radius: 10px;
}
.vis-form .vis-field-note {
    margin-top: .4rem;
    font-size: .72rem;
    line-height: 1.65;
}
.vis-form .vis-date-note {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: .3rem;
    padding: .4rem .6rem;
    border-radius: 9px;
    background: #f1f5ff;
    color: #3730a3;
}

/* کارتها و سربرگها */
.vis-form .card {
    border: 1px solid var(--vis-line);
    border-radius: var(--vis-radius);
    box-shadow: 0 3px 16px rgba(15, 23, 42, .04);
}
.vis-form .card-header.vis-card-header {
    display: flex;
    align-items: center;
    gap: var(--vis-icon-gap);
    padding: .8rem var(--vis-pad);
    background: linear-gradient(180deg, #ffffff, #f8fafc);
    border-bottom: 1px solid var(--vis-line);
    border-radius: var(--vis-radius) var(--vis-radius) 0 0;
}
.vis-form .vis-card-header > i { color: var(--vis-accent); font-size: .95rem; }
.vis-form .vis-card-header .card-title { margin: 0; font-size: .85rem; font-weight: 800; }
.vis-form .vis-card-hint {
    margin-inline-start: auto;
    font-size: .72rem;
    color: var(--vis-muted);
}
.vis-form .vis-card-actions {
    margin-inline-start: auto;
    display: flex;
    align-items: center;
    gap: var(--vis-icon-gap);
    flex-wrap: wrap;
}
.vis-form .vis-counter { font-size: .74rem; color: var(--vis-muted); white-space: nowrap; }
.vis-form .card-body { padding: var(--vis-pad); }
.vis-form .card-body > .alert { margin-top: var(--vis-gap); margin-bottom: 0; }

/* ===== اقلام: گرید واکنشگرا، بدون جدول پهن و بدون اسکرول داخلی =====
   هیچ پهنای حداقل، لبهٔ اسکرول، محدودیت ارتفاع یا جدول واکنشگرای پهن وجود ندارد؛
   ردیفها صفحه را بهصورت عمودی رشد میدهند (اسکرول صفحه مجاز، اسکرول داخلی خیر). */
.vis-form .vis-lines { margin-top: var(--vis-gap); }
.vis-form .vis-lines-head,
.vis-form .vis-line {
    display: grid;
    grid-template-columns: minmax(0, 2.4fr) minmax(0, .85fr) minmax(0, 1.3fr) minmax(0, 1.5fr) minmax(0, 1.2fr) minmax(0, .65fr);
    grid-template-areas: "name qty price disc total del";
    gap: var(--vis-gap-sm);
    align-items: start;
    min-width: 0;
}
.vis-form .vis-lines-head {
    padding: .5rem .6rem;
    background: #f8fafc;
    border: 1px solid var(--vis-line);
    border-radius: 10px;
    font-size: .74rem;
    font-weight: 700;
    color: var(--vis-muted);
}
.vis-form .vis-lines-head > span { min-width: 0; }
.vis-form .vis-h-name { grid-area: name; }
.vis-form .vis-h-qty { grid-area: qty; }
.vis-form .vis-h-price { grid-area: price; }
.vis-form .vis-h-disc { grid-area: disc; }
.vis-form .vis-h-total { grid-area: total; }
.vis-form .vis-h-del { grid-area: del; }
.vis-form .vis-line {
    margin-top: var(--vis-gap-sm);
    padding: .65rem .6rem;
    border: 1px solid var(--vis-line);
    border-radius: 12px;
    background: #fff;
    transition: box-shadow 180ms cubic-bezier(.2,.8,.2,1), transform 180ms cubic-bezier(.2,.8,.2,1);
}
.vis-form .vis-line:hover { transform: translateY(-1px); box-shadow: 0 6px 18px -8px rgba(15,23,42,.22); }
.vis-form .vis-line.is-short { border-color: var(--warning); }
.vis-form .vis-cell { min-width: 0; }
.vis-form .c-name { grid-area: name; }
.vis-form .c-qty { grid-area: qty; }
.vis-form .c-price { grid-area: price; }
.vis-form .c-disc { grid-area: disc; }
.vis-form .c-total { grid-area: total; }
.vis-form .c-del { grid-area: del; }
.vis-form .vis-cell-label { display: none; margin-bottom: .2rem; font-size: .62rem; font-weight: 700; color: var(--vis-muted); }
.vis-form .vis-line .form-control,
.vis-form .vis-line .input-group,
.vis-form .vis-line .ss { min-width: 0; width: 100%; }
.vis-form .vis-cell-note {
    margin-top: .25rem;
    font-size: .7rem;
    line-height: 1.5;
    color: var(--vis-muted);
    overflow-wrap: anywhere;
}
.vis-form .vis-line-total {
    padding: .45rem .35rem;
    border-radius: 9px;
    background: var(--primary-50);
    font-size: .8rem;
    font-weight: 800;
    text-align: center;
    overflow-wrap: anywhere;
}
.vis-form .vis-line-total small { font-size: .65rem; font-weight: 500; color: var(--vis-muted); }
.vis-form .vis-del-btn { width: 100%; }
/* ===== کمبوباکس درونسطری کالاها =====
   منو در جریان عادی صفحه است (نه position:fixed)، حداکثر ۵ گزینه رندر میشود،
   و هیچ max-height/overflow ندارد ← بدون اسکرول داخلی و بدون پرش. */
.vis-form .vis-combo { position: relative; min-width: 0; }
.vis-form .vis-combo-ctl {
    display: flex; align-items: center; gap: var(--vis-icon-gap); min-width: 0;
    border: 1px solid var(--vis-line); border-radius: 10px; background: #fff;
    padding: .1rem .35rem;
    transition: border-color 180ms cubic-bezier(.2,.8,.2,1);
}
.vis-form .vis-combo:focus-within .vis-combo-ctl { border-color: var(--vis-accent); }
.vis-form .vis-combo-ctl > i { flex: 0 0 auto; font-size: .75rem; color: var(--vis-accent); }
.vis-form .vis-combo-input {
    flex: 1 1 auto; min-width: 0; width: 100%;
    border: 0 !important; box-shadow: none !important; background: transparent !important;
    padding: .3rem .1rem !important;
    font-size: var(--vis-ctl-f) !important; min-height: var(--vis-ctl-h); line-height: 1.4;
}
.vis-form .vis-combo-chev { color: var(--vis-muted) !important; font-size: .62rem !important; cursor: pointer; }
.vis-form .vis-combo-close { color: var(--danger) !important; font-size: .68rem !important; cursor: pointer; }
.vis-form .vis-combo-selected {
    margin-top: .2rem; font-size: .66rem; color: var(--vis-ink); font-weight: 700;
    overflow-wrap: anywhere;
}
.vis-form .vis-combo-selected span { font-weight: 500; color: var(--vis-muted); }
.vis-form .vis-combo-menu {
    margin-top: .3rem; padding: .2rem;
    border: 1px solid var(--vis-line); border-radius: 10px; background: #fff;
    box-shadow: 0 6px 18px -8px rgba(15, 23, 42, .18);
}
.vis-form .vis-combo-opt {
    display: flex; flex-direction: column; gap: .05rem;
    padding: .3rem .4rem; border-radius: 7px; cursor: pointer; font-size: .7rem;
    transition: background 150ms ease;
}
.vis-form .vis-combo-opt:hover { background: var(--primary-50); }
.vis-form .vis-combo-opt small { font-size: .6rem; color: var(--vis-muted); overflow-wrap: anywhere; }
.vis-form .vis-combo-empty { padding: .3rem .4rem; font-size: .66rem; color: var(--vis-muted); }

/* ===== فاصلهٔ آیکون و متن =====
   آیکونها کنار متن نباید بچسبند: دکمهها flex میشوند تا gap حتی برای متنِ خام
   (text node) هم اعمال شود؛ در یادداشتها/هشدارها هم margin-inline-end میگیرند.
   آیکون تنها (مثل سطل حذف / ×) چون تکآیتم است، هیچ فاصلهای اضافه نمیگیرد. */
.vis-form .btn {
    display: inline-flex; align-items: center; justify-content: center;
    gap: var(--vis-icon-gap);
}
.vis-form .btn > i { margin: 0 !important; flex: 0 0 auto; }
.vis-form .card-header.vis-card-header > i,
.vis-form .vis-combo-ctl > i,
.vis-form .vis-card-actions > i { flex: 0 0 auto; }
.vis-form .vis-cell-note > i,
.vis-form .vis-field-note > i,
.vis-form .vis-status-note > i,
.vis-form .vis-action-note > i,
.vis-form .vis-date-note > i,
.vis-form .fin-header .badge > i,
.vis-form .alert > i,
