@namespace Inventory.Client.Pages
@page "/sales/visits/new"
@page "/sales/visits/{Id:int}/edit"
@inject ISalesVisitApi Api
@inject IToastService Toast
@inject LayoutState Layout
@inject NavigationManager Nav

<PageTitle>@(Id > 0 ? "ویرایش سفارش ویزیتوری" : "ثبت سفارش ویزیتوری جدید")</PageTitle>

<div class="fin-page-container fade-in vis-form">
    @if (lastSaved is not null)
    {
        <div class="alert alert-success d-flex flex-wrap align-items-center justify-content-between gap-3 p-3 rounded-4 mb-4 border border-success-subtle shadow-sm" data-last-saved>
            <div class="d-flex align-items-center gap-2.5">
                <div class="fin-avatar bg-emerald-subtle text-emerald"><i class="bi bi-check-lg fs-5"></i></div>
                <div>
                    <div class="fw-800 text-dark fs-7.5">سفارش شماره @lastSaved.Number با موفقیت ثبت شد</div>
                    <div class="fs-8 text-secondary">
                        @(lastSubmitted
                            ? "سفارش جهت تأیید مدیر فروش ارسال شد و فرم برای ثبت سفارش جدید آماده است."
                            : "پیشنویس ذخیره شد و فرم برای ثبت سفارش جدید آماده است.")
                    </div>
                </div>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-outline-success fin-btn-pill px-3" @onclick="OpenLastSaved">
                    <i class="bi bi-receipt me-1"></i> مشاهدهٔ سفارش
                </button>
                <button class="btn btn-sm btn-light fin-btn-pill px-2.5" @onclick="@(() => lastSaved = null)">
                    <i class="bi bi-x-lg"></i>
                </button>
            </div>
        </div>
    }

    <!-- ================== سربرگ ================== -->
    <div class="fin-header vis-form-header">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-pencil-square"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">@(Id > 0 ? "ویرایش سفارش ویزیتوری" : "ثبت سفارش ویزیتوری جدید")</h1>
                        <span class="badge rounded-pill fin-badge-indigo">ثبت فروش میدانی</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        انتخاب مشتری، تخصیص انبار، ثبت اقلام با استعلام برخط موجودی و سقف تخفیف مجاز
                    </div>
                    @if (!string.IsNullOrWhiteSpace(me?.CompanyName))
                    {
                        <div class="badge bg-light text-secondary border rounded-pill mt-1.5 fs-9" data-company-scope>
                            <i class="bi bi-buildings me-1 text-primary"></i> شرکت مجاز: <b>@me!.CompanyName</b>
                        </div>
                    }
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-secondary fin-btn-pill" @onclick="@(() => Nav.NavigateTo("/sales/visits"))">
                    <i class="bi bi-arrow-right me-1"></i> بازگشت به سفارش‌ها
                </button>
            </div>
        </div>
    </div>

@if (loading)
{
    <div class="vis-loading" data-loading-skeleton>
        <div class="vis-skeleton vis-skel-head"></div>
        <div class="vis-skeleton vis-skel-row"></div>
        <div class="vis-skeleton vis-skel-row"></div>
        <div class="vis-skeleton vis-skel-row"></div>
    </div>
}
else if (blocked is not null)
{
    <div class="empty-state" data-form-blocked>
        <i class="bi bi-shield-lock"></i>
        <h5>ثبت سفارش برای شما مجاز نیست</h5>
        <div class="text-muted fs-8">@blocked</div>
    </div>
}
else
{
    <div class="row vis-grid vis-form-layout">
        @* ---------------- ستون فرم ---------------- *@
        <div class="col-12">
            <div class="card">
                <div class="card-header vis-card-header">
                    <i class="bi bi-person-vcard"></i><span class="card-title">مشخصات سفارش</span>
                    <span class="vis-card-hint">اطلاعات پایهٔ سفارش</span>
                </div>
                <div class="card-body">
                    @* یک شبکهٔ واحد با فاصلهٔ یکسان افقی/عمودی؛ دیگر ردیفهای تودرتو
                       با g-2 و mt-1 وجود ندارد تا فاصلهٔ ستونها ناهماهنگ شود. *@
                    <div class="row vis-grid">
                        <div class="col-12 col-md-6 vis-field">
                            <label class="form-label">مشتری <span class="text-danger">*</span></label>
                            @* جستجو داخل خود کمبو است: نام، موبایل یا تلفن را تایپ کنید (فیلتر سمت سرور) *@
                            <div class="vis-inline-field">
                                <div class="vis-field-grow">
                                    <SearchSelect @key="formKey"
                                                  Items="customerLookup"
                                                  Value="model.PartyId"
                                                  ValueChanged="OnCustomerPicked"
                                                  RemoteSearch="true"
                                                  SearchChanged="SearchCustomersAsync"
                                                  Placeholder="جستجوی مشتری — نام، موبایل یا تلفن…" />
                                </div>
                                <button class="btn btn-outline-primary vis-icon-btn" @onclick="OpenCustomer"
                                        title="مشتری جدید — فرم تعریف مشتری (طرف حساب)">
                                    <i class="bi bi-person-plus"></i>
                                </button>
                            </div>
                            @if (customers.Count == 0)
                            {
                                <div class="vis-field-note text-warning">
                                    <i class="bi bi-exclamation-triangle"></i>
                                    برای شرکت شما مشتری فعالی ثبت نشده است؛ با دکمهٔ «مشتری جدید» همینجا اضافه کنید.
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-6 vis-field">
                            <label class="form-label">انبار <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="model.WarehouseId" @bind:after="ReloadProductLookupAsync">
                                <option value="0">— انتخاب انبار —</option>
                                @foreach (var w in warehouses)
                                {
                                    <option value="@w.Id">@w.Name</option>
                                }
                            </select>
                            @if (warehouses.Count == 0)
                            {
                                <div class="vis-field-note text-danger" data-no-warehouse>
                                    <i class="bi bi-exclamation-triangle"></i>
                                    هیچ انبار فعالی برای شرکت شما تعریف نشده است؛ از مدیر سیستم بخواهید
                                    در «انبارها» انبار این شرکت را ثبت کند.
                                </div>
                            }
                        </div>
                        <div class="col-12 col-md-4 vis-field vis-field--sm">
                            <label class="form-label">روش پرداخت</label>
                            <select class="form-select" @bind="model.PaymentMethod">
                                <option value="@PaymentMethod.Cash">نقدی</option>
                                <option value="@PaymentMethod.Credit">نسیه</option>
                                <option value="@PaymentMethod.Cheque">چک</option>
                                <option value="@PaymentMethod.Installment">اقساطی</option>
                            </select>
                        </div>
                        <div class="col-12 col-md-4 vis-field vis-field--sm">
                            <label class="form-label">تاریخ سفارش</label>
                            <DatePicker @bind-Value="orderDate" />
                        </div>
                        <div class="col-12 col-md-4 vis-field vis-field--sm">
                            <label class="form-label">
                                تاریخ دریافت محصول <span class="text-danger">*</span>
                                <i class="bi bi-info-circle text-muted" title="تاریخ تحویل مورد نظر شما؛ مدیر میتواند تاریخ نهایی را تغییر دهد و هر دو تاریخ در سابقه میماند."></i>
                            </label>
                            <DatePicker @bind-Value="deliveryDate" />
                            @if (deliveryDate.HasValue)
                            {
                                <div class="vis-field-note vis-date-note">
                                    <i class="bi bi-truck"></i>
                                    تحویل: <b>@deliveryDate.Value.ToFa()</b>
                                    <span class="text-muted">(@PersianDate.DayName(deliveryDate.Value))</span>
                                </div>
                            }
                        </div>
                        <div class="col-12 vis-field">
                            <label class="form-label">توضیحات</label>
                            <input class="form-control" @bind="model.Note" placeholder="توضیح کوتاه (اختیاری)" />
                        </div>
                    </div>
                </div>
            </div>

            @* ---------------- سطرهای کالا ---------------- *@
            <div class="card vis-stack">
                <div class="card-header vis-card-header">
                    <i class="bi bi-box-seam"></i><span class="card-title">کالاها</span>
                    <div class="vis-card-actions">
                        <span class="vis-counter">@Fa.Digits(model.Lines.Count) سطر</span>
                        @* همان رفتار و همان کلید میانبر فرم فروش: دکمه سطر خالی میسازد (F2) *@
                        <button class="btn btn-sm btn-outline-primary" data-hotkey="f2" title="کلید میانبر: F2"
                                @onclick="AddEmptyLine" disabled="@(model.WarehouseId <= 0)">
                            <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    @if (me is not null && me.ProductCount == 0)
                    {
                        <div class="alert alert-warning py-2 px-2 fs-8" data-no-product>
                            <i class="bi bi-exclamation-triangle"></i>
                            برای شرکت <b>@(string.IsNullOrWhiteSpace(me.CompanyName) ? "شما" : me.CompanyName)</b>
                            هیچ کالای فعالی تعریف نشده است؛ از مدیر سیستم بخواهید کالاهای این شرکت را ثبت کند.
                        </div>
                    }

                    @if (model.WarehouseId <= 0)
                    {
                        <div class="form-text text-warning">
                            <i class="bi bi-exclamation-triangle"></i>
                            ابتدا انبار را انتخاب کنید تا بتوانید سطر کالا اضافه کنید.
                        </div>
                    }

                    @* اقلام: گرید واکنشگرا، بدون جدول پهن و بدون هیچ اسکرول داخلی *@
                    @if (model.Lines.Count == 0)
                    {
                        <div class="vis-empty" data-no-lines>
                            <div class="vis-empty-ico"><i class="bi bi-basket"></i></div>
                            <h6>هنوز کالایی اضافه نشده است</h6>
                            <p>با کلید F2 یا دکمهٔ زیر یک سطر بسازید، سپس کالا را داخل همان سطر انتخاب کنید.</p>
                            <button class="btn btn-sm btn-outline-primary" @onclick="AddEmptyLine" disabled="@(model.WarehouseId <= 0)">
                                <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="vis-lines" data-no-scroll>
                            <div class="vis-lines-head">
                                <span class="vis-h-name">کالا</span>
                                <span class="vis-h-qty">مقدار</span>
                                <span class="vis-h-price">قیمت واحد (ریال)</span>
                                <span class="vis-h-disc" title="تا ۹۹ = درصد | از ۱۰۰ به بالا = مبلغ ریالی">تخفیف</span>
                                <span class="vis-h-total">جمع</span>
                                <span class="vis-h-del"></span>
                            </div>
                            @foreach (var l in model.Lines)
                            {
                                var available = AvailableOf(l);
                                var shortage = ShortageOf(l);
                                <div @key="l" class="vis-line @(shortage > 0 ? "is-short" : "")" data-shortage="@(shortage > 0 ? "1" : "0")">
                                    <div class="vis-cell c-name">
                                        <span class="vis-cell-label">کالا</span>
                                        @* کمبوی درونسطری: هیچ منوی fixed و هیچ JS مختصاتگیری نیست،
                                           پس با کیبورد موبایل/اسکرول نمیپرد. F2 همان سطر را باز میکند. *@
                                        <div class="vis-combo">
                                            <div class="vis-combo-ctl">
                                                <i class="bi bi-box-seam"></i>
                                                <input class="form-control form-control-sm vis-combo-input"
                                                       value="@ComboText(l)" placeholder="جستجوی کالا…" autocomplete="off"
                                                       @onfocus="@(() => OpenCombo(l))"
                                                       @oninput="e => OnComboInput(l, e.Value?.ToString())"
                                                       @onkeydown="e => OnComboKey(l, e)" />
                                                @if (IsComboOpen(l))
                                                {
                                                    <i class="bi bi-x-lg vis-combo-close" @onclick="CloseCombo"></i>
                                                }
                                                else
                                                {
                                                    <i class="bi bi-chevron-down vis-combo-chev" @onclick="@(() => OpenCombo(l))"></i>
                                                }
                                            </div>
                                            @if (l.ProductId > 0)
                                            {
                                                <div class="vis-combo-selected">@l.ProductName <span>@l.ProductCode — @l.Unit</span></div>
                                            }
                                            @if (IsComboOpen(l))
                                            {
                                                var matches = ComboMatches();
                                                <div class="vis-combo-menu" data-combo-menu>
                                                    @foreach (var opt in matches)
                                                    {
                                                        <div class="vis-combo-opt" @onmousedown:preventDefault="true"
                                                             @onclick="@(() => PickCombo(l, opt.Id))">
                                                            <span>@opt.Name</span><small>@opt.InfoText</small>
                                                        </div>
                                                    }
                                                    @if (matches.Count == 0)
                                                    {
                                                        <div class="vis-combo-empty">موردی یافت نشد؛ عبارت را دقیقتر کنید.</div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="vis-cell c-qty">
                                        <span class="vis-cell-label">مقدار</span>
                                        <input class="form-control form-control-sm num" value="@l.Quantity.ToString("0.##")"
                                               @onchange="e => SetQty(l, e.Value?.ToString())" />
                                        @if (shortage > 0)
                                        {
                                            <div class="vis-cell-note text-danger" data-stock-alarm>
                                                <i class="bi bi-exclamation-triangle"></i>
                                                موجودی @Fa.Number(available) — کسری @Fa.Number(shortage)
                                            </div>
                                        }
                                        else if (l.ProductId > 0)
                                        {
                                            <div class="vis-cell-note vis-minor">موجودی: @Fa.Number(available) @l.Unit</div>
                                        }
                                    </div>
                                    <div class="vis-cell c-price">
                                        <span class="vis-cell-label">قیمت واحد (ریال)</span>
                                        @* قیمت واحد برای ویزیتور خاکستری و غیرقابل ویرایش است (فقط خواندنی) *@
                                        <MoneyInput Value="l.UnitPrice"
                                                    ValueChanged="v => SetPrice(l, v)"
                                                    Disabled="@(me?.CanApprove != true && me?.IsAdmin != true)"
                                                    ReadOnly="@(me?.CanApprove != true && me?.IsAdmin != true)"
                                                    CssClass="@($"form-control form-control-sm text-center num {(me?.CanApprove != true && me?.IsAdmin != true ? "bg-light text-muted" : "")}")" />
                                    </div>
                                    <div class="vis-cell c-disc">
                                        <span class="vis-cell-label">تخفیف</span>
                                        @* دو حالته: تا ۹۹ = درصد، از ۱۰۰ به بالا = مبلغ ریالی *@
                                        <div class="input-group input-group-sm">
                                            <input class="form-control form-control-sm text-center num"
                                                   value="@DiscountText(l)"
                                                   @oninput="e => OnDiscountInput(l, e.Value?.ToString())"
                                                   @onblur="e => OnDiscountBlur(l)"
                                                   inputmode="numeric" dir="ltr" />
                                            <span class="input-group-text @(l.DiscountIsAmount ? "text-primary" : "")"
                                                  title="@(l.DiscountIsAmount ? "مبلغ ریالی" : "درصد")">
                                                @(l.DiscountIsAmount ? "ریال" : "٪")
                                            </span>
                                        </div>
                                        @* مبلغ تخفیف همان ردیف — همیشه به ریال نمایش داده میشود *@
                                        @if (LineDiscount(l) > 0)
                                        {
                                            <div class="vis-cell-note discount-line" data-line-discount="@LineDiscount(l)">
                                                <span class="text-danger num">@Fa.Money(LineDiscount(l)) ریال</span>
                                                @if (l.DiscountIsAmount)
                                                {
                                                    <span class="text-muted">(@Fa.Digits(l.DiscountPercent) درصد)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                    <div class="vis-cell c-total">
                                        <span class="vis-cell-label">جمع سطر</span>
                                        <div class="vis-line-total num">@Fa.Money(l.LineTotal) <small>ریال</small></div>
                                    </div>
                                    <div class="vis-cell c-del">
                                        <button class="btn btn-sm btn-outline-danger vis-del-btn" title="حذف سطر"
                                                @onclick="@(() => model.Lines.Remove(l))">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }

                    @if (me?.CanApprove == true || me?.IsAdmin == true)
                    {
                        <div class="badge bg-info-subtle text-info border border-info-subtle p-2 mt-2 d-inline-flex align-items-center gap-1">
                            <i class="bi bi-shield-check"></i> دسترسی مدیر: شما مجاز به اعمال هر مقدار تخفیف بدون محدودیت سقف هستید.
                        </div>
                    }
                    else if (me?.MaxDiscountPercent > 0)
                    {
                        <div class="form-text mt-2 text-warning-emphasis">
                            <i class="bi bi-info-circle ms-1"></i> سقف تخفیف مجاز شما: <b>@Fa.Digits(me.MaxDiscountPercent) درصد</b> (تخفیف بالاتر نیازمند تأیید مدیر است).
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ---------------- بازبینی مالی و اقدامها (تمامعرض، زیر کالاها) ---------------- *@
        <div class="col-12 vis-stack">
            <div class="vis-review" data-review-bar>
                <div class="vis-kpi"><span>جمع کل</span><b class="num">@Fa.Money(Gross) <small>ریال</small></b></div>
                <div class="vis-kpi"><span>تخفیف</span><b class="num text-danger">@Fa.Money(Discount) <small>ریال</small></b></div>
                <div class="vis-kpi vis-kpi-total"><span>قابل پرداخت</span><b class="num">@Fa.Money(Net) <small>ریال</small></b></div>
            </div>

            @if (OverLimit)
            {
                <div class="alert alert-warning py-2 px-2 mt-2 fs-8 mb-0">
                    <i class="bi bi-exclamation-triangle"></i>
                    تخفیف یک یا چند سطر از سقف مجاز شما بیشتر است؛ سفارش با علامت «تأیید ویژه» به مدیر میرود.
                </div>
            }

            @if (ShortLines.Count > 0)
            {
                <div class="alert alert-warning py-2 px-2 mt-2 mb-0 fs-8" data-stock-summary>
                    <b><i class="bi bi-exclamation-triangle"></i> کسری موجودی در @Fa.Digits(ShortLines.Count) قلم:</b>
                    @foreach (var sh in ShortLines)
                    {
                        <div class="fs-9">
                            @sh.Line.ProductName — موجودی @Fa.Number(sh.Available)، نیاز @Fa.Number(sh.Line.Quantity)
                        </div>
                    }
                    <div class="fs-9 mt-1">ثبت سفارش انجام میشود؛ ولی پیش از ثبت فروش باید موجودی تأمین شود.</div>
                </div>
            }

            @* سفارش «در انتظار تأیید» دیگر دکمهٔ ارسال ندارد *@
            @if (!CanSubmit)
            {
                <div class="alert alert-info vis-status-note" data-pending-note>
                    <i class="bi bi-hourglass-split"></i>
                    این سفارش در انتظار تأیید مدیر است؛ با ذخیرهٔ تغییرات، همچنان در صف تأیید میماند.
                </div>
            }

            <div class="vis-actionbar">
                <div class="vis-action-btns">
                    @if (CanSubmit)
                    {
                        <button class="btn btn-primary" disabled="@saving" @onclick="@(() => SaveAsync(true))">
                            <i class="bi bi-send-check"></i> ذخیره و ارسال برای تأیید
                        </button>
                    }
                    <button class="btn btn-outline-secondary" disabled="@saving" @onclick="@(() => SaveAsync(false))">
                        <i class="bi bi-save"></i> @(Id > 0 ? "ذخیرهٔ تغییرات" : "ذخیرهٔ پیشنویس")
                    </button>
                </div>
                <div class="vis-field-note vis-action-note">
                    @(CanSubmit
                        ? "تا زمانی که ارسال نکنید، سفارش روی موجودی و حساب مشتری هیچ اثری ندارد."
                        : "تغییرات ذخیرهشده به اطلاع مدیر فروش میرسد.")
                </div>
            </div>
        </div>
    </div>
}

@* ================== آلارم کسری موجودی — پیش از ثبت ==================
   قاعدهٔ کارفرما: اگر موجودی کافی نیست آلارم داده شود؛ با «تأیید» کاربر ثبت انجام
   می‌شود و با «انصراف» کار متوقف می‌ماند (هیچ سفارشی ذخیره نمی‌شود).
   ==================================================================== *@
@if (showStockConfirm)
{
    <div class="vis-modal-back">
        <div class="vis-modal" data-stock-confirm>
            <div class="d-flex align-items-center gap-2 mb-2">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-4"></i>
                <b>کسری موجودی انبار</b>
            </div>
            <div class="fs-8 mb-2">
                برای @Fa.Digits(ShortLines.Count) قلم، موجودی انبار «@WarehouseName» کمتر از مقدار سفارش است:
            </div>
            <table class="table table-sm mb-2">
                <thead><tr><th>کالا</th><th class="text-start">نیاز</th><th class="text-start">موجودی</th><th class="text-start">کسری</th></tr></thead>
                <tbody>
                    @foreach (var sh in ShortLines)
                    {
                        <tr>
                            <td class="fs-8">@sh.Line.ProductName</td>
                            <td class="text-start fs-8 num">@Fa.Number(sh.Line.Quantity)</td>
                            <td class="text-start fs-8 num">@Fa.Number(sh.Available)</td>
                            <td class="text-start fs-8 num text-danger">@Fa.Number(sh.Shortage)</td>
                        </tr>
                    }
                </tbody>
            </table>
            <div class="fs-8 text-muted mb-3">
                @(pendingSubmit
                    ? "با تأیید شما، سفارش با همین مقادیر ثبت و ارسال میشود؛ تأمین موجودی پیش از ثبت فروش لازم است."
                    : "با تأیید شما، پیشنویس سفارش با همین مقادیر ثبت میشود؛ تأمین موجودی پیش از ثبت فروش لازم است.")
            </div>
            <div class="d-flex gap-2 justify-content-end">
                <button class="btn btn-light" data-stock-cancel @onclick="CancelStockSave">انصراف</button>
                <button class="btn btn-warning" data-stock-proceed @onclick="ProceedWithShortage">
                    <i class="bi bi-check2-circle"></i> تأیید و ادامهٔ ثبت سفارش
                </button>
            </div>
        </div>
    </div>
}

