@code {
    [Parameter] public int Id { get; set; }

    private enum DecisionKind { Return, Reject }

    private bool loading = true;
    private VisOrderDto? order;
    private VisActorInfo? me;
    private DecisionKind? decision;
    private string? comment;

    /// <summary>ویرایش تا زمانی که مدیر تأیید نکرده: پیش‌نویس، ارسال‌شده و برگشتی.</summary>
    /// <summary>
    /// ارسال فقط برای پیشنویس یا سفارش برگشتی مجاز است. سفارش «در انتظار تأیید»
    /// قبلاً ارسال شده است، پس دکمهٔ «ارسال برای تأیید» نباید دیده شود.
    /// </summary>
    private bool CanSubmit => order is not null
        && order.Status is VisOrderStatus.Draft or VisOrderStatus.Returned
        && (me?.CanCreate == true || me?.CanApprove == true);

    private bool CanEdit => order is not null
        && order.Status is VisOrderStatus.Draft or VisOrderStatus.Submitted or VisOrderStatus.Returned
        && (me?.CanCreate == true || me?.CanApprove == true);

    private bool CanCancel => order is not null
        && order.Status is VisOrderStatus.Draft or VisOrderStatus.Returned or VisOrderStatus.Submitted;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        try
        {
            me = await Api.MeAsync();
            order = await Api.GetAsync(Id);
            Layout.SetTitle(order?.Number ?? "سفارش ویزیتوری");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task SubmitAsync()
    {
        try
        {
            order = await Api.SubmitAsync(Id);
            Toast.Success("سفارش برای تأیید مدیر فروش ارسال شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task ApproveAsync()
    {
        try
        {
            order = await Api.ApproveAsync(Id, null);
            Toast.Success("سفارش تأیید شد و به صف مالی رفت.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void StartDecision(DecisionKind kind)
    {
        decision = kind;
        comment = "";
    }

    private async Task SendDecisionAsync()
    {
        if (string.IsNullOrWhiteSpace(comment)) { Toast.Error("دلیل را وارد کنید."); return; }
        try
        {
            order = decision == DecisionKind.Return
                ? await Api.ReturnAsync(Id, comment!)
                : await Api.RejectAsync(Id, comment!);
            Toast.Success("تصمیم ثبت شد.");
            decision = null;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private bool showFinance;

    private async Task OnFinanceDone(VisOrderDto res)
    {
        showFinance = false;
        order = res;
        await InvokeAsync(StateHasChanged);
    }

    private async Task CancelAsync()
    {
        try
        {
            order = await Api.CancelAsync(Id, "ابطال از صفحهٔ سفارش");
            Toast.Info("سفارش ابطال شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
