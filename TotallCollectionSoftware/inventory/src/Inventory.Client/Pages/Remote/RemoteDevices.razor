@page "/remote"
@using Inventory.Shared.Dtos
@inject IApiClient Api
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IToastService Toast

<PageTitle>ریموت دسکتاپ</PageTitle>

<div class="page-head">
    <div>
        <h1>ریموت دسکتاپ</h1>
        <p class="lead">پشتیبانی از راه دور سیستم‌های دارای ایجنت RemoteAgent</p>
    </div>
    <div class="d-flex gap-2 me-auto">
        <button class="btn btn-outline-primary" @onclick="LoadAsync"><i class="bi bi-arrow-clockwise"></i> تازه‌سازی</button>
        @if (canManage)
        {
            <a class="btn btn-primary" href="/settings/remote"><i class="bi bi-gear"></i> مدیریت دستگاه‌ها</a>
        }
    </div>
</div>

@if (!canView)
{
    <div class="alert alert-warning">شما مجوز مشاهدهٔ ماژول ریموت دسکتاپ را ندارید.</div>
}
else if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="card">
        <div class="card-header"><i class="bi bi-display"></i> دستگاه‌ها</div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>نام</th><th>شرکت</th><th>سیستم‌عامل</th><th>وضعیت</th><th>آخرین اتصال</th><th></th>
                    </tr>
                </thead>
                <tbody>
                    @if (devices.Count == 0)
                    {
                        <tr><td colspan="6" class="text-center text-muted py-4">دستگاهی ثبت نشده است.</td></tr>
                    }
                    @foreach (var d in devices)
                    {
                        <tr>
                            <td>@d.Name</td>
                            <td>@d.CompanyCode</td>
                            <td dir="ltr">@d.Os</td>
                            <td>
                                @if (!d.IsEnabled)
                                {
                                    <span class="badge bg-secondary">غیرفعال</span>
                                }
                                else if (d.IsOnline)
                                {
                                    <span class="badge bg-success">آنلاین</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-dark">آفلاین</span>
                                }
                            </td>
                            <td dir="ltr">@(d.LastSeenAt?.ToString("yyyy/MM/dd HH:mm") ?? "—")</td>
                            <td class="text-nowrap">
                                <button class="btn btn-sm btn-outline-primary" disabled="@(!d.IsOnline || !d.IsEnabled || busy)" @onclick="() => ConnectAsync(d, true)">
                                    <i class="bi bi-eye"></i> مشاهده
                                </button>
                                @if (canControl)
                                {
                                    <button class="btn btn-sm btn-primary" disabled="@(!d.IsOnline || !d.IsEnabled || busy)" @onclick="() => ConnectAsync(d, false)">
                                        <i class="bi bi-mouse"></i> کنترل
                                    </button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

@code {
    private List<RemoteDeviceDto> devices = new();
    private bool loading = true, busy, canView, canControl, canManage;

    protected override async Task OnInitializedAsync()
    {
        canView = Auth.IsAdmin || Auth.CanSee("RemoteDesktop");
        canControl = Auth.IsAdmin || Auth.Has("RemoteDesktop.Control");
        canManage = Auth.IsAdmin || Auth.Has("RemoteDesktop.Manage");
        if (canView) await LoadAsync();
        loading = false;
    }

    private async Task LoadAsync()
    {
        try { devices = await Api.GetAsync<List<RemoteDeviceDto>>("api/remote/devices"); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        StateHasChanged();
    }

    private async Task ConnectAsync(RemoteDeviceDto d, bool viewOnly)
    {
        busy = true;
        try
        {
            var session = await Api.PostAsync<RemoteSessionDto>("api/remote/sessions", new { deviceId = d.Id, viewOnly });
            Nav.NavigateTo($"/remote/view/{session.Id}");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }
}
