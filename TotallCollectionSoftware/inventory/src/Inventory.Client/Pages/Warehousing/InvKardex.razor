@page "/inv/kardex"
@page "/operations/reports/kardex-rial"
@inject IInvReportService ReportSvc
@inject IInvProductService ProductSvc
@inject IInvWarehouseService WarehouseSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>گزارش کاردکس مقداری و ریالی کالا</PageTitle>

<div class="fin-page-container fade-in" @ref="printRoot">
    <!-- ================== سربرگ لوکس ================== -->
    <div class="fin-header mb-4 d-print-none">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-currency-exchange"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">کاردکس ریالی و مقداری کالا</h1>
                        <span class="badge rounded-pill fin-badge-indigo">حسابداری انبار</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        رهگیری گردش ورودی، خروجی، فی تمام‌شده و ارزش دفتری مانده کالا بر پایه اسناد قطعی
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-secondary fin-btn-pill" disabled="@(result is null)" @onclick="Print">
                    <i class="bi bi-printer-fill me-1"></i> چاپ رسمی کاردکس
                </button>
            </div>
        </div>
    </div>

    <!-- ================== نوار فیلتر ================== -->
    <div class="fin-card mb-4 d-print-none">
        <div class="fin-card-body p-3">
            <div class="row g-2.5 align-items-end">
                <div class="col-12 col-md-4">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">انتخاب کالا <span class="text-danger">*</span></label>
                    <SearchSelect Items="products" Value="productId" ValueChanged="OnProduct" Placeholder="جستجوی کالا با نام یا کد…" />
                </div>
                <div class="col-6 col-md-3">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">انبار</label>
                    <select class="form-select fin-input" value="@(warehouseId?.ToString() ?? "")" @onchange="OnWarehouse">
                        <option value="">همه انبارها</option>
                        @foreach (var w in warehouses)
                        {
                            <option value="@w.Id">@w.Name</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">از تاریخ</label>
                    <DatePicker Value="from" ValueChanged="OnFrom" AllowClear="true" />
                </div>
                <div class="col-6 col-md-2">
                    <label class="form-label fs-8 fw-700 text-dark mb-1.5">تا تاریخ</label>
                    <DatePicker Value="to" ValueChanged="OnTo" AllowClear="true" />
                </div>
                <div class="col-6 col-md-1">
                    <button class="btn btn-primary fin-btn-pill w-100" disabled="@(productId <= 0 || loading)" @onclick="Load">
                        <i class="bi bi-search"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    @if (loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
            <div class="text-secondary fs-8 mt-2">در حال ارزیابی ارزش دفتری و محاسبه کاردکس ریالی...</div>
        </div>
    }
    else if (result is null)
    {
        <div class="fin-card">
            <div class="fin-card-body text-center py-5">
                <div class="fin-avatar bg-slate-subtle text-slate mx-auto mb-2" style="width:52px;height:52px">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
                <h5 class="fw-800 text-dark">کالایی انتخاب نشده است</h5>
                <p class="text-secondary fs-8 mb-0">جهت استخراج کاردکس، ابتدا کالای مورد نظر را از کادر بالا انتخاب کنید.</p>
            </div>
        </div>
    }
    else
    {
        <!-- ================== مشخصات کالا ================== -->
        <div class="fin-card mb-4">
            <div class="fin-card-body p-3.5">
                <div class="d-flex flex-wrap align-items-center justify-content-between gap-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="fin-avatar bg-indigo-subtle text-indigo" style="width:48px;height:48px;">
                            <i class="bi bi-box-seam fs-4"></i>
                        </div>
                        <div>
                            <div class="fw-800 text-dark fs-6">@result.ProductName</div>
                            <div class="text-secondary fs-8 num mt-0.5">
                                کد: @result.ProductCode — واحد سنجش: @result.Unit — انبار: @(result.WarehouseName ?? "همه انبارها")
                            </div>
                        </div>
                    </div>
                    <span class="badge bg-indigo-subtle text-indigo rounded-pill px-3 py-2 fs-8 fw-700">
                        <i class="bi bi-calculator me-1"></i> روش قیمت‌گذاری: @result.MethodTitle
                    </span>
                </div>
            </div>
        </div>

        <!-- ================== کارت‌های KPI ================== -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-slate">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-slate">مانده ابتدای دوره</span>
                            <div class="fin-kpi-value text-dark num mt-1">@result.OpeningQty.Num() <small class="fs-9 text-secondary">@result.Unit</small></div>
                            <div class="fin-kpi-unit">ارزش: @result.OpeningValue.Money() ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-slate-subtle text-slate">
                            <i class="bi bi-hourglass-top"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="text-secondary fs-9">موجودی افتتاحیه بازه</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-emerald">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-emerald">جمع کل وارده انبار</span>
                            <div class="fin-kpi-value text-emerald num mt-1">@result.TotalInQty.Num() <small class="fs-9 text-secondary">@result.Unit</small></div>
                            <div class="fin-kpi-unit">ارزش: @result.TotalInValue.Money() ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                            <i class="bi bi-box-arrow-in-down"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">رسیدهای انبار</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-rose">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-rose">جمع کل صادره انبار</span>
                            <div class="fin-kpi-value text-rose num mt-1">@result.TotalOutQty.Num() <small class="fs-9 text-secondary">@result.Unit</small></div>
                            <div class="fin-kpi-unit">ارزش: @result.TotalOutValue.Money() ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-rose-subtle text-rose">
                            <i class="bi bi-box-arrow-up"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-rose-subtle text-rose rounded-pill px-2.5">حواله‌های خروج و فروش</span>
                    </div>
                </div>
            </div>

            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-indigo">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-indigo">مانده پایان دوره</span>
                            <div class="fin-kpi-value text-indigo num mt-1">@result.ClosingQty.Num() <small class="fs-9 text-secondary">@result.Unit</small></div>
                            <div class="fin-kpi-unit">ارزش دفتری: @result.ClosingValue.Money() ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                            <i class="bi bi-boxes"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5">موجودی نهایی انبار</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- ================== جدول کاردکس ================== -->
        <div class="fin-card">
            <div class="fin-card-header d-flex justify-content-between align-items-center p-3 border-bottom">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-table text-primary fs-5"></i>
                    <span class="fw-800 text-dark">ریز تراکنش‌ها و گردش ریالی کالا</span>
                </div>
                <span class="badge bg-indigo-subtle text-indigo rounded-pill px-3 py-1.5 num fs-8">
                    @result.Rows.Count.Num() گردش ثبت‌شده
                </span>
            </div>
            <div class="fin-card-body p-0">
                @if (result.Rows.Count == 0)
                {
                    <div class="text-center py-5">
                        <div class="fin-avatar bg-slate-subtle text-slate mx-auto mb-2" style="width:52px;height:52px">
                            <i class="bi bi-inboxes fs-3"></i>
                        </div>
                        <h5 class="fw-800 text-dark">گردشی در این بازه ثبت نشده است</h5>
                        <p class="text-secondary fs-8 mb-0">برای این کالا در محدوده تاریخی انتخاب‌شده سندی وجود ندارد.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0 fin-table">
                            <thead class="bg-light">
                                <tr>
                                    <th rowspan="2" class="text-secondary fs-8 fw-700 py-3 text-center" style="width:40px">#</th>
                                    <th rowspan="2" class="text-secondary fs-8 fw-700 py-3">تاریخ سند</th>
                                    <th rowspan="2" class="text-secondary fs-8 fw-700 py-3">شماره و نوع سند</th>
                                    <th rowspan="2" class="text-secondary fs-8 fw-700 py-3">طرف‌حساب و شرح</th>
                                    <th colspan="3" class="text-center text-emerald fs-8 fw-700 py-2 border-start border-end" style="background:#ecfdf5">وارده (ورود به انبار)</th>
                                    <th colspan="3" class="text-center text-rose fs-8 fw-700 py-2 border-end" style="background:#fff1f2">صادره (خروج از انبار)</th>
                                    <th colspan="3" class="text-center text-indigo fs-8 fw-700 py-2" style="background:#eef2ff">مانده مقداری و ریالی</th>
                                </tr>
                                <tr>
                                    <th class="text-center text-emerald fs-8 fw-600 border-start" style="background:#f0fdf4">مقدار</th>
                                    <th class="text-center text-emerald fs-8 fw-600" style="background:#f0fdf4">فی (ریال)</th>
                                    <th class="text-center text-emerald fs-8 fw-600 border-end" style="background:#f0fdf4">مبلغ کل (ریال)</th>
                                    <th class="text-center text-rose fs-8 fw-600" style="background:#fff1f2">مقدار</th>
                                    <th class="text-center text-rose fs-8 fw-600" style="background:#fff1f2">فی (ریال)</th>
                                    <th class="text-center text-rose fs-8 fw-600 border-end" style="background:#fff1f2">مبلغ کل (ریال)</th>
                                    <th class="text-center text-indigo fs-8 fw-600" style="background:#f5f7ff">مقدار مانده</th>
                                    <th class="text-center text-indigo fs-8 fw-600" style="background:#f5f7ff">میانگین فی</th>
                                    <th class="text-center text-indigo fs-8 fw-600" style="background:#f5f7ff">ارزش مانده</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="bg-light fw-700">
                                    <td class="text-center num text-secondary">—</td>
                                    <td colspan="3" class="text-dark">مانده ابتدای دوره (افتتاحیه)</td>
                                    <td colspan="6" class="border-start border-end"></td>
                                    <td class="text-center num fw-800 text-indigo">@result.OpeningQty.Num()</td>
                                    <td class="text-center num text-secondary">@(result.OpeningQty != 0 ? (result.OpeningValue / result.OpeningQty).Money() : "—")</td>
                                    <td class="text-center num fw-800 text-indigo">@result.OpeningValue.Money()</td>
                                </tr>
                                @{ var rowIdx = 1; }
                                @foreach (var r in result.Rows)
                                {
                                    <tr>
                                        <td class="text-center num text-secondary fs-8">@((rowIdx++).FaDigits())</td>
                                        <td class="num text-secondary fs-8">@r.Date.ToFaDate()</td>
                                        <td>
                                            <a href="@($"/inv/docs/edit/{r.DocId}")" class="fw-700 text-primary num text-decoration-none">
                                                @r.Number
                                            </a>
                                            <div class="text-secondary fs-9">@r.DocTypeName@(string.IsNullOrWhiteSpace(r.WarehouseName) ? "" : $" — {r.WarehouseName}")</div>
                                        </td>
                                        <td class="fs-8">
                                            <div class="fw-700 text-dark">@(string.IsNullOrWhiteSpace(r.PartyName) ? "—" : r.PartyName)</div>
                                            @if (!string.IsNullOrWhiteSpace(r.Description))
                                            {
                                                <div class="text-secondary fs-9">@r.Description</div>
                                            }
                                        </td>
                                        <td class="text-center num text-emerald fw-700 border-start">@(r.InQty != 0 ? r.InQty.Num() : "")</td>
                                        <td class="text-center num text-secondary fs-8">@(r.InQty != 0 ? r.InPrice.Money() : "")</td>
                                        <td class="text-center num text-emerald fw-700 border-end">@(r.InQty != 0 ? r.InValue.Money() : "")</td>
                                        <td class="text-center num text-rose fw-700">@(r.OutQty != 0 ? r.OutQty.Num() : "")</td>
                                        <td class="text-center num text-secondary fs-8">@(r.OutQty != 0 ? r.OutPrice.Money() : "")</td>
                                        <td class="text-center num text-rose fw-700 border-end">@(r.OutQty != 0 ? r.OutValue.Money() : "")</td>
                                        <td class="text-center num fw-800 text-indigo">@r.BalanceQty.Num()</td>
                                        <td class="text-center num text-secondary fs-8">@r.BalanceAvg.Money()</td>
                                        <td class="text-center num fw-800 text-indigo">@r.BalanceValue.Money()</td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot class="bg-light fw-800">
                                <tr>
                                    <td colspan="4" class="text-end text-dark py-3">جمع کل گردش دوره:</td>
                                    <td class="text-center num text-emerald border-start">@result.TotalInQty.Num()</td>
                                    <td></td>
                                    <td class="text-center num text-emerald border-end">@result.TotalInValue.Money()</td>
                                    <td class="text-center num text-rose">@result.TotalOutQty.Num()</td>
                                    <td></td>
                                    <td class="text-center num text-rose border-end">@result.TotalOutValue.Money()</td>
                                    <td class="text-center num text-indigo fs-7">@result.ClosingQty.Num()</td>
                                    <td></td>
                                    <td class="text-center num text-indigo fs-7">@result.ClosingValue.Money()</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>


<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
.fin-header {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
}
.fin-header-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 6px 16px -2px rgba(79, 70, 229, 0.35);
    flex-shrink: 0;
}
.fin-badge-status {
    background: #eef2ff;
    color: #4338ca;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-btn-pill {
    border-radius: 20px;
    padding: 0.45rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.2s;
}

/* کارت‌های شاخص KPI لوکس */
.fin-kpi-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
}
.fin-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.08);
}
.fin-kpi-card.border-rose { border-top: 4px solid #ef4444; }
.fin-kpi-card.border-emerald { border-top: 4px solid #10b981; }
.fin-kpi-card.border-indigo { border-top: 4px solid #4f46e5; }
.fin-kpi-card.border-slate { border-top: 4px solid #64748b; }

.fin-kpi-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.fin-kpi-value {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.2;
}
.fin-kpi-unit {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 0.1rem;
}
.fin-kpi-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}
.fin-kpi-footer {
    border-top: 1px dashed #f1f5f9;
}

/* کارت فیلتر */
.fin-filter-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.1rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
}
.fin-label {
    font-size: 0.74rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.35rem;
    display: block;
}
.fin-input {
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    font-size: 0.82rem;
}
.fin-btn-submit {
    border-radius: 10px;
    height: 33px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.88rem;
    box-shadow: 0 4px 12px rgba(79, 70, 229, 0.3);
}

/* جدول داده‌ها */
.fin-table-card {
    background: #ffffff;
    border-radius: 18px;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    overflow: hidden;
}
.fin-table-header {
    padding: 1.1rem 1.4rem;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    justify-content: space-between;
    align-items: center;
    background: #fbfcfe;
}
.fin-table-header-icon {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.1rem;
}
.fin-table-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 0.1rem;
}
.fin-table-sub {
    font-size: 0.72rem;
    color: #64748b;
    margin-bottom: 0;
}

.fin-table {
    margin-bottom: 0;
    font-size: 0.82rem;
}
.fin-table thead th {
    background: #f8fafc;
    color: #475569;
    font-weight: 700;
    font-size: 0.74rem;
    padding: 0.85rem 0.9rem;
    border-bottom: 1.5px solid #e2e8f0;
    white-space: nowrap;
}
.fin-table tbody td {
    padding: 0.85rem 0.9rem;
    border-bottom: 1px solid #f1f5f9;
}
.fin-table-row:hover {
    background: #f8fafc;
}
.fin-table-total-row {
    background: #f8fafc;
    border-top: 2px solid #cbd5e1;
}
.fin-table-total-row td {
    padding: 1rem 0.9rem;
}

.fin-avatar {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #eef2ff;
    color: #4f46e5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
    flex-shrink: 0;
}
.fin-avatar-lg {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.4rem;
    flex-shrink: 0;
}

/* صفحه صورت‌حساب شخص */
.fin-statement-header-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.04);
}
.fin-statement-kpi-badge {
    padding: 0.85rem 1.4rem;
    border-radius: 14px;
