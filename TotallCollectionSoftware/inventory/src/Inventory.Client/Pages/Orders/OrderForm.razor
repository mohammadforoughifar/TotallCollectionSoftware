    /// <summary>ثبت/ذخیره و سپس چاپ فاکتور (دکمهٔ «ثبت و چاپ» در پایین فرم).</summary>
    private Task SaveAndPrint() => SaveInternal(printAfterSave: true);

    /// <summary>
    /// چاپ فاکتور فروش/رسید خرید با قالب مستقل (همان SaleInvoicePrint که در چاپ فاکتورِ
    /// تبدیل‌شدهٔ تعمیرات هم استفاده می‌شود). چاپ در iframe جدا انجام می‌شود.
    /// </summary>
    private async Task PrintOrderAsync(int orderId)
    {
        try
        {
            companyProfile ??= await ProfileSvc.GetAsync();
            var order = await OrderSvc.GetAsync(orderId);
            if (order is null || order.Lines.Count == 0)
            {
                InvoiceError("سند ذخیره شد، ولی برای چاپ قلمی پیدا نشد.");
                return;
            }
            var html = SaleInvoicePrint.Build(order, companyProfile);
            var opened = await JS.InvokeAsync<bool>("giPrint", html);
            if (!opened)
                InvoiceError("پنجرهٔ چاپ باز نشد؛ لطفاً اجازهٔ پنجرهٔ بازشو (pop-up) را در مرورگر فعال کنید.");
        }
        catch (Exception ex) { InvoiceError("چاپ انجام نشد: " + ex.Message); }
    }

    private CompanyProfileDto? companyProfile;

    private bool ValidateInvoice()
    {
        if (warehouseId == 0) { ShowFormError("انبار را انتخاب کنید."); return false; }
        if (partyId == 0) { ShowFormError("طرف حساب را انتخاب کنید."); return false; }
        if (!date.HasValue) { ShowFormError("تاریخ سند را وارد کنید."); return false; }

        var validLines = lines.Where(l => l.ProductId > 0 && l.Qty > 0).ToList();
        if (validLines.Count == 0) { ShowFormError("حداقل یک سطر کالای معتبر وارد کنید."); return false; }
        if (CopyTemplate is not null && !IsEdit)
        {
            if (!activeWarehouseIds.Contains(warehouseId)) { ShowFormError("انبار فاکتور قبلی غیرفعال است؛ انبار فعال انتخاب کنید."); return false; }
            if (!activePartyIds.Contains(partyId)) { ShowFormError("طرف حساب فاکتور قبلی غیرفعال است؛ طرف حساب فعال انتخاب کنید."); return false; }
            if (validLines.Any(l => l.Price != decimal.Round(l.Price, 2) ||
                                    (!l.DiscountIsAmount && l.DiscountPercent != decimal.Round(l.DiscountPercent, 2))))
            {
                ShowFormError("در فاکتور کپی‌شده، قیمت و درصد تخفیف حداکثر دو رقم اعشار دارند؛ مقادیر قدیمی را اصلاح کنید.");
                return false;
            }
            if (validLines.Any(l => !products.Any(p => p.Id == l.ProductId && IsProductSelectable(p))))
            {
                ShowFormError("کالای غیرفعال یا نامجاز در انبار را از فاکتور کپی‌شده حذف یا جایگزین کنید.");
                return false;
            }
        }
        if (validLines.Any(l => l.Qty != decimal.Round(l.Qty, 2, MidpointRounding.AwayFromZero)
                                && (!l.OriginalQty.HasValue || l.Qty != l.OriginalQty.Value)))
        {
            ShowFormError("مقدار هر سطر حداکثر تا دو رقم اعشار قابل ثبت است.");
            return false;
        }
        if (validLines.Any(l => l.VatValue > 0 &&
                (l.Price != decimal.Round(l.Price, 2) || (!l.DiscountIsAmount && l.DiscountPercent != decimal.Round(l.DiscountPercent, 2)))))
        {
            ShowFormError("در سطر مشمول ارزش افزوده، قیمت و درصد تخفیف حداکثر دو رقم اعشار دارند.");
            return false;
        }
        if (validLines.Any(l => !OrderLineAmounts.IsValidVatValue(l.VatValue)))
        {
            ShowFormError("ارزش افزوده هر سطر باید عددی غیرمنفی با حداکثر دو رقم اعشار باشد.");
            return false;
        }
        return true;
    }

    private async Task SaveInternal(bool printAfterSave)
    {
        if (saving || (UseInvoiceWizard && invoiceStep != 2)) return;
        formError = null;
        if (!ValidateInvoice())
        {
            if (UseInvoiceWizard)
            {
                invoiceStep = 1;
                pendingSectionFocus = "[data-order-initial]";
            }
            return;
        }

        if (saleChequeCharge is not null && (!useCheque || (IsEdit && EditOrder?.HasChequeCharge != true) || chargeInvoiceBase != goodsTotal))
        {
            ShowFormError("برای ردیف تاخیر تادیه چک، چک را فعال کنید و پس از تغییر اقلام، سود را دوباره محاسبه کنید.");
            return;
        }
        if (saleChequeCharge is not null && CashPart > 0 && trsAccountId is not > 0)
        {
            ShowFormError("برای دریافت نقدی ترکیبی، حساب فعال صندوق یا بانک را انتخاب کنید.");
            return;
        }
        var validLines = lines.Where(l => l.ProductId > 0 && l.Qty > 0).ToList();
        var cmd = new OrderCommand
        {
            WarehouseId = warehouseId,
            PartyId = partyId,
            Type = Type,
            Date = date.Value,
            Description = description,
            ReferrerId = Type == TransactionType.Sale && referrerId > 0 ? referrerId : null,
            Lines = validLines.Select(l => new OrderLineInput
            {
                Id = l.Id,
                ProductId = l.ProductId,
                Quantity = l.Qty,
                Price = l.Price,
                DiscountPercent = l.DiscountPercent,
                DiscountAmount = l.DiscountAmount,
                DiscountIsAmount = l.DiscountIsAmount,
                VatValue = l.VatValue
            }).ToList()
        };

        // اطلاعات پرداخت (خرید و فروش)
        if (Type is TransactionType.Sale or TransactionType.Purchase)
        {
            // ---------- پرداخت ترکیبی: نقد + چک + اقساط + نسیه ----------
            if (HasNonCash && CashPart > 0 && CashPart >= grandTotal)
            {
                ShowFormError("مبلغ نقدی نمی‌تواند برابر یا بیشتر از مبلغ سند باشد؛ در این صورت فقط «نقدی» را فعال کنید.");
                return;
            }
            var cash = HasNonCash ? CashPart : grandTotal;

            cmd.PaymentMethod = DeclaredMethod;
            if (Type == TransactionType.Sale && cash > 0 && CashKind == CashType.CardTransfer && string.IsNullOrWhiteSpace(cashTrackingNumber))
            {
                ShowFormError("شماره پیگیری پرداخت کارت به کارت را وارد کنید.");
                return;
            }
            cmd.CashTrackingNumber = Type == TransactionType.Sale && cash > 0 && CashKind == CashType.CardTransfer ? cashTrackingNumber?.Trim() : null;
            cmd.CashType = CashKind;
            cmd.TrsAccountId = trsAccountId > 0 ? trsAccountId : null;
            cmd.CashAmount = HasNonCash ? cash : 0;

            // جزء چک
            var chequeList = new List<ChequeDto>();
            if (useCheque)
            {
                if (cheques.Count == 0) { ShowFormError("حداقل یک چک ثبت کنید."); return; }
                for (var i = 0; i < cheques.Count; i++)
                {
                    if (string.IsNullOrWhiteSpace(cheques[i].Number)) { ShowFormError($"شماره چک ردیف {i + 1} را وارد کنید."); return; }
                    if (!chequeDates[i].HasValue) { ShowFormError($"سررسید چک ردیف {i + 1} را وارد کنید."); return; }
                    cheques[i].Amount = Fa.ParseDecimal(chequeAmounts[i]);
                    cheques[i].DueDate = chequeDates[i]!.Value;
                    if (cheques[i].Amount <= 0) { ShowFormError($"مبلغ چک ردیف {i + 1} را وارد کنید."); return; }
                }
                chequeList = cheques;
            }

            // جزء اقساط
            var instList = new List<InstallmentDto>();
            if (useInstallment)
            {
                if (installments.Count == 0) { ShowFormError("ابتدا دفترچه اقساط را بسازید."); return; }
                for (var i = 0; i < installments.Count; i++)
                {
                    if (!instDates[i].HasValue) { ShowFormError($"سررسید قسط {i + 1} را وارد کنید."); return; }
                    installments[i].Amount = Fa.ParseDecimal(instAmounts[i]);
                    installments[i].DueDate = instDates[i]!.Value;
                    if (installments[i].Amount <= 0) { ShowFormError($"مبلغ قسط {i + 1} را وارد کنید."); return; }
                }
                instList = installments;
            }

            cmd.Cheques = chequeList;
            cmd.Installments = instList;

            // ماندهٔ نهایی = نسیه
            var paid = cash + chequeList.Sum(c => c.Amount) + instList.Sum(i => i.Amount);
            var remainder = grandTotal - paid;
            if (saleChequeCharge is not null && remainder < 0)
            {
                ShowFormError("جمع پرداخت‌ها بیش از مبلغ فاکتور است؛ لطفاً اجزای پرداخت را دستی اصلاح کنید.");
                return;
            }
            if (remainder > (saleChequeCharge is not null ? 0 : 1))
            {
                if (!useCredit || !creditDue.HasValue)
                {
                    ShowFormError($"جمع پرداخت‌ها ({paid.Money()}) کمتر از مبلغ سند ({grandTotal.Money()}) است؛ " +
                                "باقی‌ماندهٔ " + remainder.Money() + " ریال به نسیه می‌رود — جزء «نسیه» را فعال و تاریخ سررسید را وارد کنید.");
                    return;
                }
                cmd.DueDate = creditDue;
            }
            if (saleChequeCharge is not null)
            {
                saleChequeCharge.ConfirmedCreditDueDate = cmd.DueDate;
                cmd.ChequeCharge = saleChequeCharge;
            }
        }

        saving = true;
        try
        {
            Order saved;
            if (IsEdit && EditOrder!.HasChequeCharge)
            {
                saved = await OrderSvc.EditChequeOrderAsync(EditOrder.Id, cmd);
                InvoiceSuccess("فاکتور فروش با صدور سند اصلاحی جایگزین شد.");
            }
            else if (IsEdit)
            {
                saved = await OrderSvc.UpdateAsync(EditOrder!.Id, cmd);
                InvoiceSuccess(Type == TransactionType.Sale ? "فاکتور فروش ویرایش شد." : "فاکتور خرید ویرایش شد.");
            }
            else
            {
                saved = await OrderSvc.CreateAsync(cmd);
                InvoiceSuccess(Type == TransactionType.Sale ? "فاکتور فروش ثبت شد." : "فاکتور خرید ثبت شد.");
            }
            if (printAfterSave) await PrintOrderAsync(saved.Id);
            await OnSaved.InvokeAsync();
        }
        catch (Exception ex)
        {
            ShowFormError(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }
