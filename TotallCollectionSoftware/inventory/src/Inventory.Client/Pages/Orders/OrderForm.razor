    {
        public Guid Key { get; } = Guid.NewGuid();
        public int Id { get; set; }
        public int ProductId { get; set; }
        public decimal? OriginalQty { get; set; }
        public int? OriginalProductId { get; set; }
        public decimal? OriginalPrice { get; set; }
        public decimal? OriginalGross { get; set; }
        public decimal? OriginalDiscountAmount { get; set; }
        public decimal? OriginalDiscountPercent { get; set; }
        public bool? OriginalDiscountIsAmount { get; set; }
        public decimal? OriginalVatValue { get; set; }
        public decimal? OriginalVatAmount { get; set; }
        public string QtyText { get; set; } = "1";
        public string PriceText { get; set; } = "";
        public string NewSalePriceText { get; set; } = "";
        public string? PriceNotice { get; set; }
        public int PriceRequestVersion { get; set; }
        public string Unit { get; set; } = "";
        public string DiscountText { get; set; } = "";
        public decimal DiscountPercent { get; set; }
        public decimal DiscountAmount { get; set; }
        public bool DiscountIsAmount { get; set; }
        public decimal Qty => ShopQuantityInput.TryParse(QtyText, out var quantity) ? quantity : 0m;
        public decimal Price => PurchaseSalePriceInput.TryParseLegacy(PriceText, out var price) ? price : 0m;
        public bool SameOriginalBasis => Id > 0 && OriginalProductId == ProductId && OriginalQty == Qty && OriginalPrice == Price;
        public bool SameOriginalDiscount => SameOriginalBasis && OriginalDiscountIsAmount == DiscountIsAmount &&
            (DiscountIsAmount ? OriginalDiscountAmount == DiscountAmount : OriginalDiscountPercent == DiscountPercent && OriginalDiscountAmount == DiscountAmount);
        public decimal Gross => SameOriginalBasis && OriginalGross.HasValue ? OriginalGross.Value :
            ShopInvoiceAmounts.TryGross(Qty, Price, out var gross) ? gross : 0m;
        public string VatText { get; set; } = "";
        public decimal VatValue => Math.Max(0, Fa.ParseDecimal(VatText));
        public decimal AfterDiscount => Math.Max(0, Gross - DiscountAmount);
        public decimal VatAmount => SameOriginalDiscount && OriginalVatValue == VatValue && OriginalVatAmount.HasValue
            ? OriginalVatAmount.Value : OrderLineAmounts.Vat(AfterDiscount, VatValue);
        public decimal Total => AfterDiscount + VatAmount;
    }

