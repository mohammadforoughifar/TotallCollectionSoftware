    }

    private async Task OnProductPicked(LineVm l, int id)
    {
        if (l.ProductId == id) return; // Never reprice an already saved/selected row.
        l.OriginalQty = null;
        l.Id = 0;
        l.ProductId = id;
        var requestVersion = ++l.PriceRequestVersion;
        l.PriceText = "";
        l.NewSalePriceText = "";
        l.PriceNotice = null;
        var p = products.FirstOrDefault(x => x.Id == id);
        if (p is null) { l.VatText = "0"; RecalcDiscount(l); return; }
        l.Unit = p.Unit;
        l.VatText = FormatNum(ExactDecimal(p.InvoiceVatValue ?? 0));
        if (Type != TransactionType.Sale)
        {
            if (p.PurchasePrice > 0) l.PriceText = PurchaseSalePriceInput.Format(ExactDecimal(p.PurchasePrice));
            RecalcDiscount(l);
            return;
        }
        var invoiceDate = date?.Date;
        if (!invoiceDate.HasValue) { l.PriceNotice = "ابتدا تاریخ فاکتور را مشخص کنید."; return; }
        try
        {
            var suggested = await OrderSvc.GetDatedSalePriceAsync(id, invoiceDate.Value);
            // An async response must never overwrite a newer selection, date or manual entry.
            if (l.PriceRequestVersion != requestVersion || l.ProductId != id || date?.Date != invoiceDate || !string.IsNullOrWhiteSpace(l.PriceText)) return;
            if (suggested.Price.HasValue) l.PriceText = PurchaseSalePriceInput.Format(ExactDecimal(suggested.Price.Value));
            else l.PriceNotice = "قیمت این تاریخ ثبت نشده؛ دستی وارد کنید.";
            RecalcDiscount(l);
        }
        catch
        {
            if (l.PriceRequestVersion == requestVersion && l.ProductId == id && string.IsNullOrWhiteSpace(l.PriceText))
                l.PriceNotice = "دریافت قیمت تاریخی ناموفق بود؛ دستی وارد کنید.";
        }
    }

    private bool? QuantityAllowsFraction(LineVm line) => products.FirstOrDefault(p => p.Id == line.ProductId)?.AllowsFractionalQuantity;
    private string QuantityTitle(LineVm line) => QuantityAllowsFraction(line) switch
    {
        false => "این واحد فقط مقدار صحیح می‌پذیرد",
        true => "مقدار می‌تواند تا دو رقم اعشار داشته باشد",
        null => "نوع مقدار واحد در اطلاعات پایه باید تعیین شود"
    };

    private static bool TryQuantity(string text, out decimal value)
        => ShopQuantityInput.TryParse(text, out value);

    private static bool TryNewSalePrice(string text, out decimal value)
        => PurchaseSalePriceInput.TryParse(text, out value);

    // A copied legacy value must remain visible in full, even when it needs correction
    // to meet today's precision rules; formatting must not silently round it.
    private static string ExactDecimal(decimal value) =>
        value.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>قالب‌بندی مقدار کالا با حفظ ورودی نامعتبر برای اصلاح.</summary>
    private static string FormatQuantity(object? value) => ShopQuantityInput.Format(value?.ToString());

    /// <summary>قالب‌بندی زنده ورودی عددی با جداکننده سه‌رقمی (با حفظ اعشار و پشتیبانی از ارقام فارسی).</summary>
    private static string FormatNum(object? value)
    {
        var raw = Fa.ToEn(value?.ToString() ?? "").Replace(",", "");
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var parts = raw.Split('.', 2);
        var intPart = new string(parts[0].Where(char.IsDigit).ToArray());
        if (intPart.Length == 0) intPart = "0";

        var formatted = decimal.Parse(intPart).ToString("#,##0");
        if (parts.Length == 2)
        {
            var frac = new string(parts[1].Where(char.IsDigit).ToArray());
            return $"{formatted}.{frac}";
        }
        return formatted;
    }

    private bool TryRefreshCalculatedCheques()
    {
        if (calculatedChequeSchedule is not { } schedule || !useCheque ||
            chequeDates.Count != cheques.Count) return false;
        try
        {
            // Recalculate before touching any rows. A changed cash/installment amount,
            // manually edited cheque, or invalid rounded schedule requires review instead.
            var refreshed = schedule.Recalculate(goodsTotal, CashPart, InstSum(), cheques.Count,
                chequeAmounts.Select(Fa.ParseDecimal).ToArray());
            var nextAmounts = refreshed.Calculation.Amounts
                .Select(amount => Fa.FormatTyping(ExactDecimal(amount))).ToList();
            SaleChequeChargeInput? nextCharge = null;
            if (Type == TransactionType.Sale)
            {
                nextCharge = refreshed.Calculation.CreateSaleChequeCharge(goodsTotal,
                    refreshed.AdjustmentRatePercent, refreshed.AdjustmentPeriodDays);
                if (IsEdit && ((EditOrder?.HasChequeCharge == true && nextCharge is null) ||
                               (EditOrder?.HasChequeCharge != true && nextCharge is not null))) return false;
            }

            // Change only amounts and the pending calculation, never cheque metadata.
            chequeAmounts = nextAmounts;
            calculatedChequeSchedule = refreshed;
            if (Type == TransactionType.Sale)
            {
                var hadCharge = saleChequeCharge is not null;
                saleChequeCharge = nextCharge;
                saleChequeIncome = nextCharge is null ? 0m : refreshed.Calculation.Interest;
                chargeInvoiceBase = nextCharge is null ? 0m : goodsTotal;
                chargeCashBase = nextCharge is null ? 0m : CashPart;
                chargeInstallmentBase = nextCharge is null ? 0m : InstSum();
                removedCalculatedChequeIncome = nextCharge is null && (hadCharge || removedCalculatedChequeIncome);
            }
            return true;
        }
        catch (Exception ex) when (ex is ArgumentException or InvalidOperationException or OverflowException)
        {
            return false;
        }
    }

    private void GoToPayment()
    {
        formError = null;
        if (!saving && ValidateInvoice())
        {
            var hasKnownHistory = IsEdit && EditOrder is { } order &&
                (KnownLaterChequeActivity || order.IsCancelled || order.ChequeReturns.Count > 0 ||
                 order.Cheques.Any(c => c.IsCleared || c.Status != ChequeStatus.InHand) ||
                 order.Installments.Any(i => i.IsPaid));
            if (paymentStepGoodsTotal.HasValue && paymentStepGoodsTotal.Value != goodsTotal && !hasKnownHistory)
            {
                var wasCalculated = calculatedChequeSchedule is not null && useCheque;
                var refreshed = TryRefreshCalculatedCheques();
                if (!refreshed)
                {
                    // Manual, unknown or inconsistent rows require explicit amounts.
                    for (var i = 0; i < chequeAmounts.Count; i++) chequeAmounts[i] = "";
                    calculatedChequeSchedule = null;
                    if (wasCalculated) InvoiceInfo("تقسیم خودکار ممکن نیست؛ مبلغ چک‌ها را بررسی یا دوباره محاسبه کنید.");
                }
                else InvoiceInfo("مبلغ چک‌ها و سود با تنظیمات قبلی دوباره محاسبه شد.");

                // The previous review rule for non-cheque installments remains unchanged.
                // Their amounts are not redistributed or absorbed into the cheque calculation.
                for (var i = 0; i < instAmounts.Count; i++) instAmounts[i] = "";
                paymentAmountsNeedReview = chequeAmounts.Count > 0 || instAmounts.Count > 0;
            }
            paymentStepGoodsTotal = goodsTotal;
            invoiceStep = 2;
            pendingSectionFocus = "[data-order-payment]";
        }
    }

    private void BackToInvoice()
    {
        if (!saving)
        {
            paymentStepGoodsTotal = goodsTotal;
            invoiceStep = 1;
            pendingSectionFocus = "[data-order-initial]";
        }
    }

