@inject IOrderService OrderSvc
@inject IWarehouseService WarehouseSvc
@inject IPartyService PartySvc
@inject IProductService ProductSvc
@inject IReferrerService ReferrerSvc
@inject ITrsAccountService AccountSvc
@inject IToastService Toast
@inject ICompanyProfileService ProfileSvc
@inject IJSRuntime JS
@using Inventory.Client.Pages.Orders

<Modal Visible="true" Title="@FormTitle" Size="@(UseInvoiceWizard ? "modal-xl invoice-dialog" : "modal-xl")" HeaderClass="@(UseInvoiceWizard ? "purchase-order-header" : "")" OnClose="Cancel">

    <ChildContent>
        @if (!string.IsNullOrEmpty(formError))
        {
            <div class="order-form-error" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@formError</span><button type="button" aria-label="بستن پیام خطا" @onclick="() => formError = null">×</button></div>
        }
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else
        {
            @if (KnownLaterChequeActivity)
            {
                <div class="alert alert-warning py-2 fs-8" role="status">این فاکتور دارای گردش بعدی است و ویرایش مستقیم آن مجاز نیست؛ برای اصلاح از برگشت کالا، تغییر سررسید یا تعویض چک استفاده کنید.</div>
            }
            @if (IsEdit && !EditOrder!.ShopCashLedgerEnabled && !EditOrder.HasChequeCharge)
            {
                <div class="alert alert-warning py-2 d-flex align-items-center justify-content-between gap-2" role="status">
                    <span>گردش نقدی این فاکتور قدیمی هنوز تطبیق نشده است. پیش از تغییر پرداخت، سابقه صندوق/بانک را بررسی کنید.</span>
                    <button type="button" class="btn btn-sm btn-outline-dark flex-shrink-0" @onclick="OpenLegacyCashReconciliation">تطبیق نقد</button>
                </div>
            }
            @if (UseInvoiceWizard)
            {
                <nav class="purchase-steps" data-order-wizard="@formKey" aria-label="@(Type == TransactionType.Sale ? "مراحل ثبت فروش" : "مراحل ثبت خرید")">
                    <div class="purchase-step @(invoiceStep == 1 ? "active" : "complete")" aria-current="@(invoiceStep == 1 ? "step" : null)">
                        <span class="purchase-step-number">@if (invoiceStep == 1) { <span>۱</span> } else { <i class="bi bi-check-lg"></i> }</span>
                        <span><strong>@(Type == TransactionType.Sale ? "اطلاعات فروش" : "اطلاعات خرید")</strong></span>
                    </div>
                    <span class="purchase-step-line" aria-hidden="true"></span>
                    <div class="purchase-step @(invoiceStep == 2 ? "active" : "")" aria-current="@(invoiceStep == 2 ? "step" : null)">
                        <span class="purchase-step-number">۲</span>
                        <span><strong>پرداخت و تأیید</strong></span>
                    </div>
                </nav>
                @if (CopyTemplate is not null && invoiceStep == 1)
                {
                    <div class="invoice-copy-notice" role="status">
                        <i class="bi bi-copy" aria-hidden="true"></i>
                        <span>این فاکتور جدید است؛ اقلام را بازبینی کنید. اطلاعات پرداخت و گردش فاکتور قبلی کپی نشده است.
                            @if (CopyTemplate.Lines.Any(l => l.DiscountIsAmount && l.DiscountAmount != Math.Round(l.DiscountAmount, 0)))
                            {
                                <br /><strong>تخفیف ریالی اعشاری طبق قواعد ثبت جدید به ریال کامل گرد شده است؛ مبلغ را بررسی کنید.</strong>
                            }
                        </span>
                    </div>
                }
                <div class="purchase-section-heading">
                    <h3>@(invoiceStep == 1 ? "اطلاعات فاکتور" : "پرداخت و تأیید نهایی")</h3>
                    <span>مرحله @invoiceStep.Num() از ۲</span>
                </div>
            }
            <div class="row g-3 mb-3">
                @if (!UseInvoiceWizard || invoiceStep == 1)
                {
                <div class="col-md-4" data-order-initial>
                    <label class="form-label">انبار <span class="text-danger">*</span></label>
                    <SearchSelect Items="whLookup" ShowAllOnFocus="UseInvoiceWizard" ConstrainToModal="UseInvoiceWizard" AdvanceOnEnter="UseInvoiceWizard" Value="warehouseId" ValueChanged="OnWarehouseChanged" Placeholder="انتخاب انبار…" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">@(Type == TransactionType.Sale ? "مشتری" : "تأمین‌کننده") <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold" title="افزودن طرف حساب" @onclick="OpenQuickParty">
                            <i class="bi bi-plus-circle-fill text-success"></i> @(Type == TransactionType.Sale ? "مشتری جدید" : "تأمین‌کننده جدید")
                        </button>
                    </div>
                    <SearchSelect Items="partyLookup" ShowAllOnFocus="UseInvoiceWizard" ConstrainToModal="UseInvoiceWizard" AdvanceOnEnter="UseInvoiceWizard" Value="partyId" ValueChanged="OnPartyChanged" Placeholder="انتخاب طرف حساب — نام، موبایل یا تلفن…" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">تاریخ سند <span class="text-danger">*</span></label>
                    <DatePicker @bind-Value="date" OpenOnFocus="UseInvoiceWizard" />
                </div>
                <div class="col-12">
                    <label class="form-label">توضیحات</label>
                    <input class="form-control" @bind="description" placeholder="اختیاری" />
                </div>
                @if (Type == TransactionType.Sale && referrerId > 0)
                {
                    <div class="col-12">
                        <div class="alert alert-info fs-8 py-2 mb-0">
                            <i class="bi bi-person-badge ms-1"></i>
                            معرف این مشتری: <b>@(referrers.FirstOrDefault(r => r.Id == referrerId)?.Name ?? customers.FirstOrDefault(c => c.Id == partyId)?.ReferrerName ?? "نامشخص")</b>
                        </div>
                    </div>
                }

                }

                @if (UseInvoiceWizard && invoiceStep == 2)
                {
                    <div class="col-12 purchase-payment" data-order-payment>
                        @if (UseInvoiceWizard)
                        {
                            <section class="purchase-summary" aria-label="خلاصه فاکتور و پرداخت">
                                <div class="purchase-summary-head"><strong><i class="bi bi-receipt"></i> خلاصه فاکتور</strong><span>مبالغ به ریال</span></div>
                                <div class="purchase-summary-main">
                                    <div><span>@(Type == TransactionType.Sale ? "مشتری" : "تأمین‌کننده")</span><strong>@(partyLookup.FirstOrDefault(p => p.Id == partyId)?.Name ?? "—")</strong></div>
                                    <div><span>انبار</span><strong>@(whLookup.FirstOrDefault(w => w.Id == warehouseId)?.Name ?? "—")</strong></div>
                                    <div><span>اقلام</span><strong>@(lines.Count(l => l.ProductId > 0 && l.Qty > 0).Num()) سطر</strong></div>
                                    <div class="purchase-summary-total">
                                        <span>مبلغ نهایی فاکتور</span><strong class="num">@(ExactPaymentDisplay ? ExactMoney(grandTotal) : grandTotal.Money())</strong>
                                        @if (HasChequeIncomeArticle)
                                        {
                                            <small class="purchase-summary-breakdown">کالا با ارزش افزوده <b class="num">@ExactMoney(goodsTotal)</b> + تاخیر تادیه چک <b class="num">@ExactMoney(saleChequeIncome)</b></small>
                                        }
                                    </div>
                                </div>
                                <div class="purchase-summary-pay" aria-live="polite">
                                    <div><span>نقد</span><strong class="num">@(ExactPaymentDisplay ? ExactMoney(CashPart) : CashPart.Money())</strong></div>
                                    <div><span>چک</span><strong class="num">@(ExactPaymentDisplay ? ExactMoney(ChequeSum()) : ChequeSum().Money())</strong></div>
                                    <div><span>@(Type == TransactionType.Purchase ? "اعلامیه پرداخت" : "اقساط")</span><strong class="num">@(ExactPaymentDisplay ? ExactMoney(InstSum()) : InstSum().Money())</strong></div>
                                    <div class="purchase-summary-remaining @(Math.Abs(FinalRemaining) > (StrictPaymentBalance ? 0 : 1) ? "is-warning" : "")">
                                        <span>@(FinalRemaining < 0 ? "مازاد پرداخت" : useCredit && FinalRemaining > (StrictPaymentBalance ? 0 : 1) ? "مانده نسیه" : "باقی‌مانده")</span>
                                        <strong class="num">@(ExactPaymentDisplay ? ExactMoney(Math.Abs(FinalRemaining)) : Math.Abs(FinalRemaining).Money())</strong>
                                    </div>
                                </div>
                                @if (FinalRemaining != 0)
                                {
                                    <p class="purchase-summary-status" aria-live="polite">
                                        @if (FinalRemaining > (StrictPaymentBalance ? 0 : 1))
                                        {
                                            @(useCredit ? "مانده فاکتور به نسیه می‌رود؛ تاریخ سررسید را بررسی کنید." : "برای مانده فاکتور، پرداخت دیگری اضافه کنید یا نسیه و سررسید آن را مشخص کنید.")
                                        }
                                        else if (FinalRemaining < (StrictPaymentBalance ? 0 : -1))
                                        {
                                            <span>@(StrictPaymentBalance ? "جمع پرداخت‌ها بیشتر از مبلغ فاکتور است؛ آن را دستی اصلاح کنید." : "جمع پرداخت‌ها بیشتر از مبلغ فاکتور است (مازاد / سود مدت‌دار).")</span>
                                        }
                                        else
                                        {
                                            <span>اختلاف در محدوده تلورانس ثبت است؛ برای برابری دقیق، مبلغ پرداخت‌ها را دستی اصلاح کنید.</span>
                                        }
                                    </p>
                                }
                            </section>
                        }
                        @if (paymentAmountsNeedReview && ((useCheque && chequeAmounts.Any(string.IsNullOrWhiteSpace)) || (useInstallment && instAmounts.Any(string.IsNullOrWhiteSpace))))
                        {
                            <div class="alert alert-warning py-2 fs-8" role="status" data-payment-amounts-review>
                                مبلغ اقلام تغییر کرده است؛ مبلغ ردیف‌های خالی را دوباره وارد کنید. شماره، بانک و تاریخ چک‌ها حفظ شده‌اند.
                            </div>
                        }
                        <div class="pay-box">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="fw-700"><i class="bi bi-credit-card-2-front text-primary ms-1"></i>روش پرداخت (ترکیبی)</span>
                            </div>
                            <div class="pay-tabs" aria-label="روش‌های پرداخت">
                                <button type="button" class="pay-tab @(useCash ? "active" : "")" data-pay-comp="cash" aria-pressed="@(useCash ? "true" : "false")" @onclick="ToggleCash">
                                    <i class="bi bi-cash-coin"></i> نقدی
                                </button>
                                <button type="button" class="pay-tab @(useCheque ? "active" : "")" data-pay-comp="cheque" aria-pressed="@(useCheque ? "true" : "false")" @onclick="ToggleCheque">
                                    <i class="bi bi-bank"></i> چک
                                </button>
                                <button type="button" class="pay-tab @(useInstallment ? "active" : "")" data-pay-comp="installment" aria-pressed="@(useInstallment ? "true" : "false")" @onclick="ToggleInstallment">
                                    <i class="bi bi-journal-check"></i> @(Type == TransactionType.Purchase ? "اعلامیه پرداخت" : "اقساطی")
                                </button>
                                <button type="button" class="pay-tab @(useCredit ? "active" : "")" data-pay-comp="credit" aria-pressed="@(useCredit ? "true" : "false")" @onclick="ToggleCredit">
                                    <i class="bi bi-hourglass-split"></i> نسیه
                                </button>
                            </div>

                            @* ---------- جزء نقدی ---------- *@
                            @if (useCash)
                            {
                                <div class="mt-3" data-pay-cash-box>
                                    <div class="row g-2 align-items-end">
                                        @if (HasNonCash)
                                        {
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8"><i class="bi bi-cash-coin text-success"></i> @(Type == TransactionType.Sale ? "دریافت نقدی" : "پرداخت نقدی") (بخشی از مبلغ)</label>
                                                <input class="form-control form-control-sm num" value="@cashAmountText"
                                                       @oninput="OnCashAmountInput" inputmode="numeric" dir="ltr" placeholder="0" data-pay-cash-input />
                                            </div>
                                        }
                                        <div class="col-6 col-md-3">
                                            <label class="form-label fs-8">نوع @(Type == TransactionType.Sale ? "دریافت" : "پرداخت") نقدی</label>
                                            <SearchSelect Items="CashTypeLookup" Value="@((int)CashKind + 1)" ValueChanged="OnCashTypePicked"
                                                          ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" AllowClear="false" />
                                        </div>
                                        <div class="col-6 col-md-4">
                                            <label class="form-label fs-8">بانک/صندوق</label>
                                            <div class="input-group input-group-sm order-bank-select">
                                                <SearchSelect Items="@CashAccountLookup" Value="@(trsAccountId ?? 0)" ValueChanged="OnCashAccountPicked"
                                                              Placeholder="انتخاب بانک…" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" />
                                                <button type="button" class="btn btn-outline-primary" title="تعریف صندوق/بانک جدید"
                                                        @onclick="() => OpenQuickBank(CashKind == CashType.Cash ? TreasuryAccountKind.Cash : TreasuryAccountKind.Bank)">
                                                    <i class="bi bi-plus-lg ms-1"></i> @(CashKind == CashType.Cash ? "تعریف صندوق" : "تعریف بانک")
                                                </button>
                                            </div>
                                        </div>
                                        @if (Type == TransactionType.Sale && CashKind == CashType.CardTransfer)
                                        {
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8" for="cash-tracking-@formKey">شماره پیگیری پرداخت <span class="text-danger">*</span></label>
                                                <input id="cash-tracking-@formKey" class="form-control form-control-sm" @bind="cashTrackingNumber" maxlength="100" dir="ltr" autocomplete="off" />
                                            </div>
                                        }
                                        <div class="col-12 col-md-2 fs-8 pb-1">
                                            @if (HasNonCash)
                                            {
                                                <span>باقی‌مانده پس از نقد: <b class="num text-primary" data-pay-remain-cash>@ExactMoney(RemainingAfterCash)</b></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">تمام مبلغ نقدی است.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ---------- جزء چک ---------- *@
                            @if (useCheque)
                            {
                                <div class="mt-3" data-pay-cheque-box>
                                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                        <span class="fs-8 fw-700">@(Type == TransactionType.Purchase ? "چک‌های پرداختی به تأمین‌کننده" : "چک‌های دریافتی از مشتری")</span>
                                        @if (Type == TransactionType.Sale)
                                        {
                                            <button type="button" class="btn btn-sm btn-outline-primary" data-cheque-interest-only title="محاسبه تاخیر تادیه برای چک‌های دستی، بدون تغییر مبلغ آن‌ها" @onclick="() => OpenCalc(true, interestOnly: true)">
                                                <i class="bi bi-percent"></i> محاسبه سود چک‌های دستی
                                            </button>
                                        }
                                        <button type="button" class="btn btn-sm btn-calc ms-auto" title="محاسبه اقساط چک" @onclick="() => OpenCalc(true)">
                                            <i class="bi bi-calculator"></i> محاسبه اقساطِ چک
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-pay-add-cheque data-hotkey="f2" title="کلید میانبر: F2" @onclick="AddCheque">
                                            <i class="bi bi-plus-lg"></i> افزودن چک (F2)
                                        </button>
                                    </div>
                                    @for (var ci = 0; ci < cheques.Count; ci++)
                                    {
                                        var i = ci;
                                        <div class="cheque-row row g-2 align-items-end" data-cheque-row="@i">
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">شماره چک/صیاد *</label>
                                                <input class="form-control form-control-sm" @bind="cheques[i].Number" dir="ltr" />
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8">بانک @(Type == TransactionType.Purchase ? "(حساب ما) *" : "")</label>
                                                <div class="input-group input-group-sm order-bank-select">
                                                    @if (Type == TransactionType.Purchase)
                                                    {
                                                        <SearchSelect Items="@ChequeAccountLookup" Value="@(cheques[i].TrsAccountId ?? 0)" ValueChanged="@(id => OnChequeAccountPicked(i, id))"
                                                                      Placeholder="انتخاب حساب بانکی…" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" />
                                                    }
                                                    else
                                                    {
                                                        <SearchSelectStr Items="@ChequeBankNames" Value="@(cheques[i].BankName ?? "")" ValueChanged="@(name => cheques[i].BankName = name)"
                                                                         Placeholder="نام بانک…" AllowCustomValue="true" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" />
                                                    }
                                                    <button type="button" class="btn btn-outline-primary" title="افزودن بانک" aria-label="افزودن بانک"
                                                            @onclick="() => OpenChequeBank(i)">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">@(Type == TransactionType.Purchase ? "در وجه / گیرنده" : "صاحب چک")</label>
                                                <input class="form-control form-control-sm" @bind="cheques[i].OwnerName" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">مبلغ (ریال) *</label>
                                                <input class="form-control form-control-sm num" value="@chequeAmounts[i]"
                                                       @oninput="@(e => OnChequeAmountInput(i, e))" inputmode="numeric" dir="ltr" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">سررسید چک *</label>
                                                <DatePicker @bind-Value="chequeDates[i]" OpenOnFocus="UseInvoiceWizard" />
                                            </div>
                                            <div class="col-6 col-md-1 text-center">
                                                <button type="button" class="btn btn-sm btn-light" tabindex="-1" title="حذف چک" aria-label="حذف چک" data-pay-remove-cheque="@i" @onclick="() => RemoveCheque(i)"><i class="bi bi-x-lg text-danger"></i></button>
                                            </div>
                                            <div class="col-12 fs-9">
                                                <span class="text-muted">باقی‌مانده پس از این چک:</span>
                                                <b class="num text-primary" data-rem-cheque="@i">@(ExactPaymentDisplay ? ExactMoney(RemainingAfterCheque(i)) : RemainingAfterCheque(i).Money())</b> ریال
                                            </div>
                                        </div>
                                    }
                                    @if (cheques.Count == 0)
                                    {
                                        <div class="fs-8 text-muted">هنوز چکی اضافه نشده است.</div>
                                    }
                                    @if (Type == TransactionType.Sale && HasChequeIncomeArticle)
                                    {
                                        <div class="alert alert-light border py-2 px-3 fs-8 mt-2 mb-0" data-sale-cheque-income-article>
                                            <div class="d-flex flex-wrap align-items-center gap-3">
                                                <strong>تاخیر تادیه چک</strong>
                                                <span>بدهکار مشتری: <b class="num">@saleChequeIncome.Money()</b> ریال</span>
                                                <span>بستانکار فروشگاه: <b class="num">@saleChequeIncome.Money()</b> ریال</span>
                                                @if (!IsEdit)
                                                {
                                                    <button type="button" class="btn btn-sm btn-outline-danger ms-auto" @onclick="RemoveSaleChequeCharge">حذف ردیف سود</button>
                                                }
                                            </div>
                                            @if (saleChequeCharge is not null && chargeInvoiceBase != goodsTotal)
                                            {
                                                <div class="text-danger fw-bold mt-1" role="status">مبلغ کالا تغییر کرده است؛ پیش از ثبت، تاخیر تادیه چک را دوباره محاسبه کنید.</div>
                                            }
                                            <div class="text-muted mt-1">
                                                @if (saleChequeCharge is not null)
                                                {
                                                    <span>مبنای اولیه: <b class="num">@ExactMoney(saleChequeCharge.CalculatorBaseAmount)</b> ریال،
                                                        نرخ ماهانه <b class="num">@ExactPercent(saleChequeCharge.CalculatorRatePercent)</b>٪ برای <b class="num">@saleChequeCharge.CalculatorMonths.Num()</b> ماه. </span>
                                                }
                                                else
                                                {
                                                    <span>جزئیات مبنا و نرخ اولیه در سابقه این فاکتور موجود نیست. </span>
                                                }
                                                این ردیف جدا از کالا و بدون ارزش افزوده است و @(IsEdit ? "در گردش فاکتور ثبت شده است" : "با ثبت فاکتور در گردش مشتری و درآمد فروشگاه ثبت می‌شود").
                                            </div>
                                        </div>
                                    }
                                </div>
                            }

                            @* ---------- جزء اقساط ---------- *@
                            @if (useInstallment)
                            {
                                <div class="mt-3" data-pay-inst-box>
                                    <div class="row g-2 align-items-end mb-2">
                                        <div class="col-6 col-md-2">
                                            <label class="form-label fs-8">تعداد قسط</label>
                                            <input class="form-control form-control-sm num" @bind="instCount" type="number" min="1" max="60" dir="ltr" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label fs-8">تاریخ اولین قسط</label>
                                            <DatePicker @bind-Value="instFirstDue" OpenOnFocus="UseInvoiceWizard" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label fs-8">فاصله (روز)</label>
                                            <input class="form-control form-control-sm num" @bind="instIntervalDays" type="number" min="1" dir="ltr" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <button type="button" class="btn btn-sm btn-primary w-100" data-pay-build-inst @onclick="() => BuildInstallments()">
                                                <i class="bi bi-journal-plus"></i> ساخت دفترچه
                                            </button>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <button type="button" class="btn btn-sm btn-calc w-100" title="محاسبه با سود" @onclick="() => OpenCalc(false)">
                                                <i class="bi bi-calculator"></i> محاسبه با سود
                                            </button>
                                        </div>
                                    </div>
                                    <div class="fs-8 text-muted mb-2">رند اقساط: ۱۰٬۰۰۰ ریال؛ جمع دقیق حفظ می‌شود.</div>
                                    @if (installments.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-1">
                                                <thead>
                                                    <tr>
                                                        <th>قسط</th><th>سررسید</th><th class="text-start">مبلغ (ریال)</th>
                                                        <th class="text-start">باقی‌مانده پس از این قسط</th><th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (var xi = 0; xi < installments.Count; xi++)
                                                    {
                                                        var i = xi;
                                                        <tr data-inst-row="@i">
                                                            <td class="num">قسط @((i + 1).Num())</td>
                                                            <td style="max-width:170px"><DatePicker @bind-Value="instDates[i]" OpenOnFocus="UseInvoiceWizard" /></td>
                                                            <td class="text-start">
                                                                <input class="form-control form-control-sm num" value="@instAmounts[i]"
                                                                       @oninput="@(e => OnInstAmountInput(i, e))" inputmode="numeric" dir="ltr" />
                                                            </td>
                                                            <td class="text-start"><b class="num text-primary" data-rem-inst="@i">@(ExactPaymentDisplay ? ExactMoney(RemainingAfterInstallment(i)) : RemainingAfterInstallment(i).Money())</b></td>
                                                            <td><button type="button" class="btn btn-sm btn-light" tabindex="-1" title="حذف قسط" aria-label="حذف قسط" data-pay-remove-inst="@i" @onclick="() => RemoveInstallment(i)"><i class="bi bi-x-lg text-danger"></i></button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="fs-8">
                                            جمع اقساط: <b class="num">@ExactMoney(InstSum())</b> —
                                            باقی‌ماندهٔ تجمعی: <b class="num text-primary" data-pay-remain-inst>@(ExactPaymentDisplay ? ExactMoney(FinalRemaining) : FinalRemaining.Money())</b>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fs-8 text-muted">هنوز قسطی ساخته نشده است.</div>
                                    }
                                </div>
                            }

                            @* ---------- جزء نسیه (باقی‌ماندهٔ نهایی) ---------- *@
                            @if (useCredit)
                            {
                                <div class="mt-3 row g-2 align-items-end" data-pay-credit-box>
                                    <div class="col-6 col-md-4">
                                        <label class="form-label fs-8">تاریخ سررسید نسیه <span class="text-danger">*</span></label>
                                        <DatePicker @bind-Value="creditDue" OpenOnFocus="UseInvoiceWizard" />
                                    </div>
                                    <div class="col-12 col-md-8 fs-8 pb-1">
                                        مبلغ نسیه (باقی‌ماندهٔ نهایی): <b class="num text-danger" data-pay-credit-amount>@(ExactPaymentDisplay ? ExactMoney(Math.Max(0, FinalRemaining)) : Math.Max(0, FinalRemaining).Money())</b> ریال
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>

            @if (!UseInvoiceWizard || invoiceStep == 1)
            {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-700 fs-7"><i class="bi bi-list-ul text-primary ms-1"></i>اقلام فاکتور</span>
                <button class="btn btn-sm btn-outline-primary" data-order-add-line data-hotkey="f2" title="کلید میانبر: F2" @onclick="AddLine">
                    <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                </button>
            </div>
            @if (Type == TransactionType.Sale)
            {
                <div class="invoice-price-hint"><i class="bi bi-clock-history"></i> تغییر تاریخ، قیمت سطرهای موجود را خودکار عوض نمی‌کند.</div>
            }
            <div data-order-entry class="@(UseInvoiceWizard ? (Type == TransactionType.Sale ? "purchase-items sale-items" : "purchase-items") : "")">
                <table class="table table-hover align-middle mb-0">
                    @if (UseInvoiceWizard)
                    {
                        <colgroup>
                            <col style="width:@InvoiceColumnWidth(22, 20)" />
                            <col style="width:@InvoiceColumnWidth(8)" />
                            <col style="width:@InvoiceColumnWidth(12, 11)" />
                            @if (Type == TransactionType.Purchase && canManagePricing) { <col style="width:@InvoiceColumnWidth(11)" /> }
                            <col style="width:@InvoiceColumnWidth(11, 10)" />
                            <col style="width:@InvoiceColumnWidth(9, 11)" />
                            <col style="width:@InvoiceColumnWidth(11, 10)" />
                            <col style="width:@InvoiceColumnWidth(9, 11)" />
                            <col style="width:@InvoiceColumnWidth(13, 14)" />
                            @if (Type == TransactionType.Sale && CanSeeProfit) { <col style="width:@InvoiceColumnWidth(SaleExtraColumnWeight)" /> }
                            @if (Type == TransactionType.Sale && CanSeeProfit && referrerId > 0) { <col style="width:@InvoiceColumnWidth(SaleExtraColumnWeight)" /> }
                            <col style="width:@InvoiceActionsColumnWidth" />
                        </colgroup>
                    }
                    <thead>
                        <tr>
                            <th><span>کالا</span></th>
                            <th title="مقدار تا دو رقم اعشار"><span>مقدار</span><small>تا ۲ رقم</small></th>
                            <th><span>قیمت واحد</span><small>ریال</small></th>
                            @if (Type == TransactionType.Purchase && canManagePricing)
                            {
                                <th title="قیمت اختیاری از تاریخ خرید اعمال می‌شود؛ خالی یعنی بدون تغییر"><span>قیمت فروش جدید</span><small>اختیاری · ریال</small></th>
                            }
                            <th><span>مبلغ کل</span><small>ریال</small></th>
                            <th title="تا ۱۰۰ درصد، بالاتر مبلغ ریالی"><span>تخفیف</span><small>٪ یا ریال</small></th>
                            <th><span>پس از تخفیف</span><small>ریال</small></th>
                            <th title="تا ۱۰۰ درصد، بالاتر مبلغ ریالی"><span>ارزش افزوده</span><small>٪ یا ریال</small></th>
                            <th><span>کل پس از ارزش افزوده</span><small>ریال</small></th>
                            @if (Type == TransactionType.Sale)
                            {
                                @if (CanSeeProfit)
                                {
                                    <th><span>سود</span><small>ریال</small></th>
                                }
                                @if (CanSeeProfit && referrerId > 0)
                                {
                                    <th><span>پورسانت</span><small>ریال</small></th>
                                }
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lines)
                        {
                            <tr @key="l.Key" data-order-line="@l.Key">
                                <td data-label="کالا">
                                    <SearchSelect Items="productLookup"
                                                  CssClass="order-line-control"
                                                  ShowAllOnFocus="UseInvoiceWizard"
                                                  ConstrainToModal="UseInvoiceWizard"
                                                  AdvanceOnEnter="UseInvoiceWizard"
                                                  Value="l.ProductId"
                                                  ValueChanged="id => OnProductPicked(l, id)"
                                                  Placeholder="جستجوی کالا…">
                                        <ItemDetails Context="option">
                                            @if (option is InvoiceProductOption productOption && productOption.StockQuantity.HasValue)
                                            {
                                                var quantity = productOption.StockQuantity.Value;
                                                <small class="ss-item-info invoice-stock-info">
                                                    موجودی این انبار:
                                                    <span class="invoice-stock-quantity @(productOption.IsStockWarning ? "is-warning" : "")">
                                                        @if (productOption.IsStockWarning)
                                                        {
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                            <span class="visually-hidden">هشدار موجودی صفر یا منفی: </span>
                                                        }
                                                        <bdi dir="ltr">@InvoiceProductOption.FormatStock(quantity)</bdi>
                                                    </span>
                                                    @productOption.StockUnit
                                                    @if (Type == TransactionType.Sale && productOption.IsStockWarning)
                                                    {
                                                        <strong class="invoice-stock-alert"><i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i> ناموجود</strong>
                                                    }
                                                </small>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(option.InfoText))
                                            {
                                                <small class="ss-item-info">@option.InfoText</small>
                                            }
                                        </ItemDetails>
                                    </SearchSelect>
                                    @if (!string.IsNullOrEmpty(l.Unit) || l.ProductId > 0)
                                    {
                                        <div class="fs-8 text-muted mt-1 d-flex gap-2 flex-wrap">
                                            @if (!string.IsNullOrEmpty(l.Unit))
                                            {
                                                <span>واحد: @l.Unit</span>
                                            }
                                            @if (l.ProductId > 0 && warehouseId > 0 && !IsServiceProduct(l.ProductId))
                                            {
                                                @if (warehouseStock.IsLoaded)
                                                {
                                                    var avail = warehouseStock.Quantities.TryGetValue(l.ProductId, out var q) ? q : 0m;
                                                    <span class="@(Type == TransactionType.Sale && avail <= 0 ? "invoice-stock-inline-warning" : avail <= 0 ? "text-danger" : "text-success")" role="status">
                                                        @if (Type == TransactionType.Sale && avail <= 0)
                                                        {
                                                            <i class="bi bi-exclamation-octagon-fill" aria-hidden="true"></i> <strong>ناموجود</strong> <text>—</text>
                                                        }
                                                        موجودی انبار: <b class="num"><bdi dir="ltr">@InvoiceProductOption.FormatStock(avail)</bdi></b>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>· موجودی انبار: @(warehouseStock.IsLoading ? "در حال دریافت…" : "نامشخص")</span>
                                                }
                                            }
                                        </div>
                                    }
                                </td>
                                <td data-label="مقدار">
                                    <input class="form-control text-center num order-line-control" aria-label="مقدار" inputmode="@(QuantityAllowsFraction(l) == false ? "numeric" : "decimal")" dir="ltr" placeholder="1"
                                           title="@QuantityTitle(l)"
                                           value="@l.QtyText" @oninput="@(e => { l.QtyText = FormatQuantity(e.Value); RecalcDiscount(l); })" />
                                </td>
                                <td data-label="قیمت واحد (ریال)">
                                    <input class="form-control num order-line-control" aria-label="قیمت واحد به ریال" inputmode="numeric" dir="ltr" title="قیمت به ریال صحیح و بدون اعشار"
                                           value="@l.PriceText" @oninput="@(e => { l.PriceRequestVersion++; l.PriceText = PurchaseSalePriceInput.Format(e.Value?.ToString()); l.PriceNotice = null; RecalcDiscount(l); })" />
                                    @if (!string.IsNullOrEmpty(l.PriceNotice)) { <small class="dated-price-note">@l.PriceNotice</small> }
                                </td>
                                @if (Type == TransactionType.Purchase && canManagePricing)
                                {
                                    <td data-label="قیمت فروش جدید (اختیاری، ریال)">
                                        <input class="form-control num order-line-control" aria-label="قیمت فروش جدید، اختیاری" inputmode="numeric" dir="ltr"
                                               title="قیمت اختیاری از تاریخ خرید اعمال می‌شود؛ خالی یعنی بدون تغییر" placeholder="بدون تغییر"
                                               value="@l.NewSalePriceText" @oninput="@(e => l.NewSalePriceText = PurchaseSalePriceInput.Format(e.Value?.ToString()))" />
                                    </td>
                                }
                                <td data-label="مبلغ کل (ریال)" class="num fw-500"><span class="order-line-value">@l.Gross.MoneyExact()</span></td>
                                <td data-label="تخفیف (٪ یا ریال)">
                                    <div class="input-group input-group-sm order-line-rate">
                                        <input class="form-control form-control-sm text-center num order-line-control" aria-label="تخفیف درصد یا ریال"
                                               value="@l.DiscountText"
                                               @oninput="e => OnLineDiscountInput(l, e.Value?.ToString())"
                                               @onblur="() => OnLineDiscountBlur(l)"
                                               placeholder="0" inputmode="numeric" dir="ltr" />
                                        <span class="input-group-text order-line-unit @(l.DiscountIsAmount ? "text-primary" : "")"
                                              title="@(l.DiscountIsAmount ? "مبلغ ریالی" : "درصد")">
                                            @(l.DiscountIsAmount ? "ریال" : "٪")
                                        </span>
                                    </div>
                                    <div class="fs-9 mt-1 text-danger num order-line-sub">
                                        @l.DiscountAmount.Money() ریال
                                    </div>
                                </td>
                                <td data-label="پس از تخفیف (ریال)" class="num fw-500"><span class="order-line-value">@l.AfterDiscount.MoneyExact()</span></td>
                                <td data-label="ارزش افزوده (٪ یا ریال)">
                                    <div class="input-group input-group-sm order-line-rate">
                                        <input class="form-control form-control-sm text-center num order-line-control" aria-label="ارزش افزوده درصد یا ریال" data-order-last-field
                                               value="@l.VatText" @oninput="@(e => l.VatText = FormatNum(e.Value))" maxlength="24"
                                               placeholder="0" inputmode="decimal" dir="ltr" />
                                        <span class="input-group-text order-line-unit" title="@(l.VatValue > 100 ? "مبلغ ریالی" : "درصد")">@(l.VatValue > 100 ? "ریال" : "٪")</span>
                                    </div>
                                    <div class="fs-9 mt-1 text-primary num order-line-sub">@l.VatAmount.MoneyExact() ریال</div>
                                </td>
                                <td data-label="کل پس از ارزش افزوده (ریال)" class="num fw-700"><span class="order-line-value">@l.Total.MoneyExact()</span></td>
                                @if (Type == TransactionType.Sale)
                                {
                                    @if (CanSeeProfit)
                                    {
                                        <td data-label="سود" class="num">
                                            @{ var profit = LineProfit(l); }
                                            <div class="order-line-value">
                                                @if (l.ProductId > 0 && l.Qty > 0)
                                                {
                                                    <span dir="ltr" class="fw-500 @(profit >= 0 ? "text-success" : "text-danger")">@profit.Money()</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                    @if (CanSeeProfit && referrerId > 0)
                                    {
                                        <td data-label="پورسانت" class="num">
                                            <div class="order-line-value">
                                                @if (l.ProductId > 0 && l.Qty > 0)
                                                {
                                                    <span class="text-primary">@(CommissionRatesKnown ? LineCommission(l).MoneyExact() : "نامشخص")</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                }
                                <td class="text-nowrap">
                                    <div class="order-line-actions">
                                        @if (Type == TransactionType.Sale && CanSeeProfit && l.ProductId > 0 && !IsServiceProduct(l.ProductId))
                                        {
                                            <button type="button" class="btn btn-sm btn-light text-primary last-purchase-action" tabindex="-1" data-order-last-purchase title="آخرین فاکتور خرید این کالا (F8)" aria-label="آخرین خرید، میانبر F8" @onclick="() => ShowLastPurchase(l.ProductId)"><span>آخرین خرید</span><kbd>F8</kbd></button>
                                        }
                                        <button class="btn btn-sm btn-light" tabindex="-1" title="حذف سطر" aria-label="حذف سطر" @onclick="() => RemoveLine(l)">
                                            <i class="bi bi-x-lg text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (!UseInvoiceWizard)
                    {
                    <tfoot class="border-top-2 table-light" style="border-top: 2px solid #cbd5e1;">
                        <tr class="align-middle">
                            <td class="fw-bold text-secondary">
                                <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1 fs-8">جمع اقلام فاکتور</span>
                                <span class="fs-8 text-muted ms-1">(@lines.Count.Num() سطر)</span>
                            </td>
                            <td class="text-center fw-600 num fs-8 text-muted">
                                @lines.Sum(l => l.Qty).ToString("0.##")
                            </td>
                            @* ناخالص زیر ستون قیمت واحد *@
                            <td class="text-center p-2">
                                <div class="fs-9 text-muted mb-1">جمع ناخالص:</div>
                                <div class="fw-bold fs-7 num text-dark">@totalGross.Money()</div>
                                <small class="fs-9 text-muted">ریال</small>
                            </td>
                            @* تخفیف کل اقلام زیر ستون تخفیف *@
                            <td class="text-center p-2">
                                <div class="fs-9 text-muted mb-1">تخفیف کل اقلام:</div>
                                <div class="fw-bold fs-7 num @(totalLineDiscount > 0 ? "text-danger" : "text-muted")">
                                    @(totalLineDiscount > 0 ? $"- {totalLineDiscount.Money()}" : "۰")
                                </div>
                                <small class="fs-9 text-muted">ریال</small>
                            </td>
                            @* مبلغ نهایی فاکتور زیر ستون مبلغ کل *@
                            <td class="text-start p-2">
                                <div class="fs-9 text-muted mb-1">مبلغ نهایی فاکتور:</div>
                                <div class="fw-900 fs-5 text-primary num" style="letter-spacing:-0.5px;">@grandTotal.Money()</div>
                                <small class="fs-9 text-muted">ریال</small>
                            </td>
                            @if (Type == TransactionType.Sale)
                            {
                                @if (CanSeeProfit)
                                {
                                    <td class="text-start p-2">
                                        <div class="fs-9 text-muted mb-1">سود کل:</div>
                                        <div class="fw-bold fs-7 num @(totalProfit >= 0 ? "text-success" : "text-danger")">@totalProfit.Money()</div>
                                    </td>
                                }
                                @if (referrerId > 0 && CanSeeProfit)
                                {
                                    <td class="text-start p-2">
                                        <div class="fs-9 text-muted mb-1">پورسانت:</div>
                                        <div class="fw-bold fs-7 num text-primary">@(CommissionRatesKnown ? totalCommission.MoneyExact() : "نامشخص")</div>
                                    </td>
                                }
                            }
                            <td></td>
                        </tr>
                    </tfoot>
                    }
                </table>
            </div>
            @if (UseInvoiceWizard)
            {

                <div class="purchase-totals-wrap">
                    <div class="purchase-totals">
                        @if (Type == TransactionType.Sale)
                        {
                            <div><span>جمع مقدار اقلام</span><strong class="num">@TotalLines.Sum(l => l.Qty).ToString("0.##")</strong></div>
                        }
                        <div><span>جمع ناخالص</span><strong class="num">@ExactMoney(totalGross) <small>ریال</small></strong></div>
                        <div><span>تخفیف اقلام</span><strong class="num">@ExactMoney(totalLineDiscount) <small>ریال</small></strong></div>
                        <div><span>مبلغ پس از تخفیف</span><strong class="num">@TotalLines.Sum(l => l.AfterDiscount).MoneyExact() <small>ریال</small></strong></div>
                        <div><span>ارزش افزوده</span><strong class="num">@TotalLines.Sum(l => l.VatAmount).MoneyExact() <small>ریال</small></strong></div>
                        <div class="purchase-totals-final"><span>مبلغ نهایی پس از ارزش افزوده</span><strong class="num">@ExactMoney(goodsTotal) <small>ریال</small></strong></div>
                    </div>
                </div>
            }
            }

            @if (Type == TransactionType.Sale && invoiceStep == 1 && CanSeeProfit)
            {
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mt-2 p-2 px-3 rounded-3 border bg-light fs-8">
                    @if (CanSeeProfit)
                    {
                        <div>
                            <span class="text-muted ms-1">سود تخمینی:</span>
                            <span class="fw-700 num @(totalProfit >= 0 ? "text-success" : "text-danger")">@totalProfit.Money()</span> ریال
                        </div>
                    }
                    @if (referrerId > 0)
                    {
                        <div>
                            <span class="text-muted ms-1">پورسانت معرف:</span>
                            <span class="fw-700 num text-primary">@(CommissionRatesKnown ? totalCommission.MoneyExact() : "نامشخص")</span> @(CommissionRatesKnown ? "ریال" : "")
                        </div>
                        @if (CanSeeProfit)
                        {
                            <div>
                                <span class="text-muted ms-1">سود خالص:</span>
                                <span class="fw-700 num @(netProfit >= 0 ? "text-success" : "text-danger")">@(CommissionRatesKnown ? netProfit.MoneyExact() : "نامشخص")</span> @(CommissionRatesKnown ? "ریال" : "")
                            </div>
                        }
                    }
                </div>
            }
        }
    </ChildContent>

    <Footer>
        <div class="invoice-footer-actions @(UseInvoiceWizard && invoiceStep == 1 ? "is-initial-step" : !UseInvoiceWizard ? "is-legacy" : "")">
        <button type="button" class="btn btn-light" @onclick="Cancel">انصراف (Esc)</button>
        @if (!loading && UseInvoiceWizard && invoiceStep == 1)
        {
            <button type="button" class="btn btn-primary" data-hotkey="f1" data-order-shortcut="next" title="میانبر: F1" @onclick="GoToPayment" disabled="@saving">
                ادامه و انتخاب روش پرداخت (F1) <i class="bi bi-arrow-left me-1"></i>
            </button>
        }
        else if (!loading)
        {
            @if (UseInvoiceWizard)
            {
                <button type="button" class="btn btn-outline-secondary" data-hotkey="f3" title="میانبر: F3" aria-label="@(Type == TransactionType.Sale ? "بازگشت به اطلاعات فروش" : "بازگشت به اطلاعات خرید")" @onclick="BackToInvoice" disabled="@saving"><i class="bi bi-arrow-right"></i> مرحله قبل (F3)</button>
            }
            <button type="button" class="btn btn-outline-primary" data-hotkey="f4" title="میانبر: F4" @onclick="SaveAndPrint" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                <i class="bi bi-printer"></i> @(IsEdit ? "ذخیره و چاپ" : "ثبت و چاپ") (F4)
            </button>
            <button type="button" class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                <i class="bi bi-check2"></i> @(IsEdit ? "ذخیره تغییرات (F1)" : Type == TransactionType.Purchase ? "ثبت فاکتور خرید (F1)" : "ثبت فاکتور فروش (F1)")
            </button>
        }
        </div>
    </Footer>
</Modal>

<Modal Visible="showPrintOptions" Title="انتخاب اندازه چاپ فاکتور" Size="modal-sm" OnClose="ClosePrintOptions">
    <ChildContent>
        <div class="invoice-print-options" data-order-child="@formKey" data-invoice-paper-size>
            <p class="text-muted fs-8 mb-3">اندازه کاغذ را انتخاب کنید؛ فاکتور پس از تأیید ثبت و پیش‌نمایش چاپ باز می‌شود.</p>
            @foreach (var option in InvoicePaperOptions)
            {
                <label class="invoice-paper-option @(printPaperSize == option.Value ? "is-selected" : "")">
                    <input type="radio" name="invoice-paper-@formKey" value="@option.Value" checked="@(printPaperSize == option.Value)"
                           @onchange="() => printPaperSize = option.Value" disabled="@saving" />
                    <span>@option.Label</span>
                </label>
            }
        </div>
    </ChildContent>
    <Footer>
        <div class="invoice-print-actions">
            <button type="button" class="btn btn-light" @onclick="ClosePrintOptions" disabled="@saving">انصراف</button>
            <button type="button" class="btn btn-primary" data-hotkey="f1" @onclick="ConfirmSaveAndPrint" disabled="@saving">تأیید و ثبت و چاپ (F1)</button>
        </div>
    </Footer>
</Modal>

<Modal Visible="showCashReconciliation" Title="تطبیق گردش نقدی فاکتور قدیمی" Size="modal-lg" OnClose="CloseLegacyCashReconciliation">
    <ChildContent>
        @if (EditOrder is not null)
        {
            <p>فاکتور <strong>@EditOrder.Number</strong> — مبلغ نقد ثبت‌شده: <strong class="num">@EditOrder.CashAmount.Money()</strong> ریال</p>
            @if (EditOrder.CashAmount > 0)
            {
                <div class="alert alert-info py-2">ابتدا گردش صندوق/بانک و اسناد دستی قبلی را بررسی کنید. اگر سند قطعی برای همین پرداخت موجود است، شماره آن را وارد کنید؛ در غیر این صورت گردش نقدی در تاریخ فاکتور ثبت می‌شود. از ثبت دوباره یک پرداخت قبلی خودداری کنید.</div>
                <div class="row g-2">
                    <div class="col-md-4"><label class="form-label">نوع پرداخت</label>
                        <select class="form-select" @bind="legacyCashType" disabled="@(EditOrder.CashType.HasValue)">
                            <option value="0">وجه نقد</option><option value="1">کارت‌خوان</option><option value="2">کارت به کارت</option>
                        </select>
                    </div>
                    <div class="col-md-8"><label class="form-label">حساب صندوق/بانک</label>
                        <select class="form-select" @bind="legacyAccountId" disabled="@(EditOrder.TrsAccountId is > 0)">
                            <option value="0">انتخاب حساب…</option>
                            @foreach (var account in AccountsForCashType((CashType)legacyCashType))
                            { <option value="@account.Id">@account.DisplayName</option> }
                        </select>
                    </div>
                    <div class="col-12"><label class="form-label">شماره سند دستی قطعی (در صورت وجود)</label>
                        <input type="number" min="1" class="form-control" @bind="legacyVoucherNumber" placeholder="اگر سند قبلی وجود ندارد خالی بگذارید" />
                    </div>
                </div>
            }
            else
            {
                <p>برای مبلغ نقد صفر گردش جدیدی ساخته نمی‌شود. اگر مبلغ نقد در سوابق فاکتور مشخص نیست، ابتدا مدارک آن را بررسی کنید.</p>
            }
            <label class="form-check mt-3">
                <input class="form-check-input" type="checkbox" @bind="legacyCashConfirmed" />
                <span class="form-check-label">سوابق را بررسی کردم و درستی انتخاب بالا را تأیید می‌کنم.</span>
            </label>
            @if (!string.IsNullOrEmpty(legacyCashError)) { <div class="alert alert-danger mt-2 mb-0" role="alert">@legacyCashError</div> }
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="CloseLegacyCashReconciliation" disabled="@savingLegacyCash">انصراف</button>
        <button type="button" class="btn btn-primary" @onclick="ConfirmLegacyCashReconciliation" disabled="@(!legacyCashConfirmed || savingLegacyCash)">
            @if (savingLegacyCash) { <span class="spinner-border spinner-border-sm ms-1"></span> } تأیید تطبیق
        </button>
    </Footer>
</Modal>

@if (showLastPurchaseModal)
{
    <Modal Visible="true" Title="آخرین فاکتور خرید و مبنای سود" Size="modal-lg" OnClose="CloseLastPurchase">
        <ChildContent>
            @if (lastPurchaseLoading)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else
            {
                @if (minimumProfitBasis is { } basis)
                {
                    <div class="alert alert-light border py-2 mb-3" role="status">
                        <strong>مبنای کنترل سود در تاریخ فاکتور:</strong>
                        <span> @(basis.MinimumProfitEnabled ? $"فعال · {basis.MinimumMarkupPercent:0.##}٪" : (basis.PolicyConfigured ? "غیرفعال" : "تنظیم نشده"))</span>
                        @if (basis.CompanyId.HasValue) { <small class="text-muted"> · شرکت @basis.CompanyId.Value.Num()</small> }
                        @if (basis.PurchaseId.HasValue)
                        {
                            <div class="mt-1">خرید مبنا: <button type="button" class="btn btn-link p-0 fw-bold" disabled="@openingPurchaseForm" @onclick="() => OpenPurchaseForm(basis.PurchaseId.Value)">@basis.PurchaseNumber <i class="bi bi-box-arrow-up-left" aria-hidden="true"></i></button> · @(basis.PurchaseDate.HasValue ? basis.PurchaseDate.Value.ToFa() : "—")
                                · مقدار <b class="num">@(basis.PurchaseQuantity.HasValue ? basis.PurchaseQuantity.Value.Qty() : "—")</b>
                                · مبلغ کالا <b class="num">@(basis.PurchaseGross.HasValue ? basis.PurchaseGross.Value.MoneyExact() : "—")</b>
                                · تخفیف خرید <b class="num">@(basis.PurchaseDiscount.HasValue ? basis.PurchaseDiscount.Value.MoneyExact() : "—")</b> ریال</div>
                        }
                        @if (basis.NetUnitCost.HasValue)
                        {
                            <div>بهای خالص تقریبی هر واحد: <b class="num">@basis.NetUnitCost.Value.ToString("#,##0.######", System.Globalization.CultureInfo.InvariantCulture)</b> ریال
                                @if (basis.MinimumUnitRevenueBeforeSaleDiscountAndCommission.HasValue)
                                { <span> · حداقل پایه یک واحد: <b class="num">@basis.MinimumUnitRevenueBeforeSaleDiscountAndCommission.Value.MoneyExact()</b> ریال</span> }
                            </div>
                            <small class="text-muted">حداقل پایه پیش از تخفیف فروش و پورسانت است؛ کنترل نهایی مبلغ واقعی سطر را می‌سنجد.</small>
                        }
                        @if (!string.IsNullOrEmpty(basis.Reason)) { <div class="text-danger">@basis.Reason</div> }
                    </div>
                }
                else if (!string.IsNullOrEmpty(minimumProfitBasisError))
                {
                    <div class="alert alert-warning py-2">دریافت مبنای سود ناموفق بود: @minimumProfitBasisError</div>
                }
                @if (lastPurchase is not null)
                {
                <div class="fs-8 text-muted mb-2">آخرین خرید کلی در ادامه است؛ ممکن است تاریخ آن با مبنای بالا متفاوت باشد.</div>
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">شماره سند</div>
                        <button type="button" class="btn btn-link p-0 fw-700 text-primary doc-number" disabled="@openingPurchaseForm" @onclick="() => OpenPurchaseForm(lastPurchase.Id)" title="باز کردن فرم خرید">@lastPurchase.Number <i class="bi bi-box-arrow-up-left" aria-hidden="true"></i></button>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">تاریخ</div>
                        <div class="fw-500">@lastPurchase.Date.ToFa()</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">تأمین‌کننده</div>
                        <div class="fw-500">@lastPurchase.PartyName</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">انبار</div>
                        <div class="fw-500">@lastPurchase.WarehouseName</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>کالا</th>
                                <th class="text-start">مقدار</th>
                                <th class="text-start">قیمت خرید</th>
                                <th class="text-start">جمع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in lastPurchase.Lines)
                            {
                                <tr class="@(l.ProductId == lastPurchaseProductId ? "table-warning" : "")">
                                    <td>
                                        @l.ProductName
                                        @if (l.ProductId == lastPurchaseProductId)
                                        {
                                            <i class="bi bi-arrow-right-short text-primary"></i>
                                        }
                                    </td>
                                    <td class="text-start num">@l.Quantity.Qty()</td>
                                    <td class="text-start num fw-700">@l.Price.MoneyExact()</td>
                                    <td class="text-start num">@l.Total.MoneyExact()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <span class="text-muted ms-2">مبلغ کل:</span>
                    <span class="fw-800 fs-6 text-primary num">@lastPurchase.TotalAmount.MoneyExact()</span>
                    <span class="fs-8 text-muted">ریال</span>
                </div>
                }
                else if (!string.IsNullOrEmpty(lastPurchaseError))
                { <div class="text-muted">@lastPurchaseError</div> }
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-light" @onclick="CloseLastPurchase">بستن (Esc)</button>
        </Footer>
    </Modal>
}

@if (purchaseFormOrder is not null)
{
    @* Keep the sale component/draft mounted while opening the authorized purchase form. *@
    <OrderForm @key="purchaseFormOrder.Id" Type="TransactionType.Purchase" EditOrder="purchaseFormOrder"
               OnSaved="OnPurchaseFormSaved" OnCancel="ClosePurchaseForm" />
}

<Modal Visible="showCalc" Title="@(calcInterestOnly ? "محاسبه تاخیر تادیه چک‌های دستی" : calcForCheque ? "محاسبه اقساطِ چک با سود" : "محاسبه اقساط با سود")" OnClose="() => showCalc = false">
    <ChildContent>
        <div class="row g-3" data-order-calculator="@formKey">
            <div class="col-md-6">
                <label class="form-label">مبلغ پایه (ریال)</label>
                <input class="form-control num" value="@calcBaseText"
                       @oninput="@(e => calcBaseText = Fa.FormatTyping(e.Value?.ToString()))" inputmode="numeric" dir="ltr" />
                <div class="fs-8 text-muted mt-1">@(calcForCheque && Type == TransactionType.Sale ? "مبنای پیشنهادی: اصل کالا با ارزش افزوده پس از کسر نقد و اقساط" : "مبنای پیشنهادی: باقیماندهٔ سند پس از کسر سایر پرداخت‌ها") (@ExactMoney(CalculatorSuggestedBase) ریال)</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">درصد سود ماهانه</label>
                <div class="input-group">
                    <input class="form-control num" value="@calcRateText"
                           @oninput="@(e => calcRateText = e.Value?.ToString() ?? "")" inputmode="decimal" dir="ltr" />
                    <span class="input-group-text">٪ در ماه</span>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">@(calcInterestOnly ? "تعداد ماه" : "تعداد ماه (قسط)")</label>
                <input class="form-control num" @bind="calcMonths" @bind:event="oninput" type="number" min="1" max="60" dir="ltr" />
            </div>
            @if (!calcInterestOnly)
            {
                <div class="col-md-4">
                    <label class="form-label">تاریخ شروع (اولین سررسید)</label>
                    <DatePicker @bind-Value="calcStart" OpenOnFocus="UseInvoiceWizard" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">فاصله هر @(calcForCheque ? "چک" : "قسط")</label>
                    <div class="input-group">
                        <input class="form-control num" @bind="calcIntervalDays" @bind:event="oninput" type="number" min="1" dir="ltr" />
                        <span class="input-group-text">روز</span>
                    </div>
                </div>
            }

            @if (calcForCheque && Type == TransactionType.Sale)
            {
                <div class="col-12 fs-8 text-muted">
                    سود همین محاسبه، یک‌بار به بدهی مشتری و درآمد فروشگاه اضافه می‌شود؛ به خود سود ارزش افزوده تعلق نمی‌گیرد.
                </div>
                @if (IsEdit && EditOrder?.HasChequeCharge != true)
                {
                    <div class="col-12"><div class="alert alert-warning py-2 mb-0 fs-8">افزودن سود به فاکتور ثبت‌شده‌ای که ردیف تاخیر تادیه ندارد، در ویرایش پشتیبانی نمی‌شود؛ برای فروش جدید از همین ماشین‌حساب استفاده کنید.</div></div>
                }
                else if (IsEdit && EditOrder?.HasChequeCharge == true && saleChequeCharge is null)
                {
                    <div class="col-12"><div class="alert alert-warning py-2 mb-0 fs-8">جزئیات محاسبه اولیه فاکتور قدیمی در دسترس نیست و نباید حدس زده شود؛ این فاکتور به بررسی سابقه نیاز دارد.</div></div>
                }
                else if (IsEdit && EditOrder?.HasChequeCharge == true)
                {
                    <div class="col-12"><div class="alert alert-warning py-2 mb-0 fs-8">فاکتور دارای گردش بعدی قابل ویرایش مستقیم نیست؛ برای آن از برگشت کالا، تغییر سررسید یا تعویض چک استفاده کنید. سابقه کامل هنگام ثبت در سرور کنترل می‌شود.</div></div>
                }
                @if (!calcInterestOnly)
                {
                <div class="col-12">
                    <details class="fs-8">
                        <summary class="text-secondary">شرایط اختیاری تعدیل سررسید (پیش‌فرض: نرخ ماهانه، هر ۳۰ روز)</summary>
                        <div class="row g-2 mt-1">
                            <div class="col-6">
                                <label class="form-label">نرخ تعدیل هر بازه (٪)</label>
                                <input class="form-control form-control-sm num" value="@calcAdjustmentRateText"
                                       @oninput="@(e => calcAdjustmentRateText = e.Value?.ToString() ?? "")"
                                       placeholder="همان نرخ ماهانه" inputmode="decimal" dir="ltr" />
                            </div>
                            <div class="col-6">
                                <label class="form-label">بازه تعدیل (روز)</label>
                                <input class="form-control form-control-sm num" type="number" min="1" @bind="calcAdjustmentDays" @bind:event="oninput" dir="ltr" />
                            </div>
                        </div>
                    </details>
                </div>
                }
            }
            @if (calcInterestOnly)
            {
                <div class="col-12"><div class="alert alert-info py-2 mb-0 fs-8">این محاسبه هیچ مبلغ، شماره، بانک یا سررسید چکی را تغییر نمی‌دهد. پس از افزودن سود، جمع پرداخت‌ها را خودتان بررسی و اختلاف را تعیین‌تکلیف کنید.</div></div>
            }
            else
            {
                @if (calcForCheque && cheques.Count > 0)
                {
                    <div class="col-12 fs-8 text-muted">با ساخت ردیف‌ها، ردیف‌های چک فعلی جایگزین می‌شوند؛ شماره و بانک چک‌های جدید را تکمیل کنید.</div>
                }
                <div class="col-12 fs-8 text-muted">ردیف‌ها تا ۱۰٬۰۰۰ ریال رند می‌شوند؛ اختلاف کمتر از این واحد در ردیف آخر می‌ماند و جمع و سود تغییر نمی‌کنند.</div>
            }
            @if (CalculatorPlan is { } calc)
            {
                var rowAmounts = calcInterestOnly ? Array.Empty<decimal>() : calc.Amounts;
                <div class="col-12">
                    <div class="calc-preview">
                        <div class="d-flex flex-wrap gap-3 justify-content-between">
                            <div><div class="fs-8 text-muted">مبلغ پایه</div><div class="num fw-700">@ExactMoney(calc.BaseAmount)</div></div>
                            <div><div class="fs-8 text-muted">سود کل (@ExactPercent(calc.MonthlyRatePercent)٪ × @calc.Months.Num() ماه)</div><div class="num fw-700 text-warning">@ExactMoney(calc.Interest)</div></div>
                            <div><div class="fs-8 text-muted">مبلغ نهایی</div><div class="num fw-800 text-primary">@ExactMoney(calc.Total)</div></div>
                            @if (!calcInterestOnly)
                            {
                                <div>
                                    <div class="fs-8 text-muted">مبلغ هر @(calcForCheque ? "چک" : "قسط")</div>
                                    <div class="num fw-800 text-success">@CalculatorAmountRange(rowAmounts)</div>
                                </div>
                            }
                        </div>
                        @if (!calcInterestOnly && rowAmounts.Distinct().Skip(1).Any())
                        {
                            <div class="fs-8 text-muted mt-2">توزیع ردیف‌ها:
                                @foreach (var group in rowAmounts.GroupBy(amount => amount))
                                {
                                    <span class="me-2">@(group.Count().Num()) × @ExactMoney(group.Key) ریال</span>
                                }
                            </div>
                        }
                        @if (!calcInterestOnly && calc.Total % RoundedInstallmentDistribution.RoundingUnit != 0m)
                        {
                            <div class="fs-8 text-muted mt-1">برای حفظ جمع دقیق، ردیف آخر <b class="num">@ExactMoney(rowAmounts[^1])</b> ریال است.</div>
                        }
                    </div>
                </div>
            }
            else if (CalcBase > 0)
            {
                <div class="col-12 fs-8 text-danger">@(calcInterestOnly ? "مبلغ، نرخ یا تعداد ماه معتبر نیست." : "مبلغ، نرخ یا تعداد معتبر نیست، یا مبلغ برای ساخت این تعداد ردیف مثبت با رند ۱۰٬۰۰۰ ریالی کافی نیست.") مبلغ حداکثر دو رقم اعشار و نرخ حداکثر شش رقم اعشار دارد.</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showCalc = false">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" @onclick="ApplyCalc" disabled="@(CalculatorPlan is null || (!calcInterestOnly && (calcIntervalDays < 1 || !calcStart.HasValue)))">
            <i class="bi bi-check2-circle"></i> @(calcInterestOnly ? "ثبت محاسبه سود در فاکتور (F1)" : "ساخت ردیف‌ها (F1)")
        </button>
    </Footer>
</Modal>



