    // ---------------- ماشین‌حساب اقساط/چک با سود ----------------
    private bool showCalc, calcForCheque, calcInterestOnly;
    private string calcBaseText = "", calcRateText = "", calcAdjustmentRateText = "";
    private int calcMonths = 3, calcIntervalDays = 30, calcAdjustmentDays = 30;
    private DateTime? calcStart;

    private decimal CalcBase => Fa.ParseDecimal(calcBaseText);

    private static bool TryCalculatorPercent(string? value, out decimal result)
    {
        if (string.IsNullOrWhiteSpace(value)) { result = 0; return true; }
        var normalized = Fa.ToEn(value).Trim().Replace(",", "").Replace("٬", "").Replace("٫", ".");
        return decimal.TryParse(normalized, System.Globalization.NumberStyles.AllowLeadingSign |
            System.Globalization.NumberStyles.AllowDecimalPoint, System.Globalization.CultureInfo.InvariantCulture, out result);
    }

    private InvoiceInstallmentCalculation? CalculatorPlan
    {
        get
        {
            if (!TryCalculatorPercent(calcRateText, out var rate)) return null;
            try
            {
                return calcInterestOnly
                    ? InvoiceInstallmentCalculation.CreateInterestOnly(CalcBase, rate, calcMonths)
                    : InvoiceInstallmentCalculation.Create(CalcBase, rate, calcMonths);
            }
            catch (ArgumentOutOfRangeException) { return null; }
        }
    }

    private decimal CalculatorSuggestedBase => calcForCheque && Type == TransactionType.Sale
        ? Math.Max(0m, goodsTotal - CashPart - InstSum())
        : Math.Max(0m, calcForCheque ? grandTotal - CashPart - InstSum() : grandTotal - CashPart - ChequeSum());

    private static string ExactMoney(decimal amount) => Fa.MoneyExact(amount);

    private static string CalculatorAmountRange(IReadOnlyList<decimal> amounts)
    {
        var minimum = amounts.Min();
        var maximum = amounts.Max();
        return minimum == maximum ? ExactMoney(minimum) : $"{ExactMoney(minimum)} تا {ExactMoney(maximum)}";
    }

    private static string ExactPercent(decimal rate)
        => Fa.Digits(rate.ToString("0.######", System.Globalization.CultureInfo.InvariantCulture));

    // The server checks the complete history; this avoids replacing form rows when later
    // activity is already visible on the loaded invoice.
    private bool KnownLaterChequeActivity
    {
        get
        {
            if (!IsEdit || EditOrder is not { HasChequeCharge: true } order) return false;
            if (order.IsCancelled || order.ChequeReturns.Count > 0 ||
                order.Cheques.Any(c => c.IsCleared || c.Status != ChequeStatus.InHand) ||
                order.Installments.Any(i => i.IsPaid) || order.SettledAmount != order.CashAmount) return true;
            if (order.ChequeChargeSnapshot is not { } snapshot) return false;
            try
            {
                return SaleChequeInitialCalculation.Calculate(snapshot.CalculatorBaseAmount, snapshot.CalculatorRatePercent,
                    snapshot.CalculatorMonths) != order.ChequeIncomeAmount;
            }
            catch (ArgumentOutOfRangeException) { return true; }
        }
    }

    private void OpenCalc(bool forCheque, bool interestOnly = false)
    {
        calcForCheque = forCheque;
        calcInterestOnly = forCheque && Type == TransactionType.Sale && interestOnly;
        // هنگام محاسبهٔ مجدد، سود قبلی نباید دوباره بخشی از مبنای چک شود.
        var baseRemain = CalculatorSuggestedBase;
        if (forCheque && Type == TransactionType.Sale && saleChequeCharge is not null)
        {
            if (chargeInvoiceBase == goodsTotal && chargeCashBase == CashPart && chargeInstallmentBase == InstSum())
                baseRemain = saleChequeCharge.CalculatorBaseAmount;
            calcRateText = ExactDecimal(saleChequeCharge.CalculatorRatePercent);
            calcMonths = saleChequeCharge.CalculatorMonths;
            calcAdjustmentRateText = saleChequeCharge.AdjustmentRatePercent == saleChequeCharge.CalculatorRatePercent
                ? "" : ExactDecimal(saleChequeCharge.AdjustmentRatePercent);
            calcAdjustmentDays = saleChequeCharge.AdjustmentPeriodDays;
        }
        else if (forCheque && Type == TransactionType.Sale)
        {
            calcAdjustmentRateText = ""; // خالی یعنی همان نرخ ماهانه، بدون ورود دوباره
            calcAdjustmentDays = 30;
        }
        calcBaseText = baseRemain > 0 ? Fa.FormatTyping(ExactDecimal(baseRemain)) : "";
        if (!calcStart.HasValue)
            calcStart = forCheque && chequeDates.Count > 0 && chequeDates[0].HasValue
                ? chequeDates[0] : DateTime.Now.AddMonths(1);
        showCalc = true;
        if (UseInvoiceWizard) pendingSectionFocus = "[data-order-calculator]";
    }

    private void ApplyCalc()
    {
        var plan = CalculatorPlan;
        if (plan is null || (!calcInterestOnly && (!calcStart.HasValue || calcIntervalDays < 1)))
        {
            InvoiceError("مبنا، نرخ، تعداد، تاریخ یا فاصله اقساط معتبر نیست.");
            return;
        }
        var calculation = plan.Value;
        var rowAmounts = calcInterestOnly ? Array.Empty<decimal>() : calculation.Amounts;
        var adjustmentRate = calculation.MonthlyRatePercent;
        SaleChequeChargeInput? calculatedCharge = null;
        if (calcForCheque && Type == TransactionType.Sale)
        {
            if (KnownLaterChequeActivity)
            {
                InvoiceError("فاکتور دارای گردش بعدی است؛ از برگشت کالا، تغییر سررسید یا تعویض چک استفاده کنید.");
                return;
            }
            if (IsEdit && EditOrder?.HasChequeCharge == true && saleChequeCharge is null)
            {
                InvoiceError("جزئیات سود این فاکتور قدیمی موجود نیست؛ بررسی دستی سابقه لازم است.");
                return;
            }
            if (!string.IsNullOrWhiteSpace(calcAdjustmentRateText) &&
                !TryCalculatorPercent(calcAdjustmentRateText, out adjustmentRate))
            {
                InvoiceError("نرخ تعدیل سررسید معتبر نیست.");
                return;
            }
            if (calculation.BaseAmount > goodsTotal)
            {
                InvoiceError("مبنای سود بیشتر از مبلغ کالا و ارزش افزوده است.");
                return;
            }
            try { calculatedCharge = calculation.CreateSaleChequeCharge(goodsTotal, adjustmentRate, calcAdjustmentDays); }
            catch (ArgumentOutOfRangeException)
            {
                InvoiceError("نرخ یا بازه تعدیل، یا جمع کالا و سود، خارج از محدوده مجاز است.");
                return;
            }
            if (IsEdit && EditOrder?.HasChequeCharge != true && calculatedCharge is not null)
            {
                InvoiceError("افزودن سود به فاکتور ثبت‌شده بدون ردیف تاخیر تادیه پشتیبانی نمی‌شود.");
                return;
            }
            if (IsEdit && EditOrder?.HasChequeCharge == true && calculatedCharge is null)
            {
                InvoiceError("حذف کامل سود از فاکتور ثبت‌شده با این ویرایش پشتیبانی نمی‌شود.");
                return;
            }
        }

        if (calcInterestOnly)
        {
            // Only replace the pending income article. Manual cheque rows and their
            // amounts, numbers, banks and dates are deliberately untouched.
            calculatedChequeSchedule = null;
            var hadCharge = saleChequeCharge is not null;
            saleChequeCharge = calculatedCharge;
            saleChequeIncome = calculatedCharge is null ? 0m : calculation.Interest;
            chargeInvoiceBase = calculatedCharge is null ? 0m : goodsTotal;
            chargeCashBase = calculatedCharge is null ? 0m : CashPart;
            chargeInstallmentBase = calculatedCharge is null ? 0m : InstSum();
            removedCalculatedChequeIncome = calculatedCharge is null && (hadCharge || removedCalculatedChequeIncome);
            showCalc = false;
            InvoiceInfo(calculatedCharge is null
                ? "سود محاسبه‌شده صفر است؛ مبلغ چک‌ها تغییر نکرد. جمع پرداخت‌ها را بررسی کنید."
                : $"تاخیر تادیه چک {ExactMoney(calculation.Interest)} ریال محاسبه شد؛ مبلغ چک‌ها تغییر نکرد. جمع پرداخت‌ها را بررسی کنید.");
            return;
        }

        // محاسبه و اعتبارسنجی همه سررسیدها پیش از جایگزینی هر ردیف انجام شود.
        var dates = new List<DateTime>();
        try
        {
            for (var i = 0; i < calculation.Months; i++)
                dates.Add(calcStart.Value.Date.AddDays((double)((long)i * calcIntervalDays)));
        }
        catch (ArgumentOutOfRangeException)
        {
            InvoiceError("تاریخ یا فاصله سررسیدها خارج از محدوده مجاز است.");
            return;
        }

        if (calcForCheque)
        {
            var newCheques = new List<ChequeDto>();
            var newAmounts = new List<string>();
            var newDates = new List<DateTime?>();
            for (var i = 0; i < calculation.Months; i++)
            {
                var amount = rowAmounts[i];
                newCheques.Add(new ChequeDto());
                newAmounts.Add(Fa.FormatTyping(ExactDecimal(amount)));
                newDates.Add(dates[i]);
            }
            cheques = newCheques; chequeAmounts = newAmounts; chequeDates = newDates;
            if (Type == TransactionType.Sale)
            {
                saleChequeCharge = calculatedCharge;
                saleChequeIncome = calculatedCharge is null ? 0m : calculation.Interest;
                chargeInvoiceBase = calculatedCharge is null ? 0m : goodsTotal;
                chargeCashBase = calculatedCharge is null ? 0m : CashPart;
                chargeInstallmentBase = calculatedCharge is null ? 0m : InstSum();
                removedCalculatedChequeIncome = false;
            }
            calculatedChequeSchedule = new CalculatedChequeSchedule(calculation, goodsTotal, CashPart, InstSum(),
                adjustmentRate, calcAdjustmentDays);
            InvoiceSuccess($"{calculation.Months} چک ساخته شد — مبلغ نهایی {ExactMoney(calculation.Total)} ریال (شامل {ExactMoney(calculation.Interest)} سود). شماره و بانک هر چک را تکمیل کنید.");
        }
        else
        {
            var newInstallments = new List<InstallmentDto>();
            var newAmounts = new List<string>();
            var newDates = new List<DateTime?>();
            for (var i = 0; i < calculation.Months; i++)
            {
                var amount = rowAmounts[i];
                newInstallments.Add(new InstallmentDto { No = i + 1 });
                newAmounts.Add(Fa.FormatTyping(ExactDecimal(amount)));
                newDates.Add(dates[i]);
            }
            installments = newInstallments; instAmounts = newAmounts; instDates = newDates;
            instCount = calculation.Months;
            InvoiceSuccess($"دفترچه {calculation.Months} قسطی ساخته شد — مبلغ نهایی {ExactMoney(calculation.Total)} ریال (شامل {ExactMoney(calculation.Interest)} سود).");
        }
        showCalc = false;
    }

    private List<ChequeDto> cheques = new();
    private List<string> chequeAmounts = new();
    private List<DateTime?> chequeDates = new();

    private List<InstallmentDto> installments = new();
    private List<string> instAmounts = new();
    private List<DateTime?> instDates = new();
    private int instCount = 3;
    private int instIntervalDays = 30;
    private DateTime? instFirstDue = DateTime.Now.AddMonths(1); // پیش‌فرض: یک ماه بعد از امروز

    /// <summary>سطر چک جدید — مبلغ پیش‌فرض = باقی‌ماندهٔ فعلی سند (نقد + چک‌ها + اقساط کسر شده).</summary>
    private void AddCheque()
    {
        calculatedChequeSchedule = null;
        var rest = FinalRemaining;
        cheques.Add(new ChequeDto());
        chequeAmounts.Add(rest > 0 ? Fa.FormatTyping(ExactDecimal(rest)) : "");
        chequeDates.Add(null);
        if (UseInvoiceWizard) pendingSectionFocus = $"[data-cheque-row=\"{cheques.Count - 1}\"]";
    }

    private void RemoveCheque(int i)
    {
        calculatedChequeSchedule = null;
        cheques.RemoveAt(i); chequeAmounts.RemoveAt(i); chequeDates.RemoveAt(i);
    }

    /// <summary>جمع چک‌ها — اگر جزء چک غیرفعال باشد صفر (سطرهایش نگه داشته می‌شوند تا با فعال‌سازی برگردند).</summary>
    private decimal ChequeSum()
    {
        if (!useCheque) return 0;
        decimal s = 0;
        foreach (var a in chequeAmounts) s += Fa.ParseDecimal(a);
        return s;
    }

    private void BuildInstallments(bool silent = false)
    {
        if (instCount < 1 || instCount > RoundedInstallmentDistribution.MaximumCount)
        { if (!silent) InvoiceError("تعداد قسط باید بین ۱ و ۶۰ باشد."); return; }
        if (!instFirstDue.HasValue) { if (!silent) InvoiceError("تاریخ اولین قسط را وارد کنید."); return; }
        if (instIntervalDays < 1) { if (!silent) InvoiceError("فاصله اقساط باید حداقل یک روز باشد."); return; }

        // مبلغ قابل تقسیم = باقی‌مانده پس از نقد و چک‌ها (سطرهای قبلی)
        var totalDue = Math.Max(0, grandTotal - CashPart - ChequeSum());
        if (totalDue <= 0) { if (!silent) InvoiceError("ابتدا اقلام فاکتور را وارد کنید."); return; }
        if (totalDue <= PaymentMix.Tolerance / 2m)
        { if (!silent) InvoiceError("مبلغ اقساط برای ثبت روش پرداخت کافی نیست."); return; }

        decimal[] amounts;
        try { amounts = RoundedInstallmentDistribution.Split(totalDue, instCount); }
        catch (ArgumentOutOfRangeException)
        {
            if (!silent) InvoiceError("مبلغ باید حداکثر دو رقم اعشار داشته باشد و برای این تعداد قسط مثبت با رند ۱۰٬۰۰۰ ریالی کافی باشد.");
            return;
        }

        // Keep the old rows until every new amount and due date is valid.
        var newInstallments = new List<InstallmentDto>();
        var newAmounts = new List<string>();
        var newDates = new List<DateTime?>();
        try
        {
            for (var i = 0; i < instCount; i++)
            {
                newInstallments.Add(new InstallmentDto { No = i + 1 });
                newAmounts.Add(Fa.FormatTyping(ExactDecimal(amounts[i])));
                newDates.Add(instFirstDue.Value.AddDays((double)((long)i * instIntervalDays)));
            }
        }
        catch (ArgumentOutOfRangeException)
        {
            if (!silent) InvoiceError("تاریخ یا فاصله سررسیدها خارج از محدوده مجاز است.");
            return;
        }
        installments = newInstallments; instAmounts = newAmounts; instDates = newDates;
        if (!silent && UseInvoiceWizard) pendingSectionFocus = "[data-inst-row=\"0\"]";
    }

    private void RemoveInstallment(int i)
    {
        installments.RemoveAt(i); instAmounts.RemoveAt(i); instDates.RemoveAt(i);
    }

    /// <summary>جمع اقساط — اگر جزء اقساط غیرفعال باشد صفر.</summary>
    private decimal InstSum()
    {
        if (!useInstallment) return 0;
        decimal s = 0;
        foreach (var a in instAmounts) s += Fa.ParseDecimal(a);
        return s;
    }
    private decimal totalProfit => lines.Where(l => l.ProductId > 0 && l.Qty > 0).Sum(LineProfit);
    private decimal totalCommission => lines.Where(l => l.ProductId > 0 && l.Qty > 0).Sum(LineCommission);
    private decimal netProfit => totalProfit - totalCommission;
    private List<Referrer> referrers = new();
    private List<Party> customers = new();

    /// <summary>با انتخاب مشتری، معرف او (در صورت وجود) خودکار تعیین می‌شود؛ بدون معرف = بدون پورسانت.</summary>
    private void OnPartyChanged(int v)
    {
        partyId = v;
        if (Type != TransactionType.Sale) return;
        var customer = customers.FirstOrDefault(c => c.Id == v);
        referrerId = customer?.ReferrerId is > 0 ? customer.ReferrerId.Value : 0;
    }

    private (decimal? Goods, decimal? Service) PreviewCommissionRates
    {
        get
        {
            // For an edit, only the server can tell whether the saved policy is
            // historical, legacy or damaged. Do not substitute today's rate.
            if (IsEdit && EditOrder?.ReferrerId == referrerId)
                return (EditOrder.ReferrerGoodsCommissionPercent, EditOrder.ReferrerServiceCommissionPercent);
            var r = referrers.FirstOrDefault(x => x.Id == referrerId);
            return (r?.GoodsCommissionPercent, r?.ServiceCommissionPercent);
        }
    }
    private bool CommissionRatesKnown => PreviewCommissionRates is (decimal goods, decimal service) &&
        goods is >= 0 and <= 100 && service is >= 0 and <= 100;

    /// <summary>پورسانت تخمینی سطر: کالا = درصد × سود سطر (سود منفی=۰) | خدمات = درصد × مبلغ سطر.</summary>
    private decimal LineCommission(LineVm l)
    {
        if (referrerId <= 0 || !CommissionRatesKnown) return 0;
        var (goodsRate, serviceRate) = PreviewCommissionRates;
        var sameEditedReferrer = IsEdit && EditOrder?.ReferrerId == referrerId;
        var p = products.FirstOrDefault(x => x.Id == l.ProductId);
        if (p is null) return 0;
        if (p.IsService && !(sameEditedReferrer && EditOrder?.UsesLegacyCommissionPolicy == true))
            return SaleReferrerCommission.Service(l.AfterDiscount, serviceRate.Value);
        return SaleReferrerCommission.Goods(LineProfit(l), p.IsService ? serviceRate.Value : goodsRate.Value);
    }

    // ---------- آخرین فاکتور خرید ----------
    private Order? lastPurchase;
    private Order? purchaseFormOrder;
    private bool openingPurchaseForm;
    private ShopMinimumProfitBasisDto? minimumProfitBasis;
    private string? lastPurchaseError, minimumProfitBasisError;
    private bool showLastPurchaseModal, lastPurchaseLoading;
    private int lastPurchaseProductId, lastPurchaseRequestVersion;

    private bool IsServiceProduct(int productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product?.IsService
            ?? EditOrder?.Lines.FirstOrDefault(l => l.ProductId == productId)?.IsService
            ?? CopyTemplate?.Lines.FirstOrDefault(l => l.ProductId == productId)?.IsService
            ?? false;
    }

    private async Task ShowLastPurchase(int productId)
    {
        var version = ++lastPurchaseRequestVersion;
        var invoiceDate = date;
        lastPurchaseProductId = productId;
        showLastPurchaseModal = true;
        lastPurchaseLoading = true;
        lastPurchase = null;
        minimumProfitBasis = null;
        lastPurchaseError = minimumProfitBasisError = null;
        Order? purchase = null;
        ShopMinimumProfitBasisDto? basis = null;
        string? purchaseError = null, basisError = null;
        try { purchase = await OrderSvc.GetLastPurchaseAsync(productId); }
        catch (Exception ex) { purchaseError = ex.Message; }
        if (invoiceDate.HasValue)
        {
            try { basis = await OrderSvc.GetMinimumProfitBasisAsync(productId, invoiceDate.Value, IsEdit ? EditOrder!.Id : null); }
            catch (Exception ex) { basisError = ex.Message; }
        }
        else basisError = "ابتدا تاریخ فاکتور را مشخص کنید.";
        if (version != lastPurchaseRequestVersion) return;
        lastPurchase = purchase;
        minimumProfitBasis = basis;
        lastPurchaseError = purchaseError;
        minimumProfitBasisError = basisError;
        lastPurchaseLoading = false;
    }

    private async Task OpenPurchaseForm(int purchaseId)
    {
        if (openingPurchaseForm || purchaseId <= 0) return;
        openingPurchaseForm = true;
        var version = lastPurchaseRequestVersion;
        try
        {
            // Use the normal API, including its current-company and purchase read permissions.
            var order = await OrderSvc.GetAsync(purchaseId);
            if (version != lastPurchaseRequestVersion || !showLastPurchaseModal) return;
            if (order is null || order.Type != TransactionType.Purchase)
            {
                InvoiceError("سند خرید در دسترس نیست.");
                return;
            }
            purchaseFormOrder = order;
        }
        catch (Exception ex) { InvoiceError("باز کردن خرید ناموفق بود: " + ex.Message); }
        finally { openingPurchaseForm = false; }
    }

    private void ClosePurchaseForm() => purchaseFormOrder = null;

    private async Task OnPurchaseFormSaved()
    {
        purchaseFormOrder = null;
        // Refresh the purchase summary/basis without replacing any sale lines or payment data.
        if (showLastPurchaseModal) await ShowLastPurchase(lastPurchaseProductId);
    }

    private void CloseLastPurchase()
    {
        lastPurchaseRequestVersion++;
        showLastPurchaseModal = false;
        lastPurchase = null;
        minimumProfitBasis = null;
        lastPurchaseLoading = false;
    }

    /// <summary>سود تخمینی سطر: (قیمت فروش − بهای تمام‌شده میانگین) × مقدار. خدمات = کل مبلغ.</summary>
    private decimal totalGross => TotalLines.Sum(l => l.Gross);
    private decimal totalLineDiscount => TotalLines.Sum(l => l.DiscountAmount);

    private decimal LineProfit(LineVm l)
    {
        var p = products.FirstOrDefault(x => x.Id == l.ProductId);
        if (p is null) return 0;
        if (p.IsService)
        {
            var serviceCost = IsEdit ? EditOrder?.Lines.FirstOrDefault(x => x.Id == l.Id)?.UnitCost ?? 0m : 0m;
            return l.AfterDiscount - serviceCost * l.Qty;
        }
        var cost = p.AvgCost > 0 ? p.AvgCost : p.PurchasePrice;
        return l.AfterDiscount - (cost * l.Qty);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Independent requests start together; existing/copy warehouse stock can also load immediately.
            if (IsEdit) warehouseId = EditOrder!.WarehouseId;
            else if (CopyTemplate is not null) warehouseId = CopyTemplate.WarehouseId;
            var profitTask = Type == TransactionType.Sale ? OrderSvc.CanViewProfitAsync() : Task.FromResult(false);
            var pricingTask = OrderSvc.CanManagePricingAsync();
            var whTask = OrderSvc.GetInvoiceWarehousesAsync(Type, activeOnly: true);
            var partiesTask = OrderSvc.GetInvoicePartiesAsync(Type);
            var prodTask = OrderSvc.GetInvoiceProductsAsync(Type);
            var bankTask = OrderSvc.GetActiveTreasuryAccountsAsync();
            var referrerTask = Type == TransactionType.Sale ? ReferrerSvc.GetAllAsync(activeOnly: true) : null;
            var stockTask = LoadWarehouseStocksAsync();
            try
            {
                var savedBanks = await JS.InvokeAsync<string?>("localStorage.getItem", "invoiceCheque.customBanks");
                if (!string.IsNullOrWhiteSpace(savedBanks)) customChequeBanks = System.Text.Json.JsonSerializer.Deserialize<List<string>>(savedBanks) ?? new();
            }
            catch (Exception) { customChequeBanks = new(); }
            try { canSeeProfit = await profitTask; }
            catch { canSeeProfit = false; } // fail closed if the permission cannot be verified
            try { canManagePricing = await pricingTask; }
            catch { canManagePricing = false; }
            whLookup = await whTask;
            var invoiceParties = await partiesTask;
            if (Type == TransactionType.Purchase)
                partyLookup = invoiceParties.Where(p => p.IsActive).Select(p => PartyService.ToLookup(p)).ToList();
            var prods = await prodTask;

            try
            {
                bankAccounts = await bankTask;
            }
            catch
            {
                bankAccounts = new();
            }

            // در خرید، خدمات قابل انتخاب نیست؛ در فروش همه (کالا + خدمات) قابل انتخاب‌اند
            products = prods.Items
                .Where(p => p.IsActive && (Type == TransactionType.Sale || !p.IsService))
                .ToList();
            await stockTask;
            RebuildProductLookup();
            if (warehouseId > 0 && !warehouseStock.IsLoaded)
                InvoiceError("دریافت موجودی انبار ناموفق بود؛ انبار را پاک و دوباره انتخاب کنید.");

            if (Type == TransactionType.Sale)
            {
                try { referrers = await referrerTask!; }
                catch { referrers = new(); } // معرف اختیاری است و مجوز آن پیش‌نیاز فروش نیست.

                // فهرست مشتری‌ها با نمایش وضعیت معرف: «بدون معرف» یا نام معرف
                customers = invoiceParties;
                partyLookup = customers.Where(c => c.IsActive)
                    .Select(c => PartyService.ToLookup(c, CustomerDisplay(c)))
                    .ToList();
            }

            activeWarehouseIds = whLookup.Select(w => w.Id).ToHashSet();
            activePartyIds = partyLookup.Select(p => p.Id).ToHashSet();

            if (IsEdit)
            {
                // پر کردن فرم از سند موجود
                var o = EditOrder!;
                warehouseId = o.WarehouseId;
                partyId = o.PartyId;
                referrerId = o.ReferrerId ?? 0;
                date = o.Date;
                description = o.Description;

                // بارگذاری اطلاعات پرداخت (خرید و فروش) — اجزای ترکیبی
                cashTrackingNumber = o.CashTrackingNumber;
                cashTypeStr = ((int)(o.CashType ?? CashType.Cash)).ToString();
                trsAccountId = o.TrsAccountId;
                creditDue = o.DueDate;
                useCheque = o.Cheques.Count > 0 || o.PaymentMethod == PaymentMethod.Cheque;
                useInstallment = o.Installments.Count > 0 || o.PaymentMethod == PaymentMethod.Installment;
                if (o.HasChequeCharge)
                {
                    // Even an old charge without calculator terms is still a real, visible amount.
                    saleChequeIncome = o.ChequeIncomeAmount;
                    chargeInvoiceBase = o.GoodsAmount;
                    chargeCashBase = o.CashAmount;
                    chargeInstallmentBase = o.Installments.Sum(i => i.Amount);
                    if (o.ChequeChargeSnapshot is { } snapshot)
                    {
                        saleChequeCharge = new SaleChequeChargeInput
                        {
                            CalculatorBaseAmount = snapshot.CalculatorBaseAmount,
                            CalculatorRatePercent = snapshot.CalculatorRatePercent,
                            CalculatorMonths = snapshot.CalculatorMonths,
                            AdjustmentRatePercent = snapshot.AdjustmentRatePercent,
                            AdjustmentPeriodDays = snapshot.AdjustmentPeriodDays,
                            ConfirmedCreditDueDate = snapshot.ConfirmedCreditDueDate
                        };
                    }
                }
                var loadedCash = o.PaymentMethod == PaymentMethod.Cash ? o.TotalAmount : o.CashAmount;
                useCash = loadedCash > 0 || (o.Cheques.Count == 0 && o.Installments.Count == 0 && o.PaymentMethod != PaymentMethod.Cheque && o.PaymentMethod != PaymentMethod.Installment);
                cashAmountText = loadedCash > 0 && (o.Cheques.Count > 0 || o.Installments.Count > 0 || o.PaymentMethod != PaymentMethod.Cash)
                    ? Fa.FormatTyping(ExactDecimal(loadedCash)) : "";
                var loadedCredit = o.TotalAmount - loadedCash - o.Cheques.Sum(c => c.Amount) - o.Installments.Sum(i => i.Amount);
                useCredit = loadedCredit > 1 || o.PaymentMethod == PaymentMethod.Credit;
                cheques = o.Cheques.Select(c => new ChequeDto
                {
                    Id = c.Id, Number = c.Number, TrsAccountId = c.TrsAccountId, BankName = c.BankName, AccountInfo = c.AccountInfo,
                    OwnerName = c.OwnerName, Amount = c.Amount, DueDate = c.DueDate, IsCleared = c.IsCleared,
                    ClearedAt = c.ClearedAt, Note = c.Note
                }).ToList();
                chequeAmounts = o.Cheques.Select(c => Fa.FormatTyping(ExactDecimal(c.Amount))).ToList();
                chequeDates = o.Cheques.Select(c => (DateTime?)c.DueDate).ToList();
                installments = o.Installments.Select(i => new InstallmentDto
                {
                    Id = i.Id, No = i.No, Amount = i.Amount, DueDate = i.DueDate, IsPaid = i.IsPaid, PaidAt = i.PaidAt
                }).ToList();
                instAmounts = o.Installments.Select(i => Fa.FormatTyping(ExactDecimal(i.Amount))).ToList();
                instDates = o.Installments.Select(i => (DateTime?)i.DueDate).ToList();
                instCount = Math.Max(1, installments.Count);
                lines = o.Lines.Select(l =>
                {
                    var vm = new LineVm
                    {
                        Id = l.Id,
                        ProductId = l.ProductId,
                        OriginalQty = l.Quantity,
                        OriginalProductId = l.ProductId,
                        OriginalPrice = l.Price,
                        OriginalGross = l.GrossAmount ?? OrderLineAmounts.Gross(l.Quantity, l.Price),
                        OriginalDiscountAmount = l.DiscountAmount,
                        OriginalDiscountPercent = l.DiscountPercent,
                        OriginalDiscountIsAmount = l.DiscountIsAmount,
                        OriginalVatValue = l.VatValue,
                        OriginalVatAmount = l.VatAmount,
                        QtyText = FormatQuantity(ExactDecimal(l.Quantity)),
                        PriceText = PurchaseSalePriceInput.Format(ExactDecimal(l.Price)),
                        Unit = l.Unit,
                        DiscountPercent = l.DiscountPercent,
                        DiscountAmount = l.DiscountAmount,
                        DiscountIsAmount = l.DiscountIsAmount,
                        VatText = FormatNum(l.VatValue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))
                    };
                    if (vm.DiscountIsAmount)
                        vm.DiscountText = vm.DiscountAmount > 0 ? FormatNum(ExactDecimal(vm.DiscountAmount)) : "";
                    else
                        vm.DiscountText = vm.DiscountPercent > 0 ? ExactDecimal(vm.DiscountPercent) : "";
                    return vm;
                }).ToList();
                if (lines.Count == 0) lines.Add(new LineVm());
                paymentStepGoodsTotal = goodsTotal;

                // فیلتر کالاها بر اساس انبار سند
                RebuildProductLookup();

                // اگر انبار/طرف حساب/کالای سند غیرفعال شده، موقتاً به فهرست اضافه می‌شود تا انتخاب حفظ شود
                if (warehouseId > 0 && !whLookup.Any(w => w.Id == warehouseId))
                    whLookup.Add(new LookupItem { Id = warehouseId, Name = o.WarehouseName ?? $"انبار {warehouseId}" });
                if (partyId > 0 && !partyLookup.Any(p => p.Id == partyId))
                    partyLookup.Add(new LookupItem { Id = partyId, Name = o.PartyName ?? $"طرف حساب {partyId}" });
                foreach (var l in o.Lines.Where(l => !productLookup.Any(p => p.Id == l.ProductId)))
                    productLookup.Add(InvoiceProductOption.Create(l.ProductId, l.ProductName, l.Unit, IsServiceProduct(l.ProductId), warehouseStock));
            }
            else
            {
                date = DateTime.Now;
                var def = bankAccounts.FirstOrDefault(a => a.IsDefault) ?? bankAccounts.FirstOrDefault();
                if (def != null) trsAccountId = def.Id;

                if (CopyTemplate is { } copy && copy.Type == Type)
                {
                    warehouseId = copy.WarehouseId;
                    OnPartyChanged(copy.PartyId); // current customer/referrer, not the old commission snapshot
                    description = copy.Description;
                    lines = copy.Lines.Select(l =>
                    {
                        var vm = new LineVm
                        {
                            ProductId = l.ProductId,
                            QtyText = FormatQuantity(ExactDecimal(l.Quantity)),
                            PriceText = PurchaseSalePriceInput.Format(ExactDecimal(l.Price)),
                            Unit = l.Unit,
                            DiscountPercent = l.DiscountPercent,
                            DiscountAmount = l.DiscountAmount,
                            DiscountIsAmount = l.DiscountIsAmount,
                            VatText = FormatNum(ExactDecimal(l.VatValue))
                        };
                        RecalcDiscount(vm);
                        vm.DiscountText = vm.DiscountIsAmount
                            ? (vm.DiscountAmount > 0 ? FormatNum(ExactDecimal(vm.DiscountAmount)) : "")
                            : (vm.DiscountPercent > 0 ? ExactDecimal(vm.DiscountPercent) : "");
                        return vm;
                    }).ToList();
                    if (lines.Count == 0) lines.Add(new LineVm());

                    // Keep old names visible for review, but validation requires active selections on a new copy.
                    if (warehouseId > 0 && !whLookup.Any(w => w.Id == warehouseId))
                        whLookup.Add(new LookupItem { Id = warehouseId, Name = copy.WarehouseName ?? $"انبار {warehouseId}" });
                    if (partyId > 0 && !partyLookup.Any(p => p.Id == partyId))
                        partyLookup.Add(new LookupItem { Id = partyId, Name = copy.PartyName ?? $"طرف حساب {partyId}" });
                    foreach (var l in copy.Lines.Where(l => !productLookup.Any(p => p.Id == l.ProductId)))
                        productLookup.Add(InvoiceProductOption.Create(l.ProductId, l.ProductName, l.Unit, IsServiceProduct(l.ProductId), warehouseStock));
                }
            }
        }
        catch (Exception ex)
        {
            ShowFormError(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private Task<bool> LoadWarehouseStocksAsync()
        => warehouseStock.LoadAsync(warehouseId, (id, page, size) =>
            OrderSvc.GetWarehouseStockAsync(id, page, size));

    // Use the same eligibility rule when selecting a product and when validating
    // a copy; the temporary old-name entry must not make an ineligible item valid.
    private bool IsProductSelectable(Product p)
    {
        if (warehouseId <= 0) return true;
        if (p.IsService) return Type == TransactionType.Sale;
        if (p.WarehouseId is > 0 && p.WarehouseId != warehouseId) return false;
        if (Type == TransactionType.Sale)
            return p.WarehouseId == warehouseId || warehouseStock.Quantities.ContainsKey(p.Id);
        return p.WarehouseId is null || p.WarehouseId == warehouseId;
    }

    /// <summary>بازسازی فهرست کالاها بر اساس انبار انتخاب‌شده و نمایش موجودی در منوی انتخاب.</summary>
    private void RebuildProductLookup()
    {
        var filtered = products.Where(IsProductSelectable);
        productLookup = filtered
            .Select(p => (LookupItem)InvoiceProductOption.Create(
                p.Id, p.IsService ? $"{p.Code} — {p.Name} (خدمات)" : $"{p.Code} — {p.Name}",
                p.Unit, p.IsService, warehouseStock))
            .ToList();

        // Keep existing line names visible while a new warehouse's stock is unknown;
        // these temporary entries do not change the eligibility rule used by validation.
        if (warehouseId > 0 && !warehouseStock.IsLoaded)
        {
            var visible = productLookup.Select(p => p.Id).ToHashSet();
            foreach (var line in lines.Where(l => l.ProductId > 0 && visible.Add(l.ProductId)))
            {
                var product = products.FirstOrDefault(p => p.Id == line.ProductId);
                var name = product is not null
                    ? $"{product.Code} — {product.Name}" + (product.IsService ? " (خدمات)" : "")
                    : EditOrder?.Lines.FirstOrDefault(l => l.ProductId == line.ProductId)?.ProductName
                        ?? CopyTemplate?.Lines.FirstOrDefault(l => l.ProductId == line.ProductId)?.ProductName
                        ?? $"کالا {line.ProductId}";
                productLookup.Add(InvoiceProductOption.Create(line.ProductId, name, product?.Unit ?? line.Unit,
                    IsServiceProduct(line.ProductId), warehouseStock));
            }
        }
    }

    private async Task OnWarehouseChanged(int v)
    {
        warehouseId = v;
        var load = LoadWarehouseStocksAsync();
        RebuildProductLookup(); // immediately replace the previous warehouse's quantities with a loading state
        if (!await load) return; // a newer warehouse selection has already taken over
        RebuildProductLookup();
        if (warehouseId > 0 && !warehouseStock.IsLoaded)
        {
            InvoiceError("دریافت موجودی انبار ناموفق بود؛ انبار را پاک و دوباره انتخاب کنید.");
            return; // an unavailable snapshot must not clear existing invoice lines
        }

        // سطرهایی که کالایشان دیگر در فهرست مجاز این انبار نیست، پاک می‌شوند
        var validProductIds = productLookup.Select(x => x.Id).ToHashSet();
        foreach (var l in lines.Where(x => x.ProductId > 0).ToList())
        {
            if (!validProductIds.Contains(l.ProductId))
            {
                var p = products.FirstOrDefault(x => x.Id == l.ProductId);
                l.ProductId = 0;
                l.Unit = "";
                l.PriceText = "";
                l.DiscountText = "";
                l.DiscountAmount = 0;
                l.DiscountPercent = 0;
                l.VatText = "0";
                InvoiceInfo($"کالای «{p?.Name ?? "انتخاب‌شده"}» در این انبار موجود/مجاز نیست و از سطرها حذف شد.");
            }
        }
    }

    private static void RecalcDiscount(LineVm l)
    {
        var gross = l.Gross;
        if (l.SameOriginalBasis && l.OriginalDiscountIsAmount == l.DiscountIsAmount &&
            l.OriginalDiscountAmount.HasValue && l.OriginalDiscountPercent.HasValue &&
            (l.DiscountIsAmount ? Fa.ParseDecimal(l.DiscountText) == l.OriginalDiscountAmount.Value
                                : l.DiscountPercent == l.OriginalDiscountPercent.Value))
        {
            l.DiscountAmount = l.OriginalDiscountAmount.Value;
            l.DiscountPercent = l.OriginalDiscountPercent.Value;
            return;
        }
        if (l.DiscountIsAmount)
        {
            l.DiscountAmount = Math.Clamp(Math.Round(l.DiscountAmount, 0), 0, Math.Max(0, gross));
            l.DiscountPercent = gross > 0 ? Math.Round(l.DiscountAmount * 100m / gross, 2) : 0;
        }
        else
        {
            l.DiscountPercent = Math.Clamp(l.DiscountPercent, 0, 100);
            l.DiscountAmount = Math.Round(gross * l.DiscountPercent / 100m, 0);
        }
    }

    private void OnLineDiscountInput(LineVm l, string? raw)
    {
        l.DiscountText = raw ?? "";
        var val = Math.Max(0, Fa.ParseDecimal(raw));
        if (val <= 100)
        {
            l.DiscountIsAmount = false;
            l.DiscountPercent = val;
            l.DiscountAmount = 0;
        }
        else
        {
            l.DiscountIsAmount = true;
            l.DiscountAmount = val;
        }
        RecalcDiscount(l);
    }

    private void OnLineDiscountBlur(LineVm l)
    {
        RecalcDiscount(l);
        if (l.DiscountIsAmount)
        {
            l.DiscountText = l.DiscountAmount > 0 ? FormatNum(ExactDecimal(l.DiscountAmount)) : "";
        }
        else
        {
            l.DiscountText = l.DiscountPercent > 0 ? l.DiscountPercent.ToString("0.##") : "";
        }
    }

