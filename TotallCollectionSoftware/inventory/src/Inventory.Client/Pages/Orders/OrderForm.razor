    private Order? lastPurchase;
    private bool lastPurchaseLoading;
    private int lastPurchaseProductId;

    private bool IsServiceProduct(int productId)
    {
        var product = products.FirstOrDefault(p => p.Id == productId);
        return product?.IsService
            ?? EditOrder?.Lines.FirstOrDefault(l => l.ProductId == productId)?.IsService
            ?? CopyTemplate?.Lines.FirstOrDefault(l => l.ProductId == productId)?.IsService
            ?? false;
    }

