    private void OpenLegacyCashReconciliation()
    {
        if (EditOrder is null) return;
        legacyCashType = (int)(EditOrder.CashType ?? CashType.Cash);
        legacyAccountId = EditOrder.TrsAccountId ?? 0;
        legacyVoucherNumber = null;
        legacyCashConfirmed = false;
        legacyCashError = null;
        legacyCashOperationId = Guid.NewGuid();
        showCashReconciliation = true;
    }
    private void CloseLegacyCashReconciliation() { if (!savingLegacyCash) showCashReconciliation = false; }
    private async Task ConfirmLegacyCashReconciliation()
    {
        if (savingLegacyCash || !legacyCashConfirmed || EditOrder is null) return;
        savingLegacyCash = true;
        legacyCashError = null;
        try
        {
            var command = new ShopCashReconciliationCommand
            {
                OperationId = legacyCashOperationId, Confirmed = true, ExpectedCashAmount = EditOrder.CashAmount,
                TrsAccountId = EditOrder.CashAmount > 0 ? legacyAccountId : null,
                CashType = EditOrder.CashAmount > 0 ? (CashType)legacyCashType : null,
                ExistingVoucherNumber = legacyVoucherNumber
            };
            await OrderSvc.ReconcileCashAsync(EditOrder.Id, command);
            EditOrder.ShopCashLedgerEnabled = true;
            if (EditOrder.CashAmount > 0)
            {
                EditOrder.TrsAccountId = legacyAccountId;
                EditOrder.CashType = (CashType)legacyCashType;
                trsAccountId = legacyAccountId;
                cashTypeStr = legacyCashType.ToString();
            }
            showCashReconciliation = false;
            InvoiceSuccess("تطبیق گردش نقدی ثبت شد.");
        }
        catch (Exception ex) { legacyCashError = ex.Message; }
        finally { savingLegacyCash = false; }
    }

