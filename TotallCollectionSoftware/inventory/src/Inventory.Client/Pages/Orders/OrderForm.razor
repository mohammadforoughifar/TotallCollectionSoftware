        {
            if (pendingLineFocus is Guid key)
            {
                pendingLineFocus = null;
                await JS.InvokeVoidAsync("orderEntry.focusLine", formKey, key.ToString());
            }
            else if (pendingSectionFocus is string selector)
            {
                pendingSectionFocus = null;
                await JS.InvokeVoidAsync("orderEntry.focusSection", formKey, selector);
            }
            else if (!invoiceInitialFocusDone)
            {
                invoiceInitialFocusDone = true;
                await JS.InvokeVoidAsync("orderEntry.focusSection", formKey, "[data-order-initial]");
            }
