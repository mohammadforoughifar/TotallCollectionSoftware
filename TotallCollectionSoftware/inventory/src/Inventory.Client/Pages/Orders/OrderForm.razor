@inject IOrderService OrderSvc
@inject IWarehouseService WarehouseSvc
@inject IPartyService PartySvc
@inject IProductService ProductSvc
@inject IReferrerService ReferrerSvc
@inject ITrsAccountService AccountSvc
@inject IToastService Toast
@inject ICompanyProfileService ProfileSvc
@inject IJSRuntime JS
@using Inventory.Client.Pages.Orders

<Modal Visible="true" Title="@FormTitle" Size="@(UseInvoiceWizard ? "modal-xl invoice-dialog" : "modal-xl")" HeaderClass="@(UseInvoiceWizard ? "purchase-order-header" : "")" OnClose="Cancel">

    <ChildContent>
        @if (!string.IsNullOrEmpty(formError))
        {
            <div class="order-form-error" role="alert"><i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i><span>@formError</span><button type="button" aria-label="بستن پیام خطا" @onclick="() => formError = null">×</button></div>
        }
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else
        {
            @if (UseInvoiceWizard)
            {
                <nav class="purchase-steps" data-order-wizard="@formKey" aria-label="@(Type == TransactionType.Sale ? "مراحل ثبت فروش" : "مراحل ثبت خرید")">
                    <div class="purchase-step @(invoiceStep == 1 ? "active" : "complete")" aria-current="@(invoiceStep == 1 ? "step" : null)">
                        <span class="purchase-step-number">@if (invoiceStep == 1) { <span>۱</span> } else { <i class="bi bi-check-lg"></i> }</span>
                        <span><strong>@(Type == TransactionType.Sale ? "اطلاعات فروش" : "اطلاعات خرید")</strong><small>مشخصات و اقلام فاکتور</small></span>
                    </div>
                    <span class="purchase-step-line" aria-hidden="true"></span>
                    <div class="purchase-step @(invoiceStep == 2 ? "active" : "")" aria-current="@(invoiceStep == 2 ? "step" : null)">
                        <span class="purchase-step-number">۲</span>
                        <span><strong>پرداخت و تأیید</strong><small>روش پرداخت و ثبت نهایی</small></span>
                    </div>
                </nav>
                @if (CopyTemplate is not null && invoiceStep == 1)
                {
                    <div class="invoice-copy-notice" role="status">
                        <i class="bi bi-copy" aria-hidden="true"></i>
                        <span>این فاکتور جدید است؛ اقلام را بازبینی کنید. اطلاعات پرداخت و گردش فاکتور قبلی کپی نشده است.
                            @if (CopyTemplate.Lines.Any(l => l.DiscountIsAmount && l.DiscountAmount != Math.Round(l.DiscountAmount, 0)))
                            {
                                <br /><strong>تخفیف ریالی اعشاری طبق قواعد ثبت جدید به ریال کامل گرد شده است؛ مبلغ را بررسی کنید.</strong>
                            }
                        </span>
                    </div>
                }
                <div class="purchase-section-heading">
                    <div>
                        <h3>@(invoiceStep == 1 ? "اطلاعات فاکتور" : "پرداخت و تأیید نهایی")</h3>
                        <p>@(invoiceStep == 1 ? (Type == TransactionType.Sale ? "ابتدا مشخصات فروش و اقلام فاکتور را تکمیل کنید." : "ابتدا مشخصات خرید و کالاهای فاکتور را تکمیل کنید.") : "روش پرداخت را انتخاب کنید؛ امکان ترکیب چند روش وجود دارد.")</p>
                    </div>
                    <span>مرحله @invoiceStep.Num() از ۲</span>
                </div>
            }
            <div class="row g-3 mb-3">
                @if (!UseInvoiceWizard || invoiceStep == 1)
                {
                <div class="col-md-4" data-order-initial>
                    <label class="form-label">انبار <span class="text-danger">*</span></label>
                    <SearchSelect Items="whLookup" ShowAllOnFocus="UseInvoiceWizard" ConstrainToModal="UseInvoiceWizard" AdvanceOnEnter="UseInvoiceWizard" Value="warehouseId" ValueChanged="OnWarehouseChanged" Placeholder="انتخاب انبار…" />
                </div>
                <div class="col-md-4">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <label class="form-label mb-0">@(Type == TransactionType.Sale ? "مشتری" : "تأمین‌کننده") <span class="text-danger">*</span></label>
                        <button type="button" class="btn btn-link btn-sm p-0 text-decoration-none fw-bold" title="افزودن طرف حساب" @onclick="OpenQuickParty">
                            <i class="bi bi-plus-circle-fill text-success"></i> @(Type == TransactionType.Sale ? "مشتری جدید" : "تأمین‌کننده جدید")
                        </button>
                    </div>
                    <SearchSelect Items="partyLookup" ShowAllOnFocus="UseInvoiceWizard" ConstrainToModal="UseInvoiceWizard" AdvanceOnEnter="UseInvoiceWizard" Value="partyId" ValueChanged="OnPartyChanged" Placeholder="انتخاب طرف حساب…" />
                </div>
                <div class="col-md-4">
                    <label class="form-label">تاریخ سند <span class="text-danger">*</span></label>
                    <DatePicker @bind-Value="date" OpenOnFocus="UseInvoiceWizard" />
                </div>
                <div class="col-12">
                    <label class="form-label">توضیحات</label>
                    <input class="form-control" @bind="description" placeholder="اختیاری" />
                </div>
                @if (Type == TransactionType.Sale && referrerId > 0)
                {
                    <div class="col-12">
                        <div class="alert alert-info fs-8 py-2 mb-0">
                            <i class="bi bi-person-badge ms-1"></i>
                            معرف این مشتری: <b>@(referrers.FirstOrDefault(r => r.Id == referrerId)?.Name)</b>
                        </div>
                    </div>
                }

                }

                @if (UseInvoiceWizard && invoiceStep == 2)
                {
                    <div class="col-12 purchase-payment" data-order-payment>
                        @if (UseInvoiceWizard)
                        {
                            <section class="purchase-summary" aria-label="خلاصه فاکتور و پرداخت">
                                <div class="purchase-summary-head"><strong><i class="bi bi-receipt"></i> خلاصه فاکتور</strong><span>مبالغ به ریال</span></div>
                                <div class="purchase-summary-main">
                                    <div><span>@(Type == TransactionType.Sale ? "مشتری" : "تأمین‌کننده")</span><strong>@(partyLookup.FirstOrDefault(p => p.Id == partyId)?.Name ?? "—")</strong></div>
                                    <div><span>انبار</span><strong>@(whLookup.FirstOrDefault(w => w.Id == warehouseId)?.Name ?? "—")</strong></div>
                                    <div><span>اقلام</span><strong>@(lines.Count(l => l.ProductId > 0 && l.Qty > 0).Num()) سطر</strong></div>
                                    @if (saleChequeCharge is not null)
                                    {
                                        <div><span>کالا با ارزش افزوده</span><strong class="num">@goodsTotal.Money()</strong></div>
                                        <div><span>تاخیر تادیه چک</span><strong class="num">@saleChequeIncome.Money()</strong></div>
                                    }
                                    <div class="purchase-summary-total"><span>مبلغ نهایی فاکتور</span><strong class="num">@grandTotal.Money()</strong></div>
                                </div>
                                <div class="purchase-summary-pay" aria-live="polite">
                                    <div><span>نقد</span><strong class="num">@CashPart.Money()</strong></div>
                                    <div><span>چک</span><strong class="num">@ChequeSum().Money()</strong></div>
                                    <div><span>@(Type == TransactionType.Purchase ? "اعلامیه پرداخت" : "اقساط")</span><strong class="num">@InstSum().Money()</strong></div>
                                    <div class="purchase-summary-remaining @(Math.Abs(FinalRemaining) > (saleChequeCharge is null ? 1 : 0) ? "is-warning" : "")">
                                        <span>@(FinalRemaining < (saleChequeCharge is null ? -1 : 0) ? "مازاد پرداخت" : useCredit && FinalRemaining > (saleChequeCharge is null ? 1 : 0) ? "مانده نسیه" : "باقی‌مانده")</span>
                                        <strong class="num">@Math.Abs(FinalRemaining).Money()</strong>
                                    </div>
                                </div>
                                <p class="purchase-summary-status" aria-live="polite">
                                    @if (FinalRemaining > (saleChequeCharge is null ? 1 : 0))
                                    {
                                        @(useCredit ? "مانده فاکتور به نسیه می‌رود؛ تاریخ سررسید را بررسی کنید." : "برای مانده فاکتور، پرداخت دیگری اضافه کنید یا نسیه و سررسید آن را مشخص کنید.")
                                    }
                                    else if (FinalRemaining < (saleChequeCharge is null ? -1 : 0))
                                    {
                                        <span>@(saleChequeCharge is null ? "جمع پرداخت‌ها بیشتر از مبلغ فاکتور است (مازاد / سود مدت‌دار)." : "جمع پرداخت‌ها بیشتر از مبلغ فاکتور است؛ آن را دستی اصلاح کنید.")</span>
                                    }
                                    else
                                    {
                                        <span>جمع اجزای پرداخت با مبلغ فاکتور برابر است.</span>
                                    }
                                </p>
                            </section>
                        }
                        <div class="pay-box">
                            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                                <span class="fw-700"><i class="bi bi-credit-card-2-front text-primary ms-1"></i>روش پرداخت (ترکیبی)</span>
                                <span class="fs-8 text-muted">
                                    می‌توانید چند جزء را هم‌زمان فعال کنید (نقد + چک + @(Type == TransactionType.Purchase ? "اعلامیه پرداخت" : "اقساط") + نسیه)؛
                                    باقی‌ماندهٔ هر سطر بر اساس سطرهای قبلی و مبلغ نقدی محاسبه می‌شود.
                                </span>
                            </div>
                            <div class="pay-tabs" aria-label="روش‌های پرداخت">
                                <button type="button" class="pay-tab @(useCash ? "active" : "")" data-pay-comp="cash" aria-pressed="@(useCash ? "true" : "false")" @onclick="ToggleCash">
                                    <i class="bi bi-cash-coin"></i> نقدی
                                </button>
                                <button type="button" class="pay-tab @(useCheque ? "active" : "")" data-pay-comp="cheque" aria-pressed="@(useCheque ? "true" : "false")" @onclick="ToggleCheque">
                                    <i class="bi bi-bank"></i> چک
                                </button>
                                <button type="button" class="pay-tab @(useInstallment ? "active" : "")" data-pay-comp="installment" aria-pressed="@(useInstallment ? "true" : "false")" @onclick="ToggleInstallment">
                                    <i class="bi bi-journal-check"></i> @(Type == TransactionType.Purchase ? "اعلامیه پرداخت" : "اقساطی")
                                </button>
                                <button type="button" class="pay-tab @(useCredit ? "active" : "")" data-pay-comp="credit" aria-pressed="@(useCredit ? "true" : "false")" @onclick="ToggleCredit">
                                    <i class="bi bi-hourglass-split"></i> نسیه
                                </button>
                            </div>
                            <div class="order-keyboard-hint">Enter: فیلد بعدی · F1: ثبت · F3: مرحله قبل · F4: ثبت و چاپ · Esc: انصراف</div>

                            @* ---------- جزء نقدی ---------- *@
                            @if (useCash)
                            {
                                <div class="mt-3" data-pay-cash-box>
                                    <div class="row g-2 align-items-end">
                                        @if (HasNonCash)
                                        {
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8"><i class="bi bi-cash-coin text-success"></i> @(Type == TransactionType.Sale ? "دریافت نقدی" : "پرداخت نقدی") (بخشی از مبلغ)</label>
                                                <input class="form-control form-control-sm num" value="@cashAmountText"
                                                       @oninput="OnCashAmountInput" inputmode="numeric" dir="ltr" placeholder="0" data-pay-cash-input />
                                            </div>
                                        }
                                        <div class="col-6 col-md-3">
                                            <label class="form-label fs-8">نوع @(Type == TransactionType.Sale ? "دریافت" : "پرداخت") نقدی</label>
                                            <SearchSelect Items="CashTypeLookup" Value="@((int)CashKind + 1)" ValueChanged="OnCashTypePicked"
                                                          ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" AllowClear="false" />
                                        </div>
                                        <div class="col-6 col-md-4">
                                            <label class="form-label fs-8">بانک/صندوق</label>
                                            <div class="input-group input-group-sm order-bank-select">
                                                <SearchSelect Items="@CashAccountLookup" Value="@(trsAccountId ?? 0)" ValueChanged="OnCashAccountPicked"
                                                              Placeholder="انتخاب بانک…" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" />
                                                <button type="button" class="btn btn-outline-primary" title="تعریف بانک/حساب جدید"
                                                        @onclick="() => OpenQuickBank(TreasuryAccountKind.Bank)">
                                                    <i class="bi bi-plus-lg ms-1"></i> تعریف بانک
                                                </button>
                                            </div>
                                        </div>
                                        @if (Type == TransactionType.Sale && CashKind == CashType.CardTransfer)
                                        {
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8" for="cash-tracking-@formKey">شماره پیگیری پرداخت <span class="text-danger">*</span></label>
                                                <input id="cash-tracking-@formKey" class="form-control form-control-sm" @bind="cashTrackingNumber" maxlength="100" dir="ltr" autocomplete="off" />
                                            </div>
                                        }
                                        <div class="col-12 col-md-2 fs-8 pb-1">
                                            @if (HasNonCash)
                                            {
                                                <span>باقی‌مانده پس از نقد: <b class="num text-primary" data-pay-remain-cash>@RemainingAfterCash.Money()</b></span>
                                            }
                                            else
                                            {
                                                <span class="text-muted">تمام مبلغ نقدی است.</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                            @* ---------- جزء چک ---------- *@
                            @if (useCheque)
                            {
                                <div class="mt-3" data-pay-cheque-box>
                                    <div class="d-flex align-items-center gap-2 mb-2">
                                        <span class="fs-8 fw-700">@(Type == TransactionType.Purchase ? "چک‌های پرداختی به تأمین‌کننده" : "چک‌های دریافتی از مشتری")</span>
                                        <button type="button" class="btn btn-sm btn-calc ms-auto" title="محاسبه اقساط چک" disabled="@(saleChequeCharge is not null)" @onclick="() => OpenCalc(true)">
                                            <i class="bi bi-calculator"></i> محاسبه اقساطِ چک
                                        </button>
                                        <button type="button" class="btn btn-sm btn-outline-primary" data-pay-add-cheque data-hotkey="f2" title="کلید میانبر: F2" @onclick="AddCheque">
                                            <i class="bi bi-plus-lg"></i> افزودن چک (F2)
                                        </button>
                                    </div>
                                    @if (Type == TransactionType.Sale && (!IsEdit || EditOrder?.HasChequeCharge == true))
                                    {
                                        <div class="alert alert-light border py-2 fs-8 mb-2">
                                            <div class="d-flex flex-wrap align-items-center gap-2">
                                                <strong>تاخیر تادیه چک</strong>
                                                @if (saleChequeCharge is not null)
                                                {
                                                    <span class="num">@saleChequeIncome.Money() ریال</span>
                                                    @if (!IsEdit)
                                                    {
                                                        <button type="button" class="btn btn-sm btn-outline-danger" @onclick="RemoveSaleChequeCharge">حذف سود</button>
                                                    }
                                                }
                                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenSaleChequeCharge">محاسبه سود</button>
                                            </div>
                                            <div class="text-muted mt-1">ثبت آزمایشی این قابلیت به تنظیمات سرور وابسته است؛ مبلغ سود جدا از کالا و بدون ارزش افزوده در حساب درآمد مالی ثبت می‌شود.</div>
                                        </div>
                                    }
                                    @for (var ci = 0; ci < cheques.Count; ci++)
                                    {
                                        var i = ci;
                                        <div class="cheque-row row g-2 align-items-end" data-cheque-row="@i">
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">شماره چک/صیاد *</label>
                                                <input class="form-control form-control-sm" @bind="cheques[i].Number" dir="ltr" />
                                            </div>
                                            <div class="col-6 col-md-3">
                                                <label class="form-label fs-8">بانک @(Type == TransactionType.Purchase ? "(حساب ما) *" : "")</label>
                                                <div class="input-group input-group-sm order-bank-select">
                                                    @if (Type == TransactionType.Purchase)
                                                    {
                                                        <SearchSelect Items="@ChequeAccountLookup" Value="@(cheques[i].TrsAccountId ?? 0)" ValueChanged="@(id => OnChequeAccountPicked(i, id))"
                                                                      Placeholder="انتخاب حساب بانکی…" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" />
                                                    }
                                                    else
                                                    {
                                                        <SearchSelectStr Items="@ChequeBankNames" Value="@(cheques[i].BankName ?? "")" ValueChanged="@(name => cheques[i].BankName = name)"
                                                                         Placeholder="نام بانک…" AllowCustomValue="true" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="UseInvoiceWizard" />
                                                    }
                                                    <button type="button" class="btn btn-outline-primary" title="افزودن بانک" aria-label="افزودن بانک"
                                                            @onclick="() => OpenChequeBank(i)">
                                                        <i class="bi bi-plus-lg"></i>
                                                    </button>
                                                </div>
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">@(Type == TransactionType.Purchase ? "در وجه / گیرنده" : "صاحب چک")</label>
                                                <input class="form-control form-control-sm" @bind="cheques[i].OwnerName" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">مبلغ (ریال) *</label>
                                                <input class="form-control form-control-sm num" value="@chequeAmounts[i]"
                                                       @oninput="@(e => OnChequeAmountInput(i, e))" inputmode="numeric" dir="ltr" />
                                            </div>
                                            <div class="col-6 col-md-2">
                                                <label class="form-label fs-8">سررسید چک *</label>
                                                <DatePicker @bind-Value="chequeDates[i]" OpenOnFocus="UseInvoiceWizard" />
                                            </div>
                                            <div class="col-6 col-md-1 text-center">
                                                <button type="button" class="btn btn-sm btn-light" tabindex="-1" title="حذف چک" aria-label="حذف چک" data-pay-remove-cheque="@i" @onclick="() => RemoveCheque(i)"><i class="bi bi-x-lg text-danger"></i></button>
                                            </div>
                                            <div class="col-12 fs-9">
                                                <span class="text-muted">باقی‌مانده پس از این چک:</span>
                                                <b class="num text-primary" data-rem-cheque="@i">@RemainingAfterCheque(i).Money()</b> ریال
                                            </div>
                                        </div>
                                    }
                                    @if (cheques.Count == 0)
                                    {
                                        <div class="fs-8 text-muted">هنوز چکی اضافه نشده است؛ با «افزودن چک» ردیف جدید با مبلغ باقی‌مانده ساخته می‌شود.</div>
                                    }
                                </div>
                            }

                            @* ---------- جزء اقساط ---------- *@
                            @if (useInstallment)
                            {
                                <div class="mt-3" data-pay-inst-box>
                                    <div class="row g-2 align-items-end mb-2">
                                        <div class="col-6 col-md-2">
                                            <label class="form-label fs-8">تعداد قسط</label>
                                            <input class="form-control form-control-sm num" @bind="instCount" type="number" min="1" max="60" dir="ltr" />
                                        </div>
                                        <div class="col-6 col-md-3">
                                            <label class="form-label fs-8">تاریخ اولین قسط</label>
                                            <DatePicker @bind-Value="instFirstDue" OpenOnFocus="UseInvoiceWizard" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <label class="form-label fs-8">فاصله (روز)</label>
                                            <input class="form-control form-control-sm num" @bind="instIntervalDays" type="number" min="1" dir="ltr" />
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <button type="button" class="btn btn-sm btn-primary w-100" data-pay-build-inst @onclick="() => BuildInstallments()">
                                                <i class="bi bi-journal-plus"></i> ساخت دفترچه
                                            </button>
                                        </div>
                                        <div class="col-6 col-md-2">
                                            <button type="button" class="btn btn-sm btn-calc w-100" title="محاسبه با سود" @onclick="() => OpenCalc(false)">
                                                <i class="bi bi-calculator"></i> محاسبه با سود
                                            </button>
                                        </div>
                                    </div>
                                    @if (installments.Count > 0)
                                    {
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-1">
                                                <thead>
                                                    <tr>
                                                        <th>قسط</th><th>سررسید</th><th class="text-start">مبلغ (ریال)</th>
                                                        <th class="text-start">باقی‌مانده پس از این قسط</th><th></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @for (var xi = 0; xi < installments.Count; xi++)
                                                    {
                                                        var i = xi;
                                                        <tr data-inst-row="@i">
                                                            <td class="num">قسط @((i + 1).Num())</td>
                                                            <td style="max-width:170px"><DatePicker @bind-Value="instDates[i]" OpenOnFocus="UseInvoiceWizard" /></td>
                                                            <td class="text-start">
                                                                <input class="form-control form-control-sm num" value="@instAmounts[i]"
                                                                       @oninput="@(e => OnInstAmountInput(i, e))" inputmode="numeric" dir="ltr" />
                                                            </td>
                                                            <td class="text-start"><b class="num text-primary" data-rem-inst="@i">@RemainingAfterInstallment(i).Money()</b></td>
                                                            <td><button type="button" class="btn btn-sm btn-light" tabindex="-1" title="حذف قسط" aria-label="حذف قسط" data-pay-remove-inst="@i" @onclick="() => RemoveInstallment(i)"><i class="bi bi-x-lg text-danger"></i></button></td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                        <div class="fs-8">
                                            جمع اقساط: <b class="num">@InstSum().Money()</b> —
                                            باقی‌ماندهٔ تجمعی: <b class="num text-primary" data-pay-remain-inst>@FinalRemaining.Money()</b>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="fs-8 text-muted">با «ساخت دفترچه» اقساط بر اساس باقی‌ماندهٔ فعلی ساخته می‌شوند.</div>
                                    }
                                </div>
                            }

                            @* ---------- جزء نسیه (باقی‌ماندهٔ نهایی) ---------- *@
                            @if (useCredit)
                            {
                                <div class="mt-3 row g-2 align-items-end" data-pay-credit-box>
                                    <div class="col-6 col-md-4">
                                        <label class="form-label fs-8">تاریخ سررسید نسیه <span class="text-danger">*</span></label>
                                        <DatePicker @bind-Value="creditDue" OpenOnFocus="UseInvoiceWizard" />
                                    </div>
                                    <div class="col-12 col-md-8 fs-8 pb-1">
                                        مبلغ نسیه (باقی‌ماندهٔ نهایی): <b class="num text-danger" data-pay-credit-amount>@Math.Max(0, FinalRemaining).Money()</b> ریال
                                    </div>
                                </div>
                            }

                        </div>
                    </div>
                }
            </div>

            @if (!UseInvoiceWizard || invoiceStep == 1)
            {
            <div class="d-flex justify-content-between align-items-center mb-2">
                <span class="fw-700 fs-7"><i class="bi bi-list-ul text-primary ms-1"></i>اقلام فاکتور</span>
                <button class="btn btn-sm btn-outline-primary" data-order-add-line data-hotkey="f2" title="کلید میانبر: F2" @onclick="AddLine">
                    <i class="bi bi-plus-lg"></i> افزودن سطر (F2)
                </button>
            </div>
            @if (UseInvoiceWizard)
            {
                <div class="order-keyboard-hint mb-2">Tab و Enter: پیمایش فیلدها (Shift+Enter: خط جدید) · Enter در پایان سطر کالا: سطر بعد · F2: سطر جدید · F1: ادامه · Esc: انصراف</div>
            }

            <div data-order-entry class="@(UseInvoiceWizard ? (Type == TransactionType.Sale ? "purchase-items sale-items" : "purchase-items") : "")">
                <table class="table table-hover align-middle mb-0">
                    @if (UseInvoiceWizard)
                    {
                        <colgroup>
                            <col style="width:@InvoiceColumnWidth(22, 20)" />
                            <col style="width:@InvoiceColumnWidth(8)" />
                            <col style="width:@InvoiceColumnWidth(12, 11)" />
                            <col style="width:@InvoiceColumnWidth(11, 10)" />
                            <col style="width:@InvoiceColumnWidth(9, 11)" />
                            <col style="width:@InvoiceColumnWidth(11, 10)" />
                            <col style="width:@InvoiceColumnWidth(9, 11)" />
                            <col style="width:@InvoiceColumnWidth(13, 14)" />
                            @if (Type == TransactionType.Sale && CanSeeProfit) { <col style="width:@InvoiceColumnWidth(SaleExtraColumnWeight)" /> }
                            @if (Type == TransactionType.Sale && referrerId > 0) { <col style="width:@InvoiceColumnWidth(SaleExtraColumnWeight)" /> }
                            <col style="width:@InvoiceActionsColumnWidth" />
                        </colgroup>
                    }
                    <thead>
                        <tr>
                            <th><span>کالا</span></th>
                            <th title="مقدار تا دو رقم اعشار"><span>مقدار</span><small>تا ۲ رقم</small></th>
                            <th><span>قیمت واحد</span><small>ریال</small></th>
                            <th><span>مبلغ کل</span><small>ریال</small></th>
                            <th title="تا ۱۰۰ درصد، بالاتر مبلغ ریالی"><span>تخفیف</span><small>٪ یا ریال</small></th>
                            <th><span>پس از تخفیف</span><small>ریال</small></th>
                            <th title="تا ۱۰۰ درصد، بالاتر مبلغ ریالی"><span>ارزش افزوده</span><small>٪ یا ریال</small></th>
                            <th><span>کل پس از ارزش افزوده</span><small>ریال</small></th>
                            @if (Type == TransactionType.Sale)
                            {
                                @if (CanSeeProfit)
                                {
                                    <th><span>سود</span><small>ریال</small></th>
                                }
                                @if (referrerId > 0)
                                {
                                    <th><span>پورسانت</span><small>ریال</small></th>
                                }
                            }
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in lines)
                        {
                            <tr @key="l.Key" data-order-line="@l.Key">
                                <td data-label="کالا">
                                    <SearchSelect Items="productLookup"
                                                  CssClass="order-line-control"
                                                  ShowAllOnFocus="UseInvoiceWizard"
                                                  ConstrainToModal="UseInvoiceWizard"
                                                  AdvanceOnEnter="UseInvoiceWizard"
                                                  Value="l.ProductId"
                                                  ValueChanged="id => OnProductPicked(l, id)"
                                                  Placeholder="جستجوی کالا…">
                                        <ItemDetails Context="option">
                                            @if (option is InvoiceProductOption productOption && productOption.StockQuantity.HasValue)
                                            {
                                                var quantity = productOption.StockQuantity.Value;
                                                <small class="ss-item-info invoice-stock-info">
                                                    موجودی این انبار:
                                                    <span class="invoice-stock-quantity @(productOption.IsStockWarning ? "is-warning" : "")">
                                                        @if (productOption.IsStockWarning)
                                                        {
                                                            <i class="bi bi-exclamation-triangle-fill" aria-hidden="true"></i>
                                                            <span class="visually-hidden">هشدار موجودی صفر یا منفی: </span>
                                                        }
                                                        <bdi dir="ltr">@InvoiceProductOption.FormatStock(quantity)</bdi>
                                                    </span>
                                                    @productOption.StockUnit
                                                </small>
                                            }
                                            else if (!string.IsNullOrWhiteSpace(option.InfoText))
                                            {
                                                <small class="ss-item-info">@option.InfoText</small>
                                            }
                                        </ItemDetails>
                                    </SearchSelect>
                                    @if (!string.IsNullOrEmpty(l.Unit) || l.ProductId > 0)
                                    {
                                        <div class="fs-8 text-muted mt-1 d-flex gap-2 flex-wrap">
                                            @if (!string.IsNullOrEmpty(l.Unit))
                                            {
                                                <span>واحد: @l.Unit</span>
                                            }
                                            @if (l.ProductId > 0 && warehouseId > 0 && !IsServiceProduct(l.ProductId))
                                            {
                                                @if (warehouseStock.IsLoaded)
                                                {
                                                    var avail = warehouseStock.Quantities.TryGetValue(l.ProductId, out var q) ? q : 0m;
                                                    <span class="@(avail <= 0 ? "text-danger" : "text-success")">
                                                        · موجودی انبار: <b class="num"><bdi dir="ltr">@InvoiceProductOption.FormatStock(avail)</bdi></b>
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span>· موجودی انبار: @(warehouseStock.IsLoading ? "در حال دریافت…" : "نامشخص")</span>
                                                }
                                            }
                                        </div>
                                    }
                                </td>
                                <td data-label="مقدار">
                                    <input class="form-control text-center num order-line-control" aria-label="مقدار" inputmode="decimal" dir="ltr" placeholder="1.25"
                                           title="مقدار می‌تواند اعشاری و تا دو رقم اعشار باشد"
                                           value="@l.QtyText" @oninput="@(e => { l.QtyText = FormatQuantity(e.Value); RecalcDiscount(l); })" />
                                </td>
                                <td data-label="قیمت واحد (ریال)">
                                    <input class="form-control num order-line-control" aria-label="قیمت واحد به ریال" inputmode="decimal" dir="ltr"
                                           value="@l.PriceText" @oninput="@(e => { l.PriceText = FormatNum(e.Value); RecalcDiscount(l); })" />
                                </td>
                                <td data-label="مبلغ کل (ریال)" class="num fw-500"><span class="order-line-value">@l.Gross.Money()</span></td>
                                <td data-label="تخفیف (٪ یا ریال)">
                                    <div class="input-group input-group-sm order-line-rate">
                                        <input class="form-control form-control-sm text-center num order-line-control" aria-label="تخفیف درصد یا ریال"
                                               value="@l.DiscountText"
                                               @oninput="e => OnLineDiscountInput(l, e.Value?.ToString())"
                                               @onblur="() => OnLineDiscountBlur(l)"
                                               placeholder="0" inputmode="numeric" dir="ltr" />
                                        <span class="input-group-text order-line-unit @(l.DiscountIsAmount ? "text-primary" : "")"
                                              title="@(l.DiscountIsAmount ? "مبلغ ریالی" : "درصد")">
                                            @(l.DiscountIsAmount ? "ریال" : "٪")
                                        </span>
                                    </div>
                                    <div class="fs-9 mt-1 text-danger num order-line-sub">
                                        @l.DiscountAmount.Money() ریال
                                    </div>
                                </td>
                                <td data-label="پس از تخفیف (ریال)" class="num fw-500"><span class="order-line-value">@l.AfterDiscount.Money()</span></td>
                                <td data-label="ارزش افزوده (٪ یا ریال)">
                                    <div class="input-group input-group-sm order-line-rate">
                                        <input class="form-control form-control-sm text-center num order-line-control" aria-label="ارزش افزوده درصد یا ریال" data-order-last-field
                                               value="@l.VatText" @oninput="@(e => l.VatText = FormatNum(e.Value))" maxlength="24"
                                               placeholder="0" inputmode="decimal" dir="ltr" />
                                        <span class="input-group-text order-line-unit" title="@(l.VatValue > 100 ? "مبلغ ریالی" : "درصد")">@(l.VatValue > 100 ? "ریال" : "٪")</span>
                                    </div>
                                    <div class="fs-9 mt-1 text-primary num order-line-sub">@l.VatAmount.Money() ریال</div>
                                </td>
                                <td data-label="کل پس از ارزش افزوده (ریال)" class="num fw-700"><span class="order-line-value">@l.Total.Money()</span></td>
                                @if (Type == TransactionType.Sale)
                                {
                                    @if (CanSeeProfit)
                                    {
                                        <td data-label="سود" class="num">
                                            @{ var profit = LineProfit(l); }
                                            <div class="order-line-value">
                                                @if (l.ProductId > 0 && l.Qty > 0)
                                                {
                                                    <span dir="ltr" class="fw-500 @(profit >= 0 ? "text-success" : "text-danger")">@profit.Money()</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                    @if (referrerId > 0)
                                    {
                                        <td data-label="پورسانت" class="num">
                                            <div class="order-line-value">
                                                @if (l.ProductId > 0 && l.Qty > 0)
                                                {
                                                    <span class="text-primary">@LineCommission(l).Money()</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </div>
                                        </td>
                                    }
                                }
                                <td class="text-nowrap">
                                    <div class="order-line-actions">
                                        @if (Type == TransactionType.Sale && l.ProductId > 0 && !IsServiceProduct(l.ProductId))
                                        {
                                            <button class="btn btn-sm btn-light" tabindex="-1" title="آخرین فاکتور خرید این کالا" aria-label="آخرین فاکتور خرید این کالا" @onclick="() => ShowLastPurchase(l.ProductId)">
                                                <i class="bi bi-receipt text-primary"></i>
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-light" tabindex="-1" title="حذف سطر" aria-label="حذف سطر" @onclick="() => RemoveLine(l)">
                                            <i class="bi bi-x-lg text-danger"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    @if (!UseInvoiceWizard)
                    {
                    <tfoot class="border-top-2 table-light" style="border-top: 2px solid #cbd5e1;">
                        <tr class="align-middle">
                            <td class="fw-bold text-secondary">
                                <span class="badge bg-secondary-subtle text-secondary-emphasis px-2 py-1 fs-8">جمع اقلام فاکتور</span>
                                <span class="fs-8 text-muted ms-1">(@lines.Count.Num() سطر)</span>
                            </td>
                            <td class="text-center fw-600 num fs-8 text-muted">
                                @lines.Sum(l => l.Qty).ToString("0.##")
                            </td>
                            @* ناخالص زیر ستون قیمت واحد *@
                            <td class="text-center p-2">
                                <div class="fs-9 text-muted mb-1">جمع ناخالص:</div>
                                <div class="fw-bold fs-7 num text-dark">@totalGross.Money()</div>
                                <small class="fs-9 text-muted">ریال</small>
                            </td>
                            @* تخفیف کل اقلام زیر ستون تخفیف *@
                            <td class="text-center p-2">
                                <div class="fs-9 text-muted mb-1">تخفیف کل اقلام:</div>
                                <div class="fw-bold fs-7 num @(totalLineDiscount > 0 ? "text-danger" : "text-muted")">
                                    @(totalLineDiscount > 0 ? $"- {totalLineDiscount.Money()}" : "۰")
                                </div>
                                <small class="fs-9 text-muted">ریال</small>
                            </td>
                            @* مبلغ نهایی فاکتور زیر ستون مبلغ کل *@
                            <td class="text-start p-2">
                                <div class="fs-9 text-muted mb-1">مبلغ نهایی فاکتور:</div>
                                <div class="fw-900 fs-5 text-primary num" style="letter-spacing:-0.5px;">@grandTotal.Money()</div>
                                <small class="fs-9 text-muted">ریال</small>
                            </td>
                            @if (Type == TransactionType.Sale)
                            {
                                @if (CanSeeProfit)
                                {
                                    <td class="text-start p-2">
                                        <div class="fs-9 text-muted mb-1">سود کل:</div>
                                        <div class="fw-bold fs-7 num @(totalProfit >= 0 ? "text-success" : "text-danger")">@totalProfit.Money()</div>
                                    </td>
                                }
                                @if (referrerId > 0)
                                {
                                    <td class="text-start p-2">
                                        <div class="fs-9 text-muted mb-1">پورسانت:</div>
                                        <div class="fw-bold fs-7 num text-primary">@totalCommission.Money()</div>
                                    </td>
                                }
                            }
                            <td></td>
                        </tr>
                    </tfoot>
                    }
                </table>
            </div>
            @if (UseInvoiceWizard)
            {

                <div class="purchase-totals-wrap">
                    <div class="purchase-totals">
                        @if (Type == TransactionType.Sale)
                        {
                            <div><span>جمع مقدار اقلام</span><strong class="num">@TotalLines.Sum(l => l.Qty).ToString("0.##")</strong></div>
                        }
                        <div><span>جمع ناخالص</span><strong class="num">@totalGross.Money() <small>ریال</small></strong></div>
                        <div><span>تخفیف اقلام</span><strong class="num">@totalLineDiscount.Money() <small>ریال</small></strong></div>
                        <div><span>مبلغ پس از تخفیف</span><strong class="num">@TotalLines.Sum(l => l.AfterDiscount).Money() <small>ریال</small></strong></div>
                        <div><span>ارزش افزوده</span><strong class="num">@TotalLines.Sum(l => l.VatAmount).Money() <small>ریال</small></strong></div>
                        <div class="purchase-totals-final"><span>مبلغ نهایی پس از ارزش افزوده</span><strong class="num">@goodsTotal.Money() <small>ریال</small></strong></div>
                    </div>
                </div>
            }
            }

            @if (Type == TransactionType.Sale && invoiceStep == 1 && (CanSeeProfit || referrerId > 0))
            {
                <div class="d-flex flex-wrap justify-content-end align-items-center gap-3 mt-2 p-2 px-3 rounded-3 border bg-light fs-8">
                    @if (CanSeeProfit)
                    {
                        <div>
                            <span class="text-muted ms-1">سود تخمینی:</span>
                            <span class="fw-700 num @(totalProfit >= 0 ? "text-success" : "text-danger")">@totalProfit.Money()</span> ریال
                        </div>
                    }
                    @if (referrerId > 0)
                    {
                        <div>
                            <span class="text-muted ms-1">پورسانت معرف:</span>
                            <span class="fw-700 num text-primary">@totalCommission.Money()</span> ریال
                        </div>
                        @if (CanSeeProfit)
                        {
                            <div>
                                <span class="text-muted ms-1">سود خالص:</span>
                                <span class="fw-700 num @(netProfit >= 0 ? "text-success" : "text-danger")">@netProfit.Money()</span> ریال
                            </div>
                        }
                    }
                </div>
            }
        }
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-light" @onclick="Cancel">انصراف (Esc)</button>
        @if (!loading && UseInvoiceWizard && invoiceStep == 1)
        {
            <button type="button" class="btn btn-primary me-auto" data-hotkey="f1" data-order-shortcut="next" title="میانبر: F1" @onclick="GoToPayment" disabled="@saving">
                ادامه و انتخاب روش پرداخت (F1) <i class="bi bi-arrow-left me-1"></i>
            </button>
        }
        else if (!loading)
        {
            @if (UseInvoiceWizard)
            {
                <button type="button" class="btn btn-outline-secondary" data-hotkey="f3" title="میانبر: F3" @onclick="BackToInvoice" disabled="@saving"><i class="bi bi-arrow-right"></i> @(Type == TransactionType.Sale ? "بازگشت به اطلاعات فروش" : "بازگشت به اطلاعات خرید") (F3)</button>
            }
            <button type="button" class="btn btn-outline-primary" data-hotkey="f4" title="میانبر: F4" @onclick="SaveAndPrint" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                <i class="bi bi-printer"></i> @(IsEdit ? "ذخیره و چاپ" : "ثبت و چاپ") (F4)
            </button>
            <button type="button" class="btn btn-primary me-auto" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                <i class="bi bi-check2"></i> @(IsEdit ? "ذخیره تغییرات (F1)" : Type == TransactionType.Purchase ? "ثبت فاکتور خرید (F1)" : "ثبت فاکتور فروش (F1)")
            </button>
        }
    </Footer>
</Modal>

@if (lastPurchase is not null || lastPurchaseLoading)
{
    <Modal Visible="true" Title="آخرین فاکتور خرید" Size="modal-lg" OnClose="CloseLastPurchase">
        <ChildContent>
            @if (lastPurchaseLoading)
            {
                <div class="text-center py-4"><div class="spinner-border text-primary" role="status"></div></div>
            }
            else if (lastPurchase is not null)
            {
                <div class="d-flex flex-wrap gap-3 mb-3">
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">شماره سند</div>
                        <div class="fw-700 text-primary doc-number">@lastPurchase.Number</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">تاریخ</div>
                        <div class="fw-500">@lastPurchase.Date.ToFa()</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">تأمین‌کننده</div>
                        <div class="fw-500">@lastPurchase.PartyName</div>
                    </div>
                    <div class="flex-grow-1">
                        <div class="fs-8 text-muted">انبار</div>
                        <div class="fw-500">@lastPurchase.WarehouseName</div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>کالا</th>
                                <th class="text-start">مقدار</th>
                                <th class="text-start">قیمت خرید</th>
                                <th class="text-start">جمع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var l in lastPurchase.Lines)
                            {
                                <tr class="@(l.ProductId == lastPurchaseProductId ? "table-warning" : "")">
                                    <td>
                                        @l.ProductName
                                        @if (l.ProductId == lastPurchaseProductId)
                                        {
                                            <i class="bi bi-arrow-right-short text-primary"></i>
                                        }
                                    </td>
                                    <td class="text-start num">@l.Quantity.Num()</td>
                                    <td class="text-start num fw-700">@l.Price.Money()</td>
                                    <td class="text-start num">@l.Total.Money()</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <span class="text-muted ms-2">مبلغ کل:</span>
                    <span class="fw-800 fs-6 text-primary num">@lastPurchase.TotalAmount.Money()</span>
                    <span class="fs-8 text-muted">ریال</span>
                </div>
            }
        </ChildContent>
        <Footer>
            <button class="btn btn-light" @onclick="CloseLastPurchase">بستن (Esc)</button>
        </Footer>
    </Modal>
}

<Modal Visible="showSaleChequeCharge" Title="محاسبه تاخیر تادیه چک" OnClose="() => showSaleChequeCharge = false">
    <ChildContent>
        <div class="row g-2">
            <div class="col-md-6"><label class="form-label">مبنای ماشین‌حساب اولیه (ریال)</label>
                <input class="form-control num" value="@chargeBaseText" @oninput="@(e => chargeBaseText = Fa.FormatTyping(e.Value?.ToString()))" inputmode="numeric" dir="ltr" /></div>
            <div class="col-md-6"><label class="form-label">درصد سود ماهانه اولیه</label>
                <input class="form-control num" @bind="chargeRateText" inputmode="decimal" dir="ltr" /></div>
            <div class="col-md-4"><label class="form-label">تعداد ماه</label>
                <input class="form-control num" type="number" min="1" max="60" @bind="chargeMonths" dir="ltr" /></div>
            <div class="col-md-4"><label class="form-label">درصد تعدیل سررسید</label>
                <input class="form-control num" @bind="chargeAdjustmentRateText" inputmode="decimal" dir="ltr" /></div>
            <div class="col-md-4"><label class="form-label">بازه تعدیل (روز)</label>
                <input class="form-control num" type="number" min="1" @bind="chargeAdjustmentDays" dir="ltr" /></div>
            <div class="col-12 fs-8 text-muted">پس از تأیید، مبلغ سود به فاکتور اضافه می‌شود؛ مبلغ چک‌ها خودکار تغییر نمی‌کند.</div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => showSaleChequeCharge = false">انصراف</button>
        <button type="button" class="btn btn-primary" data-hotkey="f1" @onclick="ApplySaleChequeCharge">تأیید سود (F1)</button>
    </Footer>
</Modal>

<Modal Visible="showCalc" Title="@(calcForCheque ? "محاسبه اقساطِ چک با سود" : "محاسبه اقساط با سود")" OnClose="() => showCalc = false">
    <ChildContent>
        <div class="row g-3" data-order-calculator="@formKey">
            <div class="col-md-6">
                <label class="form-label">مبلغ پایه (ریال)</label>
                <input class="form-control num" value="@calcBaseText"
                       @oninput="@(e => calcBaseText = Fa.FormatTyping(e.Value?.ToString()))" inputmode="numeric" dir="ltr" />
                <div class="fs-8 text-muted mt-1">پیش‌فرض: باقیماندهٔ سند پس از کسر نقد و سطرهای قبلی (@(Math.Max(0, calcForCheque ? grandTotal - CashPart - InstSum() : grandTotal - CashPart - ChequeSum()).Money()) ریال)</div>
            </div>
            <div class="col-md-6">
                <label class="form-label">درصد سود ماهانه</label>
                <div class="input-group">
                    <input class="form-control num" value="@calcRateText"
                           @oninput="@(e => calcRateText = e.Value?.ToString() ?? "")" inputmode="decimal" dir="ltr" />
                    <span class="input-group-text">٪ در ماه</span>
                </div>
            </div>
            <div class="col-md-4">
                <label class="form-label">تعداد ماه (قسط)</label>
                <input class="form-control num" @bind="calcMonths" type="number" min="1" max="60" dir="ltr" />
            </div>
            <div class="col-md-4">
                <label class="form-label">تاریخ شروع (اولین سررسید)</label>
                <DatePicker @bind-Value="calcStart" OpenOnFocus="UseInvoiceWizard" />
            </div>
            <div class="col-md-4">
                <label class="form-label">فاصله هر @(calcForCheque ? "چک" : "قسط")</label>
                <div class="input-group">
                    <input class="form-control num" @bind="calcIntervalDays" type="number" min="1" dir="ltr" />
                    <span class="input-group-text">روز</span>
                </div>
            </div>

            @if (CalcBase > 0 && calcMonths > 0)
            {
                <div class="col-12">
                    <div class="calc-preview">
                        <div class="d-flex flex-wrap gap-3 justify-content-between">
                            <div><div class="fs-8 text-muted">مبلغ پایه</div><div class="num fw-700">@CalcBase.Money()</div></div>
                            <div><div class="fs-8 text-muted">سود کل (@CalcRate.Num()٪ × @calcMonths.Num() ماه)</div><div class="num fw-700 text-warning">@CalcInterest.Money()</div></div>
                            <div><div class="fs-8 text-muted">مبلغ نهایی</div><div class="num fw-800 text-primary">@CalcTotal.Money()</div></div>
                            <div><div class="fs-8 text-muted">مبلغ هر @(calcForCheque ? "چک" : "قسط")</div><div class="num fw-800 text-success">@CalcPerMonth.Money()</div></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showCalc = false">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" @onclick="ApplyCalc" disabled="@(CalcBase <= 0 || calcMonths < 1 || !calcStart.HasValue)">
            <i class="bi bi-check2-circle"></i> ساخت ردیف‌ها (F1)
        </button>
    </Footer>
</Modal>



<Modal Visible="showChequeBank" Title="افزودن بانک" Size="modal-sm" OnClose="CloseChequeBank">
    <ChildContent>
        <div data-order-child="@formKey">
            <label class="form-label" for="chequeBankName">نام بانک <span class="text-danger">*</span></label>
            <input id="chequeBankName" class="form-control" @bind="newChequeBankName" @bind:event="oninput" placeholder="نام بانک را وارد کنید" />
            @if (Type == TransactionType.Purchase)
            {
                <div class="form-text">برای انتخاب در چک پرداختی، یک حساب بانکی ساده با همین نام ساخته می‌شود.</div>
            }
            else
            {
                <div class="form-text">نام بانک در همین مرورگر برای انتخاب‌های بعدی نگهداری می‌شود.</div>
            }
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="CloseChequeBank" disabled="@savingChequeBank">انصراف (Esc)</button>
        <button type="button" class="btn btn-primary" data-hotkey="f1" @onclick="SaveChequeBank" disabled="@(savingChequeBank || string.IsNullOrWhiteSpace(newChequeBankName))">افزودن بانک (F1)</button>
    </Footer>
</Modal>

<QuickBankModal InvoiceFormKey="@(UseInvoiceWizard ? formKey : null)" @bind-Visible="showQuickBank"
                DefaultKind="quickBankDefaultKind"
                OnAccountCreated="OnQuickBankCreated" />


@* فرم سریع ایجاد مشتری / تأمین‌کننده و انتخاب خودکار در سند *@
<PartyFormModal InvoiceFormKey="@(UseInvoiceWizard ? formKey : null)" Visible="showNewPartyModal"
                Type="@(Type == TransactionType.Sale ? PartyType.Customer : PartyType.Supplier)"
                AllowReferrerPicker="@(Type == TransactionType.Sale)"
                OnSaved="OnQuickPartyCreated"
                OnCancel="() => showNewPartyModal = false" />

@code {
    private bool showNewPartyModal;

    private void OpenQuickParty()
    {
        showNewPartyModal = true;
        if (UseInvoiceWizard) pendingSectionFocus = "[data-order-child]";
    }

    private async Task OnQuickPartyCreated(Party newParty)
    {
        showNewPartyModal = false;
        try
        {
            if (Type == TransactionType.Sale)
            {
                customers = await PartySvc.GetAsync(PartyType.Customer);
                partyLookup = customers.Where(c => c.IsActive)
                    .Select(c => new LookupItem
                    {
                        Id = c.Id,
                        Name = string.IsNullOrWhiteSpace(c.ReferrerName)
                            ? $"{c.Name} — بدون معرف"
                            : $"{c.Name} — معرف: {c.ReferrerName}"
                    }).ToList();
            }
            else
            {
                partyLookup = await PartySvc.GetLookupsAsync(PartyType.Supplier, activeOnly: true);
            }

            // انتخاب خودکار طرف حساب جدید در کمبوباکس
            activePartyIds.Add(newParty.Id);
            OnPartyChanged(newParty.Id);
            InvoiceSuccess($"{(Type == TransactionType.Sale ? "مشتری" : "تأمین‌کننده")} «{newParty.Name}» افزوده و انتخاب شد.");
        }
        catch (Exception ex)
        {
            InvoiceError(ex.Message);
        }
    }

    /// <summary>مجوز مؤثر سمت سرور؛ claim ذخیره‌شده در مرورگر ممکن است قدیمی باشد.</summary>
    private bool canSeeProfit;
    private bool CanSeeProfit => canSeeProfit;

    [Parameter] public TransactionType Type { get; set; } = TransactionType.Sale;
    [Parameter] public EventCallback OnSaved { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }

    /// <summary>سند در حال ویرایش (null = سند جدید).</summary>
    [Parameter] public Order? EditOrder { get; set; }

    /// <summary>مشخصات تجاری مجاز برای ایجاد فاکتور تازه، بدون شناسه یا اطلاعات تسویهٔ سند قبلی.</summary>
    [Parameter] public InvoiceCopyTemplate? CopyTemplate { get; set; }

    private bool IsEdit => EditOrder is not null;

    private string FormTitle => IsEdit
        ? (Type == TransactionType.Sale ? $"ویرایش فاکتور فروش {EditOrder!.Number}" : $"ویرایش فاکتور خرید {EditOrder!.Number}")
        : (Type == TransactionType.Sale ? "صدور فاکتور فروش" : "ثبت فاکتور خرید");

    private class LineVm
    {
        public Guid Key { get; } = Guid.NewGuid();
        public int Id { get; set; }
        public int ProductId { get; set; }
        public decimal? OriginalQty { get; set; }
        public string QtyText { get; set; } = "1";
        public string PriceText { get; set; } = "";
        public string Unit { get; set; } = "";
        public string DiscountText { get; set; } = "";
        public decimal DiscountPercent { get; set; }
        public decimal DiscountAmount { get; set; }
        public bool DiscountIsAmount { get; set; }
        public decimal Qty => Fa.ParseDecimal(QtyText);
        public decimal Price => Fa.ParseDecimal(PriceText);
        public decimal Gross => OrderLineAmounts.Gross(Qty, Price);
        public string VatText { get; set; } = "";
        public decimal VatValue => Math.Max(0, Fa.ParseDecimal(VatText));
        public decimal AfterDiscount => Math.Max(0, Gross - DiscountAmount);
        public decimal VatAmount => OrderLineAmounts.Vat(AfterDiscount, VatValue);
        public decimal Total => AfterDiscount + VatAmount;
    }

    private List<LineVm> lines = new() { new LineVm() };
    private List<LookupItem> productLookup = new();
    private List<LookupItem> whLookup = new();
    private List<LookupItem> partyLookup = new();
    private List<Product> products = new();
    private HashSet<int> activeWarehouseIds = new(), activePartyIds = new();
    private readonly InvoiceWarehouseStock warehouseStock = new();
    private int warehouseId, partyId, referrerId;
    private DateTime? date;
    private string description = "";
    private bool loading = true, saving;
    private string? formError;
    private string? cashTrackingNumber;
    private void ShowFormError(string message) => formError = message;
    private void InvoiceSuccess(string message) => Toast.ShowAtTopRight(message, "success");
    private void InvoiceError(string message) => Toast.ShowAtTopRight(message, "error");
    private void InvoiceInfo(string message) => Toast.ShowAtTopRight(message, "info");
    private int invoiceStep = 1;
    private readonly string formKey = Guid.NewGuid().ToString("N");
    private bool invoiceInitialFocusDone;
    private string? pendingSectionFocus;
    private bool UseInvoiceWizard => Type is TransactionType.Purchase or TransactionType.Sale;

    // خلاصه و پرداخت فقط سطرهایی را شامل می‌شوند که واقعاً ذخیره خواهند شد.
    private IEnumerable<LineVm> TotalLines => UseInvoiceWizard
        ? lines.Where(l => l.ProductId > 0 && l.Qty > 0)
        : lines;
    private decimal goodsTotal => TotalLines.Sum(l => l.Total);
    private decimal grandTotal => goodsTotal + saleChequeIncome;

    // Sale rows can show both the last-purchase and delete buttons. In the fixed-layout
    // table the percentage columns share the space left by this fixed-width action column.
    // The eight base sale weights in the colgroup add up to SaleBaseColumnWeight.
    private const decimal SaleActionsColumnRem = 4.5m;
    private const int SaleBaseColumnWeight = 95;
    private const int SaleExtraColumnWeight = 11;
    private string InvoiceActionsColumnWidth => Type == TransactionType.Sale
        ? SaleActionsColumnRem.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture) + "rem"
        : InvoiceColumnWidth(5);

    private string InvoiceColumnWidth(int purchaseWeight, int? saleWeight = null)
    {
        if (Type != TransactionType.Sale)
            return purchaseWeight.ToString(System.Globalization.CultureInfo.InvariantCulture) + "%";

        var extraColumns = (CanSeeProfit ? 1 : 0) + (referrerId > 0 ? 1 : 0);
        var totalWeight = SaleBaseColumnWeight + SaleExtraColumnWeight * extraColumns;
        var weight = saleWeight ?? purchaseWeight;
        return (100m * weight / totalWeight).ToString("0.######", System.Globalization.CultureInfo.InvariantCulture) + "%";
    }


    // ---------------- پرداخت ترکیبی (فروش و خرید) ----------------
    // هر جزء مستقل فعال/غیرفعال می‌شود؛ باقی‌ماندهٔ هر سطر = مبلغ سند − (نقد + سطرهای قبلی)
    private bool useCash = true, useCheque, useInstallment, useCredit;
    private string cashTypeStr = "0";
    private DateTime? creditDue;

    private CashType CashKind => int.TryParse(cashTypeStr, out var v) ? (CashType)v : CashType.Cash;
    private bool HasNonCash => useCheque || useInstallment || useCredit;

    // حساب بانکی یا صندوق انتخابی
    private List<TrsAccount> bankAccounts = new();
    private int? trsAccountId;
    private bool showQuickBank;
    private TreasuryAccountKind quickBankDefaultKind = TreasuryAccountKind.Bank;
    private bool showChequeBank, savingChequeBank;
    private int? chequeBankIndex;
    private string newChequeBankName = "";
    private List<string> customChequeBanks = new();
    private static readonly string[] PopularChequeBanks = { "بانک ملت", "بانک ملی", "بانک صادرات", "بانک تجارت", "بانک سپه", "بانک سامان", "بانک پاسارگاد", "بانک پارسیان", "بانک رسالت", "بانک مهر ایران", "بانک کشاورزی", "بانک مسکن", "بانک رفاه", "بانک آینده", "بانک شهر" };
    private List<string> ChequeBankNames => PopularChequeBanks.Concat(customChequeBanks).Concat(bankAccounts.Where(a => !string.IsNullOrWhiteSpace(a.BankName)).Select(a => a.BankName!)).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
    private List<LookupItem> CashTypeLookup => new() { new() { Id = 1, Name = "وجه نقد" }, new() { Id = 2, Name = "کارت‌خوان (POS)" }, new() { Id = 3, Name = "کارت به کارت" } };
    private List<LookupItem> CashAccountLookup => AccountsForCashType(CashKind).Select(a => new LookupItem { Id = a.Id, Name = a.DisplayName }).ToList();
    private List<LookupItem> ChequeAccountLookup => bankAccounts.Where(a => a.Kind == TreasuryAccountKind.Bank).Select(a => new LookupItem { Id = a.Id, Name = a.DisplayName }).ToList();
    private void OnCashTypePicked(int id) { cashTypeStr = Math.Max(0, id - 1).ToString(); OnCashTypeChanged(CashKind); }
    private void OnCashAccountPicked(int id) => trsAccountId = id > 0 ? id : null;
    private void OnChequeAccountPicked(int index, int id) => OnChequeAccountChanged(index, new ChangeEventArgs { Value = id });

    private void OpenChequeBank(int index)
    {
        chequeBankIndex = index;
        newChequeBankName = "";
        showChequeBank = true;
        if (UseInvoiceWizard) pendingSectionFocus = "[data-order-child]";
    }
    private void CloseChequeBank() => showChequeBank = false;
    private async Task SaveChequeBank()
    {
        var name = newChequeBankName.Trim();
        if (savingChequeBank || string.IsNullOrWhiteSpace(name) || chequeBankIndex is not int index || index >= cheques.Count) return;
        savingChequeBank = true;
        try
        {
            if (Type == TransactionType.Purchase)
            {
                var account = await AccountSvc.SaveAsync(new TrsAccount { Kind = TreasuryAccountKind.Bank, Name = name, BankName = name, IsActive = true });
                bankAccounts.Add(account);
                cheques[index].TrsAccountId = account.Id;
                cheques[index].BankName = account.BankName ?? name;
            }
            else
            {
                var updated = customChequeBanks.Append(name).Distinct(StringComparer.OrdinalIgnoreCase).ToList();
                await JS.InvokeVoidAsync("localStorage.setItem", "invoiceCheque.customBanks", System.Text.Json.JsonSerializer.Serialize(updated));
                customChequeBanks = updated;
                cheques[index].BankName = name;
            }
            showChequeBank = false;
        }
        catch (Exception ex) { InvoiceError("ثبت بانک انجام نشد: " + ex.Message); }
        finally { savingChequeBank = false; }
    }


    private List<TrsAccount> AccountsForCashType(CashType ct) => ct switch
    {
        CashType.Cash => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Cash or TreasuryAccountKind.PettyCash).ToList(),
        CashType.CardReader => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Pos or TreasuryAccountKind.Bank).ToList(),
        CashType.CardTransfer => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Bank or TreasuryAccountKind.Pos).ToList(),
        _ => bankAccounts
    };

    /// <summary>تغییر نوع دریافت نقدی: اگر حساب انتخابی با نوع جدید سازگار نباشد، حساب پیش‌فرض جایگزین می‌شود.</summary>
    private void OnCashTypeChanged(CashType ct)
    {
        cashTypeStr = ((int)ct).ToString();
        var validAccounts = AccountsForCashType(ct);
        if (trsAccountId.HasValue && !validAccounts.Any(a => a.Id == trsAccountId.Value))
        {
            trsAccountId = validAccounts.FirstOrDefault(a => a.IsDefault)?.Id ?? validAccounts.FirstOrDefault()?.Id;
        }
    }

    private void OnChequeAccountChanged(int index, ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id) && id > 0)
        {
            cheques[index].TrsAccountId = id;
            var acc = bankAccounts.FirstOrDefault(a => a.Id == id);
            cheques[index].BankName = acc?.BankName ?? acc?.Name ?? "";
        }
        else
        {
            cheques[index].TrsAccountId = null;
        }
    }

    private void OpenQuickBank(TreasuryAccountKind defaultKind = TreasuryAccountKind.Bank)
    {
        quickBankDefaultKind = defaultKind;
        showQuickBank = true;
        if (UseInvoiceWizard) pendingSectionFocus = "[data-order-child]";
    }

    private void OnQuickBankCreated(TrsAccount newAcc)
    {
        if (!bankAccounts.Any(a => a.Id == newAcc.Id))
        {
            bankAccounts.Add(newAcc);
        }

        trsAccountId = newAcc.Id;
        StateHasChanged();
    }

    // ---------------- پرداخت ترکیبی: نقد + چک + اقساط + نسیه ----------------
    private string cashAmountText = "";

    /// <summary>جزء نقدی: اگر تنها جزء فعال باشد تمام مبلغ سند است، وگرنه مبلغی که کاربر وارد می‌کند.</summary>
    private decimal CashPart => UseInvoiceWizard && !useCash
        ? 0m
        : !HasNonCash ? grandTotal : Fa.ParseDecimal(cashAmountText);

    /// <summary>باقی‌ماندهٔ نهایی (می‌تواند منفی باشد = مازاد/سود مدت‌دار).</summary>
    private decimal FinalRemaining => grandTotal - CashPart - ChequeSum() - InstSum();

    private decimal RemainingAfterCash => grandTotal - CashPart;

    /// <summary>باقی‌مانده پس از این چک = مبلغ سند − (نقد + جمع چک‌های این سطر تا سطر جاری).</summary>
    private decimal RemainingAfterCheque(int i)
    {
        if (cheques.Count == 0) return RemainingAfterCash;
        var upto = Math.Min(i, chequeAmounts.Count - 1);
        decimal s = CashPart;
        for (var k = 0; k <= upto; k++) s += Fa.ParseDecimal(chequeAmounts[k]);
        return grandTotal - s;
    }

    /// <summary>باقی‌مانده پس از این قسط = مبلغ سند − (نقد + چک‌ها + جمع اقساط این سطر تا سطر جاری).</summary>
    private decimal RemainingAfterInstallment(int i)
    {
        if (installments.Count == 0) return RemainingAfterCash - ChequeSum();
        var upto = Math.Min(i, instAmounts.Count - 1);
        decimal s = CashPart + ChequeSum();
        for (var k = 0; k <= upto; k++) s += Fa.ParseDecimal(instAmounts[k]);
        return grandTotal - s;
    }

    private void OnCashAmountInput(ChangeEventArgs e)
        => cashAmountText = Fa.FormatTyping(e.Value?.ToString());

    private void OnChequeAmountInput(int i, ChangeEventArgs e)
        => chequeAmounts[i] = Fa.FormatTyping(e.Value?.ToString());

    private void OnInstAmountInput(int i, ChangeEventArgs e)
        => instAmounts[i] = Fa.FormatTyping(e.Value?.ToString());

    // ---------------- فعال/غیرفعال کردن اجزای پرداخت ----------------
    private void ToggleCash()
    {
        useCash = !useCash;
        if (!useCash && !HasNonCash) useCash = true; // حداقل یک جزء باید بماند
        if (useCash && UseInvoiceWizard) pendingSectionFocus = "[data-pay-cash-box]";
    }

    private void ToggleCheque()
    {
        useCheque = !useCheque;
        EnsureInvoicePaymentMethod();
        if (useCheque && cheques.Count == 0) AddCheque();
        if (useCheque && UseInvoiceWizard) pendingSectionFocus = "[data-pay-cheque-box]";
    }

    private void ToggleInstallment()
    {
        useInstallment = !useInstallment;
        EnsureInvoicePaymentMethod();
        if (useInstallment && installments.Count == 0) BuildInstallments(silent: true);
        if (useInstallment && UseInvoiceWizard) pendingSectionFocus = "[data-pay-inst-box]";
    }

    private void ToggleCredit()
    {
        useCredit = !useCredit;
        EnsureInvoicePaymentMethod();
        if (useCredit && !creditDue.HasValue) creditDue = DateTime.Now.AddMonths(1);
        if (useCredit && UseInvoiceWizard) pendingSectionFocus = "[data-pay-credit-box]";
    }

    // اگر آخرین جزء غیرفعال شد، سند به پرداخت نقدی برمی‌گردد.
    private void EnsureInvoicePaymentMethod()
    {
        if (UseInvoiceWizard && !useCash && !HasNonCash) useCash = true;
    }

    /// <summary>روش پرداخت اعلامی به سرور (سرور خودش ترکیبی/تک‌جزء را از اجزا استخراج می‌کند).</summary>
    private PaymentMethod DeclaredMethod => !HasNonCash
        ? PaymentMethod.Cash
        : useCheque ? PaymentMethod.Cheque
        : useInstallment ? PaymentMethod.Installment
        : PaymentMethod.Credit;

    // ثبت آزمایشی ردیف مالی مستقل؛ هیچ چکی به‌طور خودکار بازنویسی نمی‌شود.
    private bool showSaleChequeCharge;
    private string chargeBaseText = "", chargeRateText = "", chargeAdjustmentRateText = "";
    private int chargeMonths = 1, chargeAdjustmentDays = 30;
    private SaleChequeChargeInput? saleChequeCharge;
    private decimal saleChequeIncome, chargeInvoiceBase;

    private void OpenSaleChequeCharge()
    {
        if (saleChequeCharge is null) chargeBaseText = Fa.FormatTyping(goodsTotal.ToString("0.##"));
        showSaleChequeCharge = true;
    }

    private void RemoveSaleChequeCharge()
    {
        saleChequeCharge = null;
        saleChequeIncome = 0;
        chargeInvoiceBase = 0;
    }

    private void ApplySaleChequeCharge()
    {
        var basis = Fa.ParseDecimal(chargeBaseText);
        var rate = Fa.ParseDecimal(chargeRateText);
        var adjustmentRate = Fa.ParseDecimal(chargeAdjustmentRateText);
        if (basis > goodsTotal || adjustmentRate < 0 || adjustmentRate > 999999999999.999999m ||
            decimal.Round(adjustmentRate, 6) != adjustmentRate || chargeAdjustmentDays <= 0)
        {
            InvoiceError("مبنا، نرخ یا بازه تعدیل سررسید معتبر نیست.");
            return;
        }
        decimal income;
        try { income = SaleChequeInitialCalculation.Calculate(basis, rate, chargeMonths); }
        catch (ArgumentOutOfRangeException) { InvoiceError("ورودی‌های ماشین‌حساب اولیه معتبر نیست."); return; }
        if (income <= 0) { InvoiceError("سود محاسبه‌شده باید بیشتر از صفر باشد."); return; }
        saleChequeCharge = new SaleChequeChargeInput
        {
            CalculatorBaseAmount = basis, CalculatorRatePercent = rate, CalculatorMonths = chargeMonths,
            AdjustmentRatePercent = adjustmentRate, AdjustmentPeriodDays = chargeAdjustmentDays
        };
        chargeInvoiceBase = goodsTotal;
        saleChequeIncome = income;
        showSaleChequeCharge = false;
    }

    // ---------------- ماشین‌حساب اقساط/چک با سود ----------------
    private bool showCalc, calcForCheque;
    private string calcBaseText = "", calcRateText = "";
    private int calcMonths = 3, calcIntervalDays = 30;
    private DateTime? calcStart;

    private decimal CalcBase => Fa.ParseDecimal(calcBaseText);
    private decimal CalcRate => Fa.ParseDecimal(calcRateText);
    /// <summary>سود ساده ماهانه: پایه × درصد × تعداد ماه</summary>
    private decimal CalcInterest => Math.Round(CalcBase * CalcRate / 100m * calcMonths, 0);
    private decimal CalcTotal => CalcBase + CalcInterest;
    private decimal CalcPerMonth => calcMonths > 0 ? Math.Floor(CalcTotal / calcMonths) : 0;

    private void OpenCalc(bool forCheque)
    {
        calcForCheque = forCheque;
        // پایهٔ محاسبه = باقی‌مانده پس از نقد و جزء «دیگر» (چک‌ها یا اقساط)
        var baseRemain = forCheque
            ? Math.Max(0, grandTotal - CashPart - InstSum())
            : Math.Max(0, grandTotal - CashPart - ChequeSum());
        calcBaseText = baseRemain > 0 ? Fa.FormatTyping(baseRemain.ToString("0")) : "";
        if (!calcStart.HasValue) calcStart = DateTime.Now.AddMonths(1); // پیش‌فرض: یک ماه بعد
        showCalc = true;
        if (UseInvoiceWizard) pendingSectionFocus = "[data-order-calculator]";
    }

    private void ApplyCalc()
    {
        if (CalcBase <= 0 || calcMonths < 1 || !calcStart.HasValue) return;

        var per = CalcPerMonth;
        var last = CalcTotal - per * (calcMonths - 1); // قسط آخر = مانده دقیق

        if (calcForCheque)
        {
            cheques.Clear(); chequeAmounts.Clear(); chequeDates.Clear();
            for (var i = 0; i < calcMonths; i++)
            {
                var amount = i == calcMonths - 1 ? last : per;
                cheques.Add(new ChequeDto());
                chequeAmounts.Add(Fa.FormatTyping(amount.ToString("0")));
                chequeDates.Add(calcStart.Value.AddDays((double)(i * calcIntervalDays)));
            }
            InvoiceSuccess($"{calcMonths} چک ساخته شد — مبلغ نهایی {CalcTotal.Money()} ریال (شامل {CalcInterest.Money()} سود). شماره و بانک هر چک را تکمیل کنید.");
        }
        else
        {
            installments.Clear(); instAmounts.Clear(); instDates.Clear();
            for (var i = 0; i < calcMonths; i++)
            {
                var amount = i == calcMonths - 1 ? last : per;
                installments.Add(new InstallmentDto { No = i + 1 });
                instAmounts.Add(Fa.FormatTyping(amount.ToString("0")));
                instDates.Add(calcStart.Value.AddDays((double)(i * calcIntervalDays)));
            }
            instCount = calcMonths;
            InvoiceSuccess($"دفترچه {calcMonths} قسطی ساخته شد — مبلغ نهایی {CalcTotal.Money()} ریال (شامل {CalcInterest.Money()} سود).");
        }
        showCalc = false;
    }

    private List<ChequeDto> cheques = new();
    private List<string> chequeAmounts = new();
    private List<DateTime?> chequeDates = new();

    private List<InstallmentDto> installments = new();
    private List<string> instAmounts = new();
    private List<DateTime?> instDates = new();
    private int instCount = 3;
    private int instIntervalDays = 30;
    private DateTime? instFirstDue = DateTime.Now.AddMonths(1); // پیش‌فرض: یک ماه بعد از امروز

    /// <summary>سطر چک جدید — مبلغ پیش‌فرض = باقی‌ماندهٔ فعلی سند (نقد + چک‌ها + اقساط کسر شده).</summary>
    private void AddCheque()
    {
        var rest = FinalRemaining;
        cheques.Add(new ChequeDto());
        chequeAmounts.Add(rest > 0 ? Fa.FormatTyping(rest.ToString("0")) : "");
        chequeDates.Add(null);
        if (UseInvoiceWizard) pendingSectionFocus = $"[data-cheque-row=\"{cheques.Count - 1}\"]";
    }

    private void RemoveCheque(int i)
    {
        cheques.RemoveAt(i); chequeAmounts.RemoveAt(i); chequeDates.RemoveAt(i);
    }

    /// <summary>جمع چک‌ها — اگر جزء چک غیرفعال باشد صفر (سطرهایش نگه داشته می‌شوند تا با فعال‌سازی برگردند).</summary>
    private decimal ChequeSum()
    {
        if (!useCheque) return 0;
        decimal s = 0;
        foreach (var a in chequeAmounts) s += Fa.ParseDecimal(a);
        return s;
    }

    private void BuildInstallments(bool silent = false)
    {
        if (instCount < 1) { if (!silent) InvoiceError("تعداد قسط را وارد کنید."); return; }
        if (!instFirstDue.HasValue) { if (!silent) InvoiceError("تاریخ اولین قسط را وارد کنید."); return; }

        // مبلغ قابل تقسیم = باقی‌مانده پس از نقد و چک‌ها (سطرهای قبلی)
        var totalDue = Math.Max(0, grandTotal - CashPart - ChequeSum());
        if (totalDue <= 0) { if (!silent) InvoiceError("ابتدا اقلام فاکتور را وارد کنید."); return; }

        installments.Clear(); instAmounts.Clear(); instDates.Clear();
        var baseAmount = Math.Floor(totalDue / instCount);
        for (var i = 0; i < instCount; i++)
        {
            var amount = i == instCount - 1 ? totalDue - baseAmount * (instCount - 1) : baseAmount;
            installments.Add(new InstallmentDto { No = i + 1 });
            instAmounts.Add(Fa.FormatTyping(amount.ToString("0")));
            instDates.Add(instFirstDue.Value.AddDays((double)(i * instIntervalDays)));
        }
        if (!silent && UseInvoiceWizard) pendingSectionFocus = "[data-inst-row=\"0\"]";
    }

    private void RemoveInstallment(int i)
    {
        installments.RemoveAt(i); instAmounts.RemoveAt(i); instDates.RemoveAt(i);
    }

    /// <summary>جمع اقساط — اگر جزء اقساط غیرفعال باشد صفر.</summary>
    private decimal InstSum()
    {
        if (!useInstallment) return 0;
        decimal s = 0;
        foreach (var a in instAmounts) s += Fa.ParseDecimal(a);
        return s;
    }
    private decimal totalProfit => lines.Where(l => l.ProductId > 0 && l.Qty > 0).Sum(LineProfit);
    private decimal totalCommission => lines.Where(l => l.ProductId > 0 && l.Qty > 0).Sum(LineCommission);
    private decimal netProfit => totalProfit - totalCommission;
    private List<Referrer> referrers = new();
    private List<Party> customers = new();

    /// <summary>با انتخاب مشتری، معرف او (در صورت وجود) خودکار تعیین می‌شود؛ بدون معرف = بدون پورسانت.</summary>
    private void OnPartyChanged(int v)
    {
        partyId = v;
        if (Type != TransactionType.Sale) return;
        var customer = customers.FirstOrDefault(c => c.Id == v);
        referrerId = customer?.ReferrerId is > 0 && referrers.Any(r => r.Id == customer.ReferrerId)
            ? customer.ReferrerId.Value
            : 0;
    }

    /// <summary>پورسانت تخمینی سطر: کالا = درصد × سود سطر (سود منفی=۰) | خدمات = درصد × مبلغ سطر.</summary>
    private decimal LineCommission(LineVm l)
    {
        if (referrerId <= 0) return 0;
        var r = referrers.FirstOrDefault(x => x.Id == referrerId);
        if (r is null) return 0;
        var p = products.FirstOrDefault(x => x.Id == l.ProductId);
        if (p is null) return 0;
        if (p.IsService) return decimal.Round(l.AfterDiscount * r.ServiceCommissionPercent / 100m, 2);
        var profit = LineProfit(l);
        return profit > 0 ? decimal.Round(profit * r.GoodsCommissionPercent / 100m, 2) : 0;
    }

