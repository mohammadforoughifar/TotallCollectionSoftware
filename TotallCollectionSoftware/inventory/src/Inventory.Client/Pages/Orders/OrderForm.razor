    }

    /// <summary>سود تخمینی سطر: (قیمت فروش − بهای تمام‌شده میانگین) × مقدار. خدمات = کل مبلغ.</summary>
    private decimal totalGross => TotalLines.Sum(l => l.Gross);
    private decimal totalLineDiscount => TotalLines.Sum(l => l.DiscountAmount);

    private decimal LineProfit(LineVm l)
    {
        var p = products.FirstOrDefault(x => x.Id == l.ProductId);
        if (p is null) return 0;
        if (p.IsService) return l.AfterDiscount;
        var cost = p.AvgCost > 0 ? p.AvgCost : p.PurchasePrice;
        return l.AfterDiscount - (cost * l.Qty);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Independent requests start together; existing/copy warehouse stock can also load immediately.
            if (IsEdit) warehouseId = EditOrder!.WarehouseId;
            else if (CopyTemplate is not null) warehouseId = CopyTemplate.WarehouseId;
            var profitTask = Type == TransactionType.Sale ? OrderSvc.CanViewProfitAsync() : Task.FromResult(false);
            var whTask = WarehouseSvc.GetLookupsAsync(activeOnly: true);
            var partyTask = Type == TransactionType.Sale ? null : PartySvc.GetLookupsAsync(PartyType.Supplier, activeOnly: true);
            var prodTask = ProductSvc.GetProductsAsync(pageSize: 10000);
            var bankTask = Type == TransactionType.Sale
                ? OrderSvc.GetActiveTreasuryAccountsAsync()
                : AccountSvc.GetAllAsync(activeOnly: true, withBalances: false);
            var referrerTask = Type == TransactionType.Sale ? ReferrerSvc.GetAllAsync(activeOnly: true) : null;
            var customerTask = Type == TransactionType.Sale ? PartySvc.GetAsync(PartyType.Customer) : null;
            var stockTask = LoadWarehouseStocksAsync();
            try
            {
                var savedBanks = await JS.InvokeAsync<string?>("localStorage.getItem", "invoiceCheque.customBanks");
                if (!string.IsNullOrWhiteSpace(savedBanks)) customChequeBanks = System.Text.Json.JsonSerializer.Deserialize<List<string>>(savedBanks) ?? new();
            }
            catch (Exception) { customChequeBanks = new(); }
            try { canSeeProfit = await profitTask; }
            catch { canSeeProfit = false; } // fail closed if the permission cannot be verified
            whLookup = await whTask;
            if (partyTask is not null) partyLookup = await partyTask;
            var prods = await prodTask;

            try
            {
                bankAccounts = await bankTask;
            }
            catch
            {
                bankAccounts = new();
            }

            // در خرید، خدمات قابل انتخاب نیست؛ در فروش همه (کالا + خدمات) قابل انتخاب‌اند
            products = prods.Items
                .Where(p => p.IsActive && (Type == TransactionType.Sale || !p.IsService))
                .ToList();
            await stockTask;
            RebuildProductLookup();
            if (warehouseId > 0 && !warehouseStock.IsLoaded)
                InvoiceError("دریافت موجودی انبار ناموفق بود؛ انبار را پاک و دوباره انتخاب کنید.");

            if (Type == TransactionType.Sale)
            {
                referrers = await referrerTask!;

                // فهرست مشتری‌ها با نمایش وضعیت معرف: «بدون معرف» یا نام معرف
                customers = await customerTask!;
                partyLookup = customers.Where(c => c.IsActive)
                    .Select(c => new LookupItem
                    {
                        Id = c.Id,
                        Name = string.IsNullOrWhiteSpace(c.ReferrerName)
                            ? $"{c.Name} — بدون معرف"
                            : $"{c.Name} — معرف: {c.ReferrerName}"
                    }).ToList();
            }

            activeWarehouseIds = whLookup.Select(w => w.Id).ToHashSet();
            activePartyIds = partyLookup.Select(p => p.Id).ToHashSet();

            if (IsEdit)
            {
                // پر کردن فرم از سند موجود
                var o = EditOrder!;
                warehouseId = o.WarehouseId;
                partyId = o.PartyId;
                referrerId = o.ReferrerId ?? 0;
                date = o.Date;
                description = o.Description;

                // بارگذاری اطلاعات پرداخت (خرید و فروش) — اجزای ترکیبی
                cashTrackingNumber = o.CashTrackingNumber;
                cashTypeStr = ((int)(o.CashType ?? CashType.Cash)).ToString();
                trsAccountId = o.TrsAccountId;
                creditDue = o.DueDate;
                useCheque = o.Cheques.Count > 0 || o.PaymentMethod == PaymentMethod.Cheque;
                useInstallment = o.Installments.Count > 0 || o.PaymentMethod == PaymentMethod.Installment;
                if (o.HasChequeCharge && o.ChequeChargeSnapshot is not null)
                {
                    saleChequeCharge = new SaleChequeChargeInput
                    {
                        CalculatorBaseAmount = o.ChequeChargeSnapshot.CalculatorBaseAmount,
                        CalculatorRatePercent = o.ChequeChargeSnapshot.CalculatorRatePercent,
                        CalculatorMonths = o.ChequeChargeSnapshot.CalculatorMonths,
                        AdjustmentRatePercent = o.ChequeChargeSnapshot.AdjustmentRatePercent,
                        AdjustmentPeriodDays = o.ChequeChargeSnapshot.AdjustmentPeriodDays,
                        ConfirmedCreditDueDate = o.ChequeChargeSnapshot.ConfirmedCreditDueDate
                    };
                    saleChequeIncome = o.ChequeIncomeAmount;
                    chargeInvoiceBase = o.GoodsAmount;
                    chargeBaseText = Fa.FormatTyping(saleChequeCharge.CalculatorBaseAmount.ToString("0.##"));
                    chargeRateText = saleChequeCharge.CalculatorRatePercent.ToString("0.######");
                    chargeMonths = saleChequeCharge.CalculatorMonths;
                    chargeAdjustmentRateText = saleChequeCharge.AdjustmentRatePercent.ToString("0.######");
                    chargeAdjustmentDays = saleChequeCharge.AdjustmentPeriodDays;
                }
                var loadedCash = o.PaymentMethod == PaymentMethod.Cash ? o.TotalAmount : o.CashAmount;
                useCash = loadedCash > 0 || (o.Cheques.Count == 0 && o.Installments.Count == 0 && o.PaymentMethod != PaymentMethod.Cheque && o.PaymentMethod != PaymentMethod.Installment);
                cashAmountText = loadedCash > 0 && (o.Cheques.Count > 0 || o.Installments.Count > 0 || o.PaymentMethod != PaymentMethod.Cash)
                    ? Fa.FormatTyping(loadedCash.ToString("0")) : "";
                var loadedCredit = o.TotalAmount - loadedCash - o.Cheques.Sum(c => c.Amount) - o.Installments.Sum(i => i.Amount);
                useCredit = loadedCredit > 1 || o.PaymentMethod == PaymentMethod.Credit;
                cheques = o.Cheques.Select(c => new ChequeDto
                {
                    Id = c.Id, Number = c.Number, TrsAccountId = c.TrsAccountId, BankName = c.BankName, AccountInfo = c.AccountInfo,
                    OwnerName = c.OwnerName, Amount = c.Amount, DueDate = c.DueDate, IsCleared = c.IsCleared,
                    ClearedAt = c.ClearedAt, Note = c.Note
                }).ToList();
                chequeAmounts = o.Cheques.Select(c => Fa.FormatTyping(c.Amount.ToString("0"))).ToList();
                chequeDates = o.Cheques.Select(c => (DateTime?)c.DueDate).ToList();
                installments = o.Installments.Select(i => new InstallmentDto
                {
                    Id = i.Id, No = i.No, Amount = i.Amount, DueDate = i.DueDate, IsPaid = i.IsPaid, PaidAt = i.PaidAt
                }).ToList();
                instAmounts = o.Installments.Select(i => Fa.FormatTyping(i.Amount.ToString("0"))).ToList();
                instDates = o.Installments.Select(i => (DateTime?)i.DueDate).ToList();
                instCount = Math.Max(1, installments.Count);
                lines = o.Lines.Select(l =>
                {
                    var vm = new LineVm
                    {
                        Id = l.Id,
                        ProductId = l.ProductId,
                        OriginalQty = l.Quantity,
                        QtyText = FormatQuantity(l.Quantity.ToString("0.###", System.Globalization.CultureInfo.InvariantCulture)),
                        PriceText = FormatNum(l.Price.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)),
                        Unit = l.Unit,
                        DiscountPercent = l.DiscountPercent,
                        DiscountAmount = l.DiscountAmount,
                        DiscountIsAmount = l.DiscountIsAmount,
                        VatText = FormatNum(l.VatValue.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))
                    };
                    if (vm.DiscountIsAmount)
                        vm.DiscountText = vm.DiscountAmount > 0 ? FormatNum(((long)vm.DiscountAmount).ToString()) : "";
                    else
                        vm.DiscountText = vm.DiscountPercent > 0 ? vm.DiscountPercent.ToString("0.##") : "";
                    RecalcDiscount(vm);
                    return vm;
                }).ToList();
                if (lines.Count == 0) lines.Add(new LineVm());

                // فیلتر کالاها بر اساس انبار سند
                RebuildProductLookup();

                // اگر انبار/طرف حساب/کالای سند غیرفعال شده، موقتاً به فهرست اضافه می‌شود تا انتخاب حفظ شود
                if (warehouseId > 0 && !whLookup.Any(w => w.Id == warehouseId))
                    whLookup.Add(new LookupItem { Id = warehouseId, Name = o.WarehouseName ?? $"انبار {warehouseId}" });
                if (partyId > 0 && !partyLookup.Any(p => p.Id == partyId))
                    partyLookup.Add(new LookupItem { Id = partyId, Name = o.PartyName ?? $"طرف حساب {partyId}" });
                foreach (var l in o.Lines.Where(l => !productLookup.Any(p => p.Id == l.ProductId)))
                    productLookup.Add(InvoiceProductOption.Create(l.ProductId, l.ProductName, l.Unit, IsServiceProduct(l.ProductId), warehouseStock));
            }
            else
            {
                date = DateTime.Now;
                var def = bankAccounts.FirstOrDefault(a => a.IsDefault) ?? bankAccounts.FirstOrDefault();
                if (def != null) trsAccountId = def.Id;

                if (CopyTemplate is { } copy && copy.Type == Type)
                {
                    warehouseId = copy.WarehouseId;
                    OnPartyChanged(copy.PartyId); // current customer/referrer, not the old commission snapshot
                    description = copy.Description;
                    lines = copy.Lines.Select(l =>
                    {
                        var vm = new LineVm
                        {
                            ProductId = l.ProductId,
                            QtyText = FormatQuantity(ExactDecimal(l.Quantity)),
                            PriceText = FormatNum(ExactDecimal(l.Price)),
                            Unit = l.Unit,
                            DiscountPercent = l.DiscountPercent,
                            DiscountAmount = l.DiscountAmount,
                            DiscountIsAmount = l.DiscountIsAmount,
                            VatText = FormatNum(ExactDecimal(l.VatValue))
                        };
                        RecalcDiscount(vm);
                        vm.DiscountText = vm.DiscountIsAmount
                            ? (vm.DiscountAmount > 0 ? FormatNum(ExactDecimal(vm.DiscountAmount)) : "")
                            : (vm.DiscountPercent > 0 ? ExactDecimal(vm.DiscountPercent) : "");
                        return vm;
                    }).ToList();
                    if (lines.Count == 0) lines.Add(new LineVm());

                    // Keep old names visible for review, but validation requires active selections on a new copy.
                    if (warehouseId > 0 && !whLookup.Any(w => w.Id == warehouseId))
                        whLookup.Add(new LookupItem { Id = warehouseId, Name = copy.WarehouseName ?? $"انبار {warehouseId}" });
                    if (partyId > 0 && !partyLookup.Any(p => p.Id == partyId))
                        partyLookup.Add(new LookupItem { Id = partyId, Name = copy.PartyName ?? $"طرف حساب {partyId}" });
                    foreach (var l in copy.Lines.Where(l => !productLookup.Any(p => p.Id == l.ProductId)))
                        productLookup.Add(InvoiceProductOption.Create(l.ProductId, l.ProductName, l.Unit, IsServiceProduct(l.ProductId), warehouseStock));
                }
            }
        }
        catch (Exception ex)
        {
            ShowFormError(ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private Task<bool> LoadWarehouseStocksAsync()
        => warehouseStock.LoadAsync(warehouseId, (id, page, size) =>
            OrderSvc.GetWarehouseStockAsync(id, page, size));

    // Use the same eligibility rule when selecting a product and when validating
    // a copy; the temporary old-name entry must not make an ineligible item valid.
    private bool IsProductSelectable(Product p)
    {
        if (warehouseId <= 0) return true;
        if (p.IsService) return Type == TransactionType.Sale;
        if (p.WarehouseId is > 0 && p.WarehouseId != warehouseId) return false;
        if (Type == TransactionType.Sale)
            return p.WarehouseId == warehouseId || warehouseStock.Quantities.ContainsKey(p.Id);
        return p.WarehouseId is null || p.WarehouseId == warehouseId;
    }

    /// <summary>بازسازی فهرست کالاها بر اساس انبار انتخاب‌شده و نمایش موجودی در منوی انتخاب.</summary>
    private void RebuildProductLookup()
    {
        var filtered = products.Where(IsProductSelectable);
        productLookup = filtered
            .Select(p => (LookupItem)InvoiceProductOption.Create(
                p.Id, p.IsService ? $"{p.Code} — {p.Name} (خدمات)" : $"{p.Code} — {p.Name}",
                p.Unit, p.IsService, warehouseStock))
            .ToList();

        // Keep existing line names visible while a new warehouse's stock is unknown;
        // these temporary entries do not change the eligibility rule used by validation.
        if (warehouseId > 0 && !warehouseStock.IsLoaded)
        {
            var visible = productLookup.Select(p => p.Id).ToHashSet();
            foreach (var line in lines.Where(l => l.ProductId > 0 && visible.Add(l.ProductId)))
            {
                var product = products.FirstOrDefault(p => p.Id == line.ProductId);
                var name = product is not null
                    ? $"{product.Code} — {product.Name}" + (product.IsService ? " (خدمات)" : "")
                    : EditOrder?.Lines.FirstOrDefault(l => l.ProductId == line.ProductId)?.ProductName
                        ?? CopyTemplate?.Lines.FirstOrDefault(l => l.ProductId == line.ProductId)?.ProductName
                        ?? $"کالا {line.ProductId}";
                productLookup.Add(InvoiceProductOption.Create(line.ProductId, name, product?.Unit ?? line.Unit,
                    IsServiceProduct(line.ProductId), warehouseStock));
            }
        }
    }

    private async Task OnWarehouseChanged(int v)
    {
        warehouseId = v;
        var load = LoadWarehouseStocksAsync();
        RebuildProductLookup(); // immediately replace the previous warehouse's quantities with a loading state
        if (!await load) return; // a newer warehouse selection has already taken over
        RebuildProductLookup();
        if (warehouseId > 0 && !warehouseStock.IsLoaded)
        {
            InvoiceError("دریافت موجودی انبار ناموفق بود؛ انبار را پاک و دوباره انتخاب کنید.");
            return; // an unavailable snapshot must not clear existing invoice lines
        }

        // سطرهایی که کالایشان دیگر در فهرست مجاز این انبار نیست، پاک می‌شوند
        var validProductIds = productLookup.Select(x => x.Id).ToHashSet();
        foreach (var l in lines.Where(x => x.ProductId > 0).ToList())
        {
            if (!validProductIds.Contains(l.ProductId))
            {
                var p = products.FirstOrDefault(x => x.Id == l.ProductId);
                l.ProductId = 0;
                l.Unit = "";
                l.PriceText = "";
                l.DiscountText = "";
                l.DiscountAmount = 0;
                l.DiscountPercent = 0;
                l.VatText = "0";
                InvoiceInfo($"کالای «{p?.Name ?? "انتخاب‌شده"}» در این انبار موجود/مجاز نیست و از سطرها حذف شد.");
            }
        }
    }

    private static void RecalcDiscount(LineVm l)
    {
        var gross = l.Gross;
        if (l.DiscountIsAmount)
        {
            l.DiscountAmount = Math.Clamp(Math.Round(l.DiscountAmount, 0), 0, Math.Max(0, gross));
            l.DiscountPercent = gross > 0 ? Math.Round(l.DiscountAmount * 100m / gross, 2) : 0;
        }
        else
        {
            l.DiscountPercent = Math.Clamp(l.DiscountPercent, 0, 100);
            l.DiscountAmount = Math.Round(gross * l.DiscountPercent / 100m, 0);
        }
    }

    private void OnLineDiscountInput(LineVm l, string? raw)
    {
        l.DiscountText = raw ?? "";
        var val = Math.Max(0, Fa.ParseDecimal(raw));
        if (val <= 100)
        {
            l.DiscountIsAmount = false;
            l.DiscountPercent = val;
            l.DiscountAmount = 0;
        }
        else
        {
            l.DiscountIsAmount = true;
            l.DiscountAmount = val;
        }
        RecalcDiscount(l);
    }

    private void OnLineDiscountBlur(LineVm l)
    {
        RecalcDiscount(l);
        if (l.DiscountIsAmount)
        {
            l.DiscountText = l.DiscountAmount > 0 ? FormatNum(((long)l.DiscountAmount).ToString()) : "";
        }
        else
        {
            l.DiscountText = l.DiscountPercent > 0 ? l.DiscountPercent.ToString("0.##") : "";
        }
    }

    private Guid? pendingLineFocus;

    private void AddLine()
    {
        var line = new LineVm();
        lines.Add(line);
        if (UseInvoiceWizard) pendingLineFocus = line.Key;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loading || !UseInvoiceWizard) return;
        try
        {
            if (pendingLineFocus is Guid key)
            {
                pendingLineFocus = null;
                await JS.InvokeVoidAsync("orderEntry.focusLine", formKey, key.ToString());
            }
            else if (pendingSectionFocus is string selector)
            {
                pendingSectionFocus = null;
                await JS.InvokeVoidAsync("orderEntry.focusSection", formKey, selector);
            }
            else if (!invoiceInitialFocusDone)
            {
                invoiceInitialFocusDone = true;
                await JS.InvokeVoidAsync("orderEntry.focusSection", formKey, "[data-order-initial]");
            }
        }
        catch (JSException) { /* فرم همچنان با Tab قابل استفاده است. */ }
    }

    private void RemoveLine(LineVm l)
    {
        lines.Remove(l);
        if (lines.Count == 0) AddLine();
    }

    private void OnProductPicked(LineVm l, int id)
    {
        if (l.ProductId != id)
        {
            l.OriginalQty = null;
            l.Id = 0;
        }
        var changed = l.ProductId != id;
        l.ProductId = id;
        var p = products.FirstOrDefault(x => x.Id == id);
        if (p is not null)
        {
            l.Unit = p.Unit;
            if (changed) l.VatText = FormatNum((p.InvoiceVatValue ?? 0).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
            var price = Type == TransactionType.Sale ? p.SalePrice : p.PurchasePrice;
            if (price > 0) l.PriceText = FormatNum(((long)price).ToString());
            RecalcDiscount(l);
        }
        else if (changed) l.VatText = "0";
    }

    // A copied legacy value must remain visible in full, even when it needs correction
    // to meet today's precision rules; formatting must not silently round it.
    private static string ExactDecimal(decimal value) =>
        value.ToString("0.############################", System.Globalization.CultureInfo.InvariantCulture);

    /// <summary>قالب‌بندی مقدار کالا؛ نقطه، ممیز فارسی و ویرگول اعشاری را می‌پذیرد.</summary>
    private static string FormatQuantity(object? value)
    {
        var raw = Fa.ToEn(value?.ToString() ?? "").Trim()
            .Replace('\u066B', '.') // ممیز فارسی
            .Replace('\u066C', ','); // جداکنندهٔ هزارگان عربی
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var dot = raw.LastIndexOf('.');
        var comma = raw.LastIndexOf(',');
        if (dot >= 0 && comma >= 0)
        {
            // وقتی هر دو جداکننده حاضرند، جداکنندهٔ راستین ممیز اعشار است.
            // بنابراین 1,234.50 و 1.234,50 هر دو درست خوانده می‌شوند.
            raw = comma > dot
                ? raw[..comma].Replace(".", "").Replace(",", "") + "." + raw[(comma + 1)..]
                : raw.Replace(",", "");
        }
        else if (dot < 0 && comma >= 0)
        {
            // در کیبوردهای بعضی زبان‌ها ویرگول ممیز اعشار است؛ آخرین ویرگول با حداکثر دو
            // رقم پس از آن ممیز در نظر گرفته می‌شود. ویرگول‌های قبلی جداکنندهٔ هزارگان‌اند.
            var fractionDigits = raw[(comma + 1)..].Count(char.IsDigit);
            raw = fractionDigits <= 2
                ? raw[..comma].Replace(",", "") + "." + raw[(comma + 1)..]
                : raw.Replace(",", "");
        }

        var parts = raw.Split('.', 2);
        var wholeDigits = new string(parts[0].Where(char.IsDigit).ToArray());
        if (wholeDigits.Length == 0) wholeDigits = "0";
        if (!decimal.TryParse(wholeDigits, System.Globalization.NumberStyles.None,
                System.Globalization.CultureInfo.InvariantCulture, out var whole)) return "";

        var formatted = whole.ToString("#,##0", System.Globalization.CultureInfo.InvariantCulture);
        if (parts.Length == 2)
        {
            var fraction = new string(parts[1].Where(char.IsDigit).ToArray());
            return $"{formatted}.{fraction}";
        }
        return formatted;
    }

    /// <summary>قالب‌بندی زنده ورودی عددی با جداکننده سه‌رقمی (با حفظ اعشار و پشتیبانی از ارقام فارسی).</summary>
    private static string FormatNum(object? value)
    {
        var raw = Fa.ToEn(value?.ToString() ?? "").Replace(",", "");
        if (string.IsNullOrWhiteSpace(raw)) return "";

        var parts = raw.Split('.', 2);
        var intPart = new string(parts[0].Where(char.IsDigit).ToArray());
        if (intPart.Length == 0) intPart = "0";

        var formatted = decimal.Parse(intPart).ToString("#,##0");
        if (parts.Length == 2)
        {
            var frac = new string(parts[1].Where(char.IsDigit).ToArray());
            return $"{formatted}.{frac}";
        }
        return formatted;
    }

