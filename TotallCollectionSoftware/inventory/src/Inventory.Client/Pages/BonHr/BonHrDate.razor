@* تقویم شمسی مجموعه — مقدار ذخیره‌شده رشتهٔ جلالی yyyy/MM/dd *@
<DatePicker Value="_dt" ValueChanged="OnChanged" AllowClear="AllowClear" Placeholder="@Placeholder" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public bool AllowClear { get; set; } = true;
    [Parameter] public string Placeholder { get; set; } = "1403/05/12";

    private DateTime? _dt;

    protected override void OnParametersSet() => _dt = PersianDate.TryParse(Value);

    private async Task OnChanged(DateTime? dt)
    {
        _dt = dt;
        var text = dt.HasValue ? PersianDate.ToShort(dt.Value) : "";
        await ValueChanged.InvokeAsync(text);
    }
}
