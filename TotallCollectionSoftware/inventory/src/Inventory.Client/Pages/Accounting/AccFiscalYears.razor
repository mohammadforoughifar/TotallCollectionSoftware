@page "/acc/fiscal-years"
@inject IAccFiscalYearService YearSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>سال‌های مالی</PageTitle>

<div class="page-head">
    <div>
        <h1>سال‌های مالی</h1>
        <p class="lead">تعریف دوره‌های مالی؛ اسناد جدید در دوره‌ی «جاری» ثبت می‌شوند</p>
    </div>
    <div class="ms-auto">
        <button class="btn btn-primary" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> سال مالی جدید
        </button>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <i class="bi bi-calendar-range text-primary"></i>
        <span class="card-title">فهرست دوره‌های مالی</span>
        <span class="badge badge-soft-primary ms-auto">@items.Count.Num() دوره</span>
    </div>
    <div class="card-body">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state">
                <i class="bi bi-calendar-range"></i>
                <h5>هنوز سال مالی تعریف نشده است</h5>
                <button class="btn btn-primary mt-2" @onclick="OpenNew">
                    <i class="bi bi-plus-lg"></i> ساخت اولین سال مالی
                </button>
            </div>
        }
        else
        {
            <div class="table-responsive d-none d-lg-block">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th style="width:44px">#</th>
                            <th>عنوان دوره</th>
                            <th class="text-center">کد</th>
                            <th class="text-center">از تاریخ</th>
                            <th class="text-center">تا تاریخ</th>
                            <th class="text-center">تعداد سند</th>
                            <th class="text-center">جمع بدهکار</th>
                            <th class="text-center">جمع بستانکار</th>
                            <th class="text-center">وضعیت</th>
                            <th class="text-center" style="width:150px">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ var row = 1; }
                        @foreach (var y in items)
                        {
                            <tr class="@(y.IsCurrent ? "table-active" : "")">
                                <td class="num text-muted">@((row++).FaDigits())</td>
                                <td>
                                    <b>@y.Title</b>
                                    @if (!string.IsNullOrWhiteSpace(y.Description))
                                    {
                                        <div class="fs-8 text-muted">@y.Description</div>
                                    }
                                </td>
                                <td class="text-center num">@y.Code.FaDigits()</td>
                                <td class="text-center num">@y.StartDate.ToFaDate()</td>
                                <td class="text-center num">@y.EndDate.ToFaDate()</td>
                                <td class="text-center num">@y.VoucherCount.Num()</td>
                                <td class="text-center num text-success">@y.TotalDebit.Money()</td>
                                <td class="text-center num text-danger">@y.TotalCredit.Money()</td>
                                <td class="text-center">
                                    @if (y.IsCurrent)
                                    {
                                        <span class="badge badge-soft-success">جاری</span>
                                    }
                                    @if (y.IsClosed)
                                    {
                                        <span class="badge badge-soft-danger">بسته</span>
                                    }
                                    @if (!y.IsCurrent && !y.IsClosed)
                                    {
                                        <span class="badge badge-soft-secondary">باز</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (!y.IsCurrent)
                                    {
                                        <button class="btn btn-sm btn-light" title="انتخاب به‌عنوان دوره جاری" @onclick="() => SetCurrent(y)">
                                            <i class="bi bi-check2-circle text-success"></i>
                                        </button>
                                    }
                                    <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEdit(y)">
                                        <i class="bi bi-pencil text-primary"></i>
                                    </button>
                                    <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(y)">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <!-- نمای موبایل -->
            <div class="d-lg-none">
                @foreach (var y in items)
                {
                    <div class="m-card @(y.IsCurrent ? "st-success" : "")">
                        <div class="m-card-head">
                            <span class="m-card-icon"><i class="bi bi-calendar-range"></i></span>
                            <div class="min-w-0">
                                <b>@y.Title</b>
                                <div class="fs-8 text-muted num">@y.StartDate.ToFaDate() تا @y.EndDate.ToFaDate()</div>
                            </div>
                            @if (y.IsCurrent)
                            {
                                <span class="badge badge-soft-success ms-auto">جاری</span>
                            }
                        </div>
                        <div class="m-card-body">
                            <div class="m-card-row"><span>تعداد سند</span><b class="num">@y.VoucherCount.Num()</b></div>
                            <div class="m-card-row"><span>جمع بدهکار</span><b class="m-card-money num">@y.TotalDebit.Money()</b></div>
                            <div class="m-card-row"><span>جمع بستانکار</span><b class="m-card-money num">@y.TotalCredit.Money()</b></div>
                        </div>
                        <div class="m-card-actions">
                            @if (!y.IsCurrent)
                            {
                                <button class="btn btn-sm btn-light" @onclick="() => SetCurrent(y)">
                                    <i class="bi bi-check2-circle text-success"></i> دوره جاری
                                </button>
                            }
                            <button class="btn btn-sm btn-light" @onclick="() => OpenEdit(y)">
                                <i class="bi bi-pencil text-primary"></i> ویرایش
                            </button>
                            <button class="btn btn-sm btn-light" @onclick="() => Delete(y)">
                                <i class="bi bi-trash text-danger"></i> حذف
                            </button>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- ================= مودال ثبت/ویرایش ================= -->
<Modal Visible="showModal" Title="@(editing ? "ویرایش سال مالی" : "سال مالی جدید")" OnClose="CloseModal">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-8">
                <label class="form-label">عنوان دوره <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.Title" placeholder="مثلاً: سال مالی ۱۴۰۵" />
            </div>
            <div class="col-md-4">
                <label class="form-label">کد دوره</label>
                <input class="form-control num" @bind="form.Code" placeholder="مثلاً: 1405" />
            </div>

            <div class="col-md-6">
                <label class="form-label">تاریخ شروع <span class="text-danger">*</span></label>
                <DatePicker @bind-Value="startDate" />
            </div>
            <div class="col-md-6">
                <label class="form-label">تاریخ پایان <span class="text-danger">*</span></label>
                <DatePicker @bind-Value="endDate" />
            </div>

            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="fyCurrent" @bind="form.IsCurrent" />
                    <label class="form-check-label" for="fyCurrent">دوره جاری سیستم</label>
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="fyClosed" @bind="form.IsClosed" />
                    <label class="form-check-label" for="fyClosed">بسته شده (ثبت سند ممنوع)</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label">شرح</label>
                <textarea class="form-control" rows="2" @bind="form.Description"></textarea>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseModal">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            ذخیره
        </button>
    </Footer>
</Modal>

@code {
    private List<AccFiscalYear> items = new();
    private bool loading = true, showModal, saving;

    private AccFiscalYear form = new();
    private DateTime? startDate;
    private DateTime? endDate;
    private bool editing => form.Id != 0;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("سال‌های مالی");
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try { items = await YearSvc.GetAllAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private void OpenNew()
    {
        var fa = PersianDate.FromGregorian(DateTime.Now);
        var year = items.Count == 0 ? fa.Year : fa.Year + 1;
        form = new AccFiscalYear { Title = $"سال مالی {year}", Code = year.ToString(), IsCurrent = items.Count == 0 };
        startDate = PersianDate.ToGregorian(year, 1, 1);
        endDate = PersianDate.ToGregorian(year, 12, PersianDate.DaysInMonth(year, 12));
        showModal = true;
    }

    private void OpenEdit(AccFiscalYear y)
    {
        form = new AccFiscalYear
        {
            Id = y.Id, Title = y.Title, Code = y.Code, StartDate = y.StartDate, EndDate = y.EndDate,
            IsCurrent = y.IsCurrent, IsClosed = y.IsClosed, Description = y.Description
        };
        startDate = y.StartDate;
        endDate = y.EndDate;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    private async Task Save()
    {
        if (string.IsNullOrWhiteSpace(form.Title)) { Toast.Error("عنوان دوره را وارد کنید."); return; }
        if (startDate is null || endDate is null) { Toast.Error("تاریخ شروع و پایان دوره را مشخص کنید."); return; }
        if (endDate <= startDate) { Toast.Error("تاریخ پایان باید بعد از تاریخ شروع باشد."); return; }

        form.StartDate = startDate.Value;
        form.EndDate = endDate.Value;

        saving = true;
        try
        {
            await YearSvc.SaveAsync(form);
            Toast.Success(editing ? "سال مالی ویرایش شد." : "سال مالی ثبت شد.");
            showModal = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task SetCurrent(AccFiscalYear y)
    {
        try
        {
            await YearSvc.SetCurrentAsync(y.Id);
            Toast.Success($"«{y.Title}» به‌عنوان دوره جاری انتخاب شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Delete(AccFiscalYear y)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف «{y.Title}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await YearSvc.DeleteAsync(y.Id);
            Toast.Success("سال مالی حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
