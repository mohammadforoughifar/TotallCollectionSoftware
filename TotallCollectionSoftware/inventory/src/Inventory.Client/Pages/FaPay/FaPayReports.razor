@namespace Inventory.Client.Pages
@page "/fa-pay/reports"
@inject IFaPayClientService Svc
@inject IAuthState Auth
@inject IToastService Toast

<PageTitle>گزارش‌های حقوق و دستمزد</PageTitle>

<div class="page-head mb-4">
    <div>
        <h1><i class="bi bi-bar-chart"></i> گزارش‌های حقوق و دستمزد</h1>
        <div class="lead">بیمه تأمین اجتماعی، مالیات حقوق و بهای تمام‌شده واحدها</div>
    </div>
</div>

@if (!faRead)
{
    <div class="alert alert-warning">به این بخش دسترسی ندارید.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body">
        <div class="row g-2 align-items-end">
            <div class="col-md-3"><label class="form-label small text-muted">سال</label><input class="form-control" type="number" @bind="year" /></div>
            <div class="col-md-3">
                <label class="form-label small text-muted">ماه</label>
                <select class="form-select" @bind="month">
                    @for (int m = 1; m <= 12; m++)
                    {
                        <option value="@m">@FaPayUi.MonthName(m)</option>
                    }
                </select>
            </div>
            <div class="col-md-3"><button class="btn btn-primary w-100" @onclick="Reload"><i class="bi bi-search"></i> نمایش گزارش</button></div>
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    return;
}

<ul class="nav nav-tabs mb-3">
    <li class="nav-item"><button class="nav-link @(tab == 0 ? "active" : "")" @onclick="() => tab = 0">بیمه</button></li>
    <li class="nav-item"><button class="nav-link @(tab == 1 ? "active" : "")" @onclick="() => tab = 1">مالیات</button></li>
    <li class="nav-item"><button class="nav-link @(tab == 2 ? "active" : "")" @onclick="() => tab = 2">بهای تمام‌شده واحدها</button></li>
</ul>

@if (tab == 0)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>پرسنل</th><th>حقوق پایه</th><th>مبلغ مشمول بیمه</th><th>سهم کارمند</th><th>سهم کارفرما</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ins.Rows)
                        {
                            <tr>
                                <td><strong>@r.EmployeeName</strong><div class="small text-muted">@r.EmployeeCode</div></td>
                                <td>@FaPayUi.Money(r.BaseSalary)</td>
                                <td>@FaPayUi.Money(r.InsurableAmount)</td>
                                <td>@FaPayUi.Money(r.EmployeeShare)</td>
                                <td>@FaPayUi.Money(r.EmployerShare)</td>
                            </tr>
                        }
                        @if (ins.Rows.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">داده‌ای نیست.</td></tr>
                        }
                    </tbody>
                    @if (ins.Rows.Count > 0)
                    {
                        <tfoot><tr class="table-primary"><th>جمع</th><th></th><th>@FaPayUi.Money(ins.TotalInsurable)</th><th>@FaPayUi.Money(ins.TotalEmployee)</th><th>@FaPayUi.Money(ins.TotalEmployer)</th></tr></tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
}
else if (tab == 1)
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>پرسنل</th><th>جمع مزایا</th><th>مبلغ مشمول</th><th>مالیات</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in tax.Rows)
                        {
                            <tr>
                                <td><strong>@r.EmployeeName</strong><div class="small text-muted">@r.EmployeeCode</div></td>
                                <td>@FaPayUi.Money(r.Gross)</td>
                                <td>@FaPayUi.Money(r.Taxable)</td>
                                <td>@FaPayUi.Money(r.Tax)</td>
                            </tr>
                        }
                        @if (tax.Rows.Count == 0)
                        {
                            <tr><td colspan="4" class="text-center text-muted py-4">داده‌ای نیست.</td></tr>
                        }
                    </tbody>
                    @if (tax.Rows.Count > 0)
                    {
                        <tfoot><tr class="table-primary"><th>جمع</th><th>@FaPayUi.Money(tax.TotalGross)</th><th>@FaPayUi.Money(tax.TotalTaxable)</th><th>@FaPayUi.Money(tax.TotalTax)</th></tr></tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
}
else
{
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr><th>واحد سازمانی</th><th class="text-center">تعداد نفر</th><th>جمع حقوق و مزایا</th><th>بیمه سهم کارفرما</th><th>بهای تمام‌شده</th></tr>
                    </thead>
                    <tbody>
                        @foreach (var r in cost.Rows)
                        {
                            <tr>
                                <td><strong>@r.OrgUnitName</strong></td>
                                <td class="text-center">@FaPayUi.Num(r.Headcount)</td>
                                <td>@FaPayUi.Money(r.GrossTotal)</td>
                                <td>@FaPayUi.Money(r.EmployerInsurance)</td>
                                <td><strong class="text-primary">@FaPayUi.Money(r.TotalCost)</strong></td>
                            </tr>
                        }
                        @if (cost.Rows.Count == 0)
                        {
                            <tr><td colspan="5" class="text-center text-muted py-4">داده‌ای نیست.</td></tr>
                        }
                    </tbody>
                    @if (cost.Rows.Count > 0)
                    {
                        <tfoot><tr class="table-primary"><th>جمع</th><th></th><th>@FaPayUi.Money(cost.TotalGross)</th><th>@FaPayUi.Money(cost.TotalEmployerInsurance)</th><th>@FaPayUi.Money(cost.TotalCost)</th></tr></tfoot>
                    }
                </table>
            </div>
        </div>
    </div>
}

@code {
    private bool faRead => Auth.Has("FaPay.Read") || Auth.Has("FaPay.Manage") || Auth.IsAdmin;
    private bool loading = true;
    private int tab;
    private int year = FaPayUi.CurrentYear;
    private int month = FaPayUi.CurrentMonth;

    private FaPayInsuranceReportDto ins = new();
    private FaPayTaxReportDto tax = new();
    private FaPayUnitCostReportDto cost = new();

    protected override async Task OnInitializedAsync()
    {
        if (!faRead) { loading = false; return; }
        await Reload();
    }

    private async Task Reload()
    {
        loading = true;
        try
        {
            ins = await Svc.InsuranceReportAsync(year, month);
            tax = await Svc.TaxReportAsync(year, month);
            cost = await Svc.UnitCostReportAsync(year, month);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        loading = false;
    }
}
