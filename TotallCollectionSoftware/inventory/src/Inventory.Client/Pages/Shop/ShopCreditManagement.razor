@code {
    private string activeTab = "cheques";
    private bool loading = true;
    private ShopCreditSummary? summary;

    private List<ShopChequeItem> cheques = new();
    private List<ShopChequeItem> filteredCheques = new();
    private string chequeSearch = "";
    private string chequeStatusFilter = "";
    private string chequeTxnTypeFilter = "";

    private List<ShopInstallmentItem> installments = new();
    private List<ShopInstallmentItem> filteredInstallments = new();
    private string installmentSearch = "";
    private string installmentPaidFilter = "";

    private bool showBounceModal, bounceBusy;
    private ShopChequeItem? bounceTarget;
    private string bounceReason = "";
    private Guid bounceOperationId;
    private ShopChequeItem? rescheduleTarget;
    private DateTime? rescheduleDueDate, rescheduleOperationDate;
    private SaleChequeReschedulePreview? reschedulePreview;
    private Guid rescheduleOperationId;
    private bool rescheduleBusy;
    private ShopChequeItem? receiptTarget;
    private List<Inventory.Shared.Dtos.TrsAccount> receiptBanks = new();
    private DateTime? receiptDate;
    private int receiptBankId;
    private Guid receiptOperationId;
    private bool receiptBusy;
    private ShopChequeItem? reversalTarget;
    private DateTime? reversalDate;
    private Guid reversalOperationId;
    private bool reversalBusy;
    private ShopChequeItem? historyTarget;
    private List<SaleChequeStatusHistoryItem> historyItems = new();

    private async Task RequestReceiptReversal(ShopChequeItem item)
    {
        reversalDate = DateTime.Today;
        reversalOperationId = Guid.NewGuid();
        reversalTarget = item;
    }

    private void CloseReceiptReversal()
    {
        if (!reversalBusy) reversalTarget = null;
    }

    private async Task ConfirmReceiptReversal()
    {
        if (reversalTarget is null || !reversalDate.HasValue || reversalBusy) return;
        reversalBusy = true;
        try
        {
            await OrderSvc.ReverseChequeReceiptAsync(reversalTarget.Id, new SaleChequeReceiptReversalCommand
            {
                OperationId = reversalOperationId, Date = reversalDate.Value
            });
            var wasPurchase = reversalTarget.TransactionType == TransactionType.Purchase;
            reversalTarget = null;
            Toast.Success(wasPurchase ? "لغو پرداخت ثبت شد." : "لغو وصول ثبت شد.");
            await LoadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { reversalBusy = false; }
    }

    private async Task OpenChequeHistory(ShopChequeItem item)
    {
        try
        {
            historyItems = await OrderSvc.GetChequeStatusHistoryAsync(item.Id);
            historyTarget = item;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void CloseChequeHistory() => historyTarget = null;

    private static string ChequeStatusLabel(ChequeStatus status) => status switch
    {
        ChequeStatus.InHand => "در جریان",
        ChequeStatus.Bounced => "برگشتی",
        ChequeStatus.Cleared => "وصول‌شده",
        ChequeStatus.Cancelled => "ابطال / تعویض شده",
        _ => status.ToString()
    };

    private async Task OpenReceipt(ShopChequeItem item)
    {
        try
        {
            receiptBanks = await OrderSvc.GetActiveTreasuryAccountsAsync(TreasuryAccountKind.Bank);
            // For issued cheques the recorded account is the actual payer; a
            // customer's bank name, in contrast, never selects our destination.
            receiptBankId = item.TransactionType == TransactionType.Purchase && item.TrsAccountId is > 0 &&
                receiptBanks.Any(a => a.Id == item.TrsAccountId) ? item.TrsAccountId.Value : 0;
            receiptDate = DateTime.Today;
            receiptOperationId = Guid.NewGuid();
            receiptTarget = item;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void CloseReceipt()
    {
        if (!receiptBusy) receiptTarget = null;
    }

    private async Task ConfirmReceipt()
    {
        if (receiptTarget is null || receiptBankId <= 0 || !receiptDate.HasValue || receiptBusy) return;
        receiptBusy = true;
        try
        {
            await OrderSvc.ReceiveChequeAsync(receiptTarget.Id, new SaleChequeReceiptCommand
            {
                OperationId = receiptOperationId, TrsAccountId = receiptBankId, Date = receiptDate.Value
            });
            var wasPurchase = receiptTarget.TransactionType == TransactionType.Purchase;
            receiptTarget = null;
            Toast.Success(wasPurchase ? "پرداخت چک ثبت شد." : "وصول چک ثبت شد.");
            await LoadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { receiptBusy = false; }
    }

    private void OpenReschedule(ShopChequeItem item)
    {
        rescheduleTarget = item;
        rescheduleDueDate = item.DueDate;
        rescheduleOperationDate = DateTime.Today;
        reschedulePreview = null;
        rescheduleOperationId = Guid.NewGuid();
    }

    private void CloseReschedule()
    {
        if (!rescheduleBusy) { rescheduleTarget = null; reschedulePreview = null; }
    }

    private void SetRescheduleDueDate(DateTime? value)
    {
        rescheduleDueDate = value;
        reschedulePreview = null;
        rescheduleOperationId = Guid.NewGuid();
    }

    private async Task PreviewReschedule()
    {
        if (rescheduleTarget is null || !rescheduleDueDate.HasValue || rescheduleBusy) return;
        rescheduleBusy = true;
        try
        {
            reschedulePreview = await OrderSvc.PreviewChequeRescheduleAsync(rescheduleTarget.Id,
                rescheduleTarget.DueDate, rescheduleDueDate.Value);
        }
        catch (Exception ex) { reschedulePreview = null; Toast.Error(ex.Message); }
        finally { rescheduleBusy = false; }
    }

    private async Task ConfirmReschedule()
    {
        if (rescheduleTarget is null || reschedulePreview is null || !rescheduleDueDate.HasValue ||
            !rescheduleOperationDate.HasValue || rescheduleBusy) return;
        rescheduleBusy = true;
        try
        {
            await OrderSvc.RescheduleChequeAsync(rescheduleTarget.Id, new SaleChequeRescheduleCommand
            {
                OperationId = rescheduleOperationId, ExpectedDueDate = rescheduleTarget.DueDate,
                NewDueDate = rescheduleDueDate.Value, OperationDate = rescheduleOperationDate.Value,
                ConfirmedIncomeDelta = reschedulePreview.IncomeDelta
            });
            rescheduleTarget = null;
            reschedulePreview = null;
            Toast.Success("سررسید و تعدیل ثبت شد.");
            await LoadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { rescheduleBusy = false; }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private void SetTab(string tab)
    {
        activeTab = tab;
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            summary = await DashboardSvc.GetShopCreditSummaryAsync();
            cheques = await DashboardSvc.GetShopChequesAsync();
            installments = await DashboardSvc.GetShopInstallmentsAsync();

            ApplyChequeFilter();
            ApplyInstallmentFilter();
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در بارگذاری داده‌ها: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyChequeFilter()
    {
        var q = cheques.AsEnumerable();

        if (int.TryParse(chequeStatusFilter, out var st))
        {
            var status = (ChequeStatus)st;
            if (status == ChequeStatus.Cleared)
                q = q.Where(c => c.IsCleared || c.Status == ChequeStatus.Cleared);
            else if (status == ChequeStatus.Bounced)
                q = q.Where(c => c.Status == ChequeStatus.Bounced);
            else if (status == ChequeStatus.Cancelled)
                q = q.Where(c => c.Status == ChequeStatus.Cancelled);
            else
                q = q.Where(c => !c.IsCleared && c.Status != ChequeStatus.Bounced && c.Status != ChequeStatus.Cancelled);
        }

        if (int.TryParse(chequeTxnTypeFilter, out var tt))
        {
            var type = (TransactionType)tt;
            q = q.Where(c => c.TransactionType == type);
        }

        if (!string.IsNullOrWhiteSpace(chequeSearch))
        {
            var s = chequeSearch.Trim().ToLower();
            q = q.Where(c => c.Number.ToLower().Contains(s) ||
                             c.PartyName.ToLower().Contains(s) ||
                             c.OrderNumber.ToLower().Contains(s) ||
                             (c.BankName != null && c.BankName.ToLower().Contains(s)) ||
                             PhoneSearch.Matches(s, c.PartyMobile, c.PartyPhone));
        }

        filteredCheques = q.OrderBy(c => c.DueDate).ToList();
    }

    private void ApplyInstallmentFilter()
    {
        var q = installments.AsEnumerable();

        if (bool.TryParse(installmentPaidFilter, out var paid))
        {
            q = q.Where(i => i.IsPaid == paid);
        }

        if (!string.IsNullOrWhiteSpace(installmentSearch))
        {
            var s = installmentSearch.Trim().ToLower();
            q = q.Where(i => i.PartyName.ToLower().Contains(s) ||
                             i.OrderNumber.ToLower().Contains(s) ||
                             PhoneSearch.Matches(s, i.PartyMobile, i.PartyPhone));
        }

        filteredInstallments = q.OrderBy(i => i.DueDate).ToList();
    }

    private Task ConfirmClearCheque(ShopChequeItem c) => OpenReceipt(c);

    private void PromptBounce(ShopChequeItem c)
    {
        bounceTarget = c;
        bounceOperationId = Guid.NewGuid();
        bounceReason = "کسر موجودی حساب";
        showBounceModal = true;
    }

    private async Task ConfirmBounce()
    {
        if (bounceBusy || bounceTarget == null) return;
        bounceBusy = true;
        try
        {
            if (bounceTarget.HasChequeCharge)
                await OrderSvc.ChangeChequeStatusAsync(bounceTarget.Id, new SaleChequeStatusCommand { OperationId = bounceOperationId, Bounced = true, Reason = bounceReason });
            else
                await DashboardSvc.BounceChequeAsync(bounceTarget.Id, bounceReason);
            Toast.Error($"چک {bounceTarget.Number} برگشت خورد و در وضعیت بدهی ثبت شد.");
            showBounceModal = false;
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
        finally { bounceBusy = false; }
    }

    private async Task ResetCheque(ShopChequeItem c)
    {
        try
        {
            if (c.HasChequeCharge)
                await OrderSvc.ChangeChequeStatusAsync(c.Id, new SaleChequeStatusCommand { OperationId = Guid.NewGuid(), Bounced = false });
            else
                await DashboardSvc.ResetChequeAsync(c.Id);
            Toast.Info($"وضعیت چک {c.Number} به در جریان بازگردانده شد.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }

    private ShopChequeItem? replaceTarget;
    private string replaceNumber = "";
    private string replaceAmountText = "";
    private string? replaceBankName;
    private string? replaceReason;
    private DateTime? replaceOperationDate;
    private Guid replaceOperationId;
    private bool replaceBusy;

    private void OpenReplaceCheque(ShopChequeItem c)
    {
        replaceTarget = c;
        replaceNumber = "";
        replaceAmountText = Fa.FormatTyping(c.Amount.ToString("0.##"));
        replaceBankName = c.BankName;
        replaceReason = "";
        replaceOperationDate = DateTime.Today;
        replaceOperationId = Guid.NewGuid();
    }

    private void CloseReplaceCheque()
    {
        if (!replaceBusy) replaceTarget = null;
    }

    private async Task ConfirmReplaceCheque()
    {
        if (replaceTarget is null || string.IsNullOrWhiteSpace(replaceNumber) || !replaceOperationDate.HasValue || replaceBusy) return;
        var amount = Fa.ParseDecimal(replaceAmountText);
        if (amount <= 0) { Toast.Error("مبلغ چک جایگزین را وارد کنید."); return; }
        replaceBusy = true;
        try
        {
            await OrderSvc.ReplaceChequeAsync(replaceTarget.Id, new SaleChequeReplaceCommand
            {
                OperationId = replaceOperationId,
                OperationDate = replaceOperationDate.Value,
                Number = replaceNumber.Trim(),
                Amount = amount,
                DueDate = replaceTarget.DueDate,
                BankName = replaceBankName,
                OwnerName = replaceTarget.OwnerName,
                AccountInfo = replaceTarget.AccountInfo,
                Reason = replaceReason
            });
            replaceTarget = null;
            Toast.Success("تعویض چک ثبت شد و چک قبلی در تاریخچه حفظ گردید.");
            await LoadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { replaceBusy = false; }
    }

    private ShopInstallmentItem? instReceiptTarget;
    private List<TrsAccount> instReceiptAccounts = new();
    private int instReceiptAccountId;
    private DateTime? instReceiptDate;
    private Guid instReceiptOperationId;
    private bool instReceiptBusy;

    private ShopInstallmentItem? instReversalTarget;
    private DateTime? instReversalDate;
    private Guid instReversalOperationId;
    private bool instReversalBusy;

    private async Task OpenInstallmentReceipt(ShopInstallmentItem i)
    {
        try
        {
            instReceiptAccounts = await OrderSvc.GetActiveTreasuryAccountsAsync();
            instReceiptAccountId = 0;
            instReceiptDate = DateTime.Today;
            instReceiptOperationId = Guid.NewGuid();
            instReceiptTarget = i;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void CloseInstallmentReceipt()
    {
        if (!instReceiptBusy) instReceiptTarget = null;
    }

    private async Task ConfirmInstallmentReceipt()
    {
        if (instReceiptTarget is null || instReceiptAccountId <= 0 || !instReceiptDate.HasValue || instReceiptBusy) return;
        instReceiptBusy = true;
        try
        {
            await OrderSvc.ReceiveChequeInstallmentAsync(instReceiptTarget.Id, new SaleChequeInstallmentReceiptCommand
            {
                OperationId = instReceiptOperationId,
                TrsAccountId = instReceiptAccountId,
                Date = instReceiptDate.Value
            });
            var wasPurchase = instReceiptTarget.TransactionType == TransactionType.Purchase;
            instReceiptTarget = null;
            Toast.Success(wasPurchase ? "پرداخت قسط ثبت شد." : "دریافت قسط ثبت شد.");
            await LoadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { instReceiptBusy = false; }
    }

    private void CloseInstallmentReversal()
    {
        if (!instReversalBusy) instReversalTarget = null;
    }

    private async Task ConfirmInstallmentReversal()
    {
        if (instReversalTarget is null || !instReversalDate.HasValue || instReversalBusy) return;
        instReversalBusy = true;
        try
        {
            await OrderSvc.ReverseChequeInstallmentReceiptAsync(instReversalTarget.Id, new SaleChequeInstallmentReversalCommand
            {
                OperationId = instReversalOperationId,
                Date = instReversalDate.Value
            });
            var wasPurchase = instReversalTarget.TransactionType == TransactionType.Purchase;
            instReversalTarget = null;
            Toast.Warning(wasPurchase ? "پرداخت قسط لغو شد." : "دریافت قسط لغو شد.");
            await LoadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { instReversalBusy = false; }
    }

    private Task PayInstallment(ShopInstallmentItem i) => OpenInstallmentReceipt(i);

    private async Task UnpayInstallment(ShopInstallmentItem i)
    {
        if (i.HasChequeCharge || i.HasTrackedReceipt)
        {
            instReversalTarget = i;
            instReversalDate = DateTime.Today;
            instReversalOperationId = Guid.NewGuid();
            return;
        }
        try
        {
            await DashboardSvc.UnpayInstallmentAsync(i.Id);
            Toast.Warning($"تسویه قسط شماره {i.No} لغو شد و به عنوان بدهی معوق منظور گردید.");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message);
        }
    }
}
