@page "/shop/credit-management"
@using Microsoft.AspNetCore.Authorization
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IAuthState Auth
@inject IDashboardService DashboardSvc
@inject IToastService Toast

<PageTitle>مدیریت جامع چک‌ها و دفترچه اقساط</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ لوکس ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon bg-indigo-gradient">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">مدیریت چک‌ها، اسناد و دفترچه اقساط</h1>
                        <span class="badge rounded-pill fin-badge-indigo">وصول مطالبات</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        پیگیری تعهدات مشتریان و تأمین‌کنندگان، تأیید وصولی‌ها، اعلام برگشتی‌ها و تسویه اقساط
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                <button class="btn btn-outline-primary fin-btn-pill" @onclick="LoadDataAsync" disabled="@loading">
                    <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i> به‌روزرسانی اطلاعات
                </button>
            </div>
        </div>
    </div>

    @if (summary != null)
    {
        <!-- ================== کارت‌های شاخص KPI ================== -->
        <div class="row g-3 mb-4">
            <!-- چک‌های در جریان -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-indigo">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-indigo">چک‌های در جریان وصول</span>
                            <div class="fin-kpi-value text-indigo num mt-1">@summary.InHandChequesTotal.Money()</div>
                            <div class="fin-kpi-unit">ریال نزد صندوق یا بانک</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                            <i class="bi bi-hourglass-split"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-indigo-subtle text-indigo rounded-pill px-2.5 num">
                            @summary.InHandChequesCount.Num() برگ چک فعال
                        </span>
                    </div>
                </div>
            </div>

            <!-- چک‌های برگشتی -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-rose">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-rose">چک‌های برگشتی (مطالبات معوق)</span>
                            <div class="fin-kpi-value text-rose num mt-1">@summary.BouncedChequesTotal.Money()</div>
                            <div class="fin-kpi-unit">ریال وصول‌نشده</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-rose-subtle text-rose">
                            <i class="bi bi-x-octagon-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-rose-subtle text-rose rounded-pill px-2.5 num">
                            @summary.BouncedChequesCount.Num() چک برگشتی و بدهکار
                        </span>
                    </div>
                </div>
            </div>

            <!-- اقساط پرداخت‌نشده -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-amber">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-amber">اقساط باز و سررسیدشده</span>
                            <div class="fin-kpi-value text-amber num mt-1">@summary.PendingInstallmentsTotal.Money()</div>
                            <div class="fin-kpi-unit">ریال اقساط وصولی</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                            <i class="bi bi-calendar2-week"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-amber-subtle text-amber rounded-pill px-2.5 num">
                            @summary.PendingInstallmentsCount.Num() قسط باز (@summary.OverdueInstallmentsCount.Num() معوق)
                        </span>
                    </div>
                </div>
            </div>

            <!-- وصولی‌های قطعی -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-emerald">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-emerald">مجموع وصولی‌های موفق</span>
                            <div class="fin-kpi-value text-emerald num mt-1">
                                @((summary.ClearedChequesTotal + summary.PaidInstallmentsTotal).Money())
                            </div>
                            <div class="fin-kpi-unit">ریال تسویه‌شده</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                            <i class="bi bi-check-circle-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5 num">
                            @((summary.ClearedChequesCount + summary.PaidInstallmentsCount).Num()) فقره وصولی کامل
                        </span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ================== تب‌های سگمنتی لوکس ================== -->
    <div class="op-tabs-nav-wrapper mb-4">
        <div class="op-tabs-nav" style="grid-template-columns: repeat(2, 1fr);">
            <button type="button" class="op-tab-btn @(activeTab == "cheques" ? "is-active tab-cheques" : "")"
                    @onclick='() => SetTab("cheques")'>
                <div class="op-tab-icon-box">
                    <i class="bi bi-credit-card-2-front-fill"></i>
                </div>
                <div class="op-tab-text">
                    <span class="op-tab-title">مدیریت چک‌ها</span>
                    <span class="op-tab-sub">چک‌های دریافتی از مشتریان و پرداختی به تأمین‌کنندگان</span>
                </div>
                @if (cheques.Count > 0)
                {
                    <span class="op-tab-counter">@cheques.Count.Num()</span>
                }
            </button>

            <button type="button" class="op-tab-btn @(activeTab == "installments" ? "is-active tab-installments" : "")"
                    @onclick='() => SetTab("installments")'>
                <div class="op-tab-icon-box">
                    <i class="bi bi-calendar2-range-fill"></i>
                </div>
                <div class="op-tab-text">
                    <span class="op-tab-title">مدیریت دفترچه اقساط</span>
                    <span class="op-tab-sub">پیگیری سررسید اقساط و ثبت وصولی خط‌به‌خط</span>
                </div>
                @if (installments.Count > 0)
                {
                    <span class="op-tab-counter">@installments.Count.Num()</span>
                }
            </button>
        </div>
    </div>

    <!-- ================== محتوای تب فعال ================== -->
    @if (activeTab == "cheques")
    {
        <!-- نوار فیلتر چک -->
        <div class="fin-filter-card mb-4">
            <div class="row g-2.5 align-items-end">
                <div class="col-12 col-md-5 col-xl-4">
                    <label class="fin-label">جستجوی سریال چک، نام/تلفن مشتری یا شماره فاکتور</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0 fin-input"
                               placeholder="جستجوی سریال، کد صیاد، نام یا تلفن مشتری..."
                               @bind="chequeSearch" @bind:event="oninput" @onkeyup="ApplyChequeFilter" />
                    </div>
                </div>

                <div class="col-6 col-md-3 col-xl-3">
                    <label class="fin-label">وضعیت چک</label>
                    <select class="form-select form-select-sm fin-input" @bind="chequeStatusFilter" @bind:after="ApplyChequeFilter">
                        <option value="">همه وضعیت‌ها</option>
                        <option value="@((int)ChequeStatus.InHand)">در جریان وصول (نزد صندوق / بانک)</option>
                        <option value="@((int)ChequeStatus.Cleared)">وصول‌شده (پاس شده)</option>
                        <option value="@((int)ChequeStatus.Bounced)">برگشت خورده (بدهکار)</option>
                    </select>
                </div>

                <div class="col-6 col-md-3 col-xl-3">
                    <label class="fin-label">نوع تراکنش چک</label>
                    <select class="form-select form-select-sm fin-input" @bind="chequeTxnTypeFilter" @bind:after="ApplyChequeFilter">
                        <option value="">همه چک‌ها (دریافتی و پرداختی)</option>
                        <option value="@((int)TransactionType.Sale)">چک‌های دریافتی از مشتری (فروش)</option>
                        <option value="@((int)TransactionType.Purchase)">چک‌های پرداختی ما (خرید)</option>
                    </select>
                </div>

                <div class="col-12 col-md-1 col-xl-2 text-md-end pb-1">
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 num fs-8">
                        @filteredCheques.Count.Num() چک
                    </span>
                </div>
            </div>
        </div>

        <!-- جدول چک‌ها -->
        <div class="fin-table-card">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                    <div class="text-secondary fs-8">در حال بارگذاری چک‌ها...</div>
                </div>
            }
            else if (filteredCheques.Count == 0)
            {
                <div class="fin-empty-state text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted opacity-50"></i>
                    <div class="fw-bold text-secondary mt-2">هیچ چکی با شرایط انتخابی یافت نشد</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table fin-table align-middle">
                        <thead>
                            <tr>
                                <th>نوع</th>
                                <th>سریال چک / صیاد</th>
                                <th>طرف حساب</th>
                                <th>بانک و شعبه</th>
                                <th>شماره فاکتور</th>
                                <th class="text-start">مبلغ چک (ریال)</th>
                                <th>تاریخ سررسید</th>
                                <th>وضعیت</th>
                                <th class="text-center" style="width: 140px;">عملیات وصول</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in filteredCheques)
                            {
                                <tr class="fin-table-row @(c.Status == ChequeStatus.Bounced ? "table-danger-subtle" : c.IsCleared ? "table-success-subtle" : "")">
                                    <td>
                                        @if (c.TransactionType == TransactionType.Sale)
                                        {
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill px-2.5">
                                                <i class="bi bi-arrow-down-left me-1"></i> دریافتی
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-amber-subtle text-amber border border-amber-subtle rounded-pill px-2.5">
                                                <i class="bi bi-arrow-up-right me-1"></i> پرداختی
                                            </span>
                                        }
                                    </td>
                                    <td>
                                        <div class="num fw-800 text-dark">@c.Number</div>
                                        @if (!string.IsNullOrEmpty(c.OwnerName) && c.OwnerName != c.PartyName)
                                        {
                                            <div class="fs-9 text-muted">صاحب: @c.OwnerName</div>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-700 text-dark">@c.PartyName</div>
                                        @if (!string.IsNullOrEmpty(c.PartyMobile))
                                        {
                                            <div class="fs-9 text-muted num">@c.PartyMobile</div>
                                        }
                                    </td>
                                    <td class="fs-8">
                                        <div class="text-dark">@(c.BankName ?? "—")</div>
                                        @if (!string.IsNullOrEmpty(c.AccountInfo))
                                        {
                                            <div class="fs-9 text-muted">@c.AccountInfo</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="num fs-8 fw-700 text-indigo">@c.OrderNumber</span>
                                    </td>
                                    <td class="text-start num fw-800 fs-7.5 @(c.Status == ChequeStatus.Bounced ? "text-danger" : c.IsCleared ? "text-emerald" : "text-dark")">
                                        @c.Amount.Money()
                                    </td>
                                    <td class="num fs-8">
                                        <div class="fw-600">@c.DueDate.ToFa()</div>
                                        @if (!c.IsCleared && c.Status != ChequeStatus.Bounced)
                                        {
                                            if (c.DaysOverdue > 0)
                                            {
                                                <span class="badge bg-danger-subtle text-danger rounded-pill fs-9 mt-0.5">معوق (@c.DaysOverdue.Num() روز)</span>
                                            }
                                            else if (c.DueDate.Date == DateTime.Today)
                                            {
                                                <span class="badge bg-amber-subtle text-amber rounded-pill fs-9 mt-0.5">سررسید امروز</span>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @if (c.Status == ChequeStatus.Bounced)
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2.5">
                                                <i class="bi bi-x-octagon me-1"></i> برگشت خورده
                                            </span>
                                            @if (!string.IsNullOrEmpty(c.BounceReason))
                                            {
                                                <div class="fs-9 text-danger mt-1">@c.BounceReason</div>
                                            }
                                        }
                                        else if (c.IsCleared)
                                        {
                                            <span class="badge bg-emerald-subtle text-emerald border border-emerald-subtle rounded-pill px-2.5">
                                                <i class="bi bi-check2-all me-1"></i> وصول‌شده
                                            </span>
                                            @if (c.ClearedAt.HasValue)
                                            {
                                                <div class="fs-9 text-muted mt-0.5 num">@c.ClearedAt.Value.ToFa()</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5">
                                                <i class="bi bi-clock me-1"></i> در جریان وصول
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-1">
                                            @if (!c.IsCleared && c.Status != ChequeStatus.Bounced)
                                            {
                                                <button class="btn btn-sm btn-outline-success fin-btn-pill fs-9 py-1 px-2.5" title="وصول / پاس شدن چک" @onclick="() => ConfirmClearCheque(c)">
                                                    <i class="bi bi-check-lg me-1"></i> وصول
                                                </button>
                                                <button class="btn btn-sm btn-outline-danger fin-btn-pill fs-9 py-1 px-2" title="ثبت برگشت چک" @onclick="() => PromptBounce(c)">
                                                    <i class="bi bi-x-octagon"></i> برگشت
                                                </button>
                                            }
                                            else if (c.Status == ChequeStatus.Bounced)
                                            {
                                                <button class="btn btn-sm btn-success fin-btn-pill fs-9 py-1 px-2.5" title="وصول چک" @onclick="() => ConfirmClearCheque(c)">
                                                    <i class="bi bi-check-lg me-1"></i> وصول شد
                                                </button>
                                                <button class="btn btn-sm btn-light fin-btn-pill fs-9 py-1 px-2" title="بازگردانی" @onclick="() => ResetCheque(c)">
                                                    <i class="bi bi-arrow-counterclockwise"></i>
                                                </button>
                                            }
                                            else if (c.IsCleared)
                                            {
                                                <button class="btn btn-sm btn-light fin-btn-pill fs-9 py-1 px-2" title="لغو وضعیت وصولی" @onclick="() => ResetCheque(c)">
                                                    <i class="bi bi-arrow-counterclockwise me-1"></i> لغو وصول
                                                </button>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
    else
    {
        <!-- نوار فیلتر اقساط -->
        <div class="fin-filter-card mb-4">
            <div class="row g-2.5 align-items-end">
                <div class="col-12 col-md-6 col-xl-5">
                    <label class="fin-label">جستجوی نام مشتری، موبایل، تلفن یا شماره فاکتور</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control border-start-0 fin-input"
                               placeholder="جستجوی نام مشتری، تلفن، کد..."
                               @bind="installmentSearch" @bind:event="oninput" @onkeyup="ApplyInstallmentFilter" />
                    </div>
                </div>

                <div class="col-6 col-md-4 col-xl-4">
                    <label class="fin-label">وضعیت تسویه اقساط</label>
                    <select class="form-select form-select-sm fin-input" @bind="installmentPaidFilter" @bind:after="ApplyInstallmentFilter">
                        <option value="">همه اقساط</option>
                        <option value="false">پرداخت‌نشده / معوق (بدهکار)</option>
                        <option value="true">پرداخت‌شده (تسویه‌شده)</option>
                    </select>
                </div>

                <div class="col-6 col-md-2 col-xl-3 text-md-end pb-1">
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 num fs-8">
                        @filteredInstallments.Count.Num() قسط
                    </span>
                </div>
            </div>
        </div>

        <!-- جدول اقساط -->
        <div class="fin-table-card">
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                    <div class="text-secondary fs-8">در حال بارگذاری اقساط...</div>
                </div>
            }
            else if (filteredInstallments.Count == 0)
            {
                <div class="fin-empty-state text-center py-5">
                    <i class="bi bi-calendar-x fs-1 text-muted opacity-50"></i>
                    <div class="fw-bold text-secondary mt-2">هیچ قسطی یافت نشد</div>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table fin-table align-middle">
                        <thead>
                            <tr>
                                <th>نوبت قسط</th>
                                <th>مشتری بدهکار</th>
                                <th>شماره فاکتور</th>
                                <th class="text-start">مبلغ قسط (ریال)</th>
                                <th>تاریخ سررسید</th>
                                <th>وضعیت زمانی</th>
                                <th>وضعیت تسویه</th>
                                <th class="text-center" style="width: 140px;">عملیات تسویه</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in filteredInstallments)
                            {
                                <tr class="fin-table-row @(i.IsPaid ? "table-success-subtle" : i.DaysOverdue > 0 ? "table-danger-subtle" : "")">
                                    <td>
                                        <span class="badge bg-light text-dark border rounded-pill px-2.5 num">
                                            قسط @i.No.Num()
                                        </span>
                                    </td>
                                    <td>
                                        <div class="fw-700 text-dark">@i.PartyName</div>
                                        @if (!string.IsNullOrEmpty(i.PartyMobile))
                                        {
                                            <div class="fs-9 text-muted num">@i.PartyMobile</div>
                                        }
                                    </td>
                                    <td><span class="num fs-8 fw-700 text-indigo">@i.OrderNumber</span></td>
                                    <td class="text-start num fw-800 fs-7.5 @(i.IsPaid ? "text-emerald" : i.DaysOverdue > 0 ? "text-rose" : "text-dark")">
                                        @i.Amount.Money()
                                    </td>
                                    <td class="num fs-8 fw-600">@i.DueDate.ToFa()</td>
                                    <td>
                                        @if (i.IsPaid)
                                        {
                                            <span class="text-muted fs-8">—</span>
                                        }
                                        else if (i.DaysOverdue > 0)
                                        {
                                            <span class="badge bg-danger-subtle text-danger rounded-pill fs-9 fw-bold">معوق (@i.DaysOverdue.Num() روز)</span>
                                        }
                                        else if (i.DueDate.Date == DateTime.Today)
                                        {
                                            <span class="badge bg-amber-subtle text-amber rounded-pill fs-9">سررسید امروز</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info-subtle text-info rounded-pill fs-9">آتی</span>
                                        }
                                    </td>
                                    <td>
                                        @if (i.IsPaid)
                                        {
                                            <span class="badge bg-emerald-subtle text-emerald border border-emerald-subtle rounded-pill px-2.5">
                                                <i class="bi bi-check2-circle me-1"></i> پرداخت‌شده
                                            </span>
                                            @if (i.PaidAt.HasValue)
                                            {
                                                <div class="fs-9 text-muted mt-0.5 num">@i.PaidAt.Value.ToFa()</div>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger text-white rounded-pill px-2.5">
                                                <i class="bi bi-clock me-1"></i> پرداخت‌نشده (بدهکار)
                                            </span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        @if (!i.IsPaid)
                                        {
                                            <button class="btn btn-sm btn-success fin-btn-pill fs-9 py-1 px-3" title="تأیید وصول و تسویه قسط" @onclick="() => PayInstallment(i)">
                                                <i class="bi bi-check2 me-1"></i> تسویه قسط
                                            </button>
                                        }
                                        else
                                        {
                                            <button class="btn btn-sm btn-light fin-btn-pill fs-9 py-1 px-2.5" title="لغو تسویه قسط" @onclick="() => UnpayInstallment(i)">
                                                <i class="bi bi-arrow-counterclockwise me-1"></i> لغو تسویه
                                            </button>
                                        }
                                    </td>
                                </tr>
                            }
