    private async Task ToggleNeshanAsync(IncomingLetterListItemDto item)
    {
        try
        {
            if (item.ErjaId.HasValue) item.IsNeshan = await IncomingSvc.ToggleNeshanAsync(item.ErjaId.Value);
            else item.IsNeshan = await IncomingSvc.ToggleLetterNeshanAsync(item.LetterId);
            Toast.Success(item.IsNeshan ? "نامه نشان شد." : "نشان برداشت شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>
    /// «انطباق و بایگانی» با فرم: اول مودال انتخاب پوشهٔ بایگانی باز می‌شود و بعد از تأیید
    /// کاربر، نامه در همان پوشه بایگانی می‌گردد. پیش‌تر این دکمه بدون هیچ فرمی، وضعیت
    /// بایگانی را فوراً جابه‌جا می‌کرد و کاربر نمی‌توانست پوشه را انتخاب کند.
    /// اگر نامه ارجاعِ شخصی (ErjaId) داشته باشد، همان ارجاع بایگانی می‌شود؛ در غیر این صورت
    /// خودِ نامه (برای ثبت‌کننده/دبیرخانه) با ToggleLetterBayeganiAsync.
    /// </summary>
    private async Task ArchiveLetterAsync(IncomingLetterListItemDto item)
    {
        if (item.IsBayegani)
        {
            // خروج از بایگانی نیاز به پوشه ندارد و همان مسیر قبلی را می‌رود
            await ToggleBayeganiAsync(item);
            return;
        }
        try
        {
            if (folderPicker == null) return;
            var folderId = await folderPicker.PickAsync($"بایگانی نامه «{item.Title}»");
            if (folderId is not { } selected || selected <= 0) return; // کاربر انصراف داد

            if (item.ErjaId is { } erjaId)
            {
                await LetterSvc.ArchiveLettersAsync(new ArchiveLettersDto
                {
                    FolderId = selected,
                    ErjaIds = new List<int> { erjaId }
                });
            }
            else
            {
                // نامهٔ بدون ارجاع (ثبت‌کننده): فقط وضعیت بایگانی همان نامه عوض می‌شود
                await IncomingSvc.ToggleLetterBayeganiAsync(item.LetterId);
            }

            var details = activeDetail;
            if (details != null && details.LetterId == item.LetterId)
                activeDetail = await IncomingSvc.GetDetailAsync(item.LetterId);

            Toast.Success("نامه بایگانی شد.");
            await ReloadDataAsync();

            // ارجاعِ ردیفِ سمت راست (ریدر) باید با دادهٔ تازه هم‌خوان شود تا دکمه
            // «انطباق و بایگانی» بلافاصله جای خود را به وضعیت بایگانی بدهد.
            if (activeLetter != null && activeLetter.LetterId == item.LetterId)
                activeLetter = letters.FirstOrDefault(x => x.LetterId == item.LetterId) ?? activeLetter;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>
    /// بایگانی/خروج از بایگانیِ سریع (بدون انتخاب پوشه).
    /// اگر نامه ارجاعِ شخصی داشته باشد، پرچم همان ارجاع عوض می‌شود؛ در غیر این صورت
    /// (ثبت‌کننده/دبیرخانه) پرچم خودِ نامه — پیش‌تر در حالت دوم دکمه هیچ کاری نمی‌کرد.
    /// </summary>
    private async Task ToggleBayeganiAsync(IncomingLetterListItemDto item)
    {
        try
        {
            if (item.IsBayegani)
            {
                // خروج از بایگانی از مسیر «کامل» سرور: گره درختی حذف و همهٔ پرچم‌های
                // بایگانیِ همین کاربر برای این نامه آزاد می‌شود. پیش‌تر فقط یکی از پرچم‌ها
                // آزاد می‌شد و نامه از بایگانی بیرون می‌رفت ولی به «دریافتی» برنمی‌گشت.
                await IncomingSvc.UnarchiveLetterAsync(item.LetterId);
                item.IsBayegani = false;
                Toast.Success("از بایگانی خارج شد و به فهرست نامه‌ها برگشت.");
            }
            else
            {
                item.IsBayegani = item.ErjaId is { } erjaId
                    ? await IncomingSvc.ToggleBayeganiAsync(erjaId)
                    : await IncomingSvc.ToggleLetterBayeganiAsync(item.LetterId);
                Toast.Success(item.IsBayegani ? "نامه به بایگانی منتقل شد." : "از بایگانی خارج شد.");
            }

            if (activeDetail != null && activeDetail.LetterId == item.LetterId)
                activeDetail = await IncomingSvc.GetDetailAsync(item.LetterId);

            var keep = activeLetter;
            await ReloadDataAsync();
            if (bayeganiTree != null) await bayeganiTree.ReloadAsync();

            // ریدر باز می‌ماند و وضعیت تازهٔ همان نامه را نشان می‌دهد (ردیف ممکن است از
            // فهرست صفحهٔ بایگانی حذف شده باشد، ولی نمایش نامه نباید ناگهان بسته شود).
            if (readerOpen && keep != null && keep.LetterId == item.LetterId)
            {
                keep.IsBayegani = item.IsBayegani;
                activeLetter = keep;
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private void ToggleSelectErja(int erjaId)
    {
        if (selectedErjaIds.Contains(erjaId)) selectedErjaIds.Remove(erjaId);
        else selectedErjaIds.Add(erjaId);
    }

    private async Task BatchBayeganiAsync()
    {
        if (selectedErjaIds.Count == 0) return;
        try
        {
            if (folderPicker == null) return;
            var destination = await folderPicker.PickAsync("انتخاب پوشه برای بایگانی گروهی");
            if (destination is not { } folderId || folderId <= 0) return;
            await LetterSvc.ArchiveLettersAsync(new ArchiveLettersDto
            {
                FolderId = folderId,
                ErjaIds = selectedErjaIds.ToList()
            });
            Toast.Success($"{selectedErjaIds.Count.FaDigits()} نامه بایگانی گردید.");
            selectedErjaIds.Clear();
            await ReloadDataAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

