    /// <summary>کاربر جاری مجاز به افزودن پیوست/ویرایش این نامه است (ثبت‌کننده یا مدیر)</summary>
    private bool CanEditLetter => activeDetail?.CanEdit == true || Auth.IsAdmin;

    /// <summary>نشان‌کردن/برداشتن نشان از داخل ریدر — روی همان ردیف فهرست هم اعمال می‌شود</summary>
    private async Task ToggleStarReader()
    {
        if (activeDetail == null) return;
        try
        {
            var value = activeDetail.CurrentErja != null
                ? await IncomingSvc.ToggleNeshanAsync(activeDetail.CurrentErja.ErjaId)
                : await IncomingSvc.ToggleLetterNeshanAsync(activeDetail.LetterId);
            activeDetail.IsNeshan = value;
            var row = letters.FirstOrDefault(l => l.LetterId == activeDetail.LetterId);
            if (row != null) { row.IsNeshan = value; }
            if (activeDetail.CurrentErja != null) activeDetail.CurrentErja.IsNeshan = value;
            Toast.Success(value ? "نامه نشان شد." : "نشان برداشت شد.");
            StateHasChanged();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

