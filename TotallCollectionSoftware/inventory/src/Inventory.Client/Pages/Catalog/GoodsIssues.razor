@page "/goods-issues"
@implements IDisposable
@inject IAuthState Auth
@inject IGoodsIssueService IssueSvc
@inject IPartyService PartySvc
@inject ICompanyProfileService ProfileSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

@* =====================================================================
   حواله تحویل کالا — سند «فقط مقدار» (بدون هیچ مبلغ/ریالی)
   • دو روش افزودن قلم: (۱) انتخاب کالا از فهرست انبار — ستون «از انبار» یا دکمه
     «افزودن از انبار» — و (۲) تایپ آزاد نام کالا (بدون شناسهٔ کالا)
   • Enter = جابه‌جایی بین سطرها | F2 = سطر تازه | F1 = ذخیره
   • مشتری از فهرست + دکمه «مشتری جدید» با همان فرم تعریف مشتری (/parties)
   • چاپ A4 یا A5 با انتخاب هنگام چاپ
   ===================================================================== *@

<PageTitle>بیجک</PageTitle>

<div class="gi-screen">
    <div class="page-head">
        <div>
            <h1>بیجک</h1>
            <p class="lead">ثبت خروج کالا به مشتری — فقط مقدار، بدون قیمت</p>
        </div>
        <button class="btn btn-primary me-auto" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> حواله جدید
        </button>
    </div>

    @* ---------- فیلترها: جستجو → مشتری (فشرده) → بازهٔ تاریخ → اعمال ---------- *@
    <div class="card mb-3">
        <div class="card-body">
            <div class="gi-filters">
                <div class="gi-filter gi-filter-search">
                    <label class="form-label" for="gi-filter-search">جستجو</label>
                    <input id="gi-filter-search" class="form-control" @bind="search" @bind:event="oninput"
                           @onkeydown="OnSearchKeyDown" placeholder="شماره حواله، نام/تلفن مشتری یا کالا…" />
                </div>
                <div class="gi-filter gi-filter-party">
                    <label class="form-label">مشتری</label>
                    <SearchSelect Items="partyLookup" Value="filterPartyId" ValueChanged="OnFilterPartyChanged"
                                  Placeholder="همه مشتری‌ها" />
                </div>
                <div class="gi-filter gi-filter-date">
                    <label class="form-label">از تاریخ</label>
                    <DatePicker @bind-Value="from" AllowClear="true" Placeholder="از تاریخ" />
                </div>
                <div class="gi-filter gi-filter-date">
                    <label class="form-label">تا تاریخ</label>
                    <DatePicker @bind-Value="to" AllowClear="true" Placeholder="تا تاریخ" />
                </div>
                <div class="gi-filter gi-filter-apply">
                    <button id="btn-apply-filter" class="btn btn-primary w-100" @onclick="ApplyFilter" disabled="@loading">
                        @if (loading)
                        {
                            <span class="spinner-border spinner-border-sm me-1" role="status" aria-hidden="true"></span>
                        }
                        else
                        {
                            <i class="bi bi-funnel"></i>
                        }
                        اعمال فیلتر
                    </button>
                </div>
            </div>
        </div>
    </div>

    @* ---------- فهرست حواله‌ها ---------- *@
    <div class="card">
        <div class="card-body p-0">
            @if (items.Count >= ListCap && !loading)
            {
                <div class="gi-cap-hint">
                    <i class="bi bi-info-circle"></i>
                    @ListCap.Num() حوالهٔ آخر نمایش داده شده است؛ برای دیدن بقیه بازهٔ تاریخ یا مشتری را محدود کنید.
                </div>
            }
            @if (loading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status" aria-hidden="true"></div>
                    <div class="text-muted mt-2 small">در حال دریافت حواله‌ها…</div>
                </div>
            }
            else if (items.Count == 0)
            {
                <div class="empty-state"><i class="bi bi-box-seam"></i><h5>حواله‌ای ثبت نشده است</h5></div>
            }
            else
            {
                <div class="table-responsive grid-desktop">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr>
                                <th>شماره حواله</th>
                                <th>تاریخ</th>
                                <th>مشتری</th>
                                <th>اقلام</th>
                                <th>جمع مقدار</th>
                                <th>توضیحات</th>
                                <th class="text-end">عملیات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in items)
                            {
                                <tr>
                                    <td class="doc-number fw-700 text-primary">@g.Number</td>
                                    <td class="text-muted">@g.Date.ToFa()</td>
                                    <td class="fw-500">@g.PartyName</td>
                                    <td><span class="badge badge-soft-primary">@g.LineCount.Num() قلم</span></td>
                                    <td class="num fw-700">@g.TotalQuantity.Qty()</td>
                                    <td class="text-muted text-truncate" style="max-width:220px">@(g.Description ?? "—")</td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-light" title="مشاهده" disabled="@busy" @onclick="() => View(g)"><i class="bi bi-eye text-primary"></i></button>
                                        <button class="btn btn-sm btn-light" title="ویرایش" disabled="@busy" @onclick="() => OpenEdit(g)"><i class="bi bi-pencil text-primary"></i></button>
                                        <button class="btn btn-sm btn-light" title="چاپ" disabled="@busy" @onclick="() => Print(g)"><i class="bi bi-printer text-secondary"></i></button>
                                        @if (CanDelete)
                                        {
                                            <button class="btn btn-sm btn-light" title="حذف" disabled="@busy" @onclick="() => Delete(g)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @* ---------- نمای کارتی (موبایل) ---------- *@
                <div class="cards-mobile">
                    @foreach (var g in items)
                    {
                        <div class="m-card st-ready">
                            <div class="m-card-head">
                                <div class="m-card-icon"><i class="bi bi-box-seam"></i></div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="doc-number fw-800 text-primary">@g.Number</span>
                                        <span class="badge badge-soft-primary">@g.LineCount.Num() قلم</span>
                                    </div>
                                    <div class="fw-700 text-truncate">@g.PartyName</div>
                                    <div class="fs-8 text-muted">@g.Date.ToFa() — جمع مقدار: <span class="num">@g.TotalQuantity.Qty()</span></div>
                                </div>
                            </div>
                            <div class="m-card-body">
                                @if (!string.IsNullOrWhiteSpace(g.Description))
                                {
                                    <div class="fs-8 text-muted mb-2">@g.Description</div>
                                }
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-light flex-fill" @onclick="() => View(g)"><i class="bi bi-eye text-primary"></i> مشاهده</button>
                                    <button class="btn btn-sm btn-light flex-fill" @onclick="() => OpenEdit(g)"><i class="bi bi-pencil text-primary"></i> ویرایش</button>
                                    <button class="btn btn-sm btn-light flex-fill" @onclick="() => Print(g)"><i class="bi bi-printer text-secondary"></i> چاپ</button>
                                    @if (CanDelete)
                                    {
                                        <button class="btn btn-sm btn-light flex-fill" @onclick="() => Delete(g)"><i class="bi bi-trash text-danger"></i> حذف</button>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@* ==================== فرم حواله ==================== *@
<Modal Visible="showForm" Title="@FormTitle" Size="modal-xl" OnClose="CloseForm">
    <ChildContent>
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else
        {
            <div class="row g-3 mb-3">
                @* --- مشتری + دکمهٔ فرم مشترک تعریف مشتری --- *@
                <div class="col-md-6">
                    <label class="form-label">مشتری <span class="text-danger">*</span></label>
                    @if (viewing)
                    {
                        <input class="form-control" value="@form.PartyName" disabled />
                    }
                    else
                    {
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1">
                                <SearchSelect Items="partyLookup" Value="form.PartyId" ValueChanged="OnPartyChanged" Placeholder="انتخاب مشتری…" />
                            </div>
                            <button type="button" class="btn btn-outline-primary text-nowrap" @onclick="OpenNewParty"
                                    title="تعریف مشتری جدید — همان فرم طرف حسابها">
                                <i class="bi bi-person-plus"></i> مشتری جدید
                            </button>
                        </div>
                        <div class="fs-8 text-muted mt-1">اگر مشتری در فهرست نیست، با همان فرم «تعریف مشتری» طرف حسابها ثبتش کنید.</div>
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">تاریخ <span class="text-danger">*</span></label>
                    @if (viewing)
                    {
                        <input class="form-control" value="@form.Date.ToFa()" disabled />
                    }
                    else
                    {
                        <DatePicker @bind-Value="date" />
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">شماره حواله</label>
                    <input class="form-control" value="@(editing ? form.Number : "خودکار")" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label">انبار (اختیاری)</label>
                    @if (viewing)
                    {
                        <input class="form-control" value="@(form.WarehouseName ?? "—")" disabled />
                    }
                    else
                    {
                        <SearchSelect Items="warehouseLookup" Value="@(form.WarehouseId ?? 0)" ValueChanged="v => form.WarehouseId = v > 0 ? v : null" Placeholder="انتخاب انبار…" />
                    }
                    <div class="fs-8 text-muted">فقط برای ثبت در بیجک؛ موجودی تغییر نمی‌کند و فهرست کالاها موجودی کل را نشان می‌دهد.</div>
                </div>
                <div class="col-12">
                    <label class="form-label">توضیحات</label>
                    <input class="form-control" @bind="form.Description" disabled="@viewing" placeholder="اختیاری" />
                </div>
            </div>

            @* --- اقلام حواله: انتخاب از انبار یا نام آزاد + فقط مقدار --- *@
            <div class="gi-lines-head">
                <div class="fw-700">
                    <i class="bi bi-boxes text-primary ms-1"></i>اقلام حواله
                    <span class="fs-8 fw-400 text-muted">— از انبار یا نام آزاد، بدون قیمت</span>
                </div>
                @if (!viewing)
                {
                    <div class="d-flex gap-2 flex-wrap">
                        @* افزودن قلم از فهرست انبار — روش اول و پیدا‌ترین راه ورود کالا *@
                        <button type="button" id="btn-add-from-stock" class="btn btn-sm btn-outline-primary" @onclick="OpenStockPicker">
                            <i class="bi bi-box-arrow-in-down"></i> افزودن از انبار
                        </button>
                        <button type="button" id="btn-add-line" class="btn btn-sm btn-primary" data-hotkey="f2" @onclick="AddEmptyLine">
                            <i class="bi bi-plus-lg"></i> سطر تازه (F2)
                        </button>
                    </div>
                }
            </div>

            <div class="table-responsive">
                <table class="table table-sm align-middle gi-lines">
                    <thead>
                        <tr>
                            <th style="width:46px">#</th>
                            <th style="width:230px">از انبار</th>
                            <th>نام کالا <span class="fw-400 text-muted fs-8">(دستی)</span></th>
                            <th style="width:150px">مقدار</th>
                            <th style="width:56px" class="text-end">حذف</th>
                        </tr>
                    </thead>
                    <tbody>
                        @for (var i = 0; i < form.Lines.Count; i++)
                        {
                            var idx = i;              // متغیر تازه در هر تکرار تاclosure درست بماند
                            var line = form.Lines[i];
                            <tr>
                                <td class="gi-row-no">@(idx + 1)</td>
                                <td data-label="از انبار">
                                    @if (viewing)
                                    {
                                        <span class="text-muted fs-8">@(line.ProductId > 0 ? "انتخاب از انبار" : "نام دستی")</span>
                                    }
                                    else
                                    {
                                        @* انتخاب کالا از موجودی انبار؛ خالی گذاشتنش یعنی «نام دستی» *@
                                        <SearchSelect Items="productLookup"
                                                      CssClass="gi-cell gi-picker"
                                                      ConstrainToModal="true"
                                                      ShowAllOnFocus="true"
                                                      Value="line.ProductId"
                                                      ValueChanged="id => OnProductPickedAsync(idx, line, id)"
                                                      Placeholder="از انبار انتخاب کنید…" />
                                    }
                                </td>
                                <td>
                                    <input id="gi-name-@idx" class="form-control form-control-sm gi-cell" value="@line.ProductName"
                                           @oninput="e => SetName(line, e.Value?.ToString())"
                                           @onkeydown="e => OnNameKey(e, idx)"
                                           disabled="@viewing" placeholder="نام کالا…" />
                                    @if (line.ProductId > 0 && SelectedProduct(line) is { } chosen)
                                    {
                                        <small class="gi-stock-hint @(OverStock(line) ? "is-over" : "")">
                                            موجودی انبار: @Fa.Digits(chosen.TotalStock.ToString("#,##0.###")) @chosen.Unit
                                            @if (OverStock(line)) { <text> — بیش از موجودی</text> }
                                        </small>
                                    }
                                </td>
                                <td>
                                    <input id="gi-qty-@idx" type="number" min="0" step="any" class="form-control form-control-sm gi-cell num"
                                           @bind="line.Quantity" @onkeydown="e => OnQtyKey(e, idx)"
                                           disabled="@viewing" dir="ltr" placeholder="0" />
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-sm btn-light" title="حذف سطر"
                                            disabled="@viewing" @onclick="() => RemoveLine(line)">
                                        <i class="bi bi-trash text-danger"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th colspan="3" class="text-end">جمع کل مقدار</th>
                            <th class="num gi-total">@form.TotalQuantity.Qty()</th>
                            <th></th>
                        </tr>
                    </tfoot>
                </table>
            </div>

            @if (!viewing)
            {
                <div class="gi-hints">
                    <span><kbd>Enter</kbd> سطر بعدی</span>
                    <span><kbd>F2</kbd> سطر تازه</span>
                    <span>«افزودن از انبار» برای انتخاب کالا از موجودی</span>
                    <span><kbd>F1</kbd> ذخیره</span>
                    <span><kbd>Esc</kbd> انصراف</span>
                </div>
            }
        }
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="CloseForm">@(viewing ? "بستن" : "انصراف (Esc)")</button>
        @if (viewing)
        {
            <button class="btn btn-outline-primary" data-hotkey="f4" @onclick="PrintCurrent"><i class="bi bi-printer"></i> چاپ (F4)</button>
        }
        else
        {
            <button class="btn btn-primary" data-hotkey="f1" @onclick="Save" disabled="@saving">
                @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
                ذخیره (F1)
            </button>
        }
    </Footer>
</Modal>

@* ==================== تعریف مشتری ====================
   همان کامپوننت فرم «طرف حسابها» (/parties) — هیچ فرم موازی/خلاصهای در این صفحه
   تعریف نمیشود تا فیلدها، اعتبارسنجی و قواعد معرف در همهجا یکسان باشند.
   ============================================================= *@
@* ==================== انتخاب کالا از انبار (چند انتخابی) ====================
   فهرست کالاهای انباری با موجودی؛ هر کلیک یک سطر به اقلام اضافه می‌کند و پنجره
   باز می‌ماند تا چند کالا سریع اضافه شود. تایپ آزاد نام هم مستقل از این پنجره
   در ستون «نام کالا (دستی)» کار می‌کند.
   ========================================================================== *@
<Modal Visible="showStockPicker" Title="افزودن کالا از انبار" Size="modal-lg" OnClose="CloseStockPicker">
    <ChildContent>
        <div class="gi-picker-search">
            <input id="gi-stock-search" class="form-control" @bind="stockSearch" @bind:event="oninput"
                   placeholder="جستجوی نام یا کد کالا…" />
            <button type="button" id="btn-reload-stock" class="btn btn-light" @onclick="() => LoadProductOptionsAsync(true)">
                <i class="bi bi-arrow-clockwise"></i> بازخوانی
            </button>
        </div>
        <div class="fs-8 text-muted mb-2">
            روی هر کالا بزنید تا یک سطر با مقدار ۱ به اقلام اضافه شود؛ پنجره باز می‌ماند تا چند کالا اضافه کنید.
        </div>
        @if (productOptionsLoading)
        {
            <div class="text-center py-4 text-muted">
                <span class="spinner-border spinner-border-sm ms-1"></span> در حال دریافت فهرست انبار…
            </div>
        }
        else if (productOptions.Count == 0)
        {
            <div class="alert alert-warning mb-0">
                فهرست کالاهای انبار خالی است (یا دریافت نشد). «بازخوانی» را بزنید یا نام کالا را دستی در سطر وارد کنید.
            </div>
        }
        else
        {
            <div class="gi-picker-list">
                @foreach (var option in FilteredStockOptions)
                {
                    <button type="button" class="gi-picker-item" @onclick="() => AddFromStock(option)">
                        <span class="gi-picker-name">@option.Name</span>
                        <span class="gi-picker-meta">
                            @option.Code · موجودی: @Fa.Digits(option.TotalStock.ToString("#,##0.###")) @option.Unit
                            @if (!option.IsActive) { <text> · غیرفعال</text> }
                        </span>
                    </button>
                }
                @if (FilteredStockOptions.Count == 0)
                {
                    <div class="text-muted py-3 text-center">کالایی با این عبارت پیدا نشد.</div>
                }
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="CloseStockPicker">بستن</button>
    </Footer>
</Modal>

<PartyFormModal ShopQuickCreate="true" Visible="showNewParty"
                Type="PartyType.Customer"
                AllowReferrerPicker="true"
                OnSaved="OnNewPartySaved"
                OnCancel="CloseNewParty" />

<style>
    /* ---------- نوار فیلتر: جستجو → مشتری (فشرده) → بازهٔ تاریخ → اعمال ---------- */
    .gi-filters { display: flex; flex-wrap: wrap; gap: .75rem; align-items: flex-end; }
    .gi-filter { display: flex; flex-direction: column; min-width: 0; }
    .gi-filter .form-label { margin-bottom: .25rem; font-size: .8rem; color: #475569; }
    /* جستجو بیشترین جا را می‌گیرد؛ مشتری و تاریخ‌ها فشرده و ثابت‌ترند. */
    .gi-filter-search { flex: 1 1 320px; }
    .gi-filter-party { flex: 0 1 200px; max-width: 240px; }
    .gi-filter-date { flex: 0 1 135px; max-width: 160px; }
    .gi-filter-apply { flex: 0 0 auto; }
    .gi-cap-hint {
        display: flex; align-items: center; gap: .4rem; padding: .5rem .9rem;
        font-size: .8rem; color: #92400e; background: #fffbeb; border-bottom: 1px solid #fde68a;
    }
    @@media (max-width: 767.98px) {
        .gi-filter-search, .gi-filter-party, .gi-filter-date { flex: 1 1 100%; max-width: none; }
        .gi-filter-apply { flex: 1 1 100%; }
    }

    /* ---------- سربرگ بخش اقلام + راهنای کلیدها ---------- */
    .gi-lines-head {
        display: flex; align-items: center; justify-content: space-between;
        gap: .75rem; flex-wrap: wrap; margin-bottom: .5rem;
    }
    .gi-lines .gi-cell { min-width: 90px; }
    .gi-lines .gi-row-no { color: #94a3b8; font-weight: 700; font-size: .85rem; }
    .gi-lines tfoot th { background: #f8fafc; border-top: 2px solid #e2e8f0; }
    .gi-lines .gi-total { color: #4f46e5; font-size: 1.05rem; }
    .gi-hints { display: flex; gap: 1rem; flex-wrap: wrap; margin-top: .6rem; font-size: .78rem; color: #64748b; }
    .gi-lines .gi-picker { min-width: 200px; }
    .gi-lines .gi-stock-hint { display: block; margin-top: 2px; font-size: .72rem; color: #64748b; }
    .gi-lines .gi-stock-hint.is-over { color: #dc2626; font-weight: 600; }
    /* ---------- پنجرهٔ انتخاب کالا از انبار ---------- */
    .gi-picker-search { display: flex; gap: .5rem; margin-bottom: .5rem; }
    .gi-picker-list {
        max-height: 52vh; overflow-y: auto; border: 1px solid #e2e8f0; border-radius: 10px;
        background: #fff; padding: .25rem;
    }
    .gi-picker-item {
        display: flex; flex-direction: column; align-items: flex-start; gap: 2px;
        width: 100%; text-align: right; border: 0; background: transparent;
        padding: .5rem .65rem; border-radius: 8px; cursor: pointer;
    }
    .gi-picker-item:hover, .gi-picker-item:focus-visible { background: #eef2ff; }
    .gi-picker-item .gi-picker-name { font-weight: 600; color: #1e293b; }
    .gi-picker-item .gi-picker-meta { font-size: .74rem; color: #64748b; }
    .gi-hints kbd {
        background: #eef2ff; color: #4338ca; border: 1px solid #c7d2fe; border-bottom-width: 2px;
        border-radius: 5px; padding: 1px 6px; font-size: .72rem; font-family: inherit;
    }

</style>

@code {
    // ---------- فهرست ----------
    private List<GoodsIssueDto> items = new();
    private List<LookupItem> partyLookup = new();
    private List<LookupItem> warehouseLookup = new();
    /// <summary>بارگذاری فهرست (فقط برای Load) — اسپینر جدول به این وابسته است.</summary>
    private bool loading = true;

    /// <summary>کار جاری روی یک رکورد (ویرایش/مشاهده/حذف/چاپ) — اسپینر جدول را روشن نمی‌کند.</summary>
    private bool busy;

    /// <summary>شمارهٔ آخرین بارگذاری فهرست — پاسخ‌های کهنه با آن دور ریخته می‌شوند.</summary>
    private int loadVersion;

    /// <summary>درخواست در جریان فهرست؛ با هر فیلتر تازه لغو می‌شود.</summary>
    private CancellationTokenSource? loadCts;

    /// <summary>هم‌اندازهٔ سقف سرور: تازه‌ترین ۲۰۰ حواله.</summary>
    private const int ListCap = 200;

    // ---------- انتخاب کالا از انبار (در کنار ورود نام دستی) ----------
    private List<GoodsIssueProductOptionDto> productOptions = new();
    private List<LookupItem> productLookup = new();
    private bool productOptionsLoading;

    private int filterPartyId;
    private DateTime? from, to;
    private string? search;

    // ---------- فرم ----------
    private bool showForm, saving;

    /// <summary>حالت «فقط مشاهده» — همه فیلدها غیرفعال و دکمه ذخیره پنهان است.</summary>
    private bool viewing;

    private GoodsIssueDto form = new();
    private DateTime? date;

    // ---------- تعریف مشتری (همان فرم مشترک /parties) ----------
    private bool showNewParty;

    private bool editing => form.Id != 0;
    private string FormTitle => viewing ? $"\u0645\u0634\u0627\u0647\u062f\u0647 \u062d\u0648\u0627\u0644\u0647 {form.Number}"
        : editing ? $"\u0648\u06cc\u0631\u0627\u06cc\u0634 \u062d\u0648\u0627\u0644\u0647 {form.Number}"
        : "\u062d\u0648\u0627\u0644\u0647 \u062a\u062d\u0648\u06cc\u0644 \u06a9\u0627\u0644\u0627 \u062c\u062f\u06cc\u062f";

    /// <summary>حذف حواله نیاز به مجوز مستقل دارد.</summary>
    private bool CanDelete => ShopAccess.CanManage(Auth, "GoodsIssue") || Auth.Has("GoodsIssues.Delete");

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("بیجک");
        // فهرست‌های کمکی (مشتری/انبار) موازی با فهرست اصلی خوانده می‌شوند؛ اسپینر جدول
        // فقط به همان یک کوئری فهرست وابسته است و منتظر فهرست‌های سنگین نمی‌ماند.
        var lookups = LoadLookups();
        await Load();
        await lookups;
    }

    private async Task LoadLookups()
    {
        try
        {
            partyLookup = ShopAccess.CanSee(Auth, "GoodsIssue")
                ? await PartySvc.GetShopCustomerLookupsAsync("goods-issue")
                : await PartySvc.GetLookupsAsync(PartyType.Customer, activeOnly: true);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }

        try { warehouseLookup = await IssueSvc.GetWarehouseOptionsAsync(); }
        catch (Exception ex) { Toast.Error("فهرست انبارها دریافت نشد. " + ex.Message); }
        // فهرست کالاهای انباری (تا ۱۰٬۰۰۰ قلم با موجودی) عمداً اینجا خوانده نمی‌شود:
        // فقط هنگام باز شدن فرم/انتخاب‌گر لازم است و همان‌جا با LoadProductOptionsAsync می‌آید.
    }

    /// <summary>
    /// فهرست کالاهای انباری با موجودی برای انتخاب‌گر سطرها. شکست این فراخوانی ورود
    /// دستی نام کالا را نمی‌بندد؛ فقط انتخاب از انبار در دسترس نیست.
    /// </summary>
    private async Task LoadProductOptionsAsync(bool force = false)
    {
        if (productOptionsLoading || (productLookup.Count > 0 && !force)) return;
        productOptionsLoading = true;
        try
        {
            productOptions = await IssueSvc.GetProductOptionsAsync() ?? new();
            productLookup = productOptions.Select(p => new LookupItem
            {
                Id = p.Id,
                Name = p.DisplayName,
                InfoText = ProductInfoText(p)
            }).ToList();
        }
        catch (Exception ex)
        {
            productOptions = new();
            productLookup = new();
            Toast.Error("فهرست کالاهای انبار دریافت نشد؛ کالا را دستی وارد کنید. " + ex.Message);
        }
        finally { productOptionsLoading = false; }
    }

    private static string ProductInfoText(GoodsIssueProductOptionDto p)
    {
        var text = $"موجودی: {Fa.Digits(p.TotalStock.ToString("#,##0.###"))} {p.Unit}";
        if (!string.IsNullOrWhiteSpace(p.WarehouseName)) text += $" · انبار: {p.WarehouseName}";
        if (!p.IsActive) text += " · غیرفعال";
        return text;
    }

    private GoodsIssueProductOptionDto? SelectedProduct(GoodsIssueLineDto line) =>
        line.ProductId > 0 ? productOptions.FirstOrDefault(x => x.Id == line.ProductId) : null;

    /// <summary>مقدار سطر از موجودی انبار بیشتر است (فقط هشدار نمایشی؛ بیجک موجودی را کم نمی‌کند).</summary>
    private bool OverStock(GoodsIssueLineDto line) => SelectedProduct(line) is { } p && line.Quantity > p.TotalStock;

    private async Task Load()
    {
        // بازهٔ تاریخ: شروع نباید پس از پایان باشد (قاعدهٔ مشترک همهٔ فیلترها)
        if (DateRangeFilter.IsInvalid(from, to)) { Toast.Error(DateRangeFilter.InvalidMessage); return; }

        // هر بارگذاری، بارگذاریِ در جریانِ قبلی را کنار می‌گذارد: هم درخواست قبلی
        // لغو می‌شود و هم پاسخ دیررسِ آن دیگر روی فهرست نمی‌نشیند. علت اصلی
        // «چرخیدن بی‌پایان اسپینر» همین بود که چند بارگذاری هم‌زمان روی هم می‌افتادند.
        var version = ++loadVersion;
        loadCts?.Cancel();
        loadCts?.Dispose();
        var cts = new CancellationTokenSource(LoadTimeout);
        loadCts = cts;

        loading = true;
        try
        {
            var result = await IssueSvc.GetAsync(filterPartyId > 0 ? filterPartyId : null, from, to, search, cts.Token);
            if (version != loadVersion) return;
            items = result ?? new();
        }
        catch (OperationCanceledException) when (version != loadVersion)
        {
            // درخواست تازه‌تری جای این را گرفته — خطا نیست و پیامی هم ندارد
        }
        catch (OperationCanceledException)
        {
            if (version != loadVersion) return;
            items = new();
            Toast.Error(LoadTimeoutMessage);
        }
        catch (Exception ex)
        {
            if (version != loadVersion) return;
            items = new();
            Toast.Error(ex.Message);
        }
        finally
        {
            if (version == loadVersion)
            {
                loading = false;
                if (ReferenceEquals(loadCts, cts)) loadCts = null;
                cts.Dispose();
            }
        }
    }

    /// <summary>سقف انتظار فهرست در کلاینت: پس از آن پیام روشن به کاربر و توقف اسپینر.</summary>
    private static readonly TimeSpan LoadTimeout = TimeSpan.FromSeconds(45);
    private const string LoadTimeoutMessage = "دریافت فهرست حواله‌ها طول کشید و لغو شد؛ دوباره «اعمال فیلتر» را بزنید یا بازهٔ تاریخ/مشتری را محدودتر کنید.";

    private async Task OnFilterPartyChanged(int v)
    {
        filterPartyId = v;
        await Load();
    }

    /// <summary>اعمال فیلتر — await می‌شود تا پایان کار، رندر و خاموش‌شدن اسپینر تضمین شود.</summary>
    private async Task ApplyFilter() => await Load();

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await Load();
    }

    /// <summary>لغو درخواست در جریان هنگام ترک صفحه؛ پاسخ دیررس روی یک کامپوننت حذف‌شده نمی‌نشیند.</summary>
    public void Dispose()
    {
        ++loadVersion;
        loadCts?.Cancel();
        loadCts?.Dispose();
        loadCts = null;
    }

    // ============================ فرم ============================

    private async Task OpenNew()
    {
        form = new GoodsIssueDto { Date = DateTime.Today };
        date = DateTime.Today;
        // یک سطر خالی آمادهٔ تایپ — ورود سریع بدون کلیک اضافه
        form.Lines.Add(new GoodsIssueLineDto());
        viewing = false;
        showForm = true;
        // انبارهای تازه تعریف‌شده نیز بدون خروج از صفحه دیده شوند.
        try { warehouseLookup = await IssueSvc.GetWarehouseOptionsAsync(); }
        catch (Exception ex) { Toast.Error("فهرست انبارها دریافت نشد. " + ex.Message); }
        await LoadProductOptionsAsync();
    }

    private async Task OpenEdit(GoodsIssueDto g)
    {
        busy = true;
        showForm = true;
        viewing = false;
        try
        {
            var full = await IssueSvc.GetAsync(g.Id);
            if (full is null) { Toast.Error("حواله یافت نشد."); showForm = false; return; }
            form = full;
            if (full.WarehouseId is > 0 && !warehouseLookup.Any(w => w.Id == full.WarehouseId))
                warehouseLookup.Add(new LookupItem { Id = full.WarehouseId.Value, Name = full.WarehouseName ?? "انبار ثبت‌شده" });
            date = full.Date;
            if (form.Lines.Count == 0) form.Lines.Add(new GoodsIssueLineDto());
            await LoadProductOptionsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); showForm = false; }
        finally { busy = false; }
    }

    private async Task View(GoodsIssueDto g)
    {
        busy = true;
        showForm = true;
        viewing = true;
        try
        {
            var full = await IssueSvc.GetAsync(g.Id);
            if (full is null) { Toast.Error("حواله یافت نشد."); showForm = false; return; }
            form = full;
            date = full.Date;
        }
        catch (Exception ex) { Toast.Error(ex.Message); showForm = false; }
        finally { busy = false; }
    }

    private void CloseForm()
    {
        showForm = false;
        viewing = false;
    }

    private void OnPartyChanged(int v)
    {
        form.PartyId = v;
        var name = partyLookup.FirstOrDefault(p => p.Id == v)?.Name;
        if (!string.IsNullOrEmpty(name)) form.PartyName = name;
    }

    // ---------- انتخاب کالا از انبار (پنجرهٔ چند‌انتخابی) ----------

    private bool showStockPicker;
    private string? stockSearch;

    /// <summary>سقف ردیف‌های قابل نمایش در پنجرهٔ انتخاب (بقیه با جستجو پیدا می‌شوند).</summary>
    private const int StockPickerPageSize = 60;

    private List<GoodsIssueProductOptionDto> FilteredStockOptions
    {
        get
        {
            IEnumerable<GoodsIssueProductOptionDto> q = productOptions;
            var term = stockSearch?.Trim();
            if (!string.IsNullOrEmpty(term))
                q = q.Where(p => p.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                              || (p.Code ?? "").Contains(term, StringComparison.OrdinalIgnoreCase));
            return q.OrderBy(p => p.Name).ThenBy(p => p.Id).Take(StockPickerPageSize).ToList();
        }
    }

    private async Task OpenStockPicker()
    {
        if (viewing) return;
        showStockPicker = true;
        stockSearch = null;
        await LoadProductOptionsAsync();
    }

    private void CloseStockPicker()
    {
        showStockPicker = false;
        stockSearch = null;
    }

    /// <summary>
    /// افزودن کالای انتخاب‌شده به اقلام بیجک: سطر نیمه‌خالی آخر (بدون نام/شناسه) پر
    /// می‌شود تا سطر خالی اضافه نماند؛ در غیر این صورت سطر تازه ساخته می‌شود.
    /// مقدار پیش‌فرض ۱ است (کاربر معمولاً یک کارتن/عدد می‌دهد و در صورت نیاز عوض می‌کند).
    /// </summary>
    private void AddFromStock(GoodsIssueProductOptionDto option)
    {
        if (viewing) return;
        var line = form.Lines.FirstOrDefault(l => l.ProductId == 0
            && string.IsNullOrWhiteSpace(l.ProductName) && l.Quantity <= 0);
        if (line is null)
        {
            line = new GoodsIssueLineDto();
            form.Lines.Add(line);
        }
        line.ProductId = option.Id;
        line.ProductName = option.Name;
        line.Quantity = 1;
        Toast.Info($"«{option.Name}» به اقلام اضافه شد.");
    }

    // ---------- سطرها ----------

    /// <summary>سطر تازه (F2) — فوکوس بعد از رندر روی نام کالای سطر جدید می‌رود.</summary>
    private void AddEmptyLine()
    {
        if (viewing) return;
        form.Lines.Add(new GoodsIssueLineDto());
        pendingFocusRow = form.Lines.Count - 1;   // در OnAfterRenderAsync فوکوس می‌شود
    }

    /// <summary>شماره ردیفی که بعد از رندر باید فوکوس شود.</summary>
    private int? pendingFocusRow;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (pendingFocusRow is int row)
        {
            pendingFocusRow = null;
            await JS.InvokeVoidAsync("focusById", $"gi-name-{row}", true);
        }
    }

    private void RemoveLine(GoodsIssueLineDto line)
    {
        if (viewing) return;
        form.Lines.Remove(line);
        if (form.Lines.Count == 0) form.Lines.Add(new GoodsIssueLineDto());
    }

    /// <summary>
    /// نام کالا دستی تایپ می‌شود. اگر متن دیگر با «کالای انتخاب‌شده از انبار» یکی نیست،
    /// سطر به «نام آزاد» برمی‌گردد و شناسهٔ کالا پاک می‌شود تا سند گمراه‌کننده نباشد.
    /// </summary>
    private void SetName(GoodsIssueLineDto line, string? text)
    {
        line.ProductName = text ?? "";
        if (line.ProductId <= 0) return;
        var chosen = SelectedProduct(line);
        if (chosen is null || !string.Equals(line.ProductName.Trim(), chosen.Name, StringComparison.Ordinal))
            line.ProductId = 0;
    }

    /// <summary>
    /// انتخاب کالا از موجودی انبار: نام و شناسهٔ کالا در سطر می‌نشیند، مقدار خالی یک
    /// می‌شود و فوکوس به مقدار همان سطر می‌رود. هیچ اثری روی موجودی ندارد.
    /// </summary>
    private async Task OnProductPickedAsync(int idx, GoodsIssueLineDto line, int productId)
    {
        if (viewing) return;
        var chosen = productId > 0 ? productOptions.FirstOrDefault(x => x.Id == productId) : null;
        if (chosen is null)
        {
            line.ProductId = 0;   // پاک‌کردن انتخاب → همان نام دستی باقی می‌ماند
            return;
        }
        line.ProductId = chosen.Id;
        line.ProductName = chosen.Name;
        if (line.Quantity <= 0) line.Quantity = 1;
        await JS.InvokeVoidAsync("focusById", $"gi-qty-{idx}", true);
    }

    /// <summary>Enter روی نام کالا → برو به مقدار همان سطر.</summary>
    private async Task OnNameKey(KeyboardEventArgs e, int idx)
    {
        if (e.Key == "Enter") await JS.InvokeVoidAsync("focusById", $"gi-qty-{idx}", true);
    }

    /// <summary>Enter روی مقدار → سطر بعدی؛ اگر سطر آخر بود، سطر تازه ساخته و فوکوس می‌شود.</summary>
    private async Task OnQtyKey(KeyboardEventArgs e, int idx)
    {
        if (e.Key != "Enter" || viewing) return;
        if (idx + 1 < form.Lines.Count)
            await JS.InvokeVoidAsync("focusById", $"gi-name-{idx + 1}", true);
        else
            AddEmptyLine();   // سطر آخر: Enter سطر تازه می‌سازد
    }

    // ---------- ذخیره ----------

    private async Task Save()
    {
        if (saving) return;
        if (viewing) { CloseForm(); return; }
        if (form.PartyId <= 0) { Toast.Error("مشتری را انتخاب کنید."); return; }

        // سطرهای کاملاً خالی (نه نام، نه مقدار) نادیده گرفته می‌شوند تا ورود سریع اذیت نشود
        var real = form.Lines.Where(l => !string.IsNullOrWhiteSpace(l.ProductName) || l.Quantity > 0).ToList();
        if (real.Count == 0) { Toast.Error("حداقل یک کالا با مقدار وارد کنید."); return; }
        for (var i = 0; i < real.Count; i++)
        {
            if (string.IsNullOrWhiteSpace(real[i].ProductName)) { Toast.Error($"نام کالای سطر {i + 1} را وارد کنید."); return; }
            if (real[i].Quantity <= 0) { Toast.Error($"مقدار سطر {i + 1} را وارد کنید."); return; }
        }

        saving = true;
        try
        {
            await IssueSvc.SaveAsync(new GoodsIssueCommand
            {
                Id = form.Id,
                Date = date ?? DateTime.Today,
                PartyId = form.PartyId,
                WarehouseId = form.WarehouseId,
                Description = form.Description,
                Lines = real.Select(l => new GoodsIssueLineDto
                {
                    ProductId = l.ProductId,
                    ProductName = l.ProductName,
                    Quantity = l.Quantity,
                    Note = l.Note
                }).ToList()
            });
            Toast.Success(editing ? "حواله ویرایش شد." : "حواله ثبت شد.");
            showForm = false;
            viewing = false;
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    // ==================== تعریف مشتری (همان فرم مشترک /parties) ====================

    private void OpenNewParty() => showNewParty = true;

    private void CloseNewParty() => showNewParty = false;

    /// <summary>پس از ثبت در فرم واقعی طرف حساب: به‌روزرسانی فهرست و انتخاب خودکار در حواله.</summary>
    private async Task OnNewPartySaved(Party created)
    {
        showNewParty = false;
        if (created is null) { Toast.Error("مشتری ثبت شد ولی اطلاعات آن دریافت نشد؛ از فهرست انتخاب کنید."); return; }
        try
        {
            await LoadLookups();
            OnPartyChanged(created.Id);
            Toast.Success($"مشتری «{created.Name}» ثبت شد و در حواله انتخاب شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    /// <summary>حذف حواله پس از تأییدیه.</summary>
    private async Task Delete(GoodsIssueDto g)
    {
        if (!CanDelete) return;
        busy = true;
        try
        {
            await IssueSvc.DeleteAsync(g.Id);
            Toast.Success("حواله حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    // ==================== چاپ ====================

    /// <summary>چاپ از فهرست حواله.</summary>
    private async Task Print(GoodsIssueDto g)
    {
        busy = true;
        try
        {
            var full = await IssueSvc.GetAsync(g.Id);
            if (full is null) { Toast.Error("حواله یافت نشد."); return; }
            await PrintDoc(full);
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

    /// <summary>پیش‌نمایش از جزئیات، بدون بستن پنجرهٔ زیر آن.</summary>
    private async Task PrintCurrent()
    {
        if (form.Id <= 0) { Toast.Error("ابتدا بیجک را ذخیره کنید، سپس چاپ کنید."); return; }
        await Print(form); // Reload the saved record; never print unsaved form edits.
    }

    /// <summary>
    /// پیش‌نمایش سند در iframe مستقل نمایش داده می‌شود تا استایل فرم روی نسخهٔ چاپی اثر نگذارد.
    /// </summary>
    private async Task PrintDoc(GoodsIssueDto d)
    {
        if (d is null) return;
        var selectedPaper = await JS.InvokeAsync<string?>("shopPrintPreview.choosePaper");
        if (selectedPaper is null) return;
        var companyProfile = await ProfileSvc.GetAsync();
        var companyName = companyProfile.Name;
        var ok = await JS.InvokeAsync<bool>("shopPrintPreview.openHtml", GoodsIssuesPrint.Build(d, companyName, selectedPaper, companyProfile.LogoDataUrl));
        if (!ok) Toast.Error("پیش‌نمایش چاپ باز نشد.");
    }
}
