    color: #4338ca;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-badge-emerald {
    background: #d1fae5;
    color: #065f46;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #a7f3d0;
}
.border-purple { border-top: 4px solid #7c3aed !important; }
.border-amber { border-top: 4px solid #f59e0b !important; }
</style>


<style>
.op-tabs-nav-wrapper {
    background: #ffffff;
    border-radius: 16px;
    padding: 6px;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.05);
    border: 1px solid #e2e8f0;
}
.op-tabs-nav {
    display: grid;
    gap: 6px;
}
.op-tab-btn {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    background: transparent;
    border: 1.5px solid transparent;
    border-radius: 12px;
    padding: 0.75rem 1rem;
    cursor: pointer;
    transition: all 0.22s cubic-bezier(0.4, 0, 0.2, 1);
    position: relative;
    text-align: right;
    outline: none !important;
}
.op-tab-icon-box {
    width: 38px;
    height: 38px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.15rem;
    background: #f1f5f9;
    color: #64748b;
    transition: all 0.2s ease;
    flex-shrink: 0;
}
.op-tab-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
    flex-grow: 1;
}
.op-tab-title {
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
    transition: color 0.2s;
}
.op-tab-sub {
    font-size: 0.7rem;
    color: #64748b;
}
.op-tab-btn:hover:not(.is-active) {
    background: #f8fafc;
    border-color: #cbd5e1;
}
.op-tab-btn.is-active {
    background: #ffffff;
    box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.08), 0 0 0 1.5px #4f46e5;
}
.op-tab-btn.is-active.tab-cheques {
    box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.08), 0 0 0 1.5px #4f46e5;
}
.op-tab-btn.is-active.tab-cheques .op-tab-icon-box {
    background: linear-gradient(135deg, #4f46e5 0%, #4338ca 100%);
    color: #ffffff;
}
.op-tab-btn.is-active.tab-installments {
    box-shadow: 0 4px 14px -2px rgba(15, 23, 42, 0.08), 0 0 0 1.5px #059669;
}
.op-tab-btn.is-active.tab-installments .op-tab-icon-box {
    background: linear-gradient(135deg, #10b981 0%, #059669 100%);
    color: #ffffff;
}
</style>


@code {
    private PartyType type = PartyType.Customer;
    private List<Party> items = new();

    // ==================== دسترسی‌ها (مشتری و تأمین‌کننده مستقل) ====================
    private bool CanSeeCustomers => Auth.Has("Parties.Read") || Auth.HasModule("Customers");
    private bool CanSeeSuppliers => Auth.Has("Parties.Read") || Auth.HasModule("Suppliers");

    private string ModuleCurrent => type == PartyType.Supplier ? "Suppliers" : "Customers";

    private bool CanCreateCurrent => Auth.Has("Parties.Create") || Auth.Has($"{ModuleCurrent}.Create");
    private bool CanUpdateCurrent => Auth.Has("Parties.Update") || Auth.Has($"{ModuleCurrent}.Update");
    private bool CanDeleteCurrent => Auth.Has("Parties.Delete") || Auth.Has($"{ModuleCurrent}.Delete");

    private bool AnyAccess => CanSeeCustomers || CanSeeSuppliers;

    private string PageTitleText => CanSeeSuppliers && !CanSeeCustomers ? "تأمین‌کنندگان" : "طرف حساب‌ها";

    // ---------- صفحه‌بندی ----------
    private int page = 1;
    private const int PageSize = 12;
    private int PageCount => Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
    private List<Party> Paged => items;
    private int total, loadVersion;
    private async Task ChangePage(int value) { page = value; await Load(); }
    private async Task SearchChanged() { page = 1; await Load(); }
    private bool loading = true;
    private Party? editSource;
    private bool showModal;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle(PageTitleText);
        // اگر کاربر فقط مجوز تأمین‌کننده دارد، همان زبانه پیش‌فرض می‌شود
        if (!CanSeeCustomers && CanSeeSuppliers) type = PartyType.Supplier;
        await Load();
    }

    private async Task SetType(PartyType t)
    {
        type = t;
        page = 1;
        await Load();
    }

    private async Task Load()
    {
        if (!AnyAccess) { loading = false; items = new(); total = 0; return; }
        var version = ++loadVersion;
        loading = true;
        try
        {
            var result = await PartySvc.GetPagedAsync(type, (page - 1) * PageSize, PageSize);
            if (version != loadVersion) return;
            items = result.Items;
            total = result.TotalCount;
            if (page > PageCount) { page = PageCount; await Load(); }
        }
        catch (Exception ex) { if (version == loadVersion) Toast.Error(ex.Message); }
        finally { if (version == loadVersion) loading = false; }
    }

    private void OpenNew()
    {
        editSource = null;
        showModal = true;
    }

    private void OpenEdit(Party p)
    {
        editSource = p;
        showModal = true;
    }

    private void CloseModal() => showModal = false;

    /// <summary>توضیح کامل ثبت‌کننده: کاربر + پروندهٔ معرف + تاریخ ثبت.</summary>
    private static string RegistrarTitle(Party p)
    {
        var parts = new List<string> { $"ثبت‌کننده: {p.RegisteredByName}" };
        if (!string.IsNullOrWhiteSpace(p.RegisteredByReferrerName)) parts.Add($"پروندهٔ معرف: {p.RegisteredByReferrerName}");
        if (p.RegisteredAt.HasValue) parts.Add($"تاریخ ثبت: {p.RegisteredAt.Value.ToFa()}");
        return string.Join(" | ", parts);
    }

    private async Task OnPartySaved(Party _)
    {
        showModal = false;
        editSource = null;
        await Load();
    }

    private async Task Delete(Party p)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف «{p.Name}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await PartySvc.DeleteAsync(p.Id);
            Toast.Success("طرف حساب حذف شد.");
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
