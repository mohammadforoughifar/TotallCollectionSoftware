@namespace Inventory.Client.Pages
@page "/cartable"
@inject HttpClient Http
@inject IAuthState Auth
@inject NavigationManager Nav
@inject LayoutState Layout
@inject RealtimeService Rt
@inject ICartableApi CartableApi
@implements IDisposable

<PageTitle>کارتابل من</PageTitle>

<div class="page-head">
    <div>
        <h1>کارتابل من</h1>
        <p class="lead">پیام‌ها و مواردی که منتظر اقدام شما هستند</p>
    </div>
</div>

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else
{
    <div class="row g-3">
        @* ================== کارتابل یکپارچه (منابع از API) ================== *@
        @if (unified.Count > 0)
        {
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <i class="bi bi-inbox-fill text-primary"></i>
                        <span class="card-title">کارتابل یکپارچه</span>
                        @if (unifiedActionable > 0)
                        {
                            <span class="badge bg-danger rounded-pill ms-auto fs-9">@Fa.Digits(unifiedActionable) منتظر اقدام</span>
                        }
                    </div>
                    <div class="card-body p-2">
                        @foreach (var u in unified)
                        {
                            <div class="ct-item" @onclick="@(() => OpenUnified(u))">
                                <div class="ct-icon" style="background:@u.Color"><i class="bi @u.Icon"></i></div>
                                <div class="flex-grow-1 min-w-0">
                                    <div class="fw-600 fs-8">@u.Title</div>
                                    <div class="fs-9 text-muted">@u.Subtitle</div>
                                </div>
                                @if (!u.Actionable)
                                {
                                    <span class="badge bg-secondary rounded-pill fs-9">اطلاع</span>
                                }
                                else if (u.BadgeCount is > 0)
                                {
                                    <span class="badge bg-primary rounded-pill fs-9">@Fa.Digits(u.BadgeCount.Value)</span>
                                }
                                <i class="bi bi-chevron-left text-muted"></i>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }

        @* ================== موارد منتظر اقدام ================== *@
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-lightning-charge text-warning"></i>
                    <span class="card-title">منتظر اقدام شما (@actions.Count)</span>
                </div>
                <div class="card-body p-2">
                    @if (actions.Count == 0)
                    {
                        <div class="text-center text-muted py-4 fs-8"><i class="bi bi-check2-circle d-block fs-3 mb-1 text-success"></i>موردی منتظر اقدام شما نیست</div>
                    }
                    @foreach (var a in actions)
                    {
                        <div class="ct-item" @onclick="@(() => Nav.NavigateTo(a.Link))">
                            <div class="ct-icon" style="background:@a.Color"><i class="bi @a.Icon"></i></div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-600 fs-8">@a.Title</div>
                                <div class="fs-9 text-muted">@a.Sub</div>
                            </div>
                            <i class="bi bi-chevron-left text-muted"></i>
                        </div>
                    }
                </div>
            </div>
        </div>

        @* ================== پیام‌ها و اقدام‌ها (دسته‌بندی‌شده) ================== *@
        <div class="col-12 col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <i class="bi bi-bell text-primary"></i>
                    <span class="card-title">پیام‌ها و اقدام‌ها</span>
                    <label class="ct-filter ms-auto" title="فقط پیام‌های خوانده‌نشدهٔ همین تب">
                        <input type="checkbox" @bind="ntfUnreadOnly" @bind:after="OnNtfUnreadFilterAsync" />
                        فقط نخوانده
                    </label>
                </div>

                @* دو تب: «اصلی» = مورد تازه که منتظر نخستین اقدام است؛ «فرعی» = پیگیری روی مورد موجود. *@
                <div class="ct-tabs" role="tablist" aria-label="دسته‌بندی پیام‌ها">
                    <button type="button" role="tab" aria-selected="@(ntfTab == MainTab ? "true" : "false")"
                            class="ct-tab @(ntfTab == MainTab ? "on" : "")" @onclick="() => SwitchTabAsync(MainTab)">
                        <i class="bi bi-lightning-charge-fill"></i>
                        <span>اقدامات اصلی</span>
                        <span class="ct-tab-count">@mainTotal.FaDigits()</span>
                        @if (mainUnread > 0)
                        {
                            <span class="ct-tab-unread" title="@mainUnread نخوانده">@mainUnread.FaDigits()</span>
                        }
                    </button>
                    <button type="button" role="tab" aria-selected="@(ntfTab == SubTab ? "true" : "false")"
                            class="ct-tab @(ntfTab == SubTab ? "on" : "")" @onclick="() => SwitchTabAsync(SubTab)">
                        <i class="bi bi-arrow-repeat"></i>
                        <span>اقدامات فرعی</span>
                        <span class="ct-tab-count">@subTotal.FaDigits()</span>
                        @if (subUnread > 0)
                        {
                            <span class="ct-tab-unread" title="@subUnread نخوانده">@subUnread.FaDigits()</span>
                        }
                    </button>
                </div>
                <div class="ct-tab-hint">
                    @if (ntfTab == MainTab)
                    {
                        <span><b>اصلی</b> = مورد تازه‌ای که منتظر نخستین اقدام شماست: نامهٔ تازه، دستور کار تازه، درخواست/تیکت تازه، سفارش تازه…</span>
                    }
                    else
                    {
                        <span><b>فرعی</b> = پیگیری روی موردهای موجود: تأیید، رد، ارجاع، پاسخ، کامنت، تمدید مهلت، بسته‌شدن، تغییر وضعیت فاکتور…</span>
                    }
                </div>

                <div class="card-body p-2">
                    @if (ntfs.Count == 0)
                    {
                        <div class="text-center text-muted py-4 fs-8">
                            <i class="bi @(ntfTab == MainTab ? "bi-check2-circle text-success" : "bi-bell-slash") d-block fs-3 mb-1"></i>
                            @NtfEmptyText
                        </div>
                    }
                    @foreach (var n in ntfs)
                    {
                        var style = NtfStyle(n);
                        <div class="ct-item @(n.IsRead ? "" : "ct-unread")" @onclick="() => OpenNtf(n)">
                            <div class="ct-icon" style="background:@style.Color"><i class="bi @style.Icon"></i></div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-600 fs-8">@n.Title</div>
                                <div class="fs-9 text-muted">@n.FormName@(string.IsNullOrWhiteSpace(n.CompanyName) ? "" : " · " + n.CompanyName) — از: @n.FromName — @n.CreatedAt.ToFa()</div>
                            </div>
                            @if (!n.IsRead)
                            {
                                <span class="badge bg-primary rounded-pill fs-9">جدید</span>
                            }
                        </div>
                    }

                    @* ---------- صفحه‌بندی پیام‌ها (سمت سرور) ---------- *@
                    @if (ntfTotal > 0)
                    {
                        <div class="ct-pager">
                            <div class="ct-pg-size">
                                <label for="ct-page-size">تعداد در صفحه:</label>
                                <select id="ct-page-size" class="ct-pg-select" @bind="ntfPageSize" @bind:after="OnNtfPageSizeChangedAsync">
                                    @foreach (var size in NtfPageSizes)
                                    {
                                        var sz = size;
                                        <option value="@sz">@sz.FaDigits()</option>
                                    }
                                </select>
                            </div>

                            <div class="ct-pg-nav">
                                <button class="ct-pgbtn" title="صفحهٔ اول" disabled="@(ntfPage <= 1 || ntfBusy)" @onclick="() => GoNtfPageAsync(1)">
                                    <i class="bi bi-chevron-double-right"></i>
                                </button>
                                <button class="ct-pgbtn" title="قبلی" disabled="@(ntfPage <= 1 || ntfBusy)" @onclick="() => GoNtfPageAsync(ntfPage - 1)">
                                    <i class="bi bi-chevron-right"></i>
                                </button>
                                @foreach (var p in NtfPageWindow)
                                {
                                    var pp = p;
                                    <button class="ct-pgbtn @(pp == ntfPage ? "on" : "")" disabled="@ntfBusy"
                                            @onclick="() => GoNtfPageAsync(pp)">@pp.FaDigits()</button>
                                }
                                <button class="ct-pgbtn" title="بعدی" disabled="@(ntfPage >= NtfTotalPages || ntfBusy)" @onclick="() => GoNtfPageAsync(ntfPage + 1)">
                                    <i class="bi bi-chevron-left"></i>
                                </button>
                                <button class="ct-pgbtn" title="صفحهٔ آخر" disabled="@(ntfPage >= NtfTotalPages || ntfBusy)" @onclick="() => GoNtfPageAsync(NtfTotalPages)">
                                    <i class="bi bi-chevron-double-left"></i>
                                </button>
                            </div>

                            <div class="ct-pg-jump">
                                <label for="ct-jump">رفتن به صفحه:</label>
                                <input id="ct-jump" type="number" class="ct-pg-input" min="1" max="@NtfTotalPages"
                                       @bind="ntfJumpPage" @onkeydown="OnNtfJumpKeyAsync" @onblur="EnterNtfJumpAsync" />
                                <button class="btn btn-sm btn-outline-secondary"
                                        disabled="@(ntfJumpPage < 1 || ntfJumpPage > NtfTotalPages || ntfBusy)"
                                        @onclick="EnterNtfJumpAsync">
                                    <i class="bi bi-arrow-left"></i>
                                </button>
                            </div>

                            <span class="ct-pg-info">
                                نمایش @NtfRangeStart.FaDigits() تا @NtfRangeEnd.FaDigits() از @ntfTotal.FaDigits()
                                @(ntfTab == MainTab ? "اقدام اصلی" : "اقدام فرعی")
                                — صفحهٔ @ntfPage.FaDigits() از @NtfTotalPages.FaDigits()
                                @if (ntfBusy)
                                {
                                    <span class="spinner-border spinner-border-sm ms-1" style="width:.8rem;height:.8rem"></span>
                                }
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<style>
    .ct-item { display: flex; align-items: center; gap: .6rem; padding: .55rem .7rem; border-radius: 12px; cursor: pointer; transition: background .12s; }
    .ct-item:hover { background: #f1f5f9; }
    .ct-unread { background: #eff6ff; }
    .ct-icon { width: 34px; height: 34px; border-radius: 10px; color: #fff; display: flex; align-items: center; justify-content: center; flex-shrink: 0; }
    .fs-9 { font-size: .7rem; }

    /* ---------- تب‌های دسته‌بندی پیام‌ها ---------- */
    .ct-filter { display: inline-flex; align-items: center; gap: .3rem; font-size: .7rem; color: #64748b; cursor: pointer; }
    .ct-filter input { accent-color: #2563eb; }
    .ct-tabs { display: flex; gap: .35rem; padding: .5rem .6rem 0; border-bottom: 1px solid #eef2f7; background: #f8fafc; }
    .ct-tab { flex: 1 1 0; display: inline-flex; align-items: center; justify-content: center; gap: .35rem;
        border: 1px solid #e2e8f0; border-bottom: none; background: #fff; color: #475569;
        border-radius: 10px 10px 0 0; padding: .42rem .5rem; font-size: .76rem; font-weight: 600;
        cursor: pointer; transition: background .12s, color .12s; }
    .ct-tab:hover { color: #1d4ed8; background: #f1f5f9; }
    .ct-tab.on { background: #fff; color: #1d4ed8; border-color: #2563eb; box-shadow: inset 0 2px 0 #2563eb; }
    .ct-tab.on i { color: #2563eb; }
    .ct-tab i { font-size: .85rem; color: #94a3b8; }
    .ct-tab-count { background: #eef2f7; color: #475569; border-radius: 999px; font-size: .68rem; padding: 0 .42rem; }
    .ct-tab.on .ct-tab-count { background: #e0ecff; color: #1d4ed8; }
    .ct-tab-unread { background: #dc2626; color: #fff; border-radius: 999px; font-size: .65rem; padding: 0 .32rem; min-width: 1.05rem; text-align: center; }
    .ct-tab-hint { padding: .4rem .7rem; font-size: .68rem; color: #64748b; background: #fbfdff; border-bottom: 1px solid #eef2f7; line-height: 1.7; }
    .ct-tab-hint b { color: #1d4ed8; }
    @@media (max-width: 575.98px) {
        .ct-tab { font-size: .7rem; padding: .38rem .3rem; }
        .ct-tab span:not(.ct-tab-count):not(.ct-tab-unread) { display: none; }
        .ct-tab i { font-size: .95rem; }
    }

    /* ---------- صفحه‌بندی پیام‌ها ---------- */
    .ct-pager { display: flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: wrap;
        padding: .55rem .6rem; border-top: 1px solid #eef2f7; background: #f8fafc; border-radius: 0 0 12px 12px; }
    .ct-pg-size, .ct-pg-jump { display: flex; align-items: center; gap: 5px; font-size: .7rem; color: #64748b; }
    .ct-pg-select, .ct-pg-input { border: 1px solid #e2e8f0; border-radius: 8px; padding: 3px 6px; font: inherit; background: #fff; color: #334155; }
    .ct-pg-input { width: 58px; }
    .ct-pg-nav { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
    .ct-pgbtn { min-width: 30px; height: 30px; padding: 0 7px; border: 1px solid #e2e8f0; background: #fff; border-radius: 9px;
        font-size: .72rem; color: #334155; display: inline-flex; align-items: center; justify-content: center; }
    .ct-pgbtn:hover:not(:disabled) { border-color: #2563eb; color: #2563eb; }
    .ct-pgbtn.on { background: #2563eb; border-color: #2563eb; color: #fff; }
    .ct-pgbtn:disabled { opacity: .4; cursor: default; }
    .ct-pg-info { font-size: .7rem; color: #64748b; }
    @@media (max-width: 575.98px) {
        .ct-pg-info { width: 100%; text-align: center; }
        .ct-pg-nav { justify-content: center; }
    }
</style>

@code {
    private bool loading = true;
    private List<CartableItemDto> unified = new();
    private int unifiedActionable => unified.Count(u => u.Actionable);
    private List<NtfItem> ntfs = new();
    // ================== دسته‌بندی پیام‌ها (اقدامات اصلی / فرعی) ==================
    // فهرست پیش‌تر یک‌جا بود و با زیادشدن اعلان‌ها، کاربر باید همه را با اسکرول و صفحه‌بندی
    // یکی‌یکی می‌دید و موردهای مهم را گم می‌کرد. حالا «مورد تازه» از «پیگیری» جدا شده است.
    private const string MainTab = "main";
    private const string SubTab = "sub";
    private string ntfTab = MainTab;
    /// <summary>صفحهٔ جاری هر تب جدا ذخیره می‌شود تا جابه‌جایی بین تب‌ها موقعیت را از دست ندهد.</summary>
    private readonly Dictionary<string, int> ntfTabPages = new() { [MainTab] = 1, [SubTab] = 1 };
    /// <summary>آخرین تعداد ردیف‌های هر تب — برای کلمپ‌کردن شمارهٔ صفحه پیش از درخواست.</summary>
    private readonly Dictionary<string, int> ntfTabTotals = new();
    private bool ntfUnreadOnly;
    private int mainTotal, mainUnread, subTotal, subUnread;

    // ================== صفحه‌بندی پیام‌ها (سمت سرور) ==================
    // شمارندهٔ زنگوله همهٔ اعلان‌ها را می‌شمارد؛ پس فهرست هم صفحه‌به‌صفحه و کامل دیده می‌شود.
    private int ntfPage = 1;
    private int ntfPageSize = 10;
    private int ntfJumpPage = 1;
    private bool ntfBusy;
    /// <summary>تعداد ردیف‌های همان تبِ جاری (نه کل اعلان‌ها) — مبنای صفحه‌بندی.</summary>
    private int ntfTotal;
    private int ntfUnread;
    private static readonly int[] NtfPageSizes = { 10, 20, 50 };

    private int NtfTotalPages => Math.Max(1, (int)Math.Ceiling(ntfTotal / (double)Math.Max(1, ntfPageSize)));
    private int NtfRangeStart => ntfTotal == 0 ? 0 : (ntfPage - 1) * ntfPageSize + 1;
    private int NtfRangeEnd => Math.Min(ntfTotal, ntfPage * ntfPageSize);

    /// <summary>حداکثر ۵ شمارهٔ صفحه پیرامون صفحهٔ جاری (مثل بقیهٔ کارتابل‌ها).</summary>
    private IEnumerable<int> NtfPageWindow
    {
        get
        {
            var total = NtfTotalPages;
            if (total <= 5)
            {
                for (var i = 1; i <= total; i++) yield return i;
                yield break;
            }
            var start = Math.Max(1, ntfPage - 2);
            var end = Math.Min(total, start + 4);
            start = Math.Max(1, end - 4);
            for (var i = start; i <= end; i++) yield return i;
        }
    }

    private class NtfPage
    {
        public List<NtfItem> Items { get; set; } = new();
        public int Total { get; set; }
        public int Unread { get; set; }
        /// <summary>تعداد ردیف‌های همان تب درخواستی — مبنای صفحه‌بندی هر تب.</summary>
        public int FilteredTotal { get; set; }
        public int MainTotal { get; set; }
        public int MainUnread { get; set; }
        public int SubTotal { get; set; }
        public int SubUnread { get; set; }
        public bool HasMore { get; set; }
    }
    private List<ActionItem> actions = new();

    public class NtfItem { public int Id { get; set; } public string Title { get; set; } = ""; public string? Body { get; set; } public string FromName { get; set; } = ""; public string FormName { get; set; } = ""; public string? Link { get; set; } public bool IsRead { get; set; } public DateTime CreatedAt { get; set; } public int? CompanyId { get; set; } public string? CompanyName { get; set; } public string? Category { get; set; } }
    public class ActionItem { public string Title { get; set; } = ""; public string Sub { get; set; } = ""; public string Link { get; set; } = "/"; public string Icon { get; set; } = "bi-lightning"; public string Color { get; set; } = "#2563eb"; }
    private class AccessInfo { public int UserId { get; set; } public bool CanCreate { get; set; } public bool IsExpert { get; set; } public bool IsManager { get; set; } }
    private class ReqLite { public int Id { get; set; } public string Title { get; set; } = ""; public string Status { get; set; } = ""; public List<AsgLite> Assignments { get; set; } = new(); }
    private class AsgLite { public int Id { get; set; } public int ExpertUserId { get; set; } public bool ReportSubmitted { get; set; } public string? ManagerDecision { get; set; } }

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("کارتابل من");
        // ================== برخط: رفرش خودکار با SignalR ==================
        Rt.DataChanged += OnRtChanged;
        Rt.NotifyReceived += OnRtNotify;
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new System.Net.Http.Headers.AuthenticationHeaderValue("Bearer", Auth.Token);

        await ReloadAsync();
        loading = false;
    }

    private async Task ReloadAsync()
    {
        actions = new();
        // بدون reset: با هر رفرش بلادرنگ، کاربر از صفحهٔ جاری‌اش بیرون نمی‌افتد
        await LoadNotificationsAsync();

        // کارتابل یکپارچه: منابع ماژول‌ها (ویزیتوری و …) از یک قرارداد واحد
        try
        {
            var res = await CartableApi.MineAsync();
            unified = res?.Items ?? new();
        }
        catch { unified = new(); }

        // ================== موارد منتظر اقدام ==================
        try
        {
            var access = await Http.GetFromJsonAsync<AccessInfo>("/api/itrequests/my-access") ?? new();

            // درخواست‌دهنده: پاسخ آماده تایید
            var mine = await Http.GetFromJsonAsync<List<ReqLite>>("/api/itrequests/mine") ?? new();
            foreach (var r in mine.Where(r => r.Status == "ManagerApproved"))
                actions.Add(new ActionItem { Title = $"پاسخ درخواست «{r.Title}» آماده تایید شماست", Sub = "درخواست خدمت IT", Link = "/it-requests", Icon = "bi-check2-circle", Color = "#0ea5e9" });

            // کارشناس: ارجاع‌های بدون گزارش
            if (access.IsExpert)
            {
                var exp = await Http.GetFromJsonAsync<List<ReqLite>>("/api/itrequests/expert") ?? new();
                foreach (var r in exp.Where(r => r.Status == "Assigned" &&
                         r.Assignments.Any(a => a.ExpertUserId == access.UserId && !a.ReportSubmitted)))
                    actions.Add(new ActionItem { Title = $"درخواست «{r.Title}» منتظر گزارش شماست", Sub = "کارتابل کارشناس IT", Link = "/it-requests", Icon = "bi-tools", Color = "#d97706" });
            }

            // مدیر IT: درخواست‌های جدید + گزارش‌های منتظر تصمیم
            if (access.IsManager)
            {
                var mgr = await Http.GetFromJsonAsync<List<ReqLite>>("/api/itrequests/manager") ?? new();
                foreach (var r in mgr.Where(r => r.Status == "New"))
                    actions.Add(new ActionItem { Title = $"درخواست جدید «{r.Title}» منتظر ارجاع", Sub = "کارتابل مدیر IT", Link = "/it-requests", Icon = "bi-inbox", Color = "#7c3aed" });
                foreach (var r in mgr.Where(r => r.Status == "Assigned" &&
                         r.Assignments.Any(a => a.ReportSubmitted && a.ManagerDecision == null)))
                    actions.Add(new ActionItem { Title = $"گزارش کارشناس برای «{r.Title}» منتظر تایید/رد شماست", Sub = "کارتابل مدیر IT", Link = "/it-requests", Icon = "bi-patch-check", Color = "#059669" });
            }
        }
        catch { }

        // ================== مدیر منابع انسانی: درخواست‌های مرخصی/ماموریت در انتظار تایید ==================
        if (Auth.Has("LeaveRequests.Approve"))
        {
            try
            {
                var stats = await Http.GetFromJsonAsync<LeaveStats>("/api/LeaveRequests/stats");
                if (stats != null && stats.Pending > 0)
                {
                    actions.Add(new ActionItem
                    {
                        Title = $"تعداد {Fa.Digits(stats.Pending)} درخواست مرخصی/ماموریت در انتظار تایید",
                        Sub = "پنل مدیریت منابع انسانی",
                        Link = "/hr-admin",
                        Icon = "bi-calendar2-check",
                        Color = "#b06a00"
                    });
                }
            }
            catch { }
        }

        // ================== مدیر حضور و غیاب: تاخیرها و غیبت‌های امروز ==================
        if (Auth.Has("Attendance.ViewAll") || Auth.Has("Attendance.ManageShifts") || Auth.IsAdmin)
        {
            try
            {
                var t = await Http.GetFromJsonAsync<AttStatus>("/api/Attendance/today-status");
                if (t != null)
                {
                    if (t.stats.Late > 0)
                        actions.Add(new ActionItem
                        {
                            Title = $"{Fa.Digits(t.stats.Late)} نفر با تاخیر وارد شده‌اند",
                            Sub = "مدیریت حضور و غیاب",
                            Link = "/attendance-admin",
                            Icon = "bi-stopwatch",
                            Color = "#e0245e"
                        });
                    if (t.stats.Absent > 0)
                        actions.Add(new ActionItem
                        {
                            Title = $"{Fa.Digits(t.stats.Absent)} نفر امروز هنوز وارد نشده‌اند",
                            Sub = "مدیریت حضور و غیاب",
                            Link = "/attendance-admin",
                            Icon = "bi-exclamation-triangle",
                            Color = "#b21b4c"
                        });
                }
            }
            catch { }
        }
    }

    private class LeaveStats { public int Pending { get; set; } }
    private class AttStatus { public AttStats stats { get; set; } = new(); public List<object> items { get; set; } = new(); }
    private class AttStats { public int Total { get; set; } public int Present { get; set; } public int Absent { get; set; } public int Pending { get; set; } public int Late { get; set; } public int OnLeave { get; set; } }

    /// <summary>متن حالت خالی، به‌تفکیک تب و فیلتر «فقط نخوانده».</summary>
    private string NtfEmptyText =>
        ntfUnreadOnly ? "پیام خوانده‌نشده‌ای در این دسته نیست."
        : ntfTab == MainTab ? "اقدام اصلی جدیدی ندارید؛ همهٔ موردهای تازه بررسی شده‌اند."
        : "اقدام فرعی تازه‌ای نیست.";

    /// <summary>جابه‌جایی بین تب «اقدامات اصلی» و «اقدامات فرعی» — صفحهٔ هر تب حفظ می‌شود.</summary>
    private async Task SwitchTabAsync(string tab)
    {
        if (ntfTab == tab) return;
        ntfTabPages[ntfTab] = ntfPage;
        ntfTab = tab;
        ntfPage = ntfTabPages.TryGetValue(tab, out var saved) && saved > 0 ? saved : 1;
        ntfJumpPage = ntfPage;
        await LoadNotificationsAsync();
    }

    private async Task OnNtfUnreadFilterAsync()
    {
        ntfTabPages[ntfTab] = 1;
        ntfPage = 1;
        ntfJumpPage = 1;
        await LoadNotificationsAsync();
    }

    /// <summary>بارگذاری صفحهٔ جاری پیام‌ها (صفحه‌بندی و دسته‌بندی سمت سرور).</summary>
    private async Task LoadNotificationsAsync(bool reset = false)
    {
        if (reset) { ntfPage = 1; ntfJumpPage = 1; ntfTabPages[ntfTab] = 1; }
        if (ntfPage < 1) ntfPage = 1;
        // سقف صفحه فقط با «تعدادِ همان تب» سنجیده می‌شود؛ وگرنه هنگام برگشت به تبی که
        // هنوز شمارشش بارگذاری نشده، صفحهٔ درست بی‌دلیل به ۱ کلمپ می‌شد.
        var knownTotal = ntfTabTotals.TryGetValue(ntfTab, out var known) ? known : int.MaxValue;
        var knownMaxPage = Math.Max(1, (int)Math.Ceiling(knownTotal / (double)Math.Max(1, ntfPageSize)));
        if (ntfPage > knownMaxPage) { ntfPage = knownMaxPage; ntfJumpPage = knownMaxPage; }

        ntfBusy = true;
        try
        {
            var skip = (ntfPage - 1) * ntfPageSize;
            var url = $"/api/notifications/page?take={ntfPageSize}&skip={skip}&category={ntfTab}"
                      + (ntfUnreadOnly ? "&unreadOnly=true" : "");
            var page = await Http.GetFromJsonAsync<NtfPage>(url);
            if (page == null) return;

            ntfs = page.Items;
            // شمارنده‌های هر تب همیشه از سرور می‌آید تا با واقعیت دیتابیس یکی باشد.
            mainTotal = page.MainTotal;
            mainUnread = page.MainUnread;
            subTotal = page.SubTotal;
            subUnread = page.SubUnread;
            // صفحه‌بندی روی همان تب جاری است، نه کل اعلان‌ها.
            ntfTotal = page.FilteredTotal;
            ntfTabTotals[ntfTab] = page.FilteredTotal;
            ntfUnread = ntfTab == MainTab ? page.MainUnread : page.SubUnread;

            // اگر صفحهٔ جاری بعد از خواندن/پاک‌شدن خالی ماند، یک صفحه عقب برگرد
            if (ntfs.Count == 0 && ntfPage > 1)
            {
                ntfPage--;
                ntfJumpPage = ntfPage;
                await LoadNotificationsAsync();
            }
        }
        catch { /* شکست بارگذاری اعلان‌ها نباید بقیهٔ کارتابل را متوقف کند */ }
        finally { ntfBusy = false; }
    }

    /// <summary>
    /// آیکن و رنگ ردیف بر اساس نوع فرم — هم تفکیک بصری نامه/دستور کار/فاکتور و…، هم کمک به
    /// اسکن سریع فهرست بدون خواندن کامل عنوان.
    /// </summary>
    private static (string Icon, string Color) NtfStyle(NtfItem n)
    {
        var f = n.FormName;
        if (f.Contains("نامه")) return ("bi-envelope-paper", "#0ea5e9");
        if (f.Contains("دستور کار") || f.Contains("دستورکار")) return ("bi-clipboard-check", "#7c3aed");
        if (f.Contains("ویزیتور") || f.Contains("سفارش") || f.Contains("فروش")) return ("bi-bag-check", "#059669");
        if (f.Contains("منابع انسانی") || f.Contains("مرخصی") || f.Contains("HR") || f.Contains("تیکت")) return ("bi-person-badge", "#b06a00");
        if (f.Contains("پروژه")) return ("bi-diagram-3", "#2563eb");
        if (f.Contains("مدرک") || f.Contains("آرشیو")) return ("bi-archive", "#0891b2");
        if (f.Contains("IT") || f.Contains("درخواست")) return ("bi-life-preserver", "#d97706");
        // ناشناخته: اصلی‌ها نشان رعد، فرعی‌ها نشان پیگیری
        return n.Category == MainTab
            ? ("bi-lightning-charge-fill", "#ca8a04")
            : ("bi-arrow-repeat", "#64748b");
    }

    private async Task GoNtfPageAsync(int page)
    {
        if (page < 1 || page > NtfTotalPages || page == ntfPage) return;
        ntfPage = page;
        ntfJumpPage = page;
        ntfTabPages[ntfTab] = page;   // صفحهٔ همان تب حفظ می‌شود
        await LoadNotificationsAsync();
    }

    private async Task OnNtfPageSizeChangedAsync()
    {
        ntfPage = 1;
        ntfJumpPage = 1;
        ntfTabPages[ntfTab] = 1;
        await LoadNotificationsAsync();
    }

    private async Task EnterNtfJumpAsync()
    {
        var target = Math.Clamp(ntfJumpPage, 1, NtfTotalPages);
        ntfJumpPage = target;
        await GoNtfPageAsync(target);
    }

    private async Task OnNtfJumpKeyAsync(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or "NumpadEnter") await EnterNtfJumpAsync();
    }

    private async void OnRtChanged(string scope)
    {
        await ReloadAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnRtNotify(RtNotification rn)
    {
        // به‌جای درج دستی ردیف (که دسته/شرکت آن معلوم نبود)، صفحه و شمارنده‌های همان تب
        // از سرور دوباره خوانده می‌شود: اعلان در تب درست می‌نشیند و اعلان شرکت دیگر نمی‌آید.
        try { await LoadNotificationsAsync(); } catch { }
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Rt.DataChanged -= OnRtChanged;
        Rt.NotifyReceived -= OnRtNotify;
    }

    private void OpenUnified(CartableItemDto u)
    {
        if (!string.IsNullOrWhiteSpace(u.Link)) Nav.NavigateTo(u.Link);
    }

    private async Task OpenNtf(NtfItem n)
    {
        if (!n.IsRead)
        {
            n.IsRead = true;
            if (ntfUnread > 0) ntfUnread--;
            if (n.Category == MainTab) { if (mainUnread > 0) mainUnread--; }
            else if (subUnread > 0) subUnread--;
            try { await Http.PostAsync($"/api/notifications/{n.Id}/read", null); } catch { }
        }
        if (!string.IsNullOrWhiteSpace(n.Link)) Nav.NavigateTo(n.Link);
    }
}
