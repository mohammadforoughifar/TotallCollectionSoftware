@namespace Inventory.Client.Pages
@page "/hr-core/exit"
@inject IHrTalentService Svc
@inject IHrCoreService EmpSvc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<PageTitle>ترک‌کار</PageTitle>

<div class="page-head mb-4">
    <h1><i class="bi bi-box-arrow-right"></i> ترک‌کار و تسویه خروج</h1>
    <div class="lead">فرآیند خروج پرسنل + چک‌لیست تسویه (اتمام پرونده = قطع همکاری سیستمی)</div>
</div>

@if (!canRead)
{
    <div class="alert alert-warning">دسترسی به ماژول کارگزینی برای شما فعال نیست.</div>
    return;
}

<div class="card border-0 shadow-sm mb-3">
    <div class="card-body d-flex flex-wrap gap-2 align-items-end">
        <div class="form-check mb-2">
            <input class="form-check-input" type="checkbox" id="exopen" @bind="onlyOpen" @bind:after="Reload" />
            <label class="form-check-label" for="exopen">فقط پرونده‌های باز</label>
        </div>
        <div class="ms-auto">
            @if (canCreate)
            {
                <button class="btn btn-success" @onclick="() => showNew = true"><i class="bi bi-plus-lg"></i> پرونده ترک‌کار</button>
            }
        </div>
    </div>
</div>

@if (loading)
{
    <div class="text-center text-muted py-5"><span class="spinner-border"></span></div>
}
else
{
    <div class="row g-3">
        @foreach (var c in items)
        {
            <div class="col-lg-6">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <strong><a href="hr-core/employees/@c.EmployeeId" class="text-decoration-none">@c.EmployeeName</a></strong>
                        <span>
                            <span class="badge text-bg-info">@HrCoreUi.ExitType(c.Type)</span>
                            <span class="badge @(c.Status == 1 ? "text-bg-success" : "text-bg-primary")">@(c.Status == 1 ? "تکمیل" : "در جریان")</span>
                        </span>
                    </div>
                    <div class="card-body">
                        <div class="small text-muted mb-2">
                            درخواست: <span class="num">@c.RequestDate.ToFa()</span>
                            @if (c.LastWorkDate != null)
                            {
                                <span> • آخرین روز کار: <span class="num">@c.LastWorkDate.Value.ToFa()</span></span>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(c.Reason))
                        {
                            <div class="small mb-2">@c.Reason</div>
                        }
                        <div class="progress mb-3" style="height:8px">
                            <div class="progress-bar bg-success" style="width:@c.Progress%"></div>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var it in c.Items)
                            {
                                <li class="list-group-item d-flex align-items-center gap-2 px-0">
                                    @if (canUpdate && c.Status == 0)
                                    {
                                        <input class="form-check-input mt-0" type="checkbox" checked="@(it.Status == 1)"
                                               @onchange="() => ToggleItem(c, it)" title="انجام شد / باز" />
                                    }
                                    <span class="@(it.Status == 1 ? "text-decoration-line-through text-muted" : "")">@it.Title</span>
                                    <span class="badge text-bg-light ms-auto">@HrCoreUi.TalentOwner(it.Owner)</span>
                                    @if (it.Status == 2)
                                    {
                                        <span class="badge text-bg-secondary">ردشده</span>
                                    }
                                    @if (canUpdate && c.Status == 0 && it.Status == 0)
                                    {
                                        <button class="btn btn-sm btn-light" title="رد کردن" @onclick="() => SkipItem(c, it)"><i class="bi bi-x-lg text-secondary"></i></button>
                                    }
                                    @if (canDelete && c.Status == 0)
                                    {
                                        <button class="btn btn-sm btn-light" title="حذف آیتم" @onclick="() => DeleteItem(c, it.Id)"><i class="bi bi-trash text-danger"></i></button>
                                    }
                                </li>
                            }
                        </ul>
                        @if (canUpdate && c.Status == 0)
                        {
                            <div class="input-group mt-2">
                                <input class="form-control" placeholder="آیتم جدید…" @bind="newItemTitle[c.Id]" />
                                <select class="form-select" style="max-width:150px" @bind="newItemOwner[c.Id]">
                                    <option value="0">کارگزینی</option>
                                    <option value="1">مدیر</option>
                                    <option value="2">فناوری اطلاعات</option>
                                    <option value="3">خود پرسنل</option>
                                </select>
                                <button class="btn btn-outline-primary" @onclick="() => AddItem(c)"><i class="bi bi-plus-lg"></i></button>
                            </div>
                            <button class="btn btn-success btn-sm mt-2" @onclick="() => Complete(c)"><i class="bi bi-check-lg"></i> اتمام و قطع همکاری</button>
                        }
                    </div>
                </div>
            </div>
        }
        @if (items.Count == 0)
        {
            <div class="col-12"><div class="alert alert-light text-center">پرونده‌ای یافت نشد.</div></div>
        }
    </div>
}

<Modal Visible="showNew" Title="پرونده ترک‌کار جدید" OnClose="() => showNew = false">
<ChildContent>
    <div class="row g-2">
        <div class="col-md-6">
            <label class="form-label">پرسنل</label>
            <select class="form-select" @bind="nEmp">
                @foreach (var m in employees)
                {
                    <option value="@m.Id">@m.FirstName @m.LastName (@m.Code)</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">نوع ترک‌کار</label>
            <select class="form-select" @bind="nType">
                <option value="0">استعفا</option>
                <option value="1">اخراج</option>
                <option value="2">پایان قرارداد</option>
                <option value="3">بازنشستگی</option>
                <option value="4">توافقی</option>
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label">آخرین روز کار</label>
            <DatePicker @bind-Value="nLast" AllowClear="true" />
        </div>
        <div class="col-12">
            <label class="form-label">دلیل / توضیح</label>
            <textarea class="form-control" rows="2" @bind="nNote"></textarea>
        </div>
    </div>
</ChildContent>
<Footer>
    <div class="d-flex justify-content-end gap-2 mt-3">
        <button class="btn btn-light" @onclick="() => showNew = false">انصراف</button>
        <button class="btn btn-success" disabled="@saving" @onclick="Create">ثبت</button>
    </div>
</Footer>
</Modal>

@code {
    private bool canRead => Auth.Has("HrCore.Read") || Auth.IsAdmin;
    private bool canCreate => Auth.Has("HrCore.Create") || Auth.IsAdmin;
    private bool canUpdate => Auth.Has("HrCore.Update") || Auth.IsAdmin;
    private bool canDelete => Auth.Has("HrCore.Delete") || Auth.IsAdmin;

    private bool loading = true, saving, showNew, onlyOpen = true;
    private List<HrExitCaseDto> items = new();
    private List<HrEmployeeDto> employees = new();
    private Dictionary<int, string> newItemTitle = new();
    private Dictionary<int, int> newItemOwner = new();
    private int nEmp, nType;
    private DateTime? nLast = DateTime.Today;
    private string? nNote;

    protected override async Task OnInitializedAsync()
    {
        if (!canRead) { loading = false; return; }
        await Reload();
        try
        {
            employees = (await EmpSvc.SearchEmployeesAsync(null, null, 0, 0, 500)).Items;
            nEmp = employees.FirstOrDefault()?.Id ?? 0;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Reload()
    {
        loading = true;
        try
        {
            items = await Svc.GetExitCasesAsync(onlyOpen ? true : null);
            foreach (var c in items)
            {
                newItemTitle.TryAdd(c.Id, "");
                newItemOwner.TryAdd(c.Id, 0);
            }
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        loading = false;
    }

    private async Task Create()
    {
        saving = true;
        try
        {
            await Svc.CreateExitCaseAsync(new HrTalentCaseSaveDto
                { EmployeeId = nEmp, Type = nType, LastWorkDate = nLast, Note = nNote });
            showNew = false;
            nNote = null;
            Toast.Success("پرونده ترک‌کار با چک‌لیست تسویه ساخته شد.");
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        saving = false;
    }

    private async Task ToggleItem(HrExitCaseDto c, HrTalentItemDto it)
    {
        try
        {
            var u = await Svc.SetExitItemAsync(it.Id, it.Status == 1 ? 0 : 1, Auth.DisplayName);
            var i = items.FindIndex(x => x.Id == u.Id);
            if (i >= 0) items[i] = u;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task SkipItem(HrExitCaseDto c, HrTalentItemDto it)
    {
        try
        {
            var u = await Svc.SetExitItemAsync(it.Id, 2, Auth.DisplayName);
            var i = items.FindIndex(x => x.Id == u.Id);
            if (i >= 0) items[i] = u;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteItem(HrExitCaseDto c, int itemId)
    {
        if (!await JS.InvokeAsync<bool>("confirm", "این آیتم حذف شود؟")) return;
        try
        {
            await Svc.DeleteExitItemAsync(itemId);
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task AddItem(HrExitCaseDto c)
    {
        var title = newItemTitle.GetValueOrDefault(c.Id, "");
        if (string.IsNullOrWhiteSpace(title)) return;
        try
        {
            var u = await Svc.AddExitItemAsync(c.Id,
                new HrTalentItemSaveDto { Title = title, Owner = newItemOwner.GetValueOrDefault(c.Id) });
            var i = items.FindIndex(x => x.Id == u.Id);
            if (i >= 0) items[i] = u;
            newItemTitle[c.Id] = "";
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Complete(HrExitCaseDto c)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
            $"پرونده {c.EmployeeName} بسته و وضعیت سیستمی «قطع همکاری» شود؟")) return;
        try
        {
            await Svc.CompleteExitCaseAsync(c.Id, Auth.DisplayName);
            Toast.Success("ترک‌کار نهایی شد؛ پرسنل غیرفعال گردید.");
            await Reload();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
}
