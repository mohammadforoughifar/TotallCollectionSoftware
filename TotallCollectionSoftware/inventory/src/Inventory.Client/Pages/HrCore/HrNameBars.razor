@namespace Inventory.Client.Pages

@* نمودار میله‌ای افقی نام/مقدار — خالص CSS *@
<div class="d-flex flex-column gap-2">
    @foreach (var p in Points)
    {
        var pct = Max <= 0 ? 0 : p.Value / Max * 100;
        <div>
            <div class="d-flex justify-content-between small mb-1">
                <span>@p.Name</span>
                <b class="num">@Inventory.Shared.Fa.Digits(p.Value.ToString("#,0.##"))</b>
            </div>
            <div class="progress" style="height:8px">
                <div class="progress-bar bg-success" style="width:@pct.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)%"></div>
            </div>
        </div>
    }
    @if (Points.Count == 0)
    {
        <div class="text-muted small">داده‌ای نیست.</div>
    }
</div>

@code {
    [Parameter] public List<HrNameValueDto> Points { get; set; } = new();

    private double Max => Points.Count == 0 ? 0 : Points.Max(p => p.Value);
}
