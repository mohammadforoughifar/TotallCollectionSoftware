@implements IDisposable
@namespace Inventory.Client.Pages
@page "/expenses"
@inject IExpenseService ExpenseSvc
@inject ITrsAccountService AccountSvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>هزینه‌ها</PageTitle>

<div class="page-head">
    <div>
        <h1>هزینه‌ها</h1>
        <p class="lead">ثبت اسناد هزینه با نوع، مبلغ و نحوه پرداخت</p>
    </div>
    <button class="btn btn-light ms-auto" @onclick="OpenCats">
        <i class="bi bi-tags"></i> انواع هزینه
    </button>
    <button class="btn btn-primary" @onclick="OpenNew">
        <i class="bi bi-plus-lg"></i> هزینه جدید
    </button>
</div>

<div class="card mb-3">
    <div class="card-body py-2">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-search"></i></span>
                    <input class="form-control" placeholder="جستجو: شماره سند، دریافت‌کننده، توضیحات…"
                           value="@search" @oninput="OnSearchInput" />
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select" @onchange="OnCatFilter">
                    <option value="0">— همه انواع هزینه —</option>
                    @foreach (var c in categories)
                    {
                        <option value="@c.Id">@c.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2"><DatePicker @bind-Value="from" Placeholder="از تاریخ" /></div>
            <div class="col-md-2"><DatePicker @bind-Value="to" Placeholder="تا تاریخ" /></div>
            <div class="col-md-1">
                <button class="btn btn-light w-100" title="اعمال فیلتر" @onclick="ApplyFilter"><i class="bi bi-funnel"></i></button>
            </div>
        </div>
    </div>
</div>

<div class="card">
    <div class="card-body p-0">
        @if (loading)
        {
            <div class="text-center py-5"><div class="spinner-border text-primary" role="status"></div></div>
        }
        else if (items.Count == 0)
        {
            <div class="empty-state"><i class="bi bi-cash-coin"></i><h5>سند هزینه‌ای یافت نشد</h5></div>
        }
        else
        {
            @* ---------- نمای جدولی (دسکتاپ) ---------- *@
            <div class="table-responsive grid-desktop">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>سند</th>
                            <th>تاریخ</th>
                            <th>نوع هزینه</th>
                            <th>دریافت‌کننده</th>
                            <th>نحوه پرداخت</th>
                            <th class="text-start">مبلغ (ریال)</th>
                            <th>توضیحات</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in items)
                        {
                            <tr>
                                <td class="doc-number fw-700 text-primary">@e.Number</td>
                                <td class="num fs-8">@e.Date.ToFa()</td>
                                <td><span class="badge badge-soft-warning">@e.CategoryName</span></td>
                                <td>@(e.Payee ?? "—")</td>
                                <td>
                                    @if (e.Cheques.Count > 0) { <span class="badge badge-pay-cheque fs-8">@ChequeSummary(e)</span> }
                                    else { @PayTypeBadge(e.PayType)@(string.IsNullOrWhiteSpace(e.TrsAccountName) ? "" : $" ({e.TrsAccountName})") }
                                </td>
                                <td class="text-start num fw-700 text-danger">@e.Amount.Money()</td>
                                <td class="text-muted fs-8">@(string.IsNullOrWhiteSpace(e.Description) ? "—" : e.Description)</td>
                                <td class="text-end text-nowrap">
                                    @if (e.Cheques.Count > 0)
                                    { <button class="btn btn-sm btn-outline-primary" @onclick="() => chequeDetail = e">چک / وضعیت</button> }
                                    else
                                    {
                                        <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEdit(e)"><i class="bi bi-pencil text-primary"></i></button>
                                        <button class="btn btn-sm btn-light" title="حذف" @onclick="() => Delete(e)"><i class="bi bi-trash text-danger"></i></button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @* ---------- نمای کارتی (موبایل) ---------- *@
            <div class="cards-mobile">
                @foreach (var e in items)
                {
                    <div class="m-card st-cancelled">
                        <div class="m-card-head">
                            <div class="m-card-icon"><i class="bi bi-cash-coin"></i></div>
                            <div class="flex-grow-1 min-w-0">
                                <div class="d-flex align-items-center gap-2 flex-wrap">
                                    <span class="doc-number fw-800 text-primary">@e.Number</span>
                                    <span class="badge badge-soft-warning fs-8">@e.CategoryName</span>
                                </div>
                                <div class="fs-8 text-muted">@e.Date.ToFa()@(string.IsNullOrWhiteSpace(e.Payee) ? "" : $" — {e.Payee}")</div>
                                @if (!string.IsNullOrWhiteSpace(e.Description))
                                {
                                    <div class="fs-8 text-muted text-truncate">@e.Description</div>
                                }
                            </div>
                            <div class="text-end">
                                <div class="fs-8 text-muted">مبلغ</div>
                                <div class="num fw-800 text-danger">@e.Amount.Money()</div>
                                <div class="mt-1">
                                    @if (e.Cheques.Count > 0) { <span class="badge badge-pay-cheque fs-8">@ChequeSummary(e)</span> }
                                    else { @PayTypeBadge(e.PayType)@(string.IsNullOrWhiteSpace(e.TrsAccountName) ? "" : $" — {e.TrsAccountName}") }
                                </div>
                            </div>
                        </div>
                        <div class="m-card-actions">
                            @if (e.Cheques.Count > 0)
                            { <button class="btn btn-light text-primary" @onclick="() => chequeDetail = e">جزئیات و وضعیت چک</button> }
                            else
                            {
                                <button class="btn btn-light text-primary" @onclick="() => OpenEdit(e)"><i class="bi bi-pencil"></i> ویرایش</button>
                                <button class="btn btn-light text-danger" @onclick="() => Delete(e)"><i class="bi bi-trash"></i></button>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-top flex-wrap gap-2">
                <div class="fs-8 text-muted">جمع صفحه: <b class="num text-danger">@items.Sum(x => x.Amount).Money()</b> ریال</div>
                <Pager Page="page" PageCount="pageCount" OnPageChanged="GoToPage" />
            </div>
        }
    </div>
</div>

@* ---------------- فرم سند هزینه ---------------- *@
<Modal Visible="showForm" Title="@(replacement ? $"چک جایگزین برای {form.Number}" : form.Id == 0 ? "هزینه جدید" : $"ویرایش سند {form.Number}")" OnClose="() => showForm = false">
    <ChildContent>
        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">نوع هزینه <span class="text-danger">*</span></label>
                <div class="input-group">
                    <select class="form-select" @bind="catIdStr" disabled="@replacement">
                        <option value="0">— انتخاب کنید —</option>
                        @foreach (var c in categories.Where(x => x.IsActive || x.Id == form.CategoryId))
                        {
                            <option value="@c.Id">@c.Name</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-primary" title="افزودن نوع هزینه جدید" aria-label="افزودن نوع هزینه جدید" @onclick="OpenCats">
                        <i class="bi bi-plus-lg"></i>
                    </button>
                </div>
            </div>
            <div class="col-md-6">
                <label class="form-label">مبلغ (ریال) <span class="text-danger">*</span></label>
                <input class="form-control num" value="@fAmount"
                       @oninput="@(e => fAmount = Fa.FormatTyping(e.Value?.ToString()))" inputmode="numeric" dir="ltr" disabled="@replacement" />
            </div>
            <div class="col-md-6">
                <label class="form-label">تاریخ سند <span class="text-danger">*</span></label>
                @if (replacement) { <div class="form-control bg-light">@form.Date.ToFa()</div> }
                else { <DatePicker @bind-Value="expDate" /> }
            </div>
            <div class="col-md-6">
                <label class="form-label d-block">نحوه پرداخت</label>
                <div class="d-flex flex-wrap gap-3 pt-1">
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="expPay" id="epCash"
                               checked="@(paymentMode == "ordinary" && form.PayType == CashType.Cash)" disabled="@replacement" @onchange="@(() => { paymentMode = "ordinary"; form.PayType = CashType.Cash; })" />
                        <label class="form-check-label" for="epCash">وجه نقد</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="expPay" id="epPos"
                               checked="@(paymentMode == "ordinary" && form.PayType == CashType.CardReader)" disabled="@replacement" @onchange="@(() => { paymentMode = "ordinary"; form.PayType = CashType.CardReader; })" />
                        <label class="form-check-label" for="epPos">کارت‌خوان</label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="expPay" id="epC2C"
                               checked="@(paymentMode == "ordinary" && form.PayType == CashType.CardTransfer)" disabled="@replacement" @onchange="@(() => { paymentMode = "ordinary"; form.PayType = CashType.CardTransfer; })" />
                        <label class="form-check-label" for="epC2C">کارت به کارت</label>
                    </div>
                    @if (form.Id == 0 || replacement)
                    {
                        <div class="form-check"><input class="form-check-input" type="radio" name="expPay" id="epIssued" checked="@(paymentMode == "issued")" @onchange='() => PrepareMode("issued")' /><label class="form-check-label" for="epIssued">چک صادره</label></div>
                        <div class="form-check"><input class="form-check-input" type="radio" name="expPay" id="epReceived" checked="@(paymentMode == "received")" @onchange='() => PrepareMode("received")' /><label class="form-check-label" for="epReceived">خرج چک دریافتی</label></div>
                    }
                </div>
            </div>
            @if (paymentMode == "ordinary")
            {
            <div class="col-md-6">
                <label class="form-label">صندوق / بانک پرداخت</label>
                <div class="input-group">
                    <select class="form-select" value="@(form.TrsAccountId ?? 0)" @onchange="OnBankChanged">
                        <option value="0">— انتخاب @(form.PayType == CashType.Cash ? "صندوق" : "بانک") —</option>
                        @foreach (var a in AccountsForPayType())
                        {
                            <option value="@a.Id">@a.DisplayName</option>
                        }
                    </select>
                    <button type="button" class="btn btn-outline-primary" title="تعریف بانک/حساب جدید"
                            @onclick="() => OpenQuickBank(form.PayType == CashType.Cash ? TreasuryAccountKind.Cash : (form.PayType == CashType.CardReader ? TreasuryAccountKind.Pos : TreasuryAccountKind.Bank))">
                        <i class="bi bi-plus-lg ms-1"></i> تعریف بانک
                    </button>
                </div>
            </div>
            }
            @if (paymentMode == "issued")
            {
                <div class="col-md-6"><label class="form-label">بانک صادرکننده *</label><div class="input-group"><select class="form-select" @bind="issuedBankId"><option value="0">— انتخاب بانک —</option>@foreach (var a in chequeBanks) { <option value="@a.Id">@a.DisplayName</option> }</select><button type="button" class="btn btn-outline-primary" title="افزودن بانک" @onclick="() => OpenQuickBank(TreasuryAccountKind.Bank)"><i class="bi bi-plus-lg"></i></button></div></div>
                <div class="col-md-6"><label class="form-label">شماره چک *</label><input class="form-control" maxlength="50" @bind="chequeNumber" /></div>
                <div class="col-md-6"><label class="form-label">سررسید چک *</label><DatePicker @bind-Value="chequeDue" /></div>
            }
            @if (paymentMode == "received")
            {
                <div class="col-12"><label class="form-label">چک دریافتی در دست فروشگاه *</label><select class="form-select" @bind="sourceChequeId"><option value="0">— انتخاب چک —</option>@foreach (var c in receivedCheques) { <option value="@c.Id">@c.Number — @c.PartyName — @c.Amount.MoneyExact() ریال — @c.DueDate.ToFa()</option> }</select><small class="text-muted">مبلغ چک باید دقیقاً برابر مبلغ هزینه باشد و تا تعیین وضعیت دوباره قابل خرج یا وصول نیست.</small></div>
            }
            @if (paymentMode != "ordinary")
            {
                <div class="col-md-6"><label class="form-label">تاریخ تحویل چک *</label><DatePicker @bind-Value="handedAt" /></div>
                <div class="col-12"><div class="alert alert-light border mb-0 py-2 fs-8">@(paymentMode == "issued" ? "بانک فقط هنگام ثبت پاس‌شدن کسر می‌شود." : "پاس چک نزد گیرنده، بدون ثبت ورود وجه به بانک فروشگاه، تسویه فاکتور مبدأ را ثبت می‌کند.")</div></div>
            }
            <div class="col-md-6">
                <label class="form-label">دریافت‌کننده / طرف هزینه @(paymentMode != "ordinary" ? "*" : "")</label>
                <input class="form-control" @bind="form.Payee" placeholder="مثلاً موجر، اداره برق…" />
            </div>
            <div class="col-md-6">
                <label class="form-label">توضیحات</label>
                <input class="form-control" @bind="form.Description" disabled="@replacement" />
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="() => showForm = false">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            ذخیره (F1)
        </button>
    </Footer>
</Modal>

<Modal Visible="chequeDetail is not null" Title="سابقه چک‌های هزینه" Size="modal-lg" OnClose="() => chequeDetail = null">
    <ChildContent>
        @if (chequeDetail is not null)
        {
            <div class="text-muted mb-2">سند @chequeDetail.Number — مبلغ هزینه <b class="num">@chequeDetail.Amount.MoneyExact()</b> ریال</div>
            @foreach (var ch in chequeDetail.Cheques)
            {
                <div class="border rounded p-2 mb-2">
                    <div class="d-flex justify-content-between gap-2 flex-wrap"><b>@(ch.Kind == ExpenseChequeKind.Issued ? "چک صادره" : "چک دریافتی خرج‌شده") — @ch.Number</b><span>@ChequeStateName(ch.State)</span></div>
                    <div class="text-muted fs-8 mt-1">بانک: @(ch.BankName ?? "—") | گیرنده: @ch.Recipient | سررسید: @ch.DueDate.ToFa() | تحویل: @ch.HandedAt.ToFa()</div>
                    @if (ch.SettledAt.HasValue) { <div class="fs-8">تاریخ تعیین وضعیت: @ch.SettledAt.Value.ToFa() @(string.IsNullOrWhiteSpace(ch.Reason) ? "" : $" — {ch.Reason}")</div> }
                    @if (ch.State == ExpenseChequeState.Outstanding)
                    {
                        <div class="d-flex gap-2 mt-2"><button class="btn btn-sm btn-outline-primary" @onclick="() => OpenChequeStatus(ch, ExpenseChequeState.Cleared)">ثبت پاس‌شدن</button><button class="btn btn-sm btn-outline-danger" @onclick="() => OpenChequeStatus(ch, ExpenseChequeState.Returned)">برگشت / ابطال</button></div>
                    }
                </div>
            }
            @if (chequeDetail.Cheques.All(c => c.State == ExpenseChequeState.Returned))
            { <button class="btn btn-outline-primary" @onclick="() => OpenReplacement(chequeDetail)">ثبت چک جایگزین برای همین هزینه</button> }
        }
    </ChildContent>
    <Footer><button class="btn btn-light" @onclick="() => chequeDetail = null">بستن</button></Footer>
</Modal>

<Modal Visible="statusCheque is not null" Title="تعیین وضعیت چک" OnClose="() => statusCheque = null">
    <ChildContent>
        @if (statusCheque is not null)
        {
            <div class="alert alert-light border">چک @statusCheque.Number — @ChequeStateName(statusState)
                <div class="fs-8 mt-1">@(statusState == ExpenseChequeState.Cleared ? (statusCheque.Kind == ExpenseChequeKind.Issued ? "در این تاریخ مبلغ از بانک صادرکننده کسر می‌شود." : "تسویه فاکتور مبدأ ثبت می‌شود؛ وجهی به بانک فروشگاه وارد نمی‌شود.") : (statusCheque.Kind == ExpenseChequeKind.Received ? "چک مبدأ برگشتی می‌شود و هزینه همچنان ثبت است." : "چک پرداخت‌نشده بسته می‌شود و هزینه همچنان ثبت است."))</div>
            </div>
            <div class="row g-2"><div class="col-md-6"><label class="form-label">تاریخ عملیات *</label><DatePicker @bind-Value="statusDate" /></div><div class="col-md-6"><label class="form-label">توضیح</label><input class="form-control" maxlength="200" @bind="statusReason" /></div></div>
        }
    </ChildContent>
    <Footer><button class="btn btn-light" @onclick="() => statusCheque = null">انصراف</button><button class="btn btn-primary" @onclick="SaveChequeStatus" disabled="@saving">ثبت وضعیت</button></Footer>
</Modal>

<QuickBankModal @bind-Visible="showQuickBank"
                DefaultKind="quickBankKind"
                OnAccountCreated="OnQuickBankCreated" />

@* ---------------- مدیریت انواع هزینه ---------------- *@
<Modal Visible="showCats" Title="انواع هزینه" Size="modal-lg" OnClose="() => showCats = false">
    <ChildContent>
        <div class="row g-2 mb-3">
            <div class="col-md-8"><input class="form-control" placeholder="نام نوع هزینه *" @bind="catForm.Name" /></div>
            <div class="col-md-4">
                <button class="btn btn-primary w-100" data-hotkey="f1" @onclick="SaveCat" disabled="@saving">
                    @(catForm.Id == 0 ? "افزودن" : "ویرایش")
                </button>
            </div>
        </div>
        <div class="table-responsive grid-desktop">
            <table class="table table-hover align-middle">
                <thead><tr><th>نام</th><th class="text-start">تعداد سند</th><th class="text-start">جمع مبلغ (ریال)</th><th>وضعیت</th><th class="text-end">عملیات</th></tr></thead>
                <tbody>
                    @foreach (var c in categories)
                    {
                        <tr>
                            <td class="fw-500"><i class="bi bi-tag text-muted ms-1"></i> @c.Name</td>
                            <td class="text-start num">@c.ExpenseCount.Num()</td>
                            <td class="text-start num">@c.TotalAmount.Money()</td>
                            <td>
                                @if (c.IsActive)
                                {
                                    <span class="badge badge-soft-success">فعال</span>
                                }
                                else
                                {
                                    <span class="badge badge-soft-muted">غیرفعال</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <button class="btn btn-sm btn-light" @onclick="() => EditCat(c)"><i class="bi bi-pencil text-primary"></i></button>
                                <button class="btn btn-sm btn-light" title="فعال/غیرفعال" @onclick="() => ToggleCat(c)"><i class="bi bi-power @(c.IsActive ? "text-warning" : "text-success")"></i></button>
                                <button class="btn btn-sm btn-light" @onclick="() => DeleteCat(c)"><i class="bi bi-trash text-danger"></i></button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="cards-mobile">
            @foreach (var c in categories)
            {
                <div class="m-card @(c.IsActive ? "st-ready" : "st-delivered")">
                    <div class="m-card-head">
                        <div class="m-card-icon"><i class="bi bi-tag"></i></div>
                        <div class="flex-grow-1 min-w-0">
                            <div class="fw-700 text-truncate">@c.Name</div>
                            <div class="fs-8 text-muted num">@c.ExpenseCount.Num() سند — @c.TotalAmount.Money() ریال</div>
                        </div>
                    </div>
                    <div class="m-card-actions">
                        <button class="btn btn-light text-primary" @onclick="() => EditCat(c)"><i class="bi bi-pencil"></i> ویرایش</button>
                        <button class="btn btn-light" @onclick="() => ToggleCat(c)"><i class="bi bi-power"></i></button>
                        <button class="btn btn-light text-danger" @onclick="() => DeleteCat(c)"><i class="bi bi-trash"></i></button>
                    </div>
                </div>
            }
        </div>
    </ChildContent>
</Modal>

@code {
    private List<ExpenseDto> items = new();
    private List<ExpenseCategoryDto> categories = new();
    private bool loading = true, saving, showForm, showCats;

    private string search = "";
    private int catFilter;
    private DateTime? from, to;
    private int page = 1, pageCount = 1, total;
    private const int PageSize = 15;
    private System.Threading.CancellationTokenSource? searchCts;
    private int loadVersion;

    private ExpenseDto form = new();
    private ExpenseCategoryDto catForm = new();
    private string catIdStr = "0", fAmount = "";
    private DateTime? expDate;

    private bool replacement;
    private string paymentMode = "ordinary", chequeNumber = "", statusReason = "";
    private int issuedBankId, sourceChequeId;
    private DateTime? chequeDue, handedAt, statusDate;
    private Guid chequeOperation, statusOperation;
    private List<TrsAccount> chequeBanks = new();
    private List<ShopChequeItem> receivedCheques = new();
    private ExpenseDto? chequeDetail;
    private ExpenseChequeDto? statusCheque;
    private ExpenseChequeState statusState;

    private static string ChequeStateName(ExpenseChequeState state) => state switch
    {
        ExpenseChequeState.Outstanding => "در جریان", ExpenseChequeState.Cleared => "پاس‌شده", _ => "برگشتی / ابطال"
    };
    private static string ChequeSummary(ExpenseDto e)
    {
        var ch = e.Cheques.Last();
        return (ch.Kind == ExpenseChequeKind.Issued ? "چک صادره" : "چک دریافتی") + " — " + ChequeStateName(ch.State);
    }
    private async Task PrepareMode(string mode)
    {
        paymentMode = mode;
        try
        {
            if (mode == "issued") chequeBanks = await ExpenseSvc.GetChequeBanksAsync();
            if (mode == "received") receivedCheques = await ExpenseSvc.GetAvailableReceivedChequesAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
    private async Task OpenReplacement(ExpenseDto expense)
    {
        form = new ExpenseDto { Id = expense.Id, Number = expense.Number, CategoryId = expense.CategoryId,
            Amount = expense.Amount, Date = expense.Date, Payee = expense.Payee, Description = expense.Description };
        catIdStr = expense.CategoryId.ToString(); fAmount = Fa.FormatTyping(expense.Amount.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture));
        expDate = expense.Date; handedAt = DateTime.Today; chequeDue = DateTime.Today; chequeNumber = "";
        chequeOperation = Guid.NewGuid(); sourceChequeId = 0; issuedBankId = 0; replacement = true; chequeDetail = null; showForm = true;
        await PrepareMode("issued");
    }
    private void OpenChequeStatus(ExpenseChequeDto cheque, ExpenseChequeState state)
    {
        statusCheque = cheque; statusState = state; statusDate = DateTime.Today; statusReason = ""; statusOperation = Guid.NewGuid();
    }
    private async Task SaveChequeStatus()
    {
        if (saving || statusCheque is null) return;
        if (!statusDate.HasValue) { Toast.Error("تاریخ عملیات را وارد کنید."); return; }
        saving = true;
        try
        {
            await ExpenseSvc.ChangeChequeStatusAsync(statusCheque.Id, statusCheque.Kind,
                new ExpenseChequeStatusCommand { OperationId = statusOperation, Date = statusDate.Value, State = statusState, Reason = statusReason });
            statusCheque = null; Toast.Success("وضعیت چک ثبت شد."); await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    // ---------- بانک / صندوق نحوهٔ پرداخت ----------
    private List<TrsAccount> bankAccounts = new();
    private bool showQuickBank;
    private TreasuryAccountKind quickBankKind = TreasuryAccountKind.Cash;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("هزینه‌ها");
        await LoadCats();
        try { bankAccounts = await AccountSvc.GetAllAsync(true); } catch { }
        await Load();
    }

    private List<TrsAccount> AccountsForPayType() => form.PayType switch
    {
        CashType.Cash => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Cash or TreasuryAccountKind.PettyCash).ToList(),
        CashType.CardReader => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Pos or TreasuryAccountKind.Bank).ToList(),
        _ => bankAccounts.Where(a => a.Kind is TreasuryAccountKind.Bank or TreasuryAccountKind.Pos).ToList(),
    };

    private void OnBankChanged(ChangeEventArgs e)
    {
        var id = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        form.TrsAccountId = id == 0 ? null : id;
        form.TrsAccountName = bankAccounts.FirstOrDefault(a => a.Id == id)?.DisplayName;
    }

    private void OpenQuickBank(TreasuryAccountKind kind)
    {
        quickBankKind = kind;
        showQuickBank = true;
    }

    private async Task OnQuickBankCreated(TrsAccount acc)
    {
        try { bankAccounts = await AccountSvc.GetAllAsync(true); } catch { }
        form.TrsAccountId = acc.Id;
        form.TrsAccountName = acc.DisplayName;
        if (paymentMode == "issued")
        {
            try { chequeBanks = await ExpenseSvc.GetChequeBanksAsync(); issuedBankId = acc.Id; } catch (Exception ex) { Toast.Error(ex.Message); }
        }
    }

    private async Task LoadCats()
    {
        try { categories = await ExpenseSvc.GetCategoriesAsync(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task Load()
    {
        var version = ++loadVersion;
        loading = true;
        try
        {
            var res = await ExpenseSvc.GetExpensesAsync(search, catFilter, from, to, page, PageSize);
            if (version != loadVersion) return;
            items = res.Items;
            total = res.TotalCount;
            pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
            if (chequeDetail is not null) chequeDetail = items.FirstOrDefault(e => e.Id == chequeDetail.Id);
        }
        catch (Exception ex) { if (version == loadVersion) Toast.Error(ex.Message); }
        finally { if (version == loadVersion) loading = false; }
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        search = e.Value?.ToString() ?? "";
        searchCts?.Cancel();
        var cts = new System.Threading.CancellationTokenSource();
        searchCts = cts;
        var version = ++loadVersion; // invalidate an older in-flight response immediately
        page = 1;
        try
        {
            if (!string.IsNullOrWhiteSpace(search)) await Task.Delay(300, cts.Token);
            if (cts.IsCancellationRequested || version != loadVersion) return;
            await Load();
        }
        catch (OperationCanceledException) { }
        finally
        {
            if (ReferenceEquals(searchCts, cts)) searchCts = null;
            cts.Dispose();
        }
    }

    public void Dispose()
    {
        ++loadVersion;
        searchCts?.Cancel();
    }

    private async Task OnCatFilter(ChangeEventArgs e)
    {
        catFilter = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        page = 1;
        await Load();
    }

    private async Task ApplyFilter() { page = 1; await Load(); }
    private async Task GoToPage(int p) { page = p; await Load(); }

    private RenderFragment PayTypeBadge(CashType t) => t switch
    {
        CashType.CardReader => @<span class="badge badge-pay-cheque fs-8"><i class="bi bi-credit-card"></i> کارت‌خوان</span>,
        CashType.CardTransfer => @<span class="badge badge-pay-inst fs-8"><i class="bi bi-arrow-left-right"></i> کارت به کارت</span>,
        _ => @<span class="badge badge-pay-cash fs-8"><i class="bi bi-cash"></i> نقد</span>
    };

    private void OpenNew()
    {
        form = new ExpenseDto { Date = DateTime.Now, PayType = CashType.Cash };
        replacement = false; paymentMode = "ordinary"; chequeOperation = Guid.NewGuid();
        chequeNumber = ""; issuedBankId = 0; sourceChequeId = 0; chequeDue = DateTime.Today; handedAt = DateTime.Today;
        catIdStr = "0"; fAmount = ""; expDate = DateTime.Now;
        showForm = true;
    }

    private void OpenEdit(ExpenseDto e)
    {
        replacement = false; paymentMode = "ordinary";
        form = new ExpenseDto
        {
            Id = e.Id, Number = e.Number, CategoryId = e.CategoryId, Amount = e.Amount,
            Date = e.Date, PayType = e.PayType, TrsAccountId = e.TrsAccountId, TrsAccountName = e.TrsAccountName,
            Payee = e.Payee, Description = e.Description
        };
        catIdStr = e.CategoryId.ToString();
        fAmount = Fa.FormatTyping(e.Amount.ToString("0"));
        expDate = e.Date;
        showForm = true;
    }

    private async Task Save()
    {
        if (saving) return;
        form.CategoryId = int.TryParse(catIdStr, out var cid) ? cid : 0;
        form.Amount = Fa.ParseDecimal(fAmount);
        form.Date = expDate ?? DateTime.Now;

        if (form.CategoryId <= 0) { Toast.Error("نوع هزینه را انتخاب کنید."); return; }
        if (form.Amount <= 0) { Toast.Error("مبلغ هزینه را وارد کنید."); return; }

        saving = true;
        try
        {
            if (paymentMode == "ordinary")
                await ExpenseSvc.SaveExpenseAsync(form);
            else
            {
                if (string.IsNullOrWhiteSpace(form.Payee) || !handedAt.HasValue)
                    throw new InvalidOperationException("دریافت‌کننده و تاریخ تحویل چک را وارد کنید.");
                if (paymentMode == "issued" && (issuedBankId <= 0 || string.IsNullOrWhiteSpace(chequeNumber) || !chequeDue.HasValue))
                    throw new InvalidOperationException("بانک، شماره و سررسید چک صادره را وارد کنید.");
                if (paymentMode == "received" && sourceChequeId <= 0)
                    throw new InvalidOperationException("چک دریافتی را انتخاب کنید.");
                await ExpenseSvc.CreateChequeExpenseAsync(new ExpenseChequeCreateCommand
                {
                    OperationId = chequeOperation, Kind = paymentMode == "issued" ? ExpenseChequeKind.Issued : ExpenseChequeKind.Received,
                    Expense = form, Recipient = form.Payee, HandedAt = handedAt.Value,
                    IssuingAccountId = paymentMode == "issued" ? issuedBankId : null,
                    SourceChequeId = paymentMode == "received" ? sourceChequeId : null,
                    Number = chequeNumber, DueDate = chequeDue ?? default
                });
            }
            Toast.Success(replacement ? "چک جایگزین ثبت شد." : form.Id == 0 ? "سند هزینه ثبت شد." : "سند هزینه ویرایش شد.");
            showForm = false;
            await LoadCats();
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task Delete(ExpenseDto e)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"آیا از حذف سند «{e.Number}» مطمئن هستید؟");
        if (!ok) return;
        try
        {
            await ExpenseSvc.DeleteExpenseAsync(e.Id);
            Toast.Success("سند هزینه حذف شد.");
            await LoadCats();
            await Load();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---------------- انواع هزینه ----------------

    private void OpenCats() { catForm = new ExpenseCategoryDto(); showCats = true; }
    private void EditCat(ExpenseCategoryDto c) => catForm = new ExpenseCategoryDto { Id = c.Id, Name = c.Name, IsActive = c.IsActive };

    private async Task SaveCat()
    {
        if (saving) return;
        if (string.IsNullOrWhiteSpace(catForm.Name)) { Toast.Error("نام نوع هزینه را وارد کنید."); return; }
        saving = true;
        var savedName = catForm.Name.Trim();
        try
        {
            await ExpenseSvc.SaveCategoryAsync(catForm);
            Toast.Success("نوع هزینه ذخیره شد.");
            catForm = new ExpenseCategoryDto();
            await LoadCats();
            // اگر از داخل فرم هزینه نوع تازه‌ای ساخته شد، همان را در فرم انتخاب کن.
            var savedCategory = categories.FirstOrDefault(x => x.Name == savedName && x.IsActive);
            if (savedCategory is not null) catIdStr = savedCategory.Id.ToString();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }

    private async Task ToggleCat(ExpenseCategoryDto c)
    {
        try
        {
            await ExpenseSvc.SaveCategoryAsync(new ExpenseCategoryDto { Id = c.Id, Name = c.Name, IsActive = !c.IsActive });
            await LoadCats();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task DeleteCat(ExpenseCategoryDto c)
    {
        var ok = await JS.InvokeAsync<bool>("confirm", $"حذف نوع هزینه «{c.Name}»؟");
        if (!ok) return;
        try
        {
            await ExpenseSvc.DeleteCategoryAsync(c.Id);
            await LoadCats();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }
