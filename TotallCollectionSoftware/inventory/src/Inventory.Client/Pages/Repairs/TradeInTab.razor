@namespace Inventory.Client.Pages
@implements IDisposable
@inject IApiClient Api
@inject IOrderService OrderSvc
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS

<div class="page-head">
    <div><h1>طرح تعویض</h1><p class="lead">ارزش دستگاه را فروشگاه تعیین می‌کند؛ دستگاه فعلاً وارد موجودی نمی‌شود.</p></div>
    @if (CanManage)
    {
        <button class="btn btn-primary me-auto" type="button" @onclick="New"><i class="bi bi-plus-lg"></i> پذیرش تعویض</button>
    }
</div>
<div class="alert alert-light border fs-8">پس از نهایی‌سازی، ارزش دستگاه به اعتبار مشتری افزوده می‌شود و در صورت‌حساب، تسویه فروش یا پرداخت وجه قابل پیگیری است.</div>

<style>
/* ---------- نوار فیلتر فشردهٔ «طرح تعویض» ---------- */
.ti-filter-bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: .5rem .65rem;
    background: #fff;
    border: 1px solid #e3e8ee;
    border-radius: 12px;
    padding: .5rem .65rem;
    margin-bottom: .5rem;
}
.ti-search { position: relative; flex: 1 1 260px; min-width: 180px; }
.ti-search-icon {
    position: absolute; inset-inline-start: .7rem; top: 50%; transform: translateY(-50%);
    color: #94a3b8; font-size: .82rem; pointer-events: none;
}
.ti-search-input {
    width: 100%; height: 34px;
    padding-inline: 2.05rem 2rem;
    font-size: .82rem; color: #1e293b;
    background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 9px;
    outline: none; transition: border-color .15s, background .15s, box-shadow .15s;
}
.ti-search-input:focus { background: #fff; border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.12); }
.ti-search-clear {
    position: absolute; inset-inline-end: .35rem; top: 50%; transform: translateY(-50%);
    border: 0; background: none; color: #94a3b8; font-size: .72rem;
    padding: .25rem .35rem; border-radius: 6px; line-height: 1;
}
.ti-search-clear:hover { color: #e11d48; background: #fef2f2; }
.ti-control { display: flex; align-items: center; gap: .35rem; margin: 0; }
.ti-control-text { font-size: .74rem; font-weight: 700; color: #64748b; white-space: nowrap; }
.ti-status { width: auto; min-width: 9.5rem; height: 34px; font-size: .78rem; border-radius: 9px; }
.ti-date-range .date-picker { width: 7.4rem; }
.ti-date-range .date-picker .form-control { height: 34px; font-size: .74rem; padding-inline: .45rem; }
.ti-date-range .date-picker .btn { height: 34px; padding-inline: .4rem; font-size: .7rem; }
.ti-range-dash { color: #cbd5e1; font-size: .8rem; }
.ti-presets { display: inline-flex; border: 1px solid #e2e8f0; border-radius: 9px; overflow: hidden; }
.ti-presets button {
    border: 0; background: #fff; color: #475569;
    font-size: .72rem; font-weight: 700; padding: .32rem .55rem; line-height: 1.15;
}
.ti-presets button + button { border-inline-start: 1px solid #e2e8f0; }
.ti-presets button:hover { background: #f8fafc; }
.ti-presets button.on { background: #eef2ff; color: #4338ca; }
.ti-filter-tail { display: flex; align-items: center; gap: .5rem; margin-inline-start: auto; }
.ti-count { font-size: .74rem; color: #94a3b8; white-space: nowrap; }
.ti-loading { display: inline-flex; color: #6366f1; }
.ti-clear {
    border: 0; background: none; color: #e11d48; font-size: .74rem; font-weight: 700;
    padding: .3rem .5rem; border-radius: 8px; white-space: nowrap;
}
.ti-clear:hover:not(:disabled) { background: #fef2f2; }
.ti-clear:disabled { opacity: .5; }
.ti-chips { display: flex; flex-wrap: wrap; gap: .35rem; margin-bottom: .75rem; }
.ti-chips:empty { display: none; }
/* در جستجوی زنده جدول پاک نمی‌شود؛ فقط کم‌رنگ می‌شود تا تایپ نلرزد */
.ti-stale { opacity: .55; transition: opacity .12s ease; }
.ti-chip {
    display: inline-flex; align-items: center; gap: .3rem;
    border: 1px solid #e0e7ff; background: #eef2ff; color: #4338ca;
    border-radius: 99px; padding: .18rem .6rem; font-size: .72rem; font-weight: 600;
}
.ti-chip b { font-weight: 800; max-width: 14rem; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.ti-chip:hover { background: #e0e7ff; }
@media (max-width: 767.98px) {
    .ti-search { flex: 1 1 100%; }
    .ti-date-range { flex-wrap: wrap; }
    .ti-filter-tail { margin-inline-start: 0; width: 100%; justify-content: space-between; }
}
</style>


@* ---------- نوار فیلتر فشردهٔ طرح تعویض (زنده، یک‌خطی) ---------- *@
<section class="ti-filter-bar d-print-none" aria-label="فیلتر پذیرش‌های تعویض">
    <div class="ti-search">
        <i class="bi bi-search ti-search-icon" aria-hidden="true"></i>
        <input type="search"
               class="ti-search-input"
               placeholder="جستجوی شماره، مشتری، دستگاه یا سریال…"
               aria-label="جستجوی پذیرش تعویض"
               @bind="search"
               @bind:event="oninput"
               @bind:after="DebouncedLoadAsync" />
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <button type="button" class="ti-search-clear" title="پاک کردن جستجو" aria-label="پاک کردن جستجو"
                    @onclick="ClearSearchAsync">
                <i class="bi bi-x-lg"></i>
            </button>
        }
    </div>

    <label class="ti-control">
        <span class="ti-control-text">وضعیت</span>
        <select class="form-select form-select-sm ti-status" aria-label="فیلتر وضعیت"
                @bind="statusFilter" @bind:after="Load">
            <option value="">همه وضعیت‌ها</option>
            <option value="@((int)TradeInStatusFilter.Draft)">پیش‌نویس</option>
            <option value="@((int)TradeInStatusFilter.Finalized)">نهایی‌شده</option>
            <option value="@((int)TradeInStatusFilter.WithCredit)">دارای اعتبار باقیمانده</option>
        </select>
    </label>

    <div class="ti-control ti-date-range">
        <span class="ti-control-text">پذیرش از</span>
        <DatePicker Value="from" ValueChanged="OnFromChanged" AllowClear="true" Placeholder="از تاریخ" />
        <span class="ti-range-dash" aria-hidden="true">—</span>
        <span class="ti-control-text">تا</span>
        <DatePicker Value="to" ValueChanged="OnToChanged" AllowClear="true" Placeholder="تا تاریخ" />
        <div class="ti-presets" role="group" aria-label="بازهٔ سریع تاریخ">
            <button type="button" class="@(quickRangeDays == 7 ? "on" : "")" title="۷ روز اخیر"
                    aria-pressed="@(quickRangeDays == 7 ? "true" : "false")" @onclick="() => SetQuickRange(7)">۷ روز</button>
            <button type="button" class="@(quickRangeDays == 30 ? "on" : "")" title="۳۰ روز اخیر"
                    aria-pressed="@(quickRangeDays == 30 ? "true" : "false")" @onclick="() => SetQuickRange(30)">۳۰ روز</button>
            <button type="button" class="@(quickRangeDays == 90 ? "on" : "")" title="۹۰ روز اخیر"
                    aria-pressed="@(quickRangeDays == 90 ? "true" : "false")" @onclick="() => SetQuickRange(90)">۹۰ روز</button>
        </div>
    </div>

    <div class="ti-filter-tail">
        @if (loading)
        {
            <span class="ti-loading" role="status" aria-label="در حال به‌روزرسانی">
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
            </span>
        }
        else
        {
            <span class="ti-count num">@items.Count.Num() مورد</span>
        }
        @if (HasFilters)
        {
            <button type="button" class="ti-clear" @onclick="ResetFilters" disabled="@loading">
                <i class="bi bi-x-circle ms-1"></i> پاک کردن فیلترها
            </button>
        }
    </div>
</section>

@if (HasFilters)
{
    <div class="ti-chips d-print-none" aria-label="فیلترهای فعال">
        @if (!string.IsNullOrWhiteSpace(search))
        {
            <button type="button" class="ti-chip" @onclick="ClearSearchAsync" title="حذف این فیلتر">
                جستجو: <b>@search</b> <i class="bi bi-x"></i>
            </button>
        }
        @if (!string.IsNullOrWhiteSpace(statusFilter))
        {
            <button type="button" class="ti-chip" @onclick="ClearStatusAsync" title="حذف این فیلتر">
                وضعیت: <b>@StatusText</b> <i class="bi bi-x"></i>
            </button>
        }
        @if (from.HasValue)
        {
            <button type="button" class="ti-chip" @onclick="ClearFromAsync" title="حذف این فیلتر">
                از <b class="num">@from.Value.ToFa()</b> <i class="bi bi-x"></i>
            </button>
        }
        @if (to.HasValue)
        {
            <button type="button" class="ti-chip" @onclick="ClearToAsync" title="حذف این فیلتر">
                تا <b class="num">@to.Value.ToFa()</b> <i class="bi bi-x"></i>
            </button>
        }
        @if (quickRangeDays > 0)
        {
            <button type="button" class="ti-chip" @onclick="() => SetQuickRange(quickRangeDays)" title="حذف این فیلتر">
                بازه: <b>@QuickRangeLabel اخیر</b> <i class="bi bi-x"></i>
            </button>
        }
    </div>
}

@if (loading && items.Count == 0) { <div class="text-center p-4" role="status">در حال دریافت پذیرش‌ها…</div> }
else if (items.Count == 0)
{
    <div class="empty-state">
        <i class="bi bi-arrow-left-right"></i>
        <h5>@(HasFilters ? "با این فیلتر پذیرشی یافت نشد" : "پذیرش تعویضی ثبت نشده است")</h5>
        @if (HasFilters) { <button class="btn btn-sm btn-light" type="button" @onclick="ResetFilters">پاک کردن فیلتر</button> }
    </div>
}
else
{
    <div class="card @(loading ? "ti-stale" : "")" aria-busy="@(loading ? "true" : "false")"><div class="table-responsive"><table class="table table-hover align-middle mb-0">
        <thead><tr><th>شماره / تاریخ</th><th>مشتری</th><th>دستگاه</th><th class="text-start">ارزش (ریال)</th><th class="text-start">اعتبار باقیمانده</th><th>وضعیت</th><th>عملیات</th></tr></thead>
        <tbody>@foreach (var item in items)
        {
            <tr>
                <td><b>@item.Number</b><div class="text-muted fs-8 num">@item.ReceivedAt.ToFa()</div></td>
                <td>@item.PartyName</td><td>@item.DeviceType @item.DeviceModel <div class="text-muted fs-9">@item.SerialNumber</div></td>
                <td class="num text-start">@item.Value.MoneyExact()</td><td class="num text-start fw-bold">@item.AvailableCredit.MoneyExact()</td>
                <td>@(item.FinalizedAt.HasValue ? "نهایی‌شده" : "پیش‌نویس")</td>
                <td class="text-nowrap">
                    @if (!item.FinalizedAt.HasValue && CanManage)
                    {
                        <button class="btn btn-sm btn-light" type="button" @onclick="() => Edit(item)">ویرایش</button>
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => Finalize(item)" disabled="@saving">نهایی‌سازی</button>
                    }
                    @if (item.FinalizedAt.HasValue && item.AvailableCredit > 0 && CanManage && CanSettle)
                    {
                        <button class="btn btn-sm btn-outline-primary" type="button" @onclick="() => OpenUse(item)">مصرف / پرداخت اعتبار</button>
                    }
                    @if (item.Uses.Count > 0) { <button class="btn btn-sm btn-light" type="button" @onclick="() => history = item">گردش‌ها</button> }
                </td>
            </tr>
        }</tbody>
    </table></div></div>
}

<Modal Visible="showForm" Title="@(form.Id == 0 ? "پذیرش طرح تعویض" : $"ویرایش {form.Number}")" OnClose="() => showForm = false">
    <ChildContent>
        <div class="repair-form">
        <div class="repair-block">
        <div class="repair-block-head">
            <i class="bi bi-person-vcard text-primary"></i>
            <h6>مشتری و تاریخ</h6>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">مشتری *</label><div class="d-flex gap-2"><div class="flex-grow-1" style="min-width:0"><SearchSelect Items="customers" @bind-Value="form.PartyId" Placeholder="انتخاب مشتری" ConstrainToModal="true" /></div><button type="button" class="btn btn-outline-primary btn-sm" disabled="@(!CanManage)" aria-label="تعریف مشتری جدید" @onclick="() => showNewCustomer = true">جدید</button></div></div>
            <div class="col-md-6"><label class="form-label">تاریخ پذیرش *</label><DatePicker @bind-Value="receivedAt" /></div>
        </div>
        </div>
        <div class="repair-block">
        <div class="repair-block-head">
            <i class="bi bi-pc-display-horizontal text-primary"></i>
            <h6>دستگاه و ارزش تعیین‌شده</h6>
        </div>
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label">نوع دستگاه *</label><input class="form-control" maxlength="100" @bind="form.DeviceType" /></div>
            <div class="col-md-6"><label class="form-label">مدل</label><input class="form-control" maxlength="200" @bind="form.DeviceModel" /></div>
            <div class="col-md-6"><label class="form-label">سریال</label><input class="form-control num" dir="ltr" maxlength="100" @bind="form.SerialNumber" /></div>
            <div class="col-md-6"><label class="form-label">ارزش تعیین‌شده (ریال) *</label><input class="form-control num" dir="ltr" inputmode="numeric" value="@valueText" @oninput="e => valueText = Fa.FormatTyping(e.Value?.ToString())" /></div>
            <div class="col-12"><label class="form-label">یادداشت</label><input class="form-control" maxlength="500" @bind="form.Note" /></div>
        </div>
        </div>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="() => showForm = false">انصراف (Esc)</button>
        <button type="button" class="btn btn-primary me-auto" data-hotkey="f1" @onclick="Save" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            ذخیره پیش‌نویس (F1)
        </button>
    </Footer>
</Modal>

<Modal Visible="useTarget is not null" Title="مصرف یا پرداخت اعتبار مشتری" OnClose="CloseUse">
    <ChildContent>
        @if (useTarget is not null)
        {
            <div class="repair-form">
            <div class="alert alert-light border">@useTarget.PartyName — اعتبار باقیمانده: <b class="num">@useTarget.AvailableCredit.MoneyExact()</b> ریال</div>
            <div class="row g-3">
                <div class="col-md-6"><label class="form-label">نوع عملیات</label><select class="form-select" @bind="useKind"><option value="1">تسویه فاکتور فروش</option><option value="2">پرداخت وجه به مشتری</option></select></div>
                <div class="col-md-6"><label class="form-label">تاریخ عملیات</label><DatePicker @bind-Value="useDate" /></div>
                @if (useKind == 1)
                {
                    <div class="col-12"><label class="form-label">فاکتور فروش همین مشتری</label>
                        <select class="form-select" @bind="targetSaleId"><option value="0">— انتخاب فاکتور —</option>
                            @foreach (var order in orders) { <option value="@order.Id">@order.Number — @order.Date.ToFa() — @order.TotalAmount.MoneyExact() ریال</option> }
                        </select>
                        <small class="text-muted">مبلغ فقط تا مانده نسیه آزاد فاکتور قابل مصرف است؛ چک و اقساط جداگانه حفظ می‌شوند.</small>
                    </div>
                }
                else
                {
                    <div class="col-12"><label class="form-label">صندوق / بانک پرداخت</label><select class="form-select" @bind="accountId"><option value="0">— انتخاب حساب —</option>@foreach (var account in accounts) { <option value="@account.Id">@account.DisplayName</option> }</select></div>
                }
                <div class="col-12"><label class="form-label">مبلغ عملیات (ریال)</label><input class="form-control num" dir="ltr" inputmode="numeric" value="@useAmountText" @oninput="e => useAmountText = Fa.FormatTyping(e.Value?.ToString())" /></div>
            </div>
            </div>
        }
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="CloseUse">انصراف (Esc)</button>
        <button type="button" class="btn btn-primary me-auto" data-hotkey="f1" @onclick="SaveUse" disabled="@saving">
            @if (saving) { <span class="spinner-border spinner-border-sm ms-1"></span> }
            ثبت عملیات (F1)
        </button>
    </Footer>
</Modal>

<Modal Visible="history is not null" Title="گردش اعتبار تعویض" OnClose="() => history = null">
    <ChildContent>@if (history is not null)
    {
        <div class="table-responsive"><table class="table"><thead><tr><th>تاریخ</th><th>عملیات</th><th>مقصد</th><th>مبلغ</th></tr></thead><tbody>
            @foreach (var u in history.Uses)
            { <tr><td>@u.Date.ToFa()</td><td>@(u.Kind == TradeInUseKind.ApplyToSale ? "تسویه فروش" : "پرداخت وجه")</td><td>@(u.TargetSaleNumber ?? u.TrsAccountName ?? "—")</td><td class="num">@u.Amount.MoneyExact()</td></tr> }
        </tbody></table></div>
    }</ChildContent>
</Modal>

<PartyFormModal ShopQuickCreate="true" Visible="showNewCustomer" Type="PartyType.Customer" AllowReferrerPicker="true" OnSaved="OnCustomerCreated" OnCancel="() => showNewCustomer = false" />

@code {
    private bool showNewCustomer;
    private Task OnCustomerCreated(Party created)
    {
        showNewCustomer = false;
        customers.RemoveAll(c => c.Id == created.Id);
        customers.Add(new LookupItem { Id = created.Id, Name = created.Name });
        form.PartyId = created.Id;
        return Task.CompletedTask;
    }
    private List<ShopTradeInDto> items = new();
    private List<LookupItem> customers = new();
    private List<ShopTradeInTargetSaleDto> orders = new();
    private List<TrsAccount> accounts = new();
    private ShopTradeInDto form = new();
    private ShopTradeInDto? useTarget, history;
    private DateTime? receivedAt, useDate;
    private string valueText = "", useAmountText = "";
    private int useKind = 1, targetSaleId, accountId;
    private Guid useOperation;
    private bool loading, saving, showForm;
    private string search = "";
    private bool CanManage => ShopAccess.CanManage(Auth, "Repairs");
    private bool CanSettle => Auth.IsAdmin || Auth.HasDirect("Orders.Update") || ShopAccess.CanManage(Auth, "Sale") || ShopAccess.CanManage(Auth, "Installments");

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Api.GetAsync<List<LookupItem>>("api/shop-trade-ins/customers"); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        await Load();
    }
    private async Task Load()
    {
        // بازهٔ تاریخ برعکس، هیچ نتیجه‌ای ندارد؛ پیام روشن به‌جای جدول خالی.
        var start = EffectiveFrom;
        if (start.HasValue && to.HasValue && start.Value.Date > to.Value.Date)
        {
            items = new();
            Toast.Error("تاریخ «از» پس از تاریخ «تا» است؛ بازه را اصلاح کنید.");
            return;
        }
        loading = true;
        try { items = await Api.GetAsync<List<ShopTradeInDto>>(BuildFilterUrl()); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private string? statusFilter;
    private DateTime? from, to;
    // فیلترهای + (افزودنی): بازهٔ سریع بدون پر کردن فیلدهای تاریخ؛ از هر دو با هم استفاده می‌شود.
    private int quickRangeDays;
    private bool HasFilters => !string.IsNullOrWhiteSpace(search) || !string.IsNullOrWhiteSpace(statusFilter) ||
        from.HasValue || to.HasValue || quickRangeDays > 0;

    /// <summary>تاریخ شروع مؤثر: تاریخ دستی، وگرنه ابتدای بازهٔ سریع. تاریخ دستی همیشه اولویت دارد.</summary>
    private DateTime? EffectiveFrom =>
        from ?? (quickRangeDays > 0 ? DateTime.Today.AddDays(-(quickRangeDays - 1)) : null);

    private string BuildFilterUrl()
    {
        var query = new List<string>();
        if (!string.IsNullOrWhiteSpace(search)) query.Add($"search={Uri.EscapeDataString(search.Trim())}");
        if (!string.IsNullOrWhiteSpace(statusFilter)) query.Add($"status={Uri.EscapeDataString(statusFilter)}");
        if (EffectiveFrom.HasValue) query.Add($"from={EffectiveFrom.Value:yyyy-MM-dd}");
        if (to.HasValue) query.Add($"to={to.Value:yyyy-MM-dd}");
        return query.Count == 0 ? "api/shop-trade-ins" : "api/shop-trade-ins?" + string.Join("&", query);
    }

    // فیلترها با @bind:after زنده اعمال می‌شوند؛ دکمهٔ تأیید جدا لازم نیست.

    private async Task OnFromChanged(DateTime? value)
    {
        from = value;
        await Load();
    }

    private async Task OnToChanged(DateTime? value)
    {
        to = value;
        await Load();
    }

    private async Task ClearSearchAsync()
    {
        search = "";
        await Load();
    }

    private async Task ClearStatusAsync()
    {
        statusFilter = null;
        await Load();
    }

    private async Task ClearFromAsync()
    {
        from = null;
        quickRangeDays = 0;
        await Load();
    }

    /// <summary>بازهٔ سریع (۰ = همه)؛ با کلیک دوباره روی همان گزینه، بازه برداشته می‌شود.</summary>
    private async Task SetQuickRange(int days)
    {
        quickRangeDays = quickRangeDays == days ? 0 : days;
        await Load();
    }

    private string QuickRangeLabel => quickRangeDays switch
    {
        7 => "۷ روز",
        30 => "۳۰ روز",
        90 => "۹۰ روز",
        _ => ""
    };

    private async Task ClearToAsync()
    {
        to = null;
        await Load();
    }

    /// <summary>متن خوانا برای چیپ وضعیت؛ همان برچسبی که در فهرست دیده می‌شود.</summary>
    private string StatusText => statusFilter switch
    {
        "0" => "پیش‌نویس",
        "1" => "نهایی‌شده",
        "2" => "دارای اعتبار باقیمانده",
        _ => "همه وضعیت‌ها"
    };

    private async Task ResetFilters()
    {
        search = ""; statusFilter = null; from = null; to = null; quickRangeDays = 0;
        await Load();
    }

    private CancellationTokenSource? searchCts;

    /// <summary>جستجوی زنده با تأخیر کوتاه تا هر کلید یک درخواست جدا نسازد.</summary>
    private async Task DebouncedLoadAsync()
    {
        searchCts?.Cancel();
        var cts = new CancellationTokenSource();
        searchCts = cts;
        try
        {
            await Task.Delay(350, cts.Token);
            if (cts.IsCancellationRequested) return;
            await Load();
        }
        catch (TaskCanceledException) { }
    }

    public void Dispose() => searchCts?.Cancel();
    private void New()
    {
        form = new ShopTradeInDto { OperationId = Guid.NewGuid(), ReceivedAt = DateTime.Today };
        receivedAt = DateTime.Today; valueText = ""; showForm = true;
    }
    private void Edit(ShopTradeInDto t)
    {
        form = new ShopTradeInDto { Id = t.Id, OperationId = t.OperationId, Number = t.Number, PartyId = t.PartyId,
            DeviceType = t.DeviceType, DeviceModel = t.DeviceModel, SerialNumber = t.SerialNumber, Note = t.Note, Value = t.Value, ReceivedAt = t.ReceivedAt };
        receivedAt = t.ReceivedAt; valueText = Fa.FormatTyping(t.Value.ToString("0", System.Globalization.CultureInfo.InvariantCulture)); showForm = true;
    }
    private async Task Save()
    {
        if (saving) return;
        form.Value = Fa.ParseDecimal(valueText); form.ReceivedAt = receivedAt ?? default;
        saving = true;
        try { await Api.PostAsync<ShopTradeInDto>("api/shop-trade-ins", form); showForm = false; Toast.Success("پیش‌نویس تعویض ثبت شد."); await Load(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }
    private async Task Finalize(ShopTradeInDto t)
    {
        if (saving || !await JS.InvokeAsync<bool>("confirm", $"نهایی‌سازی {t.Number} و ثبت اعتبار {t.Value.MoneyExact()} ریالی برای {t.PartyName}؟")) return;
        saving = true;
        try { await Api.PostAsync<ShopTradeInDto>($"api/shop-trade-ins/{t.Id}/finalize", new ShopTradeInFinalizationCommand { Date = DateTime.Today }); Toast.Success("اعتبار مشتری ثبت شد."); await Load(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }
    private async Task OpenUse(ShopTradeInDto t)
    {
        useTarget = t; useOperation = Guid.NewGuid(); useKind = 1; targetSaleId = 0; accountId = 0; useDate = DateTime.Today; useAmountText = "";
        try { orders = await Api.GetAsync<List<ShopTradeInTargetSaleDto>>($"api/shop-trade-ins/target-sales/{t.PartyId}"); }
        catch (Exception ex) { orders = new(); Toast.Error(ex.Message); }
        try { accounts = await OrderSvc.GetActiveTreasuryAccountsAsync(); }
        catch (Exception ex) { accounts = new(); Toast.Error(ex.Message); }
    }
    private void CloseUse() => useTarget = null;
    private async Task SaveUse()
    {
        if (saving || useTarget is null) return;
        var cmd = new ShopTradeInUseCommand { OperationId = useOperation, Kind = (TradeInUseKind)useKind, Date = useDate ?? default,
            Amount = Fa.ParseDecimal(useAmountText), TargetSaleId = useKind == 1 && targetSaleId > 0 ? targetSaleId : null,
            TrsAccountId = useKind == 2 && accountId > 0 ? accountId : null };
        saving = true;
        try { await Api.PostAsync<object>($"api/shop-trade-ins/{useTarget.Id}/use", cmd); useTarget = null; Toast.Success("عملیات اعتبار ثبت شد."); await Load(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { saving = false; }
    }
}
