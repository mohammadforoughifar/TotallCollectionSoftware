@namespace Inventory.Client.Pages

<span class="repair-status-control">
    @if (Editable)
    {
        <button type="button" id="@AnchorId"
                class="badge repair-status-badge repair-status-button @RepairStatusAppearance.BadgeCss(Status)"
                title="تغییر وضعیت" aria-label="@($"وضعیت پذیرش {Number}: {RepairStatusAppearance.Text(Status)}؛ تغییر وضعیت")"
                aria-haspopup="menu" aria-expanded="@(Open ? "true" : "false")" aria-controls="@(Open ? MenuId : null)"
                aria-busy="@(Busy ? "true" : "false")" disabled="@Disabled" @onclick="OnClick">
            <span class="repair-status-content">
                @if (Status is RepairStatus.Ready or RepairStatus.Delivered)
                {
                    <i class="bi @RepairStatusAppearance.Icon(Status)" aria-hidden="true"></i>
                }
                <span>@RepairStatusAppearance.Text(Status)</span>
            </span>
            @if (Busy) { <span class="spinner-border spinner-border-sm repair-status-spinner" aria-hidden="true"></span> }
            else { <i class="bi bi-chevron-down repair-status-chevron" aria-hidden="true"></i> }
        </button>
    }
    else
    {
        <span class="badge repair-status-badge @RepairStatusAppearance.BadgeCss(Status)">
            <span class="repair-status-content">
                @if (Status is RepairStatus.Ready or RepairStatus.Delivered)
                {
                    <i class="bi @RepairStatusAppearance.Icon(Status)" aria-hidden="true"></i>
                }
                <span>@RepairStatusAppearance.Text(Status)</span>
            </span>
        </span>
    }
</span>

@code {
    [Parameter] public RepairStatus Status { get; set; }
    [Parameter] public string Number { get; set; } = "";
    [Parameter] public bool Editable { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool Open { get; set; }
    [Parameter] public string? AnchorId { get; set; }
    [Parameter] public string? MenuId { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }
}
