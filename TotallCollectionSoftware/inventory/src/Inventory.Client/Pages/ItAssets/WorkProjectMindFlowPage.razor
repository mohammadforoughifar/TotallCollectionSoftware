@page "/work-projects/mindflow"
@page "/mindflows"
@using Inventory.Client.Components.WorkProjects
@inject HttpClient Http
@inject IAuthState Auth
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>نگار ذهنی</PageTitle>

<div class="mf-page" dir="rtl">
    @if (!Auth.Has("MindFlow.View") && !Auth.Has("WorkProjects.MindFlow"))
    {
        <div class="alert alert-warning">
            <i class="bi bi-shield-lock"></i>
            به «نگار ذهنی» دسترسی ندارید. مدیر سامانه می‌تواند از
            «تنظیمات ← نقش‌ها ← دستور کار، پروژه‌ها و نگار ذهنی» مجوز «نگار ذهنی» (ماژول نگار ذهنی)
            یا مجوز «بخش نگار ذهنی پروژه» را بدهد.
        </div>
    }
    <div class="mf-page-head">
        <div>
            <div class="mf-eyebrow">دستور کار</div>
            <h1><i class="bi bi-diagram-3"></i> نگار ذهنی</h1>
            <p>نگاشت پروژه‌ها را ببین یا یک نگاشت مستقل بساز و طراحی کن.</p>
        </div>
        <div class="mf-head-actions">
            @if (Auth.Has("MindFlow.Create"))
            {
                <button type="button" class="btn btn-primary btn-sm" @onclick="ToggleStandaloneCreate"><i class="bi bi-plus-lg"></i> ساخت نگاشت مستقل</button>
            }
            @if (Auth.CanSee("WorkProjects"))
            {
                <a class="btn btn-outline-secondary btn-sm" href="/work-projects"><i class="bi bi-briefcase"></i> فهرست پروژه‌ها</a>
            }
        </div>
    </div>

    <section class="mf-standalone-section">
        <div class="mf-standalone-heading">
            <div><strong><i class="bi bi-diagram-3"></i> نگاشت‌های مستقل</strong><span>@_standaloneMaps.Count</span></div>
            <small>این نگاشت‌ها به پروژهٔ کاری متصل نیستند.</small>
        </div>
        @if (_showStandaloneCreate)
        {
            <div class="mf-standalone-create">
                <label for="new-standalone-mindflow" class="form-label mb-1">نام نگاشت مستقل</label>
                <div class="mf-standalone-create-row">
                    <input id="new-standalone-mindflow" class="form-control" maxlength="200" placeholder="مثلاً: برنامهٔ یادگیری زبان" @bind="_newStandaloneTitle" @bind:event="oninput" @onkeydown="OnStandaloneTitleKeyDown" />
                    <button type="button" class="btn btn-primary" @onclick="CreateStandaloneAsync" disabled="@(_creatingStandalone || string.IsNullOrWhiteSpace(_newStandaloneTitle))">
                        @if (_creatingStandalone) { <span class="spinner-border spinner-border-sm me-1"></span> }
                        ساخت و طراحی
                    </button>
                </div>
                <small>بعداً می‌توانی افراد را با نقش مشاهده‌گر یا ویرایشگر دعوت کنی.</small>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(_standaloneError))
        {
            <div class="alert alert-warning py-2 mt-2 mb-0">@_standaloneError</div>
        }
        @if (_loadingStandaloneMaps)
        {
            <div class="mf-standalone-empty"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری نگاشت‌های مستقل…</div>
        }
        else if (_standaloneMaps.Count == 0)
        {
            <div class="mf-standalone-empty">هنوز نگاشت مستقلی ساخته یا با شما به‌اشتراک گذاشته نشده است.</div>
        }
        else
        {
            <div class="mf-standalone-list">
                @foreach (var map in _standaloneMaps)
                {
                    <article class="mf-standalone-item" @key="map.Id">
                        <div><strong>@map.Title</strong><small>سازنده: @map.OwnerName · نقش شما: @StandaloneRoleText(map.Role)</small></div>
                        <div class="mf-standalone-actions">
                            <a class="btn btn-sm @(map.CanEdit ? "btn-outline-primary" : "btn-outline-secondary")" href="@($"/mindflows/{map.Id}")"><i class="bi @(map.CanEdit ? "bi-pencil-square" : "bi-eye")"></i> @(map.CanEdit ? "طراحی" : "مشاهده")</a>
                            @if (map.IsOwner)
                            {
                                @if (Auth.Has("MindFlow.Delete"))
                                {
                                    <button type="button" class="btn btn-sm btn-outline-danger" title="حذف نگاشت" @onclick="() => DeleteStandaloneAsync(map)"><i class="bi bi-trash"></i></button>
                                }
                            }
                        </div>
                    </article>
                }
            </div>
        }
    </section>

    <div class="mf-project-picker">
        <label for="mindflow-project-select">انتخاب نگاشت پروژه</label>
        <div class="mf-project-combo">
            <input id="mindflow-project-select" class="form-control" role="combobox" aria-expanded="@_showProjectOptions" aria-controls="mindflow-project-options"
                   placeholder="جست‌وجو و انتخاب نگاشت پروژه…" value="@_projectInputText"
                   @oninput="OnProjectSearchInput" @onfocus="ShowProjectOptions" disabled="@_loadingProjects" />
            @if (_loadingProjects) { <span class="spinner-border spinner-border-sm text-primary mf-project-spinner" aria-label="در حال بارگذاری"></span> }
            @if (_showProjectOptions && !_loadingProjects)
            {
                <div id="mindflow-project-options" class="mf-project-options" role="listbox">
                    <button type="button" class="mf-project-option clear" @onclick="() => SelectProject(null)">پاک‌کردن انتخاب</button>
                    @foreach (var item in FilteredProjects)
                    {
                        <button type="button" class="mf-project-option" @key="item.ProjectId" @onclick="() => SelectProject(item.ProjectId)">
                            <strong>@item.Number — @item.Title</strong>
                            <small>@(item.Status == "Closed" ? "بسته · فقط‌خواندنی" : "باز")</small>
                        </button>
                    }
                    @if (FilteredProjects.Count == 0)
                    {
                        <div class="mf-project-option-empty">نگاشتی با این عبارت پیدا نشد.</div>
                    }
                </div>
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-warning py-2 mt-2 mb-0">@_error</div>
        }
        @if (!_loadingProjects && _projects.Count == 0 && string.IsNullOrWhiteSpace(_error))
        {
            <div class="alert alert-light border mt-2 mb-0">هنوز به نگاشت هیچ پروژه‌ای دسترسی نداری. از مدیر پروژه بخواه تو را عضو پروژه کند یا به خود نگاشت اضافه کند.</div>
        }
    </div>

    @if (_project is not null)
    {
        <div class="mf-selected-project">
            <div>
                <span class="mf-project-number">@_project.Number</span>
                <strong>@_project.Title</strong>
                <span class="badge @(_project.Status == "Closed" ? "text-bg-secondary" : "text-bg-success")">@(_project.Status == "Closed" ? "بسته · فقط‌خواندنی" : "باز")</span>
                <span class="badge @(_project.CanManage && _project.Status == "Open" ? "text-bg-primary" : "text-bg-light text-dark")">@(_project.CanManage && _project.Status == "Open" ? "دسترسی طراحی" : "فقط‌خواندنی")</span>
            </div>
            @if (_project.CanManage && Auth.CanSee("WorkProjects"))
            {
                <a class="btn btn-sm btn-outline-secondary" href="@($"/work-projects?open={_project.ProjectId}")"><i class="bi bi-box-arrow-up-right"></i> جزئیات پروژه</a>
            }
        </div>
        <WorkProjectMindFlow ProjectId="@_project.ProjectId" ProjectTitle="@_project.Title" CanEdit="@(_project.CanManage && _project.Status == "Open")" CanManageAccess="@(_project.CanManage && _project.Status == "Open")" SelectedNodeId="@NodeId" SubFlowPath="@SubFlowPath" />
    }
    else if (_loadingProjects)
    {
        <div class="mf-placeholder"><span class="spinner-border spinner-border-sm"></span> در حال بارگذاری نگاشت‌ها…</div>
    }
    else
    {
        <div class="mf-placeholder"><i class="bi bi-arrow-up-circle"></i> برای نمایش نقشه، یکی از پروژه‌های در دسترس را انتخاب کن.</div>
    }
</div>

