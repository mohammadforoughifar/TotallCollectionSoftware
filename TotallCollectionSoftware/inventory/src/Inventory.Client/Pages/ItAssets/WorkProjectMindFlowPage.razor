@code {
    [SupplyParameterFromQuery(Name = "projectId")]
    public int? ProjectId { get; set; }

    [SupplyParameterFromQuery(Name = "nodeId")]
    public Guid? NodeId { get; set; }

    [SupplyParameterFromQuery(Name = "subFlowPath")]
    public string? SubFlowPath { get; set; }

    private List<WorkProjectMindFlowAccessibleProjectDto> _projects = new();
    private WorkProjectMindFlowAccessibleProjectDto? _project;
    private string _query = "", _projectInputText = "", _error = "";
    private bool _loadingProjects;
    private bool _projectsLoaded;
    private int? _lastQueryProjectId = -1;
    private bool _showProjectOptions;
    private List<StandaloneMindFlowSummaryDto> _standaloneMaps = new();
    private string _newStandaloneTitle = "", _standaloneError = "";
    private bool _loadingStandaloneMaps, _standaloneMapsLoaded, _showStandaloneCreate, _creatingStandalone;

    private List<WorkProjectMindFlowAccessibleProjectDto> FilteredProjects
    {
        get
        {
            return string.IsNullOrWhiteSpace(_query)
                ? _projects.ToList()
                : _projects.Where(p => p.Title.Contains(_query, StringComparison.OrdinalIgnoreCase)
                    || p.Number.Contains(_query, StringComparison.OrdinalIgnoreCase)).ToList();
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!_standaloneMapsLoaded) await LoadStandaloneMaps();
        if (!_projectsLoaded) await LoadProjects();
        if (!_projectsLoaded)
        {
            _project = null;
            _projectInputText = "";
            return;
        }

        if (ProjectId != _lastQueryProjectId || (ProjectId is > 0 && _project is null))
        {
            _lastQueryProjectId = ProjectId;
            if (ProjectId is > 0 && !_projects.Any(p => p.ProjectId == ProjectId.Value))
            {
                // A project may have been created, joined, or invited after the picker was first loaded.
                // Refresh before reporting an access denial so a stale client-side list cannot block a valid link.
                _projectsLoaded = false;
                await LoadProjects();
            }
            _project = ProjectId is > 0 ? _projects.FirstOrDefault(p => p.ProjectId == ProjectId.Value) : null;
            _query = ""; _showProjectOptions = false;
            _projectInputText = _project is null ? "" : $"{_project.Number} — {_project.Title}";
            if (!_projectsLoaded) { /* Keep the actual load error instead of replacing it with an access warning. */ }
            else if (ProjectId is > 0 && _project is null) _error = "این نگاشت پس از تازه‌سازی فهرست هم در دسترس نیست؛ عضویت/دعوت نگاشت و شرکت فعال را بررسی کن.";
            else _error = "";
        }
    }

    private void ToggleStandaloneCreate() => _showStandaloneCreate = !_showStandaloneCreate;

    private async Task LoadStandaloneMaps()
    {
        _loadingStandaloneMaps = true;
        _standaloneError = "";
        try
        {
            _standaloneMaps = await Http.GetFromJsonAsync<List<StandaloneMindFlowSummaryDto>>("api/mindflows") ?? new();
            _standaloneMapsLoaded = true;
        }
        catch (HttpRequestException) { _standaloneError = "فهرست نگاشت‌های مستقل بارگذاری نشد؛ اتصال یا شرکت فعال را بررسی کن."; }
        catch (System.Text.Json.JsonException) { _standaloneError = "پاسخ فهرست نگاشت‌های مستقل معتبر نیست."; }
        finally { _loadingStandaloneMaps = false; }
    }

    private async Task CreateStandaloneAsync()
    {
        var title = _newStandaloneTitle.Trim();
        if (title.Length == 0 || _creatingStandalone) return;
        _creatingStandalone = true;
        _standaloneError = "";
        try
        {
            var response = await Http.PostAsJsonAsync("api/mindflows", new CreateStandaloneMindFlowDto { Title = title });
            if (!response.IsSuccessStatusCode)
            {
                _standaloneError = await ReadStandaloneError(response);
                return;
            }
            var created = await response.Content.ReadFromJsonAsync<StandaloneMindFlowSummaryDto>();
            if (created is null) { _standaloneError = "پاسخ ساخت نگاشت معتبر نیست."; return; }
            _standaloneMaps.Insert(0, created);
            _newStandaloneTitle = "";
            _showStandaloneCreate = false;
            Nav.NavigateTo($"/mindflows/{created.Id}");
        }
        catch (HttpRequestException) { _standaloneError = "ساخت نگاشت انجام نشد؛ اتصال سرور را بررسی کن."; }
        catch (System.Text.Json.JsonException) { _standaloneError = "پاسخ ساخت نگاشت قابل خواندن نیست."; }
        finally { _creatingStandalone = false; }
    }

    private async Task DeleteStandaloneAsync(StandaloneMindFlowSummaryDto map)
    {
        if (!map.IsOwner || !await JS.InvokeAsync<bool>("confirm", $"نگاشت «{map.Title}» و زیرنگاشت‌هایش حذف شوند؟")) return;
        try
        {
            var response = await Http.DeleteAsync($"api/mindflows/{map.Id}");
            if (!response.IsSuccessStatusCode) { _standaloneError = await ReadStandaloneError(response); return; }
            _standaloneMaps.RemoveAll(m => m.Id == map.Id);
        }
        catch (HttpRequestException) { _standaloneError = "حذف نگاشت انجام نشد؛ اتصال سرور را بررسی کن."; }
    }

    private void OnStandaloneTitleKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") _ = CreateStandaloneAsync();
    }

    private static string StandaloneRoleText(string? role) => role switch
    {
        "Owner" => "سازنده",
        "Editor" => "ویرایشگر",
        _ => "مشاهده‌گر"
    };

    private static async Task<string> ReadStandaloneError(HttpResponseMessage response)
    {
        try
        {
            var data = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>();
            return data?.GetValueOrDefault("message") ?? $"عملیات ناموفق بود ({(int)response.StatusCode}).";
        }
        catch { return $"عملیات ناموفق بود ({(int)response.StatusCode})."; }
    }

    private async Task LoadProjects()
    {
        _loadingProjects = true; _error = ""; _projects = new();
        try
        {
            _projects = await Http.GetFromJsonAsync<List<WorkProjectMindFlowAccessibleProjectDto>>("/api/workprojects/mindflow/accessible") ?? new();
            _projectsLoaded = true;
        }
        catch (HttpRequestException) { _error = "نگاشت‌های در دسترس بارگذاری نشدند؛ اتصال سرور یا انتخاب شرکت فعال را بررسی کن."; }
        catch (System.Text.Json.JsonException) { _error = "پاسخ فهرست نگاشت‌ها معتبر نیست."; }
        finally { _loadingProjects = false; }
    }

    private void ShowProjectOptions()
    {
        _query = "";
        _projectInputText = "";
        _showProjectOptions = true;
    }

    private void OnProjectSearchInput(ChangeEventArgs e)
    {
        _query = e.Value?.ToString() ?? "";
        _projectInputText = _query;
        _showProjectOptions = true;
    }

    private void SelectProject(int? id)
    {
        _query = ""; _showProjectOptions = false;
        if (id is > 0)
        {
            var selected = _projects.FirstOrDefault(p => p.ProjectId == id.Value);
            _projectInputText = selected is null ? "" : $"{selected.Number} — {selected.Title}";
            Nav.NavigateTo($"/work-projects/mindflow?projectId={id.Value}");
        }
        else
        {
            _projectInputText = "";
            Nav.NavigateTo("/work-projects/mindflow");
        }
    }
}
