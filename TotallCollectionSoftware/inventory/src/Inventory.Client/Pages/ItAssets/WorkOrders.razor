    /// <summary>
    /// لینکِ «نامهٔ مبدأ» برای دستورکار.
    /// نوعِ نامه از <paramref name="sourceType"/> خوانده می‌شود که سرور آن را از
    /// جدولِ LetterSources (مرجعِ یکتای هر نامه) می‌گیرد؛ رشتهٔ
    /// <paramref name="module"/> فقط نقشِ پشتیبان دارد چون در داده‌های قدیمی ممکن
    /// است اشتباه یا خالی باشد. بدون این تفکیک، دستورکارِ ساخته‌شده از نامهٔ صادره
    /// ممکن بود به کارتابلِ نامهٔ داخلی باز شود (یا اصلاً باز نشود).
    /// </summary>
    private RenderFragment? SourceLink(string? module, int? sourceId, int? sourceRefId = null, int? sourceType = null)
    {
        if (string.IsNullOrWhiteSpace(module) || sourceId is not > 0) return null;
        if (module == "Document")
            return @<a class="wo-att" href="@($"/doc-archive/documents/{sourceId}")" target="_blank" title="رفتن به مدرک مبدأ در آرشیو">
                <i class="bi bi-file-earmark-text"></i> مدرک
            </a>;
        if (module == "MeetingMinutes" || module == "MeetingMinutesItem")
        {
            var targetId = module == "MeetingMinutes" ? sourceId : (sourceRefId ?? _sourceRefId ?? sourceId);
            return @<a class="wo-att" href="@($"/misc/minutes/{targetId}")" target="_blank" title="رفتن به صورتجلسه مبدأ">
                <i class="bi bi-journal-text"></i> صورتجلسه
            </a>;
        }
        // اولویت با نوعِ معتبرِ نامه (از سرور) و سپس با نامِ ماژولِ ذخیره‌شده
        var letterType = sourceType is >= 1 and <= 3 ? sourceType : LetterTypeFromModule(module);
        var letterRoute = letterType switch
        {
            2 => "/outgoing-letters",
            3 => "/incoming-letters",
            1 => "/letters",
            _ => "/letters"
        };
        var letterTitle = letterType switch
        {
            1 => "رفتن به نامهٔ داخلی مبدأ",
            2 => "رفتن به نامهٔ صادره مبدأ",
            3 => "رفتن به نامهٔ وارده مبدأ",
            _ => "رفتن به نامه مبدأ"
        };
        return @<a class="wo-att" href="@($"{letterRoute}?open={sourceId}")" target="_blank" title="@letterTitle">
            <i class="bi bi-envelope"></i> نامه
        </a>;
    }

    /// <summary>نگاشتِ نامِ ماژولِ ذخیره‌شده → نوعِ نامه (۱=داخلی، ۲=صادره، ۳=وارده)</summary>
    private static int? LetterTypeFromModule(string? module)
    {
        if (string.IsNullOrWhiteSpace(module)) return null;
        var m = module.Trim().ToLowerInvariant();
        if (m is "innerletter" or "innerletters") return 1;
        if (m is "outgoingletter" or "outgoingletters") return 2;
        if (m is "incomingletter" or "incomingletters") return 3;
        return null;
    }

