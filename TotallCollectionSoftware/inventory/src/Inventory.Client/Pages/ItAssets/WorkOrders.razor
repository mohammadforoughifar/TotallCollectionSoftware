    private void ShowSmsSummary(WorkOrderSmsResult sms)
    {
        var accepted = sms.Recipients.Count(r => r.State == "accepted");
        var failed = sms.Recipients.Count(r => r.State == "failed");
        var skipped = sms.Recipients.Count(r => r.State == "skipped");
        var unknown = sms.Recipients.Count(r => r.State == "unknown");
        var details = sms.Recipients
            .Where(r => r.State != "accepted")
            .Take(3)
            .Select(r => $"{r.Name}: {r.Message}")
            .ToList();
        var summary = $"SMS — پذیرفته‌شده: {accepted}، ناموفق: {failed}، بدون شمارهٔ معتبر: {skipped}، نامشخص: {unknown}.";
        if (details.Count > 0)
            summary += " " + string.Join("؛ ", details);
        var omitted = sms.Recipients.Count(r => r.State != "accepted") - details.Count;
        if (omitted > 0)
            summary += $"؛ و {omitted} نتیجهٔ دیگر.";

        if (failed == 0 && skipped == 0 && unknown == 0 && accepted > 0)
            Toast.Success($"درخواست ارسال پیامک برای {accepted} گیرنده توسط کاوه‌نگار پذیرفته شد.");
        else if (accepted > 0)
            Toast.Info(summary);
        else
            Toast.Error(summary);
    }

    private async Task SubmitNew()
    {
        // ⛔ ضدِ ثبت تکراری: کلیک دوم روی «ثبت دستور کار» نباید درخواست دوم بفرستد.
        // Blazor تا پایانِ اجرای هندلر رندر نمی‌کند، پس disabled شدن دکمه به‌تنهایی
        // جلوی کلیک دوم را نمی‌گیرد؛ این پرچم همان لحظه و پیش از هر await ست می‌شود.
        if (submitNewRunning) return;

        formError = "";
        if (string.IsNullOrWhiteSpace(newTitle)) { formError = "عنوان را وارد کنید."; return; }
        if (selTargets.Count == 0) { formError = "حداقل یک نفر را انتخاب کنید."; return; }
        if (newDueDate == null) { formError = "تاریخ مقرر را انتخاب کنید."; return; }
        // بند ۱: تاریخ/ساعت مقرر نباید قبل از الان باشد
        var dueCheck = newDueDate.Value.Date.Add(newDueTime.ToTimeSpan());
        if (dueCheck <= DateTime.Now)
        { formError = "تاریخ و ساعت مقرر نمی‌تواند قبل از زمان ثبت باشد."; return; }
        if (newProjectId > 0 && (newWeight < 0 || newWeight > 10))
        { formError = "وزن دستور باید بین ۰ تا ۱۰ باشد."; return; }

        submitNewRunning = true;
        busy = true;
        try
        {
            string desc = rte != null ? await rte.GetHtmlAsync() : "";
            var due = newDueDate.Value.Date.Add(newDueTime.ToTimeSpan());

            var payload = new
            {
                title = newTitle, description = desc, dueAt = due,
                assigneeUserIds = selTargets.ToList(),
                priority = newPriority,
                recurrence = newRecurrence,
                checklistItems = newChecklist,
                tags = newTags,
                sourceModule = _sourceModule, sourceId = _sourceId, sourceRefId = _sourceRefId,
                parentOrderId = chainParent?.Id,
                projectId = newProjectId > 0 ? (int?)newProjectId : null,
                weight = newWeight,
                sendSms = sendSms && editingId <= 0,
                clientRequestId = editingId > 0 ? null : newRequestId
            };
            var resp = editingId > 0
                ? await Http.PutAsJsonAsync($"/api/workorders/{editingId}", payload)
                : await Http.PostAsJsonAsync("/api/workorders", payload);
            if (!resp.IsSuccessStatusCode)
            {
                formError = await resp.Content.ReadAsStringAsync();
                return;
            }
            var created = await resp.Content.ReadFromJsonAsync<CreatedRes>();
            // سرور هم همین درخواست را تازه ثبت کرده بود (کلیک/ارسال تکراری) و
            // به‌جای ساختن دستور کار دوم، همان دستور کار قبلی را برگردانده است.
            if (created?.Duplicate == true)
            {
                Toast.Info($"این دستور کار همین لحظه ثبت شده بود ({created.Number})؛ ثبت تکراری انجام نشد.");
            }
            if (editingId <= 0 && created != null && !created.Duplicate)
            {
                foreach (var f in newFiles)
                    await UploadFile(created.Id, f);
                if (created.Sms != null)
                    ShowSmsSummary(created.Sms);
            }

            if (created?.Duplicate != true)
                Toast.Success(editingId > 0 ? "تغییرات ذخیره شد." : "دستور کار ثبت شد.");
            // کلید بعدی — ثبت بعدی (عمدی) نباید تکراری شمرده شود
            newRequestId = Guid.NewGuid().ToString("N");
            editingId = 0;
            editingSeries = false;
            showNew = false;
            chainParent = null;
            await LoadAll();
            // پاک‌سازی پارامترهای مبدأ (سورس) بعد از ثبت
            if (!string.IsNullOrWhiteSpace(_sourceModule))
            {
                _sourceModule = null; _sourceId = null; _sourceRefId = null; _sourceLabel = ""; _sourceDocTitle = "";
                Nav.NavigateTo("/work-orders");
            }
            if (projectPrefilled)
            {
                projectPrefilled = false;
                newProjectId = 0;
                Nav.NavigateTo("/work-orders");
            }
        }
        catch (Exception ex) { formError = ex.Message; }
        finally { busy = false; submitNewRunning = false; }
    }

    private async Task UploadFile(int id, Microsoft.AspNetCore.Components.Forms.IBrowserFile f)
    {
        // پیوست دستور کار: wwwroot/uploads/WorkOrders/{id}/
        try
        {
            using var content = new MultipartFormDataContent();
            var sc = new StreamContent(f.OpenReadStream(long.MaxValue));
            sc.Headers.ContentType = new MediaTypeHeaderValue(string.IsNullOrWhiteSpace(f.ContentType) ? "application/octet-stream" : f.ContentType);
            content.Add(sc, "file", f.Name);
            await Http.PostAsync($"/api/workorders/{id}/attachments", content);
        }
        catch (Exception ex) { Toast.Error($"بارگذاری {f.Name} ناموفق: {ex.Message}"); }
    }

