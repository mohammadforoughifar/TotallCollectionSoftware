    private async Task LoadStats()
    {
        if (statsLoading) return;
        statsLoading = true; statsError = null;
        try
        {
            var resp = await Http.GetAsync("/api/workorders/stats");
            if (!resp.IsSuccessStatusCode)
            {
                // پیام واقعی سرور (مثلاً «شرکت فعال انتخاب نشده است») به‌جای صفحهٔ خالی نمایش داده می‌شود.
                stats = null;
                statsError = await ReadApiErrorAsync(resp);
            }
            else
            {
                stats = await resp.Content.ReadFromJsonAsync<StatsDto>();
                if (stats is null) statsError = "پاسخی از سرور دریافت نشد.";
            }
        }
        catch (Exception ex)
        {
            stats = null;
            statsError = "بارگذاری آمار ناموفق بود: " + ex.Message;
        }
        finally { statsLoading = false; lastStatsAt = DateTime.Now; }
        StateHasChanged();
