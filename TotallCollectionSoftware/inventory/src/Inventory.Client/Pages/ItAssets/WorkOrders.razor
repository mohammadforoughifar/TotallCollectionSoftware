    /// <summary>
    /// وضعیت یک گیرنده برای رنگ‌آمیزی: <c>bad</c>=انجام‌نشده، <c>done</c>=انجام‌شده/پاسخ داده،
    /// <c>seen</c>=دیده ولی بی‌پاسخ، <c>new</c>=نخوانده.
    /// </summary>
    private static string AsgState(AsgItem a) =>
        a.Done == false ? "bad"
        : a.Done == true ? "done"
        : a.RepliedAt != null ? "done"
        : a.SeenAt != null ? "seen"
        : "new";

    private static string AsgStateFa(AsgItem a) => AsgState(a) switch
    {
        "bad" => "انجام نشد",
        "done" => "انجام شد",
        "seen" => "دیده، بی‌پاسخ",
        _ => "نخوانده"
    };

    /// <summary>حروف اول نام برای آواتار (مثلاً «مریم احمدی» ⇒ «م ا»).</summary>
    private static string Initials(string? name)
    {
        var parts = (name ?? "").Split(' ', StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length == 0) return "؟";
        if (parts.Length == 1) return parts[0].Length >= 2 ? parts[0][..2] : parts[0];
        return $"{parts[0][0]} {parts[^1][0]}";
    }

    /// <summary>رنگ ثابتِ هر کاربر (بر اساس شناسه) تا در همهٔ ردیف‌ها یک نفر یک رنگ باشد.</summary>
    private static string AvClass(int userId) => "c" + ((userId <= 0 ? 0 : (userId - 1) % 8) + 1);

    private static int RepliedCount(WoItem w) => w.Assignees.Count(a => a.RepliedAt != null);
    private static int DoneCount(WoItem w) => w.Assignees.Count(a => AsgState(a) == "done");
    private static int FailCount(WoItem w) => w.Assignees.Count(a => AsgState(a) == "bad");
    private static int PendingCount(WoItem w) => w.Assignees.Count(a => a.RepliedAt == null);

    private static int Pct(int part, int total) => total <= 0 ? 0 : Math.Clamp(part * 100 / total, 0, 100);
    private static int DonePct(WoItem w) => Pct(DoneCount(w), w.Assignees.Count);
    private static string WhoBarTitle(WoItem w) =>
        $"{DoneCount(w)} انجام‌شده · {FailCount(w)} انجام‌نشده · {PendingCount(w)} در انتظار";
    private static int FailPct(WoItem w) => Pct(FailCount(w), w.Assignees.Count);

    /// <summary>
    /// ترتیب داخل پنل: اول موارد نیازمند پیگیری (انجام‌نشده → دیده بی‌پاسخ → نخوانده) و
    /// آخر انجام‌شده‌ها؛ در هر گروه به ترتیب نام. با ۸ گیرنده، نفر مهم همیشه بالا است.
    /// </summary>
    private static IEnumerable<AsgItem> WhoSorted(WoItem w) => w.Assignees
        .OrderBy(a => AsgState(a) switch { "bad" => 0, "seen" => 1, "new" => 2, _ => 3 })
        .ThenBy(a => a.Name, StringComparer.CurrentCulture);

