    // ================== ستون «تصمیم دستوردهنده» ==================
    // تصمیم دستوردهنده روی «پاسخ هر گیرنده» ثبت می‌شود (WorkOrderAssignee.OwnerDecision:
    // Approved / Rejected / خالی)؛ در لیست، خلاصهٔ آن برای همهٔ گیرندگان یک دستور نشان
    // داده می‌شود تا بدون باز کردن جزئیات مشخص باشد کدام دستور تایید، کدام رد و کدام
    // هنوز بی‌تصمیم است.

    /// <summary>خلاصهٔ تصمیم دستوردهنده برای یک دستور کار.</summary>
    private (int Total, int Approved, int Rejected, int AwaitingDecision, int NoReply,
        bool HasAnyDecision, string ApprovedNames, string RejectedNames, string AwaitingNames) DecisionSummary(WoItem w)
    {
        var list = w.Assignees ?? new List<AsgItem>();
        var approved = list.Where(a => a.OwnerDecision == "Approved").ToList();
        var rejected = list.Where(a => a.OwnerDecision == "Rejected").ToList();
        var awaiting = list.Where(a => a.RepliedAt != null
                                       && a.OwnerDecision != "Approved"
                                       && a.OwnerDecision != "Rejected").ToList();
        var noReply = list.Count - approved.Count - rejected.Count - awaiting.Count;

        static string Names(IEnumerable<AsgItem> items) => string.Join("، ", items.Select(a =>
            string.IsNullOrWhiteSpace(a.OwnerDecisionNote) ? a.Name : $"{a.Name} ({a.OwnerDecisionNote})"));

        return (list.Count, approved.Count, rejected.Count, awaiting.Count, noReply,
            approved.Count + rejected.Count > 0, Names(approved), Names(rejected), Names(awaiting));
    }

    /// <summary>
    /// سلول ستون «تصمیم دستوردهنده» — نشان‌های فشرده با tooltip نام افراد و یادداشت تصمیم.
    /// به‌صورت رشتهٔ HTML ساخته می‌شود تا در هر دو نمای فهرست و کارت موبایل یکسان باشد.
    /// </summary>
    private MarkupString DecisionCell(WoItem w)
    {
        var d = DecisionSummary(w);
        static string Enc(string? value) => System.Net.WebUtility.HtmlEncode(value ?? "");

        if (d.Total == 0)
            return new MarkupString("<span class=\"text-muted fs-8\">—</span>");

        if (!d.HasAnyDecision && d.AwaitingDecision == 0)
        {
            var noReplyTitle = Enc(d.NoReply.ToString() + " گیرنده هنوز پاسخی نداده‌اند؛ تصمیمی برای ثبت نیست");
            return new MarkupString("<span class=\"badge bg-light text-dark border fs-9\" title=\"" + noReplyTitle + "\">در انتظار پاسخ</span>");
        }

        // ساخت با الحاق رشته (نه درج داخل رشته) تا کاراکترهایی مثل «:» و «"» مفسر قالب نشوند.
        var sb = new System.Text.StringBuilder();
        sb.Append("<span class=\"d-inline-flex flex-wrap gap-1\">");
        if (d.Approved > 0)
        {
            var title = Enc("تأییدشده: " + d.ApprovedNames);
            sb.Append("<span class=\"badge bg-primary-subtle text-primary border fs-9 num\" title=\"").Append(title).Append("\">✔ ")
              .Append(d.Approved.FaDigits()).Append(" تأیید</span>");
        }
        if (d.Rejected > 0)
        {
            var title = Enc("ردشده: " + d.RejectedNames);
            sb.Append("<span class=\"badge bg-danger-subtle text-danger border fs-9 num\" title=\"").Append(title).Append("\">✖ ")
              .Append(d.Rejected.FaDigits()).Append(" رد</span>");
        }
        if (d.AwaitingDecision > 0)
        {
            var title = Enc("در انتظار تصمیم دستوردهنده: " + d.AwaitingNames);
            sb.Append("<span class=\"badge bg-warning-subtle text-warning border fs-9 num\" title=\"").Append(title).Append("\">… ")
              .Append(d.AwaitingDecision.FaDigits()).Append(" بی‌تصمیم</span>");
        }
        sb.Append("</span>");
        return new MarkupString(sb.ToString());
    }

