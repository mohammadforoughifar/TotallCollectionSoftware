    /// <summary>طرف‌های ممکن گفتگو: اگر دستوردهنده‌ام → گیرندگان؛ اگر گیرنده‌ام → دستوردهنده.</summary>
    private List<(int Id, string Name)> ChatTargets(WoItem? w)
    {
        if (w == null) return new();
        var result = new List<(int, string)>();
        if (w.OwnerUserId == access.UserId)
            result.AddRange(w.Assignees.Where(a => a.UserId != access.UserId)
                .Select(a => (a.UserId, a.Name)).Distinct());
        else
            result.Add((w.OwnerUserId, w.OwnerName));
        return result;
    }

