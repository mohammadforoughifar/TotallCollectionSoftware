    private async Task SubmitReopen()
    {
        if (detail == null) return;
        DateTime? due = reopenDate?.Date.Add(reopenTime.ToTimeSpan());
        if (due != null && due <= DateTime.Now) { Toast.Error("مهلت جدید باید بعد از زمان فعلی باشد."); return; }
        if (!await JS.InvokeAsync<bool>("confirm", $"دستور کار «{detail.Title}» بازگشایی و به گردش برگردد؟")) return;
        busy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{detail.Id}/reopen",
                new { note = reopenNote, newDueAt = due, resetReplies = reopenReset });
            if (resp.IsSuccessStatusCode)
            {
                Toast.Success("دستور کار بازگشایی شد و به گردش برگشت. 🔓");
                var id = detail.Id;
                reopenNote = ""; reopenDate = null; reopenReset = true;
                detail = null; await LoadAll(); await OpenById(id);
            }
            else Toast.Error(await resp.Content.ReadAsStringAsync());
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

