    /// <summary>بازهایی که هنوز از مهلت نگذشته‌اند (بدون همپوشانی با «گذشته از مهلت»).</summary>
    private int OpenOnly
        => stats is null ? 0 : Math.Max(0, stats.Cards.Open - stats.Cards.Overdue);

    private int OverdueCount => stats?.Cards.Overdue ?? 0;

    /// <summary>دستورهای بسته‌شده = انجام به‌موقع + انجام با تاخیر + بستهٔ بی‌نتیجه.</summary>
    private int ClosedTotal
        => stats is null ? 0 : stats.Cards.DoneOnTime + stats.Cards.DoneLate + stats.Cards.ClosedNoDone;

    /// <summary>گرادیان مخروطی دونات وضعیت — ترتیب: باز، معوق، به‌موقع، با تاخیر، بی‌نتیجه.</summary>
    private string StatusDonutStyle()
    {
        if (stats is null) return "";
        var s = stats.ByStatus;
        var openOnly = Math.Max(0, s.Open - s.OverdueOpen);
        var parts = new (int Value, string Color)[]
        {
            (openOnly, "#3b82f6"),
            (s.OverdueOpen, "#ef4444"),
            (s.OnTime, "#22c55e"),
            (s.LateDone, "#a855f7"),
            (s.ClosedNoDone, "#94a3b8")
        };
        var total = parts.Sum(p => p.Value);
        if (total <= 0) return "background:#e2e8f0";
        var sb = new System.Text.StringBuilder("background:conic-gradient(");
        double acc = 0;
        for (var i = 0; i < parts.Length; i++)
        {
            var from = acc;
            acc += parts[i].Value * 100.0 / total;
            sb.Append(FormattableString.Invariant($"{parts[i].Color} {from:0.##}% {acc:0.##}%"));
            if (i < parts.Length - 1) sb.Append(',');
        }
        sb.Append(')');
        return sb.ToString();
    }

