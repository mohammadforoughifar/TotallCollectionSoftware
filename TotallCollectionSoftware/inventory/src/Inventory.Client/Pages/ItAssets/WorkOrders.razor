    private List<WoItem> TabItems => tab switch { "assigned" => assignedItems, "archive" => archiveItems, _ => mineItems };

    // ---- فیلتر و جستجو — همه سمت سرور (کوئری‌استرینگ API) و روی *همهٔ* دستورها، نه صفحهٔ جاری ----
    private string fltQ = "";
    private int fltPriority = -1; // -1 = همه
    // فیلتر تصمیم دستوردهنده: null=همه | approved | rejected | undecided | awaiting
    private string? fltDecision;
    // توجه: فیلترها «فقط سمت سرور» اعمال می‌شوند (همان کوئری‌استرینگی که به API می‌رود).
    // قبلاً همین فیلترها دوباره روی «صفحهٔ جاری» هم اجرا می‌شد؛ نتیجه این بود که با
    // ۱۰ ردیف در صفحه، فیلترهایی مثل «در انتظار پاسخ» خالی به‌نظر می‌رسیدند و شمارنده/
    // صفحه‌بندی هم با نتیجه نمی‌خواند. حالا فهرست دقیقاً همان چیزی است که سرور برگردانده.
    private List<WoItem> FilteredItems => TabItems;
    private int CurrentTotal => tab switch { "assigned" => assignedTotal, "archive" => archiveTotal, _ => mineTotal };
    private int TotalPages => Math.Max(1, (int)Math.Ceiling(CurrentTotal / (double)PageSize));
    private IEnumerable<WoItem> PagedItems => FilteredItems;

    /// <summary>حداکثر ۷ شمارهٔ صفحه حول صفحهٔ جاری (به‌جای ردیف بی‌پایان دکمه‌ها).</summary>
    private IEnumerable<int> PageWindow
    {
        get
        {
            const int win = 7;
            var start = Math.Max(1, page - win / 2);
            var end = Math.Min(TotalPages, start + win - 1);
            start = Math.Max(1, end - win + 1);
            for (var i = start; i <= end; i++) yield return i;
        }
    }
    private int RangeStart => CurrentTotal == 0 ? 0 : ((page - 1) * PageSize) + 1;
    private int RangeEnd => Math.Min(page * PageSize, CurrentTotal);

    private bool HasActiveFilter => !string.IsNullOrWhiteSpace(fltQ) || fltPriority >= 0
        || fltTag != null || fltProject > 0 || !string.IsNullOrEmpty(fltDecision);

    // ==================== بارگذاری فیلترها (ضدلرزش + لغو + نسخه) ====================
    // پیش‌تر هر کلید در کادر جستجو، هر سه تب + شمارنده‌ها را بدون تأخیر و بدون لغو
    // دوباره می‌خواند: چهار درخواست به‌ازای هر حرف، و اگر پاسخِ حرف قبلی دیر می‌رسید روی
    // نتیجهٔ حرف جدید می‌نشست ⇒ فهرست با متن کادر جستجو هم‌خوان نبود («اطلاعات اشتباه»).
    private CancellationTokenSource? filterCts;
    private int filterVersion;
    private bool filterBusy;

    /// <summary>زمان‌بندی بارگذاری با فیلترهای جاری — ۳۵۰ms تأخیر، لغو درخواست قبلی.</summary>
    private void ScheduleFilterLoad(bool immediate = false)
    {
        filterCts?.Cancel();
        var cts = new CancellationTokenSource();
        filterCts = cts;
        _ = FilterLoadAsync(immediate, cts);
    }

    private async Task FilterLoadAsync(bool immediate, CancellationTokenSource cts)
    {
        try { if (!immediate) await Task.Delay(350, cts.Token); }
        catch (OperationCanceledException) { return; }
        if (cts.IsCancellationRequested) return;

        var version = ++filterVersion;
        filterBusy = true;
        await InvokeAsync(StateHasChanged);
        try
        {
            await LoadPagesAsync(version, cts.Token);
        }
        finally
        {
            if (version == filterVersion)
            {
                filterBusy = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private void ClearAllFilters()
    {
        fltQ = ""; fltPriority = -1; fltTag = null; fltDecision = null; fltProject = 0; fltProjectName = "";
