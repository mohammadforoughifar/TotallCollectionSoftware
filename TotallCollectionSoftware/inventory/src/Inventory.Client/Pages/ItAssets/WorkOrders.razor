    // ---- قالب‌های آماده (موج ۷) ----
    private List<TplItem> myTemplates = new();  // فهرست قالب‌های کاربر — پرکاربردها بالا
    private bool tplSaveOpen, tplBusy;          // پنل ذخیرهٔ قالب باز است؟ / در حال ارسال
    private string tplName = "";                // نام قالب هنگام ذخیره
    private int appliedTplId;                   // قالبی که همین الان روی فرم اعمال شده (نمایش هایلایت)

    private sealed class TplItem
    {
        public int Id { get; set; }
        public string Name { get; set; } = "";
        public string Title { get; set; } = "";
        public string Description { get; set; } = "";
        public int Priority { get; set; }
        public int Recurrence { get; set; }
        public int UsageCount { get; set; }
        public List<int> AssigneeUserIds { get; set; } = new();
        public List<string> ChecklistItems { get; set; } = new();
        public List<string> Tags { get; set; } = new();
