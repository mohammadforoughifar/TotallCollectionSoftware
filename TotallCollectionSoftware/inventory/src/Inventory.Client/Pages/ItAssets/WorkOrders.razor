    .wo-flt-search > i.bi-search { position: absolute; right: .65rem; top: 50%; transform: translateY(-50%); color: #94a3b8; font-size: .85rem; pointer-events: none; }
    .wo-flt-search input { padding-right: 2rem; padding-left: 1.8rem; border-radius: 10px; }
    .wo-flt-clear { position: absolute; left: .35rem; top: 50%; transform: translateY(-50%); border: 0; background: none; color: #94a3b8; padding: .15rem .3rem; }
    .wo-flt-clear:hover { color: #ef4444; }

    /* ---------- دکمه‌های اولویت (فرم + فیلتر) ---------- */
    .wo-pr-group { display: inline-flex; gap: .35rem; flex-wrap: wrap; }
    .wo-pr-btn { border: 1px solid var(--border, #e2e8f0); background: #fff; border-radius: 999px; padding: .3rem .8rem; font-size: .8rem; color: #475569; transition: all .15s; }
    .wo-pr-btn:hover { border-color: #94a3b8; }
    .wo-pr-btn.active { background: #1e293b; border-color: #1e293b; color: #fff; font-weight: 700; }
    .wo-pr-btn.wo-pr-3.active { background: #dc2626; border-color: #dc2626; }
    .wo-pr-btn.wo-pr-2.active { background: #ea580c; border-color: #ea580c; }
    .wo-pr-btn.wo-pr-0.active { background: #64748b; border-color: #64748b; }

    /* ---------- نشان اولویت در لیست/جزئیات ---------- */
    .wo-prb-3 { background: #fef2f2; color: #dc2626; border: 1px solid #fecaca; }
    .wo-prb-2 { background: #fff7ed; color: #ea580c; border: 1px solid #fed7aa; }
    .wo-prb-0 { background: #f8fafc; color: #64748b; border: 1px solid #e2e8f0; }

    /* ---------- چک‌لیست زیرکار ---------- */
    .wo-cl-editor { border: 1px solid var(--border, #e2e8f0); border-radius: 10px; overflow: hidden; }
    .wo-cl-row { display: flex; align-items: center; gap: .5rem; padding: .35rem .6rem; border-bottom: 1px solid #f1f5f9; font-size: .85rem; }
    .wo-cl-row:last-child { border-bottom: 0; }
    .wo-cl-num { width: 22px; height: 22px; border-radius: 50%; background: #eef2ff; color: #4f46e5; display: inline-flex; align-items: center; justify-content: center; font-size: .7rem; font-weight: 700; flex-shrink: 0; }
    .wo-cl-item { display: flex; align-items: center; gap: .55rem; padding: .4rem .5rem; border-radius: 8px; font-size: .88rem; }
    .wo-cl-item.tickable { cursor: pointer; }
    .wo-cl-item.tickable:hover { background: #f8fafc; }
    .wo-cl-item.done > span.flex-grow-1 { text-decoration: line-through; color: #94a3b8; }
    .wo-cl-item i.bi { font-size: 1.05rem; color: #94a3b8; }

    /* ---------- داشبورد آماری ---------- */
    .wo-kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: .75rem; }
    .wo-kpi { background: #fff; border: 1px solid var(--border, #e2e8f0); border-radius: 14px; padding: .9rem 1rem; text-align: center; }
    .wo-kpi-num { font-size: 1.6rem; font-weight: 800; line-height: 1.2; }
    .wo-kpi-lbl { font-size: .75rem; color: #64748b; margin-top: .15rem; }
    .wo-kpi.k-open .wo-kpi-num { color: #2563eb; }
    .wo-kpi.k-late .wo-kpi-num { color: #ef4444; }
    .wo-kpi.k-today .wo-kpi-num { color: #f59e0b; }
    .wo-kpi.k-ontime .wo-kpi-num { color: #22c55e; }
    .wo-kpi.k-latedone .wo-kpi-num { color: #a855f7; }
    .wo-bar-track { height: 8px; background: #f1f5f9; border-radius: 999px; overflow: hidden; }
    .wo-bar { height: 100%; border-radius: 999px; background: #3b82f6; transition: width .3s; }
    .wo-bar-p3 { background: #dc2626; }
    .wo-bar-p2 { background: #ea580c; }
    .wo-bar-p1 { background: #3b82f6; }
    .wo-bar-p0 { background: #94a3b8; }
    .wo-chart { display: flex; gap: .5rem; align-items: stretch; height: 160px; }
    .wo-chart-col { flex: 1; display: flex; flex-direction: column; align-items: center; gap: .25rem; }
    .wo-chart-bars { flex: 1; width: 100%; display: flex; align-items: flex-end; justify-content: center; gap: 3px; }
    .wo-cb { width: 12px; border-radius: 4px 4px 0 0; min-height: 2px; }
    .wo-cb-created { background: #94a3b8; }
    .wo-cb-ontime { background: #22c55e; }
    .wo-cb-late { background: #a855f7; }
    .wo-cb-notdone { background: #ef4444; }
    .wo-empty { text-align: center; padding: 3.5rem 1rem; color: #94a3b8; }
    .wo-empty i { font-size: 3rem; display: block; margin-bottom: .5rem; }


    /* ================== داشبورد دستور کار — «گزارش مدیریتی» (wdr-*) ================== */
    .wdr-sheet { background:#fff; border:1px solid #e7e1d8; border-radius:8px; padding:1.5rem 1.7rem 1.2rem; box-shadow:0 1px 3px rgba(28,25,23,.05); color:#1c1917; }
    .wdr-alert { display:flex; align-items:center; gap:.6rem; background:#fdf8ec; border:1px solid #e6d9b8; color:#6b4e12; border-radius:8px; padding:.65rem .9rem; font-size:.82rem; }
    .wdr-alert-ic { width:20px; height:20px; border-radius:50%; background:#b45309; color:#fff; display:grid; place-items:center; font-size:.72rem; font-weight:800; flex:0 0 auto; }
    .wdr-loading { text-align:center; padding:3rem 1rem; }

    /* سرصفحه */
    .wdr-masthead { display:flex; align-items:flex-end; justify-content:space-between; gap:1rem; flex-wrap:wrap; border-bottom:2px solid #1c1917; padding-bottom:.7rem; }
    .wdr-kicker { font-size:.68rem; letter-spacing:.14em; color:#a89f92; font-weight:800; }
    .wdr-masthead h1 { font-size:1.32rem; font-weight:800; margin:.3rem 0 .2rem; letter-spacing:-.01em; }
    .wdr-scope { font-size:.73rem; color:#8a8378; }
    .wdr-meta { text-align:left; font-size:.71rem; color:#8a8378; display:flex; flex-direction:column; gap:.45rem; align-items:flex-end; }
    .wdr-btn { font:inherit; font-size:.74rem; font-weight:700; border:1px solid #ddd6cb; background:#fff; color:#3f3a34; border-radius:6px; padding:.34rem .8rem; display:inline-flex; align-items:center; gap:.35rem; }
    .wdr-btn:hover:not(:disabled) { border-color:#1c1917; color:#1c1917; }
    .wdr-btn:disabled { opacity:.6; }

    /* اعداد اصلی */
    .wdr-figures { display:grid; grid-template-columns:1.35fr repeat(4, 1fr); border-bottom:1px solid #e7e1d8; }
    .wdr-fig { padding:1.15rem .2rem 1rem 1rem; border-inline-start:1px solid #f0ebe4; }
    .wdr-fig:first-child { border-inline-start:0; padding-inline-start:0; }
    .wdr-fig-n { font-size:1.95rem; font-weight:800; letter-spacing:-.02em; line-height:1; color:#1c1917; }
    .wdr-fig-t { font-size:.72rem; color:#8a8378; margin-top:.45rem; font-weight:600; line-height:1.7; }
    .wdr-fig-t span { font-weight:400; }
    .wdr-fig-t b { font-weight:800; color:#3f3a34; }
    .wdr-fig-hero .wdr-fig-n { font-size:2.75rem; color:#7f1d1d; }
    .wdr-fig-u { font-size:1.05rem; font-weight:700; margin-inline-start:.1rem; opacity:.8; }

    /* بخش‌ها */
    .wdr-sec { display:flex; align-items:baseline; gap:.6rem; margin:1.7rem 0 .7rem; }
    .wdr-idx { font-size:.66rem; color:#a89f92; font-weight:800; letter-spacing:.1em; }
    .wdr-sec h2 { font-size:.88rem; margin:0; font-weight:800; }
    .wdr-rule { flex:1; height:1px; background:#eee9e1; }
    .wdr-sec-meta { font-size:.69rem; color:#a89f92; }

    /* فهرست کلید-مقدار */
    .wdr-two { display:grid; grid-template-columns:1fr 1fr; gap:2rem; align-items:start; }
    .wdr-kv-list { display:flex; flex-direction:column; }
    .wdr-kv { display:flex; align-items:center; gap:.55rem; font-size:.79rem; color:#3f3a34; padding:.42rem 0; border-bottom:1px solid #f3efe8; }
    .wdr-kv:last-of-type { border-bottom:0; }
    .wdr-kv-l { display:flex; align-items:center; gap:.45rem; flex:1; min-width:0; }
    .wdr-kv b { font-size:.86rem; font-weight:800; color:#1c1917; min-width:34px; text-align:left; }
    .wdr-kv-pct { font-size:.68rem; color:#a89f92; min-width:38px; text-align:left; }
    .wdr-sq { width:7px; height:7px; border-radius:1px; display:inline-block; flex:0 0 auto; }
    .wdr-hint { font-size:.65rem; color:#a89f92; }
    .wdr-mini-bar { height:5px; width:90px; background:#f3efe8; border-radius:2px; overflow:hidden; }
    .wdr-mini-bar > i { display:block; height:100%; background:#1c1917; }
    /* دکمه و پنل راهنما */
    .wdr-help { font:inherit; font-size:.7rem; font-weight:700; color:#6b625a; background:#fff; border:1px solid #ddd6cb; border-radius:999px; padding:.22rem .7rem; display:inline-flex; align-items:center; gap:.32rem; cursor:pointer; transition:all .15s; }
    .wdr-help:hover, .wdr-help.open { border-color:#1c1917; color:#1c1917; background:#faf8f5; }
    .wdr-help-q { width:14px; height:14px; border-radius:50%; background:#8a8378; color:#fff; font-size:.6rem; font-weight:800; display:grid; place-items:center; line-height:1; }
    .wdr-help.open .wdr-help-q { background:#1c1917; }
    .wdr-help-pop { background:#fbf9f6; border:1px solid #eee9e1; border-radius:8px; padding:.7rem .9rem .8rem; margin:-.2rem 0 .9rem; }
    .wdr-help-pop-h { display:flex; align-items:center; justify-content:space-between; gap:.6rem; border-bottom:1px solid #eee9e1; padding-bottom:.45rem; margin-bottom:.5rem; }
    .wdr-help-pop-h b { font-size:.76rem; color:#1c1917; }
    .wdr-help-x { border:0; background:none; color:#a89f92; font-size:1rem; line-height:1; padding:0 .15rem; cursor:pointer; }
    .wdr-help-x:hover { color:#7f1d1d; }
    .wdr-help-item { font-size:.71rem; color:#5b554d; line-height:1.9; padding:.2rem 0; }
    .wdr-help-item b { color:#1c1917; }
    .wdr-help-item + .wdr-help-item { border-top:1px dashed #eee9e1; margin-top:.25rem; padding-top:.4rem; }
    .wdr-empty { font-size:.78rem; color:#a89f92; padding:.6rem 0 1rem; }

    /* نمودار */
    .wdr-chart-wrap { padding-top:.2rem; }
    .wdr-chart-legend { display:flex; gap:1rem; flex-wrap:wrap; align-items:center; font-size:.68rem; color:#8a8378; margin-top:.35rem; }
    .wdr-chart-legend span { display:inline-flex; align-items:center; gap:.35rem; }
    .wdr-chart-cap { margin-inline-start:auto; color:#a89f92; }

    /* جدول */
    .wdr-table { width:100%; border-collapse:collapse; }
    .wdr-table thead th { font-size:.66rem; color:#8a8378; font-weight:700; text-align:right; padding:.45rem .5rem; border-bottom:1px solid #1c1917; white-space:nowrap; }
    .wdr-table thead th.c { text-align:center; }
    .wdr-table tbody td { font-size:.79rem; padding:.55rem .5rem; border-bottom:1px solid #f2eee8; color:#2b2723; }
    .wdr-table tbody tr:last-child td { border-bottom:0; }
    .wdr-table tbody td.c { text-align:center; }
    .wdr-who { display:flex; align-items:center; gap:.4rem; font-weight:700; }
    .wdr-rate { font-weight:800; }
    .wdr-u { font-size:.7rem; opacity:.7; margin-inline-start:.05rem; }

    @@media (max-width: 992px) {
        .wdr-figures { grid-template-columns:1fr 1fr; }
        .wdr-fig { border-inline-start:0; border-bottom:1px solid #f0ebe4; }
        .wdr-fig-hero { grid-column:1 / -1; border-bottom:1px solid #e7e1d8; }
        .wdr-two { grid-template-columns:1fr; gap:1rem; }
        .wdr-sheet { padding:1.1rem 1rem 1rem; }
        .wdr-chart-cap { margin-inline-start:0; }
    }

    /* ===== رنگ‌بندی مهلت (بند ۱۱ و ۱۲) ===== */
    .wo-row td:nth-child(2) { border-right: 4px solid transparent; }
    .wo-tone-late td:nth-child(2) { border-right-color: #ef4444; }      /* گذشته و انجام نشده — قرمز */
    .wo-tone-today td:nth-child(2) { border-right-color: #f59e0b; }     /* مهلت امروز — زرد */
    .wo-tone-ontime td:nth-child(2) { border-right-color: #22c55e; }    /* انجام به‌موقع — سبز */
    .wo-tone-latedone td:nth-child(2) { border-right-color: #a855f7; }  /* انجام با تاخیر — بنفش */
    .wo-tone-late { background: #fef2f2 !important; }
    .wo-tone-today { background: #fffbeb !important; }
    .wo-tone-ontime { background: #f0fdf4 !important; }
    .wo-tone-latedone { background: #faf5ff !important; }

    .wo-expander { width: 30px; height: 30px; border-radius: 8px; border: 1px solid #dbe3ee; background: #fff; color: #2563eb; cursor: pointer; font-size: .75rem; }
    .wo-expander:hover { background: #2563eb; color: #fff; }
    .wo-subrow > td { background: #f8fafc; }
    .wo-subtable { background: #fff; border-radius: 10px; overflow: hidden; }
    .wo-subtable th { font-size: .72rem; color: #64748b; }

    /* ===== کارت موبایل ===== */
    .wo-mcard { background: #fff; border: 1px solid #e8edf3; border-right-width: 5px; border-radius: 14px; padding: .8rem 1rem; display: flex; flex-direction: column; gap: .35rem; cursor: pointer; }
    .wo-mcard.wo-tone-late { border-right-color: #ef4444; }
    .wo-mcard.wo-tone-today { border-right-color: #f59e0b; }
    .wo-mcard.wo-tone-ontime { border-right-color: #22c55e; }
    .wo-mcard.wo-tone-latedone { border-right-color: #a855f7; }

    /* ===== مودال و بلاک‌ها ===== */
    .wo-modal { border: 0; border-radius: 18px; }
    .wo-info { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: .5rem; }
    .wo-info > div { background: #f8fafc; border-radius: 10px; padding: .5rem .75rem; display: flex; flex-direction: column; }
    .wo-lbl { font-size: .72rem; color: #94a3b8; }
    .wo-block { border: 1px solid #e8edf3; border-radius: 14px; overflow: hidden; }
    .wo-block-title { background: #f8fafc; padding: .5rem .85rem; font-size: .82rem; font-weight: 700; color: #334155; border-bottom: 1px solid #eef2f7; }
    .wo-block-title i { color: #2563eb; margin-left: .3rem; }
    .wo-block-body { padding: .75rem .85rem; font-size: .87rem; }
    .wo-att { display: inline-flex; align-items: center; gap: .35rem; background: #eef4ff; color: #2563eb; border-radius: 999px; padding: .2rem .7rem; font-size: .78rem; margin: 0 0 .3rem .3rem; text-decoration: none; }
    .wo-att:hover { background: #2563eb; color: #fff; }
    .wo-att .wo-att-sub { opacity: .72; font-weight: 400; max-width: 240px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wo-asg { border: 1px solid #eef2f7; border-radius: 12px; padding: .6rem .8rem; margin-bottom: .6rem; background: #fcfdfe; }
    .wo-reply { background: #f0fdf4; border: 1px solid #dcfce7; border-radius: 10px; padding: .45rem .7rem; font-size: .83rem; white-space: pre-line; }

    /* ===== تایم‌لاین ===== */
    .wo-timeline { padding: .75rem 1rem; }
    .wo-tl-item { display: flex; gap: .7rem; padding-bottom: .8rem; position: relative; }
    .wo-tl-item:not(:last-child)::before { content: ""; position: absolute; right: 5px; top: 16px; bottom: 0; width: 2px; background: #e2e8f0; }
    .wo-tl-dot { width: 12px; height: 12px; border-radius: 50%; margin-top: 4px; flex-shrink: 0; background: #94a3b8; }
    .wo-tl-created { background: #64748b; } .wo-tl-seen { background: #38bdf8; }
    .wo-tl-reply { background: #0ea5e9; } .wo-tl-approved { background: #22c55e; }
    .wo-tl-rejected { background: #ef4444; } .wo-tl-extended { background: #f59e0b; }
    .wo-tl-closed { background: #1e293b; }

    /* ================== تقویم شمسی — طراحی جدید ================== */
    .wo-cal-card {
        background: #fff; border: 1px solid #e8edf3; border-radius: 20px;
        overflow: hidden; box-shadow: 0 4px 20px rgba(15,23,42,.07);
    }
    .wo-cal-head2 {
        background: linear-gradient(135deg, #1e3a8a 0%, #2563eb 55%, #38bdf8 130%);
        padding: 1rem 1.2rem; display: flex; justify-content: space-between;
        align-items: center; flex-wrap: wrap; gap: .8rem;
    }
    .wo-cal-nav { display: flex; align-items: center; gap: .6rem; }
    .wo-nav-btn {
        width: 38px; height: 38px; border-radius: 12px; border: 1px solid rgba(255,255,255,.25);
        background: rgba(255,255,255,.12); color: #fff; cursor: pointer; transition: all .15s;
        display: flex; align-items: center; justify-content: center;
    }
    .wo-nav-btn:hover { background: rgba(255,255,255,.28); transform: scale(1.06); }
    .wo-cal-title2 { text-align: center; color: #fff; min-width: 110px; }
    .wo-cal-month { font-size: 1.25rem; font-weight: 800; line-height: 1.1; }
    .wo-cal-year { font-size: .78rem; opacity: .8; }
    .wo-today-btn {
        border: 0; background: #fff; color: #2563eb; font-weight: 700; font-size: .8rem;
        border-radius: 999px; padding: .4rem 1rem; cursor: pointer; box-shadow: 0 4px 12px rgba(0,0,0,.15);
        transition: transform .15s;
    }
    .wo-today-btn:hover { transform: translateY(-2px); }
    .wo-cal-legend2 { display: flex; gap: .9rem; font-size: .72rem; color: rgba(255,255,255,.9); flex-wrap: wrap; align-items: center; }
    .wo-leg-sep { width: 1px; height: 16px; background: rgba(255,255,255,.3); }
    .wo-dot { display: inline-block; width: 10px; height: 10px; border-radius: 50%; margin-left: .25rem; }
    .wo-donut { width: 136px; height: 136px; border-radius: 50%; display: grid; place-items: center; flex: 0 0 auto; box-shadow: 0 1px 2px rgba(15,23,42,.08); }
    .wo-donut-hole { width: 86px; height: 86px; background: #fff; border-radius: 50%; display: flex; flex-direction: column; align-items: center; justify-content: center; }
    .wo-donut-total { font-size: 1.35rem; font-weight: 800; line-height: 1; }
    .wo-donut-cap { font-size: .65rem; color: #64748b; margin-top: .1rem; }
    .wo-legend-row { display: flex; align-items: center; gap: .45rem; font-size: .8rem; color: #475569; padding: .18rem 0; }
    .wo-chart-col > .fs-9 { white-space: nowrap; }

    .wo-cal2 { display: grid; grid-template-columns: repeat(7, 1fr); gap: .45rem; padding: 1rem; background: #f8fafc; }
    .wo-dow2 {
        text-align: center; font-size: .74rem; font-weight: 800; color: #475569;
        background: #fff; border-radius: 10px; padding: .45rem 0; border: 1px solid #eef2f7;
    }
    .wo-dow2.friday { color: #dc2626; background: #fef2f2; border-color: #fecaca; }
    .wo-cell2 {
        background: #fff; border: 1px solid #e8edf3; border-radius: 14px; min-height: 104px;
        padding: .4rem; display: flex; flex-direction: column; gap: .25rem; overflow: hidden;
        transition: all .15s ease;
    }
    .wo-cell2:not(.empty):hover { border-color: #93c5fd; box-shadow: 0 6px 16px rgba(37,99,235,.12); transform: translateY(-2px); }
    .wo-cell2.empty { background: transparent; border-color: transparent; }
    .wo-cell2.friday { background: #fffafa; }
    .wo-cell2.today {
        border: 2px solid #2563eb;
        background: linear-gradient(180deg, #eff6ff 0%, #fff 55%);
        box-shadow: 0 0 0 4px rgba(37,99,235,.12);
    }
    .wo-cell2.has-items { border-bottom-width: 3px; }
    .wo-day2 { display: flex; align-items: center; justify-content: space-between; font-size: .78rem; font-weight: 800; color: #475569; }
    .wo-cell2.friday .wo-day2 { color: #dc2626; }
    .wo-cell2.today .wo-day2 { color: #2563eb; }
    .wo-today-tag { background: #2563eb; color: #fff; font-size: .56rem; border-radius: 999px; padding: .05rem .45rem; }

    .wo-chip2 {
        display: flex; align-items: center; gap: .3rem;
        font-size: .66rem; font-weight: 700; border-radius: 8px; padding: .18rem .4rem;
        color: #fff; cursor: pointer; transition: all .12s;
        box-shadow: 0 1px 3px rgba(15,23,42,.15);
    }
    .wo-chip2:hover { filter: brightness(1.1); transform: translateX(-2px); }
    .wo-chip2.closed { opacity: .55; }
    .wo-chip-txt { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
    .wo-st-ic {
        font-size: .8rem; flex-shrink: 0;
        background: #fff; border-radius: 50%; line-height: 1;
    }
    .wo-more { font-size: .62rem; color: #2563eb; font-weight: 800; cursor: pointer; background: #eff6ff; border-radius: 6px; padding: .1rem .35rem; text-align: center; transition: all .12s; }
    .wo-more:hover { background: #2563eb; color: #fff; }
    .wo-day-item { display: flex; align-items: center; gap: .6rem; padding: .6rem .8rem; border-radius: 12px; cursor: pointer; transition: background .12s; }
    .wo-day-item:hover { background: #f1f5f9; }
    .wo-day-item + .wo-day-item { border-top: 1px solid #f1f5f9; }
    .wo-day-kind { width: 6px; height: 30px; border-radius: 4px; flex-shrink: 0; }
    .wo-k-self { background: linear-gradient(135deg, #2563eb, #3b82f6); } i.wo-k-self { background: #2563eb; }
    .wo-k-others { background: linear-gradient(135deg, #f59e0b, #fbbf24); } i.wo-k-others { background: #f59e0b; }
    .wo-k-mixed { background: linear-gradient(135deg, #9333ea, #a855f7); } i.wo-k-mixed { background: #a855f7; }
    .wo-k-assigned { background: linear-gradient(135deg, #0d9488, #14b8a6); } i.wo-k-assigned { background: #0d9488; }

    /* ===== صفحه‌بندی ===== */
    .wo-pager { display: flex; gap: .4rem; justify-content: center; flex-wrap: wrap; }
    .wo-page-btn { border: 1px solid #e2e8f0; background: #fff; border-radius: 10px; min-width: 36px; height: 34px; padding: 0 .6rem; font-size: .82rem; font-weight: 600; color: #475569; cursor: pointer; }
    .wo-page-btn.active { background: #2563eb; border-color: #2563eb; color: #fff; }
    .wo-page-btn:disabled { opacity: .45; }

    /* ===== ادیتور و کمبو (مشترک) ===== */
    .rte-toolbar { display: flex; gap: .25rem; border: 1px solid #e2e8f0; border-bottom: 0; border-radius: 10px 10px 0 0; padding: .35rem .5rem; background: #f8fafc; }
    .rte-toolbar button { border: 0; background: transparent; border-radius: 8px; width: 32px; height: 30px; color: #475569; cursor: pointer; }
    .rte-toolbar button:hover { background: #e2e8f0; color: #2563eb; }
    .rte-editor { border: 1px solid #e2e8f0; border-radius: 0 0 10px 10px; min-height: 110px; padding: .6rem .8rem; font-size: .9rem; background: #fff; }
    /* تصاویر نامه که داخل شرح کپی می‌شوند نباید از عرض ادیتور بیرون بزنند */
    .rte-editor img, .wo-block-body img { max-width: 100%; height: auto; }
    /* جای‌نگهدارِ تصویر در «پیش‌نمایش کوتاه» شرح (فهرست‌ها) */
    .wo-desc-img-note { color: #64748b; font-size: .78rem; }

    /* ---------- ستون «گیرندگان» (طرح ۴: آواتار + شمارنده + نوار پاسخ‌ها) ----------
       هدف: با یک نگاه معلوم باشد «چه کسانی» دستور کار را گرفته‌اند و چقدر از کار
       پیش رفته است — حتی وقتی گیرندگان بیش از سه نفرند. تعداد آواتارِ نمایش‌داده‌شده
       خودکار به عرض صفحه بستگی دارد (پایین‌تر) و شمارندهٔ کنار آن همیشه «کل گیرندگان»
       را می‌گوید؛ فهرست کامل با کلیک روی آواتار/«جزئیات» باز می‌شود. */
    .wo-who-cell { position: relative; min-width: 196px; }
    .wo-who { display: flex; flex-direction: column; gap: 4px; }
    .wo-who-top { display: flex; align-items: center; gap: 6px; }
    .wo-avstack { display: flex; align-items: center; cursor: pointer; padding-inline-end: 2px; }
    .wo-avstack:focus-visible { outline: 2px solid #2563eb; outline-offset: 3px; border-radius: 999px; }
    .wo-avstack > .av { margin-inline-start: -7px; }
    .wo-avstack > .av:first-child { margin-inline-start: 0; }
    .wo-who .av {
        width: 24px; height: 24px; border-radius: 50%; display: inline-grid; place-items: center;
        font-size: 10px; font-weight: 700; color: #fff; flex: 0 0 auto;
        box-shadow: 0 0 0 2px #fff; font-family: inherit; letter-spacing: 0;
    }
    /* رنگ حلقه = وضعیت همان نفر (سبز=انجام شد، قرمز=انجام نشد، آبی=دیده بی‌پاسخ، خاکستری=نخوانده) */
    .wo-who .av.done { box-shadow: 0 0 0 2px #fff, 0 0 0 4px #86efac; }
    .wo-who .av.bad { box-shadow: 0 0 0 2px #fff, 0 0 0 4px #fca5a5; }
    .wo-who .av.seen { box-shadow: 0 0 0 2px #fff, 0 0 0 4px #bfdbfe; }
    .wo-who .av.new { opacity: .78; }
    .wo-who .av.c1 { background: #2563eb; } .wo-who .av.c2 { background: #0891b2; }
    .wo-who .av.c3 { background: #7c3aed; } .wo-who .av.c4 { background: #db2777; }
    .wo-who .av.c5 { background: #059669; } .wo-who .av.c6 { background: #d97706; }
    .wo-who .av.c7 { background: #475569; } .wo-who .av.c8 { background: #dc2626; }
    .wo-avcnt {
        min-width: 22px; height: 22px; padding: 0 4px; border-radius: 999px; margin-inline-start: 1px;
        background: #eef2f7; border: 1px solid #e2e8f0; color: #334155;
        font-size: 10.5px; font-weight: 700; display: inline-grid; place-items: center; box-shadow: 0 0 0 2px #fff;
    }
    .wo-who-btn {
        border: 1px solid #bfdbfe; background: #e8f0ff; color: #1d4ed8; border-radius: 999px;
        padding: 0 8px; font-size: 10.5px; font-weight: 700; line-height: 19px; cursor: pointer; font-family: inherit;
    }
    .wo-who-btn:hover { background: #dbeafe; }
    .wo-who-bar { display: flex; height: 6px; border-radius: 999px; background: #eef2f7; overflow: hidden; }
    .wo-who-bar > i { display: block; height: 100%; }
    .wo-who-bar > i.d { background: #059669; }
    .wo-who-bar > i.b { background: #dc2626; }
    .wo-who-sub { font-size: 10.5px; color: #64748b; }
    /* تعداد آواتارِ نمایش‌داده‌شده = خودکار بر اساس عرض صفحه (بقیه در شمارنده و پنل) */
    .wo-avstack > .av:nth-child(n+4) { display: none; }
    @@media (max-width: 1199.98px) { .wo-avstack > .av:nth-child(n+3) { display: none; } }
    @@media (max-width: 767.98px) { .wo-avstack > .av:nth-child(n+2) { display: none; } .wo-who-btn { display: none; } }
    /* پنل فهرست کامل گیرندگان — باید از کادر جدول بیرون بزند، پس تا وقتی باز است
       اسکرول افقیِ جدول موقتاً آزاد می‌شود (الگوی :has در همین پروژه استفاده شده). */
    .table-responsive:has(.wo-who-pop) { overflow: visible; }
    .wo-who-pop {
        position: absolute; top: calc(100% + 6px); inset-inline-start: 0; z-index: 4500;
        width: 290px; max-width: 92vw; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px;
        box-shadow: 0 14px 32px rgba(15,23,42,.18); padding: 8px;
    }
    .wo-who-pop-head { display: flex; align-items: center; gap: 8px; padding: 2px 4px 8px; border-bottom: 1px solid #f1f5f9; font-size: 11.5px; color: #475569; }
    .wo-who-pop-head .sp { flex: 1; }
    .wo-who-pop ul { list-style: none; margin: 4px 0 0; padding: 0; max-height: 250px; overflow: auto; }
    .wo-who-pop li { display: flex; align-items: center; gap: 7px; padding: 4px 5px; border-radius: 8px; font-size: 12px; }
    .wo-who-pop li:hover { background: #f8fafc; }
    .wo-who-pop .nm { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .wo-who-st { font-size: 10px; padding: 1px 7px; border-radius: 999px; border: 1px solid #e2e8f0; background: #f8fafc; color: #475569; white-space: nowrap; }
    .wo-who-st.done { background: #dcfce7; border-color: #a7f3d0; color: #047857; }
    .wo-who-st.bad { background: #fee2e2; border-color: #fca5a5; color: #b91c1c; }
    .wo-who-st.seen { background: #dbeafe; border-color: #bfdbfe; color: #1d4ed8; }
    .wo-who-empty { font-size: 11px; color: #94a3b8; }
    .ms-combo { position: relative; }
    .ms-combo-control { display: flex; flex-wrap: wrap; align-items: center; gap: .35rem; min-height: 42px; cursor: pointer; padding-left: 2rem; }
    .ms-combo-control.focus { border-color: #2563eb; }
    .ms-caret { position: absolute; left: .75rem; top: 50%; transform: translateY(-50%); color: #94a3b8; }
    .ms-chip { display: inline-flex; align-items: center; gap: .35rem; background: #eef4ff; color: #2563eb; border: 1px solid #dbe7ff; border-radius: 999px; padding: .15rem .6rem; font-size: .8rem; font-weight: 600; }
    .ms-chip i { cursor: pointer; opacity: .7; }
    .ms-combo-menu { position: absolute; top: calc(100% + 4px); right: 0; left: 0; z-index: 1060; background: #fff; border: 1px solid #e2e8f0; border-radius: 12px; overflow: hidden; }
    .ms-combo-items { max-height: 220px; overflow-y: auto; }
    .ms-combo-item { display: flex; align-items: center; gap: .5rem; padding: .5rem .85rem; cursor: pointer; font-size: .85rem; }
    .ms-combo-item:hover { background: #f1f5f9; }
    .ms-combo-item.sel { background: #eef4ff; }
    .fs-9 { font-size: .7rem; }

    /* ===== موبایل (بند ۱۴) ===== */
    @@media (max-width: 991.98px) {
        .wo-cell2 { min-height: 74px; border-radius: 10px; }
        .wo-chip2 { font-size: .58rem; padding: .12rem .3rem; }
        .wo-cal-legend2 { display: none; }
    }
    @@media (max-width: 575.98px) {
        .wo-tabs { position: sticky; top: 0; z-index: 5; background: var(--bs-body-bg, #f1f5f9); padding: .4rem 0; }
        .wo-tab { flex: 1; justify-content: center; padding: .5rem .4rem; font-size: .76rem; }
        .modal-dialog { margin: .5rem; }
        /* فرم دستور کار جدید — رسپانسیو موبایل */
        .modal-dialog.modal-fullscreen-sm-down { margin: 0; }
        .wo-form-modal { border-radius: 0 !important; }
        .wo-form-modal .wo-pr-group { display: flex; width: 100%; }
        .wo-form-modal .wo-pr-btn { flex: 1 1 auto; min-width: 0; text-align: center; padding: .45rem .3rem; }
        .wo-form-modal .modal-footer { flex-wrap: nowrap; gap: .5rem; }
        .wo-form-modal .modal-footer .btn { flex: 1 1 auto; padding-block: .55rem; }
        .wo-form-modal .modal-footer .btn.btn-primary { flex-grow: 2; }
        .wo-form-modal .modal-title { font-size: .95rem; }
        .wo-form-modal .form-label { font-size: .82rem; }
        .wo-cal2 { gap: .25rem; padding: .5rem; }
        .wo-cell2 { min-height: 56px; }
        .wo-chip-txt { display: none; }
        .wo-chip2 { justify-content: center; padding: .15rem; }
        .wo-day2 { font-size: .68rem; }
        .wo-today-tag { display: none; }
    }
    /* ---------- گزارش عملکرد افراد (موج ۸) ---------- */
    .wo-podium { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; max-width: 720px; }
    .wo-podium-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 14px; padding: .9rem; text-align: center; position: relative; }
    .wo-podium-1 { border-color: #fbbf24; background: linear-gradient(180deg, #fffbeb, #fff); order: 2; transform: translateY(-6px); box-shadow: 0 4px 14px rgba(251,191,36,.18); }
    .wo-podium-2 { border-color: #cbd5e1; background: linear-gradient(180deg, #f8fafc, #fff); order: 1; }
    .wo-podium-3 { border-color: #fdba74; background: linear-gradient(180deg, #fff7ed, #fff); order: 3; }
    .wo-podium-medal { font-size: 1.6rem; line-height: 1; margin-bottom: .25rem; }
    .wo-podium-pct { font-size: 1.25rem; font-weight: 800; color: #16a34a; margin-top: .15rem; }
    .wo-rank { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; background: #f1f5f9; color: #475569; font-size: .8rem; font-weight: 700; }
    .wo-rank-1 { background: #fef3c7; color: #b45309; }
    .wo-rank-2 { background: #f1f5f9; color: #475569; box-shadow: inset 0 0 0 1px #cbd5e1; }
    .wo-rank-3 { background: #ffedd5; color: #c2410c; }
    .wo-perf-good { background: #22c55e; }
    .wo-perf-mid { background: #f59e0b; }
    .wo-perf-bad { background: #ef4444; }
    .wo-perf-table th, .wo-perf-table td { white-space: nowrap; }
    @@media (max-width: 575.98px) {
        .wo-podium { grid-template-columns: 1fr; max-width: 100%; }
        .wo-podium-1 { transform: none; order: 1; }
        .wo-podium-2 { order: 2; }
        .wo-podium-3 { order: 3; }
    }

    /* ---------- قالب‌های آماده (موج ۷) ---------- */
    .wo-tpl-bar { display: flex; align-items: center; gap: .4rem; flex-wrap: wrap; background: #fffbeb; border: 1px dashed #fcd34d; border-radius: 12px; padding: .5rem .75rem; }
    .wo-tpl-chip { display: inline-flex; align-items: center; gap: .25rem; background: #fff; border: 1px solid #fcd34d; border-radius: 999px; padding: .18rem .3rem .18rem .55rem; font-size: .78rem; color: #92400e; transition: all .15s; }
    .wo-tpl-chip:hover { border-color: #f59e0b; box-shadow: 0 1px 4px rgba(245,158,11,.25); }
    .wo-tpl-chip.active { background: #f59e0b; border-color: #f59e0b; color: #fff; font-weight: 700; }
    .wo-tpl-chip.active .wo-tpl-x { color: #fff; }
    .wo-tpl-name { cursor: pointer; }
    .wo-tpl-x { border: 0; background: transparent; color: #b45309; padding: 0 .15rem; line-height: 1; border-radius: 50%; }
    .wo-tpl-x:hover { color: #dc2626; }
    .wo-tpl-save { background: #fffbeb; border-top: 1px dashed #fcd34d; padding-top: .75rem; }
    .wo-tpl-save-input { max-width: 320px; }
    .wo-tpl-save-btn { margin-left: auto; }
    @@media (max-width: 575.98px) {
        .wo-tpl-save-btn { width: 100%; margin-left: 0; }
        .wo-tpl-save-input { max-width: 100%; flex: 1 1 100%; }
    }

    /* ---------- نمای کانبان ---------- */
    .wo-kanban { display: grid; grid-template-columns: repeat(4, 1fr); gap: .75rem; align-items: start; }
    @@media (max-width: 992px) { .wo-kanban { grid-template-columns: repeat(2, 1fr); } }
    @@media (max-width: 576px) { .wo-kanban { grid-template-columns: 1fr; } }
    .wo-kb-col { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 14px; min-height: 220px; transition: all .15s; }
    .wo-kb-col.dragover { border-color: #7c3aed; background: #faf5ff; box-shadow: 0 0 0 3px rgba(124,58,237,.12); }
    .wo-kb-head { display: flex; justify-content: space-between; align-items: center; padding: .55rem .8rem; font-weight: 700; font-size: .85rem; border-bottom: 2px solid; border-radius: 14px 14px 0 0; }
    .wo-kb-head-3 { color: #dc2626; border-color: #dc2626; background: #fef2f2; }
    .wo-kb-head-2 { color: #ea580c; border-color: #ea580c; background: #fff7ed; }
    .wo-kb-head-1 { color: #2563eb; border-color: #2563eb; background: #eff6ff; }
    .wo-kb-head-0 { color: #64748b; border-color: #94a3b8; background: #f1f5f9; }
    .wo-kb-count { background: rgba(0,0,0,.07); border-radius: 999px; padding: 0 .5rem; font-size: .75rem; }
    .wo-kb-body { padding: .5rem; display: flex; flex-direction: column; gap: .5rem; }
    .wo-kb-empty { text-align: center; color: #cbd5e1; padding: 1rem 0; }
    .wo-kb-card { background: #fff; border: 1px solid #e2e8f0; border-radius: 10px; padding: .55rem .65rem; cursor: pointer; transition: all .12s; }
    .wo-kb-card:hover { border-color: #93c5fd; box-shadow: 0 3px 10px rgba(37,99,235,.12); }
    .wo-kb-card.draggable { cursor: grab; }
    .wo-kb-card.overdue { border-inline-start: 3px solid #dc2626; }

    /* ---------- ارجاع زنجیره‌ای ---------- */
    .wo-chain-row { display: flex; align-items: center; gap: .5rem; padding: .25rem 0; flex-wrap: wrap; }
    .wo-chain-link { color: #4f46e5; font-size: .82rem; cursor: pointer; text-decoration: none; }
    .wo-chain-link:hover { text-decoration: underline; }

    /* ---------- برچسب/دسته‌بندی ---------- */
    .wo-tag {
        display: inline-flex; align-items: center; gap: .25rem;
        background: #f3e8ff; color: #7c3aed; border: 1px solid #e9d5ff;
        border-radius: 2rem; padding: .1rem .55rem; font-size: .75rem;
    }
    .wo-tag-sm { font-size: .68rem; padding: .05rem .45rem; cursor: pointer; }
    .wo-tag-sm:hover { background: #e9d5ff; }
    .wo-tag-x {
        border: 0; background: none; padding: 0; margin-inline-start: .1rem;
        color: #a855f7; cursor: pointer; line-height: 1;
    }
    .wo-tag-x:hover { color: #dc2626; }
    .wo-tag-suggest {
        border: 1px dashed #c4b5fd; background: none; color: #7c3aed;
        border-radius: 2rem; padding: .05rem .5rem; font-size: .72rem; cursor: pointer;
    }
    .wo-tag-suggest:hover { background: #f3e8ff; }
    .wo-tag-suggest.active { background: #7c3aed; color: #fff; border-style: solid; }

    /* ---------- رشتهٔ گفتگو (کامنت‌ها) ---------- */
    .wo-cm { display: flex; gap: .5rem; align-items: flex-start; margin-bottom: .6rem; }
    .wo-cm-bubble {
        flex: 1; background: #f8f9fa; border: 1px solid #e9ecef;
        border-radius: .6rem; padding: .45rem .65rem; min-width: 0;
    }
    .wo-cm.mine .wo-cm-bubble { background: #eef2ff; border-color: #dbe4ff; }
    .wo-cm-head { display: flex; gap: .5rem; align-items: baseline; flex-wrap: wrap; }
    .wo-cm-text { font-size: .85rem; white-space: pre-wrap; word-break: break-word; margin-top: .15rem; }
    .wo-cm-quote {
        font-size: .75rem; color: #6c757d; background: #fff;
        border-inline-start: 3px solid #adb5bd; border-radius: .25rem;
        padding: .2rem .5rem; margin: .25rem 0;
    }
    .wo-cm-actions { display: flex; gap: .75rem; margin-top: .25rem; }
    .wo-cm-link {
        border: 0; background: none; padding: 0; font-size: .72rem;
        color: #6c757d; cursor: pointer;
    }
    .wo-cm-link:hover { color: #4f46e5; text-decoration: underline; }

    /* منوی انتخاب طرف گفتگو در جزئیات دستور */
    .wo-chat-wrap { position: relative; }
    .wo-chat-menu {
        position: absolute; top: calc(100% + 4px); inset-inline-start: 0; z-index: 1060;
        min-width: 200px; max-height: 240px; overflow-y: auto;
        background: #fff; border: 1px solid #dee2e6; border-radius: .5rem; padding: .25rem;
    }
    .wo-chat-item {
        display: flex; align-items: center; gap: .5rem; width: 100%;
        border: 0; background: none; text-align: start;
        padding: .35rem .5rem; border-radius: .35rem; font-size: .85rem;
    }
    .wo-chat-item:hover { background: #f1f3f5; }
    /* Work-order layout: explicit RTL alignment, independent of Bootstrap utility direction. */
    .wo-page-head { display:flex; align-items:center; gap:1rem; direction:rtl; }
    .wo-page-head h1 { margin:0; }
    .wo-page-action, .wo-filter-actions { margin-right:auto !important; margin-left:0 !important; }
    /* تب‌های دستور کار (دستورهای من / محول به من / بایگانی / کانبان / تقویم / عملکرد افراد / داشبورد)
       در چیدمان RTL سمت راست صفحه می‌نشینند. */
    .wo-tabs { direction:rtl; justify-content:flex-start; }
    .wo-dialog-backdrop { background:rgba(15,23,42,.48); }
    .wo-form-dialog { max-width:1060px; }
    .wo-detail-dialog { max-width:1100px; }
    .wo-dialog-header { display:flex; align-items:center; gap:1.25rem; padding:1.1rem 1.4rem; border-bottom:1px solid #e5eaf0; flex-wrap:nowrap; flex-shrink:0; }
    .wo-dialog-heading { min-width:0; flex:1 1 auto; }
    .wo-dialog-heading .modal-title { font-size:1.08rem; line-height:1.8; overflow-wrap:anywhere; font-weight:750; margin:0; }
    .wo-dialog-heading > .badge { margin-top:.2rem; background:transparent !important; border:0 !important; padding:0; color:#64748b !important; }
    .wo-header-actions { display:flex; gap:.5rem; align-items:center; justify-content:flex-end; flex:0 0 auto; margin-right:auto; margin-left:0; }
    .wo-header-actions .btn { white-space:nowrap; display:inline-flex; gap:.35rem; align-items:center; min-height:34px; border-radius:8px; }
    .wo-header-actions .btn-close { margin:0 8px 0 0 !important; padding:.55rem; flex-shrink:0; background-size:12px; }
    .wo-source-meta { margin-top:.4rem; font-size:.78rem; color:#64748b; }
    .wo-form-body { background:#fafbfc; padding:1.25rem 1.4rem; }
    .wo-form-grid { display:grid; grid-template-columns:minmax(0,1fr) 310px; align-items:start; gap:1.2rem; }
    .wo-form-main, .wo-form-schedule { background:#fff; border:1px solid #e5eaf0; border-radius:12px; padding:1.05rem; min-width:0; }
    .wo-form-main .form-label, .wo-form-schedule .form-label { font-size:.82rem; font-weight:650; margin-bottom:.45rem; color:#475569; }
    .wo-form-main .form-control, .wo-form-schedule .form-control, .wo-form-schedule .form-select { border-radius:8px; min-height:40px; }
    .wo-form-main .rte-editor { min-height:150px; max-height:270px; overflow:auto; }
    .wo-form-main .rte-toolbar { flex-wrap:wrap; }
    .wo-form-schedule { display:grid; gap:1.1rem; }
    .wo-sms-option { grid-column:1 / -1; }
    .wo-section-label { font-size:.87rem; font-weight:750; padding-bottom:.7rem; border-bottom:1px solid #edf0f4; }
    .wo-date-row { display:grid; grid-template-columns:minmax(0,1fr) 112px; gap:.7rem; }
    .wo-date-row > div { min-width:0; }
    .wo-form-extras { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:.8rem; margin-top:1rem; align-items:start; }
    .wo-fold { background:#fff; border:1px solid #e5eaf0; border-radius:10px; overflow:hidden; min-width:0; }
    .wo-fold > summary { padding:.85rem 1rem; cursor:pointer; font-size:.82rem; font-weight:650; color:#475569; }
    .wo-fold[open] > summary { border-bottom:1px solid #edf0f4; }
    .wo-count { display:inline-block; min-width:22px; margin-right:.4rem; padding:.08rem .3rem; background:#f1f5f9; color:#64748b; border-radius:5px; font-size:.7rem; text-align:center; }
    .wo-fold-body { padding:.8rem; }
    .wo-fold-body .form-label { display:none; }
    .wo-fold-body .d-flex.gap-2 { flex-wrap:wrap; }
    .wo-fold-body input.form-control { flex:1 1 140px; width:auto; min-width:0; }
    .wo-template-fold { margin-bottom:1rem; }
    .wo-template-fold .wo-tpl-bar { padding:.8rem; margin:0; border:0; border-radius:0; background:#fff; }
    .wo-template-save-row { display:flex; gap:.7rem; align-items:center; margin-top:1rem; }
    .wo-template-save-row .form-control { max-width:320px; }
    .wo-template-save-row .btn { white-space:nowrap; }
    .wo-dialog-footer { display:flex; direction:rtl; gap:.7rem; padding:.9rem 1.4rem; background:#fff; border-top:1px solid #e5eaf0; flex-shrink:0; }
    .wo-dialog-footer > * { margin:0; }
    .wo-footer-actions { display:flex; gap:.6rem; align-items:center; margin-right:auto; margin-left:0; }
    .wo-dialog-footer .btn { min-height:38px; border-radius:8px; font-size:.83rem; }
    .wo-detail-meta { display:flex; gap:.45rem; flex-wrap:wrap; padding:.8rem 1.4rem; align-items:center; flex-shrink:0; }
    .wo-detail-tabs { display:flex; gap:1.4rem; padding:0 1.4rem; border-bottom:1px solid #e5eaf0; overflow-x:auto; flex-shrink:0; }
    .wo-detail-tabs > button { flex-shrink:0; border:0; border-bottom:2px solid transparent; background:transparent; padding:.75rem .1rem; color:#64748b; font-size:.83rem; font-weight:650; }
    .wo-detail-tabs > button.active { color:#2563eb; border-bottom-color:#2563eb; }
    .wo-detail-tabs > button span { font-size:.7rem; background:#f1f5f9; padding:.1rem .35rem; border-radius:5px; margin-right:.25rem; }
    .wo-detail-body { background:#fafbfc; padding:1.2rem 1.4rem; min-height:240px; }
    .wo-detail-body > section[hidden] { display:none !important; }
    .wo-detail-body .wo-info { gap:.8rem; grid-template-columns:repeat(auto-fit,minmax(160px,1fr)); }
    .wo-detail-body .wo-info > div { background:#fff; border:1px solid #e5eaf0; padding:.75rem .9rem; gap:.2rem; }
    .wo-detail-body .wo-block { border-radius:10px; background:#fff; border-color:#e5eaf0 !important; }
    .wo-detail-body .wo-block-title { background:#fff !important; padding:.8rem 1rem; border-bottom:1px solid #edf0f4; }
    .wo-detail-body .wo-block-body { padding:1rem; overflow-wrap:anywhere; }
    .wo-detail-body .wo-asg { background:#fff; margin-bottom:.8rem; padding:.9rem; }
    .wo-detail-body .wo-asg:last-child { margin-bottom:0; }
    .wo-detail-body .wo-block-body img { max-width:100%; height:auto; }
    .wo-related-cell { min-width:145px; max-width:240px; }
    /* ستون «تصمیم دستوردهنده» — نشان‌ها کوتاه و بدون شکست خط بمانند */
    .wo-dec-approved.active { background:#dbeafe !important; color:#1d4ed8 !important; border-color:#93b5ed !important; }
    .wo-dec-rejected.active { background:#fee2e2 !important; color:#b91c1c !important; border-color:#fca5a5 !important; }
    .wo-dec-pending.active { background:#fef3c7 !important; color:#92400e !important; border-color:#fcd34d !important; }
    .wo-dec-awaiting.active { background:#f1f5f9 !important; color:#334155 !important; border-color:#cbd5e1 !important; }
    .wo-flt-dec .wo-pr-btn { white-space:nowrap; }
    .wo-decision-cell { min-width:120px; }
    .wo-decision-cell .badge { white-space: nowrap; }
    .wo-related-links { display:flex; align-items:center; flex-wrap:wrap; gap:.3rem; }
    .wo-related-link { display:inline-flex; align-items:center; gap:.3rem; padding:.2rem .5rem; border:1px solid #dce6f5; border-radius:6px; color:#2563eb; background:#f8fbff; text-decoration:none; font-size:.74rem; font-weight:600; white-space:nowrap; }
    .wo-related-link:hover { background:#eaf2ff; border-color:#93b5ed; color:#1d4ed8; text-decoration:underline; }
    .wo-related-link:focus-visible, .wo-fold > summary:focus-visible, .wo-detail-tabs > button:focus-visible { outline:2px solid #2563eb; outline-offset:3px; }
    .wo-mobile-related { padding:.3rem 0; }
    .wo-muted-empty { color:#94a3b8; text-align:center; padding:2rem; }
    @@media (max-width:991.98px) {
        .wo-form-grid { grid-template-columns:minmax(0,1fr); }
        .wo-form-schedule { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .wo-section-label, .wo-date-row { grid-column:1 / -1; }
        .wo-form-extras { grid-template-columns:repeat(2,minmax(0,1fr)); }
        .wo-dialog-header { flex-wrap:wrap; gap:.7rem; }
        .wo-header-actions { flex-wrap:wrap; }
    }
    @@media (max-width:575.98px) {
        .wo-page-head { align-items:flex-start; }
        .wo-page-head h1 { font-size:1.05rem; }
        .wo-page-action { font-size:.76rem; white-space:nowrap; }
        .wo-dialog-header, .wo-dialog-footer { padding:.85rem 1rem; }
        .wo-form-dialog, .wo-detail-dialog { height:100dvh; min-height:100dvh; }
        .wo-form-modal, .wo-detail-modal { border-radius:0; height:100%; max-height:100dvh; }
        .wo-form-modal .modal-body, .wo-detail-modal .modal-body { max-height:none; min-height:0; flex:1 1 auto; }
        .wo-modal .wo-dialog-footer { position:static; flex:0 0 auto; min-height:0; height:auto; }
        .wo-detail-modal .wo-dialog-footer .btn { flex:0 0 auto; }
        .wo-detail-modal .wo-dialog-heading, .wo-gardesh-modal .wo-dialog-heading { flex-basis:100%; }
        .wo-header-actions { max-width:100%; gap:.4rem; }
        .wo-header-actions .btn { font-size:.74rem; padding:.35rem .6rem; }
        .wo-form-body, .wo-detail-body { padding:.85rem; }
        .wo-form-main, .wo-form-schedule { padding:.8rem; }
        .wo-form-extras { grid-template-columns:minmax(0,1fr); }
        .wo-detail-meta { padding:.6rem 1rem; }
        .wo-detail-tabs { gap:1rem; padding:0 1rem; }
        .wo-form-modal .modal-footer { flex-wrap:wrap; }
        .wo-form-modal .modal-footer .btn { flex:0 0 auto; }
        .wo-form-modal .modal-footer .wo-template-button { font-size:.75rem; padding-inline:.45rem; }
        .wo-footer-actions { flex-wrap:wrap; justify-content:flex-end; }
        .wo-detail-body .wo-info { grid-template-columns:repeat(2,minmax(0,1fr)); }
    }
</style>

@* ================== گردش کار دستور — مشابه گردش نامه داخلی ================== *@
@if (gardeshOpen && detail != null)
{
    var isOwnerG = detail.OwnerUserId == access.UserId;
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55);z-index:2000">
        <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content wo-gardesh-modal" dir="rtl">
                <div class="modal-header wo-dialog-header">
                    <div class="wo-dialog-heading">
                        <h5 class="modal-title mb-1"><i class="bi bi-diagram-3 text-primary"></i> گردش کار — @detail.Title</h5>
                        <span class="badge bg-dark-subtle text-dark border num me-1">@detail.Number</span>
                        <span class="fs-8 text-muted">مهلت: <span class="num">@detail.DueAt.ToFa()</span></span>
                    </div>
                    <div class="wo-header-actions">
                        <div class="btn-group btn-group-sm" role="group" aria-label="نمای گردش کار">
                            <button type="button" class="btn @(gardeshView == 0 ? "btn-primary" : "btn-light border")" @onclick="() => gardeshView = 0">لیستی</button>
                            <button type="button" class="btn @(gardeshView == 1 ? "btn-primary" : "btn-light border")" @onclick="() => gardeshView = 1">درختواره</button>
                            <button type="button" class="btn @(gardeshView == 2 ? "btn-primary" : "btn-light border")" @onclick="() => gardeshView = 2">فلوچارتی</button>
                        </div>
                        <button type="button" class="btn-close" aria-label="بستن گردش کار" @onclick="() => gardeshOpen = false"></button>
                    </div>
                </div>
                <div class="modal-body">

                    @* ---------- افزودن نفر به گردش (فقط دستوردهنده، دستور باز) ---------- *@
                    @if (isOwnerG && detail.Status == "Open")
                    {
                        @if (!gdAddOpen)
                        {
                            <div class="d-flex justify-content-end mb-2">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenGardeshAdd">
                                    <i class="bi bi-person-plus"></i> افزودن نفر به گردش
                                </button>
                            </div>
                        }
                        else
                        {
                            var existingIds = detail.Assignees.Select(x => x.UserId).ToHashSet();
                            var opts = targets.Where(t => !existingIds.Contains(t.Id)
                                && (string.IsNullOrWhiteSpace(gdAddSearch) || t.Username.Contains(gdAddSearch.Trim(), StringComparison.OrdinalIgnoreCase))).ToList();
                            <div class="wo-block mb-3" style="border-color:#bfdbfe">
                                <div class="wo-block-title" style="background:#eff6ff">
                                    <i class="bi bi-person-plus text-primary"></i> افزودن نفر به گردش
                                    <button type="button" class="btn-close ms-auto" style="font-size:.6rem" aria-label="انصراف" @onclick="() => gdAddOpen = false"></button>
                                </div>
                                <div class="wo-block-body">
                                    @if (gdAddSel.Count > 0)
                                    {
                                        <div class="d-flex flex-wrap gap-1 mb-2">
                                            @foreach (var t in targets.Where(t => gdAddSel.Contains(t.Id)))
                                            {
                                                var tid = t.Id;
                                                <span class="ms-chip">@t.Username <i class="bi bi-x-circle-fill" role="button" @onclick="() => gdAddSel.Remove(tid)"></i></span>
                                            }
                                        </div>
                                    }
                                    <input class="form-control form-control-sm mb-1" placeholder="جستجوی افراد..." @bind="gdAddSearch" @bind:event="oninput" />
                                    <div class="border rounded mb-2" style="max-height:200px;overflow:auto">
                                        @if (gdAddLoading)
                                        {
                                            <div class="text-center py-3"><span class="spinner-border spinner-border-sm text-primary"></span></div>
                                        }
                                        else if (opts.Count == 0)
                                        {
                                            <div class="text-muted fs-8 text-center py-3">فرد دیگری در لیست مجاز شما برای افزودن نیست.</div>
                                        }
                                        else
                                        {
                                            @foreach (var t in opts)
                                            {
                                                var tid = t.Id;
                                                var isSel = gdAddSel.Contains(tid);
                                                <div class="ms-combo-item @(isSel ? "sel" : "")" role="button" @onclick="() => { if (!gdAddSel.Remove(tid)) gdAddSel.Add(tid); }">
                                                    <i class="bi @(isSel ? "bi-check-square-fill" : "bi-square")"></i> @t.Username
                                                </div>
                                            }
                                        }
                                    </div>
                                    <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="توضیح برای افراد جدید (اختیاری)..." @bind="gdAddNote"></textarea>
                                    <div class="d-flex flex-wrap align-items-center gap-2">
                                        <div class="form-check mb-0">
                                            <input class="form-check-input" type="checkbox" id="gdAddSms" @bind="gdAddSms" disabled="@(!access.SmsConfigured)" />
                                            <label class="form-check-label fs-8" for="gdAddSms">ارسال پیامک@(access.SmsConfigured ? "" : " (تنظیم نشده)")</label>
                                        </div>
                                        <button type="button" class="btn btn-primary btn-sm ms-auto" disabled="@(busy || gdAddSel.Count == 0)" @onclick="SubmitGardeshAdd">
                                            <i class="bi bi-check2"></i> افزودن @(gdAddSel.Count > 0 ? $"({gdAddSel.Count} نفر)" : "")
                                        </button>
                                    </div>
                                </div>
                            </div>
                        }
                    }

                    @* ---------- نمای لیستی ---------- *@
                    @if (gardeshView == 0)
                    {
                        <div class="wo-gd-station">
                            <div class="d-flex justify-content-between flex-wrap gap-1">
                                <b><i class="bi bi-person-badge text-primary"></i> @detail.OwnerName @(isOwnerG ? "(شما)" : "")</b>
                                <span class="fs-8 text-muted">دستوردهنده · ثبت: <span class="num">@detail.CreatedAt.ToFa()</span></span>
                            </div>
                            <div class="fs-8 text-muted mt-1">شروع گردش — وضعیت دستور: @(detail.Status == "Open" ? "باز" : "بسته‌شده")</div>
                        </div>
                        @foreach (var a in detail.Assignees)
                        {
                            var aa = a;
                            <div class="wo-gd-station @(aa.Done == true ? "done" : "") @(selectedGardeshAssignee?.Id == aa.Id ? "wo-gd-selected" : "")" @onclick="() => SelectGardeshAssignee(aa)">
                                <div class="d-flex justify-content-between flex-wrap gap-1">
                                    <b><i class="bi bi-person"></i> @aa.Name @(aa.UserId == access.UserId ? "(شما)" : "")</b>
                                    @if (aa.Done == true) { <span class="badge bg-success-subtle text-success border">✅ انجام شد</span> }
                                    else if (aa.Done == false) { <span class="badge bg-danger-subtle text-danger border">❌ انجام نشد</span> }
                                    else if (aa.SeenAt != null) { <span class="badge bg-info-subtle text-info border">رویت شده</span> }
                                    else { <span class="badge bg-light text-dark border">در انتظار رویت</span> }
                                </div>
                                <div class="fs-8 text-muted mt-1">
                                    رویت: <span class="num">@(aa.SeenAt == null ? "—" : aa.SeenAt.Value.ToFa())</span>
                                    · پاسخ: <span class="num">@(aa.RepliedAt == null ? "—" : aa.RepliedAt.Value.ToFa())</span>
                                    @if (aa.OwnerDecision != null) { <span>· تصمیم دستوردهنده: <b>@(aa.OwnerDecision == "Approved" ? "تایید ✔" : "رد ✗")</b></span> }
                                </div>
                                @if (!string.IsNullOrWhiteSpace(aa.ReplyText))
                                {
                                    <div class="wo-reply mt-1"><i class="bi bi-reply"></i> @aa.ReplyText</div>
                                }
                                @if (!string.IsNullOrWhiteSpace(aa.OwnerDecisionNote))
                                {
                                    <div class="fs-8 text-muted mt-1">یادداشت دستوردهنده: @aa.OwnerDecisionNote</div>
                                }
                            </div>
                        }
                        @if (detail.Assignees.Count == 0)
                        {
                            <div class="text-muted text-center py-4"><i class="bi bi-people"></i> گیرنده‌ای ثبت نشده است</div>
                        }
                    }

                    @* ---------- نمای درختواره ---------- *@
                    else if (gardeshView == 1)
                    {
                        <div class="ltx" style="animation:none">
                            <div class="gtree">
                                <ul>
                                    <li>
                                        <div class="tnode">
                                            <span class="mini"><i class="bi bi-person-badge"></i></span>
                                            <div><b>@detail.OwnerName</b><small> — دستوردهنده · @detail.CreatedAt.ToFa()</small></div>
                                            <span class="tst p">شروع گردش</span>
                                        </div>
                                        <ul>
                                            <li>
                                                <div class="tnode">
                                                    <span class="mini"><i class="bi bi-card-checklist"></i></span>
                                                    <div><b>گیرندگان دستور</b><small> — @detail.Assignees.Count(a => a.RepliedAt != null)/@detail.Assignees.Count پاسخ</small></div>
                                                    <span class="tst @(detail.Assignees.Count > 0 && detail.Assignees.All(a => a.Done == true) ? "g" : "w")">
                                                        @(detail.Assignees.Count > 0 && detail.Assignees.All(a => a.Done == true) ? "انجام شد" : "در جریان")
                                                    </span>
                                                </div>
                                                <ul>
                                                    @foreach (var a in detail.Assignees)
                                                    {
                                                        var aa = a;
                                                        <li>
                                                            <div class="tnode gnode-click @(selectedGardeshAssignee?.Id == aa.Id ? "wo-gd-selected" : "")" @onclick="() => SelectGardeshAssignee(aa)">
                                                                <span class="mini"><i class="bi bi-person"></i></span>
                                                                <div><b>@aa.Name</b><small> — رویت: @(aa.SeenAt == null ? "—" : aa.SeenAt.Value.ToFa())</small></div>
                                                                <span class="tst @(aa.Done == true ? "g" : aa.Done == false ? "r" : "w")">
                                                                    @(aa.Done == true ? "انجام شد" : aa.Done == false ? "انجام نشد" : aa.SeenAt != null ? "رویت شده" : "در انتظار")
                                                                </span>
                                                            </div>
                                                        </li>
                                                    }
                                                </ul>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    }

                    @* ---------- نمای فلوچارتی ---------- *@
                    else
                    {
                        <div class="ltx" style="animation:none">
                            <div class="fcwrap">
                                <div class="fc">
                                    <ul>
                                        <li>
