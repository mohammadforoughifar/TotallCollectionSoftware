        editingId = detail.Id;
        _sourceModule = detail.SourceModule;
        _sourceId = detail.SourceId;
        _sourceRefId = detail.SourceRefId;
        _sourceLabel = "";
        _sourceDocTitle = "";
        var desc = detail.Description ?? "";
        var title = detail.Title;
        var due = detail.DueAt;
        var pr = detail.Priority;
        var rec = detail.Recurrence;
        var hasSeries = detail.RecurrenceSeriesId != null;
        var detailId = detail.Id;
        var prjId = detail.ProjectId ?? 0;
        var prjWeight = detail.Weight;
        var prjCode = detail.ProjectCode ?? "";
        var prjName = detail.ProjectName ?? "";
        var ids = detail.Assignees.Select(a => a.UserId).ToHashSet();
        var extra = detail.Assignees.Select(a => new TargetOpt { Id = a.UserId, Username = a.Name }).ToList();
