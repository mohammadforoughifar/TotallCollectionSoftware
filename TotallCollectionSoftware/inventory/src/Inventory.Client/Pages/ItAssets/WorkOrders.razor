    /// <summary>
    /// خواندن متن کامل شرح از سرور (فقط وقتی سرور علامت HasFullDescription داده است).
    /// بدون این، جزئیات فقط پیش‌نمایش کوتاه را نشان می‌داد و تصاویر نامه دیده نمی‌شدند.
    /// </summary>
    private async Task LoadFullDescription(WoItem w)
    {
        if (!w.HasFullDescription) return;
        try
        {
            var r = await Http.GetFromJsonAsync<DescResult>($"/api/workorders/{w.Id}/description");
            if (r is null) return;
            w.Description = r.Description ?? w.Description;
            if (detail?.Id == w.Id) { detail.Description = w.Description; StateHasChanged(); }
        }
        catch { /* نمایشِ پیش‌نمایش بهتر از خطا است */ }
    }

