    private async Task LoadTemplates()
    {
        try { myTemplates = await Http.GetFromJsonAsync<List<TplItem>>("/api/workorders/templates") ?? new(); }
        catch { myTemplates = new(); }
    }

    /// <summary>اعمال قالب روی فرم — همه فیلدها به‌جز تاریخ/ساعت مقرر پیش‌پُر می‌شوند.</summary>
    private async Task ApplyTemplate(TplItem t)
    {
        newTitle = t.Title;
        newPriority = t.Priority;
        newRecurrence = t.Recurrence;
        newChecklist = t.ChecklistItems.ToList();
        newTags = t.Tags.ToList();
        // فقط گیرندگانی که هنوز در لیست مجاز هستند انتخاب می‌شوند
        selTargets = t.AssigneeUserIds.Where(id => targets.Any(x => x.Id == id)).ToHashSet();
        appliedTplId = t.Id;
        if (rte != null) await rte.SetHtmlAsync(t.Description ?? "");
        // شمارش استفاده — ناهمگام؛ خطا مهم نیست
        _ = Http.PostAsync($"/api/workorders/templates/{t.Id}/used", null);
        Toast.Success($"قالب «{t.Name}» روی فرم اعمال شد.");
        StateHasChanged();
    }

    /// <summary>ذخیرهٔ محتوای فعلی فرم به‌عنوان قالب.</summary>
    private async Task SaveTemplate()
    {
        if (string.IsNullOrWhiteSpace(tplName)) return;
        if (string.IsNullOrWhiteSpace(newTitle)) { formError = "برای ذخیرهٔ قالب، عنوان دستور کار را وارد کنید."; return; }
        tplBusy = true;
        try
        {
            string desc = rte != null ? await rte.GetHtmlAsync() : "";
            var payload = new
            {
                name = tplName.Trim(),
                title = newTitle,
                description = desc,
                priority = newPriority,
                recurrence = newRecurrence,
                assigneeUserIds = selTargets.ToList(),
                checklistItems = newChecklist,
                tags = newTags
            };
            var resp = await Http.PostAsJsonAsync("/api/workorders/templates", payload);
            if (!resp.IsSuccessStatusCode) { await ShowApiError(resp, "خطا در عملیات قالب"); return; }
            Toast.Success($"قالب «{tplName.Trim()}» ذخیره شد.");
            tplName = ""; tplSaveOpen = false;
            await LoadTemplates();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { tplBusy = false; }
    }

    private async Task DeleteTemplate(int tplId)
    {
        try
        {
            var resp = await Http.DeleteAsync($"/api/workorders/templates/{tplId}");
            if (!resp.IsSuccessStatusCode) { await ShowApiError(resp, "خطا در عملیات قالب"); return; }
            myTemplates.RemoveAll(t => t.Id == tplId);
            if (appliedTplId == tplId) appliedTplId = 0;
            Toast.Success("قالب حذف شد.");
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    // ---- خروجی Excel / PDF ----
    private bool exporting;

    /// <summary>خروجی گرفتن از تب جاری با فیلترهای جاری — فایل از سرور ساخته و دانلود می‌شود.</summary>
    private async Task ExportList(string format)
    {
        exporting = true;
        try
        {
            var url = $"/api/workorders/export?tab={tab}&format={format}";
            if (!string.IsNullOrWhiteSpace(fltQ)) url += $"&q={Uri.EscapeDataString(fltQ.Trim())}";
            if (fltPriority >= 0) url += $"&priority={fltPriority}";
            if (fltTag != null) url += $"&tag={Uri.EscapeDataString(fltTag)}";
            if (fltProject > 0) url += $"&projectId={fltProject}";
            if (!string.IsNullOrEmpty(fltDecision)) url += $"&decision={fltDecision}";

            var resp = await Http.GetAsync(url);
            if (!resp.IsSuccessStatusCode) { Toast.Error("خطا در تهیه خروجی"); return; }

            var bytes = await resp.Content.ReadAsByteArrayAsync();
            var name = resp.Content.Headers.ContentDisposition?.FileNameStar
                       ?? resp.Content.Headers.ContentDisposition?.FileName?.Trim('"')
                       ?? $"workorders-{tab}.{format}";
            var mime = format == "pdf" ? "application/pdf"
                       : "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet";
            await JS.InvokeVoidAsync("downloadBlob", name, mime, Convert.ToBase64String(bytes));
        }
        catch { Toast.Error("خطا در تهیه خروجی"); }
        finally { exporting = false; }
    }

    // ---- نمای کانبان ----
    private string kanbanScope = "mine";  // mine | assigned
    private int kbDragId;                 // کارت در حال کشیدن
    private int kbDragOver = -1;          // ستونی که کارت روی آن است

    private List<WoItem> KanbanItems => kanbanScope == "assigned" ? assignedItems : mineItems;

    /// <summary>رها کردن کارت روی ستون اولویت — فقط دستورهای خودم؛ سرور هم مالکیت را کنترل می‌کند.</summary>
    private async Task KanbanDrop(int newPriority)
    {
        kbDragOver = -1;
        var w = KanbanItems.FirstOrDefault(x => x.Id == kbDragId);
        kbDragId = 0;
        if (w == null || w.Priority == newPriority) return;
        if (w.OwnerUserId != access.UserId)
        {
            Toast.Error("فقط اولویت دستورهای خودتان قابل تغییر است.");
            return;
        }
        var old = w.Priority;
        w.Priority = newPriority; // خوش‌بینانه — در خطا برمی‌گردد
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{w.Id}/priority", new { Priority = newPriority });
            if (!resp.IsSuccessStatusCode)
            {
                w.Priority = old;
                await ShowApiError(resp, "خطا در تغییر اولویت");
            }
        }
        catch { w.Priority = old; Toast.Error("خطا در تغییر اولویت"); }
        StateHasChanged();
    }

