    private void SetReplyTo(CmItem cm) { replyTo = cm; editingCommentId = 0; }

    private async Task SubmitComment()
    {
        if (detail == null || string.IsNullOrWhiteSpace(newCommentText)) return;
        cmBusy = true;
        try
        {
            var resp = await Http.PostAsJsonAsync($"/api/workorders/{detail.Id}/comments",
                new { Text = newCommentText.Trim(), ReplyToId = replyTo?.Id });
            if (resp.IsSuccessStatusCode)
            {
                var cm = await resp.Content.ReadFromJsonAsync<CmItem>();
                if (cm != null) comments.Add(cm);
                newCommentText = ""; replyTo = null;
            }
            else await ShowApiError(resp, "خطا در ثبت کامنت");
        }
        catch { Toast.Error("خطا در ثبت کامنت"); }
        finally { cmBusy = false; }
    }

    private void StartEditComment(CmItem cm) { editingCommentId = cm.Id; editingCommentText = cm.Text; replyTo = null; }
    private void CancelEditComment() { editingCommentId = 0; editingCommentText = ""; }

    private async Task SubmitEditComment()
    {
        if (editingCommentId == 0 || string.IsNullOrWhiteSpace(editingCommentText)) return;
        cmBusy = true;
        try
        {
            var resp = await Http.PutAsJsonAsync($"/api/workorders/comments/{editingCommentId}",
                new { Text = editingCommentText.Trim() });
            if (resp.IsSuccessStatusCode)
            {
                var cm = comments.FirstOrDefault(c => c.Id == editingCommentId);
                if (cm != null) { cm.Text = editingCommentText.Trim(); cm.EditedAt = DateTime.Now; }
                CancelEditComment();
            }
            else await ShowApiError(resp, "خطا در ویرایش کامنت");
        }
        catch { Toast.Error("خطا در ویرایش کامنت"); }
        finally { cmBusy = false; }
    }

