    private async Task SearchProjectsAsync(string q, List<LookupItem> sink, int keepId, string keepName, bool openOnly = true)
    {
        try
        {
            var list = await Http.GetFromJsonAsync<List<WorkProjectLookupDto>>(
                $"/api/workprojects/lookup?q={Uri.EscapeDataString(q ?? "")}&take=20&openOnly={(openOnly ? "true" : "false")}") ?? new();
            foreach (var p in list)
                if (!projectOpts.Any(x => x.Id == p.Id)) projectOpts.Add(p);
            sink.Clear();
            sink.AddRange(list.Select(p => new LookupItem { Id = p.Id, Name = $"{p.Code} — {p.Name}" }));
            if (keepId > 0 && sink.All(x => x.Id != keepId) && !string.IsNullOrWhiteSpace(keepName))
                sink.Insert(0, new LookupItem { Id = keepId, Name = keepName });
            StateHasChanged();
        }
        catch { }
    }

