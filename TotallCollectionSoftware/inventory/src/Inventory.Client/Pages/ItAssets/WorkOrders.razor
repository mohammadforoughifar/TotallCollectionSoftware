    private async Task DeleteOrder(WoItem? order)
    {
        if (order == null || !access.CanDelete || busy) return;
        if (!await JS.InvokeAsync<bool>("confirm", $"این نوبت از دستور کار {order.Number} حذف شود؟")) return;
        busy = true;
        try
        {
            var response = await Http.DeleteAsync($"/api/workorders/{order.Id}");
            if (!response.IsSuccessStatusCode)
            {
                await ShowApiError(response, "حذف دستور کار انجام نشد.");
                return;
            }
            if (detail?.Id == order.Id) detail = null;
            expanded.Remove(order.Id);
            Toast.Success("دستور کار حذف شد.");
            await LoadAll();
            await LoadCal();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { busy = false; }
    }

