    // ================== رنگ‌بندی مهلت (بند ۱۱ و ۱۲) ==================
    private string Tone(WoItem w)
    {
        var allDone = w.Assignees.Count > 0 && w.Assignees.All(a => a.Done == true);
        if (allDone)
        {
            // بند ۱۲: ملاک، زمان «پاسخ» است نه زمان تایید دستوردهنده
            var lastReply = w.Assignees.Max(a => a.RepliedAt) ?? DateTime.MaxValue;
            return lastReply <= w.DueAt ? "ontime" : "latedone";
        }
        if (w.Status == "Closed") return "none";
        if (w.DueAt < DateTime.Now && w.DueAt.Date != DateTime.Today) return "late";
        if (w.DueAt.Date == DateTime.Today) return DateTime.Now > w.DueAt ? "late" : "today";
        return "none";
    }

