    /// <summary>خواندن پیام خطای API (بدنهٔ { message }) برای نمایش به کاربر.</summary>
    private static async Task<string> ReadApiErrorAsync(HttpResponseMessage resp)
    {
        var fallback = $"خطای سرور (کد {(int)resp.StatusCode})";
        try
        {
            var body = await resp.Content.ReadAsStringAsync();
            if (string.IsNullOrWhiteSpace(body)) return fallback;
            using var doc = System.Text.Json.JsonDocument.Parse(body);
            if (doc.RootElement.TryGetProperty("message", out var m) && !string.IsNullOrWhiteSpace(m.GetString()))
                return m.GetString()!;
        }
        catch { /* بدنه JSON نبود */ }
        return fallback;
    }

    /// <summary>درصد ایمن برای ارتفاع/عرض نمودار (۰ تا ۱۰۰).</summary>
    private static int Pct(int value, int max)
        => max <= 0 || value <= 0 ? 0 : (int)Math.Round(Math.Min(100, value * 100.0 / max));

    /// <summary>نرخ انجام به‌موقع از کل دستورهای بسته‌شده.</summary>
    private int DoneRate
    {
        get
        {
            if (stats is null) return 0;
            var done = stats.Cards.DoneOnTime + stats.Cards.DoneLate;
            var closed = done + stats.Cards.ClosedNoDone;
            return closed == 0 ? 0 : (int)Math.Round(stats.Cards.DoneOnTime * 100.0 / closed);
        }
    }

