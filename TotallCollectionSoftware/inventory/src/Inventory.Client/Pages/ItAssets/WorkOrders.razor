    /// <summary>باز کردن فرم ایجاد از یک مبدأ (سورس) — پیش‌پُرش عنوان/شرح/گیرندگان از نامه.</summary>
    private async Task OpenFromSourceAsync(string module, int sourceId, int? sourceRefId = null)
    {
        if (!access.CanCreate)
        {
            Toast.Error("شما مجوز ایجاد دستور کار را ندارید.");
            return;
        }
        _sourceModule = module; _sourceId = sourceId; _sourceRefId = sourceRefId; _sourceLabel = module; _sourceDocTitle = "";
        // فقط برای نامه داخلی، جزئیات نامه را می‌گیریم تا فرم پیش‌پُر شود
        if (module == "InnerLetter")
        {
            try
            {
                var letter = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.InnerLetterDetailDto>($"/api/letters/{sourceId}");
                if (letter != null)
                {
                    _sourceLabel = $"نامه # {letter.LetterNumber}";

                    // سرصفحهٔ نامه + متن نامه به‌صورت HTML امن: اگر متن با ویرایشگر غنی نوشته
                    // شده باشد قالب سبکش حفظ می‌شود، و اگر متن ساده یا escape‌شده باشد به
                    // پاراگراف خوانا تبدیل می‌شود — همان قاعدهٔ نامهٔ وارده/صادره تا هیچ‌وقت
                    // تگ خام (‎&lt;p&gt;‎) در شرح دستور کار دیده نشود.
                    var sbInner = new System.Text.StringBuilder();
                    sbInner.Append("<p><b>نامهٔ داخلی: ")
                           .Append(System.Net.WebUtility.HtmlEncode(letter.Title))
                           .Append("</b>");
                    if (!string.IsNullOrWhiteSpace(letter.LetterNumber))
                        sbInner.Append(" — شماره: ").Append(System.Net.WebUtility.HtmlEncode(letter.LetterNumber));
                    if (!string.IsNullOrWhiteSpace(letter.SenderName))
                        sbInner.Append(" — فرستنده: ").Append(System.Net.WebUtility.HtmlEncode(letter.SenderName));
                    if (letter.DateSabt != default)
                        sbInner.Append(" — تاریخ: ").Append(letter.DateSabt.ToFaDate());
                    sbInner.Append("</p>");
                    if (!string.IsNullOrWhiteSpace(letter.Text))
                        // نامهٔ داخلی هم اگر تصویر درون‌متن داشته باشد (مثلاً چسبانده‌شده)
                        // حفظ می‌شود؛ بودجهٔ حجم مانع شرح‌های چندمگابایتی می‌شود.
                        sbInner.Append(Inventory.Client.Extensions.HtmlText.ToDisplayHtmlWithinBudget(letter.Text));

                    await ShowNewFormAsync(letter.Title, sbInner.ToString());

                    // پیش‌انتخاب گیرندگانِ گردش نامه (گیرنده/ارجاع/هامش) — قابل ویرایش/حذف
                    foreach (var u in letter.ReciversGirande) selTargets.Add(u.UserId);
                    foreach (var u in letter.ReciversErja) selTargets.Add(u.UserId);
                    foreach (var u in letter.ReciversHamesh) selTargets.Add(u.UserId);
                    AugmentTargets(letter);
                }
                else await ShowNewFormAsync("", "");
            }
            catch (Exception ex)
            {
                Toast.Error($"بارگذاری نامه ناموفق بود: {ex.Message}");
                await ShowNewFormAsync("", "");
            }
        }
        else if (module == "IncomingLetter" || module == "IncomingLetters")
        {
            // پیش‌پُرش فرم از «نامهٔ وارده»: عنوان، متن (شرح نامه + مبدأ/شماره/تاریخ) و
            // گیرندگانِ گردش نامه. پیش‌تر این حالت به شاخهٔ else می‌افتاد و فرم خالی باز
            // می‌شد؛ یعنی «دکمهٔ دستورکار» از جزئیات نامهٔ وارده عملاً چیزی را پر نمی‌کرد.
            try
            {
                var letter = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.IncomingLetterDetailDto>(
                    $"/api/incoming-letters/{sourceId}");
                if (letter != null)
                {
                    _sourceLabel = string.IsNullOrWhiteSpace(letter.NumberLetterVarede)
                        ? $"نامهٔ وارده {letter.NumberSabt}"
                        : $"نامهٔ وارده {letter.NumberLetterVarede}";

                    var sb = new System.Text.StringBuilder();
                    sb.Append("<p><b>نامهٔ وارده: ")
                      .Append(System.Net.WebUtility.HtmlEncode(letter.Title))
                      .Append("</b>");
                    if (!string.IsNullOrWhiteSpace(letter.Ferestande))
                        sb.Append(" — فرستنده: ").Append(System.Net.WebUtility.HtmlEncode(letter.Ferestande));
                    if (!string.IsNullOrWhiteSpace(letter.NumberLetterVarede))
                        sb.Append(" — شمارهٔ مبدأ: ").Append(System.Net.WebUtility.HtmlEncode(letter.NumberLetterVarede));
                    if (letter.Date != default)
                        sb.Append(" — تاریخ نامه: ").Append(letter.Date.ToFaDate());
                    sb.Append(" — شمارهٔ اندیکاتور: ").Append(letter.NumberSabt);
                    sb.Append("</p>");
                    if (!string.IsNullOrWhiteSpace(letter.Description))
                    {
                        // شرح نامهٔ وارده (و بدنهٔ ایمیلی که از آن ساخته شده) خودش HTML است.
                        //
                        // باگ گزارش‌شده: «تصویر نامه در شرح دستور کار قرار نمی‌گیرد». دلیلش
                        // این بود که ToSafeHtml اول HTML را به «متن ساده» تبدیل می‌کند و
                        // تگ <img> را کامل دور می‌ریزد؛ برای نامهٔ ساخته‌شده از ایمیل،
                        // تصویر به‌صورت data URI داخل همان متن است و باید حفظ شود.
                        // حالا با ToDisplayHtml قالب و تصاویر حفظ می‌شوند (تگ‌های خطرناک
                        // حذف می‌شوند) و اگر حجم از بودجه بیشتر شد، بزرگ‌ترین تصاویر حذف
                        // و یادداشت «تصاویر در پیوست‌های نامه» اضافه می‌شود.
                        sb.Append(Inventory.Client.Extensions.HtmlText.ToDisplayHtmlWithinBudget(letter.Description));
                    }

                    await ShowNewFormAsync(letter.Title, sb.ToString());

                    // گیرندگان: همهٔ افراد حاضر در گردش نامه (گیرنده/ارجاع/هامش)، بدون خودم
                    var crew = letter.Erjas.Where(e => e.ReciverUserId > 0)
                                           .Select(e => (Id: e.ReciverUserId, Name: e.ReciverName))
                                           .GroupBy(x => x.Id).Select(g => g.First()).ToList();
                    foreach (var u in crew.Where(x => x.Id != access.UserId))
                        selTargets.Add(u.Id);
                    var known = targets.Select(t => t.Id).ToHashSet();
                    foreach (var u in crew.Where(x => !known.Contains(x.Id)))
                        targets.Add(new TargetOpt { Id = u.Id, Username = string.IsNullOrWhiteSpace(u.Name) ? $"کاربر {u.Id}" : u.Name });
                }
                else await ShowNewFormAsync("", "");
            }
            catch (Exception ex)
            {
                Toast.Error($"بارگذاری نامهٔ وارده ناموفق بود: {ex.Message}");
                await ShowNewFormAsync("", "");
            }
        }
        else if (module == "OutgoingLetter" || module == "OutgoingLetters")
        {
            // همان قاعده برای «نامهٔ صادره» (یکسان‌سازی سه نوع نامه): عنوان، متن و افراد گردش/رونوشت.
            try
            {
                var letter = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.OutgoingLetterDetailDto>(
                    $"/api/outgoing-letters/{sourceId}");
                if (letter != null)
                {
                    _sourceLabel = $"نامهٔ صادره {letter.LetterNumber}";

                    var sb = new System.Text.StringBuilder();
                    sb.Append("<p><b>نامهٔ صادره: ")
                      .Append(System.Net.WebUtility.HtmlEncode(letter.Title))
                      .Append("</b>");
                    if (!string.IsNullOrWhiteSpace(letter.ReceiverOrganization))
                        sb.Append(" — گیرنده: ").Append(System.Net.WebUtility.HtmlEncode(letter.ReceiverOrganization));
                    if (!string.IsNullOrWhiteSpace(letter.LetterNumber))
                        sb.Append(" — شماره: ").Append(System.Net.WebUtility.HtmlEncode(letter.LetterNumber));
                    sb.Append("</p>");
                    if (!string.IsNullOrWhiteSpace(letter.Text))
                        sb.Append(Inventory.Client.Extensions.HtmlText.ToDisplayHtmlWithinBudget(letter.Text));

                    await ShowNewFormAsync(letter.Title, sb.ToString());

                    var crew = letter.ReciversGirande.Concat(letter.ReciversErja).Concat(letter.ReciversHamesh)
                                    .Concat(letter.Signers.Select(sg => new Inventory.Shared.Dtos.LetterReciverDto
                                    { UserId = sg.UserId, FullName = string.IsNullOrWhiteSpace(sg.DisplayName) ? sg.UserName : sg.DisplayName }))
                                    .Where(x => x.UserId > 0)
                                    .Select(x => (Id: x.UserId, Name: x.FullName))
                                    .GroupBy(x => x.Id).Select(g => g.First()).ToList();
                    foreach (var u in crew.Where(x => x.Id != access.UserId))
                        selTargets.Add(u.Id);
                    var known = targets.Select(t => t.Id).ToHashSet();
                    foreach (var u in crew.Where(x => !known.Contains(x.Id)))
                        targets.Add(new TargetOpt { Id = u.Id, Username = string.IsNullOrWhiteSpace(u.Name) ? $"کاربر {u.Id}" : u.Name });
                }
                else await ShowNewFormAsync("", "");
            }
            catch (Exception ex)
            {
                Toast.Error($"بارگذاری نامهٔ صادره ناموفق بود: {ex.Message}");
                await ShowNewFormAsync("", "");
            }
        }
        else if (module == "Document")
        {
            // پیش‌پُرش فرم ایجاد از مدرک آرشیو اسناد
            try
            {
                var doc = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.DocumentDto>($"/api/doc-archive/documents/{sourceId}");
                if (doc != null)
                {
                    _sourceLabel = $"مدرک {doc.Code}";
                    _sourceDocTitle = doc.Title;
                    var title = $"دستور کار مدرک {doc.Code} — {doc.Title}";
                    var sb = new System.Text.StringBuilder();
                    sb.Append($"<p>مدرک مبدأ: <b>{System.Net.WebUtility.HtmlEncode(doc.Code)} — {System.Net.WebUtility.HtmlEncode(doc.Title)}</b>");
                    if (!string.IsNullOrWhiteSpace(doc.CustomerCode))
                        sb.Append($" (مشتری: {System.Net.WebUtility.HtmlEncode(doc.CustomerCode)})");
                    sb.Append("</p>");
                    if (!string.IsNullOrWhiteSpace(doc.Description))
                        // مثل نامهٔ وارده/صادره: قالب و تصویر مدرک حفظ می‌شود (ToSafeHtml
                        // همهٔ تگ‌ها از جمله <img> را دور می‌ریخت).
                        sb.Append(Inventory.Client.Extensions.HtmlText.ToDisplayHtmlWithinBudget(doc.Description));
                    await ShowNewFormAsync(title, sb.ToString());
                }
                else await ShowNewFormAsync("", "");
            }
            catch (Exception ex)
            {
                Toast.Error($"بارگذاری مدرک ناموفق بود: {ex.Message}");
                await ShowNewFormAsync("", "");
            }
        }
        else if (module == "MeetingMinutes" || module == "MeetingMinutesItem")
        {
            var minId = module == "MeetingMinutes" ? sourceId : (sourceRefId ?? sourceId);
            Inventory.Shared.Dtos.MinutesDetailDto? mDetail = null;
            try { mDetail = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.MinutesDetailDto>($"/api/meeting-minutes/{minId}"); } catch { }
            if (mDetail != null)
            {
                _sourceDocTitle = mDetail.Title;
                if (module == "MeetingMinutesItem")
                {
                    var item = mDetail.Items.FirstOrDefault(i => i.Id == sourceId);
                    var itemNo = item?.RowNo ?? 1;
                    var t = $"پیگیری بند {itemNo} صورتجلسه «{mDetail.Title}»";
                    var d = $"<p><b>مربوط به بند {itemNo} صورتجلسه «{mDetail.Title}» مورخ {mDetail.MeetingDate:yyyy/MM/dd}:</b></p>" +
                            $"<p>{item?.Description}</p>";
                    await ShowNewFormAsync(t, d);
                    if (item?.ResponsibleUserId != null) selTargets = new() { item.ResponsibleUserId.Value };
                    else if (item?.FollowUpUserId != null) selTargets = new() { item.FollowUpUserId.Value };
                    if (item?.DueDate != null)
                    {
                        var targetDue = item.DueDate.Value.Date.AddHours(17);
                        if (targetDue > DateTime.Now)
                        {
                            newDueDate = targetDue.Date;
                            newDueTime = new TimeOnly(17, 0);
                        }
                    }
                    _sourceLabel = $"صورتجلسه «{mDetail.Title}» — بند {itemNo}";
                }
                else
                {
                    var t = $"پیگیری مصوبات صورتجلسه «{mDetail.Title}»";
                    var sb = new System.Text.StringBuilder();
                    sb.Append($"<p><b>پیگیری مصوبات صورتجلسه «{mDetail.Title}» مورخ {mDetail.MeetingDate:yyyy/MM/dd}:</b></p><ul>");
                    foreach (var itm in mDetail.Items)
                        sb.Append($"<li>بند {itm.RowNo}: {itm.Description}</li>");
                    sb.Append("</ul>");
                    await ShowNewFormAsync(t, sb.ToString());
                    selTargets = mDetail.Participants.Where(p => p.Kind == "Attendee").Select(p => p.UserId).ToHashSet();
                    _sourceLabel = $"صورتجلسه «{mDetail.Title}»";
                }
            }
            else
            {
                await ShowNewFormAsync(module == "MeetingMinutes" ? $"صورتجلسه {sourceId}" : $"بند صورتجلسه {sourceId}", "");
            }
        }
        else
        {
            await ShowNewFormAsync("", "");
        }
        StateHasChanged();
    }

