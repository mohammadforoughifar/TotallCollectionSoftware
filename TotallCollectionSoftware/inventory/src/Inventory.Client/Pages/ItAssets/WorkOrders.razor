    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("دستور کار");
        if (!string.IsNullOrWhiteSpace(Auth.Token))
            Http.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", Auth.Token);
        apiBase = Http.BaseAddress?.ToString().TrimEnd('/') ?? "";

        try { access = await Http.GetFromJsonAsync<AccessInfo>("/api/workorders/my-access") ?? new(); } catch { }
        await LoadMyTags(); // چیپ‌های فیلتر برچسب از سرور (پایدار، مستقل از صفحه)
        await LoadAll();
        // دسترسیِ لینک نامه در دستورکارهای متصل به نامه: اگر دادهٔ قبلی گیرندهٔ نامه را در گردش
        // نداشته باشد، یک‌بار (idempotent) ردیف ارجاع ساخته می‌شود تا کلیک روی لینک نامه ۴۰۳ ندهد.
        _ = SyncLetterFlowAsync();

        var now = DateTime.Now;
        calYear = pc.GetYear(now); calMonth = pc.GetMonth(now);
        RecalcCal();
        loading = false;

        Rt.DataChanged += OnRtChanged;
        await Rt.EnsureStartedAsync(apiBase, access.UserId);
        await TryOpenFromQuery();
        Nav.LocationChanged += OnLocChanged;
    }

    private async void OnRtChanged(string scope)
    {
        if (scope != "workorders") return;
        await LoadAll();
        if (tab == "calendar") await LoadCal();
        await InvokeAsync(StateHasChanged);
    }

    private async void OnLocChanged(object? s, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        await TryOpenFromQuery();
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Rt.DataChanged -= OnRtChanged;
        Nav.LocationChanged -= OnLocChanged;
    }

    private async Task TryOpenFromQuery()
    {
        // محافظ مسیر: این متد روی هر LocationChanged هم فراخوان می‌شود (حین ناوبری
        // به صفحات دیگر، پیش از از بار رفتن کامپوننت). فقط زمانی که URL همان صفحهٔ
        // دستور کار است به ?open= واکنش نشان بده؛ وگرنه مثلاً کلیک روی اعلان نامه
        // (incoming-letters?open=7) با شناسهٔ نامه، دستورِکار اشتباهی را باز و
        // خطای «دستور کار در دسترس نیست» را می‌سازد.
        var rel = Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/');
        if (!rel.Equals("work-orders", StringComparison.OrdinalIgnoreCase)) return;
        var qs = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        if (qs["tab"] == "calendar" && tab != "calendar") { tab = "calendar"; await LoadCal(); }
        // باز شدن مستقیم تب آمار با لینک (مثلاً از داشبورد) هم باید داده‌ها را بارگذاری کند.
        if (qs["tab"] == "stats" && tab != "stats") { tab = "stats"; await LoadStats(); }

        // باز کردن فرم «دستور کار جدید» برای یک پروژه کاری (از صفحه پروژه‌ها)
        if (int.TryParse(qs["projectId"], out var preProjectId) && preProjectId > 0 && !_sourceHandled)
        {
            _sourceHandled = true;
            await OpenNewForProjectAsync(preProjectId);
            return;
        }

        // باز کردن فرم «دستور کار جدید» از یک مبدأ (سورس) — مثلاً تبدیل نامه به دستور کار
        var srcModule = qs["sourceModule"];
        if (!string.IsNullOrWhiteSpace(srcModule) && int.TryParse(qs["sourceId"], out var srcId) && srcId > 0 && !_sourceHandled)
        {
            _sourceHandled = true;
            int? srcRefId = int.TryParse(qs["sourceRefId"], out var sref) && sref > 0 ? sref : null;
            await OpenFromSourceAsync(srcModule, srcId, srcRefId);
            return;
        }

        if (!int.TryParse(qs["open"], out var id) || id <= 0) return;
        await OpenById(id);
    }

    private async Task OpenById(int id)
    {
        try
        {
            var response = await Http.GetAsync($"/api/workorders/{id}");
            if (!response.IsSuccessStatusCode)
            {
                Toast.Error(response.StatusCode == System.Net.HttpStatusCode.Forbidden
                    ? "دسترسی به این دستور کار مجاز نیست."
                    : "دستور کار در دسترس نیست.");
                return;
            }
            var w = await response.Content.ReadFromJsonAsync<WoItem>();
            if (w == null) return;
            await OpenDetail(w);
        }
        catch { Toast.Error("دریافت دستور کار انجام نشد."); }
    }

    private async Task<WorkOrderPage> LoadWorkOrderPage(string endpoint, CancellationToken ct = default)
    {
        var qs = $"page={page}&pageSize={PageSize}";
        if (!string.IsNullOrWhiteSpace(fltQ)) qs += $"&Q={Uri.EscapeDataString(fltQ.Trim())}";
        if (fltPriority >= 0) qs += $"&Priority={fltPriority}";
        if (!string.IsNullOrWhiteSpace(fltTag)) qs += $"&Tag={Uri.EscapeDataString(fltTag)}";
        if (fltProject > 0) qs += $"&ProjectId={fltProject}";
        if (!string.IsNullOrEmpty(fltDecision)) qs += $"&Decision={fltDecision}";
        return await Http.GetFromJsonAsync<WorkOrderPage>($"/api/workorders/{endpoint}?{qs}", ct) ?? new();
    }

    /// <summary>
    /// بارگذاری فهرست پس از تغییر فیلتر — <b>فقط تبی که دیده می‌شود</b> (به‌جای سه تب).
    /// <para>
    /// چرا: پیش‌تر هر تغییر فیلتر سه درخواست سنگین (mine/assigned/archive) می‌فرستاد و
    /// کاربر فقط یکی را می‌دید؛ با چند هزار دستور کار، همین باعث کندی و «هنگ» می‌شد.
    /// شمارندهٔ تب‌ها از اندپوینت سبک counts می‌آید و به این سه درخواست وابسته نیست.
    /// </para>
    /// </summary>
    private async Task LoadPagesAsync(int version, CancellationToken ct)
    {
        try
        {
            var needMine = tab is "mine" or "kanban";
            var needAssigned = tab is "assigned" or "kanban";
            var needArchive = tab == "archive";

            if (needMine)
            {
                var m = await LoadWorkOrderPage("mine", ct);
                if (version != filterVersion) return; // نتیجهٔ منسوخ
                mineItems = m.Items; mineTotal = m.TotalCount;
            }
            if (needAssigned)
            {
                var a = await LoadWorkOrderPage("assigned", ct);
                if (version != filterVersion) return;
                assignedItems = a.Items; assignedTotal = a.TotalCount;
            }
            if (needArchive)
            {
                var ar = await LoadWorkOrderPage("archive", ct);
                if (version != filterVersion) return;
                archiveItems = ar.Items; archiveTotal = ar.TotalCount;
            }

            // اگر با فیلتر جدید، صفحهٔ جاری از محدوده بیرون افتاد، به آخرین صفحهٔ موجود برو
            if (page > TotalPages)
            {
                page = TotalPages;
                await ReloadActiveTabAsync(version, ct);
            }

            // شمارندهٔ تب‌ها (سطر دستور کار، بدون فیلتر) — سبک و مستقل
            await LoadTabCountsAsync();
        }
        // لغوِ خودمان (درخواست تازه‌تر جایش را گرفت) خطا نیست؛ ولی تایم‌اوت شبکه باید دیده شود
        catch (OperationCanceledException) when (ct.IsCancellationRequested) { }
        catch (Exception ex) { if (version == filterVersion) Toast.Error(ex.Message); }
    }

    /// <summary>بارگذاری دوبارهٔ فقط تب فعال (بعد از اصلاح شمارهٔ صفحه).</summary>
    private async Task ReloadActiveTabAsync(int version, CancellationToken ct)
    {
        var endpoint = tab switch { "assigned" => "assigned", "archive" => "archive", _ => "mine" };
        var r = await LoadWorkOrderPage(endpoint, ct);
        if (version != filterVersion) return;
        switch (endpoint)
        {
            case "assigned": assignedItems = r.Items; assignedTotal = r.TotalCount; break;
            case "archive": archiveItems = r.Items; archiveTotal = r.TotalCount; break;
            default: mineItems = r.Items; mineTotal = r.TotalCount; break;
        }
    }

    /// <summary>
    /// شمارندهٔ تب‌ها از اندپوینت اختصاصی خوانده می‌شود که در سرور
    /// «تعداد سطر دستور کار» را برمی‌گرداند (COUNT روی جدول دستور کار).
    /// قبلاً با pageSize=1 خوانده می‌شد؛ نتیجه یکی بود، ولی سه درخواست اضافه می‌فرستاد.
    /// مهم: این عدد هرگز از تعداد گیرندگان یا پاسخ‌ها گرفته نمی‌شود.
    /// </summary>
    private async Task LoadTabCountsAsync()
    {
        try
        {
            var c = await Http.GetFromJsonAsync<WorkOrderCounts>("/api/workorders/counts");
            if (c == null) return;
            mineAll = c.Mine; assignedAll = c.Assigned; archiveAll = c.Archive;
        }
        catch { /* شمارنده کمکی است؛ خطای آن فهرست را مختل نمی‌کند */ }
    }

    /// <summary>
    /// همگام‌سازی یک‌بارهٔ دسترسی به نامه برای دستورکارهای متصل به نامه (بدون بلاک‌کردن بارگذاری صفحه).
    /// </summary>
    private async Task SyncLetterFlowAsync()
    {
        try { await Http.PostAsync("/api/workorders/letter-flow/sync", null); }
        catch { /* همگام‌سازی کمکی است؛ خطای آن نباید صفحه را مختل کند */ }
    }

    private async Task LoadAll()
    {
        try
        {
            var m = await LoadWorkOrderPage("mine"); mineItems = m.Items; mineTotal = m.TotalCount;
            var a = await LoadWorkOrderPage("assigned"); assignedItems = a.Items; assignedTotal = a.TotalCount;
            var ar = await LoadWorkOrderPage("archive"); archiveItems = ar.Items; archiveTotal = ar.TotalCount;

            // اگر با فیلتر/بایگانی، صفحهٔ جاری از محدوده بیرون افتاد (مثلاً آخرین صفحه خالی شد)
            // خودکار به آخرین صفحهٔ موجود می‌رویم تا کاربر با فهرست خالی گیر نکند.
            if (page > TotalPages)
            {
                page = TotalPages;
                var m2 = await LoadWorkOrderPage("mine"); mineItems = m2.Items; mineTotal = m2.TotalCount;
                var a2 = await LoadWorkOrderPage("assigned"); assignedItems = a2.Items; assignedTotal = a2.TotalCount;
                var ar2 = await LoadWorkOrderPage("archive"); archiveItems = ar2.Items; archiveTotal = ar2.TotalCount;
            }

            // شمارندهٔ تب‌ها همیشه از سرور و «سطری» خوانده می‌شود؛ نه از نتیجهٔ فیلتر و نه
            // از تعداد گیرندگان. هر دستور کار = یک عدد، هر چند گیرنده داشته باشد.
            await LoadTabCountsAsync();
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
    }

    private async Task GoToPage(int target)
    {
        if (target < 1 || target > TotalPages || target == page) return;
        page = target;
        ScheduleFilterLoad(immediate: true); // فقط تب فعال دوباره خوانده می‌شود
    }

    private void SwitchTab(string t)
    {
        tab = t; page = 1;
        // برچسب‌های هر تب متفاوت‌اند؛ فیلتر برچسب پاک می‌شود (بقیهٔ فیلترها می‌مانند).
        fltTag = null;
        if (t == "calendar") { _ = LoadCal(); return; }
        if (t == "stats") { _ = LoadStats(); return; }
        if (t == "perf") { _ = LoadPerf(); return; }
        if (t == "guide") return;
        // فهرست فقط برای همین تب از سرور خوانده می‌شود (نه هر سه تب).
        ScheduleFilterLoad(immediate: true);
    }

