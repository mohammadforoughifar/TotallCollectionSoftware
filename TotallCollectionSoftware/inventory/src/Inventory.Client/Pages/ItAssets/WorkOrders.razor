    private void AddProjectMembersToTargets()
    {
        var known = targets.Select(t => t.Id).ToHashSet();
        var added = 0; var skipped = 0;
        foreach (var uid in selProjectMemberIds)
        {
            if (selTargets.Contains(uid)) continue;
            if (!known.Contains(uid)) { skipped++; continue; }
            selTargets.Add(uid); added++;
        }
        if (skipped > 0) Toast.Info($"{skipped} عضو پروژه در لیست مجاز شما نیست و اضافه نشد.");
        else if (added == 0) Toast.Info("همه اعضای پروژه از قبل در گیرندگان هستند.");
    }

