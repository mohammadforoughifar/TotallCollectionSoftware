@namespace Inventory.Client.Pages
@page "/work-orders"
@using System.Net.Http.Headers
@using System.Globalization
@using Inventory.Shared.Dtos
@inject HttpClient Http
@inject IAuthState Auth
@inject IToastService Toast
@inject IJSRuntime JS
@inject LayoutState Layout
@inject NavigationManager Nav
@inject RealtimeService Rt
@implements IDisposable

<PageTitle>دستور کار</PageTitle>

<div class="page-head wo-page-head">
    <div>
        <h1>دستور کار و وظایف</h1>
    </div>
    @if (access.CanCreate && tab != "guide")
    {
        <button class="btn btn-primary wo-page-action" @onclick="OpenNew">
            <i class="bi bi-plus-lg"></i> دستور کار جدید
        </button>
    }
</div>

@* ================== تب‌ها ================== *@
<div class="wo-tabs mb-3">
    @* شمارندهٔ هر تب = «تعداد سطر دستور کار» (هر دستور کار یک عدد)، نه تعداد گیرندگان آن دستورها. *@
    <button class="wo-tab @(tab == "mine" ? "active" : "")" @onclick='() => SwitchTab("mine")'
            title="تعداد سطر دستور کار — هر دستور کار یک عدد، مستقل از تعداد گیرندگان">
        <i class="bi bi-send"></i> دستورهای من <span class="wo-tab-badge">@mineAll</span>
    </button>
    <button class="wo-tab @(tab == "assigned" ? "active" : "")" @onclick='() => SwitchTab("assigned")'
            title="تعداد سطر دستور کار — هر دستور کار یک عدد، مستقل از تعداد گیرندگان">
        <i class="bi bi-inbox"></i> محول به من <span class="wo-tab-badge">@assignedAll</span>
    </button>
    <button class="wo-tab @(tab == "archive" ? "active" : "")" @onclick='() => SwitchTab("archive")'
            title="تعداد سطر دستور کار — هر دستور کار یک عدد، مستقل از تعداد گیرندگان">
        <i class="bi bi-archive"></i> بایگانی <span class="wo-tab-badge">@archiveAll</span>
    </button>
    <button class="wo-tab @(tab == "kanban" ? "active" : "")" @onclick='() => SwitchTab("kanban")'>
        <i class="bi bi-kanban"></i> کانبان
    </button>
    <button class="wo-tab @(tab == "calendar" ? "active" : "")" @onclick='() => SwitchTab("calendar")'>
        <i class="bi bi-calendar3"></i> تقویم
    </button>
    <button class="wo-tab @(tab == "perf" ? "active" : "")" @onclick='() => SwitchTab("perf")'>
        <i class="bi bi-trophy"></i> عملکرد افراد
    </button>
    <button class="wo-tab @(tab == "stats" ? "active" : "")" @onclick='() => SwitchTab("stats")'>
        <i class="bi bi-bar-chart"></i> داشبورد
    </button>
    <button class="wo-tab @(tab == "guide" ? "active" : "")" @onclick='() => SwitchTab("guide")'>
        <i class="bi bi-journal-check"></i> راهنما
    </button>
</div>

@* ================== نوار جستجو و فیلتر ================== *@
@if (!loading && tab != "calendar" && tab != "stats" && tab != "kanban" && tab != "perf" && tab != "guide")
{
    <div class="wo-filterbar mb-3">
        <div class="wo-flt-search">
            <i class="bi bi-search"></i>
            <input class="form-control form-control-sm" placeholder="جستجو در شماره، عنوان یا دستوردهنده..."
                   value="@fltQ" @oninput="OnSearchInput" />
            @if (!string.IsNullOrWhiteSpace(fltQ))
            {
                <button class="wo-flt-clear" title="پاک کردن" @onclick="ClearSearch"><i class="bi bi-x-lg"></i></button>
            }
        </div>
        <div class="wo-pr-group wo-flt-pr">
            <button type="button" class="wo-pr-btn @(fltPriority == -1 ? "active" : "")"
                    @onclick="() => SetPriorityFilter(-1)">همه</button>
            @foreach (var (val, fa) in PriorityOpts)
            {
                var v2 = val;
                <button type="button" class="wo-pr-btn wo-pr-@v2 @(fltPriority == v2 ? "active" : "")"
                        @onclick="() => SetPriorityFilter(v2)">@fa</button>
            }
        </div>
        <div class="wo-pr-group wo-flt-dec" title="فیلتر بر اساس تصمیم دستوردهنده روی پاسخ گیرندگان">
            <button type="button" class="wo-pr-btn @(string.IsNullOrEmpty(fltDecision) ? "active" : "")"
                    @onclick='() => SetDecisionFilter(null)'>همه</button>
            <button type="button" class="wo-pr-btn wo-dec-approved @(fltDecision == "approved" ? "active" : "")"
                    title="دستورهایی که حداقل یک پاسخ را تأیید کرده‌اند"
                    @onclick='() => SetDecisionFilter("approved")'>✔ تأییدشده</button>
            <button type="button" class="wo-pr-btn wo-dec-rejected @(fltDecision == "rejected" ? "active" : "")"
                    title="دستورهایی که حداقل یک پاسخ را رد کرده‌اند"
                    @onclick='() => SetDecisionFilter("rejected")'>✖ ردشده</button>
            <button type="button" class="wo-pr-btn wo-dec-pending @(fltDecision == "undecided" ? "active" : "")"
                    title="گیرنده پاسخ داده ولی دستوردهنده هنوز تأیید/رد نکرده است"
                    @onclick='() => SetDecisionFilter("undecided")'>… بی‌تصمیم</button>
            <button type="button" class="wo-pr-btn wo-dec-awaiting @(fltDecision == "awaiting" ? "active" : "")"
                    title="گیرنده دارد ولی هنوز هیچ پاسخی ثبت نشده است"
                    @onclick='() => SetDecisionFilter("awaiting")'>⏳ در انتظار پاسخ</button>
        </div>
        <div class="wo-flt-project" style="min-width:210px">
            <SearchSelect Items="fltProjectOpts" Value="fltProject" ValueChanged="(int v) => SetProjectFilter(v)"
                          SearchChanged="OnFltProjectSearch" RemoteSearch="true"
                          Placeholder="🏗 فیلتر پروژه…" CssClass="form-select-sm" />
        </div>
        @if (TagOptions.Any() || !string.IsNullOrWhiteSpace(fltTag))
        {
            <div class="d-flex gap-1 flex-wrap align-items-center">
                <i class="bi bi-tags text-muted fs-8"></i>
                @* چیپ برچسب فعال همیشه دیده می‌شود — حتی اگر در فهرست پرکاربردها نباشد،
                   وگرنه کاربر نمی‌توانست فیلتر برچسب را بردارد. *@
                @if (!string.IsNullOrWhiteSpace(fltTag) && !TagOptions.Contains(fltTag))
                {
                    <button type="button" class="wo-tag-suggest active"
                            title="برداشتن فیلتر برچسب"
                            @onclick="() => SetTagFilter(null)">@fltTag <i class="bi bi-x"></i></button>
                }
                @foreach (var t in TagOptions.Take(10))
                {
                    var t2 = t;
                    <button type="button" class="wo-tag-suggest @(fltTag == t2 ? "active" : "")"
                            title="@TagChipTitle(t2)"
                            @onclick="() => SetTagFilter(fltTag == t2 ? null : t2)">@t2</button>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(fltQ) || fltPriority >= 0 || fltTag != null || fltProject > 0 || !string.IsNullOrEmpty(fltDecision))
        {
            <span class="fs-8 text-muted d-inline-flex align-items-center gap-1">
                @if (filterBusy)
                {
                    <span class="spinner-border spinner-border-sm" style="width:.7rem;height:.7rem;border-width:.14em" title="در حال اعمال فیلتر"></span>
                }
                @TabItems.Count مورد در این صفحه · <b class="num">@CurrentTotal</b> مورد با فیلتر فعلی
            </span>
        }
        <div class="d-flex gap-1 wo-filter-actions">
            <button class="btn btn-sm btn-outline-success" title="خروجی اکسل (با فیلترهای جاری)" disabled="@exporting" @onclick='() => ExportList("xlsx")'>
                @if (exporting) { <span class="spinner-border spinner-border-sm"></span> }
                else { <i class="bi bi-file-earmark-excel"></i> }
                <span class="d-none d-sm-inline">اکسل</span>
            </button>
            <button class="btn btn-sm btn-outline-danger" title="خروجی PDF (با فیلترهای جاری)" disabled="@exporting" @onclick='() => ExportList("pdf")'>
                <i class="bi bi-file-earmark-pdf"></i>
                <span class="d-none d-sm-inline">PDF</span>
            </button>
        </div>
    </div>
}
@if ((tab == "mine" || tab == "assigned") && selectedOrders.Count > 0)
{
    <div class="alert alert-primary d-flex align-items-center gap-2 py-2 no-print">
        <b>@selectedOrders.Count مورد انتخاب شده</b>
        <button class="btn btn-sm btn-outline-primary" @onclick='() => BulkOrders("archive")'><i class="bi bi-archive"></i> بایگانی گروهی</button>
        <button class="btn btn-sm btn-outline-danger" @onclick='() => BulkOrders("delete")'><i class="bi bi-trash"></i> حذف گروهی</button>
        <button class="btn btn-sm btn-link" @onclick="() => selectedOrders.Clear()">انصراف</button>
    </div>
}

@if (loading)
{
    <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
}
else if (tab == "guide")
{
    <WorkOrdersGuide OnBack="BackFromGuide" />
}
else if (tab == "kanban")
{
    @* ================== نمای کانبان — ستون‌بندی بر اساس اولویت، درگ‌اند‌دراپ برای تغییر اولویت ================== *@
    @if (HasActiveFilter)
    {
        @* نوار فیلتر در این نما پنهان است؛ اگر فیلتری از تب قبلی مانده باشد، کارت‌ها فیلترشده‌اند
           و کاربر فکر می‌کند داده کم/اشتباه است. پس وضعیت فیلتر صریح نشان داده می‌شود. *@
        <div class="alert alert-warning d-flex align-items-center gap-2 py-2 flex-wrap">
            <i class="bi bi-funnel-fill"></i>
            <span class="fs-8">
                این نما با فیلترهای فعال نمایش داده می‌شود
                @if (!string.IsNullOrWhiteSpace(fltQ)) { <b>— جستجو: «@fltQ»</b> }
                @if (fltPriority >= 0) { <b>— اولویت: @PriorityFa(fltPriority)</b> }
                @if (!string.IsNullOrEmpty(fltDecision)) { <b>— تصمیم: @DecisionFa(fltDecision)</b> }
                @if (fltProject > 0) { <b>— پروژه: @(string.IsNullOrWhiteSpace(fltProjectName) ? "انتخاب‌شده" : fltProjectName)</b> }
                @if (!string.IsNullOrWhiteSpace(fltTag)) { <b>— برچسب: @fltTag</b> }
            </span>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllFilters">پاک کردن فیلترها</button>
        </div>
    }
    <div class="d-flex align-items-center gap-2 mb-2 flex-wrap">
        <div class="wo-pr-group">
            <button type="button" class="wo-pr-btn @(kanbanScope == "mine" ? "active" : "")" @onclick='() => kanbanScope = "mine"'>دستورهای من</button>
            <button type="button" class="wo-pr-btn @(kanbanScope == "assigned" ? "active" : "")" @onclick='() => kanbanScope = "assigned"'>محول به من</button>
        </div>

    </div>
    <div class="wo-kanban">
        @foreach (var (pv, pfa) in PriorityOpts.Reverse())
        {
            var col = pv;
            var colItems = KanbanItems.Where(w => w.Priority == col).OrderBy(w => w.DueAt).ToList();
            <div class="wo-kb-col @(kbDragOver == col ? "dragover" : "")"
                 @ondragover:preventDefault @ondragenter="() => kbDragOver = col" @ondragleave="() => kbDragOver = -1"
                 @ondrop="() => KanbanDrop(col)">
                <div class="wo-kb-head wo-kb-head-@col">
                    <span>@pfa</span>
                    <span class="wo-kb-count num">@colItems.Count</span>
                </div>
                <div class="wo-kb-body">
                    @if (colItems.Count == 0)
                    {
                        <div class="wo-kb-empty">—</div>
                    }
                    @foreach (var w in colItems)
                    {
                        var w2 = w;
                        var draggable = w2.OwnerUserId == access.UserId;
                        var overdue = w2.DueAt < DateTime.Now;
                        <div class="wo-kb-card @(overdue ? "overdue" : "") @(draggable ? "draggable" : "")"
                             draggable="@(draggable ? "true" : "false")"
                             @ondragstart="() => kbDragId = w2.Id"
                             @onclick="() => OpenDetail(w2)">
                            <div class="d-flex justify-content-between align-items-start gap-1">
                                <span class="fw-700 fs-8">@w2.Title</span>
                                <span class="fs-9 text-muted num text-nowrap">@w2.Number</span>
                            </div>
                            <div class="fs-9 text-muted mt-1 d-flex align-items-center gap-2 flex-wrap">
                                <span class="num @(overdue ? "text-danger fw-700" : "")"><i class="bi bi-clock"></i> @w2.DueAt.ToFa() @w2.DueAt.ToString("HH:mm")</span>
                                @if (w2.ChecklistTotal > 0) { <span class="num">☑ @w2.ChecklistDone/@w2.ChecklistTotal</span> }
                                @if (w2.CommentCount > 0) { <span class="num">💬 @w2.CommentCount</span> }
                                @if (w2.Children.Count > 0) { <span class="num">🔗 @w2.Children.Count(c => c.Status == "Closed")/@w2.Children.Count</span> }
                                @if (w2.Recurrence > 0) { <span>🔁</span> }
                            </div>
                            <div class="fs-9 text-muted mt-1 d-flex align-items-center gap-1">
                                <i class="bi bi-people"></i>
                                <span>@(kanbanScope == "mine" ? string.Join("، ", w2.Assignees.Select(a => a.Name)) : w2.OwnerName)</span>
                                <span class="ms-auto num">@w2.Assignees.Count(a => a.RepliedAt != null)/@w2.Assignees.Count پاسخ</span>
                            </div>
                            @if (HasRelatedOrders(w2)) { @RelatedOrderLinks(w2) }
                            @if (w2.Tags.Count > 0)
                            {
                                <div class="d-flex gap-1 flex-wrap mt-1">
                                    @foreach (var t in w2.Tags) { <span class="wo-tag wo-tag-sm">@t</span> }
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        }
    </div>
}
else if (tab == "calendar")
{
    @* ================== تقویم شمسی (بند ۱۳) — بازطراحی ================== *@
    <div class="wo-cal-card">
        <div class="wo-cal-head2">
            <div class="wo-cal-nav">
                <button class="wo-nav-btn" @onclick="() => MoveMonth(-1)"><i class="bi bi-chevron-right"></i></button>
                <div class="wo-cal-title2">
                    <div class="wo-cal-month">@MonthName(calMonth)</div>
                    <div class="wo-cal-year num">@calYear.ToString()</div>
                </div>
                <button class="wo-nav-btn" @onclick="() => MoveMonth(1)"><i class="bi bi-chevron-left"></i></button>
                <button class="wo-today-btn" @onclick="GoToday"><i class="bi bi-calendar-check"></i> امروز</button>
            </div>
            <div class="wo-cal-legend2">
                <span><i class="wo-dot wo-k-self"></i> برای خودم</span>
                <span><i class="wo-dot wo-k-others"></i> برای دیگران</span>
                <span><i class="wo-dot wo-k-mixed"></i> مشترک</span>
                <span><i class="wo-dot wo-k-assigned"></i> محول به من</span>
                <span class="wo-leg-sep"></span>
                <span><i class="bi bi-check-circle-fill" style="color:#22c55e"></i> انجام به‌موقع</span>
                <span><i class="bi bi-check-circle-fill" style="color:#a855f7"></i> با تاخیر</span>
                <span><i class="bi bi-x-circle-fill" style="color:#ef4444"></i> انجام نشده</span>
            </div>
        </div>
        <div class="wo-cal2">
            @foreach (var d in new[] { "شنبه", "یکشنبه", "دوشنبه", "سه‌شنبه", "چهارشنبه", "پنجشنبه", "جمعه" })
            {
                <div class="wo-dow2 @(d == "جمعه" ? "friday" : "")">@d</div>
            }
            @for (var i = 0; i < calOffset; i++)
            {
                <div class="wo-cell2 empty"></div>
            }
            @for (var day = 1; day <= calDays; day++)
            {
                var d2 = day;
                var g = pc.ToDateTime(calYear, calMonth, d2, 0, 0, 0, 0);
                var isToday = g.Date == DateTime.Today;
                var isFriday = g.DayOfWeek == DayOfWeek.Friday;
                var dayOrders = calItems.Where(c => c.DueAt.Date == g.Date).ToList();
                <div class="wo-cell2 @(isToday ? "today" : "") @(isFriday ? "friday" : "") @(dayOrders.Any() ? "has-items" : "")" @onclick="() => OpenDayModal(g)">
                    <div class="wo-day2">
                        <span class="num">@d2</span>
                        @if (isToday)
                        {
                            <span class="wo-today-tag">امروز</span>
                        }
                    </div>
                    @foreach (var o in dayOrders.Take(3))
                    {
                        <div class="wo-chip2 wo-k-@o.Kind.ToLower() @(o.Status == "Closed" && o.Tone is not ("ontime" or "latedone") ? "closed" : "")"
                             title="@o.Number — @o.Title" @onclick="() => OpenById(o.Id)" @onclick:stopPropagation="true">
                            @* تیک / ضربدر وضعیت — تشخیص در یک نگاه *@
                            @if (o.Tone == "ontime")
                            {
                                <i class="bi bi-check-circle-fill wo-st-ic" style="color:#22c55e"></i>
                            }
                            else if (o.Tone == "latedone")
                            {
                                <i class="bi bi-check-circle-fill wo-st-ic" style="color:#a855f7"></i>
                            }
                            else if (o.Tone == "late" || (o.Status == "Closed" && o.Tone == "closed"))
                            {
                                <i class="bi bi-x-circle-fill wo-st-ic" style="color:#ef4444"></i>
                            }
                            else if (o.Tone == "today")
                            {
                                <i class="bi bi-alarm-fill wo-st-ic" style="color:#fbbf24"></i>
                            }
                            <span class="wo-chip-txt">@o.Title</span>
                        </div>
                    }
                    @if (dayOrders.Count > 3)
                    {
                        <div class="wo-more" @onclick="() => OpenDayModal(g)">+@(dayOrders.Count - 3) مورد دیگر</div>
                    }
                </div>
            }
        </div>
    </div>
}
else if (tab == "perf")
{
    @* ================== گزارش عملکرد افراد (موج ۸) ================== *@
    <div class="d-flex align-items-center gap-2 mb-3 flex-wrap">

        <div class="wo-pr-group ms-auto">
            @foreach (var (d, fa) in PerfPeriods)
            {
                var d2 = d;
                <button type="button" class="wo-pr-btn @(perfDays == d2 ? "active" : "")"
                        @onclick="() => SetPerfPeriod(d2)">@fa</button>
            }
        </div>
        <button class="btn btn-sm btn-outline-success" disabled="@exporting" @onclick='() => ExportPerf("xlsx")'>
            <i class="bi bi-file-earmark-excel"></i> اکسل
        </button>
        <button class="btn btn-sm btn-outline-danger" disabled="@exporting" @onclick='() => ExportPerf("pdf")'>
            <i class="bi bi-file-earmark-pdf"></i> PDF
        </button>
    </div>

    @if (perfLoading)
    {
        <div class="text-center py-5"><div class="spinner-border text-primary"></div></div>
    }
    else if (perfRows.Count == 0)
    {
        <div class="text-center text-muted py-5">
            <i class="bi bi-trophy fs-1 d-block mb-2 opacity-50"></i>
            در این بازه دستوری به دیگران نداده‌اید.
        </div>
    }
    else
    {
        @* ---------- سکوی سه نفر برتر ---------- *@
        @if (perfRows.Count >= 2)
        {
            <div class="wo-podium mb-3">
                @foreach (var r in perfRows.Take(3))
                {
                    <div class="wo-podium-card wo-podium-@r.Rank">
                        <div class="wo-podium-medal">@(r.Rank == 1 ? "🥇" : r.Rank == 2 ? "🥈" : "🥉")</div>
                        <div class="fw-700">@r.Name</div>
                        <div class="fs-8 text-muted num">@r.OnTime از @r.Total به‌موقع</div>
                        <div class="wo-podium-pct num">@r.OnTimePercent٪</div>
                    </div>
                }
            </div>
        }

        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 wo-perf-table">
                        <thead>
                            <tr class="fs-8 text-muted">
                                <th style="width:52px">رتبه</th>
                                <th>نام</th>
                                <th class="text-center">دریافتی</th>
                                <th class="text-center">انجام‌شده</th>
                                <th class="text-center">به‌موقع</th>
                                <th class="text-center">با تاخیر</th>
                                <th class="text-center">انجام نشد</th>
                                <th class="text-center">در انتظار</th>
                                <th class="text-center" title="در انتظار پاسخ و گذشته از مهلت">منقضی باز</th>
                                <th class="text-center">میانگین تاخیر</th>
                                <th style="width:170px">٪ به‌موقع</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var r in perfRows)
                            {
                                <tr>
                                    <td><span class="wo-rank num @(r.Rank <= 3 ? $"wo-rank-{r.Rank}" : "")">@r.Rank</span></td>
                                    <td class="fw-600">@r.Name</td>
                                    <td class="text-center num">@r.Total</td>
                                    <td class="text-center num">@r.Done</td>
                                    <td class="text-center num text-success fw-700">@r.OnTime</td>
                                    <td class="text-center num" style="color:#a855f7">@r.DoneLate</td>
                                    <td class="text-center num text-danger">@r.NotDone</td>
                                    <td class="text-center num">@r.Pending</td>
                                    <td class="text-center num @(r.OverdueOpen > 0 ? "text-danger fw-700" : "")">@r.OverdueOpen</td>
                                    <td class="text-center num fs-8">@(r.AvgDelayHours > 0 ? DelayFa(r.AvgDelayHours) : "—")</td>
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            <div class="wo-bar-track flex-grow-1">
                                                <div class="wo-bar @(r.OnTimePercent >= 80 ? "wo-perf-good" : r.OnTimePercent >= 50 ? "wo-perf-mid" : "wo-perf-bad")"
                                                     style="width:@(r.OnTimePercent)%"></div>
                                            </div>
                                            <span class="fs-8 fw-700 num" style="width:34px">@r.OnTimePercent٪</span>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <div class="fs-9 text-muted mt-2">
            <i class="bi bi-lightbulb"></i> «میانگین تاخیر» فقط روی انجام‌های دیرهنگام محاسبه می‌شود. «منقضی باز» یعنی هنوز پاسخ نداده و مهلت گذشته است.
        </div>
    }
}
else if (tab == "stats")
{
    @* ================== داشبورد آماری — «گزارش مدیریتی» (سبک سند) ================== *@
    @if (statsError is not null)
    {
        <div class="wdr-alert">
            <span class="wdr-alert-ic">!</span>
            <div class="flex-grow-1">@statsError</div>
            <button class="wdr-btn" @onclick="LoadStats">تلاش دوباره</button>
        </div>
    }

    @if (stats == null)
    {
        <div class="wdr-loading"><div class="spinner-border text-primary"></div><div class="text-muted fs-8 mt-2">در حال محاسبهٔ آمار…</div></div>
    }
    else if (stats.Cards.Total == 0)
    {
        <div class="wo-empty"><i class="bi bi-bar-chart"></i><h5>هنوز داده‌ای برای نمایش نیست</h5>
            <div class="text-muted fs-8">با ثبت اولین دستور کار، این گزارش تکمیل می‌شود.</div></div>
    }
    else
    {
        <div class="wdr-sheet">

            @* ---------- سرصفحهٔ گزارش ---------- *@
            <div class="wdr-masthead">
                <div>
                    <div class="wdr-kicker">گزارش عملکرد · دستور کار</div>
                    <h1>خلاصهٔ مدیریتی دستور کارها</h1>
                    <div class="wdr-scope">دستورهایی که شما صادر کرده‌اید یا به شما سپرده شده‌اند · شرکت فعال</div>
                </div>
                <div class="wdr-meta">
                    <div class="num">آخرین محاسبه: @UpdatedFa</div>
                    <button type="button" class="wdr-btn" @onclick="LoadStats" disabled="@statsLoading">
                        @if (statsLoading) { <span class="spinner-border spinner-border-sm"></span> } محاسبهٔ مجدد
                    </button>
                </div>
            </div>

            @* ---------- اعداد اصلی ---------- *@
            <div class="wdr-figures">
                <div class="wdr-fig wdr-fig-hero">
                    <div class="wdr-fig-n num">@DoneRate<span class="wdr-fig-u">٪</span></div>
                    <div class="wdr-fig-t">نرخ انجام به‌موقع<br><span>از <b class="num">@ClosedTotal</b> دستور بسته‌شده</span></div>
                </div>
                <div class="wdr-fig"><div class="wdr-fig-n num">@stats.Cards.Total</div><div class="wdr-fig-t">کل دستورها</div></div>
                <div class="wdr-fig"><div class="wdr-fig-n num">@stats.Cards.Open</div><div class="wdr-fig-t">باز / در جریان</div></div>
                <div class="wdr-fig"><div class="wdr-fig-n num">@stats.Cards.DoneOnTime</div><div class="wdr-fig-t">انجام به‌موقع</div></div>
                <div class="wdr-fig"><div class="wdr-fig-n num">@stats.Cards.DoneLate</div><div class="wdr-fig-t">انجام با تاخیر</div></div>
            </div>

            @* ---------- ۰۱ وضعیت دستور کار ---------- *@
            <div class="wdr-sec">
                <span class="wdr-idx">۰۱</span><h2>وضعیت دستور کار</h2><span class="wdr-rule"></span>
                <button type="button" class="wdr-help @(showStatsHelp ? "open" : "")"
                        title="راهنمای اصطلاحات این گزارش"
                        @onclick="() => showStatsHelp = !showStatsHelp">
                    <span class="wdr-help-q">؟</span> راهنما
                </button>
            </div>
            @if (showStatsHelp)
            {
                <div class="wdr-help-pop">
                    <div class="wdr-help-pop-h">
                        <b>راهنمای اصطلاحات</b>
                        <button type="button" class="wdr-help-x" @onclick="() => showStatsHelp = false" aria-label="بستن">×</button>
                    </div>
                    <div class="wdr-help-item">
                        <b>بستهٔ بی‌نتیجه</b>
                        دستوری که توسط دستوردهنده <b>بسته/بایگانی</b> شده است، اما هیچ‌یک از گیرندگان پاسخ «انجام شد» نداده‌اند
                        (یا پاسخ نداده‌اند یا «انجام نشد» ثبت کرده‌اند). این دستورها نه «انجام‌شده» شمرده می‌شوند و نه «باز»؛
                        برای همین یک گروه جدا در ترکیب دستور کارها دارند.
                    </div>
                    <div class="wdr-help-item">
                        <b>گذشته از مهلت / مهلت امروز</b>
                        هر دو زیرمجموعهٔ دستورهای «باز» هستند و در جمع کل دوباره شمرده نمی‌شوند.
                    </div>
                    <div class="wdr-help-item">
                        <b>نرخ انجام به‌موقع</b>
                        انجام به‌موقع ÷ دستورهای بسته‌شده (به‌موقع + با تاخیر + بی‌نتیجه). «نرخ انجام» در جدول گیرندگان
                        مخرج متفاوتی دارد: انجام‌شده ÷ کل واگذاری‌ها.
                    </div>
                    <div class="wdr-help-item">
                        <b>در انتظار پاسخ</b>
                        تعداد واگذاری‌هایی که گیرنده هنوز هیچ پاسخی نداده است (نه تعداد دستور).
                    </div>
                </div>
            }
            <div class="wdr-two">
                <div class="wdr-kv-list">
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#1c1917"></i>باز و در مهلت</span>
                        <b class="num">@OpenOnly</b>
                    </div>
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#b45309"></i>گذشته از مهلت <span class="wdr-hint">زیرمجموعهٔ باز</span></span>
                        <b class="num">@OverdueCount</b>
                    </div>
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#c9a227"></i>مهلت امروز <span class="wdr-hint">زیرمجموعهٔ باز</span></span>
                        <b class="num">@stats.Cards.DueToday</b>
                    </div>
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#1f6f43"></i>انجام به‌موقع</span>
                        <b class="num">@stats.Cards.DoneOnTime</b>
                    </div>
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#7f1d1d"></i>انجام با تاخیر</span>
                        <b class="num">@stats.Cards.DoneLate</b>
                    </div>
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#a8a29e"></i>بستهٔ بی‌نتیجه</span>
                        <b class="num">@stats.Cards.ClosedNoDone</b>
                    </div>
                    <div class="wdr-kv">
                        <span class="wdr-kv-l"><i class="wdr-sq" style="background:#78716c"></i>در انتظار پاسخ <span class="wdr-hint">تعداد دستور کار</span></span>
                        <b class="num">@stats.Cards.PendingReply</b>
                    </div>
                </div>

                <div class="wdr-chart-wrap">
                    <svg viewBox="0 0 300 190" width="100%" height="190" role="img" aria-label="نمودار روند ایجاد دستورها">
                        @{
                            var rMax = Math.Max(1, stats.Months.SelectMany(m => new[] { m.Created, m.OnTime, m.Late }).DefaultIfEmpty(0).Max());
                            var step = 300.0 / Math.Max(1, stats.Months.Count);
                        }
                        <line x1="6" y1="158" x2="294" y2="158" stroke="#1c1917" stroke-width="1.2" />
                        @for (var i = 0; i < stats.Months.Count; i++)
                        {
                            var m = stats.Months[i];
                            var cx = 6 + step * i + step / 2;
                            var hC = Math.Max(2, 120.0 * m.Created / rMax);
                            var hO = Math.Max(0, 120.0 * m.OnTime / rMax);
                            var hL = Math.Max(0, 120.0 * m.Late / rMax);
                            var bw = Math.Min(26, step * 0.26);
                            <g>
                                <rect x="@(cx - bw*1.5)" y="@(158 - hC)" width="@bw" height="@hC" fill="#1c1917" />
                                <rect x="@(cx - bw*0.5)" y="@(158 - hO)" width="@bw" height="@hO" fill="#1f6f43" />
                                <rect x="@(cx + bw*0.5)" y="@(158 - hL)" width="@bw" height="@hL" fill="#7f1d1d" />
                                <text x="@cx" y="@(158 - hC - 6)" text-anchor="middle" font-size="10.5" font-weight="700" fill="#1c1917" font-family="Vazirmatn,Tahoma">@m.Created</text>
                                <text x="@cx" y="174" text-anchor="middle" font-size="9.5" fill="#8a8378" font-family="Vazirmatn,Tahoma">@MonthName(m.Month)</text>
                                <text x="@cx" y="186" text-anchor="middle" font-size="8.5" fill="#a89f92" font-family="Vazirmatn,Tahoma">@m.OnTime / @m.Late / @m.NotDone</text>
                            </g>
                        }
                    </svg>
                    <div class="wdr-chart-legend">
                        <span><i class="wdr-sq" style="background:#1c1917"></i>ایجادشده</span>
                        <span><i class="wdr-sq" style="background:#1f6f43"></i>انجام به‌موقع</span>
                        <span><i class="wdr-sq" style="background:#7f1d1d"></i>انجام با تاخیر</span>
                        <span class="wdr-chart-cap">ردیف زیر هر ماه: به‌موقع / با تاخیر / بی‌نتیجه</span>
                    </div>
                </div>
            </div>

            @* ---------- ۰۲ اولویت دستورهای باز ---------- *@
            <div class="wdr-sec"><span class="wdr-idx">۰۲</span><h2>اولویت دستورهای باز</h2><span class="wdr-rule"></span>
                <span class="wdr-sec-meta num">@stats.Cards.Open دستور باز</span></div>
            @if (!stats.ByPriority.Any())
            {
                <div class="wdr-empty">دستور بازی وجود ندارد.</div>
            }
            else
            {
                <div class="wdr-kv-list">
                    @foreach (var p in stats.ByPriority)
                    {
                        <div class="wdr-kv">
                            <span class="wdr-kv-l">@PriorityFa(p.Priority)</span>
                            <span class="wdr-mini-bar"><i style="width:@Pct(p.Count, Math.Max(1, stats.Cards.Open))%"></i></span>
                            <b class="num">@p.Count</b>
                            <span class="wdr-kv-pct num">@Pct(p.Count, Math.Max(1, stats.Cards.Open))٪</span>
                        </div>
                    }
                </div>
            }

            @* ---------- ۰۳ عملکرد گیرندگان ---------- *@
            <div class="wdr-sec"><span class="wdr-idx">۰۳</span><h2>عملکرد گیرندگان</h2><span class="wdr-rule"></span>
                <span class="wdr-sec-meta">گیرندگان دستورهایی که شما صادر کرده‌اید</span></div>
            @if (!stats.PerAssignee.Any())
            {
                <div class="wdr-empty">هنوز دستوری به دیگران واگذار نشده است.</div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="wdr-table">
                        <thead>
                            <tr>
                                <th>گیرنده</th>
                                <th class="c">کل</th>
                                <th class="c">انجام شد</th>
                                <th class="c">به‌موقع</th>
                                <th class="c">انجام نشد</th>
                                <th class="c">بی‌پاسخ</th>
                                <th class="c">نرخ انجام</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var a in stats.PerAssignee)
                            {
                                var rate = a.Total == 0 ? 0 : a.Done * 100 / a.Total;
                                <tr>
                                    <td class="wdr-who">
                                        <i class="wdr-sq" style="background:@(rate >= 80 ? "#1f6f43" : rate >= 50 ? "#b45309" : "#7f1d1d")"></i>
                                        <UserAvatar LoginUserId="a.UserId" Size="20" CssClass="user-avatar-sm" /> @a.Name
                                    </td>
                                    <td class="c num">@a.Total</td>
                                    <td class="c num">@a.Done</td>
                                    <td class="c num">@a.OnTime</td>
                                    <td class="c num">@a.NotDone</td>
                                    <td class="c num">@a.Pending</td>
                                    <td class="c num wdr-rate">@rate<span class="wdr-u">٪</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }
}
else if (!PagedItems.Any())
{
    @if (HasActiveFilter)
    {
        <div class="wo-empty">
            <i class="bi bi-funnel"></i>
            <h5>با فیلترهای فعلی موردی پیدا نشد</h5>
            <div class="fs-8 mb-3">فیلترها سمت سرور روی همهٔ دستورها اعمال می‌شوند، نه فقط همین صفحه.</div>
            <button class="btn btn-sm btn-outline-secondary" @onclick="ClearAllFilters">
                <i class="bi bi-x-circle"></i> پاک‌کردن فیلترها
            </button>
        </div>
    }
    else
    {
        <div class="wo-empty"><i class="bi bi-clipboard-x"></i><h5>دستور کاری وجود ندارد</h5></div>
    }
}
else
{
    @* ================== دیتاگرید با سطرهای بازشو (بند ۸) — دسکتاپ ================== *@
    <div class="card grid-desktop">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:44px"></th>
                            <th style="width:36px"><input type="checkbox" title="انتخاب همه" @onclick="ToggleSelectAll" /></th>
                            <th>شماره</th><th>عنوان</th>
                            @* در تب «دستورهای من» دستوردهنده همیشه خودِ کاربر است، پس این ستون
                               تکرار بی‌فایده بود و فضا می‌گرفت؛ فقط در «محول به من» و
                               «بایگانی» که دستوردهنده می‌تواند شخص دیگری باشد نمایش داده می‌شود. *@
                            @if (tab != "mine")
                            {
                                <th>دستوردهنده</th>
                            }
                            <th>مهلت</th>
                            <th title="چه کسانی این دستور کار را دریافت کرده‌اند — حلقهٔ رنگی، وضعیت هر نفر را نشان می‌دهد؛ «جزئیات» فهرست کامل را باز می‌کند">گیرندگان</th>
                            <th>دستورهای مرتبط</th><th>وضعیت</th>
                            <th title="نتیجهٔ تصمیم دستوردهنده روی پاسخ گیرندگان">تصمیم دستوردهنده</th>
                            <th class="text-end">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in PagedItems)
                        {
                            var tone = Tone(w);
                            <tr class="wo-row wo-tone-@tone">
                                <td><input type="checkbox" checked="@selectedOrders.Contains(w.Id)" @onclick:stopPropagation="true" @onchange="() => ToggleSelected(w.Id)" /></td>
                                <td>
                                    <button class="wo-expander" @onclick="() => ToggleExpand(w.Id)">
                                        <i class="bi @(expanded.Contains(w.Id) ? "bi-dash-lg" : "bi-plus-lg")"></i>
                                    </button>
                                </td>
                                <td class="num fw-700 text-primary">@w.Number</td>
                                <td class="fw-600">
                                    @PriorityBadge(w.Priority) @w.Title @SourceLink(w.SourceModule, w.SourceId, null, w.SourceType) @ProjectBadge(w)
                                    @if (w.Recurrence > 0)
                                    {
                                        <i class="bi bi-arrow-repeat text-info" title="تکرار @RecurrenceFa(w.Recurrence)"></i>
                                    }
                                    @if (w.ChecklistTotal > 0)
                                    {
                                        <span class="badge bg-light text-dark border fs-9 num" title="چک‌لیست">☑ @w.ChecklistDone/@w.ChecklistTotal</span>
                                    }
                                    @if (w.CommentCount > 0)
                                    {
                                        <span class="badge bg-light text-dark border fs-9 num" title="کامنت‌ها">💬 @w.CommentCount</span>
                                    }
                                    @foreach (var t in w.Tags)
                                    {
                                        var t2 = t;
                                        <span class="wo-tag wo-tag-sm" title="فیلتر با این برچسب" @onclick="() => SetTagFilter(t2)" @onclick:stopPropagation="true">@t2</span>
                                    }
                                </td>
                                @if (tab != "mine")
                                {
                                    <td>@w.OwnerName</td>
                                }
                                <td class="num">@w.DueAt.ToFa() @w.DueAt.ToString("HH:mm")</td>
                                <td class="wo-who-cell">
                                    @* ---------- گیرندگان: آواتار + شمارنده + نوار پاسخ‌ها ----------
                                       قبلاً این ستون فقط «۳ گیرنده (۱ پاسخ)» نشان می‌داد و معلوم نبود
                                       چه کسانی‌اند. حالا چهره‌ها/حروف اول نام‌ها با رنگ وضعیت هر نفر
                                       دیده می‌شود، تعداد آواتار خودکار با عرض صفحه تنظیم می‌شود و
                                       شمارندهٔ کنار آن همیشه کل گیرندگان را می‌گوید. *@
                                    @if (w.Assignees.Count == 0)
                                    {
                                        <span class="wo-who-empty">— بدون گیرنده</span>
                                    }
                                    else
                                    {
                                        <div class="wo-who">
                                            <div class="wo-who-top">
                                                <div class="wo-avstack" role="button" tabindex="0"
                                                     title="فهرست کامل گیرندگان و وضعیت هر نفر"
                                                     @onclick="() => ToggleWho(w.Id)" @onclick:stopPropagation="true"
                                                     @onkeydown="OnWhoKeyDown">
                                                    @foreach (var a in w.Assignees)
                                                    {
                                                        <span class="av @AvClass(a.UserId) @AsgState(a)" title="@($"{a.Name} — {AsgStateFa(a)}")">@Initials(a.Name)</span>
                                                    }
                                                    <span class="wo-avcnt num" title="تعداد کل گیرندگان">@w.Assignees.Count</span>
                                                </div>
                                                <button type="button" class="wo-who-btn"
                                                        title="فهرست کامل گیرندگان و وضعیت هر نفر"
                                                        @onclick="() => ToggleWho(w.Id)" @onclick:stopPropagation="true"
                                                        @onkeydown="OnWhoKeyDown">
                                                    جزئیات
                                                </button>
                                            </div>
                                            <div class="wo-who-bar" title="@WhoBarTitle(w)">
                                                <i class="d" style="width:@DonePct(w)%"></i><i class="b" style="width:@FailPct(w)%"></i>
                                            </div>
                                            <div class="wo-who-sub num">
                                                @RepliedCount(w) از @w.Assignees.Count پاسخ داد
                                                @if (PendingCount(w) > 0)
                                                {
                                                    <span> · @PendingCount(w) در انتظار</span>
                                                }
                                            </div>
                                        </div>
                                        @if (whoOpenId == w.Id)
                                        {
                                            <div class="pop-overlay" @onclick="CloseWho" @onclick:stopPropagation="true"></div>
                                            <div class="wo-who-pop" @onclick:stopPropagation="true">
                                                <div class="wo-who-pop-head">
                                                    <span>گیرندگان (@w.Assignees.Count نفر)</span>
                                                    <span class="sp"></span>
                                                    <span class="num">@RepliedCount(w) پاسخ</span>
                                                    <button type="button" class="btn btn-sm btn-light py-0 px-2" title="بستن" @onclick="CloseWho">
                                                        <i class="bi bi-x-lg fs-8"></i>
                                                    </button>
                                                </div>
                                                <ul>
                                                    @foreach (var a in WhoSorted(w))
                                                    {
                                                        <li>
                                                            <span class="av @AvClass(a.UserId) @AsgState(a)">@Initials(a.Name)</span>
                                                            <span class="nm" title="@a.Name">@a.Name</span>
                                                            <span class="wo-who-st @AsgState(a)">@AsgStateFa(a)</span>
                                                        </li>
                                                    }
                                                </ul>
                                            </div>
                                        }
                                    }
                                </td>
                                <td class="wo-related-cell">@RelatedOrderLinks(w)</td>
                                <td>@ToneBadge(w, tone)</td>
                                <td class="wo-decision-cell">@DecisionCell(w)</td>
                                <td class="text-end">
                                    <div class="d-flex gap-1 justify-content-end align-items-center">
                                        <button class="btn btn-sm btn-light" title="جزئیات" @onclick="() => OpenDetail(w)"><i class="bi bi-eye text-primary"></i></button>
                                        @if (CanEdit(w))
                                        {
                                            <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditFromList(w)"><i class="bi bi-pencil text-primary"></i></button>
                                        }
                                        @if (access.CanDelete)
                                        {
                                            <button class="btn btn-sm btn-light" title="حذف این نوبت" disabled="@busy" @onclick="() => DeleteOrder(w)"><i class="bi bi-trash text-danger"></i></button>
                                        }
                                        <ArchiveButton Module="WorkOrders" RefId="@w.Id"
                                                       Title="@($"{w.Number} — {w.Title}")"
                                                       Link="@($"/work-orders?open={w.Id}")"
                                                       Compact="true" />
                                    </div>
                                </td>
                            </tr>
                            @if (expanded.Contains(w.Id))
                            {
                                <tr class="wo-subrow">
                                    <td></td>
                                    @* تعداد ستون‌ها در تب «دستورهای من» یکی کمتر است (ستون
                                       دستوردهنده حذف شده)؛ colspan باید همان‌قدر کم شود. *@
                                    <td colspan='@(tab == "mine" ? 9 : 10)'>
                                        <table class="table table-sm mb-0 wo-subtable">
                                            <thead>
                                                <tr>
                                                    <th>گیرنده</th><th>رویت</th><th>پاسخ</th>
                                                    <th>نتیجه</th><th>شرح پاسخ</th><th>تصمیم دستوردهنده</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var a in w.Assignees)
                                                {
                                                    <tr>
                                                        <td class="fw-600"><span class="d-inline-flex align-items-center gap-1"><UserAvatar LoginUserId="a.UserId" Size="22" CssClass="user-avatar-sm" /> @a.Name</span></td>
                                                        <td class="num fs-8">@(a.SeenAt == null ? "—" : $"{a.SeenAt.Value.ToFa()} {a.SeenAt:HH:mm}")</td>
                                                        <td class="num fs-8">@(a.RepliedAt == null ? "—" : $"{a.RepliedAt.Value.ToFa()} {a.RepliedAt:HH:mm}")</td>
                                                        <td>
                                                            @if (a.Done == true)
                                                            {
                                                                <span class="badge bg-success-subtle text-success border">✅ انجام شد</span>
                                                            }
                                                            else if (a.Done == false)
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border">❌ انجام نشد</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="badge bg-warning-subtle text-warning border">در انتظار</span>
                                                            }
                                                        </td>
                                                        <td class="fs-8">@(a.ReplyText ?? "—")</td>
                                                        <td>
                                                            @if (a.OwnerDecision == "Approved")
                                                            {
                                                                <span class="badge bg-primary-subtle text-primary border">تایید ✔</span>
                                                            }
                                                            else if (a.OwnerDecision == "Rejected")
                                                            {
                                                                <span class="badge bg-danger-subtle text-danger border">رد شده</span>
                                                            }
                                                            else
                                                            {
                                                                <span class="text-muted fs-8">—</span>
                                                            }
                                                        </td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    @* ================== کارت‌ویو موبایل (بند ۱۴) ================== *@
    <div class="cards-mobile">
        @foreach (var w in PagedItems)
        {
            var tone = Tone(w);
            <div class="wo-mcard wo-tone-@tone" @onclick="() => OpenDetail(w)">
                <div class="d-flex justify-content-between align-items-start gap-2">
                    <div class="fw-700">@PriorityBadge(w.Priority) @w.Title</div>
                    @ToneBadge(w, tone)
                </div>
                <div class="fs-8 text-muted num">@w.Number — مهلت: @w.DueAt.ToFa() @w.DueAt.ToString("HH:mm") @SourceLink(w.SourceModule, w.SourceId, null, w.SourceType) @ProjectBadge(w)</div>
                @if (HasRelatedOrders(w)) { <div class="wo-mobile-related">@RelatedOrderLinks(w)</div> }
                @if (w.Assignees.Any(a => a.OwnerDecision != null) || w.Assignees.Any(a => a.RepliedAt != null))
                {
                    @* ستون «تصمیم دستوردهنده» در نمای موبایل — فقط وقتی تصمیمی یا پاسخی وجود دارد *@
                    <div class="fs-8 d-flex align-items-center gap-1 flex-wrap">
                        <span class="text-muted">تصمیم دستوردهنده:</span> @DecisionCell(w)
                    </div>
                }
                <div class="d-flex justify-content-between align-items-center">
                    @* در «دستورهای من» دستوردهنده خودِ کاربر است و تکرار نمی‌شود (مثل جدول دسکتاپ) *@
                    <div class="fs-8 d-flex align-items-center gap-1">
                        @if (tab != "mine")
                        {
                            <UserAvatar LoginUserId="w.OwnerUserId" Size="22" CssClass="user-avatar-sm" />
                            <span>@w.OwnerName —</span>
                        }
                        <span class="num">@w.Assignees.Count گیرنده (@w.Assignees.Count(a => a.RepliedAt != null) پاسخ)</span>
                    </div>
                    <div class="d-flex gap-1" @onclick:stopPropagation="true">
                        @if (CanEdit(w))
                        {
                            <button class="btn btn-sm btn-light" title="ویرایش" @onclick="() => OpenEditFromList(w)"><i class="bi bi-pencil text-primary"></i></button>
                        }
                        @if (access.CanDelete)
                        {
                            <button class="btn btn-sm btn-light" title="حذف این نوبت" disabled="@busy" @onclick="() => DeleteOrder(w)"><i class="bi bi-trash text-danger"></i></button>
                        }
                        <ArchiveButton Module="WorkOrders" RefId="@w.Id"
                                       Title="@($"{w.Number} — {w.Title}")"
                                       Link="@($"/work-orders?open={w.Id}")"
                                       Compact="true" />
                    </div>
                </div>
            </div>
        }
    </div>

    @* ================== صفحه‌بندی ================== *@
    @if (TotalPages > 1)
    {
        <div class="wo-pager mt-3">
            <button class="wo-page-btn" title="اولین صفحه" disabled="@(page <= 1)" @onclick="() => GoToPage(1)">
                <i class="bi bi-chevron-double-right"></i>
            </button>
            @* قبلی باید داده را هم دوباره بگیرد (قبلاً فقط عدد صفحه کم می‌شد و فهرست عوض نمی‌شد) *@
            <button class="wo-page-btn" title="قبلی" disabled="@(page <= 1)" @onclick="() => GoToPage(page - 1)">
                <i class="bi bi-chevron-right"></i>
            </button>
            @foreach (var pn in PageWindow)
            {
                var p2 = pn;
                <button class="wo-page-btn num @(page == p2 ? "active" : "")" @onclick="() => GoToPage(p2)">@p2</button>
            }
            <button class="wo-page-btn" title="بعدی" disabled="@(page >= TotalPages)" @onclick="() => GoToPage(page + 1)">
                <i class="bi bi-chevron-left"></i>
            </button>
            <button class="wo-page-btn" title="آخرین صفحه" disabled="@(page >= TotalPages)" @onclick="() => GoToPage(TotalPages)">
                <i class="bi bi-chevron-double-left"></i>
            </button>
            <span class="fs-8 text-muted ms-2">
                صفحهٔ <b class="num">@(page)</b> از <b class="num">@TotalPages</b>
                · نمایش <span class="num">@RangeStart</span> تا <span class="num">@RangeEnd</span> از <span class="num">@CurrentTotal</span>
            </span>
        </div>
    }
}

@* ================== مودال همه دستورهای یک روز ================== *@
@if (dayModalDate != null)
{
    var dayList = calItems.Where(c => c.DueAt.Date == dayModalDate.Value.Date).OrderBy(c => c.DueAt).ToList();
    <div class="modal fade show d-block" style="background:rgba(15,23,42,.55)">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable">
            <div class="modal-content wo-modal">
                <div class="modal-header" style="background:linear-gradient(135deg,#1e3a8a,#2563eb);color:#fff;border:0">
                    <h6 class="modal-title">
                        <i class="bi bi-calendar-day"></i>
                        دستورهای کار @(pc.GetYear(dayModalDate.Value))/@(pc.GetMonth(dayModalDate.Value).ToString("00"))/@(pc.GetDayOfMonth(dayModalDate.Value).ToString("00"))
                        <span class="badge bg-light text-primary me-2">@dayList.Count مورد</span>
                    </h6>
                    <button type="button" class="btn-close btn-close-white" @onclick="() => dayModalDate = null"></button>
                </div>
                <div class="modal-body p-2">
                    @foreach (var o in dayList)
                    {
                        <div class="wo-day-item" @onclick="async () => { dayModalDate = null; await OpenById(o.Id); }">
                            <span class="wo-day-kind wo-k-@o.Kind.ToLower()"></span>
                            @if (o.Tone == "ontime")
                            {
                                <i class="bi bi-check-circle-fill" style="color:#22c55e"></i>
                            }
                            else if (o.Tone == "latedone")
                            {
                                <i class="bi bi-check-circle-fill" style="color:#a855f7"></i>
                            }
                            else if (o.Tone == "late" || (o.Status == "Closed" && o.Tone == "closed"))
                            {
                                <i class="bi bi-x-circle-fill" style="color:#ef4444"></i>
                            }
                            else if (o.Tone == "today")
                            {
                                <i class="bi bi-alarm-fill" style="color:#f59e0b"></i>
                            }
                            else
                            {
                                <i class="bi bi-circle" style="color:#cbd5e1"></i>
                            }
                            <div class="flex-grow-1 min-w-0">
                                <div class="fw-700 fs-8 text-truncate">@o.Title</div>
                                <div class="fs-9 text-muted num">@o.Number — ساعت @o.DueAt.ToString("HH:mm")</div>
                            </div>
                            <span class="fs-9 text-muted">@KindFa(o.Kind)</span>
                            <i class="bi bi-chevron-left text-muted"></i>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* ================== مودال دستور کار جدید ================== *@
@if (showNew)
{
    <div class="modal fade show d-block wo-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="wo-form-title">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down wo-form-dialog">
            <div class="modal-content wo-modal wo-form-modal" dir="rtl">
                <div class="modal-header wo-dialog-header">
                    <div class="wo-dialog-heading">
                        <h5 id="wo-form-title" class="modal-title">@(editingId > 0 ? "ویرایش دستور کار" : "دستور کار جدید")</h5>
                        @if (chainParent != null)
                        {
                            <a class="wo-related-link" href="@($"/work-orders?open={chainParent.Id}")"><i class="bi bi-link-45deg"></i><bdi>@chainParent.Number</bdi></a>
                        }
                        @if (!string.IsNullOrWhiteSpace(_sourceLabel))
                        {
                            <div class="wo-source-meta">@SourceLink(_sourceModule, _sourceId) @_sourceLabel</div>
                        }
                    </div>
                    <div class="wo-header-actions">
                        <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseNewForm"></button>
                    </div>
                </div>
                <div class="modal-body wo-form-body">
                    @if (!string.IsNullOrWhiteSpace(formError))
                    {
                        <div class="alert alert-danger py-2" role="alert">@formError</div>
                    }
                    @if (editingId <= 0 && myTemplates.Count > 0)
                    {
                        <details class="wo-fold wo-template-fold"><summary>قالب‌ها <span class="wo-count">@myTemplates.Count</span></summary><div class="wo-tpl-bar">

                            @foreach (var t in myTemplates)
                            {
                                var t2 = t;
                                <span class="wo-tpl-chip @(appliedTplId == t2.Id ? "active" : "")" title="@($"عنوان: {t2.Title}")">
                                    <span class="wo-tpl-name" @onclick="() => ApplyTemplate(t2)">@t2.Name</span>
                                    <button type="button" class="wo-tpl-x" title="حذف قالب" @onclick:stopPropagation="true" @onclick="() => DeleteTemplate(t2.Id)"><i class="bi bi-x"></i></button>
                                </span>
                            }
                        </div></details>
                    }

                    <div class="wo-form-grid">
                        <section class="wo-form-main">
                            <div class="row g-3">

                        <div class="col-12">
                            <label class="form-label">عنوان <span class="text-danger">*</span></label>
                            <input class="form-control" @bind="newTitle" placeholder="عنوان دستور کار" />
                        </div>
                        <div class="col-12">
                            <label class="form-label">گیرندگان <span class="text-danger">*</span></label>
                            @* کمبوی چندانتخابی با جستجو (بند ۷) *@
                            <div class="ms-combo">
                                <div class="ms-combo-control form-control @(tDropOpen ? "focus" : "")" @ref="_tComboEl" @onclick="ToggleTargetsCombo">
                                    @if (selTargets.Count == 0)
                                    {
                                        <span class="text-muted">— انتخاب افراد —</span>
                                    }
                                    @foreach (var t in targets.Where(t => selTargets.Contains(t.Id)))
                                    {
                                        <span class="ms-chip">@t.Username <i class="bi bi-x-circle-fill" @onclick:stopPropagation="true" @onclick="() => selTargets.Remove(t.Id)"></i></span>
                                    }
                                    <i class="bi bi-chevron-@(tDropOpen ? "up" : "down") ms-caret"></i>
                                </div>
                                @if (tDropOpen)
                                {
                                    <div class="pop-overlay" @onclick="() => tDropOpen = false" @onclick:stopPropagation="true"></div>
                                    <div class="ms-combo-menu shadow" style="@TargetsMenuStyle" @onclick:stopPropagation="true">
                                        <div class="p-2 border-bottom">
                                            <input class="form-control form-control-sm" placeholder="جستجو..." @bind="tSearch" @bind:event="oninput" @onclick:stopPropagation="true" />
                                        </div>
                                        <div class="ms-combo-items">
                                            @foreach (var t in targets.Where(t => string.IsNullOrWhiteSpace(tSearch) || t.Username.Contains(tSearch.Trim(), StringComparison.OrdinalIgnoreCase)))
                                            {
                                                var isSel = selTargets.Contains(t.Id);
                                                <div class="ms-combo-item @(isSel ? "sel" : "")" @onclick="() => { if (isSel) selTargets.Remove(t.Id); else selTargets.Add(t.Id); }">
                                                    <i class="bi @(isSel ? "bi-check-square-fill" : "bi-square")"></i> @t.Username
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="col-12 col-md-8">
                            <label class="form-label">🏗 پروژه کاری <span class="text-muted fs-9">(اختیاری)</span></label>
                            <SearchSelect Items="formProjectOpts" Value="newProjectId" ValueChanged="(int v) => OnFormProjectSelected(v)"
                                          SearchChanged="OnFormProjectSearch" RemoteSearch="true"
                                          Placeholder="جستجوی پروژه…" />
                            @if (newProjectId > 0 && selProjectDueAt != null && newDueDate != null && newDueDate.Value.Date > selProjectDueAt.Value.Date)
                            {
                                <div class="alert alert-warning py-1 px-2 mt-1 fs-8">⚠ مهلت دستور بعد از مهلت پروژه (@selProjectDueAt.Value.ToFa()) است.</div>
                            }
                            @if (newProjectId > 0 && selProjectMemberIds.Count > 0)
                            {
                                <button type="button" class="btn btn-sm btn-link p-0 fs-8" @onclick="AddProjectMembersToTargets">
                                    <i class="bi bi-people"></i> افزودن اعضای پروژه به گیرندگان
                                </button>
                            }
                        </div>
                        <div class="col-12 col-md-4">
                            <label class="form-label">وزن در پروژه</label>
                            <input type="number" class="form-control num" min="0" max="10" @bind="newWeight" disabled="@(newProjectId <= 0)" />
                            <div class="fs-9 text-muted">۰ تا ۱۰ (۰ = در پیشرفت حساب نشود)</div>
                        </div>

                        <div class="col-12">
                            <label class="form-label">شرح</label>
                            <RteEditor @ref="rte" />
                        </div>

                            </div>
                        </section>
                        <section class="wo-form-schedule" aria-label="زمان‌بندی">
                            <div class="wo-section-label">زمان‌بندی</div>
                            <div class="wo-date-row">
                                <div>
                                    <label class="form-label">تاریخ مقرر <span class="text-danger">*</span></label>
                                    <DatePicker @bind-Value="newDueDate" />
                                </div>
                                <div>
                                    <label class="form-label" for="wo-due-time">ساعت</label>
                                    <input id="wo-due-time" type="time" class="form-control num" dir="ltr" @bind="newDueTime" />
                                </div>
                            </div>
                            <div>
                                <label class="form-label" for="wo-priority">اولویت</label>
                                <select id="wo-priority" class="form-select" @bind="newPriority">
                                    @foreach (var (val, fa) in PriorityOpts) { <option value="@val">@fa</option> }
                                </select>
                            </div>
                            <div>
                                <label class="form-label" for="wo-recurrence">تکرار</label>
                                <select id="wo-recurrence" class="form-select" @bind="newRecurrence" disabled="@editingSeries">
                                    @foreach (var (val, fa) in RecurrenceOpts) { <option value="@val">@fa</option> }
                                </select>
                            </div>
                            @if (editingId <= 0)
                            {
                                <div class="wo-sms-option border rounded p-3 mt-3">
                                    <div class="form-check form-switch">
                                        <input id="wo-send-sms" class="form-check-input" type="checkbox"
                                               @bind="sendSms" disabled="@(!access.SmsConfigured)" />
                                        <label class="form-check-label" for="wo-send-sms">
                                            <i class="bi bi-chat-dots"></i> ارسال SMS به گیرندگان
                                        </label>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        @if (access.SmsConfigured)
                                        {
                                            <span>پس از ثبت، پیام «شما یک دستور کار جدید دارید» به شماره موبایل ثبت‌شدهٔ گیرندگان ارسال می‌شود.</span>
                                        }
                                        else
                                        {
                                            <span>درگاه کاوه‌نگار روی سرور تنظیم نشده است؛ برای فعال‌سازی با مدیر سامانه تماس بگیرید.</span>
                                        }
                                    </div>
                                </div>
                            }
                        </section>
                    </div>
                    <div class="wo-form-extras">
                        <details class="wo-fold" open="@(newChecklist.Count > 0)">
                            <summary>چک‌لیست <span class="wo-count">@newChecklist.Count</span></summary>
                            <div class="wo-fold-body">
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-check2-square"></i> چک‌لیست</label>
                            <div class="d-flex gap-2 mb-2">
                                <input class="form-control form-control-sm" placeholder="عنوان مرحله"
                                       @bind="newClText" @bind:event="oninput" @onkeydown="OnClKeyDown" />
                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap" @onclick="AddChecklistItem">
                                    <i class="bi bi-plus-lg"></i> افزودن
                                </button>
                            </div>
                            @if (newChecklist.Count > 0)
                            {
                                <div class="wo-cl-editor">
                                    @for (var ci = 0; ci < newChecklist.Count; ci++)
                                    {
                                        var idx = ci;
                                        <div class="wo-cl-row">
                                            <span class="wo-cl-num num">@(idx + 1)</span>
                                            <span class="flex-grow-1">@newChecklist[idx]</span>
                                            <button type="button" class="btn btn-sm btn-light text-danger" title="حذف"
                                                    @onclick="() => RemoveChecklistItem(idx)"><i class="bi bi-x"></i></button>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                            </div>
                        </details>
                        <details class="wo-fold" open="@(newTags.Count > 0)">
                            <summary>برچسب‌ها <span class="wo-count">@newTags.Count</span></summary>
                            <div class="wo-fold-body">
                        <div class="col-12">
                            <label class="form-label"><i class="bi bi-tags"></i> برچسب‌ها</label>
                            <div class="d-flex gap-2 mb-2">
                                <input class="form-control form-control-sm" placeholder="برچسب جدید"
                                       maxlength="30" @bind="newTagText" @bind:event="oninput" @onkeydown="OnTagKeyDown" />
                                <button type="button" class="btn btn-sm btn-outline-primary text-nowrap"
                                        disabled="@(newTags.Count >= 5)" @onclick="AddTag">
                                    <i class="bi bi-plus-lg"></i> افزودن
                                </button>
                            </div>
                            @if (newTags.Count > 0)
                            {
                                <div class="d-flex gap-1 flex-wrap mb-1">
                                    @for (var ti = 0; ti < newTags.Count; ti++)
                                    {
                                        var tidx = ti;
                                        <span class="wo-tag">
                                            <i class="bi bi-tag-fill"></i> @newTags[tidx]
                                            <button type="button" class="wo-tag-x" title="حذف" @onclick="() => newTags.RemoveAt(tidx)"><i class="bi bi-x"></i></button>
                                        </span>
                                    }
                                </div>
                            }
                            @if (myTags.Count > 0)
                            {
                                <div class="d-flex gap-1 flex-wrap align-items-center">
                                    <span class="fs-9 text-muted">پیشنهاد:</span>
                                    @foreach (var t in myTags.Where(t => !newTags.Contains(t)).Take(8))
                                    {
                                        var t2 = t;
                                        <button type="button" class="wo-tag-suggest" @onclick="() => AddSuggestedTag(t2)">@t2</button>
                                    }
                                </div>
                            }
                        </div>
                            </div>
                        </details>
                        @if (editingId <= 0)
                        {
                            <details class="wo-fold">
                                <summary>پیوست‌ها <span class="wo-count">@newFiles.Count</span></summary>
                                <div class="wo-fold-body"><InputFile class="form-control" OnChange="OnFilesSelected" multiple /></div>
                            </details>
                        }
                    </div>
                    @if (tplSaveOpen && editingId <= 0)
                    {
                        <div class="wo-template-save-row">
                            <input class="form-control form-control-sm" maxlength="100" aria-label="نام قالب" placeholder="نام قالب" @bind="tplName" @bind:event="oninput" />
                            <button type="button" class="btn btn-sm btn-outline-primary" disabled="@(string.IsNullOrWhiteSpace(tplName) || tplBusy)" @onclick="SaveTemplate">ذخیره قالب</button>
                        </div>
                    }
                </div>
                <div class="modal-footer wo-dialog-footer">
                    @if (editingId <= 0)
                    {
                        <button type="button" class="btn btn-light wo-template-button" disabled="@busy" @onclick="() => tplSaveOpen = !tplSaveOpen"><i class="bi bi-bookmark-plus"></i> ذخیره قالب</button>
                    }
                    <div class="wo-footer-actions">
                        <button type="button" class="btn btn-outline-secondary" @onclick="CloseNewForm">انصراف</button>
                        <button type="button" class="btn btn-primary" disabled="@(busy || submitNewRunning)" @onclick="SubmitNew">
                            @if (busy || submitNewRunning) { <span class="spinner-border spinner-border-sm"></span> }
                            @(editingId > 0 ? "ذخیره تغییرات" : "ثبت دستور کار")
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@* ================== مودال جزئیات ================== *@
@if (detail != null)
{
    var isOwner = detail.OwnerUserId == access.UserId;
    var tone = Tone(detail);
    <div class="modal fade show d-block wo-dialog-backdrop" role="dialog" aria-modal="true" aria-labelledby="wo-detail-title">
        <div class="modal-dialog modal-xl modal-dialog-centered modal-dialog-scrollable modal-fullscreen-sm-down wo-detail-dialog">
            <div class="modal-content wo-modal wo-detail-modal" dir="rtl" @key="detail.Id">
                <div class="modal-header wo-dialog-header">
                    <div class="wo-dialog-heading">
                        <h5 id="wo-detail-title" class="modal-title mb-1">@detail.Title</h5>
                        <span class="badge bg-dark-subtle text-dark border num me-1">@detail.Number</span>
                    </div>
                    <div class="wo-header-actions">
                        @if (Auth.CanSee("Chat") && ChatTargets(detail).Any())
                        {
                            <div class="wo-chat-wrap">
                                <button type="button" class="btn btn-sm btn-outline-info" title="گفتگو دربارهٔ این دستور در پیام‌رسان"
                                        disabled="@chatBusy" @onclick="ToggleChatMenu">
                                    @if (chatBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                    else { <i class="bi bi-chat-dots"></i> }
                                    گفتگو
                                </button>
                                @if (chatMenuOpen)
                                {
                                    <div class="wo-chat-menu shadow">
                                        @foreach (var t in ChatTargets(detail))
                                        {
                                            var t2 = t;
                                            <button type="button" class="wo-chat-item" @onclick="() => StartChatAbout(t2.Id, t2.Name)">
                                                <UserAvatar LoginUserId="t2.Id" Size="22" CssClass="user-avatar-sm" />
                                                <span>@t2.Name</span>
                                            </button>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="OpenGardesh">
                            <i class="bi bi-diagram-3"></i> گردش کار
                        </button>
                        @if (isOwner && detail.Status == "Open" && !detail.Assignees.Any(a => a.SeenAt != null || a.RepliedAt != null))
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" @onclick="OpenEditFromDetail">
                                <i class="bi bi-pencil"></i> ویرایش
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary no-print" title="چاپ (Ctrl+P)" @onclick="PrintDetail"><i class="bi bi-printer"></i> چاپ</button>
                        <button type="button" class="btn-close" aria-label="بستن" @onclick="CloseDetail"></button>
                    </div>
                </div>
                <div class="wo-detail-meta">
                    @PriorityBadge(detail.Priority)
                        @if (detail.Recurrence > 0)
                        {
                            <span class="badge bg-info-subtle text-info border">🔁 @RecurrenceFa(detail.Recurrence)</span>
                        }
                        @foreach (var t in detail.Tags)
                        {
                            <span class="wo-tag wo-tag-sm"><i class="bi bi-tag-fill"></i> @t</span>
                        }
                        @ToneBadge(detail, tone)
                        @if (detail.ExtensionCount > 0)
                        {
                            <span class="badge bg-warning-subtle text-warning border">تمدید @detail.ExtensionCount از ۵</span>
                        }
</div>
                <div class="wo-detail-tabs" aria-label="بخش‌های دستور کار">
                    <button type="button" class="@(detailTab == "overview" ? "active" : "")" @onclick='() => detailTab = "overview"'>اطلاعات</button>
                    <button type="button" class="@(detailTab == "people" ? "active" : "")" @onclick='() => detailTab = "people"'>گیرندگان <span>@detail.Assignees.Count</span></button>
                    <button type="button" class="@(detailTab == "files" ? "active" : "")" @onclick='() => detailTab = "files"'>پیوست‌ها <span class="num">@detailAttCount</span></button>
                    <button type="button" class="@(detailTab == "comments" ? "active" : "")" @onclick='() => detailTab = "comments"'>گفت‌وگو <span>@comments.Count(c => !c.IsDeleted)</span></button>
                    @if (isOwner || detail.Status == "Closed")
                    {
                        <button type="button" class="@(detailTab == "actions" ? "active" : "")" @onclick='() => detailTab = "actions"'>@(detail.Status == "Closed" ? "نتیجه" : "عملیات")</button>
                    }
                </div>
                <div class="modal-body wo-detail-body">
                    <section hidden="@(detailTab != "overview")" aria-label="اطلاعات">
                        <div class="wo-info mb-3">
                            <div><span class="wo-lbl">دستوردهنده</span><span>@detail.OwnerName</span></div>
                            <div><span class="wo-lbl">مهلت</span><span class="num">@detail.DueAt.ToFa() @detail.DueAt.ToString("HH:mm")</span></div>
                            <div><span class="wo-lbl">تاریخ ثبت</span><span class="num">@detail.CreatedAt.ToFa()</span></div>
                            @* تعداد پیوست‌ها — از خودِ فهرست پیوست‌ها خوانده می‌شود تا شمارنده با
                               محتوای واقعی جعبهٔ پیوست یکی باشد، و کلیک روی آن تب پیوست‌ها را باز می‌کند. *@
                            <div>
                                <span class="wo-lbl">پیوست‌ها</span>
                                <span class="d-inline-flex align-items-center flex-wrap gap-1">
                                    <i class="bi bi-paperclip"></i>
                                    <b class="num">@detailAttCount</b>
                                    <span class="text-muted fs-9">فایل</span>
                                    @if (detailAttCount > 0)
                                    {
                                        <button type="button" class="btn btn-link btn-sm py-0 fs-9" @onclick='() => detailTab = "files"'>مشاهده</button>
                                    }
                                </span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(detail.SourceModule) && detail.SourceId is > 0)
                            {
                                <div>
                                    <span class="wo-lbl">منبع</span><span class="d-inline-flex align-items-center flex-wrap gap-1">
                                        @SourceLink(detail.SourceModule, detail.SourceId, detail.SourceRefId, detail.SourceType)
                                        @if (detail.SourceModule == "Document" && _docRefs.TryGetValue(detail.Id, out var docRef))
                                        {
                                            <span class="text-muted fs-9">@docRef.Code — @docRef.Title</span>
                                        }
                                    </span>
                                </div>
                            }
                            @if (detail.ProjectId is > 0)
                            {
                                <div>
                                    <span class="wo-lbl">پروژه</span><span class="d-inline-flex align-items-center flex-wrap gap-1">
                                        @ProjectBadge(detail)
                                        <span class="text-muted fs-9">@detail.ProjectName — وزن @detail.Weight — پیشرفت @detail.OrderProgress٪</span>
                                    </span>
                                </div>
                            }
                        </div>
                    @if (_mindFlowLinks.Count > 0)
                    {
                        <div class="wo-block mb-3">
                            <div class="wo-block-title"><i class="bi bi-diagram-3"></i> نگاشت‌های ذهنی متصل</div>
                            <div class="wo-block-body">
                                @foreach (var link in _mindFlowLinks)
                                {
                                    var pathQuery = Uri.EscapeDataString(string.Join(",", link.SubFlowPath));
                                    var mindFlowHref = link.StandaloneMindFlowId is int standaloneId
                                        ? $"/mindflows/{standaloneId}?nodeId={link.NodeId}&subFlowPath={pathQuery}"
                                        : $"/work-projects/mindflow?projectId={link.ProjectId}&nodeId={link.NodeId}&subFlowPath={pathQuery}";
                                    <div class="wo-chain-row">
                                        <i class="bi bi-diagram-2 text-primary"></i>
                                        <a class="wo-chain-link" href="@mindFlowHref" target="_blank" rel="noopener noreferrer">
                                            @if (link.StandaloneMindFlowId is not null) { <span>نگاشت مستقل · @link.MapTitle</span> }
                                            else { <span>@link.ProjectNumber — @link.ProjectTitle</span> }
                                            / @link.NodeText
                                        </a>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(detail.Description))
                    {
                        <div class="wo-block mb-3">
                            <div class="wo-block-title"><i class="bi bi-card-text"></i> شرح</div>
                            <div class="wo-block-body">@((MarkupString)detail.Description)</div>
                        </div>
                    }

                    @* ---------- چک‌لیست زیرکار + درصد پیشرفت ---------- *@
                    @if (detailChecklist.Count > 0)
                    {
                        var clDone = detailChecklist.Count(c => c.IsDone);
                        var clPct = clDone * 100 / detailChecklist.Count;
                        <div class="wo-block mb-3">
                            <div class="wo-block-title d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="bi bi-check2-square"></i> چک‌لیست (@clDone از @detailChecklist.Count)</span>
                                <div class="d-flex align-items-center gap-2" style="min-width:160px">
                                    <div class="wo-bar-track flex-grow-1">
                                        <div class="wo-bar" style="width:@clPct%;background:@(clPct == 100 ? "#22c55e" : "#3b82f6")"></div>
                                    </div>
                                    <span class="fs-9 num fw-700">@clPct%</span>
                                </div>
                            </div>
                            <div class="wo-block-body">
                                @foreach (var c in detailChecklist.OrderBy(x => x.SortOrder))
                                {
                                    var canTick = detail.Status == "Open" &&
                                        (isOwner || detail.Assignees.Any(a => a.UserId == access.UserId));
                                    <div class="wo-cl-item @(c.IsDone ? "done" : "") @(canTick ? "tickable" : "")"
                                         @onclick="async () => { if (canTick) await ToggleChecklist(c); }">
                                        <i class="bi @(c.IsDone ? "bi-check-square-fill text-success" : "bi-square")"></i>
                                        <span class="flex-grow-1">@c.Text</span>
                                        @if (c.IsDone && !string.IsNullOrWhiteSpace(c.DoneByName))
                                        {
                                            <span class="fs-9 text-muted">@c.DoneByName@(c.DoneAt != null ? $" — {c.DoneAt.Value.ToFa()}" : "")</span>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }

                     @* ---------- ارجاع زنجیره‌ای (والد / زیر-دستورها) ---------- *@
                    @{
                        var canChain = detail.Status == "Open" && access.CanCreate &&
                            (isOwner || detail.Assignees.Any(a => a.UserId == access.UserId));
                    }
                    @if (detail.ParentOrderId != null || detail.Children.Count > 0 || canChain)
                    {
                        <div class="wo-block mb-3">
                            <div class="wo-block-title d-flex justify-content-between align-items-center flex-wrap gap-2">
                                <span><i class="bi bi-link-45deg"></i> دستورهای مرتبط</span>
                                @if (canChain)
                                {
                                    <button type="button" class="btn btn-sm btn-outline-primary py-0 fs-8" @onclick="OpenChainForm">
                                        <i class="bi bi-diagram-2"></i> زیر‌دستور جدید
                                    </button>
                                }
                            </div>
                            <div class="wo-block-body">
                                @if (detail.ParentOrderId != null)
                                {
                                    <div class="wo-chain-row">
                                        <i class="bi bi-arrow-up-left-circle text-secondary"></i>
                                        <span class="fs-8 text-muted">والد:</span>
                                        <a class="wo-chain-link" href="@($"/work-orders?open={detail.ParentOrderId}")">
                                            @detail.ParentNumber — @detail.ParentTitle
                                        </a>
                                    </div>
                                }
                                @if (detail.Children.Count > 0)
                                {
                                    <div class="fs-8 text-muted mb-1 mt-1">
                                        زیر-دستورها (@detail.Children.Count(c => c.Status == "Closed") از @detail.Children.Count بسته):
                                    </div>
                                    @foreach (var ch in detail.Children)
                                    {
                                        var ch2 = ch;
                                        <div class="wo-chain-row">
                                            <i class="bi @(ch2.Status == "Closed" ? "bi-check-circle-fill text-success" : "bi-circle text-warning")"></i>
                                            <a class="wo-chain-link" href="@($"/work-orders?open={ch2.Id}")">
                                                @ch2.Number — @ch2.Title
                                            </a>
                                            <span class="fs-9 text-muted">(@ch2.OwnerName)</span>
                                            <span class="badge @(ch2.Status == "Closed" ? "bg-success-subtle text-success" : "bg-warning-subtle text-warning") border fs-9">
                                                @(ch2.Status == "Closed" ? "بسته" : "باز")
                                            </span>
                                        </div>
                                    }
                                }
                            </div>
                        </div>
                    }

                    </section>
                    <section hidden="@(detailTab != "people")" aria-label="گیرندگان">@* ---------- گیرندگان + عملیات ---------- *@
                    <div class="wo-block mb-3">
                        <div class="wo-block-title"><i class="bi bi-people"></i> گیرندگان (@detail.Assignees.Count(a => a.RepliedAt != null)/@detail.Assignees.Count پاسخ)</div>
                        <div class="wo-block-body">
                            @foreach (var a in detail.Assignees)
                            {
                                <div class="wo-asg">
                                    <div class="d-flex justify-content-between flex-wrap gap-1 align-items-center">
                                        <span class="fw-700 d-inline-flex align-items-center gap-1"><UserAvatar LoginUserId="a.UserId" Size="24" CssClass="user-avatar-sm" /> @a.Name</span>
                                        <div class="d-flex gap-1 flex-wrap">
                                            <span class="badge bg-light text-dark border fs-9">رویت: @(a.SeenAt == null ? "—" : a.SeenAt.Value.ToFa())</span>
                                            @if (a.Done == true)
                                            {
                                                <span class="badge bg-success-subtle text-success border">انجام شد</span>
                                            }
                                            else if (a.Done == false)
                                            {
                                                <span class="badge bg-danger-subtle text-danger border">انجام نشد</span>
                                            }
                                            @if (a.OwnerDecision == "Approved")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border">تأیید</span>
                                            }
                                            else if (a.OwnerDecision == "Rejected")
                                            {
                                                <span class="badge bg-danger-subtle text-danger border">رد شده</span>
                                            }
                                        </div>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(a.ReplyText))
                                    {
                                        <div class="wo-reply mt-1">@a.ReplyText</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(a.OwnerDecisionNote))
                                    {
                                        <div class="fs-8 text-muted mt-1">یادداشت دستوردهنده: @a.OwnerDecisionNote</div>
                                    }

                                    @* پاسخ گیرنده *@
                                    @if (detail.Status == "Open" && a.UserId == access.UserId && a.RepliedAt == null)
                                    {
                                        <div class="mt-2 p-2 rounded-3" style="background:#f0fdf4;border:1px dashed #86efac">
                                            <div class="d-flex gap-3 mb-2">
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="wodone" id="wod-y" checked="@(myDone == true)" @onchange="() => myDone = true" />
                                                    <label class="form-check-label text-success fw-600" for="wod-y">انجام شد</label>
                                                </div>
                                                <div class="form-check">
                                                    <input class="form-check-input" type="radio" name="wodone" id="wod-n" checked="@(myDone == false)" @onchange="() => myDone = false" />
                                                    <label class="form-check-label text-danger fw-600" for="wod-n">انجام نشد</label>
                                                </div>
                                            </div>
                                            <textarea class="form-control form-control-sm" rows="2" placeholder="شرح پاسخ..." @bind="myReply"></textarea>
                                            <button class="btn btn-success btn-sm mt-2" disabled="@busy" @onclick="SubmitReply"><i class="bi bi-check2"></i> ثبت پاسخ</button>
                                        </div>
                                    }

                                    @* تصمیم دستوردهنده *@
                                    @if (detail.Status == "Open" && isOwner && a.RepliedAt != null && a.OwnerDecision == null)
                                    {
                                        <div class="mt-2 p-2 rounded-3" style="background:#fffbeb;border:1px dashed #fcd34d">
                                            <input class="form-control form-control-sm mb-2" placeholder="یادداشت (اختیاری)" @bind="decideNotes[a.Id]" />
                                            <div class="d-flex gap-2">
                                                <button class="btn btn-success btn-sm" disabled="@busy" @onclick="() => Decide(a.Id, true)"><i class="bi bi-check2"></i> تایید</button>
                                                <button class="btn btn-outline-danger btn-sm" disabled="@busy" @onclick="() => Decide(a.Id, false)"><i class="bi bi-x-lg"></i> رد (برگشت)</button>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    </section>
                    <section hidden="@(detailTab != "files")" aria-label="پیوست‌ها">@* ---------- پیوست‌ها — کامپوننت جامع (یک کد برای همه فرم‌ها) ---------- *@
                    <div class="mb-3 d-flex justify-content-between align-items-start gap-2 flex-wrap">
                        <div class="flex-grow-1">
                            <AttachmentBox Module="WorkOrders" RefId="@detail.Id" CanUpload="@(detail.Status == "Open")"
                                           OnCountChanged="SetDetailAttCount" />
                        </div>
                        <ArchiveButton Module="WorkOrders" RefId="@detail.Id"
                                       Title="@($"{detail.Number} — {detail.Title}")"
                                       Link="@($"/work-orders?open={detail.Id}")" />
                    </div>

                    </section>
                    <section hidden="@(detailTab != "comments")" aria-label="گفت‌وگو">@* ---------- رشتهٔ گفتگو (کامنت‌ها) ---------- *@
                    @{
                        var canComment = detail.Status == "Open" &&
                            (isOwner || detail.Assignees.Any(a => a.UserId == access.UserId));
                    }
                    <div class="wo-block mb-3">
                        <div class="wo-block-title"><i class="bi bi-chat-left-text"></i> گفتگو (@comments.Count(c => !c.IsDeleted))</div>
                        <div class="wo-block-body">
                            @if (comments.Count == 0)
                            {
                                <div class="wo-muted-empty">بدون پیام</div>
                            }
                            @foreach (var cm in comments)
                            {
                                var mine = cm.AuthorUserId == access.UserId;
                                <div class="wo-cm @(mine ? "mine" : "")" id="wo-cm-@cm.Id">
                                    <UserAvatar LoginUserId="cm.AuthorUserId" Size="28" CssClass="user-avatar-sm" />
                                    <div class="wo-cm-bubble">
                                        <div class="wo-cm-head">
                                            <span class="fw-700 fs-8">@cm.AuthorName</span>
                                            <span class="fs-9 text-muted num">@cm.CreatedAt.ToFa() @cm.CreatedAt.ToString("HH:mm")</span>
                                            @if (cm.EditedAt != null && !cm.IsDeleted)
                                            {
                                                <span class="fs-9 text-muted">(ویرایش‌شده)</span>
                                            }
                                        </div>
                                        @if (cm.ReplyToId != null)
                                        {
                                            var parent = comments.FirstOrDefault(x => x.Id == cm.ReplyToId);
                                            <div class="wo-cm-quote">
                                                <i class="bi bi-reply-fill"></i>
                                                @(parent == null || parent.IsDeleted ? "کامنت حذف‌شده" : $"{parent.AuthorName}: {Brief(parent.Text)}")
                                            </div>
                                        }
                                        @if (cm.IsDeleted)
                                        {
                                            <div class="fs-8 text-muted fst-italic"><i class="bi bi-trash"></i> این کامنت حذف شده است.</div>
                                        }
                                        else if (editingCommentId == cm.Id)
                                        {
                                            <textarea class="form-control form-control-sm mb-1" rows="2" @bind="editingCommentText"></textarea>
                                            <div class="d-flex gap-1">
                                                <button class="btn btn-sm btn-primary py-0 fs-8" disabled="@cmBusy" @onclick="SubmitEditComment">ذخیره</button>
                                                <button class="btn btn-sm btn-light py-0 fs-8" @onclick="CancelEditComment">انصراف</button>
                                            </div>
                                        }
                                        else
                                        {
                                            <div class="wo-cm-text">@cm.Text</div>
                                            @if (canComment)
                                            {
                                                <div class="wo-cm-actions">
                                                    <button class="wo-cm-link" @onclick="() => SetReplyTo(cm)"><i class="bi bi-reply"></i> پاسخ</button>
                                                    @if (mine)
                                                    {
                                                        <button class="wo-cm-link" @onclick="() => StartEditComment(cm)"><i class="bi bi-pencil"></i> ویرایش</button>
                                                    }
                                                    @if (mine || isOwner)
                                                    {
                                                        <button class="wo-cm-link text-danger" @onclick="() => DeleteComment(cm)"><i class="bi bi-trash"></i> حذف</button>
                                                    }
                                                </div>
                                            }
                                        }
                                    </div>
                                </div>
                            }

                            @if (canComment)
                            {
                                <div class="mt-2 pt-2 border-top">
                                    @if (replyTo != null)
                                    {
                                        <div class="wo-cm-quote d-flex justify-content-between align-items-center mb-1">
                                            <span><i class="bi bi-reply-fill"></i> پاسخ به @replyTo.AuthorName: @Brief(replyTo.Text)</span>
                                            <button class="wo-cm-link" @onclick="() => replyTo = null"><i class="bi bi-x-lg"></i></button>
                                        </div>
                                    }
                                    <div class="d-flex gap-2 align-items-start">
                                        <textarea class="form-control form-control-sm" rows="2" maxlength="2000"
                                                  placeholder="متن پیام"
                                                  @bind="newCommentText" @bind:event="oninput"></textarea>
                                        <button class="btn btn-primary btn-sm" style="white-space:nowrap"
                                                disabled="@(cmBusy || string.IsNullOrWhiteSpace(newCommentText))" @onclick="SubmitComment">
                                            @if (cmBusy) { <span class="spinner-border spinner-border-sm"></span> }
                                            else { <i class="bi bi-send"></i> }
                                            ارسال
                                        </button>
                                    </div>
                                </div>
                            }
                            else if (detail.Status == "Closed")
                            {
                                <div class="fs-9 text-muted mt-2"><i class="bi bi-lock"></i> گفت‌وگو بسته است.</div>
                            }
                        </div>
                    </div>

                    </section>
                    <section hidden="@(detailTab != "actions")" aria-label="عملیات">@* ---------- تمدید و بستن (فقط دستوردهنده) ---------- *@
                    @if (detail.Status == "Open" && isOwner)
                    {
                        <div class="wo-block mb-3" style="border-color:#e9d5ff">
                            <div class="wo-block-title" style="background:#faf5ff"><i class="bi bi-sliders" style="color:#7c3aed"></i> عملیات دستوردهنده</div>
                            <div class="wo-block-body">
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-md-4">
                                        <label class="form-label fs-8">تمدید مهلت (@detail.ExtensionCount از ۵)</label>
                                        <DatePicker @bind-Value="extDate" />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="time" class="form-control num" dir="ltr" @bind="extTime" />
                                    </div>
                                    <div class="col-md-5">
                                        <button class="btn btn-warning btn-sm w-100" disabled="@(busy || detail.ExtensionCount >= 5)" @onclick="SubmitExtend">
                                            <i class="bi bi-clock-history"></i> تمدید مهلت
                                        </button>
                                    </div>
                                </div>
                                <hr />
                                <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="یادداشت بستن (اختیاری)..." @bind="closeNote"></textarea>
                                <button class="btn btn-danger" disabled="@busy" @onclick="SubmitClose">
                                    <i class="bi bi-lock"></i> بستن دستور کار
                                </button>
                            </div>
                        </div>
                    }
                    @if (detail.Status == "Closed")
                    {
                        <div class="alert alert-secondary py-2 fs-8">
                            <i class="bi bi-lock-fill"></i> این دستور کار در @(detail.ClosedAt?.ToFa()) نهایی و بسته شده است.
                            @if (!string.IsNullOrWhiteSpace(detail.CloseNote))
                            {
                                <div class="mt-1">یادداشت: @detail.CloseNote</div>
                            }
                        </div>
                    }
                    @if (detail.Status == "Closed" && isOwner)
                    {
                        <div class="wo-block mb-3" style="border-color:#bbf7d0">
                            <div class="wo-block-title" style="background:#f0fdf4"><i class="bi bi-unlock" style="color:#16a34a"></i> بازگشایی و برگشت به گردش</div>
                            <div class="wo-block-body">
                                <div class="fs-8 text-muted mb-2">دستور کار دوباره «باز» می‌شود، به کارتابل گیرندگان برمی‌گردد و همهٔ عملیات (پاسخ، تمدید، چک‌لیست، گفت‌وگو و بستن مجدد) دوباره فعال می‌شود. سابقهٔ قبلی در تاریخچه محفوظ می‌ماند.</div>
                                <div class="row g-2 align-items-end mb-2">
                                    <div class="col-md-5">
                                        <label class="form-label fs-8">مهلت جدید (اختیاری)</label>
                                        <DatePicker @bind-Value="reopenDate" />
                                    </div>
                                    <div class="col-md-3">
                                        <input type="time" class="form-control num" dir="ltr" @bind="reopenTime" disabled="@(reopenDate == null)" />
                                    </div>
                                    <div class="col-md-4 fs-9 text-muted">
                                        @if (reopenDate == null && detail.DueAt < DateTime.Now)
                                        {
                                            <span class="text-danger"><i class="bi bi-exclamation-triangle"></i> مهلت فعلی (@detail.DueAt.ToFa()) گذشته است.</span>
                                        }
                                    </div>
                                </div>
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" id="woReopenReset" @bind="reopenReset" />
                                    <label class="form-check-label fs-8" for="woReopenReset">پاسخ‌ها و تأییدهای قبلی گیرندگان باطل شود تا دوباره پاسخ دهند</label>
                                </div>
                                <textarea class="form-control form-control-sm mb-2" rows="2" placeholder="علت بازگشایی (اختیاری)..." @bind="reopenNote"></textarea>
                                <button class="btn btn-success" disabled="@busy" @onclick="SubmitReopen">
                                    <i class="bi bi-unlock"></i> بازگشایی دستور کار
                                </button>
                            </div>
                        </div>
                    }

                    </section>
                </div>
                <div class="modal-footer wo-dialog-footer">
                    @if (access.CanDelete)
                    {
                        <button type="button" class="btn btn-outline-danger" disabled="@busy" @onclick="() => DeleteOrder(detail)"><i class="bi bi-trash"></i> حذف</button>
                    }
                    <div class="wo-footer-actions"><button type="button" class="btn btn-outline-secondary" @onclick="CloseDetail">بستن پنجره</button></div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .wo-tabs { display: flex; gap: .5rem; flex-wrap: wrap; }
    .wo-tab { border: 1px solid #e2e8f0; background: #fff; border-radius: 12px; padding: .5rem 1rem; font-size: .88rem; font-weight: 600; color: #475569; display: inline-flex; align-items: center; gap: .45rem; cursor: pointer; transition: all .15s; }
    .wo-tab:hover { border-color: #93c5fd; color: #2563eb; }
    .wo-tab.active { background: #2563eb; border-color: #2563eb; color: #fff; box-shadow: 0 4px 12px rgba(37,99,235,.3); }
    .wo-tab-badge { background: rgba(0,0,0,.08); border-radius: 999px; padding: 0 .5rem; font-size: .75rem; }
    .wo-tab.active .wo-tab-badge { background: rgba(255,255,255,.25); }

    /* ---------- نوار جستجو و فیلتر ---------- */
