        decideNotes = w.Assignees.ToDictionary(a => a.Id, a => "");
        extDate = w.DueAt.Date; extTime = TimeOnly.FromDateTime(w.DueAt);
        attachments = new(); logs = new();
        // شمارندهٔ اولیه از لیست (سبک) و سپس تازه‌سازی از فهرست واقعی پیوست‌ها
        detailAttCount = w.AttachmentCount;
        _ = LoadAttachmentCount(w.Id).ContinueWith(_ => InvokeAsync(StateHasChanged));
        detailChecklist = new();
        comments = new(); newCommentText = ""; replyTo = null; editingCommentId = 0;
        _ = LoadDetailChecklist(w.Id).ContinueWith(_ => InvokeAsync(StateHasChanged));
        _ = LoadComments(w.Id).ContinueWith(_ => InvokeAsync(StateHasChanged));

        // ثبت رویت (بند ۸)
        if (w.Assignees.Any(a => a.UserId == access.UserId && a.SeenAt == null))
        {
            try { await Http.PostAsync($"/api/workorders/{w.Id}/seen", null); } catch { }
            var mine = w.Assignees.First(a => a.UserId == access.UserId);
            mine.SeenAt = DateTime.Now;
        }

        try
        {
            var rows = await Http.GetFromJsonAsync<List<LogItem>>($"/api/workorders/{w.Id}/logs") ?? new();
            if (detail?.Id == w.Id) logs = rows;
        }
        catch { }

        // شماره/عنوان مدرک آرشیوِ متصل را برای نمایش در بخش «منبع» می‌آوریم (بی‌صدا؛ فقط نمایشی).
        if (w.SourceModule == "Document" && w.SourceId is int docId && docId > 0 && !_docRefs.ContainsKey(w.Id))
        {
            try
            {
                var d = await Http.GetFromJsonAsync<Inventory.Shared.Dtos.DocumentDto>($"/api/doc-archive/documents/{docId}");
                if (d != null)
                {
                    _docRefs[w.Id] = (d.Code, d.Title);
                    StateHasChanged();
                }
            }
            catch { /* مدرک حذف/ناموجود شده باشد مشکلی ایجاد نمی‌کند */ }
        }
    }



