@namespace Inventory.Client.Pages
@using Inventory.Client.Pages.Office.Guides

<OfficeGuide Title="راهنمای دستور کار و وظایف"
             Description="از ثبت دستور کار و انتخاب گیرندگان تا پاسخ، تأیید دستوردهنده، تمدید مهلت، زیر-دستور و گزارش عملکرد؛ همهٔ مراحل کار با دستور کار را گام‌به‌گام در این صفحه ببینید."
             Eyebrow="دستور کار / راهنمای کاربری" Icon="bi-clipboard-check-fill"
             BackLabel="بازگشت به دستور کار" QuickStartTitle="ثبت اولین دستور کار در سه گام"
             Steps="QuickSteps" Sections="GuideSections" OnBack="OnBack">

    <OfficeGuideSection Id="wo-overview" Index="1" Title="آشنایی با دستور کار" Kicker="نمای کلی">
        <p>
            «دستور کار» یک وظیفه یا درخواست با <b>عنوان، گیرنده(ها)، مهلت (تاریخ و ساعت)، اولویت و شرح</b> است.
            هر دستور کار یک <b>دستوردهنده</b> و یک یا چند <b>گیرنده</b> دارد و تا وقتی دستوردهنده پاسخ‌ها را
            <b>تأیید</b> نکند بسته نمی‌شود. صفحهٔ دستور کار از سه بخش تشکیل شده است:
        </p>
        <div class="anatomy-grid">
            <article class="anatomy-card violet">
                <span class="card-icon"><i class="bi bi-segmented-nav"></i></span>
                <h3>تب‌ها</h3>
                <p>دستورهای من، محول به من، بایگانی، کانبان، تقویم، عملکرد افراد و داشبورد.</p>
            </article>
            <article class="anatomy-card blue">
                <span class="card-icon"><i class="bi bi-funnel"></i></span>
                <h3>نوار جستجو و فیلتر</h3>
                <p>جستجوی متنی، اولویت، برچسب، پروژه و تصمیم دستوردهنده — همه سمت سرور؛ به‌همراه خروجی اکسل و PDF از همان فیلترها.</p>
            </article>
            <article class="anatomy-card green">
                <span class="card-icon"><i class="bi bi-window-stack"></i></span>
                <h3>فهرست و پنل جزئیات</h3>
                <p>هر ردیف خلاصهٔ دستور کار را نشان می‌دهد و با باز کردن آن، مشخصات، گیرندگان، گفتگو، پیوست‌ها و عملیات در دسترس است.</p>
            </article>
        </div>
        <div class="guide-note info">
            <i class="bi bi-people"></i>
            <div>
                <strong>هر کاربر دادهٔ خودش را می‌بیند</strong>
                <span>داشبورد و گزارش عملکرد برای هر کاربر فقط داده‌های خودش را نشان می‌دهد؛ اعداد داشبورد شامل دستورهای شما و کارهای محول‌شده به شماست.</span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-create" Index="2" Title="ثبت دستور کار جدید" Kicker="ایجاد">
        <p>با دکمهٔ <b>«دستور کار جدید»</b> در بالای صفحه، فرم ثبت باز می‌شود. فیلدهای ستاره‌دار الزامی‌اند:</p>
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>فیلد</th><th>توضیح</th></tr>
                </thead>
                <tbody>
                    <tr><td>عنوان <span class="text-danger">*</span></td><td>خلاصه و روشن از کاری که باید انجام شود.</td></tr>
                    <tr><td>گیرندگان <span class="text-danger">*</span></td><td>یک یا چند کاربر؛ با کادر جستجو سریع‌تر پیدا می‌شوند. هر گیرنده یک ردیف پاسخ مستقل دارد.</td></tr>
                    <tr><td>تاریخ مقرر و ساعت <span class="text-danger">*</span></td><td>مهلت انجام، به تاریخ شمسی و ساعت؛ مبنای محاسبهٔ «دیرکرد» در گزارش‌ها.</td></tr>
                    <tr><td>اولویت</td><td>کم / عادی / بالا / فوری. ستون‌های نمای کانبان بر همین اساس ساخته می‌شوند.</td></tr>
                    <tr><td>تکرار</td><td>بدون تکرار / روزانه / هفتگی / ماهانه؛ نسخهٔ بعدی خودکار ساخته می‌شود.</td></tr>
                    <tr><td>شرح</td><td>توضیح کامل کار، انتظارات و نکات لازم برای گیرنده.</td></tr>
                    <tr><td>پروژهٔ کاری و وزن</td><td>اختیاری؛ دستور کار به یک پروژه وصل می‌شود و وزن آن در درصد پیشرفت پروژه اثر می‌گذارد.</td></tr>
                    <tr><td>چک‌لیست و برچسب‌ها</td><td>مراحل انجام کار و برچسب‌هایی برای دسته‌بندی و فیلتر سریع.</td></tr>
                    <tr><td>پیوست و پیامک</td><td>فایل‌های مرتبط را اضافه کنید؛ اگر پیامک تنظیم شده باشد، گیرنده خبردار می‌شود.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note">
            <i class="bi bi-lightning-charge"></i>
            <div>
                <strong>قالب‌های آماده</strong>
                <span>برای دستورهای تکرارشونده، فرم پرشده را به‌عنوان قالب ذخیره کنید تا بار بعد با یک کلیک همان ساختار آماده شود.</span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-assign" Index="3" Title="گیرندگان و زیر-دستور" Kicker="واگذاری">
        <ol class="instruction-list">
            <li><span>۱</span><div>گیرندگان را از فهرست کاربران انتخاب کنید؛ افزودن نفر به یک دستور کارِ باز هم بعداً از پنل جزئیات ممکن است.</div></li>
            <li><span>۲</span><div>وقتی کار بزرگ است، آن را به <b>زیر-دستور</b> بشکنید: هر زیر-دستور گیرنده و مهلت خودش را دارد و پیشرفت کل از دستور والد دیده می‌شود («زیر-دستورها: ۲ از ۳ بسته»).</div></li>
            <li><span>۳</span><div>زیر-دستور فقط برای دستور کارِ <b>باز</b> و توسط دستوردهنده یا گیرندهٔ همان دستور ساخته می‌شود.</div></li>
        </ol>
        <div class="guide-note info">
            <i class="bi bi-diagram-3"></i>
            <div>
                <strong>اگر خودتان هم انجام‌دهنده هستید</strong>
                <span>خودتان را هم می‌توانید به‌عنوان گیرنده انتخاب کنید؛ در این حالت دستور کار هم در «دستورهای من» و هم در «محول به من» دیده می‌شود.</span>
            </div>
        </div>
        <div class="guide-note">
            <i class="bi bi-envelope-paper"></i>
            <div>
                <strong>دستور کارِ ساخته‌شده از نامه — دسترسی گیرندگان به نامه</strong>
                <span>
                    وقتی دستور کار از روی یک نامه ساخته می‌شود، این قاعده برای <b>هر سه نوع نامه</b> — <b>داخلی</b>،
                    <b>صادره</b> و <b>وارده</b> — یکسان اجرا می‌شود: برای هر گیرنده‌ای که در گردش آن نامه نیست، سامانه
                    به‌صورت خودکار یک <b>ارجاع</b> روی همان نامه می‌سازد. بنابراین لینک «نامه» در فهرست دستور کار برای همهٔ گیرندگان باز می‌شود و در کارتابل نامه هم
                    دیده می‌شود و برای بازکردن نامه نیازی به مجوز عمومی کارتابل آن نامه نیست (همین که در گردش نامه
                    باشید کافی است). برای همان افراد یک <b>اعلان «نامهٔ جدید در کارتابل شما»</b> هم فرستاده می‌شود که با
                    کلیک روی آن، مستقیم همان نامه باز می‌شود؛ افرادی که از قبل در گردش نامه بودند اعلان تکراری نمی‌گیرند. اگر نامه را به دستور کار وصل کرده‌اید ولی گیرنده‌ای هنوز خطای دسترسی می‌گیرد،
                    یک‌بار صفحهٔ دستور کار را باز کنید؛ سامانه دسترسی‌های ناقصِ قبلی را برای هر سه نوع نامه خودکار
                    اصلاح می‌کند.
                </span>
            </div>
        </div>
        <div class="guide-note info">
            <i class="bi bi-person-check"></i>
            <div>
                <strong>ساختن دستور کار، نامه را در «دریافتی» خودتان نمی‌گذارد</strong>
                <span>
                    وقتی روی یک نامه دستور کار می‌سازید (برای خودتان یا دیگران)، سامانه شما را به گردش آن نامه اضافه
                    نمی‌کند؛ پس نامه دوباره در صندوق <b>«دریافتی»</b> خودتان ظاهر نمی‌شود. این قاعده حتی وقتی
                    خودتان را به‌عنوان <b>گیرنده</b> انتخاب کنید هم برقرار است: دستور کار در تب «محول به من» دیده
                    می‌شود، ولی نامه به دریافتی شما اضافه نمی‌شود. همچنین <b>ثبت‌کنندهٔ نامه</b> به‌صورت خودکار به
                    گردش نامهٔ خودش اضافه نمی‌شود؛ فقط افراد دیگر (گیرندگان دستور کار) برای بازکردن نامه ارجاع
                    می‌گیرند. ردیف‌های اشتباهِ ساخته‌شده در نسخه‌های قبلی، با یک‌بار باز کردن صفحهٔ دستور کار
                    خودکار پاک می‌شوند.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-respond" Index="4" Title="دریافت و پاسخ گیرنده" Kicker="انجام کار">
        <ol class="instruction-list">
            <li><span>۱</span><div>تب <b>«محول به من»</b> کارهایی را نشان می‌دهد که به شما واگذار شده است؛ شمارندهٔ کنار هر ردیف تعداد پاسخ‌ها را نشان می‌دهد.</div></li>
            <li><span>۲</span><div>با باز کردن دستور کار، وضعیت «دیده شد» ثبت می‌شود؛ دستوردهنده می‌فهمد کار خوانده شده است.</div></li>
            <li><span>۳</span><div>در بخش گیرندگان، پاسخ خود را با <b>«انجام شد»</b> یا <b>«انجام نشد»</b> و شرح نتیجه ثبت کنید.</div></li>
            <li><span>۴</span><div>در صورت نیاز پیوست اضافه کنید یا در <b>گفتگو</b> سؤال و توضیح بگذارید؛ همهٔ رویدادها در تاریخچه ثبت می‌شود.</div></li>
        </ol>
        <div class="guide-note">
            <i class="bi bi-info-circle-fill"></i>
            <div>
                <strong>پاسخ یک‌بار ثبت می‌شود</strong>
                <span>پس از ثبت پاسخ، امکان ویرایش آن از سوی گیرنده وجود ندارد؛ اگر نیاز به اصلاح بود، دستوردهنده می‌تواند دستور کار را بازگشایی کند.</span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-decide" Index="5" Title="تأیید، بستن و بازگشایی" Kicker="عملیات دستوردهنده">
        <div class="table-wrap">
            <table class="guide-table">
                <thead>
                    <tr><th>عملیات</th><th>کاربرد</th></tr>
                </thead>
                <tbody>
                    <tr><td>تأیید / رد پاسخ</td><td>برای هر گیرنده، پاسخ او را با یادداشت اختیاری تأیید یا رد کنید.</td></tr>
                    <tr><td>تمدید مهلت</td><td>تاریخ/ساعت مقرر را جابه‌جا کنید؛ تا <b>۵ بار</b> برای هر دستور کار امکان‌پذیر است.</td></tr>
                    <tr><td>افزودن نفر به گردش</td><td>گیرندهٔ جدید به دستور کارِ باز اضافه کنید.</td></tr>
                    <tr><td>بستن نهایی</td><td>با یادداشت بستن؛ پس از تصمیم همهٔ گیرندگان امکان‌پذیر است.</td></tr>
                    <tr><td>بازگشایی</td><td>دستور کار بسته را دوباره باز کنید؛ می‌توانید پاسخ‌ها و تأییدهای قبلی گیرندگان را <b>باطل</b> کنید یا نگه دارید.</td></tr>
                    <tr><td>بایگانی و حذف</td><td>دستور کار تمام‌شده را بایگانی کنید تا فهرست کارهای جاری خلوت بماند.</td></tr>
                </tbody>
            </table>
        </div>
        <div class="guide-note">
            <i class="bi bi-check2-all"></i>
            <div>
                <strong>کار تا تأیید نهایی بسته نمی‌شود</strong>
                <span>حتی اگر همهٔ گیرندگان «انجام شد» بزنند، تا تصمیم دستوردهنده وضعیت دستور کار باز می‌ماند؛ این چرخه کیفیت خروجی را کنترل می‌کند.</span>
            </div>
        </div>
        <div class="guide-note info">
            <i class="bi bi-table"></i>
            <div>
                <strong>ستون «تصمیم دستوردهنده» در فهرست</strong>
                <span>
                    در فهرست دستور کار (نمای دسکتاپ و کارت موبایل) ستونی به همین نام اضافه شده است که وضعیت تصمیم
                    دستوردهنده را بدون باز کردن جزئیات نشان می‌دهد: <b>✔ تأیید</b> (آبی)، <b>✖ رد</b> (قرمز) و
                    <b>… بی‌تصمیم</b> (زرد) برای پاسخ‌هایی که هنوز تصمیمی نگرفته‌اند. اگر هیچ گیرنده‌ای پاسخ نداده باشد،
                    «در انتظار پاسخ» نمایش داده می‌شود. با نگه‌داشتن نشانگر روی هر نشان، نام افراد و یادداشت تصمیم
                    دیده می‌شود. همین ستون در خروجی اکسل و PDF هم آمده است.
                </span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-views" Index="6" Title="نماها: کانبان، تقویم و گزارش‌ها" Kicker="پیگیری">
        <div class="anatomy-grid">
            <article class="anatomy-card violet">
                <span class="card-icon"><i class="bi bi-kanban"></i></span>
                <h3>کانبان</h3>
                <p>ستون‌ها بر اساس اولویت؛ کارت‌ها را می‌کشید و رها می‌کنید تا اولویت تغییر کند (این جابه‌جایی برای دستوردهنده فعال است).</p>
            </article>
            <article class="anatomy-card blue">
                <span class="card-icon"><i class="bi bi-calendar3"></i></span>
                <h3>تقویم</h3>
                <p>مهلت‌ها را روی تقویم ببینید؛ کارهای نزدیک به مهلت و دیرکردها راحت‌تر پیدا می‌شوند.</p>
            </article>
            <article class="anatomy-card green">
                <span class="card-icon"><i class="bi bi-bar-chart"></i></span>
                <h3>داشبورد و عملکرد</h3>
                <p>وضعیت دستور کار، اولویت دستورهای باز و عملکرد گیرندگان؛ «عملکرد افراد» بازهٔ ۳۰/۹۰/۳۶۵ روز و خروجی CSV/Excel دارد.</p>
            </article>
        </div>
        <div class="guide-note info">
            <i class="bi bi-lock"></i>
            <div>
                <strong>گزارش برای هر کاربر فقط دادهٔ خودش</strong>
                <span>اعداد داشبورد و عملکرد، بر پایهٔ دستورهای شما و کارهایی است که به شما محول شده؛ برای مقایسهٔ عملکرد بین افراد از سطح دسترسی مدیریتی استفاده کنید.</span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-projects" Index="7" Title="پروژهٔ کاری و وزن" Kicker="تجمیع">
        <p>
            از صفحهٔ <b>«پروژه‌های کاری»</b> می‌توانید پروژه بسازید و دستور کارها را به آن وصل کنید. با تعیین
            <b>وزن</b> هر دستور کار، درصد پیشرفت پروژه بر اساس کارهای واقعاً بسته‌شده محاسبه می‌شود؛ بنابراین
            پروژه‌ای که چند کار سنگین دارد، پیشرفت واقعی‌تری نشان می‌دهد.
        </p>
        <div class="guide-note">
            <i class="bi bi-bullseye"></i>
            <div>
                <strong>پیشنهاد</strong>
                <span>برای کارهای روزمره وزن کم و برای تحویل‌دادنی‌های کلیدی وزن بیشتر بگذارید تا درصد پیشرفت گویا باشد.</span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-filter" Index="8" Title="جستجو، فیلتر و خروجی" Kicker="یافتن سریع">
        <ul>
            <li><b>جستجو:</b> در شماره، عنوان یا نام دستوردهنده.</li>
            <li><b>فیلترها:</b> اولویت، برچسب، پروژه و <b>تصمیم دستوردهنده</b>؛ برای حذف فیلترها گزینهٔ «همه» همان گروه را بزنید.</li>
            <li><b>فیلتر تصمیم دستوردهنده:</b> «✔ تأییدشده» دستورهایی را می‌آورد که دست‌کم یک پاسخ تأیید شده دارد، «✖ ردشده» دست‌کم یک رد، «… بی‌تصمیم» پاسخ‌هایی که هنوز تأیید/رد نشده‌اند و «⏳ در انتظار پاسخ» دستورهایی که گیرنده دارند ولی پاسخی ثبت نشده است.
                در تب <b>«محول به من»</b> ملاک، سهم <b>خودِ شما</b> است: «در انتظار پاسخ» یعنی شما هنوز پاسخ نداده‌اید (حتی اگر همکاری پاسخ داده باشد) و «بی‌تصمیم/تأییدشده/ردشده» روی پاسخ خودتان حساب می‌شود.</li>
            <li><b>همهٔ فیلترها سمت سرور اعمال می‌شوند:</b> جستجو، اولویت، برچسب، پروژه و تصمیم دستوردهنده روی <b>کل دستورهای آن تب</b> اجرا می‌شوند، نه فقط ۱۰ ردیف همان صفحه؛ عدد کنار نتیجه هم «تعداد کل با فیلتر فعلی» را نشان می‌دهد. اگر با فیلترها نتیجه‌ای نبود، دکمهٔ «پاک‌کردن فیلترها» ظاهر می‌شود.</li>
            <li><b>صفحه‌بندی:</b> دکمه‌های اول/قبلی/بعدی/آخر و حداکثر ۷ شمارهٔ صفحه؛ زیر آن بازهٔ نمایش («نمایش ۱ تا ۱۰ از ۵۷») نوشته می‌شود. تغییر هر فیلتر شما را به صفحهٔ اول برمی‌گرداند.</li>
            <li><b>خروجی:</b> دکمه‌های «اکسل» و «PDF» همان فیلترهای جاری (از جمله فیلتر تصمیم دستوردهنده) را خروجی می‌گیرند.</li>
            <li><b>عملیات گروهی:</b> با تیک‌زدن چند دستور کار در تب‌های «دستورهای من» و «محول به من»، بایگانی یا حذف گروهی انجام می‌شود.</li>
        </ul>
        <div class="guide-note info">
            <i class="bi bi-123"></i>
            <div>
                <strong>شمارندهٔ تب‌ها بر اساس «سطر دستور کار» است</strong>
                <span>
                    عدد داخل دایرهٔ کنار «دستورهای من»، «محول به من» و «بایگانی» تعداد
                    <b>سطر دستور کار</b> است — هر دستور کار دقیقاً یک عدد، حتی اگر چند گیرنده داشته باشد.
                    این عدد از تعداد گیرندگان، پاسخ‌ها یا افراد در گردش گرفته نمی‌شود و با فیلترها هم تغییر
                    نمی‌کند (همیشه کل آن تب را می‌گوید). دستور کاری که هم شما صادر کرده‌اید و هم خودتان
                    گیرندهٔ آن هستید، در هر دو تب یک بار شمرده می‌شود.
                </span>
            </div>
        </div>
        <div class="guide-note">
            <i class="bi bi-arrow-repeat"></i>
            <div>
                <strong>به‌روزرسانی زنده</strong>
                <span>با ثبت، پاسخ یا تغییر وضعیت هر دستور کار، فهرست و شمارنده‌ها بدون رفرش دستی به‌روز می‌شوند.</span>
            </div>
        </div>
    </OfficeGuideSection>

    <OfficeGuideSection Id="wo-faq" Index="9" Title="پرسش‌های متداول" Kicker="رفع ابهام">
        <div class="faq-list">
            <details open>
                <summary>دستور کار من بسته نمی‌شود؛ چرا؟ <i class="bi bi-chevron-down"></i></summary>
                <p>بسته‌شدن به دو چیز بستگی دارد: پاسخ همهٔ گیرندگان و تصمیم دستوردهنده. بخش «گیرندگان» را باز کنید و ببینید چه کسی هنوز پاسخ نداده یا کدام پاسخ هنوز تأیید/رد نشده است.</p>
            </details>
            <details>
                <summary>تفاوت «اولویت» و «مهلت» چیست؟ <i class="bi bi-chevron-down"></i></summary>
                <p>اولویت اهمیت و ترتیب رسیدگی را می‌گوید و ستون‌های کانبان را می‌سازد؛ مهلت، زمان مقرر انجام است و مبنای محاسبهٔ دیرکرد در گزارش‌ها. یک کار می‌تواند اولویت بالا و مهلت دور داشته باشد.</p>
            </details>
            <details>
                <summary>چرا نمی‌توانم برای دیگران دستور کار ثبت کنم؟ <i class="bi bi-chevron-down"></i></summary>
                <p>انتخاب گیرندهٔ دلخواه به مجوز «تعیین گیرندهٔ دیگران» نیاز دارد. در غیر این صورت فقط دستورهای مربوط به خودتان در دسترس است؛ با مسئول سامانه هماهنگ کنید.</p>
            </details>
            <details>
                <summary>دستور کار را اشتباهی بستم؛ چه کنم؟ <i class="bi bi-chevron-down"></i></summary>
                <p>دستوردهنده می‌تواند دستور کار را بازگشایی کند؛ اگر پاسخ‌ها و تأییدهای قبلی معتبر نیستند، گزینهٔ «ابطال پاسخ‌های قبلی» را فعال کنید تا گیرندگان دوباره پاسخ دهند.</p>
            </details>
            <details>
                <summary>پیامک برای گیرنده ارسال نشد؛ چرا؟ <i class="bi bi-chevron-down"></i></summary>
                <p>ارسال پیامک به تنظیم سرویس پیامک در سامانه بستگی دارد. اگر گزینهٔ پیامک در فرم غیرفعال است، ابتدا تنظیمات پیامک را بررسی کنید.</p>
            </details>
            <details>
                <summary>کارهای تکراری چگونه ساخته می‌شوند؟ <i class="bi bi-chevron-down"></i></summary>
                <p>در فرم ثبت، «تکرار» را روی روزانه/هفتگی/ماهانه بگذارید؛ نسخهٔ بعدی در زمان مقرر خودکار ساخته می‌شود و در تاریخچهٔ دستور کار ثبت می‌گردد.</p>
            </details>
            <details>
                <summary>دکمهٔ «ثبت دستور کار» را دو بار زدم؛ دو دستور کار ثبت می‌شود؟ <i class="bi bi-chevron-down"></i></summary>
                <p>نه. دکمه پس از اولین کلیک قفل می‌شود و سامانه هم همان درخواست را در چند ثانیهٔ بعد تکراری می‌شناسد؛ در این حالت فقط پیام «این دستور کار همین لحظه ثبت شده بود» نمایش داده می‌شود و دستور کار دوم ساخته نمی‌شود. اگر واقعاً دو دستور کار با همان عنوان و همان گیرندگان می‌خواهید، فرم را دوباره باز کنید و متن یا مهلت را تغییر دهید.</p>
            </details>
        </div>
    </OfficeGuideSection>

</OfficeGuide>

