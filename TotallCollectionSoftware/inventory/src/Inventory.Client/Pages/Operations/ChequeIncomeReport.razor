@page "/operations/reports/cheque-income"
@inject IAuthState Auth
@inject IOrderService OrderSvc
@inject IPartyService PartySvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>گزارش تاخیر تادیه چک</PageTitle>

@if (!Auth.CanSee("Orders") || !Auth.Has("Orders.ViewProfit"))
{
    <div class="alert alert-warning mt-3">برای مشاهدهٔ این گزارش، دسترسی اسناد فروش و مشاهدهٔ سود لازم است.</div>
}
else
{
    <div class="container-fluid py-3" style="max-width: 1440px;">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
            <div>
                <h1 class="h4 fw-bold mb-1">گزارش تاخیر تادیه چک</h1>
                <p class="text-muted fs-8 mb-0">گردش درآمد فروشگاه بر اساس تاریخ عملیات و مشتری؛ مبالغ منفی نشان‌دهنده کاهش یا برگشت درآمد هستند</p>
            </div>
            <div class="d-flex gap-2 d-print-none">
                <a class="btn btn-outline-secondary btn-sm" href="/operations/reports/orders/sale">گزارش فروش</a>
                <button class="btn btn-outline-primary btn-sm" disabled="@(report is null || loading)" @onclick="Print"><i class="bi bi-printer"></i> چاپ</button>
            </div>
        </div>
        <div class="card border-0 shadow-sm mb-3 d-print-none">
            <div class="card-body">
                <div class="row g-2 align-items-end">
                    <div class="col-6 col-md-3"><label class="form-label fs-8">از تاریخ</label><DatePicker @bind-Value="from" AllowClear="true" /></div>
                    <div class="col-6 col-md-3"><label class="form-label fs-8">تا تاریخ</label><DatePicker @bind-Value="to" AllowClear="true" /></div>
                    <div class="col-8 col-md-4"><label class="form-label fs-8">مشتری</label><SearchSelect Items="parties" Value="partyId" ValueChanged="v => partyId = v" Placeholder="همهٔ مشتریان" /></div>
                    <div class="col-4 col-md-2"><button class="btn btn-primary w-100" disabled="@loading" @onclick="Load">اعمال فیلتر</button></div>
                </div>
            </div>
        </div>
        @if (loading)
        {
            <div class="card border-0 shadow-sm p-4 text-center text-muted" role="status"><span class="spinner-border spinner-border-sm me-2"></span>در حال بارگذاری گردش‌ها</div>
        }
        else if (report is not null)
        {
            <div class="card border-0 shadow-sm mb-3">
                <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <span class="text-muted">خالص درآمد دوره</span>
                    <strong class="num fs-5" dir="ltr">@report.TotalIncome.MoneyExact() <small class="fs-8 text-muted">ریال</small></strong>
                </div>
            </div>
            <div class="card border-0 shadow-sm">
                @if (report.Rows.Count == 0)
                {
                    <div class="card-body text-center text-muted py-5"><i class="bi bi-receipt fs-3 d-block mb-2"></i>گردش قطعی برای فیلتر انتخاب‌شده وجود ندارد.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light"><tr><th>تاریخ گردش</th><th>مشتری</th><th>فاکتور فروش</th><th>شناسه گردش</th><th>نوع گردش</th><th class="text-start">بستانکاری درآمد فروشگاه (ریال)</th></tr></thead>
                            <tbody>
                            @foreach (var row in report.Rows)
                            {
                                <tr>
                                    <td class="num">@row.Date.ToFa()</td><td>@row.PartyName</td><td class="num">@row.SaleNumber</td>
                                    <td class="num">@row.EventId.Num()</td><td>@KindTitle(row.Kind)</td>
                                    <td class="num text-start @(row.Income < 0 ? "text-danger" : "")" dir="ltr">@row.Income.MoneyExact()</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private DateTime? from = DateTime.Today.AddDays(-30);
    private DateTime? to = DateTime.Today;
    private int partyId;
    private bool loading = true;
    private List<LookupItem> parties = new();
    private ChequeIncomeReportDto? report;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("گزارش تاخیر تادیه چک");
        if (!Auth.CanSee("Orders") || !Auth.Has("Orders.ViewProfit")) { loading = false; return; }
        try { parties = (await OrderSvc.GetInvoicePartiesAsync(TransactionType.Sale))
            .Select(p => new LookupItem { Id = p.Id, Name = p.Name }).ToList(); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try { report = await OrderSvc.GetChequeIncomeReportAsync(from, to, partyId); }
        catch (Exception ex) { report = null; Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");
    private static string KindTitle(SaleChequeChargeEventKind kind) => kind switch
    {
        SaleChequeChargeEventKind.Initial => "سود اولیه چک فاکتور",
        SaleChequeChargeEventKind.DueDateAdjustment => "تغییر سررسید",
        SaleChequeChargeEventKind.GoodsReturn => "برگشت کالا",
        SaleChequeChargeEventKind.Cancellation => "ابطال فاکتور",
        _ => "سایر"
    };
}
