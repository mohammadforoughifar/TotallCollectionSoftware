@page "/operations/reports/party-statements"
@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject IPartyService PartySvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>گزارش گردش حساب و مانده اشخاص (طلب و بدهی)</PageTitle>

<div class="fin-page-container fade-in">
    <!-- ================== سربرگ لوکس و هوشمند ================== -->
    <div class="fin-header mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
            <div class="d-flex align-items-center gap-3">
                <div class="fin-header-icon">
                    <i class="bi bi-wallet2"></i>
                </div>
                <div>
                    <div class="d-flex align-items-center gap-2">
                        <h1 class="h4 fw-800 text-dark mb-0">گزارش طلب و بدهی و گردش حساب اشخاص</h1>
                        <span class="badge rounded-pill fin-badge-status">دفتر معین اشخاص</span>
                    </div>
                    <div class="text-secondary fs-8 mt-1">
                        پایش مطالبات وصول‌نشده، دیون به تأمین‌کنندگان، اثر مانده افتتاحیه و ریز تراکنش‌ها
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2 align-items-center flex-wrap">
                @if (selectedPartyDetail != null)
                {
                    <button class="btn btn-outline-secondary fin-btn-pill" @onclick="() => selectedPartyDetail = null">
                        <i class="bi bi-arrow-right me-1"></i> بازگشت به فهرست اشخاص
                    </button>
                    <button class="btn btn-primary fin-btn-pill" @onclick="PrintStatement">
                        <i class="bi bi-printer-fill me-1"></i> چاپ رسمی صورت‌حساب
                    </button>
                }
                else
                {
                    <button class="btn btn-outline-primary fin-btn-pill" @onclick="LoadReportAsync" disabled="@loading">
                        <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i> به‌روزرسانی داده‌ها
                    </button>
                }
            </div>
        </div>
    </div>

@if (selectedPartyDetail == null)
{
    @* ==================== حالت نمایش کلی (خلاصه اشخاص) ==================== *@
    @if (reportData != null)
    {
        <!-- کارت‌های شاخص‌های مالی با سبک جدید -->
        <div class="row g-3 mb-4">
            <!-- کارت مطالبات -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-rose">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-rose">کل مطالبات (طلب ما)</span>
                            <div class="fin-kpi-value text-rose num mt-1">@reportData.TotalReceivable.Money()</div>
                            <div class="fin-kpi-unit">ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-rose-subtle text-rose">
                            <i class="bi bi-arrow-down-left-circle-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-rose-subtle text-rose rounded-pill px-2.5">
                            <i class="bi bi-people-fill me-1"></i> @reportData.DebtorCount.Num() شخص بدهکار
                        </span>
                    </div>
                </div>
            </div>

            <!-- کارت بدهی‌ها -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-emerald">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-emerald">کل بدهی‌ها (بستانکاری اشخاص)</span>
                            <div class="fin-kpi-value text-emerald num mt-1">@reportData.TotalPayable.Money()</div>
                            <div class="fin-kpi-unit">ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-emerald-subtle text-emerald">
                            <i class="bi bi-arrow-up-right-circle-fill"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge bg-emerald-subtle text-emerald rounded-pill px-2.5">
                            <i class="bi bi-person-check-fill me-1"></i> @reportData.CreditorCount.Num() شخص بستانکار
                        </span>
                    </div>
                </div>
            </div>

            <!-- تراز خالص -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-indigo">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-indigo">تراز خالص مطالبات / بدهی</span>
                            <div class="fin-kpi-value @(reportData.NetBalance >= 0 ? "text-indigo" : "text-amber") num mt-1">
                                @Math.Abs(reportData.NetBalance).Money()
                            </div>
                            <div class="fin-kpi-unit">ریال</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-indigo-subtle text-indigo">
                            <i class="bi bi-scale"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="badge @(reportData.NetBalance >= 0 ? "bg-indigo-subtle text-indigo" : "bg-amber-subtle text-amber") rounded-pill px-2.5">
                            @(reportData.NetBalance >= 0 ? "تراز مثبت (مازاد مطالبات)" : "تراز منفی (مازاد بدهی‌ها)")
                        </span>
                    </div>
                </div>
            </div>

            <!-- کل اشخاص -->
            <div class="col-12 col-sm-6 col-xl-3">
                <div class="fin-kpi-card border-slate">
                    <div class="d-flex justify-content-between align-items-start">
                        <div>
                            <span class="fin-kpi-title text-slate">کل طرف‌حساب‌های فعال</span>
                            <div class="fin-kpi-value text-dark num mt-1">@reportData.Items.Count.Num()</div>
                            <div class="fin-kpi-unit">طرف حساب ثبت‌شده</div>
                        </div>
                        <div class="fin-kpi-icon-box bg-slate-subtle text-slate">
                            <i class="bi bi-journal-text"></i>
                        </div>
                    </div>
                    <div class="fin-kpi-footer mt-3 pt-2">
                        <span class="text-secondary fs-9">شامل کلیه مشتریان و تأمین‌کنندگان</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- نوار فیلترهای ارگونومیک و مدرن -->
    <div class="fin-filter-card mb-4">
        <div class="row g-2.5 align-items-end">
            <div class="col-12 col-md-4 col-xl-3">
                <label class="fin-label">جستجوی شخص یا شماره تماس</label>
                <div class="input-group input-group-sm">
                    <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input class="form-control border-start-0 fin-input" placeholder="نام مشتری، تأمین‌کننده یا موبایل..."
                           @bind="searchTerm" @bind:event="oninput" @onkeyup="OnSearchKey" />
                </div>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="fin-label">دسته‌بندی شخص</label>
                <select class="form-select form-select-sm fin-input" @bind="selectedTypeStr" @bind:after="LoadReportAsync">
                    <option value="">همه اشخاص</option>
                    <option value="0">فقط مشتریان</option>
                    <option value="1">فقط تأمین‌کنندگان</option>
                </select>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="fin-label">وضعیت مانده حساب</label>
                <select class="form-select form-select-sm fin-input" @bind="balanceFilter" @bind:after="ApplyBalanceFilter">
                    <option value="all">همه وضعیت‌ها</option>
                    <option value="debtors">فقط بدهکاران (طلب ما)</option>
                    <option value="creditors">فقط بستانکاران (بدهی ما)</option>
                    <option value="nonzero">فقط حساب‌های باز (غیرصفر)</option>
                </select>
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="fin-label">از تاریخ</label>
                <DatePicker @bind-Value="fromDate" />
            </div>

            <div class="col-6 col-md-3 col-xl-2">
                <label class="fin-label">تا تاریخ</label>
                <DatePicker @bind-Value="toDate" />
            </div>

            <div class="col-12 col-xl-1">
                <button class="btn btn-primary w-100 fin-btn-submit" @onclick="LoadReportAsync" disabled="@loading">
                    <i class="bi bi-funnel-fill"></i>
                </button>
            </div>
        </div>
    </div>

    <!-- جدول خلاصه مانده‌های کلی اشخاص -->
    <div class="fin-table-card">
        <div class="fin-table-header">
            <div class="d-flex align-items-center gap-2">
                <div class="fin-table-header-icon bg-indigo-subtle text-indigo">
                    <i class="bi bi-people-fill"></i>
                </div>
                <div>
                    <h3 class="fin-table-title">صورت وضعیت اشخاص و مانده نهایی</h3>
                    <p class="fin-table-sub">نمایش به تفکیک مانده افتتاحیه اول دوره، گردش بدهکار و بستانکار و مانده نهایی</p>
                </div>
            </div>
            <div class="num fs-8 fw-700 text-secondary">
                نمایش @filteredItems.Count.Num() شخص
            </div>
        </div>

        @if (loading)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                <div class="text-secondary fw-500 fs-8">در حال محاسبه گردش و مانده حساب‌ها...</div>
            </div>
        }
        else if (filteredItems.Count == 0)
        {
            <div class="fin-empty-state text-center py-5">
                <i class="bi bi-inbox fs-1 text-muted opacity-50"></i>
                <div class="fw-bold text-secondary mt-2">هیچ شخصی با فیلترهای جاری یافت نشد</div>
                <div class="fs-8 text-muted mt-1">می‌توانید عبارات جستجو را تغییر دهید یا فیلترها را حذف کنید.</div>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table fin-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 45px;" class="text-center">#</th>
                            <th>طرف حساب</th>
                            <th>نوع شخص</th>
                            <th>اطلاعات تماس</th>
                            <th class="text-start">مانده افتتاحیه</th>
                            <th class="text-start">گردش بدهکار (افزایش)</th>
                            <th class="text-start">گردش بستانکار (کاهش)</th>
                            <th class="text-start">مانده نهایی</th>
                            <th class="text-center">وضعیت حساب</th>
                            <th class="text-center" style="width: 100px;">عملیات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int idx = 1; }
                        @foreach (var item in filteredItems)
                        {
                            <tr class="fin-table-row">
                                <td class="text-center num text-muted fs-8">@Fa.Digits(idx++)</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="fin-avatar">
                                            @item.PartyName.Substring(0, Math.Min(1, item.PartyName.Length))
                                        </div>
                                        <div>
                                            <div class="fw-800 text-dark fs-7.5">@item.PartyName</div>
                                            @if (!string.IsNullOrWhiteSpace(item.NationalCode))
                                            {
                                                <div class="num fs-9 text-muted">کد ملی: @item.NationalCode</div>
                                            }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(item.Type == PartyType.Customer ? "bg-info-subtle text-info border border-info-subtle" : "bg-purple-subtle text-purple border border-purple-subtle") rounded-pill px-2">
                                        @(item.Type == PartyType.Customer ? "مشتری" : "تأمین‌کننده")
                                    </span>
                                </td>
                                <td class="num fs-8 text-secondary">
                                    @(string.IsNullOrWhiteSpace(item.Mobile) ? "—" : item.Mobile)
                                </td>
                                <td class="text-start num fs-8">
                                    @if (item.OpeningBalance != 0)
                                    {
                                        <span class="fw-bold @(item.OpeningBalance > 0 ? "text-danger" : "text-success")">
                                            @Math.Abs(item.OpeningBalance).Money()
                                        </span>
                                        <small class="fs-9 text-muted ms-1">@(item.OpeningBalance > 0 ? "طلب" : "بدهی")</small>
                                    }
                                    else
                                    {
                                        <span class="text-muted">۰</span>
                                    }
                                </td>
                                <td class="text-start num fs-8 text-danger fw-500">
                                    @(item.TotalDebit > 0 ? item.TotalDebit.Money() : "۰")
                                </td>
                                <td class="text-start num fs-8 text-success fw-500">
                                    @(item.TotalCredit > 0 ? item.TotalCredit.Money() : "۰")
                                </td>
                                <td class="text-start num fs-7 fw-800">
                                    @if (item.ClosingBalance != 0)
                                    {
                                        <span class="@(item.IsDebtor ? "text-danger" : "text-success")">
                                            @Math.Abs(item.ClosingBalance).Money()
                                        </span>
                                        <span class="fs-9 fw-normal text-muted ms-1">ریال</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary fw-normal">تسویه صفر</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.IsDebtor)
                                    {
                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2.5">
                                            <i class="bi bi-arrow-down-left me-1"></i> بدهکار (طلب ما)
                                        </span>
                                    }
                                    else if (item.IsCreditor)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle rounded-pill px-2.5">
                                            <i class="bi bi-arrow-up-right me-1"></i> بستانکار (بدهی ما)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary-subtle text-secondary rounded-pill px-2.5">
                                            تسویه کامل
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-outline-primary fin-btn-pill fs-8 px-2.5" @onclick="() => ViewPartyDetail(item.PartyId)">
                                        <i class="bi bi-file-earmark-text me-1"></i> ریز صورت‌حساب
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
}

else
{
    @* ==================== حالت نمایش ریز صورت‌حساب شخص (دفتر معین) ==================== *@
    <div class="fin-statement-view">
        <!-- کارت خلاصه مشخصات طرف حساب -->
        <div class="fin-statement-header-card mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="fin-avatar-lg">
                        @selectedPartyDetail.PartyName.Substring(0, Math.Min(1, selectedPartyDetail.PartyName.Length))
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h2 class="h5 fw-800 text-dark mb-0">صورت‌حساب مالی «@selectedPartyDetail.PartyName»</h2>
                            <span class="badge @(selectedPartyDetail.PartyType == PartyType.Customer ? "bg-info-subtle text-info" : "bg-purple-subtle text-purple") rounded-pill">
                                @(selectedPartyDetail.PartyType == PartyType.Customer ? "مشتری" : "تأمین‌کننده")
                            </span>
                        </div>
                        <div class="d-flex gap-3 text-secondary fs-8 mt-1.5 flex-wrap">
                            @if (!string.IsNullOrWhiteSpace(selectedPartyDetail.Mobile))
                            {
                                <span><i class="bi bi-telephone text-muted me-1"></i> شماره تماس: <b class="num">@selectedPartyDetail.Mobile</b></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(selectedPartyDetail.NationalCode))
                            {
                                <span><i class="bi bi-card-text text-muted me-1"></i> کد ملی: <b class="num">@selectedPartyDetail.NationalCode</b></span>
                            }
                            <span><i class="bi bi-calendar3 text-muted me-1"></i> تاریخ گزارش: <b class="num">@DateTime.Today.ToFa()</b></span>
                        </div>
                    </div>
                </div>

                <div class="fin-statement-kpi-badge @(selectedPartyDetail.ClosingBalance > 0 ? "badge-debtor" : (selectedPartyDetail.ClosingBalance < 0 ? "badge-creditor" : "badge-settled"))">
                    <div class="fin-statement-kpi-sub">مانده نهایی حساب</div>
                    <div class="fin-statement-kpi-val num">
                        @Math.Abs(selectedPartyDetail.ClosingBalance).MoneyExact() <small class="fs-8 fw-normal">ریال</small>
                    </div>
                    <div class="fin-statement-kpi-status">
                        @(selectedPartyDetail.ClosingBalance > 0 ? "بدهکار (طلب ما)" : (selectedPartyDetail.ClosingBalance < 0 ? "بستانکار (طلب شخص)" : "تسویه کامل"))
                    </div>
                </div>
            </div>
        </div>

        @if (selectedPartyDetail.PartyType == PartyType.Customer)
        {
            <div class="d-flex flex-wrap gap-3 mb-3 px-2 fs-8 text-secondary">
                <span>فروش کالا و خدمات با ارزش افزوده: <b class="num text-dark">@selectedPartyDetail.SaleGoodsTotal.MoneyExact()</b> ریال</span>
                <span>تخفیف فاکتورهای صادرشده دوره (پیش از برگشت): <b class="num text-dark">@selectedPartyDetail.SaleIssuedDiscountTotal.MoneyExact()</b> ریال</span>
                <span>تاخیر تادیه چک: <b class="num text-dark">@selectedPartyDetail.SaleChequeIncomeTotal.MoneyExact()</b> ریال</span>
            </div>
            <p class="fs-8 text-secondary px-2 mb-3">تاخیر تادیه چک در ریز صورت‌حساب، جدا از کالا و به‌عنوان بدهی مشتری آمده است. مبلغ چک هنگام ثبت وصول از بدهی کم می‌شود، نه صرفاً هنگام تحویل چک.</p>
        }

        <!-- جدول ریز تراکنش‌ها -->
        <div class="fin-table-card">
            <div class="fin-table-header">
                <div class="d-flex align-items-center gap-2">
                    <div class="fin-table-header-icon bg-primary-subtle text-primary">
                        <i class="bi bi-card-checklist"></i>
                    </div>
                    <div>
                        <h3 class="fin-table-title">گردش خط‌به‌خط اسناد و تسویه‌ها</h3>
                        <p class="fin-table-sub">ریز رویدادهای مالی به ترتیب تقدم زمانی و محاسبه لحظه‌ای مانده</p>
                    </div>
                </div>
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-secondary fin-btn-pill" @onclick="PrintStatement">
                        <i class="bi bi-printer me-1"></i> چاپ صورت‌حساب
                    </button>
                    <button class="btn btn-sm btn-secondary fin-btn-pill" @onclick="() => selectedPartyDetail = null">
                        <i class="bi bi-arrow-right me-1"></i> بازگشت
                    </button>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table fin-table align-middle">
                    <thead>
                        <tr>
                            <th style="width: 40px;" class="text-center">ردیف</th>
                            <th style="width: 100px;" class="text-center">تاریخ</th>
                            <th style="width: 100px;" class="text-center">شماره سند</th>
                            <th>عنوان رویداد / فاکتور</th>
                            <th>شرح سند</th>
                            <th class="text-start" style="width: 130px;">بدهکار (ریال)</th>
                            <th class="text-start" style="width: 130px;">بستانکار (ریال)</th>
                            <th class="text-start" style="width: 150px;">مانده لحظه‌ای (ریال)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rowNum = 1; }
                        @foreach (var r in selectedPartyDetail.Rows)
                        {
                            <tr class="fin-table-row @(r.IsOpening ? "fin-opening-row" : "")">
                                <td class="text-center num text-muted fs-8">@Fa.Digits(rowNum++)</td>
                                <td class="text-center num fs-8">@r.Date.ToFa()</td>
                                <td class="text-center num fs-8">@(string.IsNullOrWhiteSpace(r.DocumentNumber) ? "—" : r.DocumentNumber)</td>
                                <td>
                                    @if (r.IsOpening)
                                    {
                                        <span class="badge bg-warning-subtle text-amber border border-warning-subtle rounded-pill px-2.5 me-1">
                                            <i class="bi bi-star-fill me-1"></i> مانده افتتاحیه
                                        </span>
                                    }
                                    <span class="fw-700 text-dark fs-8">@r.Title</span>
                                </td>
                                <td class="text-secondary fs-8">
                                    @r.Description
                                    @if (r.SaleInvoiceDiscount is decimal discount)
                                    {
                                        <div class="text-muted">تخفیف فاکتور: <b class="num">@discount.MoneyExact()</b> ریال (در مبلغ لحاظ شده)</div>
                                    }
                                </td>
                                <td class="text-start num fs-8 @(r.Debit > 0 ? "text-danger fw-700" : "text-muted")">
                                    @(r.Debit > 0 ? r.Debit.MoneyExact() : "۰")
                                </td>
                                <td class="text-start num fs-8 @(r.Credit > 0 ? "text-success fw-700" : "text-muted")">
                                    @(r.Credit > 0 ? r.Credit.MoneyExact() : "۰")
                                </td>
                                <td class="text-start num fs-8 fw-800 @(r.Balance > 0 ? "text-danger" : (r.Balance < 0 ? "text-success" : "text-muted"))">
                                    @Math.Abs(r.Balance).MoneyExact()
                                    <small class="fs-9 ms-1 @(r.Balance > 0 ? "badge bg-danger-subtle text-danger" : (r.Balance < 0 ? "badge bg-success-subtle text-success" : ""))">
                                        @(r.Balance > 0 ? "بد" : (r.Balance < 0 ? "بس" : "—"))
                                    </small>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr class="fin-table-total-row">
                            <td colspan="5" class="text-end fw-800 fs-7.5">جمع کل گردش دوره:</td>
                            <td class="text-start num text-danger fw-800 fs-7.5">@selectedPartyDetail.TotalDebit.MoneyExact()</td>
                            <td class="text-start num text-success fw-800 fs-7.5">@selectedPartyDetail.TotalCredit.MoneyExact()</td>
                            <td class="text-start num fw-900 fs-7 @(selectedPartyDetail.ClosingBalance > 0 ? "text-danger" : "text-success")">
                                @Math.Abs(selectedPartyDetail.ClosingBalance).MoneyExact()
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}
</div>


