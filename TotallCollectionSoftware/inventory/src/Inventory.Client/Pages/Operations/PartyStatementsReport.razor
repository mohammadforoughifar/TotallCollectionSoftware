@code {
    private bool loading = true;
    private PartyStatementReportDto? reportData;
    private List<PartyBalanceSummaryDto> filteredItems = new();
    private PartyStatementDetailDto? selectedPartyDetail;

    private string searchTerm = "";
    private string selectedTypeStr = "";
    private string balanceFilter = "all";
    private DateTime? fromDate;
    private DateTime? toDate;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("گزارش طلب و بدهی (گردش حساب اشخاص)");
        await LoadReportAsync();
    }

    private async Task LoadReportAsync()
    {
        loading = true;
        try
        {
            PartyType? t = string.IsNullOrEmpty(selectedTypeStr) ? null : (PartyType)int.Parse(selectedTypeStr);
            reportData = await PartySvc.GetPartyStatementsSummaryAsync(t, fromDate, toDate, searchTerm);
            ApplyBalanceFilter();
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در بارگذاری گزارش: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private void ApplyBalanceFilter()
    {
        if (reportData == null) return;
        var q = reportData.Items.AsEnumerable();

        if (balanceFilter == "debtors")
            q = q.Where(x => x.IsDebtor);
        else if (balanceFilter == "creditors")
            q = q.Where(x => x.IsCreditor);
        else if (balanceFilter == "nonzero")
            q = q.Where(x => !x.IsSettled);

        filteredItems = q.ToList();
    }

    private async Task OnSearchKey(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadReportAsync();
    }

    private async Task ViewPartyDetail(int partyId)
    {
        loading = true;
        try
        {
            selectedPartyDetail = await PartySvc.GetPartyStatementDetailAsync(partyId, fromDate, toDate);
        }
        catch (Exception ex)
        {
            Toast.Error("خطا در بارگذاری صورت‌حساب: " + ex.Message);
        }
        finally
        {
            loading = false;
        }
    }

    private async Task PrintStatement()
    {
        await JS.InvokeVoidAsync("print");
    }
}
