}
.fin-table-total-row {
    background: #f8fafc;
    border-top: 2px solid #cbd5e1;
}
.fin-table-total-row td {
    padding: 1rem 0.9rem;
}

.fin-avatar {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #eef2ff;
    color: #4f46e5;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 0.82rem;
    flex-shrink: 0;
}
.fin-avatar-lg {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-weight: 800;
    font-size: 1.4rem;
    flex-shrink: 0;
}

/* صفحه صورت‌حساب شخص */
.fin-statement-header-card {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.04);
}
.fin-statement-kpi-badge {
    padding: 0.85rem 1.4rem;
    border-radius: 14px;
    text-align: left;
    min-width: 220px;
}
.fin-statement-kpi-badge.badge-debtor {
    background: #fef2f2;
    border: 1.5px solid #fecaca;
    color: #b91c1c;
}
.fin-statement-kpi-badge.badge-creditor {
    background: #f0fdf4;
    border: 1.5px solid #bbf7d0;
    color: #15803d;
}
.fin-statement-kpi-badge.badge-settled {
    background: #f8fafc;
    border: 1.5px solid #e2e8f0;
    color: #475569;
}
.fin-statement-kpi-sub {
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0.85;
}
.fin-statement-kpi-val {
    font-size: 1.45rem;
    font-weight: 900;
    line-height: 1.2;
    margin: 0.15rem 0;
}
.fin-statement-kpi-status {
    font-size: 0.74rem;
    font-weight: 700;
}

.fin-opening-row {
    background: #fffbeb !important;
}
.fin-opening-row:hover {
    background: #fef3c7 !important;
}

.text-rose { color: #e11d48 !important; }
.bg-rose-subtle { background-color: #ffe4e6 !important; }
.text-emerald { color: #059669 !important; }
.bg-emerald-subtle { background-color: #d1fae5 !important; }
.text-indigo { color: #4f46e5 !important; }
.bg-indigo-subtle { background-color: #eef2ff !important; }
.text-amber { color: #d97706 !important; }
.bg-amber-subtle { background-color: #fef3c7 !important; }
.text-slate { color: #475569 !important; }
.bg-slate-subtle { background-color: #f1f5f9 !important; }
.text-purple { color: #7c3aed !important; }
.bg-purple-subtle { background-color: #ede9fe !important; }

.spin {
    animation: finSpin 0.7s linear infinite;
}
@@keyframes finSpin {
    from { transform: rotate(0deg); }
    to { transform: rotate(360deg); }
}

.fade-in {
    animation: finFadeIn 0.25s ease-in-out;
}
@@keyframes finFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
}
