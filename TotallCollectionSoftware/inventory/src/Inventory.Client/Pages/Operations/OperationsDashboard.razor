@code {
    private ElementReference printRoot;

    private bool CanOpenDashboard => Auth.CanSee("Orders") || Auth.CanSee("Repairs");
    private OperationsDashboardDto? data;
    private DateTime? from = DateTime.Today.AddDays(-30);
    private DateTime? to = DateTime.Today;
    private bool loading = true;

    private string RangeText => $"{(from.HasValue ? from.Value.ToFa() : "از ابتدا")} تا {(to.HasValue ? to.Value.ToFa() : "امروز")}";
    private string TrendPeriod => data?.Trend.Any(p => p.Label.Contains('/')) == true ? "روزانه" : "ماهانه";
    private IEnumerable<decimal> ChartValues => data is null ? Enumerable.Empty<decimal>() : data.Trend.SelectMany(p =>
        (Auth.CanSee("Orders") ? new[] { p.Purchase, p.Sale } : Array.Empty<decimal>())
        .Concat(Auth.CanSee("Repairs") ? new[] { p.RepairRevenue } : Array.Empty<decimal>()));
    private decimal ChartMax => Math.Max(0m, ChartValues.DefaultIfEmpty(0m).Max());
    private decimal ChartMin => Math.Min(0m, ChartValues.DefaultIfEmpty(0m).Min());
    private decimal ChartRange => Math.Max(1m, ChartMax - ChartMin);
    private decimal ChartZero => -ChartMin / ChartRange * 100m;

    protected override async Task OnInitializedAsync()
    {
        Layout.SetTitle("داشبورد جامع فروشگاهی");
        if (CanOpenDashboard) await Load();
    }

    private async Task Load()
    {
        loading = true;
        try { data = await DashboardSvc.GetOperationsDashboardAsync(from, to); }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private string BarStyle(decimal value)
    {
        var height = Math.Abs(value) / ChartRange * 100m;
        var bottom = ChartZero - (value < 0 ? height : 0m);
        return FormattableString.Invariant($"height:{height:F3}%;bottom:{bottom:F3}%");
    }

    private async Task Print()
    {
        try
        {
            if (!await JS.InvokeAsync<bool>("shopPrintPreview.openElement", printRoot, "گزارش داشبورد فروشگاهی"))
                Toast.Error("پیش‌نمایش چاپ باز نشد؛ دوباره تلاش کنید.");
        }
        catch (Exception ex) { Toast.Error("پیش‌نمایش چاپ آماده نشد: " + ex.Message); }
    }
}
