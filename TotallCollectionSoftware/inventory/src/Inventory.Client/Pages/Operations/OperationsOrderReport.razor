@code {
    [Parameter] public string? Type { get; set; }

    private bool isPurchase => string.Equals(Type, "purchase", StringComparison.OrdinalIgnoreCase);
    private bool CanSeeProfit => Auth.Has("Orders.ViewProfit");
    private TransactionType selectedType => isPurchase ? TransactionType.Purchase : TransactionType.Sale;
    private string TrendPeriod => summary?.Trend.Any(p => p.Label.Contains('/')) == true ? "روزانه" : "ماهانه";

    private const int PageSize = 20;
    private int page = 1;
    private int pageCount = 1;
    private int total;
    private int partyId;
    private int warehouseId;
    private string chequeIncomeFilter = "all";
    private bool? SelectedChequeIncome => isPurchase ? null : chequeIncomeFilter switch
    {
        "with" => true,
        "without" => false,
        _ => null
    };
    private DateTime? from = DateTime.Today.AddDays(-30);
    private DateTime? to = DateTime.Today;
    private bool loading = true;
    private bool lookupsLoaded;
    private bool? lookupPurchase;
    private List<Order> items = new();
    private List<LookupItem> partyLookup = new();
    private List<LookupItem> warehouseLookup = new();
    private OperationsOrderReportDto? summary;

    protected override async Task OnParametersSetAsync()
    {
        Layout.SetTitle(isPurchase ? "گزارش خرید" : "گزارش فروش");
        if (!Auth.CanSee("Orders")) return;
        if (lookupPurchase.HasValue && lookupPurchase.Value != isPurchase)
        {
            lookupsLoaded = false;
            partyId = 0;
            partyLookup.Clear();
        }
        lookupPurchase = isPurchase;
        await LoadLookups();
        page = 1;
        await Load();
    }

    private async Task LoadLookups()
    {
        if (lookupsLoaded) return;
        try
        {
            var parties = PartySvc.GetLookupsAsync(isPurchase ? PartyType.Supplier : PartyType.Customer);
            var warehouses = WarehouseSvc.GetLookupsAsync();
            await Task.WhenAll(parties, warehouses);
            partyLookup = await parties;
            warehouseLookup = await warehouses;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { lookupsLoaded = true; }
    }

    private async Task ApplyFilter()
    {
        page = 1;
        await Load();
    }

    private async Task GoToPage(int selectedPage)
    {
        page = selectedPage;
        await Load();
    }

    private async Task Load()
    {
        loading = true;
        try
        {
            var ordersTask = OrderSvc.GetOrdersAsync(selectedType, from, to, partyId, warehouseId, page, PageSize, SelectedChequeIncome);
            var summaryTask = OrderSvc.GetReportSummaryAsync(selectedType, from, to, partyId, warehouseId, SelectedChequeIncome);
            await Task.WhenAll(ordersTask, summaryTask);
            var paged = await ordersTask;
            items = paged.Items;
            total = paged.TotalCount;
            pageCount = Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));
            summary = await summaryTask;
        }
        catch (Exception ex) { Toast.Error(ex.Message); }
        finally { loading = false; }
    }

    private static string BarStyle(decimal value, decimal max)
    {
        var pct = max <= 0 ? 0 : Math.Clamp((double)(value / max) * 100d, 0d, 100d);
        return $"width:{pct.ToString("F1", System.Globalization.CultureInfo.InvariantCulture)}%";
    }

    private async Task Print() => await JS.InvokeVoidAsync("window.print");
}
