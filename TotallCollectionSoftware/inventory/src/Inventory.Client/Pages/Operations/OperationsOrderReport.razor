@page "/operations/reports/orders/{Type}"
@inject IAuthState Auth
@inject IOrderService OrderSvc
@inject IWarehouseService WarehouseSvc
@inject IPartyService PartySvc
@inject IToastService Toast
@inject LayoutState Layout
@inject IJSRuntime JS

<PageTitle>@(isPurchase ? "گزارش تحلیلی خرید" : "گزارش تحلیلی فروش")</PageTitle>

@if (!Auth.CanSee("Orders"))
{
    <div class="alert alert-warning d-flex align-items-center gap-2 mt-3 rounded-4 p-3">
        <i class="bi bi-shield-exclamation fs-4 text-warning"></i>
        <div>برای مشاهدهٔ گزارش خرید و فروش، دسترسی مشاهدهٔ اسناد خرید و فروش لازم است.</div>
    </div>
}
else
{
    <div class="fin-page-container fade-in">
        <!-- ================== سربرگ ================== -->
        <div class="fin-header mb-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="fin-header-icon @(isPurchase ? "bg-indigo-gradient" : "bg-emerald-gradient")">
                        <i class="bi @(isPurchase ? "bi-bag-check-fill" : "bi-cart-check-fill")"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h1 class="h4 fw-800 text-dark mb-0">@(isPurchase ? "گزارش جامع و تحلیلی خرید" : "گزارش جامع و تحلیلی فروش")</h1>
                            <span class="badge rounded-pill @(isPurchase ? "fin-badge-indigo" : "fin-badge-emerald")">
                                @(isPurchase ? "عملیات تأمین کالا" : "عملیات فروش و درآمد")
                            </span>
                        </div>
                        <div class="text-secondary fs-8 mt-1">
                            تحلیل روندهای دوره‌ای، رتبه‌بندی طرف‌حساب‌ها، مقادیر فیزیکی و مبالغ ناخالص و سود
                        </div>
                    </div>
                </div>

                <div class="d-flex gap-2 align-items-center flex-wrap">
                    @if (!isPurchase && CanSeeProfit)
                    {
                        <a class="btn btn-outline-secondary fin-btn-pill" href="/operations/reports/cheque-income">گزارش تاخیر تادیه چک</a>
                    }
                    <button class="btn btn-outline-secondary fin-btn-pill" disabled="@(summary is null)" @onclick="Print">
                        <i class="bi bi-printer-fill me-1"></i> چاپ رسمی گزارش
                    </button>
                    <button class="btn btn-outline-primary fin-btn-pill" disabled="@loading" @onclick="ApplyFilter">
                        <i class="bi bi-arrow-clockwise me-1 @(loading ? "spin" : "")"></i> بازخوانی
                    </button>
                </div>
            </div>
        </div>

        <!-- ================== نوار فیلتر ================== -->
        <div class="fin-filter-card mb-4 d-print-none">
            <div class="row g-2.5 align-items-end">
                <div class="col-6 col-lg-2">
                    <label class="fin-label">از تاریخ</label>
                    <DatePicker @bind-Value="from" AllowClear="true" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="fin-label">تا تاریخ</label>
                    <DatePicker @bind-Value="to" AllowClear="true" />
                </div>
                <div class="col-6 col-lg-3">
                    <label class="fin-label">@(isPurchase ? "تأمین‌کننده" : "مشتری")</label>
                    <SearchSelect Items="partyLookup" Value="partyId" ValueChanged="v => partyId = v" Placeholder="همهٔ طرف‌حساب‌ها" />
                </div>
                <div class="col-6 col-lg-3">
                    <label class="fin-label">انبار مقصد/مبدأ</label>
                    <SearchSelect Items="warehouseLookup" Value="warehouseId" ValueChanged="v => warehouseId = v" Placeholder="همهٔ انبارها" />
                </div>
                <div class="col-12 col-lg-2">
                    <button class="btn btn-primary w-100 fin-btn-submit" disabled="@loading" @onclick="ApplyFilter">
                        <i class="bi bi-funnel-fill me-1"></i> اعمال فیلتر
                    </button>
                </div>
            </div>
        </div>

        @if (!isPurchase)
        {
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3 d-print-none">
                <label for="cheque-income-filter" class="fin-label mb-0">تاخیر تادیه چک</label>
                <select id="cheque-income-filter" class="form-select form-select-sm w-auto" @bind="chequeIncomeFilter">
                    <option value="all">همه فاکتورها</option>
                    <option value="with">دارای تاخیر تادیه چک</option>
                    <option value="without">بدون تاخیر تادیه چک</option>
                </select>
                <button class="btn btn-sm btn-outline-primary" disabled="@loading" @onclick="ApplyFilter">اعمال</button>
            </div>
        }

        @if (loading && summary is null)
        {
            <div class="text-center py-5">
                <div class="spinner-border text-primary mb-3" style="width: 2.8rem; height: 2.8rem;"></div>
                <div class="text-secondary fw-500 fs-8">در حال تحلیل و استخراج داده‌های اسناد...</div>
            </div>
        }
        else if (!loading && summary is null)
        {
            <div class="fin-table-card p-5 text-center">
                <i class="bi bi-exclamation-circle fs-1 text-muted opacity-50"></i>
                <div class="fw-bold text-secondary mt-2">داده‌ای برای این گزارش دریافت نشد</div>
            </div>
        }
        else if (summary is not null)
        {
            @if (!isPurchase)
            {
                <div class="d-flex flex-wrap gap-3 mb-3 px-2 fs-8 text-secondary">
                    <span>کالا و خدمات با ارزش افزوده: <b class="num text-dark">@summary.GoodsAmount.Money()</b> ریال</span>
                    <span>تاخیر تادیه چک: <b class="num text-dark">@summary.ChequeIncomeAmount.Money()</b> ریال</span>
                    <span>جمع فاکتورها: <b class="num text-dark">@summary.TotalAmount.Money()</b> ریال</span>
                </div>
            }
            <!-- ================== کارت‌های شاخص (KPI Cards) ================== -->
            <div class="row g-3 mb-4">
                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="fin-kpi-card @(isPurchase ? "border-indigo" : "border-emerald")">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fin-kpi-title @(isPurchase ? "text-indigo" : "text-emerald")">
                                    جمع کل مبلغ @(isPurchase ? "خرید" : "فروش")
                                </span>
                                <div class="fin-kpi-value num @(isPurchase ? "text-indigo" : "text-emerald") mt-1">
                                    @summary.TotalAmount.Money()
                                </div>
                                <div class="fin-kpi-unit">ریال</div>
                            </div>
                            <div class="fin-kpi-icon-box @(isPurchase ? "bg-indigo-subtle text-indigo" : "bg-emerald-subtle text-emerald")">
                                <i class="bi @(isPurchase ? "bi-bag-check" : "bi-cart-check")"></i>
                            </div>
                        </div>
                        <div class="fin-kpi-footer mt-3 pt-2">
                            <span class="text-secondary fs-9">مجموع مبالغ قطعی اسناد این بازه</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="fin-kpi-card border-slate">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fin-kpi-title text-slate">تعداد کل فاکتورها</span>
                                <div class="fin-kpi-value text-dark num mt-1">@summary.DocumentCount.Num()</div>
                                <div class="fin-kpi-unit">سند ثبتی</div>
                            </div>
                            <div class="fin-kpi-icon-box bg-slate-subtle text-slate">
                                <i class="bi bi-receipt"></i>
                            </div>
                        </div>
                        <div class="fin-kpi-footer mt-3 pt-2">
                            <span class="badge bg-slate-subtle text-slate rounded-pill px-2.5 num">
                                @summary.LineCount.Num() ردیف قلم کالا
                            </span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="fin-kpi-card border-amber">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fin-kpi-title text-amber">مقدار کل اقلام فیزیکی</span>
                                <div class="fin-kpi-value text-amber num mt-1">@summary.TotalQuantity.Qty()</div>
                                <div class="fin-kpi-unit">واحد کالا</div>
                            </div>
                            <div class="fin-kpi-icon-box bg-amber-subtle text-amber">
                                <i class="bi bi-boxes"></i>
                            </div>
                        </div>
                        <div class="fin-kpi-footer mt-3 pt-2">
                            <span class="text-secondary fs-9">مجموع شمارش کالاهای گردش‌یافته</span>
                        </div>
                    </div>
                </div>

                <div class="col-12 col-sm-6 col-xl-3">
                    <div class="fin-kpi-card border-purple">
                        <div class="d-flex justify-content-between align-items-start">
                            <div>
                                <span class="fin-kpi-title text-purple">میانگین مبلغ هر سند</span>
                                <div class="fin-kpi-value text-purple num mt-1">@summary.AverageDocumentAmount.Money()</div>
                                <div class="fin-kpi-unit">ریال</div>
                            </div>
                            <div class="fin-kpi-icon-box bg-purple-subtle text-purple">
                                <i class="bi bi-calculator"></i>
                            </div>
                        </div>
                        <div class="fin-kpi-footer mt-3 pt-2">
                            <span class="text-secondary fs-9">@(isPurchase ? "متوسط ارزش هر فاکتور" : "متوسط کالا و خدمات با ارزش افزوده، بدون درآمد چک")</span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================== نمودار روند و برترین طرف‌حساب‌ها ================== -->
            <div class="row g-4 mb-4">
                <div class="col-12 col-xl-7">
                    <div class="fin-table-card h-100">
                        <div class="fin-table-header">
                            <div class="d-flex align-items-center gap-2">
                                <div class="fin-table-header-icon @(isPurchase ? "bg-indigo-subtle text-indigo" : "bg-emerald-subtle text-emerald")">
                                    <i class="bi bi-graph-up-arrow"></i>
                                </div>
                                <div>
                                    <h3 class="fin-table-title">روند زمانی گردش @(isPurchase ? "خرید" : "فروش")</h3>
                                    <p class="fin-table-sub">@(isPurchase ? "توزیع مبالغ و تعداد اسناد در طول زمان" : "مبلغ کالا و خدمات با ارزش افزوده، بدون درآمد چک")</p>
                                </div>
                            </div>
                            <span class="badge @(isPurchase ? "bg-indigo-subtle text-indigo" : "bg-emerald-subtle text-emerald") rounded-pill px-3">
                                @TrendPeriod
                            </span>
                        </div>

                        <div class="p-3.5">
                            @if (summary.Trend.Count == 0)
                            {
                                <div class="fin-empty-state text-center py-4">
                                    <i class="bi bi-bar-chart fs-2 text-muted opacity-50"></i>
                                    <div class="text-secondary mt-1 fs-8">داده‌ای برای رسم روند موجود نیست</div>
                                </div>
                            }
                            else
                            {
                                var maxAmount = summary.Trend.Max(x => x.Amount);
                                <div class="d-flex flex-column gap-3">
                                    @foreach (var point in summary.Trend)
                                    {
                                        <div>
                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                <span class="text-secondary fs-8 fw-600">
                                                    @point.Label
                                                    <span class="text-muted num ms-1 fs-9">(@point.DocumentCount.Num() سند)</span>
                                                </span>
                                                <b class="num fs-7 text-dark">@point.Amount.Money() <small class="text-muted fs-9">ریال</small></b>
                                            </div>
                                            <div class="progress" style="height: 8px; border-radius: 6px; background: #f1f5f9;">
                                                <div class="progress-bar @(isPurchase ? "bg-indigo-gradient" : "bg-emerald-gradient")"
                                                     role="progressbar" style="@BarStyle(point.Amount, maxAmount)"></div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <div class="col-12 col-xl-5">
                    <div class="fin-table-card h-100">
                        <div class="fin-table-header">
                            <div class="d-flex align-items-center gap-2">
                                <div class="fin-table-header-icon bg-purple-subtle text-purple">
                                    <i class="bi bi-award-fill"></i>
                                </div>
                                <div>
                                    <h3 class="fin-table-title">@(isPurchase ? "تأمین‌کنندگان برتر دوره" : "مشتریان برتر دوره")</h3>
                                    <p class="fin-table-sub">@(isPurchase ? "رتبه‌بندی بر اساس مبلغ تراکنش" : "رتبه‌بندی بر اساس مبلغ کالا و خدمات، بدون درآمد چک")</p>
                                </div>
                            </div>
                        </div>

                        <div>
                            @if (summary.TopParties.Count == 0)
                            {
                                <div class="fin-empty-state text-center py-4">
                                    <i class="bi bi-inbox fs-2 text-muted opacity-50"></i>
                                    <div class="text-secondary mt-1 fs-8">طرف‌حسابی در این بازه ثبت نشده است</div>
                                </div>
                            }
                            else
                            {
                                <div class="table-responsive">
                                    <table class="table fin-table align-middle">
                                        <thead>
                                            <tr>
                                                <th>طرف حساب</th>
                                                <th class="text-center">تعداد اسناد</th>
                                                <th class="text-start">مجموع مبلغ (ریال)</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var party in summary.TopParties)
                                            {
                                                <tr class="fin-table-row">
                                                    <td class="fw-700 text-dark">
                                                        <div class="d-flex align-items-center gap-2">
                                                            <div class="fin-avatar">
                                                                @party.PartyName.Substring(0, Math.Min(1, party.PartyName.Length))
                                                            </div>
                                                            <span>@party.PartyName</span>
                                                        </div>
                                                    </td>
                                                    <td class="text-center num fs-8 text-secondary">@party.DocumentCount.Num()</td>
                                                    <td class="text-start num fw-800 fs-7.5 @(isPurchase ? "text-indigo" : "text-emerald")">
                                                        @party.TotalAmount.Money()
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- ================== جدول ریز اسناد ================== -->
            <div class="fin-table-card">
                <div class="fin-table-header">
                    <div class="d-flex align-items-center gap-2">
                        <div class="fin-table-header-icon bg-indigo-subtle text-indigo">
                            <i class="bi bi-journal-text"></i>
                        </div>
                        <div>
                            <h3 class="fin-table-title">جزئیات اسناد و فاکتورها</h3>
                            <p class="fin-table-sub">فهرست کامل فاکتورهای صادره به همراه مبالغ، اقلام و سود</p>
                        </div>
                    </div>
                    <span class="badge bg-secondary-subtle text-secondary rounded-pill px-3 num">
                        @total.Num() سند ثبت‌شده
                    </span>
                </div>

                @if (loading)
                {
                    <div class="text-center py-4">
                        <div class="spinner-border spinner-border-sm text-primary mb-2"></div>
                        <div class="text-muted fs-8">در حال بارگذاری صفحه...</div>
                    </div>
                }
                else if (items.Count == 0)
                {
                    <div class="fin-empty-state text-center py-5">
                        <i class="bi bi-receipt fs-1 text-muted opacity-50"></i>
                        <div class="fw-bold text-secondary mt-2">در فیلتر انتخاب‌شده سندی پیدا نشد</div>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table fin-table align-middle">
                            <thead>
                                <tr>
                                    <th>شماره سند</th>
                                    <th>تاریخ</th>
                                    <th>طرف حساب</th>
                                    <th>انبار مربوطه</th>
                                    <th class="text-center">اقلام</th>
                                    <th class="text-center">مقدار</th>
                                    @if (!isPurchase)
                                    {
                                        <th class="text-start">کالا و ارزش افزوده (ریال)</th>
                                        <th class="text-start">تاخیر تادیه چک (ریال)</th>
                                    }
                                    <th class="text-start">مبلغ کل (ریال)</th>
                                    @if (!isPurchase && CanSeeProfit)
                                    {
                                        <th class="text-start">سود ناخالص (ریال)</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var order in items)
                                {
                                    <tr class="fin-table-row">
                                        <td class="num fw-800 text-indigo">@order.Number</td>
                                        <td class="num text-secondary fs-8">@order.Date.ToFa()</td>
                                        <td class="fw-700 text-dark">@order.PartyName</td>
                                        <td class="text-muted fs-8">@order.WarehouseName</td>
                                        <td class="text-center num text-secondary fs-8">@order.Lines.Count.Num()</td>
                                        <td class="text-center num fw-600 text-dark fs-8">@order.Lines.Sum(l => l.Quantity).Qty()</td>
                                        @if (!isPurchase)
                                        {
                                            <td class="text-start num fs-8">@order.GoodsAmount.Money()</td>
                                            <td class="text-start num fs-8">@order.ChequeIncomeAmount.Money()</td>
                                        }
                                        <td class="text-start num fw-800 fs-7.5 @(isPurchase ? "text-indigo" : "text-emerald")">
                                            @order.TotalAmount.Money()
                                        </td>
                                        @if (!isPurchase && CanSeeProfit)
                                        {
                                            <td class="text-start num fs-8">
                                                @if (order.TotalProfit.HasValue)
                                                {
                                                    <span class="fw-800 @(order.TotalProfit >= 0 ? "text-emerald" : "text-danger")">
                                                        @order.TotalProfit.Value.Money()
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">—</span>
                                                }
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <div class="d-print-none p-3 border-top bg-light">
                        <Pager Page="page" PageCount="pageCount" OnPageChanged="GoToPage" />
                    </div>
                }
            </div>
        }
    </div>
}


<style>
/* ========================================================
   استایل‌های مدرن و چشم‌نواز FinTech برای گزارش طلب و بدهی
   ======================================================== */
.fin-page-container {
    max-width: 1440px;
    margin: 0 auto;
}

/* سربرگ */
.fin-header {
    background: #ffffff;
    border-radius: 18px;
    padding: 1.3rem 1.6rem;
    box-shadow: 0 4px 20px -4px rgba(15, 23, 42, 0.04);
    border: 1px solid #e2e8f0;
}
.fin-header-icon {
    width: 50px;
    height: 50px;
    border-radius: 14px;
    background: linear-gradient(135deg, #4f46e5 0%, #3730a3 100%);
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
    box-shadow: 0 6px 16px -2px rgba(79, 70, 229, 0.35);
    flex-shrink: 0;
}
.fin-badge-status {
    background: #eef2ff;
    color: #4338ca;
    font-weight: 700;
    font-size: 0.72rem;
    padding: 0.3rem 0.75rem;
    border: 1px solid #c7d2fe;
}
.fin-btn-pill {
    border-radius: 20px;
    padding: 0.45rem 1rem;
    font-weight: 700;
    font-size: 0.8rem;
    transition: all 0.2s;
}

/* کارت‌های شاخص KPI لوکس */
.fin-kpi-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.25rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 4px 18px -4px rgba(15, 23, 42, 0.03);
    transition: transform 0.2s, box-shadow 0.2s;
    position: relative;
    overflow: hidden;
}
.fin-kpi-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 24px -4px rgba(15, 23, 42, 0.08);
}
.fin-kpi-card.border-rose { border-top: 4px solid #ef4444; }
.fin-kpi-card.border-emerald { border-top: 4px solid #10b981; }
.fin-kpi-card.border-indigo { border-top: 4px solid #4f46e5; }
.fin-kpi-card.border-slate { border-top: 4px solid #64748b; }

.fin-kpi-title {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: -0.01em;
}
.fin-kpi-value {
    font-size: 1.5rem;
    font-weight: 900;
    line-height: 1.2;
}
.fin-kpi-unit {
    font-size: 0.72rem;
    color: #94a3b8;
    margin-top: 0.1rem;
}
.fin-kpi-icon-box {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.35rem;
    flex-shrink: 0;
}
.fin-kpi-footer {
    border-top: 1px dashed #f1f5f9;
}

/* کارت فیلتر */
.fin-filter-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 1.1rem 1.4rem;
    border: 1px solid #e2e8f0;
    box-shadow: 0 2px 12px rgba(15, 23, 42, 0.03);
}
.fin-label {
    font-size: 0.74rem;
    font-weight: 700;
    color: #475569;
    margin-bottom: 0.35rem;
    display: block;
}
.fin-input {
    border-radius: 10px;
    border: 1px solid #cbd5e1;
    font-size: 0.82rem;
}
.fin-btn-submit {
    border-radius: 10px;
    height: 33px;
    display: flex;
    align-items: center;
    justify-content: center;
