namespace Inventory.Client.Shared;

@code {
    [Parameter] public string Text { get; set; } = "";
    [Parameter] public string? Title { get; set; } = "راهنما";

    private bool showModal;
}

@if (!string.IsNullOrWhiteSpace(Text))
{
    <span class="form-help-icon ms-1" title="@Text" @onclick="() => showModal = true" role="button">
        <i class="bi bi-question-circle-fill"></i>
    </span>

    @if (showModal)
    {
        <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.4);" @onclick="() => showModal = false">
            <div class="modal-dialog modal-dialog-centered modal-sm" @onclick:stopPropagation="true">
                <div class="modal-content border-0 shadow">
                    <div class="modal-header py-2 bg-light">
                        <h6 class="modal-title fw-bold text-primary mb-0"><i class="bi bi-info-circle me-1"></i> @Title</h6>
                        <button type="button" class="btn-close" @onclick="() => showModal = false"></button>
                    </div>
                    <div class="modal-body fs-7 text-secondary" style="line-height: 1.8;">
                        @Text
                    </div>
                    <div class="modal-footer py-1">
                        <button type="button" class="btn btn-sm btn-secondary rounded-pill px-3" @onclick="() => showModal = false">بستن</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

<style>
    .form-help-icon {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: #0284c7;
        cursor: pointer;
        font-size: 0.9em;
        transition: transform 0.15s ease, color 0.15s ease;
    }
    .form-help-icon:hover {
        color: #0369a1;
        transform: scale(1.15);
    }
</style>
