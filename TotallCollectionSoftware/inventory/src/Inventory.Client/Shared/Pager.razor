@if (PageCount > 1)
{
    <div class="d-flex justify-content-center flex-wrap p-3 gap-1">
        <ul class="pagination">
            <li class="page-item @(Page <= 1 ? "disabled" : "")">
                <button class="page-link" @onclick="() => Go(Page - 1)">
                    <i class="bi bi-chevron-right"></i>
                </button>
            </li>

            @foreach (var p in Pages)
            {
                <li class="page-item @(p == Page ? "active" : "")">
                    <button class="page-link" @onclick="() => Go(p)">@p.Num()</button>
                </li>
            }

            <li class="page-item @(Page >= PageCount ? "disabled" : "")">
                <button class="page-link" @onclick="() => Go(Page + 1)">
                    <i class="bi bi-chevron-left"></i>
                </button>
            </li>
        </ul>
    </div>
}

@code {
    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageCount { get; set; } = 1;
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private List<int> Pages
    {
        get
        {
            var list = new List<int>();
            int start = Math.Max(1, Page - 2);
            int end = Math.Min(PageCount, Page + 2);
            for (int i = start; i <= end; i++) list.Add(i);
            return list;
        }
    }

    private async Task Go(int p)
    {
        if (p < 1 || p > PageCount || p == Page) return;
        await OnPageChanged.InvokeAsync(p);
    }
}
