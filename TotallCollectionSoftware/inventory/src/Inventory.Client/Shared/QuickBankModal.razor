@using Inventory.Shared
@using Inventory.Shared.Dtos
@inject ITrsAccountService AccountSvc
@inject IToastService Toast
@inject IJSRuntime JS

<Modal Visible="Visible" Title="@Title" Size="modal-lg" OnClose="Close">
    <ChildContent>
        <div class="row g-3" data-order-child="@InvoiceFormKey">
            <!-- نوع حساب -->
            <div class="col-md-6">
                <label class="form-label fs-8 fw-bold">نوع حساب <span class="text-danger">*</span></label>
                <div class="btn-group w-100" role="group">
                    <button type="button" class="btn btn-sm @(form.Kind == TreasuryAccountKind.Bank ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetKind(TreasuryAccountKind.Bank)">
                        <i class="bi bi-bank ms-1"></i> حساب بانکی
                    </button>
                    <button type="button" class="btn btn-sm @(form.Kind == TreasuryAccountKind.Pos ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetKind(TreasuryAccountKind.Pos)">
                        <i class="bi bi-credit-card ms-1"></i> کارتخوان (POS)
                    </button>
                    <button type="button" class="btn btn-sm @(form.Kind == TreasuryAccountKind.Cash ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetKind(TreasuryAccountKind.Cash)">
                        <i class="bi bi-wallet2 ms-1"></i> صندوق
                    </button>
                    <button type="button" class="btn btn-sm @(form.Kind == TreasuryAccountKind.PettyCash ? "btn-primary" : "btn-outline-secondary")"
                            @onclick="() => SetKind(TreasuryAccountKind.PettyCash)">
                        <i class="bi bi-cash-stack ms-1"></i> تنخواه
                    </button>
                </div>
            </div>

            <!-- انتخاب سریع نام بانک -->
            @if (form.Kind is TreasuryAccountKind.Bank or TreasuryAccountKind.Pos)
            {
                <div class="col-md-6">
                    <label class="form-label fs-8 fw-bold">انتخاب سریع بانک</label>
                    <div class="input-group">
                        @if (!string.IsNullOrWhiteSpace(InvoiceFormKey))
                        {
                            <div class="flex-grow-1" style="min-width:0">
                                <SearchSelectStr Items="@(AllBanks.ToList())" Value="@selectedBank" ValueChanged="@(name => OnQuickBankPick(new ChangeEventArgs { Value = name }))"
                                                 Placeholder="انتخاب از لیست بانک‌ها" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="true" />
                            </div>
                        }
                        else
                        {
                            <select class="form-select form-select-sm" value="@selectedBank" @onchange="OnQuickBankPick">
                                <option value="">— انتخاب از لیست بانک‌ها —</option>
                                @foreach (var b in AllBanks)
                                {
                                    <option value="@b">@b</option>
                                }
                            </select>
                        }
                        <button type="button" class="btn btn-outline-primary" title="مدیریت و افزودن بانک" aria-label="مدیریت و افزودن بانک" @onclick="OpenBankManager">
                            <i class="bi bi-plus-lg"></i>
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="col-md-6"></div>
            }

            <!-- عنوان حساب، مستقل از بانک انتخاب‌شده -->
            <div class="col-12">
                <label class="form-label fs-8 fw-bold">عنوان حساب <span class="text-danger">*</span></label>
                <input class="form-control" @bind="form.Name" placeholder="مثال: حساب جاری شرکت یا صندوق مرکزی" />
            </div>

            <!-- مشخصات حساب؛ نام بانک فقط از انتخابگر بالای فرم گرفته می‌شود -->
            @if (form.Kind is TreasuryAccountKind.Bank or TreasuryAccountKind.Pos)
            {
                <div class="col-md-4">
                    <label class="form-label fs-8">شماره حساب</label>
                    <input class="form-control num" @bind="form.AccountNumber" dir="ltr" placeholder="شماره حساب بانکی" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fs-8">شماره کارت (۱۶ رقم)</label>
                    <input class="form-control num @(CardNumberError is not null ? "is-invalid" : "")" @bind="form.CardNumber" @bind:event="oninput" dir="ltr" inputmode="numeric"
                           aria-invalid="@(CardNumberError is not null ? "true" : "false")" aria-describedby="quick-bank-card-error" placeholder="xxxx-xxxx-xxxx-xxxx" />
                    @if (CardNumberError is not null) { <div id="quick-bank-card-error" class="invalid-feedback d-block" role="status">@CardNumberError</div> }
                </div>
                <div class="col-md-4">
                    <label class="form-label fs-8">شماره شبا (بدون IR)</label>
                    <div class="input-group" dir="ltr">
                        <span class="input-group-text">IR</span>
                        <input class="form-control num @(IbanError is not null ? "is-invalid" : "")" @bind="form.Iban" @bind:event="oninput" placeholder="۲۴ رقم شبا" inputmode="text"
                               aria-invalid="@(IbanError is not null ? "true" : "false")" aria-describedby="quick-bank-iban-error" />
                    </div>
                    @if (IbanError is not null) { <div id="quick-bank-iban-error" class="invalid-feedback d-block" role="status">@IbanError</div> }
                </div>

                <div class="col-md-6">
                    <label class="form-label fs-8">نام شعبه</label>
                    <input class="form-control" @bind="form.BranchName" placeholder="مثال: شعبه مرکزی" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fs-8">کد شعبه</label>
                    <input class="form-control num" @bind="form.BranchCode" placeholder="کد عددی شعبه" />
                </div>
            }

            <!-- مانده اول دوره -->
            <div class="col-md-6">
                <label class="form-label fs-8">مانده ابتدای دوره (ریال)</label>
                <input class="form-control num" value="@openingText" @oninput="OnOpeningInput" placeholder="0" />
                @if (form.OpeningBalance > 0)
                {
                    <div class="form-text fs-9 text-muted num">@Fa.MoneyWithWords(form.OpeningBalance)</div>
                }
            </div>

            <!-- تنظیمات وضعیت -->
            <div class="col-md-6 d-flex align-items-center pt-3">
                <div class="form-check form-switch me-4">
                    <input class="form-check-input" type="checkbox" id="chkQuickDefault" @bind="form.IsDefault" />
                    <label class="form-check-label fs-8" for="chkQuickDefault">حساب پیش‌فرض دریافت/پرداخت</label>
                </div>
            </div>

            <div class="col-12">
                <label class="form-label fs-8">توضیحات اختیاری</label>
                <input class="form-control form-control-sm" @bind="form.Description" placeholder="یادداشت یا توضیحات اضافی…" />
            </div>
        </div>
    </ChildContent>

    <Footer>
        <button type="button" class="btn btn-secondary" @onclick="Close" disabled="@saving">
            انصراف (Esc)
        </button>
        <button type="button" class="btn btn-primary" data-hotkey="f1" @onclick="Save" disabled="@saving">
            @if (saving)
            {
                <span class="spinner-border spinner-border-sm ms-1" role="status"></span>
                <span>در حال ثبت…</span>
            }
            else
            {
                <i class="bi bi-check-lg ms-1"></i>
                <span>ثبت و انتخاب بانک (F1)</span>
            }
        </button>
    </Footer>
</Modal>

<Modal Visible="showBankManager" Title="مدیریت بانک‌ها" Size="modal-lg" OnClose="CloseBankManager">
    <ChildContent>
        <div class="d-flex justify-content-between align-items-center gap-2 flex-wrap mb-3">
            <div>
                <div class="fw-bold">فهرست بانک‌های سفارشی</div>
                <div class="text-muted fs-8">بانک‌های پیش‌فرض در کمبو هستند؛ از اینجا بانک‌های اختصاصی را اضافه یا حذف کنید.</div>
            </div>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-sm-8"><input class="form-control" @bind="newBankName" @bind:event="oninput" @onkeydown="OnBankInputKeyDown" placeholder="نام بانک جدید، مثلاً بانک خاورمیانه" /></div>
            <div class="col-sm-4"><button type="button" class="btn btn-primary w-100" data-hotkey="f1" title="کلید میانبر: F1" @onclick="AddBank" disabled="@string.IsNullOrWhiteSpace(newBankName)"><i class="bi bi-plus-lg ms-1"></i>افزودن بانک (F1)</button></div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead><tr><th>نام بانک</th><th>وضعیت در فهرست انتخاب سریع</th><th class="text-end">عملیات</th></tr></thead>
                <tbody>
                    @if (customBanks.Count == 0)
                    {
                        <tr><td colspan="3" class="text-center text-muted py-4">هنوز بانک سفارشی اضافه نشده است.</td></tr>
                    }
                    else
                    {
                        @foreach (var bank in customBanks)
                        {
                            <tr>
                                <td class="fw-semibold"><i class="bi bi-bank text-primary ms-2"></i>@bank</td>
                                <td><span class="badge bg-success-subtle text-success">در کمبو موجود است</span></td>
                                <td class="text-end"><button type="button" class="btn btn-sm btn-outline-danger" title="حذف بانک" @onclick="() => RemoveBank(bank)"><i class="bi bi-trash"></i><span class="me-1">حذف</span></button></td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </ChildContent>
    <Footer>
        <button type="button" class="btn btn-light" @onclick="CloseBankManager">بستن</button>
    </Footer>
</Modal>

@code {
    /// <summary>شناسهٔ فرم فاکتور برای ناوبری کیبورد؛ در سایر صفحات خالی است.</summary>
    [Parameter] public string? InvoiceFormKey { get; set; }

    private void NotifyError(string message)
    {
        if (!string.IsNullOrWhiteSpace(InvoiceFormKey)) Toast.ShowAtTopRight(message, "error");
        else Toast.Error(message);
    }
    private void NotifySuccess(string message)
    {
        if (!string.IsNullOrWhiteSpace(InvoiceFormKey)) Toast.ShowAtTopRight(message, "success");
        else Toast.Success(message);
    }

    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback<bool> VisibleChanged { get; set; }
    [Parameter] public EventCallback<TrsAccount> OnAccountCreated { get; set; }
    [Parameter] public TreasuryAccountKind DefaultKind { get; set; } = TreasuryAccountKind.Bank;
    [Parameter] public string Title { get; set; } = "تعریف بانک و حساب جدید";

    [Parameter] public int? InitialCompanyId { get; set; }
    [Parameter] public int InitialSortOrder { get; set; }
    private bool wasVisible;
    private TrsAccount form = new();
    // Validate copies for live feedback; normalization must not rewrite text while typing.
    private string? CardNumberError => ShopIdentifierRules.ValidateBank(new TrsAccount { CardNumber = form.CardNumber });
    private string? IbanError => ShopIdentifierRules.ValidateBank(new TrsAccount { Iban = form.Iban });
    private string openingText = "0";
    private bool saving = false;
    private bool showBankManager;
    private string newBankName = "";
    private string selectedBank = "";
    private List<string> customBanks = new();
    private IEnumerable<string> AllBanks => PopularBanks.Concat(customBanks).Distinct(StringComparer.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var saved = await JS.InvokeAsync<string?>("localStorage.getItem", "quickBank.customBanks");
            if (!string.IsNullOrWhiteSpace(saved))
                customBanks = System.Text.Json.JsonSerializer.Deserialize<List<string>>(saved) ?? new();
        }
        catch { }
    }

    private void OpenBankManager() => showBankManager = true;
    private void CloseBankManager() => showBankManager = false;

    private async Task OnBankInputKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddBank();
    }

    private async Task AddBank()
    {
        var name = newBankName.Trim();
        if (string.IsNullOrWhiteSpace(name)) return;
        if (AllBanks.Contains(name, StringComparer.OrdinalIgnoreCase))
        {
            NotifyError("این بانک از قبل در فهرست وجود دارد.");
            return;
        }
        customBanks.Add(name);
        newBankName = "";
        await SaveCustomBanks();
        selectedBank = name;
        ApplyBankSelection(name);
        showBankManager = false;
    }

    private async Task RemoveBank(string name)
    {
        customBanks.RemoveAll(x => string.Equals(x, name, StringComparison.OrdinalIgnoreCase));
        if (string.Equals(selectedBank, name, StringComparison.OrdinalIgnoreCase))
        {
            selectedBank = "";
            form.BankName = null;
        }
        await SaveCustomBanks();
    }

    private void ApplyBankSelection(string picked)
    {
        form.BankName = picked;
        if (string.IsNullOrWhiteSpace(form.Name) || form.Name.StartsWith("بانک ") || form.Name.StartsWith("حساب "))
            form.Name = $"{picked} - جاری";
    }

    private async Task SaveCustomBanks()
    {
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", "quickBank.customBanks", System.Text.Json.JsonSerializer.Serialize(customBanks));
        }
        catch { NotifyError("ذخیره فهرست بانک‌ها در این مرورگر ممکن نشد."); }
    }

    private static readonly string[] PopularBanks =
    [
        "بانک ملت",
        "بانک ملی ایران",
        "بانک صادرات ایران",
        "بانک تجارت",
        "بانک سپه",
        "بانک سامان",
        "بانک پاسارگاد",
        "بانک پارسیان",
        "بانک رسالت",
        "بانک مهر ایران",
        "بانک کشاورزی",
        "بانک مسکن",
        "بانک رفاه کارگران",
        "بانک آینده",
        "بانک شهر",
        "بانک سینا",
        "بانک دی",
        "بانک اقتصاد نوین",
        "بانک کارآفرین",
        "بانک سرمایه",
        "بانک گردشگری",
        "پست بانک ایران"
    ];

    protected override void OnParametersSet()
    {
        if (Visible && !wasVisible) ResetForm();
        wasVisible = Visible;
    }

    private void ResetForm()
    {
        form = new TrsAccount
        {
            Kind = DefaultKind,
            CompanyId = InitialCompanyId, SortOrder = InitialSortOrder,
            IsActive = true
        };
        openingText = "0";
        selectedBank = "";
    }

    private void SetKind(TreasuryAccountKind kind)
    {
        form.Kind = kind;
        if (kind == TreasuryAccountKind.Cash && string.IsNullOrWhiteSpace(form.Name))
            form.Name = "صندوق نقدی";
        else if (kind == TreasuryAccountKind.Pos && string.IsNullOrWhiteSpace(form.Name))
            form.Name = "دستگاه کارتخوان";
        else if (kind == TreasuryAccountKind.PettyCash && string.IsNullOrWhiteSpace(form.Name))
            form.Name = "تنخواه‌گردان";
    }

    private void OnQuickBankPick(ChangeEventArgs e)
    {
        var picked = e.Value?.ToString() ?? "";
        selectedBank = picked;
        if (string.IsNullOrWhiteSpace(picked)) { form.BankName = null; return; }
        ApplyBankSelection(picked);
    }

    private void OnOpeningInput(ChangeEventArgs e)
    {
        openingText = Fa.FormatTyping(e.Value?.ToString());
        form.OpeningBalance = Fa.ParseDecimal(openingText);
    }

    private async Task Close()
    {
        Visible = false;
        await VisibleChanged.InvokeAsync(false);
    }

    private async Task Save()
    {
        if (saving) return;
        if (string.IsNullOrWhiteSpace(form.Name))
        {
            NotifyError("لطفاً عنوان حساب را وارد کنید.");
            return;
        }

        if ((form.Kind is TreasuryAccountKind.Bank or TreasuryAccountKind.Pos) && string.IsNullOrWhiteSpace(form.BankName))
        {
            NotifyError("لطفاً بانک را از فهرست انتخاب کنید؛ برای بانک جدید از دکمهٔ + استفاده کنید.");
            return;
        }

        var identifierError = ShopIdentifierRules.ValidateBank(form);
        if (identifierError is not null) { NotifyError(identifierError); return; }

        saving = true;
        try
        {
            var saved = await AccountSvc.SaveShopAsync(form);
            NotifySuccess($"حساب «{saved.Name}» با موفقیت ثبت و افزوده شد.");

            await OnAccountCreated.InvokeAsync(saved);
            await Close();
            ResetForm();
        }
        catch (Exception ex)
        {
            NotifyError(ex.Message);
        }
        finally
        {
            saving = false;
        }
    }
}
