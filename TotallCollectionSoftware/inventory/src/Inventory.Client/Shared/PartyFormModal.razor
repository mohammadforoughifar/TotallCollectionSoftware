@* ================== فرم «طرف حساب جدید / ویرایش طرف حساب» ==================
   تنها نسخهٔ فرم تعریف مشتری/تأمینکننده در سامانهٔ فروشگاهی. هر جا دکمهٔ
   «مشتری جدید» هست باید دقیقاً همین کامپوننت باز شود؛ هیچ فرم خلاصهٔ موازی
   (فقط نام/موبایل/تلفن/آدرس) تعریف نمیشود.
   مصرفکنندهها: «طرف حسابها» (/parties، اطلاعات پایه ← مرجع)، «فاکتور فروش/خرید»
   (Orders/OrderForm)، «ثبت سفارش ویزیتوری» (SalesVisit/VisitForm)،
   «حوالهٔ تحویل کالا» (Catalog/GoodsIssues) و «پذیرش تعمیرات» (Repairs/Repairs).
   بنابراین مشتریان ثبتشده از هر نقطه دقیقاً همان فیلدها، همان اعتبارسنجی و
   همان رکورد «تعریف مشتری» را دارند.
   AllowReferrerPicker=false فقط برای ویزیتور است که معرفش توسط سرور ثابت میشود.
   قرارداد مودال: بستن فقط با ×، «انصراف» یا Esc.
   اعتبارسنجی: «هر» ذخیره (دکمه یا F1) از ValidateForm میگذرد؛ نام، موبایل،
   تلفن ثابت، کد پستی و شناسهٔ ملی برای هر دو نوع مشتری و تأمینکننده بررسی
   میشوند. در صورت خطا هیچ فراخوانی API انجام نمیشود و OnSaved صدا زده نمیشود.
   ======================================================================= *@
@namespace Inventory.Client.Shared
@inject IPartyService PartySvc
@inject IReferrerService ReferrerSvc
@inject IToastService Toast
@inject IAuthState Auth

<Modal Visible="Visible" Title="@(IsEdit ? "ویرایش طرف حساب" : Type == PartyType.Supplier ? "تأمینکننده جدید" : "مشتری جدید")"
       OnClose="Close">
    <ChildContent>
        @if (IsEdit)
        {
            <div class="alert alert-light border py-2 px-2 fs-8 mb-3">
                <i class="bi bi-pencil-square text-primary"></i>
                ویرایش طرف حساب شمارهٔ <b class="num">@Fa.Digits(party.Id)</b>
                @if (!string.IsNullOrWhiteSpace(party.RegisteredByName))
                {
                    <span class="text-muted">
                        — ثبتشده توسط
                        <b>@party.RegisteredByName</b>
                        @if (!string.IsNullOrWhiteSpace(party.RegisteredByReferrerName))
                        {
                            <span>(ویزیتور: @party.RegisteredByReferrerName)</span>
                        }
                    </span>
                }
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(formError))
        {
            <div class="alert alert-danger py-2 px-2 fs-8 mb-3" role="alert">
                <i class="bi bi-exclamation-triangle-fill me-1"></i>@formError
            </div>
        }

        <div class="row g-3" data-order-child="@InvoiceFormKey">
            <div class="col-12">
                <label class="form-label">نام <span class="text-danger">*</span></label>
                <input class="form-control @(FieldClass("name"))" @bind="party.Name" data-party-field="name" />
                @FieldError("name")
            </div>
            <div class="col-md-6">
                <label class="form-label">موبایل</label>
                <ShopDigitsInput @bind-Value="party.Mobile" Field="mobile" MaxDigits="11" ValidLengths="@(new[] { 11 })" Phone="true" ErrorMessage="شماره موبایل باید دقیقاً ۱۱ رقم با صفر آغازین باشد." />
                @FieldError("mobile")
            </div>
            <div class="col-md-6">
                <label class="form-label">تلفن ثابت</label>
                <ShopDigitsInput @bind-Value="party.Phone" MaxDigits="11" ValidLengths="@(new[] { 11 })" Phone="true" ErrorMessage="شماره تلفن ثابت باید دقیقاً ۱۱ رقم با صفر آغازین باشد." />
                @FieldError("phone")
            </div>
            <div class="col-12">
                <label class="form-label">آدرس</label>
                <input class="form-control" @bind="party.Address" />
            </div>
                <div class="col-md-6">
                    <label class="form-label">@(Type == PartyType.Customer ? "شناسه ملی خریدار" : "شناسه ملی/اقتصادی تأمینکننده")</label>
                    <ShopDigitsInput @bind-Value="party.TaxId" MaxDigits="14" ValidLengths="@(new[] { 10, 11, 12, 14 })" ErrorMessage="شناسه ملی/مالیاتی باید ۱۰، ۱۱، ۱۲ یا ۱۴ رقم باشد." />
                    @FieldError("taxId")
                </div>
                <div class="col-md-6">
                    <label class="form-label">@(Type == PartyType.Customer ? "کد پستی خریدار" : "کد پستی تأمینکننده")</label>
                    <ShopDigitsInput @bind-Value="party.PostalCode" MaxDigits="10" ValidLengths="@(new[] { 10 })" ErrorMessage="کد پستی باید دقیقاً ۱۰ رقم باشد." />
                    @FieldError("postal")
                </div>
            @if (Type == PartyType.Customer && AllowReferrerPicker)
            {
                <div class="col-12">
                    <label class="form-label">معرف</label>
                    @if (!string.IsNullOrWhiteSpace(InvoiceFormKey))
                    {
                        <SearchSelect Items="@ReferrerLookup" Value="SelectedReferrer" ValueChanged="@(id => referrerIdStr = id.ToString())"
                                      Placeholder="بدون معرف" ShowAllOnFocus="true" ConstrainToModal="true" AdvanceOnEnter="true" />
                    }
                    else
                    {
                        <select class="form-select" @bind="referrerIdStr">
                            <option value="0">— بدون معرف —</option>
                            @foreach (var r in referrerList)
                            {
                                <option value="@r.Id">@r.Name@(string.IsNullOrWhiteSpace(r.CompanyName) ? "" : $" ({r.CompanyName})")</option>
                            }
                        </select>
                    }
                    <div class="fs-8 text-muted mt-1">در فاکتور فروش این مشتری، معرف بهصورت خودکار انتخاب میشود</div>
                </div>
            }
            @if (Type == PartyType.Customer && !AllowReferrerPicker)
            {
                <div class="col-12">
                    <div class="alert alert-info py-2 px-2 fs-8 mb-0">
                        <i class="bi bi-info-circle"></i>
                        این مشتری بهصورت خودکار در پروندهٔ معرفی خودِ شما ثبت میشود.
                    </div>
                </div>
            }
            <div class="col-12">
                <label class="form-label">یادداشت</label>
                @if (!string.IsNullOrEmpty(InvoiceFormKey))
                {
                    <div class="fs-9 text-muted">Enter: فیلد بعدی · Shift+Enter: خط جدید</div>
                }
                <textarea class="form-control" rows="2" @bind="party.Note"></textarea>
            </div>
            <div class="col-12">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="partyFormActive" @bind="party.IsActive" />
                    <label class="form-check-label" for="partyFormActive">فعال باشد</label>
                </div>
            </div>
        </div>
    </ChildContent>
    <Footer>
        <button class="btn btn-light" @onclick="Close">انصراف (Esc)</button>
        <button class="btn btn-primary" data-hotkey="f1" title="کلید میانبر: F1" @onclick="Save" disabled="@saving">
            @if (saving)
            {
                <span class="spinner-border spinner-border-sm ms-1"></span>
            }
            ذخیره (F1)
        </button>
    </Footer>
</Modal>

@code {
    /// <summary>شناسهٔ فرم فاکتور برای ناوبری کیبورد؛ در سایر صفحات خالی است.</summary>
    [Parameter] public string? InvoiceFormKey { get; set; }

    /// <summary>فقط برای ثبت سریع مشتری یا تأمینکننده از فرمهای فروشگاهی.</summary>
    [Parameter] public bool ShopQuickCreate { get; set; }

    /// <summary>نمایش/عدم نمایش فرم.</summary>
    [Parameter] public bool Visible { get; set; }

    /// <summary>نوع طرف حساب (مشتری/تأمینکننده).</summary>
    [Parameter] public PartyType Type { get; set; } = PartyType.Customer;

    /// <summary>طرف حساب آمادهٔ ویرایش (null یا Id=0 یعنی ایجاد جدید).</summary>
    [Parameter] public Party? Model { get; set; }

    /// <summary>
    /// انتخاب معرف در فرم مجاز باشد یا نه. ویزیتور معرفِ خودش را میگیرد و AllowReferrerPicker=false است.
    /// </summary>
    [Parameter] public bool AllowReferrerPicker { get; set; } = true;

    /// <summary>پس از ثبت/ویرایش موفق.</summary>
    [Parameter] public EventCallback<Party> OnSaved { get; set; }

    /// <summary>انصراف کاربر.</summary>
    [Parameter] public EventCallback OnCancel { get; set; }

    private Party party = new();
    private bool saving;
    private List<Referrer> referrerList = new();
    private string referrerIdStr = "0";
    private int SelectedReferrer => int.TryParse(referrerIdStr, out var id) ? id : 0;
    private List<LookupItem> ReferrerLookup => referrerList.Select(r => new LookupItem
    {
        Id = r.Id, Name = r.Name + (string.IsNullOrWhiteSpace(r.CompanyName) ? "" : $" ({r.CompanyName})")
    }).ToList();
    private bool loadedForKey;

    // خطاهای اعتبارسنجی: هم زیر فیلد و هم بهصورت پیام بالای فرم نشان داده میشوند.
    private readonly Dictionary<string, string> fieldErrors = new();
    private string? formError;
    private bool validated;

    private bool IsEdit => party.Id != 0;

    private PartyType _prevType;

    private string FieldClass(string field) => fieldErrors.ContainsKey(field) ? "is-invalid" : "";

    private RenderFragment? FieldError(string field)
    {
        if (!fieldErrors.TryGetValue(field, out var message)) return null;
        return builder =>
        {
            builder.OpenElement(0, "div");
            builder.AddAttribute(1, "class", "invalid-feedback d-block");
            builder.AddAttribute(2, "role", "status");
            builder.AddContent(3, message);
            builder.CloseElement();
        };
    }

    private static string FieldOf(string message) => message.Contains("موبایل") ? "mobile"
        : message.Contains("تلفن") ? "phone"
        : message.Contains("پستی") ? "postal"
        : message.Contains("شناسه") ? "taxId" : "name";

    /// <summary>
    /// تنها دروازهٔ ذخیره. خطاها را نمایش میدهد و اجازهٔ هیچ نوشتنی نمیدهد؛
    /// نرمالسازی مقادیر توسط ShopIdentifierRules انجام میشود تا همان مقدارِ
    /// بررسیشده به سرور ارسال شود. برای مشتری و تأمینکننده یکسان اجرا میشود.
    /// </summary>
    private bool ValidateForm()
    {
        fieldErrors.Clear();
        formError = null;
        validated = false;
        if (string.IsNullOrWhiteSpace(party.Name))
            return Fail("نام طرف حساب را وارد کنید.", "name");

        var identifierError = ShopIdentifierRules.ValidateParty(party);
        if (identifierError is not null)
            return Fail(identifierError, FieldOf(identifierError));

        validated = true;
        return true;
    }

    private bool Fail(string message, string field)
    {
        formError = message;
        fieldErrors[field] = message;
        Notify(message, true);
        return false;
    }

    protected override void OnParametersSet()
    {
        // با تغییر وضعیت نمایش یا تغییر نوع (مثلاً از فروش به خرید)، فرم باید از نو مقداردهی شود
        if (!Visible) { loadedForKey = false; return; }
        if (loadedForKey && _prevType == Type) return;
        loadedForKey = true;
        _prevType = Type;

        var src = Model;
        party = new Party
        {
            Id = src?.Id ?? 0,
            Type = Type,
            Name = src?.Name ?? "",
            Mobile = src?.Mobile,
            Phone = src?.Phone,
            Address = src?.Address,
            TaxId = src?.TaxId,
            PostalCode = src?.PostalCode,
            Note = src?.Note,
            IsActive = src?.IsActive ?? true,
            ReferrerId = src?.ReferrerId,
            RegisteredByName = src?.RegisteredByName,
            RegisteredByReferrerName = src?.RegisteredByReferrerName
        };
        referrerIdStr = (party.ReferrerId ?? 0).ToString();
        fieldErrors.Clear();
        formError = null;
        validated = false;
        _ = LoadReferrersAsync();
    }

    private async Task LoadReferrersAsync()
    {
        if (Type != PartyType.Customer || !AllowReferrerPicker) return;
        try { referrerList = await ReferrerSvc.GetAllAsync(activeOnly: true); }
        catch { /* فهرست معرفها اختیاری است */ }
        StateHasChanged();
    }

    private async Task Close()
    {
        saving = false;
        validated = false;
        await OnCancel.InvokeAsync();
    }

    private void Notify(string message, bool error)
    {
        if (!string.IsNullOrWhiteSpace(InvoiceFormKey)) Toast.ShowAtTopRight(message, error ? "error" : "success");
        else if (error) Toast.Error(message);
        else Toast.Success(message);
    }

    private async Task Save()
    {
        if (saving) return;
        // اعتبارسنجی مقدماتی: در صورت خطا هیچ درخواست ذخیرهای ارسال نمیشود.
        if (!ValidateForm()) return;

        party.ReferrerId = AllowReferrerPicker && int.TryParse(referrerIdStr, out var rid) && rid > 0 ? rid : party.ReferrerId;
        saving = true;
        try
        {
            // نگهبان نهایی: حتی اگر مسیر دیگری (کلید میانبر/کلیک دوتایی) وارد شد،
            // بدون اعتبارسنجی موفقِ همین مقادیر، نوشتنی انجام نشود.
            if (!validated || string.IsNullOrWhiteSpace(party.Name) ||
                ShopIdentifierRules.ValidateParty(party) is not null)
            {
                if (formError is null) Notify("اطلاعات طرف حساب معتبر نیست؛ ذخیره انجام نشد.", true);
                return;
            }
            var saved = ShopQuickCreate && !IsEdit
                ? await PartySvc.SaveShopQuickAsync(party)
                : await PartySvc.SaveAsync(party);
            Notify(IsEdit ? "طرف حساب ویرایش شد." : "طرف حساب ثبت شد.", false);
            validated = false;
            await OnSaved.InvokeAsync(saved);
        }
        catch (Exception ex) { Notify(ex.Message, true); }
        finally { saving = false; }
    }
}
