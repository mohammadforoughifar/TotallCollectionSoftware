@* ============================================================
   نوار پیشرفت «در حال باز کردن نامه»
   ------------------------------------------------------------
   وقتی کاربر روی یک نامه کلیک می‌کند، تا رسیدن جزئیات از سرور، این نوار با
   درصدِ متحرک نمایش داده می‌شود. درصد از LoadProgress می‌آید: تا ۹۲٪ به‌آرامی
   بالا می‌رود و با رسیدن پاسخ به ۱۰۰٪ می‌رسد و محو می‌شود.
   ============================================================ *@
@if (Value > 0)
{
    <div class="@CssClass" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Value" aria-label="@Text">
        <div class="lp-bar">
            <span style="width:@(Value)%"></span>
        </div>
        @if (!Compact)
        {
            <div class="lp-bar-cap">
                <span><i class="bi bi-hourglass-split"></i> @Text</span>
                <span class="num">@Value.FaDigits()٪</span>
            </div>
        }
    </div>
}

@code {
    /// <summary>درصد پیشرفت (۰ تا ۱۰۰) — صفر یعنی نوار دیده نشود.</summary>
    [Parameter] public int Value { get; set; }

    /// <summary>متن همراه نوار.</summary>
    [Parameter] public string Text { get; set; } = "در حال دریافت نامه…";

    /// <summary>
    /// حالت جمع‌وجور: فقط نوار باریک، بدون متن و درصد — برای لحظهٔ پایانی (رسیدن به ۱۰۰٪)
    /// تا بالای نامه جابه‌جا نشود.
    /// </summary>
    [Parameter] public bool Compact { get; set; }

    private string CssClass => Compact ? "lp-bar-wrap compact" : "lp-bar-wrap";
}
