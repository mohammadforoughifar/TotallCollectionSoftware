@inject ApiOptions ApiCfg
@inject IJSRuntime JS

@code {
    private string Dflt => (ApiCfg?.BaseUrl ?? "").TrimEnd('/') + "/uploads/users/default.jpg";
    private readonly string _uniqueId = Guid.NewGuid().ToString("N").Substring(0, 8);
}

<div class="ss">
    <input type="text"
           class="form-control @CssClass"
           value="@query"
           placeholder="@Placeholder"
           @ref="_input"
           @onfocus="OnFocus"
           @oninput="OnInput"
           @onkeydown="OnKeyDown"
           @onfocusout="OnBlur" />

    @if (AllowClear && Value > 0)
    {
        @* دکمه پاک کردن انتخاب — در فیلترهای بالا و فرم‌ها، انتخاب اشتباه سریع قابل حذف است *@
        <button type="button" class="ss-clear" title="پاک کردن انتخاب" tabindex="-1"
                @onclick="ClearSelection" @onclick:stopPropagation="true">
            <i class="bi bi-x-lg"></i>
        </button>
    }

    @if (open)
    {
        @* پوشش نامرئی تمام‌صفحه — کلیک بیرون منو را می‌بندد؛ منوی fixed هیچ‌گاه زیر کارت‌ها نمی‌رود *@
        <div class="pop-overlay" @onclick="CloseMenu" @onclick:stopPropagation="true"></div>
        <div class="ss-menu" style="@MenuStyle" @onclick:stopPropagation="true">
            @if (matches.Count == 0)
            {
                <div class="ss-empty">موردی یافت نشد</div>
            }
            else
            {
                @for (var i = 0; i < matches.Count; i++)
                {
                    var idx = i;
                    var it = matches[idx];
                    var isSelected = it.Id == Value;
                    var isHighlighted = idx == highlightIndex;
                    <div id="@($"ss-opt-{_uniqueId}-{idx}")"
                         class="ss-item @(isSelected ? "selected" : "") @(isHighlighted ? "highlighted" : "")"
                         @onmousedown="@(() => Select(it))"
                         @onmousedown:preventDefault="true"
                         @onclick="@(() => Select(it))"
                         @onmouseover="@(() => highlightIndex = idx)">
                        @if (!string.IsNullOrWhiteSpace(it.AvatarUrl))
                        {
                            <img class="user-avatar user-avatar-sm" src="@it.AvatarUrl" alt="" loading="lazy" decoding="async"
                                 onerror="this.onerror=null;this.src='@Dflt';" />
                        }
                        <span class="ss-item-copy">
                            <span class="ss-item-name">@it.Name</span>
                            @if (!string.IsNullOrWhiteSpace(it.InfoText))
                            {
                                <small class="ss-item-info">@it.InfoText</small>
                            }
                        </span>
                    </div>
                }
                @if (matchesTotal > matches.Count)
                {
                    <div class="ss-more" @onclick:stopPropagation="true">
                        <i class="bi bi-info-circle"></i>
                        @matchesTotal.FaDigits() مورد پیدا شد — @matches.Count.FaDigits() مورد اول نمایش داده شده؛
                        برای رسیدن به بقیه، متن جستجو را دقیق‌تر کنید.
                    </div>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<LookupItem> Items { get; set; } = new();
    [Parameter] public int Value { get; set; }
    [Parameter] public EventCallback<int> ValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "انتخاب کنید…";
    [Parameter] public string CssClass { get; set; } = "";

    /// <summary>نمایش دکمه «پاک کردن» وقتی مقداری انتخاب شده است (پیش‌فرض: فعال)</summary>
    [Parameter] public bool AllowClear { get; set; } = true;

    /// <summary>اعلان متن جستجو برای بارگیری گزینه‌ها از سرور؛ انتخابگر همچنان با لیست محدود دریافتی کار می‌کند.</summary>
    [Parameter] public EventCallback<string> SearchChanged { get; set; }

    /// <summary>در حالت جستجوی راه‌دور، فیلتر گزینه‌ها را خود سرور انجام داده است.</summary>
    [Parameter] public bool RemoteSearch { get; set; }

    /// <summary>
    /// حداکثر گزینه‌ای که در منو رندر می‌شود.
    /// <para>
    /// چرا لازم است: بعضی کمبوها (مثل «همه پروژه‌ها» در گزارش کار) هزاران گزینه دارند.
    /// پیش‌تر هنگام فوکوس یا تایپ، همهٔ گزینه‌های منطبق یک‌جا در منو رندر می‌شد و مرورگر
    /// با ساخت هزاران گره DOM و درخواست آواتار برای هر ردیف، عملاً هنگ می‌کرد.
    /// اکنون فقط همین تعداد رندر می‌شود و تعداد کلِ منطبق در پایین منو نوشته می‌شود.
    /// </para>
    /// </summary>
    [Parameter] public int MaxVisible { get; set; } = 40;

    private string query = "";
    private bool open;
    private int highlightIndex = 0;

    /// <summary>گزینه‌های قابل نمایش در منو (حداکثر <see cref="MaxVisible"/> مورد).</summary>
    private List<LookupItem> matches = new();

    /// <summary>تعداد کل گزینه‌های منطبق با متن جستجو (ممکن است از تعداد نمایش‌داده‌شده بیشتر باشد).</summary>
    private int matchesTotal;

    /// <summary>
    /// بازسازی فهرست نتایج — یک‌بار در هر تغییر متن/گزینه‌ها، نه در هر بار خواندن مقدار
    /// (پیش‌تر <c>filtered</c> یک property بود و در هر رندر و هر حرکت کلید دوباره روی کل
    /// لیست LINQ اجرا می‌شد).
    /// </summary>
    private void RebuildMatches()
    {
        var q = (query ?? "").Trim();
        var starts = new List<LookupItem>(Math.Min(MaxVisible, 32)); // نامی که با متن شروع می‌شود
        var contains = new List<LookupItem>(Math.Min(MaxVisible, 32)); // بقیهٔ تطبیق‌ها
        var total = 0;
        foreach (var it in Items)
        {
            if (!RemoteSearch && q.Length > 0)
            {
                var idx = it.Name.IndexOf(q, StringComparison.OrdinalIgnoreCase);
                if (idx < 0) continue;
                total++;
                // نتایجی که نامشان با متن جستجو شروع می‌شود، اول فهرست می‌آیند
                if (idx == 0) { if (starts.Count < MaxVisible) starts.Add(it); }
                else if (contains.Count < MaxVisible) contains.Add(it);
            }
            else
            {
                total++;
                if (starts.Count < MaxVisible) starts.Add(it);
            }
        }
        if (contains.Count > 0)
            starts.AddRange(contains.Take(Math.Max(0, MaxVisible - starts.Count)));
        matches = starts;
        matchesTotal = total;

        if (highlightIndex >= matches.Count) highlightIndex = Math.Max(0, matches.Count - 1);
    }

    /// <summary>پاک کردن انتخاب فعلی — مقدار صفر (هیچ) به والد برمی‌گردد</summary>
    private async Task ClearSelection()
    {
        query = "";
        open = false;
        highlightIndex = 0;
        RebuildMatches();
        if (Value != 0)
        {
            Value = 0;
            await ValueChanged.InvokeAsync(0);
        }
    }

    private ElementReference _input;
    private double _mTop, _mLeft, _mWidth;

    /// <summary>منو با position:fixed هم‌عرض ورودی زیر آن باز می‌شود (الگوی منوی شناور) —
    /// مصون از stacking context کارت‌ها و overflow جدول/مودال</summary>
    private string MenuStyle => Popover.FixedStyle(_mTop, _mLeft, _mWidth);


    protected override void OnParametersSet()
    {
        if (Value > 0 && string.IsNullOrEmpty(query))
        {
            var sel = Items.FirstOrDefault(i => i.Id == Value);
            if (sel is not null) query = sel.Name;
        }
        if (Value == 0 && !string.IsNullOrEmpty(query) && !focused)
        {
            // مقدار پاک شده — فقط در صورت عدم فوکوس
            var exists = Items.Any(i => i.Name == query);
            if (!exists) query = "";
        }
        RebuildMatches();
    }

    private bool focused;

    private async Task OnFocus()
    {
        focused = true;
        await OpenMenu();
        highlightIndex = 0;
        if (Value > 0)
        {
            var sel = Items.FirstOrDefault(i => i.Id == Value);
            if (sel is not null)
            {
                query = sel.Name;
                RebuildMatches(); // فهرست منو با همین متن هم‌خوان شود
                var idx = matches.FindIndex(i => i.Id == Value);
                if (idx >= 0) highlightIndex = idx;
            }
        }
        else
        {
            RebuildMatches(); // منوی خالی: فهرست کامل (محدود به MaxVisible)
        }

        if (string.IsNullOrWhiteSpace(query) && SearchChanged.HasDelegate)
            await SearchChanged.InvokeAsync(query);
    }

    private async Task OpenMenu()
    {
        try
        {
            var r = await JS.InvokeAsync<UiRect>("uiRect", _input);
            (_mTop, _mLeft, _mWidth) = Popover.Below(r);
        }
        catch (JSException) { }
        open = true;
    }

    private void CloseMenu() => open = false;

    private async Task OnInput(ChangeEventArgs e)
    {
        query = e.Value?.ToString() ?? "";
        highlightIndex = 0;
        RebuildMatches(); // فهرست فقط یک‌بار برای همین متن ساخته می‌شود (نه در هر رندر)
        if (!open) await OpenMenu();
        if (SearchChanged.HasDelegate) await SearchChanged.InvokeAsync(query);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!open)
        {
            if (e.Key is "ArrowDown" or "ArrowUp")
            {
                await OpenMenu();
                highlightIndex = 0;
                return;
            }
            return;
        }

        if (matches.Count == 0) return;

        if (e.Key == "ArrowDown")
        {
            if (highlightIndex < matches.Count - 1)
                highlightIndex++;
            else
                highlightIndex = 0;

            await ScrollHighlightedIntoView();
        }
        else if (e.Key == "ArrowUp")
        {
            if (highlightIndex > 0)
                highlightIndex--;
            else
                highlightIndex = matches.Count - 1;

            await ScrollHighlightedIntoView();
        }
        else if (e.Key == "Enter")
        {
            if (matches.Count > 0)
            {
                var clamped = Math.Clamp(highlightIndex, 0, matches.Count - 1);
                await Select(matches[clamped]);
            }
        }
        else if (e.Key == "Escape")
        {
            CloseMenu();
        }
    }

    private async Task ScrollHighlightedIntoView()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollIntoViewById", $"ss-opt-{_uniqueId}-{highlightIndex}");
        }
        catch { }
    }

    private async Task OnBlur()
    {
        focused = false;
        await Task.Delay(160);
        open = false;
        // اگر متن انتخابی مطابق نیست، برگرد به نام گزینه انتخاب‌شده
        var sel = Items.FirstOrDefault(i => i.Id == Value);
        query = sel?.Name ?? "";
        RebuildMatches();
    }

    private async Task Select(LookupItem item)
    {
        query = item.Name;
        open = false;
        RebuildMatches();
        if (Value != item.Id)
        {
            Value = item.Id;
            await ValueChanged.InvokeAsync(item.Id);
        }
    }
}
