@* ============================================================
   نگه‌دارنده‌ی صفحاتِ تب‌ها
   • همه‌ی تب‌های باز یک‌بار ساخته می‌شوند و در DOM می‌مانند
   • تبِ غیرفعال فقط با display:none مخفی می‌شود، پس وضعیتش
     (فیلتر، شماره صفحه، اسکرول، فرم نیمه‌پر) دست‌نخورده می‌ماند
   • با افزایشِ Version (دکمهٔ بازسازی) آن تب از نو ساخته می‌شود
   ============================================================ *@
@inject TabService Tabs
@implements IDisposable

@foreach (var t in Tabs.Tabs)
{
    <div class="tabpane @(t.IsActive ? "on" : "")" @key="t.Key">
        @if (t.RouteData is not null)
        {
            <div class="tabpane-body" @key="t.Version">
                @* نگهبان «سامانه فروشگاهی»: هر بخش فقط با مجوز همان بخش باز می‌شود
                   (ورود مستقیم با آدرس هم پوشش داده می‌شود، نه فقط پنهان‌کردن آیتم منو) *@
                @if (HrNavigation.IsWorkspace(t.Key) && !ForoughAryaHrNavigation.IsWorkspace(t.Key))
                {
                    <HrWorkspaceShell>
                        <ShopSectionGate Path="@t.Key">
                            <BonHrSectionGate Path="@t.Key" Action="View">
                                <RouteView RouteData="@t.RouteData" />
                            </BonHrSectionGate>
                        </ShopSectionGate>
                    </HrWorkspaceShell>
                }
                else
                {
                    <ShopSectionGate Path="@t.Key">
                        <BonHrSectionGate Path="@t.Key" Action="View">
                            <RouteView RouteData="@t.RouteData" />
                        </BonHrSectionGate>
                    </ShopSectionGate>
                }
            </div>
        }
        else if (t.IsActive)
        {
            <div class="tabpane-wait">
                <span class="spinner-border spinner-border-sm"></span>
                <span>در حال آماده‌سازی…</span>
            </div>
        }
    </div>
}

@code {
    protected override void OnInitialized() => Tabs.Changed += OnChanged;

    private void OnChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Tabs.Changed -= OnChanged;
}
