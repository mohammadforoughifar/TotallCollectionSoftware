@* ============================================================
   نوار تب‌های کاری
   • هر بخش یک تب: آیکون + عنوان + دکمهٔ بستن
   • راست‌کلیک: بازسازی / سنجاق / انتقال / بستن بقیه / بستن همه / بستن
   • کشیدن و رها کردن برای تغییر ترتیب:
     - دسکتاپ: HTML5 Drag & Drop روی کل تب (با dataTransfer در JS)
     - لمسی/قلمی: کشیدن از دستگیرهٔ ⠿ با Pointer Events (در tabs.js)
     - صفحه‌کلید: Ctrl+←/→ روی تبِ فوکوس‌شده
   • تبِ خانه سنجاق است و بسته نمی‌شود
   • دکمه‌های ‹ › کنارِ نوار، صفحهٔ قبلی/بعدی را باز می‌کنند
   ============================================================ *@
@inject TabService Tabs
@inject IJSRuntime JS
@implements IDisposable

<div class="tabbar">
    @* صفحهٔ قبلی/بعدی (تاریخچهٔ بازدید، مثل مرورگر). اگر مقصدی نباشد دکمه واقعاً
       غیرفعال می‌شود تا کاربر به‌جای کلیکِ بی‌اثر، دلیل را ببیند. *@
    <button type="button" class="tabnav" title="صفحهٔ قبلی" aria-label="صفحهٔ قبلی" data-tab-nav="prev"
            disabled="@(PrevTab is null)" @onclick="GoPrev">
        <i class="bi bi-chevron-right"></i>
    </button>

    <div class="tabstrip" @ref="strip"
         @ondragover="OnStripDragOver" @ondragover:preventDefault="true"
         @ondrop="DropAtEnd" @ondrop:preventDefault="true"
         @ondragleave="OnStripDragLeave">
        @foreach (var t in Tabs.Tabs)
        {
            var tab = t;
            <div class="tab @(tab.IsActive ? "on" : "") @(tab.Pinned ? "pinned" : "") @(dragOver == tab ? "dragover" : "") @(dragging == tab ? "dragging" : "")"
                 data-tab-key="@tab.Key"
                 title="@($"{tab.Title} — برای تغییر ترتیب بکشید یا Ctrl+←/→ را بزنید")"
                 role="tab"
                 tabindex="0"
                 aria-selected="@tab.IsActive"
                 aria-label="@($"{tab.Title} — برای تغییر ترتیب بکشید")"
                 draggable="true"
                 @onclick="() => Activate(tab)"
                 @onkeydown="(KeyboardEventArgs e) => OnTabKeyDown(tab, e)"
                 @oncontextmenu="(MouseEventArgs e) => OpenMenu(tab, e)"
                 @oncontextmenu:preventDefault="true"
                 @ondragstart="() => dragging = tab"
                 @ondragend="OnDragEnd"
                 @ondragover="() => dragOver = tab" @ondragover:preventDefault="true"
                 @ondragenter="() => dragOver = tab"
                 @ondragleave="() => OnTabDragLeave(tab)"
                 @ondrop="() => Drop(tab)" @ondrop:stopPropagation="true" @ondrop:preventDefault="true">

                <span class="tab-grip" title="برای تغییر ترتیب بکشید" aria-hidden="true">
                    <i class="bi bi-grip-vertical"></i>
                </span>
                <i class="bi @tab.Icon tab-ico"></i>
                <span class="tab-title">@tab.Title</span>

                @if (tab.Pinned)
                {
                    <i class="bi bi-pin-angle-fill tab-pin" title="سنجاق‌شده"></i>
                }
                else
                {
                    <button class="tab-x" title="بستن تب"
                            @onclick:stopPropagation="true"
                            @onclick="() => Close(tab)">
                        <i class="bi bi-x"></i>
                    </button>
                }
            </div>
        }
    </div>

    <button type="button" class="tabnav" title="صفحهٔ بعدی" aria-label="صفحهٔ بعدی" data-tab-nav="next"
            disabled="@(NextTab is null)" @onclick="GoNext">
        <i class="bi bi-chevron-left"></i>
    </button>

    <div class="tabtools">
        <button class="tabtool" title="بازسازی این تب" @onclick="RefreshActive"
                disabled="@(Tabs.Active is null)">
            <i class="bi bi-arrow-clockwise"></i>
        </button>

        <div class="tabmenu-wrap">
            <button class="tabtool" title="فهرست تب‌ها" @onclick="() => listOpen = !listOpen">
                <i class="bi bi-list-ul"></i>
                <span class="tabcnt">@Tabs.Tabs.Count</span>
            </button>

            @if (listOpen)
            {
                <div class="tabmenu">
                    <div class="tabmenu-head">
                        <span>تب‌های باز (@Tabs.Tabs.Count.FaDigits())</span>
                        <button class="tabmenu-act" @onclick="CloseAll">بستن همه</button>
                    </div>
                    <div class="tabmenu-body">
                        @foreach (var t in Tabs.Tabs)
                        {
                            var tab = t;
                            <div class="tabmenu-row @(tab.IsActive ? "on" : "")" @onclick="() => Activate(tab)">
                                <i class="bi @tab.Icon"></i>
                                <span class="tabmenu-t">@tab.Title</span>
                                @if (tab.Pinned) { <i class="bi bi-pin-angle-fill tab-pin"></i> }
                                <span class="grow"></span>
                                @if (tab.Closable)
                                {
                                    <button class="tab-x" title="بستن"
                                            @onclick:stopPropagation="true"
                                            @onclick="() => Close(tab)">
                                        <i class="bi bi-x"></i>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@* ---------- منوی راست‌کلیک ---------- *@
@if (menuTab is not null)
{
    <div class="tabctx-backdrop" @onclick="() => menuTab = null"
         @oncontextmenu:preventDefault="true" @oncontextmenu="() => menuTab = null"></div>
    <div class="tabctx" style="left:@(menuX)px; top:@(menuY)px">
        <button class="tabctx-i" @onclick="() => Refresh(menuTab)">
            <i class="bi bi-arrow-clockwise"></i> بازسازی این تب
        </button>
        <button class="tabctx-i" @onclick="() => Pin(menuTab)" disabled="@(!menuTab.Closable && menuTab.Pinned)">
            <i class="bi @(menuTab.Pinned ? "bi-pin-angle" : "bi-pin-angle-fill")"></i>
            @(menuTab.Pinned ? "برداشتن سنجاق" : "سنجاق کردن")
        </button>
        <div class="tabctx-sep"></div>
        <button class="tabctx-i" @onclick="() => MoveToStart(menuTab)">
            <i class="bi bi-arrow-right-square"></i> انتقال به ابتدای نوار
        </button>
        <button class="tabctx-i" @onclick="() => MoveToEnd(menuTab)">
            <i class="bi bi-arrow-left-square"></i> انتقال به انتهای نوار
        </button>
        <div class="tabctx-sep"></div>
        <button class="tabctx-i" @onclick="() => CloseOthers(menuTab)">
            <i class="bi bi-x-circle"></i> بستن بقیه
        </button>
        <button class="tabctx-i" @onclick="CloseAll">
            <i class="bi bi-x-square"></i> بستن همه
        </button>
        <div class="tabctx-sep"></div>
        <button class="tabctx-i danger" @onclick="() => Close(menuTab)" disabled="@(!menuTab.Closable)">
            <i class="bi bi-x-lg"></i> بستن این تب
        </button>
    </div>
}

@code {
    private ElementReference strip;
    private bool listOpen;
    private TabItem? dragging;
    private TabItem? dragOver;

    private TabItem? menuTab;
    private double menuX, menuY;

    private DotNetObjectReference<TabBar>? _self;
    private DateTime _lastDropUtc = DateTime.MinValue;

    protected override void OnInitialized() => Tabs.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try { await JS.InvokeVoidAsync("appTabs.enableWheel", strip); } catch { }
            try
            {
                _self ??= DotNetObjectReference.Create(this);
                await JS.InvokeVoidAsync("appTabs.enableDrag", strip, _self);
            }
            catch { }
        }
        try { await JS.InvokeVoidAsync("appTabs.scrollToActive", strip); } catch { }
    }

    private void OnChanged()
    {
        listOpen = false;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        Tabs.Changed -= OnChanged;
        _self?.Dispose();
    }

    // ---------- عملیات ----------

    private void Activate(TabItem t)
    {
        menuTab = null;
        // کلیکِ بلافاصله بعد از رها کردن (HTML5 یا لمسی) نباید تب را فعال کند؛
        // وگرنه کاربر فقط می‌خواست ترتیب را عوض کند ولی صفحه هم عوض می‌شود.
        if ((DateTime.UtcNow - _lastDropUtc).TotalMilliseconds < 350) return;
        Tabs.Activate(t);
    }

    private async Task Close(TabItem t)
    {
        menuTab = null;
        await Tabs.CloseAsync(t);
    }

    private async Task CloseOthers(TabItem t)
    {
        menuTab = null;
        await Tabs.CloseOthersAsync(t);
    }

    private async Task CloseAll()
    {
        menuTab = null;
        listOpen = false;
        await Tabs.CloseAllAsync();
    }

    private void Refresh(TabItem t)
    {
        menuTab = null;
        Tabs.Refresh(t);
    }

    private void RefreshActive()
    {
        if (Tabs.Active is { } a) Tabs.Refresh(a);
    }

    private async Task Pin(TabItem t)
    {
        menuTab = null;
        await Tabs.TogglePinAsync(t);
    }

    private async Task MoveToStart(TabItem t)
    {
        menuTab = null;
        await Tabs.MoveToAsync(t, 0);
    }

    private async Task MoveToEnd(TabItem t)
    {
        menuTab = null;
        await Tabs.MoveToAsync(t, Tabs.Tabs.Count - 1);
    }

    // ---------- کشیدن و رها کردن (دسکتاپ — HTML5) ----------

    private async Task Drop(TabItem target)
    {
        dragOver = null;
        _lastDropUtc = DateTime.UtcNow;
        if (dragging is null || ReferenceEquals(dragging, target)) { dragging = null; return; }
        await Tabs.MoveAsync(dragging, target);
        dragging = null;
    }

    /// <summary>رها کردن روی فضای خالیِ نوار (بعد از آخرین تب) — تب به انتها می‌رود.</summary>
    private async Task DropAtEnd()
    {
        dragOver = null;
        _lastDropUtc = DateTime.UtcNow;
        if (dragging is null) return;
        await Tabs.MoveToAsync(dragging, Tabs.Tabs.Count - 1);
        dragging = null;
    }

    private void OnDragEnd()
    {
        dragging = null;
        dragOver = null;
    }

    private void OnTabDragLeave(TabItem tab)
    {
        if (dragOver == tab) dragOver = null;
    }

    private void OnStripDragOver()
    {
        // فقط برای اجازه دادن به drop (preventDefault در خط بالا)؛
        // نشانگر روی تبِ زیرِ نشانگر با dragenter/dragoverِ خودِ تب تنظیم می‌شود.
    }

    private void OnStripDragLeave()
    {
        dragOver = null;
    }

    /// <summary>
    /// فراخوانی از JS بعد از درگ لمسی/قلمی (tabs.js).
    /// <paramref name="sourceKey"/> کلیدِ تبِ کشیده‌شده و <paramref name="targetIndex"/>
    /// ایندکسِ نهایی در فهرست است (۰ تا Count-1).
    /// </summary>
    [JSInvokable]
    public async Task OnTabDropped(string sourceKey, int targetIndex)
    {
        _lastDropUtc = DateTime.UtcNow;
        dragging = null;
        dragOver = null;
        await Tabs.MoveByKeyAsync(sourceKey, targetIndex);
    }

    // ---------- جابه‌جایی با صفحه‌کلید ----------

    private async Task OnTabKeyDown(TabItem tab, KeyboardEventArgs e)
    {
        // در نوارِ RTL، «چپ» یعنی دیداری به چپ = ایندکسِ بزرگ‌تر و «راست» یعنی ایندکسِ کوچک‌تر.
        if (e.CtrlKey && e.Key == "ArrowLeft")
            await Tabs.MoveByOffsetAsync(tab, +1);
        else if (e.CtrlKey && e.Key == "ArrowRight")
            await Tabs.MoveByOffsetAsync(tab, -1);
        else if (e.CtrlKey && e.Key == "Home")
            await Tabs.MoveToAsync(tab, 0);
        else if (e.CtrlKey && e.Key == "End")
            await Tabs.MoveToAsync(tab, Tabs.Tabs.Count - 1);
    }

    // ---------- منو و پیمایش ----------

    private void OpenMenu(TabItem t, MouseEventArgs e)
    {
        menuTab = t;
        menuX = e.ClientX;
        menuY = e.ClientY;
        listOpen = false;
    }

    // ---------- جابه‌جایی بین صفحه‌ها (قبلی/بعدی مثل مرورگر) ----------

    /// <summary>صفحهٔ قبلی در تاریخچهٔ بازدید؛ null یعنی دکمه غیرفعال است.</summary>
    private TabItem? PrevTab => Tabs.Previous;

    /// <summary>صفحهٔ بعدی در تاریخچهٔ بازدید؛ null یعنی دکمه غیرفعال است.</summary>
    private TabItem? NextTab => Tabs.Next;

    private void GoPrev()
    {
        menuTab = null;
        listOpen = false;
        Tabs.GoBack();
    }

    private void GoNext()
    {
        menuTab = null;
        listOpen = false;
        Tabs.GoForward();
    }
}
