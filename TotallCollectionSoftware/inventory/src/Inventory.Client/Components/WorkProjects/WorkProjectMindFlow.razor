    private static double Width(WorkProjectMindFlowNodeDto node)
        => Math.Clamp(node.Width ?? (node.ParentId is null ? 250 : Math.Clamp(100 + node.Text.Length * 12, 145, 245)), MinNodeWidth, MaxNodeWidth);
    private static double Height(WorkProjectMindFlowNodeDto node)
        => Math.Clamp(node.Height ?? (node.ParentId is null ? 82 : 62), MinNodeHeight, MaxNodeHeight);
    private void AdjustSelectedNodeSize(double widthDelta, double heightDelta)
    {
        if (!CanEdit || SelectedNode is not { } node) return;
        var width = Math.Clamp(Width(node) + widthDelta, MinNodeWidth, MaxNodeWidth);
        var height = Math.Clamp(Height(node) + heightDelta, MinNodeHeight, MaxNodeHeight);
        if (width == Width(node) && height == Height(node)) return;
        Snapshot();
        node.Width = width; node.Height = height;
        node.X = Math.Clamp(node.X, width / 2 + 4, 1600 - width / 2 - 4);
        node.Y = Math.Clamp(node.Y, height / 2 + 4, 900 - height / 2 - 4);
        Dirty();
    }
