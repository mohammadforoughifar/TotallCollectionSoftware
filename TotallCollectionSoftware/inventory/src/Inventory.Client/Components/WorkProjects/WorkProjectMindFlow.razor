                                }
                            }
                        }
                        else
                        {
                            <div class="wpmf-empty-check">اطلاعات این دستورکار در دسترس نیست یا مجوز مشاهدهٔ آن را نداری.</div>
                            <a class="small" href="@($"/work-orders?open={linkedOrderId}")" target="_blank" rel="noopener noreferrer">رفتن به دستورکار در تب جدید</a>
                        }
                    }
                    else if (NodeWorkOrderIds(SelectedNode).Count == 0)
                    {
                        <div class="wpmf-empty-check">برای دیدن چک‌لیست اصلی، دستورکارهای موجود را به این گره وصل کن.</div>
                    }
                    </section>
                    <section class="wpmf-inspector-card wpmf-subflow-card">
                        <header class="wpmf-card-heading"><i class="bi bi-diagram-3"></i><span>زیرنگاشت</span><span class="wpmf-card-status">@(SelectedNode.ChildMindFlow is not null ? "ساخته‌شده" : SelectedNode.LinkedMindFlowProjectId.HasValue ? "پیوندشده" : "ندارد")</span></header>
                    @if (SelectedNode.ChildMindFlow is not null)
                    {
                        <a class="wpmf-subflow-link" href="@SubMindFlowHref(SelectedNode.Id)" target="_blank" rel="noopener noreferrer">
                            <i class="bi bi-diagram-3"></i> @(CanEdit ? "طراحی" : "مشاهدهٔ") «@SelectedNode.ChildMindFlow.Title» در تب جدید
                        </a>
                    }
                    else if (SelectedNode.LinkedMindFlowProjectId is int linkedMindFlowId)
                    {
                        var linkedMindFlow = FindAccessibleMindFlow(linkedMindFlowId);
                        @if (linkedMindFlow is not null)
                        {
                            <a class="wpmf-subflow-link" href="@($"/work-projects/mindflow?projectId={linkedMindFlow.ProjectId}")" target="_blank" rel="noopener noreferrer">
                                <i class="bi bi-diagram-3"></i> @(linkedMindFlow.CanManage && linkedMindFlow.Status == "Open" ? "طراحی" : "مشاهدهٔ") «@linkedMindFlow.Title» در تب جدید
                            </a>
                        }
                        else
                        {
                            <div class="wpmf-empty-check">این زیرمایندفلو برای حساب فعلی قابل مشاهده نیست.</div>
                        }
                        @if (CanEdit)
                        {
                            <button type="button" class="btn btn-sm btn-link text-danger p-0 mt-1" @onclick="UnlinkExistingMindFlow">قطع پیوند</button>
                        }
                    }
                    else if (CanEdit)
                    {
                        <label class="form-label small mb-1">جست‌وجو و پیوند به مایندفلو موجود</label>
                        <div class="wpmf-combobox mb-2">
                            <input class="form-control form-control-sm" role="combobox" aria-expanded="@_showMindFlowOptions" aria-controls="wpmf-mindflow-options"
                                   placeholder="نام یا شمارهٔ پروژه را جست‌وجو کن…" value="@_mindFlowSearch"
                                   @oninput="SearchMindFlows" @onfocus="ShowMindFlowOptions" />
                            @if (_showMindFlowOptions)
                            {
                                <div id="wpmf-mindflow-options" class="wpmf-combo-options" role="listbox">
                                    @if (_mindFlowsLoading) { <div class="wpmf-combo-empty">در حال بارگذاری…</div> }
                                    else if (FilteredMindFlows.Count == 0) { <div class="wpmf-combo-empty">مایندفلوی دیگری در دسترس نیست.</div> }
                                    else
                                    {
                                        @foreach (var flow in FilteredMindFlows)
                                        {
                                            <button type="button" class="wpmf-combo-option" @key="flow.ProjectId" @onclick="() => LinkExistingMindFlow(flow)">
                                                <strong>@flow.Number — @flow.Title</strong>
                                                <small>@(flow.Status == "Closed" ? "بسته · فقط‌خواندنی" : "باز")</small>
                                            </button>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" @onclick="CreateChildMindFlowAsync" disabled="@_saving">
                            <i class="bi bi-plus-circle"></i> ساخت زیرمایندفلوی تازه
                        </button>
                    }
                    </section>
                    @if (CanManageAccess)
                    {
                        <section class="wpmf-access-panel wpmf-inspector-card">
                            <div class="wpmf-checks-title"><b>@(IsStandalone ? "دسترسی‌های این نگاشت" : "افرادی که نگاشت را می‌بینند")</b><span>@_mindFlowMembers.Count اشتراک</span></div>
                            <div class="small text-muted mb-2">@(IsStandalone ? "فقط شما و افراد دعوت‌شده به این نگاشت دسترسی دارند؛ نقش ویرایشگر امکان طراحی می‌دهد." : "مدیر و اعضای پروژه خودکار دسترسی دارند؛ دعوت مستقیم فقط مشاهده است.")</div>
                            @if (!string.IsNullOrWhiteSpace(_accessMessage))
                            {
                                <div class="alert @AccessMessageClass py-1 px-2 small mb-2">@_accessMessage</div>
                            }
                            @if (IsStandalone)
                            {
                                <label class="form-label small mb-1" for="wpmf-invite-role">نقش دعوت‌شده‌ها</label>
                                <select id="wpmf-invite-role" class="form-select form-select-sm mb-2" @bind="_inviteRole">
                                    <option value="Viewer">فقط مشاهده</option>
                                    <option value="Editor">مشاهده و طراحی</option>
                                </select>
                            }
                            <label class="form-label small mb-1">جست‌وجو و انتخاب چند نفر برای دعوت</label>
                            <div class="wpmf-combobox mb-2">
                                <input class="form-control form-control-sm" role="combobox" aria-expanded="@_showCandidateOptions" aria-controls="wpmf-candidate-options"
                                       placeholder="نام یا نام کاربری را جست‌وجو کن…" value="@_memberSearch"
                                       @oninput="SearchMindFlowCandidatesAsync" @onfocus="ShowCandidateOptions"
                                       @onkeydown="OnCandidateSearchKeyDown" />
                                @if (_candidatesLoading) { <span class="wpmf-combo-spinner spinner-border spinner-border-sm" aria-hidden="true"></span> }
                                @if (_showCandidateOptions)
                                {
                                    <div id="wpmf-candidate-options" class="wpmf-combo-options" role="listbox" aria-multiselectable="true">
                                        @if (_candidates.Count > 0)
                                        {
                                            <div class="wpmf-combo-head">
                                                <span>@_candidates.Count کاربر در دسترس</span>
                                                @if (_selectedCandidateIds.Count > 0) { <b>@_selectedCandidateIds.Count انتخاب‌شده</b> }
                                                <button type="button" class="wpmf-combo-close" aria-label="بستن فهرست" @onclick="CloseCandidateOptions">×</button>
                                            </div>
                                        }
                                        @if (_candidatesLoading && _candidates.Count == 0)
                                        {
                                            <div class="wpmf-combo-empty">در حال جست‌وجو…</div>
                                        }
                                        else if (_candidates.Count == 0)
                                        {
                                            <div class="wpmf-combo-empty">
                                                @(string.IsNullOrWhiteSpace(_memberSearch)
                                                    ? "فرد فعالی برای دعوت نمانده است — مدیر و اعضای پروژه از قبل دسترسی دارند."
                                                    : "کسی با این نام پیدا نشد.")
                                            </div>
                                        }
                                        else
                                        {
                                            @foreach (var user in _candidates)
                                            {
                                                var isSelected = _selectedCandidateIds.Contains(user.UserId);
                                                <button type="button" class="wpmf-combo-option @(isSelected ? "selected" : "")" @key="user.UserId" @onclick="() => ToggleCandidate(user)">
                                                    <span><i class="bi @(isSelected ? "bi-check-square-fill" : "bi-square")"></i> @user.Name</span>
                                                    <small>@(isSelected ? "انتخاب‌شده" : "افزودن به انتخاب")</small>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            @if (_selectedCandidateIds.Count > 0)
                            {
                                <div class="wpmf-selection-chips">
                                    @foreach (var candidateId in _selectedCandidateIds)
                                    {
                                        <span class="wpmf-selection-chip" @key="candidateId">@_selectedCandidateNames.GetValueOrDefault(candidateId, $"کاربر #{candidateId}")
                                            <button type="button" aria-label="حذف از انتخاب" @onclick="() => RemoveCandidateFromSelection(candidateId)">×</button>
                                        </span>
                                    }
                                </div>
                            }
                            <div class="wpmf-add-member">
                                <button type="button" class="btn btn-sm btn-outline-primary" @onclick="AddMindFlowMemberAsync" disabled="@(_selectedCandidateIds.Count == 0 || _peopleLoading || _savingMembers)">
                                    <i class="bi bi-person-plus"></i> افزودن @(_selectedCandidateIds.Count > 0 ? $"{_selectedCandidateIds.Count} نفر" : "افراد انتخاب‌شده")
                                </button>
                            </div>
                            @if (_peopleLoading) { <div class="small text-muted py-2">در حال دریافت دسترسی‌ها…</div> }
                            else if (_mindFlowMembers.Count == 0) { <div class="small text-muted py-2">هنوز کسی مستقیم به نگاشت دعوت نشده است.</div> }
                            else
                            {
                                @foreach (var member in _mindFlowMembers)
                                {
                                    <div class="wpmf-member-row" @key="member.UserId"><span><i class="bi bi-person-check"></i> @member.Name @if (IsStandalone) { <small class="text-muted">· @(member.Role == "Editor" ? "ویرایشگر" : "فقط مشاهده")</small> }</span><button class="wpmf-remove" @onclick="() => RemoveMindFlowMemberAsync(member)" title="لغو دسترسی">×</button></div>
                                }
                            }
                        </section>
                    }
                }
                else { <div class="text-muted small">یک گره را انتخاب کن.</div> }
            </aside>
        </div>
    }
</div>

@* ---------- پیش‌نمایش چاپ نقشه ---------- *@
@if (_printOpen)
{
    <div class="wpmf-print-overlay" id="@_printOverlayId" tabindex="-1" role="dialog" aria-modal="true" aria-label="پیش‌نمایش چاپ نگار ذهنی" @onkeydown="OnPrintKeyDown">
        <div class="wpmf-print-head">
            <div class="wpmf-print-heading">
                <i class="bi bi-printer"></i>
                <div>
                    <strong>پیش‌نمایش چاپ نگار ذهنی</strong>
                    <span>@PrintSubtitle</span>
                </div>
            </div>
            <div class="wpmf-print-actions">
                <button type="button" class="btn btn-sm btn-light" @onclick="ClosePrint"><i class="bi bi-x-lg"></i> بستن</button>
                <button type="button" class="btn btn-sm btn-primary" @onclick="PrintAsync"><i class="bi bi-printer"></i> چاپ</button>
            </div>
        </div>
        <div class="wpmf-print-stage">
            <div class="wpmf-print-sheet">
                <header class="wpmf-print-sheet-head">
                    <div class="wpmf-print-sheet-title">
                        <strong>@PrintTitle</strong>
                        <span>@PrintSubtitle</span>
                    </div>
                    <div class="wpmf-print-sheet-meta">
                        <span>@PrintMeta</span>
                    </div>
                </header>
                <div class="wpmf-print-sheet-canvas" id="@_printCanvasId"></div>
                <footer class="wpmf-print-sheet-foot">نرم‌افزار یکپارچه فروغ آریا — نگار ذهنی</footer>
            </div>
        </div>
    </div>
}

@code {
    private static readonly string[] Palette = ["#596cf3", "#e28b4d", "#32a783", "#ae6fc7", "#d85d75", "#318eae"];
