        _workOrderLoadGeneration++; _candidateSearchGeneration++;
        _loadedProjectId = ProjectId; _loadedStandaloneMapId = StandaloneMapId; _loadedSubFlowPath = subPath;
        _projectOrders.Clear(); _workOrderCache.Clear(); _workOrderSkip = 0; _hasMoreWorkOrders = false; _loadingOrders = false; _linkedChecklist.Clear(); _loadedChecklistOrderId = null;
        _checklistLoadGeneration++; _loadingChecklist = false; _selectedWorkOrderId = null; _showNodeWorkOrderList = false;
        _mindFlowMembers.Clear(); _candidates.Clear(); _selectedCandidateIds.Clear(); _selectedCandidateNames.Clear();
        _accessMessage = ""; _savingMembers = false;
