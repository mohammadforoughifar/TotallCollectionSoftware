    {
        if (!CanEdit || SelectedNode is null) return; Snapshot(); var branch = SelectedNode; while (branch.ParentId is Guid p && _map.Nodes.FirstOrDefault(n => n.Id == p) is { ParentId: not null } parent) branch = parent; Recolor(branch.Id, color); Dirty();
