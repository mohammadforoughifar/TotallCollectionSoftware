            _selectedId = SelectedNodeId is Guid requested && _map.Nodes.Any(n => n.Id == requested)
                ? requested : _map.Nodes.FirstOrDefault(n => n.ParentId is null)?.Id ?? Guid.Empty;
            var initialOrders = NodeWorkOrderIds(SelectedNode);
            _selectedWorkOrderId = initialOrders.Count > 0 ? initialOrders[0] : null;
            _lastRequestedNodeId = SelectedNodeId;
            _status = isNewMap ? "نگاشت تازه؛ ذخیره‌نشده" : "ذخیره‌شده"; _dirty = isNewMap && string.IsNullOrWhiteSpace(subPath); _message = "";
            await LoadProjectOrdersAsync();
            await LoadAvailableMindFlowsAsync();
            await LoadLinkedChecklistAsync();
            if (CanManageAccess) await LoadMindFlowPeopleAsync();
            if (isNewMap && !string.IsNullOrWhiteSpace(subPath)) _message = "این زیرمایندفلو هنوز ذخیره نشده یا در دسترس نیست.";
        }
        catch (Exception ex) when (ex is HttpRequestException or System.Text.Json.JsonException)
        {
            _map = new WorkProjectMindFlowDto { ProjectId = ProjectId, Title = ProjectTitle, Nodes = new() };
            if (string.IsNullOrWhiteSpace(subPath)) { CreateStarter(); _message = "نقشه بارگذاری نشد؛ اتصال API را بررسی کن."; }
            else _message = "زیرمایندفلو پیدا نشد یا دسترسی لازم را نداری.";
        }
        finally { _loading = false; }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_attached && !_loading && _map.Nodes.Count > 0)
        {
            _self ??= DotNetObjectReference.Create(this);
            await AttachDragAsync();
            await BindCanvasKeysAsync();
        }
        if (_focusNodeTitlePending)
        {
            _focusNodeTitlePending = false;
            try { await JS.InvokeVoidAsync("inventoryWorkProjectMindFlow.focusNodeTitle", _svgId); }
            catch (Exception ex) when (ex is JSException or InvalidOperationException or TaskCanceledException) { /* فوکوس اختیاری است */ }
        }
        // بعد از تغییر بزرگ‌نمایی، مرکز دید را به جای قبلی برمی‌گردانیم.
        await RestoreZoomAnchorAsync();

        // پیش‌نمایش چاپ تازه باز شده: نسخهٔ چاپی نقشه را می‌سازیم (DOM الان آماده است).
        if (_printMountPending)
        {
            _printMountPending = false;
            try
            {
                await JS.InvokeVoidAsync("inventoryWorkProjectMindFlow.mountPrintPreview", _svgId, _printCanvasId);
                await JS.InvokeVoidAsync("inventoryWorkProjectMindFlow.focusPrintOverlay", _printOverlayId);
            }
            catch (JSException) { /* پیش‌نمایش بدون نسخهٔ چاپی هم باز می‌ماند */ }
            catch (Exception ex) when (ex is InvalidOperationException or TaskCanceledException) { }
        }
    }

    /// <summary>
    /// اتصال «کشیدنِ گره‌ها» به ماژول JS — دو لایه تا حتی با index.html قدیمیِ کش‌شده هم کار کند.
    /// هر خطای JS فقط «کشیدن با ماوس» را از کار می‌اندازد، نه رندر صفحه.
    /// </summary>
    private async Task AttachDragAsync()
    {
        var wasUnavailable = _dragUnavailable;
        try
        {
            // مسیر اول: اسکریپت کلاسیکِ index.html (window.inventoryWorkProjectMindFlow).
            // بدون «eval» بررسی می‌شود تا با CSP سخت‌گیرانه هم کار کند؛ اگر تگ script نباشد،
            // فراخوانی JSException می‌دهد و به مسیر ماژول می‌رویم.
            var attached = false;
            try
            {
                attached = await JS.InvokeAsync<bool>("inventoryWorkProjectMindFlow.attachDrag", _svgId, _self);
            }
            catch (JSException) { /* تگ script در index.html نیست (نسخهٔ کش‌شده یا فراموش‌شده) */ }

            if (!attached)
            {
                _dragModule ??= await JS.InvokeAsync<IJSObjectReference>("import",
                    "./js/inventory-workproject-mindflow.module.js?v=4");
                attached = await _dragModule.InvokeAsync<bool>("attachDrag", _svgId, _self);
            }

            _attached = true;
            _dragUnavailable = !attached;
        }
        catch (Exception ex)
        {
            _attached = true;
            _dragUnavailable = true;
            Console.WriteLine($"[MindFlow] فعال‌سازی کشیدن گره‌ها انجام نشد: {ex.Message}");
        }

        // پیام «کشیدن فعال نشد» فقط وقتی نمایش داده می‌شود که وضعیت عوض شده باشد.
        if (wasUnavailable != _dragUnavailable) await InvokeAsync(StateHasChanged);
    }

    /// <summary>
    /// پیمایش بوم با کلیدهای جهت — کاملاً در JS انجام می‌شود تا حرکت نرم و بدون تأخیر باشد.
    /// </summary>
    private async Task BindCanvasKeysAsync()
