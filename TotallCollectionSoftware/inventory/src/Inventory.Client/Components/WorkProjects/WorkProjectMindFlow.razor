    private readonly HashSet<Guid> _unsavedChildNodeIds = new();
    private readonly List<WorkProjectMindFlowMemberDto> _mindFlowMembers = new();
    private readonly List<WorkProjectMindFlowUserDto> _candidates = new();
    private readonly HashSet<int> _selectedCandidateIds = new();
    private readonly Dictionary<int, string> _selectedCandidateNames = new();
    private int? _loadedChecklistOrderId;
    private int? _dragChecklistItemId, _checklistDropTargetId;
    private int _checklistLoadGeneration, _workOrderLoadGeneration, _workOrderSkip, _candidateSearchGeneration;
    private bool _hasMoreWorkOrders;
    private string _memberSearch = "", _mindFlowSearch = "", _inviteRole = "Viewer";
    private bool _peopleLoading, _candidatesLoading, _savingMembers, _wasCanManageAccess, _loadingOrders, _showWorkOrderOptions, _showCandidateOptions, _showMindFlowOptions, _mindFlowsLoading;
