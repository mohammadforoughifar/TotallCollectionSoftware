        _loading = true;
        try
        {
            var url = string.IsNullOrWhiteSpace(subPath) ? RootMapApiUrl : SubMapApiUrl(subPath);
            _map = await Http.GetFromJsonAsync<WorkProjectMindFlowDto>(url) ?? new();
            _map.Nodes ??= new();
            var isNewMap = _map.Nodes.Count == 0;
            if (isNewMap && string.IsNullOrWhiteSpace(subPath)) CreateStarter();
