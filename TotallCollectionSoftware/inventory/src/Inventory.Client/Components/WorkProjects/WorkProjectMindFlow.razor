    private string _orderSearch = "";
    /// <summary>اندازهٔ ثابت فضای طراحی (واحد کاربر). بزرگ‌نمایی روی خودِ بوم اعمال می‌شود، نه با برشِ viewBox.</summary>
    private const double DesignWidth = 1600;
    private const double DesignHeight = 900;
    private const double MinZoom = .5;
    private const double MaxZoom = 2.5;
    private double Zoom = 1;
    /// <summary>بومِ رندرشده؛ با بزرگ‌نمایی بزرگ می‌شود تا سطح اسکرول افقی و عمودی هم بزرگ شود.</summary>
    private double CanvasWidth => DesignWidth * Zoom;
    private double CanvasHeight => DesignHeight * Zoom;
