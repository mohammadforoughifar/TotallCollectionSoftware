    /// که فوکوس روی خودشان باشد؛ این میان‌بر برای وقتی است که فوکوس جای دیگری رفته باشد.
    /// </summary>
    private async Task OnDocumentKeyDown(KeyboardEventArgs e)
    {
        if (_nodeTitleEditingId is not Guid editing) return;
        if (_map.Nodes.FirstOrDefault(n => n.Id == editing) is not { } node) { _nodeTitleEditingId = null; return; }
        switch (e.Key)
        {
            case "Escape": EndNodeTitleEdit(node, commit: false); break;
            case "Enter" when e.CtrlKey: EndNodeTitleEdit(node, commit: true); break;
            default: return;
        }
        await InvokeAsync(StateHasChanged);
    }

