    private void Normalize()
    {
        _map.Nodes ??= new();
        foreach (var node in _map.Nodes)
        {
            node.Note ??= "";
            node.Color = string.IsNullOrWhiteSpace(node.Color) ? Palette[0] : node.Color;
            node.WorkOrderIds ??= new();
            if (node.WorkOrderId is int legacy && legacy > 0 && !node.WorkOrderIds.Contains(legacy)) node.WorkOrderIds.Insert(0, legacy);
            node.WorkOrderIds = node.WorkOrderIds.Where(id => id > 0).Distinct().ToList();
            node.WorkOrderId = null;
        }
    }
    private async Task SaveAsync()
    {
        if (!CanEdit || _saving) return;
        _saving = true; _message = "";
        try
        {
            Normalize();
            _map.ProjectId = IsStandalone ? 0 : ProjectId;
            var path = NormalizeSubMindFlowPath(SubFlowPath);
            var url = string.IsNullOrWhiteSpace(path) ? RootMapApiUrl : SubMapApiUrl(path);
            var response = await Http.PutAsJsonAsync(url, _map);
            if (!response.IsSuccessStatusCode) { _message = await ErrorMessage(response); return; }
            _dirty = false; _unsavedChildNodeIds.Clear(); _status = $"ذخیره شد · {DateTime.Now:HH:mm}";
        }
        catch (HttpRequestException) { _message = "ذخیره انجام نشد؛ اتصال به سرور را بررسی کن."; }
        finally { _saving = false; }
    }
