            if (SelectedNodeId != _lastRequestedNodeId)
            {
                _lastRequestedNodeId = SelectedNodeId;
                if (SelectedNodeId is Guid requested && _map.Nodes.Any(n => n.Id == requested)) await Select(requested);
            }
