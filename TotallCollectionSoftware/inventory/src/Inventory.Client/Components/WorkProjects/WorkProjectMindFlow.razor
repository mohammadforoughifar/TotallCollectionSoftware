    [Parameter] public string ProjectTitle { get; set; } = "پروژه";
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public bool CanManageAccess { get; set; }
    [Parameter] public Guid? SelectedNodeId { get; set; }
    [Parameter] public string? SubFlowPath { get; set; }
    private WorkProjectMindFlowDto _map = new();
    private readonly Stack<string> _undo = new();
    private readonly Stack<string> _redo = new();
