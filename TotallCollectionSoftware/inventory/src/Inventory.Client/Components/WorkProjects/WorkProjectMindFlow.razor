    /// <summary>برداشتن شنونده‌های کشیدن از SVG/window (جلوگیری از نشتی و تداخل بین نشست‌ها).</summary>
    private void DetachDrag()
    {
        if (!_attached) return;
        _attached = false;
        _ = SafeDetachAsync();
    }

    private async Task SafeDetachAsync()
    {
        try { await JS.InvokeVoidAsync("inventoryWorkProjectMindFlow.detachDrag", _svgId); }
        catch { /* صفحه/JS در حال تخریب است */ }
        if (_dragModule is not null)
        {
            var module = _dragModule; _dragModule = null;
            try { await module.DisposeAsync(); } catch { }
        }
    }
