    private string PrintMeta => $"{PersianDate.ToLong(DateTime.Now)} — {VisibleNodes.Count} گره";
    private bool IsStandalone => StandaloneMapId is > 0;
    private string _svgId => IsStandalone ? $"wpmf-canvas-standalone-{StandaloneMapId}" : $"wpmf-canvas-{ProjectId}";
    private string _canvasWrapId => $"{_svgId}-wrap";
    private string RootMapApiUrl => IsStandalone ? $"api/mindflows/{StandaloneMapId}" : $"api/workprojects/{ProjectId}/mindflow";
    private string ShareApiUrl => IsStandalone ? $"api/mindflows/{StandaloneMapId}" : $"api/workprojects/{ProjectId}/mindflow";
    private string SubMapApiUrl(string path) => IsStandalone
        ? $"api/mindflows/{StandaloneMapId}/sub?path={Uri.EscapeDataString(path)}"
        : $"api/workprojects/{ProjectId}/mindflow/sub?path={Uri.EscapeDataString(path)}";
    private WorkProjectMindFlowNodeDto? SelectedNode => _map.Nodes.FirstOrDefault(n => n.Id == _selectedId);
    private string AccessMessageClass => _accessMessage.StartsWith("دسترسی ثبت شد", StringComparison.Ordinal) || _accessMessage == "دسترسی لغو شد." ? "alert-success" : "alert-warning";
    private List<WorkProjectMindFlowNodeDto> VisibleNodes => _map.Nodes.Where(IsVisible).ToList();
    private int LinkedWorkOrderCount => _map.Nodes.SelectMany(NodeWorkOrderIds).Distinct().Count();
    private List<MindFlowWorkOrder> FilteredWorkOrders => _projectOrders.Concat(_workOrderCache.Values)
        .GroupBy(o => o.Id).Select(g => g.First())
        .Where(o => !_map.Nodes.SelectMany(NodeWorkOrderIds).Contains(o.Id))
        .ToList();

    /// <summary>
    /// دستورکارهای متصل به گرهٔ انتخاب‌شده، فیلترشده با <see cref="_orderSearch"/>.
    /// جست‌وجو روی شماره، عنوان و نام پروژه، بدون حساسیت به فاصلهٔ ابتدا/انتها.
    /// شناسه‌هایی که جزئیاتشان هنوز بارگذاری نشده (FindWorkOrder == null) هم با «#شماره» قابل جست‌وجو هستند.
    /// </summary>
    private List<(int Id, MindFlowWorkOrder? Order)> FilteredNodeWorkOrders
    {
        get
        {
            var term = (_orderSearch ?? "").Trim();
            var rows = NodeWorkOrderIds(SelectedNode).Select(id => (Id: id, Order: FindWorkOrder(id)));
            if (term.Length == 0) return rows.ToList();
            return rows.Where(r =>
            {
                var o = r.Order;
                if (o is null) return $"#{r.Id}".Contains(term, StringComparison.OrdinalIgnoreCase) || r.Id.ToString().Contains(term, StringComparison.Ordinal);
                return o.Number.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Title.Contains(term, StringComparison.OrdinalIgnoreCase)
                    || (o.ProjectName ?? "").Contains(term, StringComparison.OrdinalIgnoreCase)
                    || o.Id.ToString().Contains(term, StringComparison.Ordinal);
            }).ToList();
        }
    }
    private List<WorkProjectMindFlowAccessibleProjectDto> FilteredMindFlows => _availableMindFlows.Where(flow =>
        flow.ProjectId != ProjectId
        && !_map.Nodes.Any(n => n.LinkedMindFlowProjectId == flow.ProjectId)
        && (string.IsNullOrWhiteSpace(_mindFlowSearch)
            || flow.Title.Contains(_mindFlowSearch, StringComparison.OrdinalIgnoreCase)
            || flow.Number.Contains(_mindFlowSearch, StringComparison.OrdinalIgnoreCase))).ToList();

    protected override async Task OnParametersSetAsync()
    {
        var subPath = NormalizeSubMindFlowPath(SubFlowPath);
