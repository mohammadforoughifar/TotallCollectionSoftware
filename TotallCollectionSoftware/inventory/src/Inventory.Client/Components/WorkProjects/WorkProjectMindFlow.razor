    [JSInvokable]
    public Task CommitDrag(Guid rootId, List<DragPoint> points, Guid? targetParentId)
    {
        if (!CanEdit || points.Count == 0) return Task.CompletedTask;
        Snapshot(); var moved = points.ToDictionary(p => p.Id); var root = _map.Nodes.FirstOrDefault(n => n.Id == rootId); var target = moved.GetValueOrDefault(rootId);
        var dx = root is null || target is null ? 0 : target.X - root.X; var dy = root is null || target is null ? 0 : target.Y - root.Y;
        foreach (var point in points) if (_map.Nodes.FirstOrDefault(n => n.Id == point.Id) is { } node) { node.X = point.X; node.Y = point.Y; }
        var descendants = new HashSet<Guid> { rootId }; var changed = true;
        while (changed) { changed = false; foreach (var child in _map.Nodes.Where(n => n.ParentId.HasValue && descendants.Contains(n.ParentId.Value))) if (descendants.Add(child.Id)) changed = true; }
        foreach (var id in descendants.Where(id => !moved.ContainsKey(id))) if (_map.Nodes.FirstOrDefault(n => n.Id == id) is { } hidden) { hidden.X += dx; hidden.Y += dy; }
        if (root?.ParentId is not null && targetParentId is Guid nextParentId && !descendants.Contains(nextParentId)
            && _map.Nodes.FirstOrDefault(n => n.Id == nextParentId) is { } nextParent)
        {
            root.ParentId = nextParentId;
            nextParent.Collapsed = false;
        }
        _selectedId = rootId; Dirty(); return InvokeAsync(StateHasChanged);
    }
    public void Dispose()
    {
        _workOrderLoadGeneration++;
        _candidateSearchGeneration++;
