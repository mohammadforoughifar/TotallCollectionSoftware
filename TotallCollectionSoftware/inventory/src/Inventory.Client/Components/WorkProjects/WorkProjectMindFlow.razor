    // ==================== بزرگ‌نمایی و اسکرول بوم ====================
    //
    // بزرگ‌نمایی با «بزرگ‌کردن خودِ بوم» انجام می‌شود، نه با کوچک‌کردنِ viewBox.
    // یعنی سطح قابل اسکرول هم به همان نسبت بزرگ می‌شود و کاربر می‌تواند در بزرگ‌نمایی
    // بالا هم افقی و هم عمودی حرکت کند و به هر گوشهٔ نقشه برسد.
    // برای اینکه با هر پلهٔ بزرگ‌نمایی نقشه به گوشه نپرد، مرکز دید قبل و بعد حفظ می‌شود.

    private Task ZoomIn() => SetZoomAsync(Zoom + .1);
    private Task ZoomOut() => SetZoomAsync(Zoom - .1);
    private Task Fit() => FitAsync();

    private async Task SetZoomAsync(double value)
    {
        var next = Math.Clamp(Math.Round(value, 2), MinZoom, MaxZoom);
        if (Math.Abs(next - Zoom) < .001) return;

        // مرکز دید فعلی، در واحد فضای طراحی.
        double? anchorU = null, anchorV = null;
        var view = await GetCanvasViewAsync();
        if (view is not null && view.W > 0 && view.H > 0)
        {
            anchorU = (view.Left + view.W / 2) / Zoom;
            anchorV = (view.Top + view.H / 2) / Zoom;
        }

        Zoom = next;
        _pendingZoomAnchor = anchorU is not null && anchorV is not null ? (anchorU.Value, anchorV.Value) : null;
        await InvokeAsync(StateHasChanged);
    }

    /// <summary>«نمای کامل» = جای دادن همهٔ نقشه در فضای دید (هرگز بیش از ۱۰۰٪ بزرگ نمی‌شود).</summary>
    private async Task FitAsync()
    {
        var target = 1d;
        var view = await GetCanvasViewAsync();
        if (view is not null && view.W > 0 && view.H > 0)
            target = Math.Min(view.W / DesignWidth, view.H / DesignHeight);
        await SetZoomAsync(Math.Clamp(target, MinZoom, 1));
    }

    private async Task<CanvasView?> GetCanvasViewAsync()
    {
        try
        {
            return await JS.InvokeAsync<CanvasView?>("inventoryWorkProjectMindFlow.getCanvasView", _canvasWrapRef);
        }
        catch (JSException) { /* اسکریپت کلاسیک بارگذاری نشده → مسیر ماژول */ }
        catch (Exception ex) when (ex is InvalidOperationException or TaskCanceledException) { return null; }

        try
        {
            _dragModule ??= await JS.InvokeAsync<IJSObjectReference>("import",
                "./js/inventory-workproject-mindflow.module.js?v=4");
            return await _dragModule.InvokeAsync<CanvasView?>("getCanvasView", _canvasWrapRef);
        }
        catch { return null; }
    }

    /// <summary>پس از تغییر بزرگ‌نمایی، همان نقطهٔ مرکز دید را برمی‌گرداند.</summary>
    private async Task RestoreZoomAnchorAsync()
    {
        if (_pendingZoomAnchor is not { } anchor) return;
        _pendingZoomAnchor = null;
        var view = await GetCanvasViewAsync();
        if (view is null || view.W <= 0 || view.H <= 0) return;
        var maxLeft = Math.Max(0, CanvasWidth - view.W);
        var maxTop = Math.Max(0, CanvasHeight - view.H);
        var left = Math.Clamp(anchor.U * Zoom - view.W / 2, 0, maxLeft);
        var top = Math.Clamp(anchor.V * Zoom - view.H / 2, 0, maxTop);
        try { await JS.InvokeVoidAsync("inventoryWorkProjectMindFlow.setCanvasView", _canvasWrapRef, left, top); }
        catch (JSException) { /* مسیر ماژول */ }
        catch (Exception ex) when (ex is InvalidOperationException or TaskCanceledException) { }
    }

    private void ToggleFullscreen() => _isFullscreen = !_isFullscreen;

    /// <summary>
    /// میان‌برهای صفحه‌کلید روی بوم: ＋ / − برای بزرگ‌نمایی و ۰ برای «نمای کامل».
    /// پیمایش با کلیدهای جهت در JS انجام می‌شود تا نرم و بدون تأخیر باشد.
    /// </summary>
    private async Task OnCanvasKeyDown(KeyboardEventArgs e)
    {
        if (_nodeTitleEditingId is not null) return;      // هنگام تایپ عنوان گره
        if (e.CtrlKey || e.MetaKey || e.AltKey) return;

        switch (e.Key)
        {
            case "+": case "=": await ZoomIn(); break;
            case "-": case "_": await ZoomOut(); break;
            case "0": await Fit(); break;
        }
    }

