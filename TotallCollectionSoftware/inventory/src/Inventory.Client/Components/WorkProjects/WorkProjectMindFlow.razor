    private static string NormalizeSubMindFlowPath(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        var ids = new List<Guid>();
        foreach (var part in path.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
        {
            if (!Guid.TryParse(part, out var id) || id == Guid.Empty) return "invalid";
            ids.Add(id);
        }
        return ids.Count is 0 or > 8 ? "invalid" : string.Join(",", ids);
    }
    private string SubMindFlowHref(Guid ownerNodeId)
    {
        var owner = _map.Nodes.FirstOrDefault(node => node.Id == ownerNodeId);
        if (owner?.LinkedMindFlowProjectId is int linkedProjectId)
            return $"/work-projects/mindflow?projectId={linkedProjectId}";
        var currentPath = NormalizeSubMindFlowPath(SubFlowPath);
        var rootHref = IsStandalone ? $"/mindflows/{StandaloneMapId}" : $"/work-projects/mindflow?projectId={ProjectId}";
        if (currentPath == "invalid") return rootHref;
        var ids = currentPath == "" ? new List<Guid>() : currentPath.Split(',').Select(Guid.Parse).ToList();
        ids.Add(ownerNodeId);
        var pathQuery = Uri.EscapeDataString(string.Join(",", ids));
        return IsStandalone ? $"{rootHref}?subFlowPath={pathQuery}" : $"{rootHref}&subFlowPath={pathQuery}";
    }
    private static async Task<string> ErrorMessage(HttpResponseMessage response)
    {
        try { var data = await response.Content.ReadFromJsonAsync<Dictionary<string, string>>(); return data?.GetValueOrDefault("message") ?? $"ذخیره ناموفق بود ({(int)response.StatusCode})."; }
        catch { return $"ذخیره ناموفق بود ({(int)response.StatusCode})."; }
    }
