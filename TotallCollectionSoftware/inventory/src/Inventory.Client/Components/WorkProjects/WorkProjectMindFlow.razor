    private void AddChild()
    {
        if (!CanEdit || SelectedNode is null) return; Snapshot();
        var p = SelectedNode; p.Collapsed = false;
        var siblings = _map.Nodes.Count(n => n.ParentId == p.Id); var sign = p.X < 800 ? -1 : 1;
        var node = new WorkProjectMindFlowNodeDto { ParentId = p.Id, Text = "کار جدید", X = Math.Clamp(p.X + sign * 240, 120, 1480), Y = Math.Clamp(p.Y + (siblings % 2 == 0 ? 115 : -115), 90, 810), Color = p.ParentId is null ? Palette[_map.Nodes.Count % Palette.Length] : p.Color };
        _map.Nodes.Add(node); _selectedId = node.Id; Dirty();
        FocusNewNodeTitle(node);
    }
    private void AddSibling()
    {
        if (!CanEdit || SelectedNode is null) return;
        if (SelectedNode.ParentId is not Guid parentId) { AddChild(); return; }
        Snapshot(); var n = SelectedNode; var p = _map.Nodes.FirstOrDefault(x => x.Id == parentId); if (p is null) return;
        var sibling = new WorkProjectMindFlowNodeDto { ParentId = parentId, Text = "کار جدید", X = n.X, Y = Math.Clamp(p.Y + (_map.Nodes.Count(x => x.ParentId == parentId) % 2 == 0 ? 115 : -115), 90, 810), Color = n.Color };
        _map.Nodes.Add(sibling); _selectedId = sibling.Id; Dirty();
        FocusNewNodeTitle(sibling);
    }
    private void DeleteSelected()
    {
        if (!CanEdit || SelectedNode?.ParentId is not Guid parent) return; Snapshot();
        var remove = new HashSet<Guid> { _selectedId }; var changed = true;
        while (changed) { changed = false; foreach (var n in _map.Nodes.Where(n => n.ParentId.HasValue && remove.Contains(n.ParentId.Value))) if (remove.Add(n.Id)) changed = true; }
        _map.Nodes.RemoveAll(n => remove.Contains(n.Id)); _selectedId = parent; Dirty();
    }
