  "_comment": "\u0641\u0647\u0631\u0633\u062A \u0645\u0631\u06A9\u0632\u06CC \u06A9\u0644\u06CC\u062F\u0647\u0627\u06CC \u0639\u0645\u0648\u0645\u06CC \u0627\u0645\u0636\u0627\u06CC \u0644\u0627\u06CC\u0633\u0646\u0633. \u0628\u0631\u0627\u06CC \u0686\u0631\u062E\u0634 \u06A9\u0644\u06CC\u062F\u060C \u0631\u062F\u06CC\u0641 \u062A\u0627\u0632\u0647 \u0627\u0636\u0627\u0641\u0647 \u06A9\u0646\u06CC\u062F \u0648 \u06A9\u0644\u06CC\u062F \u0642\u062F\u06CC\u0645\u06CC \u0631\u0627 \u062D\u0630\u0641 \u0646\u06A9\u0646\u06CC\u062F \u062A\u0627 \u0644\u0627\u06CC\u0633\u0646\u0633\u200C\u0647\u0627\u06CC \u0635\u0627\u062F\u0631\u0634\u062F\u0647\u0654 \u0642\u0628\u0644\u06CC \u0645\u0639\u062A\u0628\u0631 \u0628\u0645\u0627\u0646\u0646\u062F. sha256 = \u0627\u062B\u0631 \u0627\u0646\u06AF\u0634\u062A hex \u06A9\u0644\u06CC\u062F \u0639\u0645\u0648\u0645\u06CC \u062F\u0631 \u0642\u0627\u0644\u0628 DER (SubjectPublicKeyInfo) \u0627\u0633\u062A \u0648 \u0647\u0646\u06AF\u0627\u0645 \u0628\u0627\u0631\u06AF\u0630\u0627\u0631\u06CC \u0628\u0631\u0631\u0633\u06CC \u0645\u06CC\u200C\u0634\u0648\u062F \u062A\u0627 \u06A9\u0644\u06CC\u062F\u0650 \u062F\u0633\u062A\u200C\u06A9\u0627\u0631\u06CC\u200C\u0634\u062F\u0647 \u0631\u062F \u0634\u0648\u062F. \u0631\u062F\u06CC\u0641\u200C\u0647\u0627\u06CC\u06CC \u06A9\u0647 debugOnly=true \u062F\u0627\u0631\u0646\u062F \u0641\u0642\u0637 \u062F\u0631 \u0628\u06CC\u0644\u062F Debug \u0628\u0627\u0631\u06AF\u0630\u0627\u0631\u06CC \u0645\u06CC\u200C\u0634\u0648\u0646\u062F\u061B \u0628\u06CC\u0644\u062F Release \u0641\u0642\u0637 \u06A9\u0644\u06CC\u062F\u0647\u0627\u06CC \u062A\u0648\u0644\u06CC\u062F \u0631\u0627 \u0645\u06CC\u200C\u0634\u0646\u0627\u0633\u062F (\u0628\u0627\u0632\u0628\u06CC\u0646\u06CC \u0686\u0647\u0627\u0631\u0645\u060C \u0645\u0648\u0631\u062F \u06F5).",
