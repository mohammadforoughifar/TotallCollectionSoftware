--- a/src/Inventory.Client/wwwroot/css/app.css
+++ b/src/Inventory.Client/wwwroot/css/app.css
@@ -3906,3 +3906,135 @@
     .rr-trend { height: 170px; }
     .rr-trend-x { display: none; }
 }
+/* ======================================================================
+   بازطراحی نوار تب‌های کاری — ظاهر مدرن، روشن و مناسب رابط RTL
+   ====================================================================== */
+.tabbar {
+    --tab-accent: #2563eb;
+    --tab-ink: #334155;
+    height: 50px;
+    gap: 6px;
+    padding: 5px 10px;
+    background: linear-gradient(180deg, rgba(248,250,255,.97), rgba(241,245,252,.94));
+    border-bottom: 1px solid #dfe7f2;
+    box-shadow: 0 5px 16px rgba(31, 50, 81, .055);
+}
+.tabbar .tabstrip {
+    align-items: center;
+    gap: 7px;
+    padding: 3px 4px;
+}
+.tabbar .tab {
+    min-height: 37px;
+    max-width: 240px;
+    gap: 8px;
+    padding: 0 12px;
+    border: 1px solid transparent;
+    border-radius: 11px;
+    background: rgba(255,255,255,.42);
+    color: #64748b;
+    font-size: .79rem;
+    font-weight: 600;
+    box-shadow: inset 0 1px 0 rgba(255,255,255,.75);
+    transition: background .18s ease, color .18s ease, border-color .18s ease,
+                box-shadow .18s ease, transform .18s ease;
+}
+.tabbar .tab:hover {
+    background: #fff;
+    color: #1e3a5f;
+    border-color: #e1e9f3;
+    box-shadow: 0 3px 9px rgba(31,50,81,.07);
+    transform: translateY(-1px);
+}
+.tabbar .tab.on {
+    color: #1746a2;
+    background: linear-gradient(135deg, #fff 15%, #edf5ff 100%);
+    border: 1px solid #cfe0fa;
+    border-bottom: 1px solid #cfe0fa;
+    box-shadow: 0 3px 10px rgba(37,99,235,.11), inset 0 1px 0 #fff;
+}
+.tabbar .tab.on::after {
+    content: "";
+    position: absolute;
+    inset-inline: 13px;
+    inset-block-end: -1px;
+    height: 3px;
+    border-radius: 5px 5px 0 0;
+    background: linear-gradient(90deg, #60a5fa, #2563eb);
+}
+.tabbar .tab .tab-ico {
+    display: inline-grid;
+    place-items: center;
+    width: 25px;
+    height: 25px;
+    border-radius: 8px;
+    background: #edf2f8;
+    color: #64748b;
+    font-size: .82rem;
+    opacity: 1;
+    transition: background .18s ease, color .18s ease, transform .18s ease;
+}
+.tabbar .tab.on .tab-ico {
+    color: #2563eb;
+    background: #dceaff;
+    transform: scale(1.03);
+}
+.tabbar .tab .tab-title { max-width: 165px; }
+.tabbar .tab.pinned { padding-inline-start: 12px; }
+.tabbar .tab .tab-pin { color: #2563eb; }
+.tabbar .tab .tab-x {
+    width: 20px;
+    height: 20px;
+    margin-inline-start: 1px;
+    color: #94a3b8;
+    font-size: .8rem;
+}
+.tabbar .tab .tab-x:hover { background: #fee2e2; color: #dc2626; }
+.tabbar .tabnav,
+.tabbar .tabtool {
+    color: #64748b;
+    background: rgba(255,255,255,.68);
+    border: 1px solid #e2e8f0;
+    border-radius: 9px;
+}
+.tabbar .tabnav { width: 29px; }
+.tabbar .tabnav:hover,
+.tabbar .tabtool:hover:not(:disabled) {
+    color: #1d4ed8;
+    background: #fff;
+    border-color: #cfe0fa;
+    box-shadow: 0 2px 7px rgba(37,99,235,.09);
+}
+.tabbar .tabtools { gap: 5px; padding-inline-start: 5px; }
+.tabbar .tabtool { width: 31px; height: 31px; }
+.tabbar .tabtool .tabcnt { box-shadow: 0 0 0 2px #f1f5fc; }
+.tabbar .tab:focus-visible,
+.tabbar .tabnav:focus-visible,
+.tabbar .tabtool:focus-visible,
+.tabbar .tab-x:focus-visible {
+    outline: 3px solid rgba(37,99,235,.35);
+    outline-offset: 2px;
+}
+.tabbar .tabmenu {
+    border-color: #dce5f0;
+    border-radius: 14px;
+    box-shadow: 0 16px 38px rgba(15,23,42,.16);
+}
+.tabbar .tabmenu-head { background: #f5f8fc; }
+.tabbar .tabmenu-row { padding-block: .55rem; }
+
+@media (max-width: 991.98px) {
+    .tabbar { height: 47px; padding-inline: 8px; }
+    .tabbar .tab { min-height: 35px; }
+}
+@media (max-width: 575.98px) {
+    .tabbar { height: 44px; padding-inline: 5px; }
+    .tabbar .tab { min-height: 33px; gap: 6px; padding-inline: 8px; }
+    .tabbar .tab .tab-ico { width: 23px; height: 23px; }
+    .tabbar .tab .tab-title { max-width: 78px; }
+    .tabbar .tabtools { gap: 3px; }
+}
+@media (prefers-reduced-motion: reduce) {
+    .tabbar .tab, .tabbar .tab .tab-ico { transition: none; }
+}
+
