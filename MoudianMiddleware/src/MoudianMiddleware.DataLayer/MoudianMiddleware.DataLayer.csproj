<Project Sdk="Microsoft.NET.Sdk">

  <!--
    لایه‌ی داده: فقط DbContext، Entityها، Configurationها، Repositoryها، UnitOfWork، Migration و Seed.
    هیچ منطق کسب‌وکاری در این پروژه نیست و به هیچ لایه‌ی بالاتری ارجاع نمی‌دهد.
    نسخه‌ی پکیج‌ها فقط در Directory.Packages.props تعریف می‌شود.
  -->
  <PropertyGroup>
    <RootNamespace>MoudianMiddleware.DataLayer</RootNamespace>
    <AssemblyName>MoudianMiddleware.DataLayer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MoudianMiddleware.Contracts\MoudianMiddleware.Contracts.csproj" />
  </ItemGroup>

</Project>
