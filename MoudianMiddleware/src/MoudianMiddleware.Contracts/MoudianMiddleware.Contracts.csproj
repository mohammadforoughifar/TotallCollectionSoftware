<Project Sdk="Microsoft.NET.Sdk">

  <!--
    پروژه‌ی Contracts: تنها قرارداد مشترک بین API، CoreLayer و Blazor.
    ⚠️ این پروژه عمداً «صفر وابستگی پکیج» است و فقط از BCL استفاده می‌کند.
    افزودن هر PackageReference به این فایل، معماری را می‌شکند (WASM باد می‌کند).
  -->
  <PropertyGroup>
    <RootNamespace>MoudianMiddleware.Contracts</RootNamespace>
    <AssemblyName>MoudianMiddleware.Contracts</AssemblyName>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>

</Project>
